var GetStaticURL=(typeof GetStaticURL==='undefined')?function(initial_static_host){var stored_static_host=initial_static_host||'/static';return function(url){var slashurl=url.replace(/^\/?/,'/');return stored_static_host+slashurl;}}(typeof static_host==='undefined'?'':static_host):GetStaticURL;jQuery(document).ready(function(){function debounce(callback,timeout){timeout=!timeout&&timeout!==0?50:timeout;let timer;return function(){let context=this;let args=arguments;clearTimeout(timer);timer=setTimeout(function(){callback.apply(context,args);},timeout);};}
function fuzzySearch(needle,haystack){let needleLen=needle.length;let haystackLen=haystack.length;let haystackUpper=haystack.toUpperCase();if(needleLen>haystackLen)return'';if(needleLen===haystackLen)return needle===haystack?'<mark>'+haystack+'</mark>':'';let highlightTerm='';let highlightLen=0;for(let i=0,j=0;i<needleLen;i++){let found=false;let needleChar=needle.charCodeAt(i);while(j<haystackLen){highlightLen++;if(haystackUpper.charCodeAt(j++)===needleChar){highlightTerm+='<mark>'+haystack[j-1]+'</mark>';found=true;break;}
highlightTerm+=haystack[j-1];}
if(found)continue;return'';}
return highlightTerm.replaceAll('</mark><mark>','')+haystack.substr(highlightLen);}
let cachedMenu=false;jQuery('#LEFTMENU_FILTER').bind('keyup',debounce(function(){let vals=[];if(this.value){vals=this.value.split(',');for(let i=0;i<vals.length;i++){vals[i]=vals[i].trim();if(!vals[i]){vals.splice(i,1);i--;}else if(/^".*/.test(vals[i])){let val=vals[i].replace(/^"|"$/g,'').toUpperCase();if(val){vals[i]=new RegExp(val.replace(/[.*+?^${}()|[\]\\]/g,'\\$&'),'i');}else{vals.splice(i,1);i--;}}else{vals[i]=vals[i].toUpperCase();}}}
let headings=jQuery('.c__left-panel-sub-section-header');let links=jQuery(this).parent().parent().find('a');if(!cachedMenu){links.each(function(_i,e){e.originalHTML=e.innerHTML;e.menuText=Array.prototype.filter.call(e.childNodes,function(child){return child.nodeType===Node.TEXT_NODE;})[0].textContent;});cachedMenu=true;}
if(vals.length){links.hide();links.filter(function(_i,e){let menuText=e.menuText;for(let i in vals){let val=vals[i];if(val instanceof RegExp){if(val.test(menuText)){let newMenuText=menuText.replace(val,'<mark>$&</mark>');e.innerHTML=e.originalHTML.replace(menuText,newMenuText);return true;}}else{let regExp=new RegExp(val.replace(/[.*+?^${}()|[\]\\]/g,'\\$&'),'i');if(regExp.test(menuText)){let newMenuText=menuText.replace(regExp,'<mark>$&</mark>');e.innerHTML=e.originalHTML.replace(menuText,newMenuText);return true;}
let match=fuzzySearch(val,menuText);if(match){e.innerHTML=e.originalHTML.replace(menuText,match);return true;}}}
return false;}).show();headings.hide();headings.filter(function(_i,e){let me=jQuery(e);let firstVisible=me.nextUntil('.c__left-panel-sub-section-header').children('a').toArray().findIndex(function(e){let style=window.getComputedStyle(e);return!(style.display==='none'||style.visibility==='hidden');});if(firstVisible!==-1){return true;}
return false;}).show();}else{links.each(function(_i,e){if(e.innerHTML!==e.originalHTML)e.innerHTML=e.originalHTML;}).show();headings.show();}}));jQuery('#LEFTMENU_FILTER').focus();});
