if(select.is(':visible')){select.trigger('change');}
else{textinput.trigger('change');}}}}
function WindowOpen(href,name,parameters,opener){opener=opener||window;if(name&&parameters){return opener.open(href,name,parameters);}else if(name){return opener.open(href,name);}else{return opener.open(href);}
return newwindow;}
function PickDate(dateobj,pickdatecallback,bottomalign,selecteddate,dateranges,escapedfailuremessages){var basehref;if(AH.GetGlobal('BASE_HREF')!=undefined){basehref=AH.GetGlobal('BASE_HREF');}
else{basehref='';}
var height=210;var width=250;var top=window.event.screenY-(bottomalign?(height+20):0);var url=basehref+'/datepicker.esp?TITLE=datepicker';var selecteddateobj;var datepart;var startdateobj;var enddateobj;if(selecteddate&&IsDate(selecteddate)){datepart=selecteddate.split('/');selecteddateobj={month:parseInt(datepart[0],10)-1,date:parseInt(datepart[1],10),year:parseInt(datepart[2],10)};}
if(dateranges){var datesplit=dateranges.split('-');var startdates=datesplit[0];var enddates=datesplit[1];if(startdates&&IsDate(startdates)){datepart=startdates.split('/');startdateobj={month:parseInt(datepart[0],10),date:parseInt(datepart[1],10),year:parseInt(datepart[2],10)};}
if(enddates&&IsDate(enddates)){datepart=enddates.split('/');enddateobj={month:parseInt(datepart[0],10),date:parseInt(datepart[1],10),year:parseInt(datepart[2],10)};}}
var args={page:url,onclose:pickdatecallback,width:width,height:height,additionalargs:{dateobj:dateobj,selecteddateobj:selecteddateobj,startdateobj:startdateobj,enddateobj:enddateobj,escapedfailuremessages:escapedfailuremessages}};ModalPopupWindow(args);}
function AthenaShortKeys(e){if(!AH.IsMain||!AH.Frames.GlobalNav.Frame().ShowMenu){return false;}
var event=e||window.event;if(event.keyCode==27&&!event.shiftKey){if(AH.Frames.Top.Frame().IsMenuOpen()){AH.Frames.Top.Frame().CloseAllMenus(true);}
else{AH.Frames.GlobalNav.Frame().ShowMenu("GlobalNavMenu",1,1);}
return false;}
if(event.keyCode==220&&!event.shiftKey){AH.Frames.GlobalNav.Frame().ShowMenu("ActionMenu",event.x,1);return false;}
if(event.ctrlKey&&(event.keyCode==9)&&document.zform&&document.zform.submitonctrlenter){if(typeof CheckForm!='undefined'){if(CheckForm())document.zform.submit();}else{document.zform.submit();}}
if(event.altKey){if(event.keyCode==49){GOTO_FindPatient('ID');}else if(event.keyCode==50){GOTO_FindPatient('DOB')}else if(event.keyCode==51){GOTO_FindPatient('SSN');}else if(event.keyCode==52){GOTO_FindPatient('NAME');}else if(event.keyCode==67){GOTO_FindClaim();}else if(event.keyCode==83&&document.zform){if(typeof CheckForm!='undefined'){if(CheckForm())document.zform.submit();}else{document.zform.submit();}}else{CheckPatientShortKeys(e);}}
else{CheckPatientShortKeys(e);}
if(event.keyCode==112){AthenaNetHelp();}
if(event.keyCode==113){if(AH.Frames.ScheduleNav.IsVisible()){AH.SetGlobal('navWidth',AH.Frames.ScheduleNav.GetWidth());AH.Frames.ScheduleNav.Hide();}
else{ShowNavigation();}}}
function PatientShortKeys(e){var event=e||window.event;var keypressed=String.fromCharCode(event.keyCode);var menubar=document.getElementById('ActionMenuBar');if(!(menubar&&AH.IsMain&&AH.Frames.Main.getElementById('ActionMenuBar'))){return false;}
var menuselector;if(isDefined(AH.GetGlobal('menubaractive'))&&AH.GetGlobal('menubaractive')!==''){menuselector='#'+AH.GetGlobal('menubaractive');}
else{menuselector='#ActionMenuBar';}
window.setTimeout(function(){jQuery(menuselector+' [shortcutkey='+keypressed+']',AH.Frames.Main.Document()).trigger('click');},0);}
function CheckPatientShortKeys(e){var event=e||window.event;if(event.altKey){if(isDefined(AH.GetGlobal('menubaractive'))&&AH.GetGlobal('menubaractive')==''&&event.keyCode>=65&&event.keyCode<=90){PatientShortKeys(e);}}
if(isDefined(AH.GetGlobal('menubaractive'))&&AH.GetGlobal('menubaractive')!==''&&!event.altKey){if(event.keyCode>=65&&event.keyCode<=90){PatientShortKeys(e);}}}
function SwitchTabEnter(e){var event=e||window.event;var source=event.srcElement;if(event.keyCode==13&&source.tagName!='TEXTAREA'&&!IsMobile()&&!(source.tagName=='INPUT'&&source.type=='submit')&&!(source.tagName=='INPUT'&&source.type=='button'&&source.value.toUpperCase()=='SAVE')&&!(source.contentEditable&&source.contentEditable!="inherit")&&!(jQuery(source).data("preventtab"))){var allforms=(document&&isElement(document))?GetChildren(document,'tagName','form'):[];if(!(allforms&&allforms.length==1&&allforms[0].getAttribute('submitonenterkey')=='yes')){event.keyCode=9;if(event.keyCode!=9){event.preventDefault?event.preventDefault():event.returnValue=false;var sourcetabindex=source.getAttribute('tabIndex');var focusresult=[];if(isDefined(sourcetabindex)&&(sourcetabindex!=null)){var nextindex=parseInt(sourcetabindex)+(event.shiftKey?(-1):1);focusresult=jQuery("input[tabIndex='"+nextindex+"']").focus();}
if(!focusresult.length){var inputlist=jQuery(source).closest('form').find('textarea, select, button, input').filter(":visible:enabled");var sourceindex=inputlist.index(source);var nextindex=inputlist.index(source)+(event.shiftKey?(-1):1);if(inputlist.eq(sourceindex).is("select")&&sourceindex==(inputlist.length-1)){jQuery(source).blur();}
if(nextindex>-1&&(nextindex)<inputlist.length){inputlist.eq(nextindex).focus();}}}}}
return true;}
function IsFrameAccessible(frame){try{if(frame&&frame.Frame().document){return 1;}}
catch(ex){}
return 0;}
function DefaultKeyHandler(e){var event=e||window.event;SwitchTabEnter(event);if(!IsFrameAccessible(AH)){return;}
var framesaccessible=AH.Frames?1:0;var globalnavaccessible=framesaccessible&&IsFrameAccessible(AH.Frames.GlobalNav);if(AH.IsMain&&!isAirlockOpen()){if(globalnavaccessible&&AH.Frames.GlobalNav.Frame().menuitems){AthenaShortKeys(event);}
else{if(event.keyCode==27){AH.Frames.Top.Frame().CloseAllMenus();if(globalnavaccessible&&AH.GetGlobal('menusearchactive')){var searchinput=AH.Frames.GlobalNav.Frame().jQuery('#searchinput');if(searchinput&&searchinput.length){searchinput.focus();}}}
if((event.altKey&&event.keyCode===83&&document.zform)||(event.ctrlKey&&(event.keyCode===9)&&document.zform&&document.zform.submitonctrlenter)){if(typeof CheckForm!=='undefined'){if(CheckForm())document.zform.submit();}else{document.zform.submit();}}
else if(event.keyCode==112){AthenaNetHelp();}
else if(event.keyCode==113){if(IsFrameAccessible(AH.Frames.ScheduleNav)&&AH.Frames.ScheduleNav.IsVisible()){AH.SetGlobal('navWidth',AH.Frames.ScheduleNav.GetWidth());AH.Frames.ScheduleNav.Hide();}
else{ShowNavigation();}}}}
else{if(framesaccessible&&event.keyCode===27){if(isAirlockOpen()){AH.Frames.Top.Frame().CloseAllMenus();if(globalnavaccessible&&AH.GetGlobal('menusearchactive')){var globalsearchinput=AH.Frames.GlobalNav.Frame().jQuery('#searchinput');if(globalsearchinput&&globalsearchinput.length){globalsearchinput.focus();}}}}}
if(event.keyCode==8){var srcType="";if(event.srcElement.type){srcType=event.srcElement.type.toString().toUpperCase();}
if(event.srcElement.isContentEditable){return true;}
if(!InList(srcType,['TEXT','PASSWORD','FILE','TEXTAREA','NUMBER','SEARCH'])){return false;}}
if(AH.DictationNavigator&&isObject(AH.DictationNavigator)){AH.DictationNavigator.DictationControl.ProcessKeyStroke(event.keyCode);}}
