function ModalPopUp(items,xpos,ypos,callback){popupHeight=items.length*20+32;popupWidth=0;for(i=0;i<items.length;i++){stringWidth=8*items[i].length;if(stringWidth>popupWidth){popupWidth=stringWidth;}}
popupWidth=Math.floor(popupWidth+25);ModalPopupWindow({page:AH.PrependBasePath(GetMDCCompatibleHTMLURL('modalmenu.html')),additionalargs:{items:items},width:popupWidth,height:popupHeight,onclose:callback});}
