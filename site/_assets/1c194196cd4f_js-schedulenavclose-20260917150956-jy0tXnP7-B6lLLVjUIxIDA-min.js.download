catch(e){AthenaNetError("Error in NavSetCurrentPatientID: "+e.message,document.location.pathname);}});}
function IsDate(d){if(d==''){return true;}
if(isNaN(Date.parse(d))){return false;}else{if(list=d.match(/^(\d+)\/(\d+)\/(\d+)$/)){if(list[1]<1||list[1]>12||list[2]<1||list[2]>31||list[3]<=0||list[3]>9999||list[3].length!=4){return false;}else{return true;}}else{return false;}}}
function IsPastDate(date){if(!IsDate(date)){return false;}
var today=new Date();var datelist=date.match(/^(\d+)\/(\d+)\/(\d+)$/);var dateobject=new Date();dateobject.setFullYear(datelist[3],datelist[1]-1,datelist[2]);return dateobject<today;}
function SetDate(checkNumYears,obj,suppressalert,checkoutofrange,nottoday){if(!obj){obj=event.srcElement;}
var jqobj=jQuery(obj);if(suppressalert&&obj.value==''){jqobj.removeClass('InvalidInput');return true;}
d=obj.value;if(d==''){if(jqobj.hasClass('InvalidInput')){if(obj.getAttribute('enforcerestriction')){obj.harderror=0;jqobj.removeClass('InvalidInput');}}
return false;}
dt=new Date();thisyear=dt.getFullYear();if(d.match(/t/i)){d=TrimWhitespace(d);}
if(d.toLowerCase()=='t'){d=(dt.getMonth()+1)+'/'+dt.getDate()+'/'+dt.getFullYear();}else if(d.match(new RegExp('^t[+-][0-9]+','ig'))){day=new Number(dt.getDate());offset=new Number(d.substr(2));if(d.substr(1,1)=='+'){dt.setDate(day+offset);}else{dt.setDate(day-offset);}
d=(dt.getMonth()+1)+'/'+dt.getDate()+'/'+dt.getFullYear();}
checkyear=TrimWhitespace(d.substring(d.lastIndexOf('/')+1,d.length));checkyearnomodification=checkyear;if(checkyear.length==0){checkyear=thisyear;}
if(checkyear.length>1&&checkyear[0]==='0'){checkyear=checkyear.replace(/^0*(\d)/,'$1');}
if(checkyear.length<4){checkyear=new Number(checkyear);c=Math.floor((thisyear+10-checkyear)/100);checkyear=100*c+checkyear;}
if(checkyear!=checkyearnomodification){d=d.substring(0,d.lastIndexOf('/')+1)+checkyear.toString();}
if(d!=""){mon=TrimWhitespace(d.substring(0,d.indexOf('/'))||obj.value);day=TrimWhitespace(d.substring(d.indexOf('/')+1,d.lastIndexOf('/')));year=TrimWhitespace(d.substr(d.lastIndexOf('/')+1));if(mon.match(/\D/)||mon<1||mon>12){if(!suppressalert){var alertmessage;if(mon=='NaN'){alertmessage="This date has an invalid month, please use mm/dd/yyyy format.";}else{alertmessage="'"+mon+"' is not a valid month.";}
alert(alertmessage);if(obj.type!='hidden'){setTimeout(function(){obj.focus();},100);}}
else{jqobj.addClass('InvalidInput');obj['markedinvalid']=1;}
return false;}else if(day.match(/\D/)||day<1||day>31){if(!suppressalert){var alertmessage;if(day=='NaN'){alertmessage="This date has an invalid day, please use mm/dd/yyyy format.";}else{alertmessage="'"+day+"' is not a valid day of the month.";}
alert(alertmessage);if(obj.type!='hidden'){setTimeout(function(){obj.focus();},100);}}
else{jqobj.addClass('InvalidInput');obj['markedinvalid']=1;}
return false;}else if(year.match(/\D/)||year<=0||year>9999||year.length!=4){if(!suppressalert){var alertmessage;if(year=='NaN'){alertmessage="This date has an invalid year, please use mm/dd/yyyy format.";}else{alertmessage="'"+year+"' is not a valid year.";}
alert(alertmessage);if(obj.type!='hidden'){setTimeout(function(){obj.focus();},100);}}
else{jqobj.addClass('InvalidInput');obj['markedinvalid']=1;}
return false;}
dt=new Date(d);dt.setFullYear(checkyear,mon-1,day);if(!isNaN(dt)){month=dt.getMonth()+1;if(month<10){month="0"+month;}
date=dt.getDate();if(date<10){date="0"+date;}
jqobj.prop('value',month+"/"+date+"/"+checkyear);}else{if(!suppressalert){alert("The entered date, "+d+", is invalid.");}
else{jqobj.addClass('InvalidInput');obj['markedinvalid']=1;}}
today_date=new Date();today_date.setHours(0);today_date.setMinutes(0);today_date.setSeconds(0);today_date.setMilliseconds(0);elapsedMilliSeconds=dt-today_date;elapsedYears=elapsedMilliSeconds/(1000*60*60*24*365);if(jqobj.hasClass('InvalidInput')){if(obj.getAttribute('enforcerestriction')){obj.harderror=0;jqobj.removeClass('InvalidInput');}}
var todaycheckfails=nottoday&&elapsedMilliSeconds==0;if(checkNumYears<0){if(elapsedYears>0||todaycheckfails){if(obj.getAttribute('enforcerestriction')){obj.harderror=1;jqobj.addClass('InvalidInput');if(!suppressalert){if(todaycheckfails){alert("WARNING: This date must be a past date. The entered date is today.");}
else{alert("WARNING: This date must be a past date. The entered date occurs in the future.");}}}
else{if(!suppressalert){if(todaycheckfails){alert("WARNING: This date should generally be a past date. The entered date is today.");}
else{alert("WARNING: This date should generally be a past date. The entered date occurs in the future.");}}}
if(checkoutofrange){return false;}}else if(elapsedYears<checkNumYears){if(obj.getAttribute('enforcerestriction')){obj.harderror=1;jqobj.addClass('InvalidInput');if(!suppressalert){alert("WARNING: This date must occur within the past "+(-checkNumYears)+" year(s). The entered date occurs about "+Math.round(-elapsedYears)+" year(s) ago.");}}
else{if(!suppressalert){alert("WARNING: This date should generally occur within the past "+(-checkNumYears)+" year(s). The entered date occurs about "+Math.round(-elapsedYears)+" year(s) ago.");}}
if(checkoutofrange){return false;}}}
if(checkNumYears>0){if(elapsedYears<0||todaycheckfails){if(obj.getAttribute('enforcerestriction')){obj.harderror=1;jqobj.addClass('InvalidInput');if(!suppressalert){if(todaycheckfails){alert("WARNING: This date must be a future date. The entered date is today.");}
else{alert("WARNING: This date must be a future date. The entered date occurs in the past.");}}}
else{if(!suppressalert){if(todaycheckfails){alert("WARNING: This date should generally be a future date. The entered date is today.");}
else{alert("WARNING: This date should generally be a future date. The entered date occurs in the past.");}}}
if(checkoutofrange){return false;}}else if(elapsedYears>checkNumYears){if(obj.getAttribute('enforcerestriction')){obj.harderror=1;jqobj.addClass('InvalidInput');if(!suppressalert){alert("WARNING: This date must occur within the next "+checkNumYears+" year(s). The entered date occurs in about "+Math.round(elapsedYears)+" year(s).");}}
else{if(!suppressalert){alert("WARNING: This date should generally occur within the next "+checkNumYears+" year(s). The entered date occurs in about "+Math.round(elapsedYears)+" year(s).");}}
if(checkoutofrange){return false;}}}}
if(jqobj.hasClass('InvalidInput')&&obj['markedinvalid']){jqobj.removeClass('InvalidInput');obj['markedinvalid']=0;}
return true;}
function DateTimeKeyDown(field){var e=window.event;var keypressed=e.keyCode||e.charCode;if(keypressed==9||keypressed==13){jQuery('#'+EscapeJQuerySelector(field.getAttribute('datetimegroupid'))+'_SPAN').prop('tabbedout',true);}}
function UpdateDateTime(field,datetimefieldid,datefieldid,timefieldid,ampmfieldid){var datetime=jQuery("#"+EscapeJQuerySelector(datetimefieldid));var fieldjq=jQuery(field);var modifiedfieldid=field.id.replace(/_AMPM$/,'_TIME');var validatingfieldid=datetime.data('validatingfieldid')||'';if(validatingfieldid!=''&&validatingfieldid!=modifiedfieldid){return;}
var currentfieldid=datetime.data('currentfieldid')||'';if(currentfieldid!=''&&currentfieldid!=field.id){return;}
datetime.data('validatingfieldid',modifiedfieldid);datetime.data('currentfieldid',field.id);var strippedvalue=TrimWhitespace(field.value);if(field.id==datetimefieldid){if(strippedvalue==''){jQuery("#"+EscapeJQuerySelector(datefieldid)).val('');jQuery("#"+EscapeJQuerySelector(timefieldid)).val('');jQuery("#"+EscapeJQuerySelector(ampmfieldid)).val('');field.INVALID=false;}
else{var datetimearr=strippedvalue.split(" ");jQuery("#"+EscapeJQuerySelector(datefieldid)).val(datetimearr[0]);jQuery("#"+EscapeJQuerySelector(timefieldid)).val(datetimearr[1]);jQuery("#"+EscapeJQuerySelector(ampmfieldid)).val(datetimearr[2]);if(datetimearr[0]&&datetimearr[1]&&datetimearr[2]&&!isNaN(new Date(strippedvalue))){field.INVALID=false;}
else{field.value='';field.INVALID=true;}}}
else{if(field.id==datefieldid){if(field.value!=''){fieldjq.unbind("blur");if(isTablet()){if(ProcessFlexibleDates(datefieldid,datefieldid+'_MASK',field,true)==false){setTimeout(function(){field.focus();fieldjq.blur(function(){UpdateDateTime(field,datetimefieldid,datefieldid,timefieldid,ampmfieldid);});},100);return false;}}
else if(!SetDate(0,field)){setTimeout(function(){field.focus();fieldjq.blur(function(){UpdateDateTime(field,datetimefieldid,datefieldid,timefieldid,ampmfieldid);});},100);return false;}
fieldjq.blur(function(){UpdateDateTime(field,datetimefieldid,datefieldid,timefieldid,ampmfieldid);});}}
else if(field.id==timefieldid){if(InList(strippedvalue.toLowerCase(),['t','n'])||strippedvalue.match(new RegExp('t[+-][0-9]+','ig'))){var d=new Date();if(strippedvalue.substr(1,1)=='+'||strippedvalue.substr(1,1)=='-'){var offset=new Number(strippedvalue.substr(2));if(strippedvalue.substr(1,1)=='-'){offset*=-1;}
d.setTime(d.getTime()+1000*60*offset);}
var newtime=((d.getHours()+11)%12)+1;if(newtime<10){newtime='0'+newtime;}
newtime+=':'+(d.getMinutes()<10?'0':'')+d.getMinutes();field.value=newtime;jQuery("#"+EscapeJQuerySelector(ampmfieldid)).val(d.getHours()>11?'PM':'AM');}
else if(strippedvalue.match(/^\s*$/)){jQuery("#"+EscapeJQuerySelector(ampmfieldid)).val('');}
else{var invalidalerts=new Array();if(strippedvalue.match(/^(\d\d):(\d\d)$/)){var hours=RegExp.$1;var minutes=RegExp.$2;if(hours<1||hours>12){invalidalerts.push(hours+" is not a valid number of hours.");}
if(minutes<0||minutes>59){invalidalerts.push(minutes+" is not a valid number of minutes.");}}
else{invalidalerts.push(strippedvalue+" is not a valid time.");}
if(invalidalerts.length){fieldjq.unbind("blur");alert(invalidalerts.join("\n"));setTimeout(function(){field.focus();fieldjq.blur(function(){UpdateDateTime(field,datetimefieldid,datefieldid,timefieldid,ampmfieldid);});},100);datetime.attr('INVALID',true);return false;}}}
var date=jQuery("input[name='"+EscapeJQuerySelector(datefieldid)+"']");var time=jQuery("#"+EscapeJQuerySelector(timefieldid));var ampm=jQuery("#"+EscapeJQuerySelector(ampmfieldid));var outerspan=jQuery('#'+EscapeJQuerySelector(datetimefieldid)+'_SPAN');var datevalue=date.length?date.val():'';var newdatetime=TrimWhitespace(datevalue+" "+time.val()+" "+ampm.val());var performcheck;if(outerspan.prop('tabbedout')&&field.id==ampmfieldid){performcheck=true;}
else if(!outerspan.prop('mouseinspan')&&!outerspan.prop('tabbedout')){performcheck=true;}
else{performcheck=false;}
if(performcheck){if(ampm.val()==''&&time.val()){ampm.unbind("blur");alert("Please specify AM or PM.");setTimeout(function(){ampm.focus();ampm.blur(function(){UpdateDateTime(field,datetimefieldid,datefieldid,timefieldid,ampmfieldid);});},100);datetime.attr('INVALID',true);return false;}
if(datetime.attr('requiretime')&&date.val()&&time.val()==''){time.unbind("blur");alert('Please specify a time.');setTimeout(function(){time.focus();time.blur(function(){UpdateDateTime(field,datetimefieldid,datefieldid,timefieldid,ampmfieldid);});},100);datetime.attr('INVALID',true);var timeerrorfield=modifiedfieldid.replace(/_DATE$/,'_TIME');datetime.data('currentfieldid',timeerrorfield);datetime.data('validatingfieldid',timeerrorfield);return false;}
if(datetime.attr('requiredate')&&time.val()&&date.val()==''){date.unbind("blur");alert('Please specify a date.');setTimeout(function(){date.focus();date.blur(function(){UpdateDateTime(field,datetimefieldid,datefieldid,timefieldid,ampmfieldid);});},100);datetime.attr('INVALID',true);var dateerrorfield=modifiedfieldid.replace(/_TIME$/,'_DATE');datetime.data('currentfieldid',dateerrorfield);datetime.data('validatingfieldid',dateerrorfield);return false;}}
if(!newdatetime||!isNaN(new Date(newdatetime))||(!datetime.attr('requiredate')&&newdatetime.match(/^(\d\d):(\d\d) (AM|PM)$/))){datetime.val(newdatetime);datetime.attr('INVALID',false);}
else{datetime.attr('INVALID',true);}}
datetime.data('validatingfieldid','');datetime.data('currentfieldid','');return true;}
function FormatDate(e){if(!e){var e=window.event;}
var target;if(e.target){target=e.target;}
else{target=e.srcElement;}
if(e.keyCode==8||e.keyCode==37){return;}
d=target.value;if(d){if(d.substring(d.length-2,d.length)=="//"||d.substring(d.length-2,d.length)=="/-"){target.value=d.substring(0,d.length-1);}else if(d.length==2&&!isNaN(d.substring(0,2))){target.value+="/";}else if(d.length==5&&!isNaN(d.substring(0,2))&&!isNaN(d.substring(3,5))){target.value+="/";}}}
function CheckDateOverlap(startdate1text,enddate1text,startdate2text,enddate2text){var startdate1=new Date(startdate1text);var enddate1=new Date(enddate1text);var startdate2=new Date(startdate2text);var enddate2=new Date(enddate2text);return((isNaN(startdate1)||isNaN(enddate2)||startdate1<enddate2)&&(isNaN(enddate1)||isNaN(startdate2)||enddate1>startdate2));}
function TodayToString(){var dt=new Date();return DateToString(dt);}
function DateToString(dt){var month=dt.getMonth()+1;if(month<10){month="0"+month;}
var date=dt.getDate();if(date<10){date="0"+date;}
var year=dt.getFullYear();return month+"/"+date+"/"+year;}
function TodayToStringWithTime(){dt=new Date();var month=dt.getMonth()+1;if(month<10){month="0"+month;}
var date=dt.getDate();if(date<10){date="0"+date;}
var year=dt.getFullYear();var newtime=((dt.getHours()+11)%12)+1;if(newtime<10){newtime='0'+newtime;}
newtime+=':'+(dt.getMinutes()<10?'0':'')+dt.getMinutes();var ampm=dt.getHours()>11?'PM':'AM';return month+"/"+date+"/"+year+" "+newtime+" "+ampm;}
function FormatTime(){if(event.keyCode==8||event.keyCode==37){return;}
d=event.srcElement.value;if(d.substring(d.length-2,d.length)=="::"){event.srcElement.value=d.substring(0,d.length-1);}else if(d.length==2&&d.substr(1,2)==":"){event.srcElement.value="0"+event.srcElement.value;}else if(d.length==2&&!isNaN(d.substring(0,2))){event.srcElement.value=event.srcElement.value+":";}}
function FormatIPAddress(){var field=event.srcElement;if(event.keyCode==8||event.keyCode==37){return;}
if(field.value.match(/\d{3}$/)&&!field.value.match(/\.\d+\.\d+\./)){field.value=field.value+".";}
else if(field.value.match(/\.\.$/)){field.value=field.value.substring(0,field.value.length-1);}}
function MaskEqual(val,checkFor,mask){var newval=(val&mask);return BinaryEqual(newval,checkFor);}
function BinaryEqual(val,checkFor){return(val&checkFor)==checkFor}
function AutoTab(field,type){if(InList(event.keyCode,[8,9,16,37,39])||!document.zform||!event.srcElement){return;}
var d=event.srcElement.value;if((type=='DATE'&&d.length==10&&!isNaN(d.substring(0,2))&&!isNaN(d.substring(3,5))&&!isNaN(d.substring(6)))||(type=='TIME'&&d.length==5&&!isNaN(d.substring(0,2))&&!isNaN(d.substring(3,5)))){var inputs=GetChildren(document.zform,'tagName',['input','select','textarea','a']);if(!inputs){return;}
inputs=inputs.sort(function(thing1,thing2){return(thing1.tabIndex-thing2.tabIndex)||(thing1.sourceIndex-thing2.sourceIndex);});var target;for(var i=0;i<inputs.length;i++){if(inputs[i]==field){do{i++;target=inputs[i];}
while(target&&(target.type=='hidden'||target.tabIndex==-1||(target.style&&target.style.display=='none')));break;}}
if(!target){return;}
target.focus();if(target.select){target.select();}}}
function FormatPhone(countryid){if(!countryid&&(document.zform&&document.zform.COUNTRYID)){countryid=document.zform.COUNTRYID.value;}
else if(!countryid&&window.contactManagement){countryid=window.contactManagement.countryId;}
var countryNotEnabled=!document.zform||!document.zform.COUNTRYID;if(window.contactManagement){countryNotEnabled=!window.contactManagement.countryId;}
if(countryid=='1'||countryNotEnabled){if(event.keyCode==8||event.keyCode==37){return;}
phone=event.srcElement.value;if(phone.length==1&&phone!="("){event.srcElement.value="("+phone;}else if(phone.length==4&&phone.substring(0,1)=="("&&!isNaN(phone.substring(1,4))){event.srcElement.value=phone+") ";}else if(phone.length==9&&phone.substring(0,1)=="("&&!isNaN(phone.substring(1,4))&&phone.substring(4,5)==")"&&!isNaN(phone.substring(6,9))){event.srcElement.value=phone+"-";}}}
function FormatPhoneDigitsOnly(){if(event.keyCode==16||event.keyCode==17){return;}
var validchars="0123456789()-";var character=String.fromCharCode(event.keyCode);if(validchars.indexOf(character)==-1){event.keyCode="";}
phone=event.srcElement.value;if(phone.length==1&&phone!="("){event.srcElement.value="("+phone;}else if(phone.length==4&&phone.substring(0,1)=="("&&!isNaN(phone.substring(1,4))){event.srcElement.value=phone+") ";}else if(phone.length==9&&phone.substring(0,1)=="("&&!isNaN(phone.substring(1,4))&&phone.substring(4,5)==")"&&!isNaN(phone.substring(6,9))){event.srcElement.value=phone+"-";}else if(phone.length>6&&!isNaN(phone.substring(0,6))){event.srcElement.value="("+phone.substring(0,3)+") "+phone.substring(3,6)+"-"+phone.substring(6,phone.length);}}
function FormatSSN(){if(event.keyCode==8||event.keyCode==37){return;}
ssn=event.srcElement.value;if(isNaN(ssn)){alert("Please enter the SSN as all digits (no dashes), i.e. 111223333.");event.srcElement.value=ssn.substring(0,ssn.length-1);}}
function CheckSSN(){ssn=event.srcElement.value;if(ssn.length!=9){alert("The SSN must be 9 digits long.");}}
function LookupZipCode(args){AssertFields(args,['ZIPINPUT','CITYINPUT','STATEINPUT','HIDDENSTATEINPUT'],['COUNTRYINPUT','GPCILOCATIONIDINPUT','GPCILOCATIONNAMEINPUT']);CallRemote({SUB:'AthenaUtils::ZipCodeLookup',ARGS:{ZIPCODE:args.ZIPINPUT.val()},ONFINISH:function(info){if(info){args.CITYINPUT.val(info.CITY);args.STATEINPUT.val(info.STATE);args.HIDDENSTATEINPUT.val(info.STATE);args.CITYINPUT.removeClass('InvalidInput');args.STATEINPUT.removeClass('InvalidInput');if(args.COUNTRYINPUT){args.COUNTRYINPUT.val(1);}
if(args.GPCILOCATIONIDINPUT){args.GPCILOCATIONIDINPUT.val(info.GPCILOCATIONID);}
