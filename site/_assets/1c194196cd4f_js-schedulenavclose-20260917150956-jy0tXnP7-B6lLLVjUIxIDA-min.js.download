var visitfinder=jQuery('#VISITFINDER',globalnavdocument);if(visitfinder.length){visitfinder.show();}
globalnavdocument.visitfindform.ID.value='';if(jQuery(globalnavdocument.visitfindform.ID).is(":visible")){globalnavdocument.visitfindform.ID.focus();}}}
function GOTO_FindClaim(){var globalnavdocument=AH.Frames.GlobalNav.Document();if(globalnavdocument.claimfindform){var otherfinders=jQuery('#PATIENTFINDER, #VISITFINDER',globalnavdocument);if(otherfinders.length){otherfinders.hide();}
var claimfinder=jQuery('#CLAIMFINDER',globalnavdocument);if(claimfinder.length){claimfinder.show();}
globalnavdocument.claimfindform.ID.value='';if(jQuery(globalnavdocument.claimfindform.ID).is(":visible")){globalnavdocument.claimfindform.ID.focus();}}}
var focusElement;function KillReturn(){if(event.keyCode==13){if(document.zform){focusElement=event.srcElement;document.zform.onsubmit=ReturnFalse;}}}
function SetReturn(){if(event.keyCode==13){if(document.zform){if(!CheckForm){document.zform.onsubmit='';}else{document.zform.onsubmit=CheckForm;}
if(focusElement&&focusElement.focus){focusElement.focus();}
alert("The ENTER key has been disabled. To move to the next field, please use the TAB key. To move to the previous field, use SHIFT+TAB.");}}}
var submitting=false;function PageChangedSinceLoad(skipnames){var dirty=false;var forms=GetChildren(document,'tagName','form');FORMS:for(var i=0;i<forms.length;i++){var inputs=GetChildren(forms[i],'tagName',['input','select','textarea','checkbox']);if(forms[i].skipdirtycheck){continue;}
INPUTS:for(var j=0;j<inputs.length;j++){var input=inputs[j];if(input.getAttribute('skipdirtycheck')||(skipnames&&InList(input.name,skipnames))){continue;}
dirty=InputValue(input)!=InputDefaultValue(input);if(dirty)break FORMS;}}
return dirty;}
function FormChangedSinceLoad(form,args){Assert(isDefined(form),'form is undefined');if(!args){args={};}
var dirty=false;var inputs=GetChildren(form,'tagName',['input','select','textarea','checkbox']);for(var j=0;j<inputs.length;j++){var input=inputs[j];dirty=InputValue(input)!=InputDefaultValue(input)&&!(args.NOHIDDENINPUT&&input.type=='hidden');if(dirty)break;}
return dirty;}
