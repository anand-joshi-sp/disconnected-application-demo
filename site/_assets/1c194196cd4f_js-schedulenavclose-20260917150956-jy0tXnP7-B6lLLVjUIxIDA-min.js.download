var jqcontainer=jQuery(container);var escapedinputmaskname=EscapeJQuerySelector(inputmaskname);var escapedinputname=EscapeJQuerySelector(inputname);var hiddendatemaskinput=jqcontainer.find('#'+escapedinputmaskname+",[name='"+escapedinputmaskname+"']").get(0);var hiddendateinput=jqcontainer.find('input#'+escapedinputname+",input[name='"+escapedinputname+"']").filter(':hidden').get(0);var regexp;var inputvalue=inputobj.value.toString();var arr;if(!inputvalue){hiddendatemaskinput.value='';hiddendateinput.value='';if(suppressalert&&inputobj.className=='InvalidInput'){if(inputobj.oldclass){inputobj.className=inputobj.oldclass;}
else{inputobj.className=' ';}}
return false;}
if(arr=inputvalue.match(/^(\d{4})$/)){inputobj.value='01/01/'+inputobj.value;if(SetDate(-120,inputobj,suppressalert)){hiddendatemaskinput.value='YYYY';hiddendateinput.value=inputobj.value;}
if(!showfulldate){inputobj.value=arr[1];}}
else if(arr=inputvalue.match(/^(\d{1,2})\/(\d{2}|\d{4})$/)){inputobj.value=arr[1]+'/01/'+arr[2];if(SetDate(-120,inputobj,suppressalert)){hiddendatemaskinput.value='MM/YYYY';hiddendateinput.value=inputobj.value;var outputpattern=inputobj.value.match(/^(\d{2})\/(\d{2})\/(\d{4})$/);if(outputpattern!=null&&!showfulldate){inputobj.value=outputpattern[1]+"/"+outputpattern[3];}}
else if(!showfulldate){inputobj.value=arr[1]+"/"+arr[2];}}
else if((arr=inputvalue.match(/^(\d{1,2})\/(\d{1,2})\/(\d{2}|\d{4})$/))||(arr=inputvalue.match(/t[+-]?\d*/i))){if(SetDate(-120,inputobj,suppressalert)){hiddendatemaskinput.value='MM/DD/YYYY';hiddendateinput.value=inputobj.value;}
else if(suppressalert){inputobj.oldclass=inputobj.className;inputobj.className='InvalidInput';return false;}}
else if(arr=inputvalue.match(/^(\d{2})(\d{2})(\d{4})$/)){inputobj.value=arr[1]+'/'+arr[2]+'/'+arr[3];if(SetDate(-120,inputobj,suppressalert)){hiddendatemaskinput.value='MM/DD/YYYY';hiddendateinput.value=inputobj.value;}
else if(suppressalert){inputobj.oldclass=inputobj.className;inputobj.className='InvalidInput';return false;}}
else if(arr=inputvalue.match(/^(\d{4})\-(\d{2})\-(\d{2})$/)){hiddendateinput.value=arr[2]+'/'+arr[3]+'/'+arr[1];}
else if(inputobj.value!=''){if(!suppressalert){if(!(inputobj.getAttribute('validationpending')=='1')){alert('Valid Date formats are : YYYY or MM/YYYY or MM/DD/YYYY');}
preventformsubmission=1;inputobj.setAttribute('validationpending',1);setTimeout(function(){inputobj.focus();inputobj.setAttribute('validationpending',0);},100);}
else{inputobj.oldclass=inputobj.className;inputobj.className='InvalidInput';}
return false;}
if(inputobj.className=='InvalidInput'){if(inputobj.oldclass){inputobj.className=inputobj.oldclass;}
else{inputobj.className=' ';}}}
function GreatestCommonDivisor(a,b){return b==0?a:GreatestCommonDivisor(b,a%b);}
