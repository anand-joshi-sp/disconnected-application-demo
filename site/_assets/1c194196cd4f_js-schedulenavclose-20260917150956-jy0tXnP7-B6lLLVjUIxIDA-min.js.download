try{AH.SetGlobal('isDirty',false);AH.SetGlobal('waitingToSubmit',false);}catch(e){};function LargeModalLookup(args){var dimensions=_ConvertToStandardModalWidthHeight({size:'LARGE'});if(args.mode=='MODELESS'){return ModelessLookup(args.page,args.title,dimensions.width,dimensions.height,args.schedulenav,args.windowname,args.additionalargs);}
else{}}
function _ConvertToStandardModalWidthHeight(args){var standarddimensions={small:'400',medium:'550',large:'800',extraWide:'1200'};var dimensions={};if(args.size=='SMALL'){dimensions.width=standarddimensions.small;dimensions.height=standarddimensions.small;}
else if(args.size=='MEDIUM'){dimensions.width=standarddimensions.medium;dimensions.height=standarddimensions.medium;}
else if(args.size=='LARGE'){dimensions.width=standarddimensions.large;dimensions.height=standarddimensions.medium;}
else if(args.size=='EXTRAWIDE'){dimensions.width=standarddimensions.extraWide;dimensions.height=standarddimensions.medium;}
else if(!(args.width||$args.height)){dimensions.width=standarddimensions.small;dimensions.height=standarddimensons.small;}
else if(args.width<=standarddimensions.small&&args.height<=standarddimensions.small){dimensions.width=standarddimensions.small;dimensions.height=standarddimensions.small;}
else if(args.width<=standarddimensions.medium&&args.height<=standarddimensions.medium){dimensions.width=standarddimensions.medium;dimensions.height=standarddimensions.medium;}
else if(args.width<=standarddimensions.large&&args.height<=standarddimensions.large){dimensions.width=standarddimensions.large;dimensions.height=standarddimensions.large;}
else if(args.width<=standarddimensions.extraWide&&args.height<=standarddimensions.large){dimensions.width=standarddimensions.extraWide;dimensions.height=standarddimensions.large;}
else{dimensions.width=args.width;dimensions.height=args.height;}
return dimensions;}
function GetModalLookupArguments(){if(window.dialogArguments){return window.dialogArguments;}
else if(top.dialogArguments){return top.dialogArguments;}
else if(window.athenaDialogArguments){return window.athenaDialogArguments;}
else if(top.athenaDialogArguments){return top.athenaDialogArguments;}
else{return null;}}
function GetOpenerOrWindow(){var args=GetModalLookupArguments();if(args&&args['OPENER']){return args['OPENER'];}
return window;}
function GetMDCCompatibleHTMLURL(file){if((file=='blank.html'||file=='modalmenu.html')&&window.isdocumentdomainadded){file='documentdomain_'+file;}
return GetStaticURL(file);}
function ModelessLookup(page,t,w,h,schedulenav,windowname,args){t=escape(t);if(!(w||h)){var dimensions=_ConvertToStandardModalWidthHeight({size:'SMALL'});if(!w)w=dimensions.width;if(!h)h=dimensions.height;}
var lookupurl='/help/modalframeset.esp?PAGE='+escape(page);if(args&&args.FRAMELESSLOOKUP){lookupurl=page;delete args.FRAMELESSLOOKUP;}
return _AthenaShowModelessDialog(AH.PrependBasePath(lookupurl+'&TITLE='+t+'&SCHEDULENAV='+schedulenav),windowname,args,'width='+w+',height='+h);}
function _AthenaShowModelessDialog(url,windowname,args,features){var windowfeatures=new Array('resizable','scroll','status');if(args){try{for(var key in args){if(InList(key,windowfeatures)){if(features){features+=",";}
features+=key+"="+args[key];}
else{url+='&'+key+'='+escape(args[key]);}}}catch(e){alert('args must be a javascript object'+e);}}
return window.open(url,windowname,features);}
function RemoveGivenCharacters(activeInput,unwantedcharacters){var re=new RegExp("["+unwantedcharacters+"]","g");if(activeInput.value.match(re)){activeInput.value=activeInput.value.replace(re,'');}}
