function GetElementPosition(item){if(item.getBoundingClientRect){var bounds=item.getBoundingClientRect();var scroll=document.body.scrollTop||document.documentElement.scrollTop;var scrollleft=document.body.scrollLeft||document.documentElement.scrollLeft;return[parseInt(bounds.left,10)+scrollleft,parseInt(bounds.top,10)+scroll];}
var x=0;var y=0;do{x+=item.offsetLeft;y+=item.offsetTop;}while(item=item.offsetParent);return[x,y];}
function GetElementSize(item){return[item.scrollWidth,item.scrollHeight];}
function ScrollToItem(item,subitem,scrollobj,offset,scrolltotop){var scrollBy=0;var loc;var size=GetElementSize(item);var scrn;var scroll;offset=offset||0;if(scrollobj){loc=GetElementPosition(item);locscrollobj=GetElementPosition(scrollobj);loc[1]+=scrollobj.scrollTop;loc[0]-=locscrollobj[0];loc[1]-=locscrollobj[1];scrn=jQuery(scrollobj).height();scroll=scrollobj.scrollTop;}
else{scrollobj=document.body;loc=GetElementPosition(item);scrn=jQuery(window).height();scroll=scrollobj.scrollTop;}
if(!(subitem&&size[1]>scrn-10)&&offset){loc[1]+=offset;}
var scrnpos=loc[1]-scroll;if(scrolltotop){scrollBy=scrnpos-10;}
else if(size[1]>scrn-10){scrollBy=scrnpos;}else if(scrnpos+size[1]>scrn-10){scrollBy=scrnpos+size[1]-(scrn-10);}else if(scrnpos<10){scrollBy=scrnpos-10;}else{return;}
if(subitem&&size[1]>scrn-10){var subloc;if(scrollobj&&scrollobj!=document.body&&scrollobj!=document.documentElement){var layoutoffset=GetElementPosition(scrollobj);var subitemoffset=GetElementPosition(subitem);subloc=[subitemoffset[0]-layoutoffset[0],subitemoffset[1]-layoutoffset[1]];subloc[1]+=scrollobj.scrollTop;}
else{subloc=GetElementPosition(subitem);}
subloc[1]+=offset;var fromtop=subloc[1]-scroll;var subsize=GetElementSize(subitem);if(fromtop>10&&fromtop+subsize[1]<scrn-10){return;}
if(subsize[1]<(scrn-10)&&subloc[1]>(scroll+10)){scrollBy=fromtop+subsize[1]-(scrn-10);}else{scrollBy=fromtop-10;}}
if(scrollBy!=0){if(scrollobj){ScrollTo(scrollBy,scrollobj);}
else{Scroll(scrollBy);}}}
function CollapseableSearch(rootdiv,notfoundelt){this.root=rootdiv;this.notfound=notfoundelt;}
CollapseableSearch.prototype.PerformNextSearch=function(){if(this.text==null||this.text==""){this.item=null;return null;}
var text=this.text.toLowerCase();if(this.item==null){this.item=this.root.childNodes[0];}
while(this.item!=this.root){if(this.item.childNodes&&this.item.childNodes.length>0){this.item=this.item.childNodes[0];}
else if(this.item.nextSibling){this.item=this.item.nextSibling;}
else{while(!this.item.parentNode.nextSibling){this.item=this.item.parentNode;if(this.item==this.root||this.item.parentNode==null){return null;}}
this.item=this.item.parentNode.nextSibling;}
if(this.item.nodeName=="#text"){var loc=this.item.data.toLowerCase().indexOf(text);if(this.item.data.toLowerCase().indexOf(text)>=0){return this.item;}}}
return null;}
CollapseableSearch.prototype.ShowCollapseable=function(){var item=this.item;this.openedItems=[];while(item&&item!=this.root){if(item.nodeName=="DIV"){if(_ToggleCollapseable(item,true)){this.openedItems.push(item);}}
item=item.parentNode;}}
CollapseableSearch.prototype.RecloseCollapseable=function(){if(!this.openedItems){return;}
for(var idx=0;idx<this.openedItems.length;idx++){_ToggleCollapseable(this.openedItems[idx],false);}}
CollapseableSearch.prototype.HilightFound=function(){var oldHilight=this.oldHilight;if(this.item){var idx=this.item.data.toLowerCase().indexOf(this.text.toLowerCase());var len=this.item.data.length;var replace=this.item;if(idx>0){this.item.splitText(idx);replace=this.item.nextSibling;}
if(idx+this.text.length<len){replace.splitText(this.text.length);}
var emph=document.createElement("SPAN");emph.className="highlightfoundtext";emph.appendChild(document.createTextNode(replace.data));replace.parentNode.replaceChild(emph,replace);this.item=emph.childNodes[0];this.oldHilight=emph;}
if(oldHilight){var text="";if(oldHilight.previousSibling){if(oldHilight.previousSibling.nodeName=="#text"){text+=oldHilight.previousSibling.data;oldHilight.parentNode.removeChild(oldHilight.previousSibling);}}
text+=oldHilight.childNodes[0].data;if(oldHilight.nextSibling){if(oldHilight.nextSibling.nodeName=="#text"){text+=oldHilight.nextSibling.data;oldHilight.parentNode.removeChild(oldHilight.nextSibling);}}
var newtext=document.createTextNode(text);try{oldHilight.parentNode.replaceChild(newtext,oldHilight);}
catch(err){}}}
CollapseableSearch.prototype.Find=function(stext){if(this.hiliteItem){new InputWrapper(this.hiliteItem).RemoveClass("highlightfoundblock");}
this.text=stext;this.item=this.PerformNextSearch();this.HilightFound();this.RecloseCollapseable();if(this.item){this.ShowCollapseable();this.hiliteItem=this.item;while(this.hiliteItem.nodeName!="DIV"&&this.hiliteItem.nodeName!="P"){this.hiliteItem=this.hiliteItem.parentNode;}
new InputWrapper(this.hiliteItem).AddClass("highlightfoundblock");ScrollToItem(this.hiliteItem,this.oldHilight);}else{ScrollToItem(this.notfound||this.root);}}
var expandconfig={collapseablerow:{open:". DIV",img:"_ SPAN",imgclass:["sprite-plus","sprite-minus"]},collapseablenextrow:{open:"DIV",img:"< _ SPAN",imgclass:["sprite-plus","sprite-minus"]},collapseabletext:{open:"_ . .",closed:"_ . . ."}};function FindCollapseableBlock(ref,pathstring){if(!pathstring){return null;}
var path=pathstring.split(" ");for(var i=0;i<path.length;i++){if(path[i]=="."){ref=ref.nextSibling;}
else if(path[i]=="_"){if(ref.childNodes){ref=ref.childNodes[0];}else{ref=null;}}
else if(path[i]=="<"){if(ref.previousSibling){ref=ref.previousSibling;}}
else if(path[i]=="^"){ref=ref.parentNode;}
else{while(ref&&ref.tagName!=path[i]){ref=ref.nextSibling;}}
if(ref==null){break;}}
return ref;}
function ToggleCollapseable(evt){if(!evt)var evt=window.event;var targ=evt.target||evt.srcElement;_ToggleCollapseable(targ);return false;}
function _ToggleCollapseable(targ,open){while(targ.nodeName!="DIV"){targ=targ.parentNode;}
var type=targ.getAttribute("expand");if(!type){return false;}
var config=expandconfig[type];if(!config){return false;}
var openblock=FindCollapseableBlock(targ,config.open);var closedblock=FindCollapseableBlock(targ,config.closed);var imgitem=FindCollapseableBlock(targ,config.img);if(!openblock&&!closedblock){return false;}
var isopen=openblock?(openblock.style.display!="none"):closedblock.style.display=="none";if(open!=undefined&&open!=null){if(isopen==open){return false;}
isopen=!open;}
if(isopen){if(openblock){openblock.style.display="none";}
if(closedblock){closedblock.style.display=(closedblock.nodeName=="DIV")?"block":"inline";}
if(imgitem){if(config.imgclass){imgitem.className=config.imgclass[0];}else{imgitem.src=config.imgsrc[0];}}}else{if(openblock){openblock.style.display=(openblock.nodeName=="DIV")?"block":"inline";}
if(closedblock){closedblock.style.display="none";}
if(imgitem){if(config.imgclass){imgitem.className=config.imgclass[1];}else{imgitem.src=config.imgsrc[1];}}}
return true;}
function PrintSchedule(){var inputs=GetChildren(document,'tagName',['input','select']);var urlargs=new Array();for(var i=0;i<inputs.length;i++){if(inputs[i].name!=''&&InputValue(inputs[i])!=''&&isDefined(InputValue(inputs[i]))){urlargs.push(inputs[i].name+'='+InputValue(inputs[i]));}}
var url=AH.PrependBasePath('/schedule/printpop.esp?'+urlargs.join('&'));if(jQuery('meta[name="PrintingFrameworkEnabled"]').attr('content')){AthenaPattern_Print.print_page({HREF:document.location.protocol+'//'+document.location.host+url,OLDPRINT:function(){LargeModalPopupWindow({page:url,title:'Print Schedule'});}});}
else{LargeModalPopupWindow({page:url,title:'Print Schedule'});}
return false;}
function RuleLookup(activeInput,ruletype){if(activeInput.value=="."||activeInput.value=="?"){MediumModalPopupWindow({page:AH.PrependBasePath('/help/ruleslist.esp?RULETYPE='+ruletype),title:'Select '+ruletype+' rules',onclose:function(result){activeInput.value=result===null?'':result;}});}}
function GetContainer(matcharray,startobject){var candidate=startobject?startobject:event.srcElement;if(!candidate){return undefined;}
while(candidate&&!InList(candidate.id,matcharray)){candidate=candidate.parentNode;}
if(!candidate){return undefined;}
return candidate;}
function AddMultispecialtyFilterToURL(url){url=url.replace(/&SPECIALTIES=[\d%]*/g,'');if(isDefined(AH.GetGlobal('SPECIALTIES'))){return url+'&SPECIALTIES='+escape(AH.GetGlobal('SPECIALTIES'));}
return url;}
function GenericRollup(toggleelement,hidecontainer){if(!toggleelement||!hidecontainer){return;}
var togglesprite=GetChild(toggleelement,'id','rollup');if(togglesprite.className=='sprite-minus'){togglesprite.className='sprite-plus';}
else{togglesprite.className='sprite-minus';}
hidecontainer.style.display=togglesprite.className=='sprite-minus'?'inline':'none';}
function DymoInstalled(alertwithdetails){if(ADM.IsEnabled()&&!ADM.PreferActiveX()){return true;}
else if(IsIE()){return DymoActiveXInstalled();}
else{return DymoJSCanAccessFramework(alertwithdetails);}}
function DymoJSCanAccessFramework(alertwithdetails){var jsframework=false;try{ADM.IsMacOsAndADMIsEnabled(function(enabled){if(enabled){dymo.label.framework.init();}});var dymoenv=dymo.label.framework.checkEnvironment();if(dymoenv.isBrowserSupported&&dymoenv.isFrameworkInstalled)
jsframework=true;else{if(alertwithdetails){if(dymoenv.errorDetails){alert(dymoenv.errorDetails);}
else{if(!dymoenv.isBrowserSupported)
alert("This browser is not supported by Dymo software.");if(!dymoenv.isFrameworkInstalled)
alert("Dymo framework is not installed.");}}}}
catch(err){}
return jsframework;}
function DymoActiveXInstalled(){var ispresent=true;try{var DymoAddIn=new ActiveXObject('DYMO.DymoAddIn');}
catch(err){ispresent=false;}
return ispresent;}
