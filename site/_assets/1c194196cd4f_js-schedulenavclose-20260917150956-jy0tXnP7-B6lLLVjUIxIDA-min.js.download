function AllSelectedRadioAction(radiobutton){var selectdivid=radiobutton.name.replace(/radio$/,'selectspan');var selectdiv=GetChild(document,'id',selectdivid);var selectname=radiobutton.name.replace(/_radio$/,'');var select=GetChild(selectdiv,'name',selectname);if(radiobutton.value=='All'){var msname=radiobutton.name.replace(/_radio$/,'_wrapper');var msdiv=GetChild(selectdiv,'tagName','table','className','ms','id',msname);if(msdiv){GetMultiCheckObj(msdiv.getAttribute('name')).ClearAll(0,1);}
else{if(select){for(var i=0;i<select.length;i++){select.options[i].selected=false;}}}
