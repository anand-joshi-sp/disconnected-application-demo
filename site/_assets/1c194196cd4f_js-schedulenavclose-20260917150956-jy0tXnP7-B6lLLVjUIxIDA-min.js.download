function ObjectToJSON(object,level){if(!level)level=1;if(level>100){var message="ObjectToJSON: recursion past level 100 detected (probably a circular structure).  Aborting.";throw{name:'Deep recursion error',description:message,message:message};}
switch(typeof object){case'string':object=object.replace(/\\/g,'\\\\');object=object.replace(/\"/g,'\\"');object=object.replace(/([\n\r\t\f\b])/g,EscapeWhitespaceCharacter);return'"'+object+'"';case'undefined':return'null';case'boolean':return object?'true':'false';case'function':case'number':return object.toString();default:var result='';if(!object){return'null';}
else if(object.constructor==Array){result='[ ';for(var i=0;i<object.length;i++){result+=ObjectToJSON(object[i],level+1);if(i<object.length-1)
result+=", ";}
result=result.replace(/, $/,' ');result+=' ]';if(object.length==0)result='[]';}
else{result='{ ';var keys=[];var proto=object.constructor&&object.constructor.prototype?object.constructor.prototype:{};for(var property in object){if(object[property]==proto[property])continue;keys.push(property);}
for(var j=0;j<keys.length;j++){result+=('"'+keys[j].replace(/\"/,'\\"')+'": '+ObjectToJSON(object[keys[j]],level+1));result+=", ";}
result=result.replace(/, $/,' ');result+=' }';if(keys.length==0)result='{}';}
return result;}}
