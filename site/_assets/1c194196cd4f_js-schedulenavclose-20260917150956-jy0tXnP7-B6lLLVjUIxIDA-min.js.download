function PostHref(link,formtarget){if(formtarget&&formtarget.match(/ScheduleNav/)){ShowNavigation();}
var url=isDefined(link.href)?link.href:link;url=UnescapeHTML(url);var parts=url.split('?');var action=parts[0];var query=parts[1];var pairs=query.split('&');var form=AddElement(document.body,'beforeEnd','form');form.style.display='none';form.method='post';form.action=action;if(formtarget&&formtarget!=''){if(formtarget.match(/^fr/)||formtarget.match(/^content_/)){form.target=formtarget;}
else{eval("form.target = AH.Frames."+formtarget+".Frame().name");}}
var input='<input type=hidden>';form.innerHTML=input.repeat(pairs.length);for(var i=0;i<pairs.length;i++){var parts=pairs[i].split('=');var name=parts[0];var value=parts[1];var input=form.childNodes[i];input.name=unescape(name);input.value=unescape(value);}
if(typeof CSRFProtectForm=='function'){CSRFProtectForm(form);}
form.submit();return false;}
function GetAttribute(object,attributename){var attrib=object.attributes;if(attrib.getNamedItem(attributename)){return attrib.getNamedItem(attributename).value;}else{return false;}}
function SetElementData(elem,property,value){elem[property]=value;jQuery(elem).data(property,value);}
function GetElementData(elem,property){return elem[property]||jQuery(elem).data(property);}
function MakeSortable(table,sortheadrownum,preserveclasses,defaultsortarrow,initialsort){if(!sortheadrownum){sortheadrownum=0;}
var thead=jQuery(table).children('thead');var tbody=jQuery(table).children('tbody');var sortrow;if(thead.size()>0){sortrow=jQuery(thead).children('tr')[sortheadrownum];SetElementData(table,'startrow',0);SetElementData(table,'allrows',tbody.children('tr'));}
else if(tbody.size()>0){sortrow=jQuery(tbody).children('tr')[sortheadrownum];SetElementData(table,'startrow',sortheadrownum+1);SetElementData(table,'allrows',jQuery(tbody).children('tr'));}
SetElementData(table,'columnnamehash',new Array());SetElementData(table,'preserveclasses',preserveclasses);var sortcolumn;for(var i=0;i<sortrow.cells.length;i++){var headercolumn=sortrow.cells[i];var hc=jQuery(headercolumn);SetElementData(headercolumn,'nosort',hc.attr("nosort"));if(hc.attr('datesort')==1){SetElementData(headercolumn,'datesort',1);}
if(!headercolumn.nosort){SetElementData(headercolumn,'columnindex',i);SetElementData(headercolumn,'columnname',hc.text());table.columnnamehash[headercolumn.columnname]=i;hc.css('cursor',"pointer");hc.addClass("sortable");var initialsortorder=(hc.attr("initialsortorder")=='-')?'-':'+';SetElementData(headercolumn,'initialsortorder',initialsortorder);SetElementData(headercolumn,'sortdirection','');hc.click(SortColumn);var sortarrowvalue=GetElementData(hc,'sortarrow')||hc.attr("sortarrow");if(sortarrowvalue=="yes"||(defaultsortarrow&&sortarrowvalue!='no')){var spanarrow=jQuery("<tt>");if(hc.attr("defaultsort")=="yes"){spanarrow.html((initialsortorder=='+')?"&nbsp;&#9650;":"&nbsp;&#9660;");SetElementData(headercolumn,'sortdirection',initialsortorder);SetElementData(table,'lastclick',headercolumn);sortcolumn=headercolumn;}
else{spanarrow.html("&nbsp;");}
hc.append(spanarrow);SetElementData(headercolumn,'sortarrow',spanarrow.get());}}}
for(var i=table.startrow;i<table.allrows.length;i++){SetElementData(table.allrows[i],'nosum',false);}
if(sortcolumn&&initialsort){SortColumn('',sortcolumn);}
if(table.sorthook){table.sorthook();}}
function sortListOfObjsByProperty(property){var sortOrder=1;if(property[0]==="-"){sortOrder=-1;property=property.substr(1);}
return function(a,b){var result=(a[property]<b[property])?-1:(a[property]>b[property])?1:0;return result*sortOrder;};}
function SortBy(columns){for(var i=0;i<columns.length;i++){SortColumn('',columns[i]);}}
function SortColumn(e,column)
{var clickObject;if(column){clickObject=column;}
else{clickObject=e.srcElement;}
clickObject=jQuery(clickObject).closest('th');var tableObject=jQuery(clickObject).closest('table');var colindex=GetElementData(clickObject,'columnindex');var lastclick=GetElementData(tableObject,'lastclick');if(colindex!=null){var sortdir;if(!lastclick){SetElementData(clickObject,'sortdirection',GetElementData(clickObject,'initialsortorder'));}
else if(jQuery(lastclick).text()!=jQuery(clickObject).text()&&lastclick!=clickObject){SetElementData(clickObject,'sortdirection',GetElementData(clickObject,'initialsortorder'));SetElementData(lastclick,'sortdirection','');var sortarrow=GetElementData(lastclick,'sortarrow');if(sortarrow){jQuery(sortarrow).html("&nbsp;");}}
else{sortdir=GetElementData(clickObject,'sortdirection');sortdir=(sortdir=='-')?'+':'-';SetElementData(clickObject,'sortdirection',sortdir);}
var sortarrow=GetElementData(clickObject,'sortarrow');sortdir=GetElementData(clickObject,'sortdirection');if(sortarrow){jQuery(sortarrow).html(clickObject.sortdirection=="-"?'&nbsp;&#9660;':'&nbsp;&#9650;');}
SetElementData(tableObject,'lastclick',clickObject);var datesort=GetElementData(clickObject,'datesort');TableSort(tableObject,colindex,sortdir,datesort);if(tableObject.sorthook){tableObject.sorthook();}
else if(tableObject.get(0).sorthook){tableObject.get(0).sorthook();}}}
function TableSort(table,columnindex,sortdirection,datesort){var startrow=GetElementData(table,'startrow');var allrows=jQuery(table).children('tbody').children('tr');var sortedarray=new Array();var nonsorting=new Array();var valuearray=new Array();for(var i=startrow;i<allrows.length;i++){var row=jQuery(allrows[i]);if(row.attr("skiptablesort")){nonsorting[nonsorting.length]=allrows[i];continue;}
if(row.attr("attachedrowtablesort")){valuearray[valuearray.length]=new Array(allrows[i],valuearray[valuearray.length-1][1]);continue;}
var cell=jQuery(GetCellAt(allrows[i],columnindex));var preserveclasses=GetElementData(table,"preserveclasses");if(cell.length==0||(cell.attr('colspan')>1)||(jQuery(allrows[i].cells[0]).attr('colspan')>1)||row.attr("delimitingrow")){AddSortedArray(sortedarray,valuearray,sortdirection,preserveclasses,datesort);sortedarray[sortedarray.length]=allrows[i];valuearray=new Array();continue;}
var sortvalue=cell.attr("sortvalue")||cell.text()||"";sortvalue=sortvalue.toLowerCase();valuearray[valuearray.length]=new Array(allrows[i],sortvalue);}
AddSortedArray(sortedarray,valuearray,sortdirection,preserveclasses,datesort);var thead=jQuery(table).children('thead');var tbody=jQuery(table).children('tbody').first();if(thead.size()>0){tbody.empty();}
else{var startrow=GetElementData(table,"startrow");tbody.children("tr:gt("+startrow+")").detach();}
for(var i=0;i<nonsorting.length;i++){jQuery(tbody).append(nonsorting[i]);}
for(var i=0;i<sortedarray.length;i++){jQuery(tbody).append(sortedarray[i]);}}
function AddSortedArray(array1,array2,sortdirection,preserveclasses,datesort){var trclasses=new Array();if(preserveclasses){for(var i=0;i<array2.length;i++){trclasses[i]=array2[i][0].className;}}
var compareAscending=datesort?SecondColumnDateSortAscending:SecondColumnSortAscending;var compareDescending=datesort?SecondColumnDateSortDescending:SecondColumnSortDescending;if(sortdirection=="-"){array2.sort(compareDescending);}else{array2.sort(compareAscending);}
for(var j=0;j<array2.length;j++){array1[array1.length]=array2[j][0];if(preserveclasses){array1[array1.length-1].className=trclasses[j];}}}
function SecondColumnSortAscending(a,b){aa=parseFloat(a[1]);bb=parseFloat(b[1]);if(isNaN(bb)||isNaN(aa)){if(a[1]<b[1])return-1;if(a[1]>b[1])return 1;return 0;}
return aa-bb;}
function SecondColumnSortDescending(a,b){aa=parseFloat(a[1]);bb=parseFloat(b[1]);if(isNaN(bb)||isNaN(aa)){if(a[1]>b[1])return-1;if(a[1]<b[1])return 1;return 0;}
return bb-aa;}
function SecondColumnDateSortAscending(a,b){aa=Date.parse(a[1]);bb=Date.parse(b[1]);if(isNaN(aa)&&isNaN(bb)){return 0;}
else if(isNaN(aa)){return-1;}
else if(isNaN(bb)){return 1;}
datea=new Date(aa);dateb=new Date(bb);if(datea<dateb){return-1;}
else if(datea>dateb){return 1;}
return 0;}
function SecondColumnDateSortDescending(a,b){return SecondColumnDateSortAscending(b,a);}
function GetCellAt(tablerow,index){if(!tablerow)return;var currentindex=0;for(var i=0;i<tablerow.cells.length;i++){if(currentindex>index){return tablerow.cells[i-1];}else if(currentindex==index){return tablerow.cells[i];}
currentindex+=tablerow.cells[i].colSpan;}
return tablerow.cells[tablerow.cells.length-1];}
function StripComma(potentialamount){if(potentialamount!=null&&isString(potentialamount)){return(potentialamount.replace(/\,/g,''));}
return potentialamount;}
function isNaNPotentialComma(checkvalue){newvalue=StripComma(checkvalue);return(isNaN(newvalue));}
function AddCommas(number,decimalplaces){if(!decimalplaces){decimalplaces=2;}
var roundingfactor=Math.pow(10,decimalplaces);if((number<0)&&(number>-0.0001))number=0;var negative=number<0?"-":"";number=number<0?-number:number;if(number>=1000){var thousands=Math.floor(number/1000);var rest=Math.round((number%1000)*roundingfactor)/roundingfactor;var zeros="";if((rest<100)&&(rest>=10)){zeros="0";}else if(rest<10){zeros="00";}
var returnvalue=zeros+rest;while(thousands>=1000){rest=Math.floor(thousands%1000);thousands=Math.floor(thousands/1000);zeros="";if((rest<100)&&(rest>=10)){zeros="0";}else if(rest<10){zeros="00";}
returnvalue=zeros+rest+","+returnvalue;}
return negative+thousands+","+returnvalue;}else{number=Math.round(number*roundingfactor)/roundingfactor;return negative+number;}}
function RoundCurrency(amt){newamt=parseFloat(Math.round(100*(StripComma(amt))).toString())/100;if(isNaN(newamt)){newamt=0.00;}
return newamt;}
function FormatCurrency(number,symbol){if((number<0)&&(number>-0.0001))number=0;var negative=number<0?"-":"";number=number<0?-number:number;if(number>=1000){var thousands=Math.floor(number/1000);var rest=number%1000;var zeros="";if((rest<100)&&(rest>=10)){zeros="0";}else if(rest<10){zeros="00";}
var returnvalue=zeros+rest.toFixed(2);while(thousands>=1000){rest=Math.floor(thousands%1000);thousands=Math.floor(thousands/1000);zeros="";if((rest<100)&&(rest>=10)){zeros="0";}else if(rest<10){zeros="00";}
returnvalue=zeros+rest+","+returnvalue;}
return symbol+negative+thousands+","+returnvalue;}else{return symbol+negative+number.toFixed(2);}}
function UnFormatCurrency(string,symbol){var unformattedstring=string;var negative=0;if(symbol&&unformattedstring.substring(0,1)==symbol){unformattedstring=unformattedstring.substring(1,unformattedstring.length);}
if(unformattedstring.substring(0,1)=='-'){negative=1;unformattedstring=unformattedstring.substring(1,unformattedstring.length);}
unformattedstring=unformattedstring.replace(/,/g,'');if(negative){return-1*parseFloat(unformattedstring);}
return parseFloat(unformattedstring);}
function GetColumnValue(row,index){var colindex=GetElementData(this,'columnindex');var cell=GetCellAt(row,colindex)
if(cell.colSpan>1)return false;var value=GetAttribute(cell,"sortvalue");value=value?value:cell.innerText;return value;}
function Filter(table,filterargs){this.columnindex=table.columnnamehash[filterargs[0]];this.checkvalue=filterargs[2];if(this.columnindex!=null){this.GetValue=GetColumnValue;}else if(filterargs[0]=="<title>"){this.GetValue=function(row,index){return row.title};}else{this.GetValue=function(row,index){return false};}
if(filterargs[1]=='='){this.Keep=function(row){var value=this.GetValue(row,this.columnindex);if(value==false)return true;var returnvalue=value==this.checkvalue;return returnvalue;}}else if(filterargs[1]=='>'){this.Keep=function(row){var value=this.GetValue(row,this.columnindex);if(value==false)return true;var returnvalue=(value>this.checkvalue);return returnvalue;}}else if(filterargs[1]=='>='){this.Keep=function(row){var value=this.GetValue(row,this.columnindex);if(value==false)return true;var returnvalue=(value>=this.checkvalue);return returnvalue;}}else if(filterargs[1]=='<'){this.Keep=function(row){var value=this.GetValue(row,this.columnindex);if(value==false)return true;var returnvalue=(value<this.checkvalue);return returnvalue;}}else if(filterargs[1]=='<='){this.Keep=function(row){var value=this.GetValue(row,this.columnindex);if(value==false)return true;var returnvalue=(value<=this.checkvalue);return returnvalue;}}else if(filterargs[1]=='does not contain'){this.Keep=function(row){var value=this.GetValue(row,this.columnindex);if(value==false)return true;var returnvalue=(value.indexOf(this.checkvalue)==-1);return returnvalue;}}
return this;}
function ApplyFilters(row,filters){for(var j=0;j<filters.length;j++){if(!filters[j].Keep(row)){return false}}
return true;}
function FilterRows(table,filterarray){var filters=new Array();for(var i=0;i<filterarray.length;i++){filters[filters.length]=new Filter(table,filterarray[i]);}
var startrow=table.startrow;var allrows=table.allrows;for(var i=startrow;i<allrows.length;i++){var currentrow=allrows[i];if(ApplyFilters(currentrow,filters)){jQuery(currentrow).show();}
else{jQuery(currentrow).hide();}}}
function ClearFilters(table){var startrow=table.startrow;var allrows=table.allrows;for(var i=startrow;i<allrows.length;i++){jQuery(allrows[i]).show();}}
function ShowNavigation(){if(!AH.GetGlobal('navWidth')){AH.SetGlobal('navWidth',210);return;}
if(AH.GetGlobal('DISABLESHOWNAVIGATION')){AH.SetGlobal('DISABLESHOWNAVIGATION',false);return;}
var schedulenavlocation=AH.Frames.ScheduleNav.GetLocation().toString();if(schedulenavlocation.match(/[/]schedulenav.esp/)){require(['shared:/scripts/athena/utils/cross_frame_events'],function(CrossFrameEventsUtils){CrossFrameEventsUtils.trigger('shownavigation');});}
else{if(AH.Frames.ScheduleNav.IsVisible()){return false;}
AH.Frames.ScheduleNav.Show();}}
function ScheduleNavAutoRefresh(){if(AH.GetGlobal('SESSIONLOCKED')){return;}
var locationparts=document.location.toString().split('?');var action=locationparts[0];var query=locationparts[1];if(!query){query='SCHEDULENAVAUTOREFRESH=1';}
else if(query.indexOf('SCHEDULENAVAUTOREFRESH')==-1){query+='&SCHEDULENAVAUTOREFRESH=1';}
if(query.indexOf('AUTOMATIC_POLLING')==-1){query+='&AUTOMATIC_POLLING=1';}
action=action.replace(/\#(\d+)/g,'');query=query.replace(/\#(\d+)/g,'');query=query.replace(/&SCROLLTOP=(\d+)/g,'');query+='&SCROLLTOP='+(jQuery(window).scrollTop()||jQuery('html').scrollTop());document.location=action+'?'+query;}
function CheckEnforceLength(TheObject,CharLimit){if(TheObject.value.length>CharLimit){var message='';if(TheObject.title){message="Only the first "+CharLimit+" characters of \'"+TheObject.title+"\' will be saved. \nClick OK to continue, Cancel to rephrase.";}
else{message="Only the first "+CharLimit+" characters will be saved. \nClick OK to continue, Cancel to rephrase.";}
if(confirm(message)){MaxLengthTA(TheObject,CharLimit);return true;}
else{TheObject.focus();return false;}}
return true;}
