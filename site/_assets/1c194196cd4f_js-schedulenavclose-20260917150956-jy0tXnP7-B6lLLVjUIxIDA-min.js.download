function EscapeHTML(text){return jQuery("<div />").text(text).html();}
function UnescapeHTML(html){return jQuery("<div />").html(html).text();}
function ElideTextForElement(elt,text,offset){var jqelt=jQuery(elt);if(!offset){offset=0;}
var washidden=0;var invisibles=[];if(!jqelt.is(":visible")){var parents=jqelt.parents();for(var idx=parents.length-1;idx>=0;idx--){var jq=jQuery(parents[idx]);if(!jq.is(":visible")){if(jq.css("display")=='none'){invisibles.push(jq);}
jq.show();}}
if(!jqelt.is(":visible")){if(jqelt.css("display")=='none'){invisibles.push(jqelt);}
jqelt.show();}}
var width=jqelt.width()-offset;var cache=jqelt.data("elidecache");var elidetext='...';var elidedstring='';if(cache&&cache.text==text&&cache.width==width){elidedstring=cache.elide;}
else{var box=document.createElement('DIV');box.style.position='absolute';box.style.top='0px';box.style.left='-1000px';var fontFamily=jqelt.css('font-family');if(fontFamily){box.style.fontFamily=fontFamily;}
var fontSize=jqelt.css('font-size');if(fontSize){box.style.fontSize=fontSize;}
var fontWeight=jqelt.css('font-weight');if(fontWeight){box.style.fontWeight=fontWeight;}
jqelt.parent().append(box);var jqbox=jQuery(box);var elide=text;jqbox.text(text);var len=jqbox.width();if(len>width){var top=text.length;var bot=0;while(top>bot){var mid=Math.ceil((top+bot)/2);elide=text.substr(0,mid)+elidetext;jqbox.text(elide);box.innerHTML=box.innerHTML;len=jqbox.width();if(len>width){top=mid-1;}
else{bot=mid;}}
elide=text.substr(0,bot)+elidetext;jqelt.data('elidecache',{"text":text,"width":width,"elide":elide});}
jqbox.remove();elidedstring=elide;}
if(invisibles.length){for(idx=0;idx<invisibles.length;idx++){jQuery(invisibles[idx]).hide();}}
return elidedstring;}
var invalidpatientidmap=new Array();var cachedpatientidlookups=new Array();function ValidatePatient(patientidobj,multiline,crossprovidergroup,crossnetwork,providergroupid){var objname=patientidobj.name.split('_');var patientlookupargs;var index='';var inputindex='';if(objname.length==2){index=objname[1];inputindex='_'+objname[1];}
var patientidfull=patientidobj.value.toUpperCase();var patientid=patientidfull;var contextid;if(patientid){if(crossnetwork){if(patientidfull.match(/^\d+A\d+$/)){var values=patientidfull.split('A');patientid=values[0];contextid=values[1];}
else{patientidobj.title='invalid';var patienttextobj=document.getElementsByName('invalidpatienttext'+inputindex)[0];patienttextobj.innerHTML='<font class=alert>invalid</font>';alert("The practice ID must be appended to the patient ID, separated with the letter A.\n\nex: 12345A"+AH.GetGlobal('LOGINPRACTICEID'));invalidpatientidmap[index]=1;return;}}
if(!isNaN(patientid)&&parseInt(patientid,10)>0){invalidpatientidmap[index]=1;if(isDefined(cachedpatientidlookups[patientidfull])){patientidobj.title=cachedpatientidlookups[patientidfull].titletext;var patienttextobj=eval("document.all.invalidpatienttext"+inputindex);if(cachedpatientidlookups[patientidfull].titletext.match(/^invalid/)){patienttextobj.innerHTML='<font class=alert>invalid</font>';alert(cachedpatientidlookups[patientidfull].alerttext);}
else{patienttextobj.innerHTML=cachedpatientidlookups[patientidfull].patienttext;invalidpatientidmap[index]=0;}}
else if(patientidfull){patientlookupargs={'PATIENTID':patientidfull};if(isDefined(crossprovidergroup)){patientlookupargs.CROSSPROVIDERGROUP=crossprovidergroup;}
if(isDefined(providergroupid)){patientlookupargs.PROVIDERGROUPID=providergroupid;}
CallRemote({SUB:'Patient::GetPatientDetailsText',ARGS:patientlookupargs,LOADINGINDICATORFLAG:1,ONFINISH:function(detailstext){if(detailstext){ContinueValidatePatient(index,multiline,detailstext);}}});}}
else{var patientidobj=eval("document.zform.PATIENTID"+inputindex);patientidobj.title='invalid';var patienttextobj=eval("document.all.invalidpatienttext"+inputindex);patienttextobj.innerHTML='<font class=alert>invalid</font>';alert("The Patient ID entered is not valid.");invalidpatientidmap[index]=1;}}
else{patientidobj.title='';var patienttextobj=eval("document.all.invalidpatienttext"+inputindex);patienttextobj.innerHTML='';invalidpatientidmap[index]=0;}}
function ContinueValidatePatient(index,multiline,titletext){var patienttext=titletext;var inputindex='';if(index!=''){inputindex='_'+index;}
if(titletext.match(/^invalid/)){patienttext='<font class=alert>invalid</font>';invalidpatientidmap[index]=1;}
else{var titletextarray=titletext.split('__');if(titletextarray.length>1){titletext=titletextarray[0]+' '+titletextarray[1]+"\n"+titletextarray[2];if(isDefined(multiline)&&multiline){patienttext=titletextarray[0]+"<br>"+titletextarray[1];}
else{patienttext=titletextarray[0]+' '+titletextarray[1];}}
invalidpatientidmap[index]=0;}
var patientidobj=eval("document.zform.PATIENTID"+inputindex);var patientidfull=patientidobj.value.toUpperCase();patientidobj.title=titletext;cachedpatientidlookups[patientidfull]=new Object();cachedpatientidlookups[patientidfull].titletext=titletext;cachedpatientidlookups[patientidfull].patienttext=patienttext;var patienttextobj=eval("document.all.invalidpatienttext"+inputindex);patienttextobj.innerHTML=patienttext;if(titletext.match(/^invalid/)){var alerttext;if(titletext.match(/network/)){alerttext="The Practice ID entered is not valid for this network";}
else{alerttext="The Patient ID entered is not valid";}
if(titletext.match(/provider\s+group/)){alerttext=alerttext+" for this provider group";}
alerttext=alerttext+".";cachedpatientidlookups[patientidfull].alerttext=alerttext;alert(alerttext);}
else{cachedpatientidlookups[patientidfull].alerttext='';}}
var Notifier={element:undefined,emphasized:false,showtimer:undefined,parentdocument:undefined,_metricsNavigation:{stage:'',msEpoch:0},Show:function(html,fast,keepshowing,parentdocument){if(parentdocument){Notifier.parentdocument=parentdocument;}
