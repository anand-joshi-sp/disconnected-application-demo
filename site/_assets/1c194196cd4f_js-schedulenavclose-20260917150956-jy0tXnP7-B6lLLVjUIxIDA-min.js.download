MediumModalPopupWindow({page:AH.PrependBasePath(MakeURL('/client/checkemployerdupe.esp',checkemployerdupeargs)),title:'Possible Employer Duplicates'});}}});}
function Cookie(document,name,domain,path){this.$document=document;this.$name=name;this.$expires=new Date(9999,11,31);this.$path=(path)?path:null;this.$domain=(domain)?domain:null;}
Cookie.prototype.store=function(){var cookieval="";for(var prop in this){if(prop.charAt(0)=='$'||typeof this[prop]=='function'){continue;}
if(cookieval!=""){cookieval+='&';}
cookieval+=prop+':'+escape(this[prop]);}
var cookie=this.$name+'='+cookieval;if(this.$expires)cookie+='; expires='+this.$expires.toGMTString();if(this.$path)cookie+='; path='+this.$path;if(this.$domain)cookie+='; domain='+this.$domain;cookie+='; secure';this.$document.cookie=cookie;}
Cookie.prototype.load=function(){var allcookies=this.$document.cookie;if(allcookies=="")return false;var start=allcookies.indexOf(this.$name+'=');if(start==-1)return false;start+=this.$name.length+1;var end=allcookies.indexOf(';',start);if(end==-1){end=allcookies.length;}
var cookieval=allcookies.substring(start,end);var a=cookieval.split('&');for(var i=0;i<a.length;i++){a[i]=a[i].split(':');this[a[i][0]]=unescape(a[i][1]);}
return true;}
function GetCookieValue(name){var allcookies=document.cookie;var matched=allcookies.match(new RegExp('('+name+')=([^;]*)'));return matched&&RegExp.$1?RegExp.$2:'';}
function SetCookieValue(name,arg){var cookie=new Cookie(document,name,'athenahealth.com','/');cookie.load();for(var value in arg){cookie[value]=arg[value];}
cookie.store();}
function CanonicalFrameSize(args){args=args||{};if(!args.PRESERVEWRAPPERSIZE){var wrapperframeset=AH.getElementById('frWrapper');if(args.SHOWRESUMESESSIONFRAME){if(wrapperframeset){wrapperframeset.rows=sprintf("*,0,%s0%s",AH.GlobalElements&&AH.GlobalElements.GlobalNav?'':'0,',AH.GlobalElements&&AH.GlobalElements.Status?'':',0');}
if(keys(AH.GlobalElements).length){AH.Frames.Top.Frame().HideGlobalElements();}
if(top.jQuery){top.jQuery('div.simplemodal-overlay,div.simplemodal-container').hide();}}
else if(AH.GetGlobal('COMMUNICATOROPERATORSIZE')){wrapperframeset.rows="0,0,32,"+AH.GetGlobal('COMMUNICATOROPERATORSIZE')+",*,26";jQuery(AH.Frames.GlobalNav.Document()).scrollTop(0);}
else if(isDefined(AH.GetGlobal('SSIWIZARD'))||args.HIDEALLGLOBALELEMENTS){wrapperframeset.rows=sprintf("0,0,%s*%s",AH.GlobalElements&&AH.GlobalElements.GlobalNav?'':'0,',AH.GlobalElements&&AH.GlobalElements.Status?'':',0');if(keys(AH.GlobalElements).length){AH.Frames.Top.Frame().HideGlobalElements();}}
else{if(wrapperframeset){wrapperframeset.rows=sprintf("0,0,%s*%s",AH.GlobalElements&&AH.GlobalElements.GlobalNav?'':'32,',AH.GlobalElements&&AH.GlobalElements.Status?'':',26');}
if(keys(AH.GlobalElements).length){AH.Frames.Top.Frame().ShowGlobalElements();}
jQuery(AH.Frames.GlobalNav.Document()).scrollTop(0);if(top.jQuery){top.jQuery('div.simplemodal-overlay,div.simplemodal-container').show();}}}
if(!args.PRESERVECONTENTSIZE){var contentwidth;if(AH.getElementById('frameContent')){contentwidth={framesetScheduleNavWrapper:0,frMainWrapper:jQuery(AH.Wrappers.FrameContentWrapper()).width()-jQuery(AH.Separators.ContentSeparator()).width()};}
else{contentwidth={framesetContent:"0,*"};}
AH.SetContentColumns(contentwidth);}}
function InitOrderSelect(){jQuery("[name='sortable']").sortable({revert:true,helper:"clone"});jQuery("ul, li").disableSelection();}
function OrderSelectUpdateSelected(id){id=EscapeJQuerySelector(id);var itemjq=jQuery('#'+id+'_item');var inputjq=itemjq.children('#'+id+'_input');if(event.srcElement.tagName=='INPUT'){if(inputjq.is(':checked')){itemjq.attr('class','ui-state-selected');}
else{itemjq.attr('class','ui-state-default');}}
else{if(inputjq.is(':checked')){inputjq.prop('checked',false);itemjq.attr('class','ui-state-default');}
else{inputjq.prop('checked',true);itemjq.attr('class','ui-state-selected');}}}
