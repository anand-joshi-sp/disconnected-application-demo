else if(fieldname=='ADDRESS1'){fieldname='ADDRESS';}
jQuery('[name="'+fieldname+'"]:not(.searchfield)').val(field);jQuery('[name="'+fieldname+'"]:not(.searchfield)').trigger('change');jQuery('[name="'+fieldname+'"]:not(.searchfield)').trigger('blur');}}}
