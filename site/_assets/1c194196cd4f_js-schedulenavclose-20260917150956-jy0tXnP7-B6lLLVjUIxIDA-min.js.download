function GetPreferredSchedulingWorkflowLink(legacyLink){var deferred=jQuery.Deferred();CallRemote({SUB:'BusCall::Appointment::GetAppointmentScheduleLink',ARGS:{LEGACYLINK:legacyLink},ONFINISH:function(link){link.APPOINTMENTSCHEDULELINK='/schedule/'+link.APPOINTMENTSCHEDULELINK+'?';deferred.resolve(link);}});return deferred.promise();}
function LoadUserPreferredSchedulingWorkflow(){GetPreferredSchedulingWorkflowLink('findapptframeset.esp').then(function(link){GoPatient(link.APPOINTMENTSCHEDULELINK,document.getElementById('PatientActionMenu_DATA').getAttribute('PATIENTID'),document.getElementById('PatientActionMenu_DATA').getAttribute('CHARTID'));});}
