function _OpenDymoPrinterSelect(args){top.AthenaPattern_Popup.open({CONTENTHTML:args.POPUPHTML,OVERLAYTYPE:'LIGHTBOX',ONCLOSE:function(dymoprinter){if(dymoprinter){var expires=new Date(9999,11,31);var cookie='UNENCRYPTED_DYMOPRINTERNAME='+encodeURIComponent(dymoprinter);cookie+='; expires='+expires.toGMTString();cookie+='; path=/; domain=athenahealth.com';document.cookie=cookie;if(args.ADMENABLED){window.DYMOLabelPrinter.CallPrintWithPrinter(args.LABELURL,args.FIELDS,dymoprinter);}
