function CheckPostDate(postdate){var minvalue=postdate.getAttribute('minvalue');var maxvalue=postdate.getAttribute('maxvalue');var maxpostdate=postdate.getAttribute('maxpostdate');if(!postdate||!postdate.value){return true;}
if(!IsDate(postdate.value)){alert("Post date must be a valid date.");FocusElement({selector:postdate});return false;}else if(minvalue&&maxvalue){var d=new Date(postdate.value);var dmin=new Date(minvalue);var dmax=new Date(maxvalue);if(d<dmin||d>dmax){alert("Post date must be between "+minvalue+" and "+maxvalue+".");FocusElement({selector:postdate});return false;}
if(maxpostdate){var dmaxpostdate=new Date(maxpostdate);if(d<dmaxpostdate){var myMsg=("Continue?  The postdate you have entered is before the postdate of at least "
+"one of the charges appearing on this page.  You have two options:\n"
+"1] Click Cancel and choose postdate "+maxpostdate+" or later.\n"
+"2] Click OK to Continue.  Any charge whose postdate is after "+postdate.value
+" will be posted with the charge's postdate, and not "+postdate.value+".");var warningmessage=postdate.getAttribute('warningmessage');if(warningmessage){myMsg+="  See below for a detailed list of charges and postdates:\n\n"+warningmessage;}
if(!confirmYN(myMsg)){FocusElement({selector:postdate});return false;}}}}
return true;}
