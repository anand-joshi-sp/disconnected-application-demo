catch(e){}}
function SwapBetweenSelects(fromobject,toobject){for(i=0;i<fromobject.length;i++){if(fromobject.options[i].selected){toobject.options[toobject.length]=new Option(fromobject.options[i].text,fromobject.options[i].value);fromobject.options[i--]=null;}}}
function MoveUpInSelect(object){for(i=0;i<object.length;i++){if(i>0&&object.options[i].selected&&!object.options[i-1].selected){SwapWithinSelect(object,i,i-1);object.options[i].selected=false;object.options[i-1].selected=true;}}}
function MoveDownInSelect(object){for(i=object.length-1;i>=0;i--){if(i<(object.length-1)&&object.options[i].selected&&!object.options[i+1].selected){SwapWithinSelect(object,i,i+1);object.options[i].selected=false;object.options[i+1].selected=true;}}}
function SwapWithinSelect(object,index1,index2){var newOption1=new Option(object.options[index1].text,object.options[index1].value);var newOption2=new Option(object.options[index2].text,object.options[index2].value);object.options[index1]=newOption2;object.options[index2]=newOption1;}
function SelectReplaceOptions(theselect,newoptions){if(theselect.tagName!='SELECT'){alert('First argument to SelectReplaceOptions must be a select object');return;}
var lastselected=selectValue(theselect);theselect.options.length=0;var ids=[];for(var option in newoptions){if(option=='_ORDERING')continue;ids.push(option);}
var sortorder=newoptions['_ORDERING'];if(!sortorder){sortorder=ids;sortorder.sort();}
for(var i=0;i<sortorder.length;i++){option=sortorder[i];theselect.options[theselect.options.length]=new Option(newoptions[option],option);}
selectSetValue(theselect,lastselected);}
function SelectReplaceOptionsFromArrays(theselect,newoptionids,newoptionvalues){var counter=0;var newoptions=new Object();newoptions['_ORDERING']=new Array();while(isDefined(newoptionids[counter])){newoptions[newoptionids[counter]]=newoptionvalues[counter];newoptions['_ORDERING'][counter]=newoptionids[counter];counter++;}
SelectReplaceOptions(theselect,newoptions);}
function IsValidPercentRange(percent,min,max){decimalcheck=/\.+/;if(percent.match(decimalcheck)){alert(percent+' contains a decimal. Please enter a percentage with no decimal.');return false;}
if(isNaN(percent)){alert(percent+' is not a valid number.');return false;}
if(!min){min=0;}
if(!max){max=100;}
if(percent>max||percent<min){alert(percent+' is not a valid percentage. Please enter a percentage between '+min+' and '+max+'.');return false;}else{return true;}}
function OneLine(str){return str.replace(/(\s*\n\s*)+/g," ");}
function Assert(condition,message){if(!condition){alert(message+'\n\n'+StackTrace(1));}}
function ElementSummary(theelement){try{return theelement.outerHTML.match(/(<[^>]*>)/)[1];}
catch(e){}}
