function DelayForFrameLoad(framepath,action){if(!DelayForFrameLoad.Cache){DelayForFrameLoad.Cache=[];}
if(!DelayForFrameLoad.Cache[framepath]){DelayForFrameLoad.Cache[framepath]=[];}
if(!isDefined(DelayForFrameLoad.Cache[framepath].RetryCount)){DelayForFrameLoad.Cache[framepath].RetryCount=0;}
if(!DelayForFrameLoad.Cache[framepath].Actions){DelayForFrameLoad.Cache[framepath].Actions=[];}
if(action){DelayForFrameLoad.Cache[framepath].Actions.push(action);}
var frame;try{eval('frame = '+framepath+';');}
catch(e){ReportError(e,"Couldn't get frame")};var ready=0;try{ready=frame&&frame.document&&frame.document.readyState=='complete';}
catch(e){}
if(ready){for(var i=0;i<DelayForFrameLoad.Cache[framepath].Actions.length;i++){var action=DelayForFrameLoad.Cache[framepath].Actions[i];try{action();}
catch(e){ReportError(e,"Error while executing action for ["+framepath+"]: ["+action+"]");};}
DelayForFrameLoad.Cache[framepath].RetryCount=0;DelayForFrameLoad.Cache[framepath].Actions=[];}
else if(DelayForFrameLoad.Cache[framepath].RetryCount<100){DelayForFrameLoad.Cache[framepath].RetryCount++;setTimeout(function(){DelayForFrameLoad(framepath)},250);}
else{DelayForFrameLoad.Cache[framepath].RetryCount=0;}}
