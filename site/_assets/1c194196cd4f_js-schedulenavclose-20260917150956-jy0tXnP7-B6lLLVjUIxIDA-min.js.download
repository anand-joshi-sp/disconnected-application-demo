function MoveDown(selectbox){with(selectbox){for(i=length-2;i>=0;i--){if(i<(length-1)&&options[i].selected&&!options[i+1].selected){MoveWithinSelect(selectbox,i,i+1);options[i+1].selected=true;options[i].selected=false;}}}}
