function CheckReferralForm(){if(document.zform.REFERRALAUTHID&&document.zform.REFERRALAUTHID.value!='NEW'){return true;}
if(document.zform.VISITSAPPROVED){if(isNaN(document.zform.VISITSAPPROVED.value)){alert('Visits Approved must be a number');return false;}
if(document.zform.VISITSLEFT&&isNaN(document.zform.VISITSLEFT.value)){alert('Visits Left must be a number');return false;}
if(document.zform.TYPEOFSERVICEID&&isNaN(document.zform.TYPEOFSERVICEID.value)){alert('Type of service must be a numeric code.');return false;}
if(document.zform.REFERRALAUTHNUMBER.value==''&&document.zform.REFERRINGPROVIDERID.value==''){alert('Referral auth number and Referring provider cannot both be blank.');return false;}
if(document.zform.STARTDATE&&(document.zform.STARTDATE.value!=''&&!IsDate(document.zform.STARTDATE.value))){alert('Please enter a valid start date.');eval('document.zform.STARTDATE.focus()')
return false;}
if(document.zform.EXPIRATIONDATE&&(document.zform.EXPIRATIONDATE.value!=''&&!IsDate(document.zform.EXPIRATIONDATE.value))){alert('Please enter a valid expirationdate date.');eval('document.zform.EXPIRATIONDATE.focus()')
return false;}}
return true;}
