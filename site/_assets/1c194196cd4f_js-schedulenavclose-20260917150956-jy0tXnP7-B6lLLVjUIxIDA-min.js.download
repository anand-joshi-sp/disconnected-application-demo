else if(framework=='ADM'){if(!window.DYMOLabelPrinter){window.admdymomoduleregistered=false;window.admdymomoduleisprinting=false;window.admdymoprintertouse='';window.admdymolabels=[];window.currentlabel;window.DYMOLabelPrinter=(function(){var module={name:"DYMOLabelPrinter",onregister:function(){window.admdymomoduleregistered=true;ADMPrintQueuedLabel();},events:{PrintResponse:function(response){var connecteddymoprinters;try{connecteddymoprinters=JSON.parse(response.Data);LogDymoUser(framework);OpenDymoPrinterSelect({CONNECTEDDYMOPRINTERS:connecteddymoprinters,LABELURL:window.currentlabel.labelurl,FIELDS:window.currentlabel.fields,ADMENABLED:true});}
catch(e){if((!response.Data||response.Data.length==0)||(response.Data&&!/^You must install the software/.test(response.Data))){LogDymoUser(framework);}
