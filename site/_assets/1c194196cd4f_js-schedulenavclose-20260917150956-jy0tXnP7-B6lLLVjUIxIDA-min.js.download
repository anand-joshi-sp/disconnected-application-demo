function UpdateTaskbarForAppointment(apptdate,apptid,deptid){if(!isDefined(apptdate)||!isDefined(apptid)||!isDefined(deptid)||!AH.IsMain||!AH.Frames.ScheduleNav||!AH.Frames.ScheduleNav.IsVisible()){return false;}
var schedulenavlocation=AH.Frames.ScheduleNav.GetLocation().toString();if(schedulenavlocation.match(/schedulenavbilling.esp/)){AH.Frames.ScheduleNav.Reload();return;}
