function AthenaNetHelp(pagename,pagepath){var path=document.location.pathname;var helpkey=document.helpkey;if(typeof(pagepath)!='undefined'){path=pagepath;helpkey=pagename;pagename=null;}
CallRemote({SUB:'BusCall::CustomerCare::GetHelpKey',ARGS:{PAGENAME:pagename,HELPKEY:helpkey,PATH:path},ONFINISH:function(helpurl){if(AH.GetGlobal('OHelpWindow')&&!AH.GetGlobal('OHelpWindow').closed){AH.GetGlobal('OHelpWindow').close();}
AH.SetGlobal('OHelpWindow',window.open(helpurl,'ohelp','titlebar=1, directories=no, location=no, menubar=no, status=yes, toolbar=no, top=0, left=0, scrollbars=yes, resizable=yes'));}});return false;}
