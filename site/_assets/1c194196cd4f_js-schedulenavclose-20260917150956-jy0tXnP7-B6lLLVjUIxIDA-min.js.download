function ZipCodeLookup(zipinput,prefix,onfinish,lookupbyname,postfix,modifycountry){CallRemote({SUB:'AthenaUtils::ZipCodeLookup',ARGS:{ZIPCODE:zipinput.value},ONFINISH:function(info){if(info){if(lookupbyname){if(document.getElementsByName(prefix+'CITY'+postfix)[0]){document.getElementsByName(prefix+'CITY'+postfix)[0].value=info.CITY;}
if(document.getElementsByName(prefix+'STATE'+postfix)[0]){document.getElementsByName(prefix+'STATE'+postfix)[0].value=info.STATE;}
if(document.getElementsByName(prefix+'GPCILOCATIONID'+postfix)[0]){document.getElementsByName(prefix+'GPCILOCATIONID'+postfix)[0].value=info.GPCILOCATIONID;}
if(document.getElementsByName(prefix+'GPCILOCATIONNAME'+postfix)[0]){document.getElementsByName(prefix+'GPCILOCATIONNAME'+postfix)[0].innerText=info.GPCILOCATIONNAME;}}
else{if(document.getElementById(prefix+'CITY'+postfix)){document.getElementById(prefix+'CITY'+postfix).value=info.CITY;}
if(document.getElementById(prefix+'STATE'+postfix)){document.getElementById(prefix+'STATE'+postfix).value=info.STATE;}
if(document.getElementById(prefix+'GPCILOCATIONID'+postfix)){document.getElementById(prefix+'GPCILOCATIONID'+postfix).value=info.GPCILOCATIONID;}
if(document.getElementById(prefix+'GPCILOCATIONNAME'+postfix)){document.getElementById(prefix+'GPCILOCATIONNAME'+postfix).innerText=info.GPCILOCATIONNAME;}}
var countryobj=document.getElementsByName(prefix+'COUNTRY'+postfix)[0]||document.getElementsByName(prefix+'COUNTRYID'+postfix)[0];if(modifycountry&&countryobj){countryobj.value='1';countryobj.onchange();}}
eval(onfinish);}});}
function IsZip(zipcode){if(!zipcode.match(/^\d{5}$/g)&&!zipcode.match(/^\d{5}-\d{4}$/g)){return false;}else{return true;}}
var IsState=(function(){var allstates=undefined;return function(state){state=state.toUpperCase();if(!state.match('^[A-Z]{2}$','g')){return false;}
if(!allstates){allstates={AA:true,AE:true,AK:true,AL:true,AP:true,AR:true,AS:true,AZ:true,CA:true,CO:true,CT:true,DC:true,DE:true,FL:true,FM:true,GA:true,GU:true,HI:true,IA:true,ID:true,IL:true,IN:true,KS:true,KY:true,LA:true,MA:true,MD:true,ME:true,MH:true,MI:true,MN:true,MO:true,MP:true,MS:true,MT:true,NC:true,ND:true,NE:true,NH:true,NJ:true,NM:true,NV:true,NY:true,OH:true,OK:true,OR:true,PA:true,PR:true,PW:true,RI:true,SC:true,SD:true,TN:true,TX:true,UT:true,VA:true,VI:true,VT:true,WA:true,WI:true,WV:true,WY:true};}
if(!allstates[state]){return false;}
return true;};})();function IsStateAlert(stateinput){var value=stateinput.value.toUpperCase();stateinput.value=value;if(value.length&&!IsState(value)){alert(stateinput.value+' is not a valid state abbreviation.');stateinput.focus();return false;}
return true;}
function CheckUSState(stateinputid,countryvalue,usaid,validationmessage){var hidden=jQuery('#'+stateinputid);var select=jQuery('#'+stateinputid+'_select');var text=jQuery('#'+stateinputid+'_text');var statevalue;if(select.length&&select.is(':visible')){statevalue=select.find('option').filter(':selected').val();hidden.val(statevalue);if((!countryvalue.length||countryvalue==usaid)&&statevalue.length&&!IsState(statevalue)){alert(validationmessage);select.focus();return false;}}
else if(text.length&&text.is(':visible')){hidden.val(text.val());}
