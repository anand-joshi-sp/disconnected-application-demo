function launchNewRegEmbeddedAppFromRegisterFamilyMember(patientId){launchNewRegEmbeddedAppForRegisterFamilyMember("family billing",patientId);}
function logExpressRegAmplitudeEvent(launchLocation){require(['shared:/scripts/athena/utils/cross_frame_events'],function(CrossFrameEventsUtils){CrossFrameEventsUtils.trigger('user-tracking.track-event',{rollout_toggle_key:"AMPLITUDE_ANALYTICS",event_type:"expressreg",event_properties:{page:launchLocation,component:"launch link",action:"click"}});});}
