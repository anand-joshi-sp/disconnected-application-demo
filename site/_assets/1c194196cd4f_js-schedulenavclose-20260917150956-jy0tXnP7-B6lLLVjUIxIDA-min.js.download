+'Verify that you are using the latest version of athenaNet Device Manager from the Device Management page (under Settings).';}
module.error(errormessage);}
else{module.error();}
window.admdymomoduleisprinting=false;if(window.admdymolabels.length>0){ADMPrintQueuedLabel();}}}},calls:{Print:'PrintResponse',PrintWithPrinter:'PrintResponse'}};ADM.RegisterModule(module);return{CallPrint:function(printlabelurl,fields,usedefaultprinter){module.error();module.admerror();module.donotcheckconnectivity=true;module.calls.Print({labelURL:printlabelurl,JSONObjectText:JSON.stringify(fields),useDefaultPrinter:!!usedefaultprinter});},CallPrintWithPrinter:function(printlabelurl,fields,printer){module.error();module.admerror();module.donotcheckconnectivity=true;window.admdymoprintertouse=printer;module.calls.PrintWithPrinter({labelURL:printlabelurl,JSONObjectText:JSON.stringify(fields),printer:printer});}};})();}
