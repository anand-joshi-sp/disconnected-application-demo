else if(cctype=='diag'){searchtype='ICD9DX';name='ICD-9 DIAG';}
else if(cctype=='ndc'){searchtype='Pharmaceutical';name='Pharmaceutical';}
else if(cctype=='icd10diag'){searchtype='ICD10CM';name='ICD-10 DIAG';}
