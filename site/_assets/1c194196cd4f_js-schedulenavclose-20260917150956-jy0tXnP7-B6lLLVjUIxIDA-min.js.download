input.value=ID;text.innerHTML=name?name:noselectiontext?noselectiontext:'(none)';span.clinicalfindingsentenceid=response[2];changed=(value!=input.value);}
args.ONSELECT(changed);try{link.focus();}
catch(e){}
return changed;};if(modalpagename=='/clinicalsadmin/clinicaltemplatepicker.esp'){modallength=600;modalwidth=625;MediumModalPopupWindow({page:modalpath,title:'Choose '+entitylabel,additionalargs:{resizable:1},onclose:function(results){onclose(results);}});}
