if(!isDefined(callback)){if(AH.GetGlobal('useractive')&&isDefined(AH.GetGlobal('timeoutupdated'))){var pinginterval=130;var sinceupdated=time-AH.GetGlobal('timeoutupdated');var untiltimeout=GetTimeoutCookie()-sinceupdated;if(sinceupdated>=pinginterval||untiltimeout<=pinginterval/2){callback=function(){};}else{return;}}else{return;}}
