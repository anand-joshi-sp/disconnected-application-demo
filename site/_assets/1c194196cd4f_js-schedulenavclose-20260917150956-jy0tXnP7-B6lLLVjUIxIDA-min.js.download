var RunBenchmark=(function(){var _Benchmark,_loading=false,_loadfailed=false,_queue=[];function _LoadBenchmark(deferredtests){if(_loadfailed){console.log('benchmark.js failed to load');return;}
_queue.push(deferredtests);if(_loading)return;_loading=true;if(!document.body.javaTimer){var appletdiv=document.createElement('div');appletdiv.innerHTML="<applet name='javaTimer' code='nano' archive='"+GetStaticURL('thirdparty/nano.jar')+"'>";document.body.appendChild(appletdiv);console.log('Java timer loaded.');}
var benchmark=document.createElement('script');benchmark.setAttribute('type','text/javascript');benchmark.setAttribute('src',GetStaticURL('thirdparty/benchmark.js'));document.getElementsByTagName('head')[0].appendChild(benchmark);console.log('loading benchmark.js');var _attempts=0;var _Wait=function(){if(_attempts++>10){console.log('benchmark.js failed to load');_loadfailed=true;_queue=[];}
else{setTimeout(function(){try{_Benchmark=require('Benchmark');}
catch(err){}
