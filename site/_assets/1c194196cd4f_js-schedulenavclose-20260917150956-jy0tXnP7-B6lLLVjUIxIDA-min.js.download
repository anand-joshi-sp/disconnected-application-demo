parentdiv=parentdiv.parentElement;}
return parentdiv;}
catch(e){DisplayError(e,"GetParentDiv: Exception caught:");}}
function GetParent(){var argarray=[];for(var i=0;i<arguments.length;i++){argarray.push(arguments[i]);}
var child=argarray.shift();var requirements=_GetRequirementsFromArray(argarray);var parent;if(child){parent=child.parentElement;}
else{return void(0);}
PARENTS:while(parent){if(_ElementMeetsRequirements(parent,requirements)){return parent;}
parent=parent.parentElement;}
return void(0);}
function SetParent(theelement,theparent,where){var detachedelement=jQuery(theelement).detach();where=where.toUpperCase();if(where=='BEFOREEND'){detachedelement.appendTo(theparent);return theparent.children[theparent.children.length-1];}
else if(where=='AFTERBEGIN'){detachedelement.prependTo(theparent);return theparent.children[0];}
else{return void(0);}}
function IsParent(parent,child){if(parent&&child){var potentialparent=child.parentElement;while(potentialparent){if(parent===potentialparent){return 1;}
potentialparent=potentialparent.parentElement;}}
return 0;}
function AddElement(parent,where,tagname,id){var tagtext;if(id){tagtext="<"+tagname+" id="+id+"></"+tagname+">";}
else{tagtext="<"+tagname+"></"+tagname+">";}
parent.insertAdjacentHTML(where,tagtext);var children=GetChildren(parent,'tagName',tagname);where=where.toUpperCase();if(where=='BEFOREEND'){return children[children.length-1];}
else if(where=='AFTERBEGIN'){return children[0];}
else{return void(0);}}
function FunctionExists(functionname){if(window[functionname]){return true;}
else{return false;}}
var hiddenframequeue=[];var hiddenframetaskuniqueid=0;var hiddenframelatch=0;var hiddenframecurrentid;var hiddenframecallback;var latchtimeout=20*1000;var servercycle=100;function QueueHiddenFrameRequest(url,callback){var request=[];request.url=url;request.callback=callback;request.uniqueid=++hiddenframetaskuniqueid;hiddenframequeue.push(request);HiddenFrameServeOneRequest();return request.uniqueid;}
function CancelHiddenFrameRequest(uniqueid){if(hiddenframecurrentid==uniqueid){hiddenframecallback=function(){;};hiddenframelatch=0;}
for(var i=0;i<hiddenframequeue.length;i++){if(hiddenframequeue[i].uniqueid==uniqueid){hiddenframequeue.splice(i,1);break;}}}
function HiddenFrameServeOneRequest(){var hiddenframe=AH.Frames?AH.Frames.Hidden.Frame():top.frHidden;if(!hiddenframelatch&&hiddenframequeue.length){var now=new Date();hiddenframelatch=now.getTime();var request=hiddenframequeue.shift();hiddenframecurrentid=request.uniqueid;hiddenframecallback=request.callback;hiddenframe.location=request.url;try{hiddenframe.document.body.oldframestillloaded=true;}
catch(err){}
setTimeout("HiddenFrameLoadedCheck()",servercycle);setTimeout("HiddenFrameLatchTimeout()",latchtimeout);}
if(hiddenframequeue.length>0){setTimeout("HiddenFrameServeOneRequest()",servercycle);}}
function HiddenFrameLoadedCheck(){var notyetunloaded;var hiddenframedocument=AH.Frames?AH.Frames.Hidden.Document():top.frHidden.document;try{notyetunloaded=hiddenframedocument.readyState!='complete'||hiddenframedocument.body.oldframestillloaded;}
catch(e){notyetunloaded=1;}
if(notyetunloaded){setTimeout("HiddenFrameLoadedCheck()",servercycle);}
else{hiddenframelatch=0;hiddenframecurrentid=0;if(isFunction(hiddenframecallback)){hiddenframecallback();}}}
function HiddenFrameLatchTimeout(){var now=new Date();if(hiddenframelatch&&now.getTime()-hiddenframelatch>=latchtimeout){hiddenframelatch=0;}}
function ExportDynamicFunctions(htmlnode){var scripts=GetChildren(htmlnode,'tagName','script');for(var i=0;i<scripts.length;i++){EvalInGlobalNamespace(scripts[i].text);}}
function EvalInGlobalNamespace(text,args){var withobj=(args&&args.withobj)?args.withobj:window;try{if(text!=''){if(window.execScript){withobj.execScript(text);}
else{eval.call(withobj,text);}}}
catch(e){var error=new Error([e.message,'\nFrom EvalInGlobalNamespace:\n',text].join(''));error.errormessage=e.errormessage;throw(error);}}
function EvaluateScriptTags(html,args){var re=/<script[^>]*>([\s\S]*?)<\/+script>/gi;var match;while((match=re.exec(html))!=null){var scriptbody=match[1];EvalInGlobalNamespace(scriptbody,args);}}
function StripScriptTags(html){var re=/<script[^>]*>([\s\S]*?)<\/+script>/gi;return html.replace(re,'');}
var FdatValueCache={};function FdatValue(inputname,form){if(!isDefined(form)){form=document.forms[0];}
Assert(isDefined(form),"Couldn't get a form context");if(!isDefined(FdatValueCache[form.name])){FdatValueCache[form.name]={};}
if(!isDefined(FdatValueCache[form.name][inputname])){FdatValueCache[form.name][inputname]=GetChildren(form,'name',inputname,'tagName',['INPUT','TEXTAREA','SELECT']);}
var activeinputs=[];for(var i=0;i<FdatValueCache[form.name][inputname].length;i++){var input=FdatValueCache[form.name][inputname][i];if(!input.disabled){if((!(input.type=='checkbox'||input.type=='radio')||input.checked)){activeinputs.push(input);}}}
var value=activeinputs.map(function(){return InputValue(this)}).join('\t');return value;}
function SetInputValue(input,value){if(input.tagName!='INPUT'&&input.tagName!='TEXTAREA'&&input.tagName!='SELECT'){alert("SetInputValue doesn't know how to set a value for "+input+"\nStack trace:\n"+StackTrace());return;}
if(jQuery(input).parent().hasClass("checkboxgroup")){SetCheckBoxGroupValue(input,value);}
else if(input.type=='checkbox'){input.checked=value?true:false;}
else if(input.tagName=='SELECT'){if(input.getAttribute('multiline')){if(value){var options=jQuery(input).siblings('.MultiLineSelect').children();for(var i=0;i<options.length;i++){if(jQuery(options[i]).attr('value')==value){MultiLineSelect.Choose(options[i]);return;}}}
else{input.options[0].value='';input.options[0].text=input.getAttribute('nulltext')||'';}
return;}
var values=isArray(value)?value:[value];for(var i=0;i<input.options.length;i++){input.options[i].selected=InList(input.options[i].value,values);}}
else{input.value=value;}}
function DateAdd(date,days){var ms_since_epoch=Date.parse(date);var new_date=new Date(ms_since_epoch+days*24*60*60*1000);return(new_date.getMonth()+1)+'/'+new_date.getDate()+'/'+new_date.getFullYear();}
function AddDays(date,days){var dateConverted=new Date(Date.parse(date));dateConverted.setDate(dateConverted.getDate()+days);return dateConverted.toLocaleDateString('en-US',{month:'2-digit',day:'2-digit',year:'numeric'});}
function DateDiff(date1,date2){if(date1 instanceof Date){date1=date1.toDateString();}
if(date2 instanceof Date){date2=date2.toDateString();}
var fromDate=Date.parse(date1);var toDate=Date.parse(date2);return Math.round((toDate-fromDate)/864e5);}
function Date1IsLaterThanOrEqualToDate2(date1,date2){var delta=DateDiff(date2,date1);return delta>=0?true:false;}
function ContainsWhiteSpace(checkstring){var regexp=new RegExp("\\s");return regexp.test(checkstring);}
function DeSelectDefaultOption(selectinput,defaultvalue){var selected=new Array();var counter=0;for(i=0;i<selectinput.length;i++){if(selectinput.options[i].selected){selected[counter]=selectinput.options[i].value;counter++;}}
if(selected.length>1){for(i=0;i<selectinput.length;i++){if(selectinput.options[i].selected&&selectinput.options[i].value==defaultvalue){selectinput.options[i].selected=false;break;}}}}
