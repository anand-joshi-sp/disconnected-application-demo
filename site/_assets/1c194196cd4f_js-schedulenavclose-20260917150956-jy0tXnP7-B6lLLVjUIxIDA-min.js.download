if(AH.Frames.ScheduleNav.GetLocation().toString().match(/chartabstractionnav/)){var newpage=AH.Frames.ScheduleNav.GetLocation().toString();if(document.referrer&&document.referrer.match(/chartabstractionnav/)){return false;}
if(newpage.match(/SCROLLTOP=\d+/)){newpage=newpage.replace(/SCROLLTOP=\d+/,'SCROLLTOP='+AH.Frames.ScheduleNav.Document().body.scrollTop);}
else{newpage+="?SCROLLTOP="+AH.Frames.ScheduleNav.Document().body.scrollTop;}
AH.Frames.ScheduleNav.SetLocation(newpage);}
else{return false;}}
