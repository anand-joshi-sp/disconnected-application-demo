function ToggleStateInputs(args){AssertFields(args,['STATEINPUTID','COUNTRYINPUTID','USAID'],['CLEARVALUES','STATELABEL','ZIPLABEL','ZIPLOOKUPLINK','CITYINPUTID','ZIPINPUTID']);var hidden=jQuery('#'+args.STATEINPUTID);var select=jQuery('#'+args.STATEINPUTID+'_select');var textinput=jQuery('#'+args.STATEINPUTID+'_text');var country=jQuery('#'+args.COUNTRYINPUTID);var statelabel=args.STATELABEL?jQuery('#'+args.STATELABEL):'';var ziplabel=args.ZIPLABEL?jQuery('#'+args.ZIPLABEL):'';var ziplookuplink=args.ZIPLOOKUPLINK?jQuery('#'+args.ZIPLOOKUPLINK):'';var cityinput=args.CITYINPUTID?jQuery('#'+args.CITYINPUTID):'';var zipinput=args.ZIPINPUTID?jQuery('#'+args.ZIPINPUTID):'';var usstatetext='State';var foreignstatetext='State or province';var usziptext='ZIP code';var foreignziptext='Postal code';if(hidden.length&&select.length&&textinput.length){if(!country.length||!country.is(':visible')||!country.find('option').filter(':selected').val()||country.val()==args.USAID){textinput.hide();select.show();if(statelabel.length){statelabel.text(usstatetext);}
