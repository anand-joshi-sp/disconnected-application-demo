function ToggleDropdown(id){RefreshFacit();AH.SetGlobal('activecomponent',id);var dropdown=_FetchElementByID(id);if(dropdown.style.display!=="block"){ShowDropdown(dropdown);}else{HideDropdown(dropdown);}
return false;}
function BarItemMouseOver(baritem){if(baritem.className=='inactive'||baritem.className==''){baritem.className='active';if(isDefined(AH.GetGlobal('menubaractive'))&&AH.GetGlobal('menubaractive')!==''){var newdropdownid=baritem.id.split('_')[0]+'_'+baritem.id.split('_')[1];if(AH.GetGlobal('menubaractive')==newdropdownid){return;}
var olddropdown=document.getElementById(AH.GetGlobal('menubaractive'));HideDropdown(olddropdown);var newdropdown=_FetchElementByID(newdropdownid);ShowDropdown(newdropdown);}}}
function BarItemMouseOut(baritem){if(baritem.className=='active'){baritem.className='inactive';}}
function ShowDropdown(dropdown){var sourceelement=_FetchJqueryElementByID(dropdown.id+'_span');var offset=sourceelement.offset();var dropdownoffset={top:offset.top+sourceelement.outerHeight(),left:offset.left};if(dropdownoffset.left+jQuery(dropdown).outerWidth()>AH.Frames.Main.Document().body.clientWidth){dropdownoffset.left=AH.Frames.Main.Document().body.clientWidth-jQuery(dropdown).outerWidth();}
jQuery(dropdown).show().offset(dropdownoffset).offset(dropdownoffset);dropdown.focus();var baritem=_FetchElementByID(dropdown.id+'_span');baritem.className='fixedactive';AH.SetGlobal('menubaractive',dropdown.id);}
function HideDropdown(dropdown){if(dropdown.style.display=="none"){return;}
dropdown.style.display="none";var baritem=_FetchElementByID(dropdown.id+'_span');baritem.className='inactive';AH.SetGlobal('menubaractive','');}
function _FetchElementByID(id){var element=AH.Frames.Main.getElementById(id);if(!element){element=document.getElementById(id);}
return element;}
function _FetchJqueryElementByID(id){var sourceelement=jQuery('#'+id,AH.Frames.Main.Document());if(sourceelement.length==0){sourceelement=jQuery('#'+id,document);}
return sourceelement;}
function GoPatient(url,patientid,chartid,title,id,departmentid,providergroupid,claimid){var chartidstring=isDefined(chartid)&&!isNull(chartid)?'&CHARTID='+chartid:'';var departmentidstring=isDefined(departmentid)&&!isNull(departmentid)?'&DEPARTMENTID='+departmentid:'&DEPARTMENTID='+AH.GetGlobal('DEPARTMENTID');var providergroupidstring=isDefined(providergroupid)&&!isNull(providergroupid)?'&PROVIDERGROUPID='+providergroupid:'';var claimidstring=isDefined(claimid)&&!isNull(claimid)?'&CLAIMID='+claimid:'';if(title){var idvalue=id||title;var newurl=escape(url+'PATIENTID='+patientid+chartidstring);AH.Frames.Main.SetLocation(AH.PrependBasePath('/clinicals/charttabs.esp?PATIENTID='+patientid+chartidstring+'&ID='+idvalue+'&TITLE='+title+'&URL='+newurl));}
else{document.location.href=AH.PrependBasePath(url+'PATIENTID='+patientid+chartidstring+departmentidstring+providergroupidstring+claimidstring);}}
function AutoScroll(forcescroll,object){if(AH.UserPreferences){var autoscroll=AH.GetUserPreference('ENABLEENCOUNTERAUTOSCROLL');if(!autoscroll||autoscroll==0){return;}}
var ycoordinate;if(event.srcElement.type=='text'){ycoordinate=parseInt(event.clientY-event.offsetY);}else{ycoordinate=parseInt(event.clientY);}
var bodyheight=document.body.clientHeight;if(ycoordinate&&bodyheight){var edgeheight=parseInt(bodyheight/5);var topthird=parseInt(bodyheight/3);var diffvalue;var temp=object;var top=object.offsetHeight;var scrollobj;while(temp){if(temp.tagName=='DIV'&&temp.currentStyle!=null&&(temp.currentStyle.overflow=='auto'||temp.currentStyle.overflow=='scroll')){scrollobj=temp;break;}
temp=temp.parentNode;}
if(typeof scrollobj!='undefined'){var tempobject=object;var top=tempobject.offsetHeight;while(tempobject){if(tempobject==scrollobj){break;}
top+=tempobject.offsetTop;tempobject=tempobject.offsetParent;}
ycoordinate=eval(top-scrollobj.scrollTop);bodyheight=scrollobj.offsetHeight;edgeheight=parseInt(bodyheight/3);topthird=parseInt(bodyheight/3);}
if(forcescroll||(ycoordinate>bodyheight-edgeheight)||(ycoordinate<edgeheight)){var scrolldistance=ycoordinate-topthird;if(typeof scrollobj!='undefined'){if(scrolldistance<0&&scrollobj.scrollTop==0){return false;}
setTimeout(function(){ScrollTo(scrolldistance,scrollobj);},2);}
else{setTimeout(function(){Scroll(scrolldistance);},2);}}}
return 0;}
