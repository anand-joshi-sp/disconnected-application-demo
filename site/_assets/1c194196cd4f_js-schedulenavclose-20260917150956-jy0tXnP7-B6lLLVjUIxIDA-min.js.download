function FormHash(form,args){if(!args){args={};}
var output=args.EXISTINGOUTPUT;if(!output){output={};}
var inputs=JQueryMultiFind(['input','select','textarea'],form);var changed=0;for(var i=0;i<inputs.length;i++){var input=inputs[i];if(!changed&&!(args.ONLYCHANGED&&InputValue(input)==InputDefaultValue(input))){changed=1;}
if(args.ONLYCHANGED&&args.RESETDEFAULTVALUE){input.DefaultValue=InputValue(input);}
if(InList(input.type,['checkbox','radio'])&&!input.checked){continue;}
if(input.disabled){continue;}
var newvalue=InputValue(input);if(args.NOPOSTBLANK&&!newvalue&&!input.getAttribute('postblank')){continue;}
if(isDefined(output[input.name])){output[input.name]+="\t";}
else{output[input.name]="";}
output[input.name]+=typeof newvalue!='undefined'?newvalue:"";if(output[input.name]===""){output[input.name]="";}}
if(changed){return output;}
else{return'';}}
function SaveCheckIn(args){if(document.location.toString().match(/(apptworkflow|checkin)/)&&PageChangedSinceLoad()&&document.zform){var formdata=FormHash(document.zform,{ONLYCHANGED:1,RESETDEFAULTVALUE:1});if(formdata){CallRemote({SUB:'Appointment::SaveCheckIn',ARGS:{ID:formdata.ID,APPOINTMENTUPDATE:formdata,DONTPROCESSPAYMENTS:1},ONFINISH:args.ONFINISH});}}
else{args.ONFINISH()}}
