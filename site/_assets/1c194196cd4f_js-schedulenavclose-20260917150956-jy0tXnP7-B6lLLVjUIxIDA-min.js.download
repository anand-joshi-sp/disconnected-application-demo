function SelectOptionsFromTableHash(theselect,tablehash){var ordering=[];var options=[];for(var i=0;i<tablehash.length;i++){ordering.push(tablehash[i].ID);options[tablehash[i].ID]=tablehash[i].NAME;}
options['_ORDERING']=ordering;SelectReplaceOptions(theselect,options);}
