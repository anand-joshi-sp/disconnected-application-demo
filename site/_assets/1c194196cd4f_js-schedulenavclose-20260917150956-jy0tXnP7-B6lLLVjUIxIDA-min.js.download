GoPatient(url,document.getElementById('PatientActionMenu_DATA').getAttribute('PATIENTID'),document.getElementById('PatientActionMenu_DATA').getAttribute('CHARTID'));});}
function RefreshWorklistOnUpdate(refreshargs,updateeditargs,athenarefreshargs){try{if(top.window.opener&&top.window.opener.location&&top.window.opener.WorklistRecord){if(/billing\/teamworklistdashboard/.test(top.window.opener.location)){top.window.opener.WorklistRecord.UpdateEditRecords(updateeditargs.CONTEXTID,updateeditargs.USERNAME,updateeditargs.WORKLISTIDS);if(top.window.opener.WorklistInbox){top.window.opener.WorklistInbox.RefreshDashboard({TABLE:'myclaims'});}
else{top.window.opener.WorklistRecord.Refresh(refreshargs.CONTEXTID,refreshargs.WORKLISTIDS);}}
else if(/cbo\/teamworklistdashboard/.test(top.window.opener.location)){top.window.opener.WorklistRecord.Refresh(athenarefreshargs.CONTEXTID,athenarefreshargs.WORKLISTIDS);}}}
catch(err){}}
function launchFormsOnDemandApp(config){try{var NimbusBundleLoader=require('base:/scripts/athena/nimbus/bundle_loader');var embeddedappsversion;CallRemote({SUBSYSTEM:'Nimbus',SUB:'GetApplicationVersion',ARGS:{USERNAME:AH.GetGlobal('USERNAME'),APPNAME:'embedded-app-launcher'},ONFINISH:function(version){embeddedappsversion=version;var props={contextId:AH.Frames.GlobalNav.GetGlobal('contextid'),anetUser:AH.GetGlobal('USERNAME'),departmentId:AH.GetGlobal('DEPARTMENTID'),patientId:+AH.GetGlobal('PATIENTID'),config:config};(function(){NimbusBundleLoader.load({cdnName:'nimbus',packageName:'embedded-app-launcher',version:embeddedappsversion}).then(function(embeddedAppLauncherBundle){embeddedAppLauncherBundle.getCachedEmbeddedAppsForSpace({appSpaceKey:"ENCOUNTERCARD_SCREENING"})
.then(function(apps){var fodApp=apps.find(function(app){return app.displayName==='Forms On Demand';});if(fodApp){fodApp.launchAppIntoAppDock({propsFromLaunchLocation:props});}else{throw new Error('Forms on Demand App Not Found');}});});})();}});}catch(error){console.error('Error launching Forms On Demand App:',error);}}
function launchFormsOnDemandAppForRegisterationMenu(){var config={forms:{appointmentExcluded:true},screeners:{disabled:true}};launchFormsOnDemandApp(config);}
function launchFormsOnDemandAppForClinicalsMenu(){var config={forms:{appointmentExcluded:true},screeners:{disabled:false}};launchFormsOnDemandApp(config);}
function launchExpressRegEmbeddedApp(launchLocation,propsFromLaunchLocation){try{var NimbusBundleLoader=require("base:/scripts/athena/nimbus/bundle_loader");var embeddedappsversion;CallRemote({SUBSYSTEM:"Nimbus",SUB:"GetApplicationVersion",ARGS:{USERNAME:AH.GetGlobal("USERNAME"),APPNAME:"embedded-app-launcher"},ONFINISH:function(version){embeddedappsversion=version;(function(){NimbusBundleLoader.load({cdnName:"nimbus",packageName:"embedded-app-launcher",version:embeddedappsversion}).then(function(embeddedAppLauncherBundle){embeddedAppLauncherBundle
.getCachedEmbeddedAppsForSpace({appSpaceKey:"APPS_DRAWER"})
.then(function(apps){var xpr=apps.find(function(app){return app.packageName==="express-patient-registration-ui";});if(xpr){if(propsFromLaunchLocation){xpr.launchAppIntoAppDock({propsFromLaunchLocation:propsFromLaunchLocation});}else{xpr.launchAppIntoAppDock();}
logExpressRegAmplitudeEvent(launchLocation);}else{throw new Error("app not available in app drawer");}}).catch(function(error){console.error("[prn] ["+launchLocation+"] Issue finding Registration App:",error);});}).catch(function(error){console.error("[prn] ["+launchLocation+"] Issue loading embedded-app-launcher:",error);});})();},ONERROR:function(error){var additionalInfo=error&&error.HTTPSTATUS?": Remote call failed with status: ["+error.HTTPSTATUS+"]":'';console.error("[prn] ["+launchLocation+"] Issue getting embedded-app-launcher version"+additionalInfo);}});}catch(error){console.error("[prn] ["+launchLocation+"] Issue launching Registration App:",error);}}
function launchExpressRegEmbeddedAppFromPatientMenu(){launchExpressRegEmbeddedApp("patients menu");}
function launchExpressRegEmbeddedAppFromNewPatientReg(){launchExpressRegEmbeddedApp("fullreg");}
function launchNewRegEmbeddedAppForRegisterFamilyMember(launchLocation,patientId){patientId=+patientId;if(!patientId){console.error("[prn] ["+launchLocation+"] A source patient is required to register a family member");return;}
launchExpressRegEmbeddedApp(launchLocation,{preFillMode:"REGISTER_FAMILY_MEMBER",modeProps:{sourcePatientId:patientId}});}
