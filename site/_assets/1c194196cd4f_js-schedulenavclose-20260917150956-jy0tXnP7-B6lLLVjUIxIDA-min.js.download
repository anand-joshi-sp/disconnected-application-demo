return string.replace(/%([ +\-0#]*)(\d*)(?:\.(\d+))?([%bcsduoxefg])/g,function(match,flags,minwidth,precision,type){var param=toparguments.shift();try{switch(type){case'%':toparguments.unshift(param);return'%';case'c':return param.charCodeAt(0);case's':return param.toString();case'b':return Math.abs(parseInt(param,10)).toString(2);case'd':return parseInt(param,10)?parseInt(param,10):0;case'u':return Math.abs(param);case'f':return precision!=''?Math.round(parseFloat(param)*Math.pow(10,precision))/Math.pow(10,precision):parseFloat(param);case'o':return parseInt(param,10).toString(8);case'x':return parseInt(param,10).toString(16).toLowerCase();case'X':return parseInt(param,10).toString(16).toUpperCase();default:toparguments.unshift(param);return match;}}
catch(e){return'';}});}
function SetFocusToNextInput(form,currentelement){var j=-1;var formelements=form.elements;for(var i=0;i<formelements.length;i++){if(currentelement.id==formelements[i].id){j=i;continue;}
try{if(j!=-1&&formelements[i].type!='hidden'){formelements[i].focus();return;}}catch(e){continue;}}}
function EscapeRegExp(string){return string.replace(/([.*+?^${}()|!{}[\]\/\\])/g,'\\$1')}
function HTMLAttributes(args){var pairs=new Array();var value;for(attribute in args){if(attribute!=''&&args[attribute]!=null&&attribute.match(/^[_a-zA-Z][-:_a-zA-Z0-9]*$/)){value=''+args[attribute];val=value.replace(/&(\w+;)/g,'&amp;'+RegExp.$1);if(value.match(/^[a-zA-Z0-9]+$/)){}
else if(value.match(/'/)){value=value.replace(new RegExp('"','g'),'&quot;');value='"'+value+'"';}else{value="'"+value+"'";}
pairs.push(attribute+"="+value);}}
