var msEpoch=Notifier._metricsNavigation.msEpoch;Notifier._metricsNavigation.msEpoch=0;var stage=Notifier._metricsNavigation.stage;Notifier._metricsNavigation.stage='';return[msEpoch,stage];},Emphasize:function(){if(Notifier.emphasized){return;}
Notifier.RunIfDocumentReady(function(){Notifier.emphasized=true;Fade(Notifier.element,0,1,240);Notifier.CancelFadeOut();});},Hide:function(){Notifier.RunIfDocumentReady(function(){Notifier.emphasized=false;Fade(Notifier.element,0.85,0,80);});},FastFadeOut:function(){Notifier.RunIfDocumentReady(function(){Notifier.emphasized=false;Fade(Notifier.element,1,0,240);Notifier.CancelFadeOut();});},FadeOut:function(){Notifier.RunIfDocumentReady(function(){Notifier.emphasized=false;Fade(Notifier.element,0.85,0,480);});},FadeIn:function(){Notifier.RunIfDocumentReady(function(){Fade(Notifier.element,0,0.85,320);});},CancelFadeOut:function(){if(Notifier.showtimer){window.clearTimeout(Notifier.showtimer);}},RunIfDocumentReady:function(action){Notifier.parentdocument=Notifier.parentdocument||document;try{if(Notifier.parentdocument&&Notifier.parentdocument.readyState=='complete'){action();}}
catch(e){if(e.message=="Permission denied"){return;}
throw e;}}};function Fade(object,start,end,duration,currentvalue,steps){if(typeof(object)=='undefined'||object==null){return;}
if(!steps){var fps=20;steps=duration/(1000/fps);}
if(typeof(currentvalue)=='undefined'){if(typeof(object.fadetimer)!='undefined'){window.clearTimeout(object.fadetimer);object.fadetimer=undefined;}
if(typeof(object.fadevalue)!='undefined'){currentvalue=object.fadevalue;}else{currentvalue=100*start;}}
currentvalue=currentvalue+Math.round(100*(end-start)/steps);if(currentvalue<=0){currentvalue=0;object.style.display='none';}else{object.style.display='';}
if((start>end&&currentvalue<=100*end)||(start<end&&currentvalue>=100*end)){currentvalue=100*end;object.fadetimer=undefined;}else{object.fadetimer=window.setTimeout(function(){Fade(object,start,end,duration,currentvalue,steps);},duration/steps);}
object.style.filter='alpha(opacity='+currentvalue+')';object.fadevalue=currentvalue;}
function ActivateLinks(table){jQuery("tr[href]",table).bind({mouseover:function(){jQuery(this).addClass('hilite');},mouseout:function(){jQuery(this).removeClass('hilite');},click:function(){table.ownerDocument.location=this.getAttribute('href');}})
