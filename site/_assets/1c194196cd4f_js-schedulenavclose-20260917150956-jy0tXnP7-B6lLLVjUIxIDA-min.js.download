function SelectDymoPrinterAndPrint(fields,labelurl,DymoAddIn,DymoLabel){var dymoprinters=DymoAddIn.GetDymoPrinters();if(!dymoprinters){alert('No DYMO printers are installed. Install a DYMO printer.');return;}
if(!AH.GetGlobal('printerselectpopupopen')){dymoprinters=dymoprinters.split("|");var connecteddymoprinters=jQuery.grep(dymoprinters,function(dymoprinter){return DymoAddIn.IsPrinterOnline(dymoprinter);});if(!connecteddymoprinters.length){alert('No DYMO printers are connected. Connect a DYMO printer.');return;}
