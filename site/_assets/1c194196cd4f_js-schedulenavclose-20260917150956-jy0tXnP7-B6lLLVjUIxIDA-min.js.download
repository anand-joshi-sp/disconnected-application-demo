else{_PostProcess();}}}
function LookupKickReason(activeInput,claimid,transfertype,claimactionid,defaultlist,newstatus,oldstatus,outstanding,restrictbycontracttype){basehref=document.BASE_HREF||AH.GetGlobal('BASE_HREF');if(activeInput.value=="."||activeInput.value=="?"){activeInput.value='';if(claimactionid==''&&!defaultlist){alert('You must select an action before choosing a kickreason.');activeInput.onchange();return;}
status=(status?status:'');restrictbycontracttype=(restrictbycontracttype=='Y'?'Y':'N');var lookupurl=basehref+'/help/kickreasonlist.esp?CLAIMID='+claimid+'&TRANSFERTYPE='+transfertype+'&CLAIMACTIONID='+escape(claimactionid)+'&DEFAULTLIST='+defaultlist+'&RESTRICTBYCONTRACTTYPE='+restrictbycontracttype;if(isDefined(newstatus)){lookupurl=lookupurl+'&NEWSTATUS='+newstatus;}
if(isDefined(oldstatus)){lookupurl=lookupurl+'&OLDSTATUS='+oldstatus;}
