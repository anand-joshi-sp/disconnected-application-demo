+'&KICKCODE='+encodeURIComponent(kickcode)+'&LINENUMBER='+linenumber+'&SETSTATUS='+setstatus+'&NEWSTATUS='+newstatus+'&OLDSTATUS='+oldstatus+'&OUTSTANDING='
+outstanding+'&PATIENTINSURANCEID='+patientinsuranceid+'&OVERRIDEALARMPERIOD='+overridealarmperiod+'&RESTRICTBYCONTRACTTYPE='+restrictbycontracttype+'&USERNAME='
+username+'&KICKREASONCATEGORYID='+kickreasoncategoryid+'&PATIENTID='+patientid);}}
function CheckClaimNoteForm(){if(document.zform.VIEWOREDIT.value=='view'){if(event.altKey){if(event.keyCode==83||event.keyCode==13){return false;}}}
if(AH.GetGlobal('isDirty')){AH.SetGlobal('waitingToSubmit',true);return false;}
if(document.zform.ACTION.value==''){alert("You must choose an action.");document.zform.ACTION.focus();return false;}
if(document.zform.KICKCODE.value!=''&&document.all("KICKREASONID").value==''){alert("You have chosen an invalid kickcode for this insurance.");return false;}
if(jQuery('#KICKREASONOPTION').hasClass('RequiredField')&&jQuery('#KICKREASONOPTION').val()==''){alert('You must choose a kick reason option.');try{jQuery('#KICKREASONOPTION').focus();}catch(e){};return false;}
if(jQuery('#ESCALATEDPAYERSITECLASS').hasClass('RequiredField')&&jQuery('#ESCALATEDPAYERSITECLASS').val()==''){alert('You must choose a PayerSite class.');try{jQuery('#ESCALATEDPAYERSITECLASS').focus();}catch(e){};return false;}
if(jQuery('#NOTE').hasClass('RequiredField')&&jQuery('#NOTE').val()==''){alert('The note is required.');try{jQuery('#NOTE').focus();}catch(e){};return false;}
if(document.zform.PAYMENTAMOUNT.value!=''&&document.zform.PAYMENTDATE.value==''){if(!confirm("You have entered a payment amount, but no payment date.\n    Do you still wish to proceed?  (OK=Yes, Cancel=No)")){return false;}}
if(document.zform.PAYMENTAMOUNT.value!=''&&isNaN(document.zform.PAYMENTAMOUNT.value)){alert("Payment amount is not a number");return false;}
if(document.zform.CHECKAMOUNT.value!=''&&isNaN(document.zform.CHECKAMOUNT.value)){alert("Check amount is not a number");return false;}
if(document.zform.ACTION.value!=''&&document.zform.KICKREASONID.value==''){alert("You must choose a kick reason with this action.");document.zform.KICKCODE.focus();return false;}
if(document.zform.KICKCODE.value=='POSTING'||document.zform.KICKCODE.value=='POSTINGEXT'){if(document.zform.PAYMENTBATCHIDSELECT.value===''&&document.zform.PAYMENTBATCHIDTEXT.value===''){alert("You must choose a payment batch with this kickcode.");document.zform.PAYMENTBATCHIDSELECT.focus();return false;}
else if(document.zform.PAYMENTBATCHIDSELECT.value!==''&&document.zform.PAYMENTBATCHIDTEXT.value!==''){alert("Use one Payment Batch input, not both.");document.zform.PAYMENTBATCHIDSELECT.focus();return false;}
else if(document.zform.PAYMENTBATCHIDSELECT.value===''){document.zform.PAYMENTBATCHIDTEXT.value=document.zform.PAYMENTBATCHIDTEXT.value.replace("A"+AH.GetGlobal('LOGINPRACTICEID'),"");if(isNaN(document.zform.PAYMENTBATCHIDTEXT.value)){alert("Payment Batch is not a number");return false;}
document.zform.PAYMENTBATCHID.value=document.zform.PAYMENTBATCHIDTEXT.value;}
else{document.zform.PAYMENTBATCHID.value=document.zform.PAYMENTBATCHIDSELECT.value;}}
if(document.zform.USERDIRECTEDDATE&&document.zform.ALARMMAXDATE){var datediff=DateDiff(document.zform.USERDIRECTEDDATE.value,document.zform.ALARMMAXDATE.value);if(datediff<0){alert("'Return to Revenue Stream on' date for this claim, transfertype, and kickreasonid should be less than or equal to "+document.zform.ALARMMAXDATE.value);return false;}}
if(document.zform.USERDIRECTEDDATE&&document.zform.ALARMMINDATE){var datediff=DateDiff(document.zform.ALARMMINDATE.value,document.zform.USERDIRECTEDDATE.value);if(datediff<0){alert("'Return to Revenue Stream on' date for this claim, transfertype, and kickreasonid should be more than or equal to "+document.zform.ALARMMINDATE.value);return false;}}
if(AH.GetGlobal('isDirty')){AH.SetGlobal('waitingToSubmit',true);return false;}
if(document.zform.PATIENTINSURANCEID&&document.zform.PATIENTINSURANCEID.value=='UNSPECIFIEDREMIT'){if(document.zform.UNSPECIFIEDREMITPAYORNAME.value==''){alert("You must specify a payer name.");return false;}}
var notefield=jQuery('#NOTE');var copynotecheckbox=jQuery('#COPYNOTE');notefield.val(TrimWhitespace(notefield.val()));if(notefield.val().length===0){copynotecheckbox.prop('checked',false);}
if(CheckEnforceLength(document.zform.NOTE,4000)&&(document.zform.CLIENTAPPEALNOTE.disabled||CheckEnforceLength(document.zform.CLIENTAPPEALNOTE,4000))){return true;}
else{return false;}
return true;}
function confirmYN(args){if(!jQuery.isPlainObject(args)){if(arguments.length>1){return _LegacyConfirmYN.apply(this,arguments);}
args={TEXT:args,NATIVE:true};}
AssertFields(args||{},['TEXT'],['NATIVE','CALLBACK','YESBUTTON','NOBUTTON','OTHERBUTTON','EXTRATEXT','DEFER']);var text=args.TEXT;if(args.NATIVE){var response;text=text.replace(/&nbsp;/g,' ');text=text.replace(/<\/?(?:br|p)[^>]*>/g,'\n');text=text.replace(/<\/?(?:div|font|span|strong)[^>]*>/g,'');response=confirm(text)&&1;if(args.CALLBACK){args.CALLBACK(response);}
return response;}
else{var height=110+Math.ceil(text.length/10);var width=Math.min(600,290+text.length)+50;text=text.replace(/\n/g,'<br>');height+=8*text.split(/<(?:li|br)[^>]*>/).length;ModalPopupWindow({page:AH.PrependBasePath('/confirm.esp'),width:width,height:height,noclosebutton:true,defer:args.DEFER,additionalargs:{textstring:text,yesname:args.YESBUTTON,noname:args.NOBUTTON,otherbuttonname:args.OTHERBUTTON,afterbuttonmessage:args.EXTRATEXT},onclose:function(response){if(args.CALLBACK){args.CALLBACK(response||false);}}});}}
