var timedout=false;function WaitReuse(milliseconds,evt,element){if(!milliseconds){milliseconds=2000;}
evt=evt||event;if(!(evt&&evt.type&&evt.type.toString)){return;}
var eventtype=evt.type.toString();if(!element){element=evt.srcElement||evt.target;}
if(element&&!element['oldon'+eventtype]){var parentwindow=GetWindow(element);element['oldon'+eventtype]=element['on'+eventtype];element['on'+eventtype]=ReturnFalse;parentwindow.setTimeout(function(){element['on'+eventtype]=element['oldon'+eventtype];element['oldon'+eventtype]=undefined;},milliseconds);}
return true;}
function SlowCommand(command,mintimebetweenexecutions){if(!mintimebetweenexecutions){mintimebetweenexecutions=750;}
now=new Date();if(event.srcElement.scheduledtimeoutid){clearTimeout(event.srcElement.scheduledtimeoutid);event.srcElement.scheduledtimeoutid=null;}
if(event.srcElement.lastupdated==null){event.srcElement.lastupdated=now;return eval(command);}
else{var timelefttowait=mintimebetweenexecutions-(now-event.srcElement.lastupdated);if(timelefttowait<0){event.srcElement.lastupdated=now;return eval(command);}
else{if(!event.srcElement.id){event.srcElement.id=event.srcElement.uniqueID;}
var timeoutid=window.setTimeout(command+"; document.getElementById('"+event.srcElement.id+"').lastupdated = new Date();",timelefttowait);event.srcElement.scheduledtimeoutid=timeoutid;}}}
if(!Function.prototype.bind){Function.prototype.bind=function(){var __method=this,args=Array.prototype.slice.call(arguments),object=args.shift();return function(){return __method.apply(object,args.concat(Array.prototype.slice.call(arguments)));}}}
