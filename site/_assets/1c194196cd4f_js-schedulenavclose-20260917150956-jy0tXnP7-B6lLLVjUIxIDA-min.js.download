list[i]=a;}
return list;}
catch(e){}}
function getHTMLTags(theString){var position;var beginPosition=-1;var theTags=new Array;while((beginPosition=theString.indexOf("<",beginPosition+1))!=-1){var quoteChar='';for(position=beginPosition;position<theString.length;position++){theChar=theString.substr(position,1);if(theChar=='>'&&quoteChar==''){break;}
if(theChar==quoteChar){quoteChar='';continue;}
if(quoteChar==''&&(theChar=="'"||theChar=='"')){quoteChar=theChar;}}
var theTag;if(theString.substr(position,1)=='>'){theTag=theString.slice(beginPosition,position+1);beginPosition=position;}
else{theTag="";}
theTags[theTags.length]=theTag;}
return theTags;}
