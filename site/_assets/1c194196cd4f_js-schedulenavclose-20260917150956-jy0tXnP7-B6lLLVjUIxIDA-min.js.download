return;}
OpenDymoPrinterSelect({CONNECTEDDYMOPRINTERS:connecteddymoprinters,FIELDS:fields,LABELURL:labelurl,DYMOADDIN:DymoAddIn,DYMOLABEL:DymoLabel,ADMENABLED:false});}
else{WaitForDymoPrinterSelectThenPrint({FIELDS:fields,LABELURL:labelurl,DYMOADDIN:DymoAddIn,DYMOLABEL:DymoLabel,ADMENABLED:false});}}
