function CodeCheck(cptarray,icdarray,servicedate,departmentid,icdversion,claimeditflag){var getStringParameters={DEPARTMENTID:departmentid,SERVICEDATE:servicedate,CPTCODE:[],MODIFIER:[],ICDCODE:[],ICDPOINTER:[],ICDVERSION:icdversion,CLAIMEDITFLAG:claimeditflag,MEDICAREPART:[]};if(icdarray.length==0){alert("At least one "+icdversion+" code must be specified");return false;}
var uniqueicd={};var icdmap=[];for(var i=0;i<icdarray.length;i++){var icdmapindex=i;if(uniqueicd[icdarray[i]]!=undefined){icdmap[i+1]=uniqueicd[icdarray[i]];}
else{getStringParameters['ICDCODE'].push(icdarray[i]);icdmap[i+1]=i+1;uniqueicd[icdarray[i]]=i+1;}}
for(var i=0;i<cptarray.length;i++){var modifiers=cptarray[i]['CPT'].split(',');var procedurecode=modifiers.splice(0,1);getStringParameters['CPTCODE'].push(procedurecode);getStringParameters['MODIFIER'].push(jQuery.grep(modifiers,function(item,index){return/.{1,2}/.test(item);}).join(','));var icdpointers=cptarray[i]['ICD'].split(',');for(var icd=0;icd<icdpointers.length;icd++){icdpointers[icd]=icdmap[icdpointers[icd]];}
icdpointers=UniqueElements(icdpointers);getStringParameters['ICDPOINTER'].push(icdpointers.join(','));getStringParameters['MEDICAREPART'].push(cptarray[i]['MEDICAREPART']);}
var win=ModelessLookup(MakeURL(AH.PrependBasePath('/partners/codecorrect/detail/codecheckcms1500.esp'),getStringParameters),'athenaCodesource powered by nThrive',1000,700,0,'cccodecheck',{status:1});win.focus();}
