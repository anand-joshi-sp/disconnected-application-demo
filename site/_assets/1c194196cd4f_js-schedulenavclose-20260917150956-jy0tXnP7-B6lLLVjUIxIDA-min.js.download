else{activeInput.value='';MediumModalPopupWindow({page:AH.PrependBasePath('/help/principalprocedurecodelookup.esp?CODE='+code),title:'Find Principal Procedure Code',onclose:function(responses){if(responses!==null){activeInput.value=responses;}
else{activeInput.value='';}
