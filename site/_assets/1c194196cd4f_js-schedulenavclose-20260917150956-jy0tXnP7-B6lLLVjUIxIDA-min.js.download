else{EPaymentWindowClosingCallback.callback=callback;}}
else{EPaymentWindowClosingCallback.callback=EPaymentDefaultWindowClosingCallback;}
clearInterval(EPaymentWatchForWindowClosing.interval);EPaymentWatchForWindowClosing.interval=window.setInterval(EPaymentWatchForWindowClosing,500);}
function OpenEPaymentApplicationByPOST(url,args,callback,callbackfix){var form=document.createElement("form");form.action=url;form.method='POST';for(var key in args)
{var input=document.createElement('input');input.type='hidden';input.name=key;input.value=typeof args[key]==="object"?JSON.stringify(args[key]):args[key];form.appendChild(input);}
issimplifydevice=args.ISSIMPLIFYDEVICE;document.body.appendChild(form);EPaymentWindowClosingCallback.wnd=window.open('','epaymentwindow','titlebar=no,'
+'directories=no,'
+'location=yes,'
+'menubar=no,'
+'status=yes,'
+'toolbar=no,'
+'top=0,'
+'scrollbars=yes,'
+'resizable=yes');form.target='epaymentwindow';form.submit();document.body.removeChild(form);if(callback){if(callbackfix&&callbackfix=='1'){var callbackfunction=new Function(callback);EPaymentWindowClosingCallback.callback=callbackfunction;}
else{EPaymentWindowClosingCallback.callback=callback;}}
else{EPaymentWindowClosingCallback.callback=EPaymentDefaultWindowClosingCallback;}
clearInterval(EPaymentWatchForWindowClosing.interval);EPaymentWatchForWindowClosing.interval=window.setInterval(EPaymentWatchForWindowClosing,500);}
function EPaymentWatchForWindowClosing(){try{if(EPaymentWindowClosingCallback.wnd.closed){if(ADM&&ADM.IsEnabled()){var re=new RegExp("ISSIMPLIFYDEVICE=1");if(re.test(epaymentwindowgetstring)||issimplifydevice){ADM.ResetSimplify();}
ADM.CloseRDMCheckScanner({setShouldPreserve:false});ADM.StopBurroughsScanner();}
window.clearInterval(EPaymentWatchForWindowClosing.interval);var handled=EPaymentWindowClosingCallback.callback.apply();if(!handled)EPaymentDefaultWindowClosingCallback();}}
catch(e){}}
function EPaymentDefaultWindowClosingCallback(){return true;}
function SwipeTrackData(track1,track2,track3){this.Reset(track1,track2,track3);}
SwipeTrackData.prototype.Reset=function(track1,track2,track3){this.track1={data:track1,valid:false};this.track2={data:track2,valid:false};this.track3={data:track3,valid:false};this.validatedAs=false;}
SwipeTrackData.prototype.ValidateCreditCard=function(){if(this.validatedAs){this.Reset(this.track1.data,this.track2.data,this.track3.data);}
this.validatedAs='CREDIT';var track1regexp=/^%B(\d+)\^([A-Z\/ ]+)\^(\d{2})(\d{2})\d*\?$/;this.track1.valid=track1regexp.test(this.track1.data);this.track1.number=RegExp.$1;this.nameoncard=RegExp.$2;var names=this.nameoncard.split('/');if(names[1]){this.nameoncard=names[1]+' '+names[0];}
this.track1.year='20'+RegExp.$3;this.track1.month=RegExp.$4;var track2regexp=/^;(\d+)=(\d{2})(\d{2})\d*\?$/;this.track2.valid=track2regexp.test(this.track2.data);this.track2.number=RegExp.$1;this.track2.year='20'+RegExp.$2;this.track2.month=RegExp.$3;}
