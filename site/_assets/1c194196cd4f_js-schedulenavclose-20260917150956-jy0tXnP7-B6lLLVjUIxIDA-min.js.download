ypos+=AH.Frames.GlobalNav.getElementById(menuName+"Image").height+4;}
if(xpos&&ypos){paramtext="xpos,ypos";}else{paramtext='';}
eval(menuName+".PopUp("+paramtext+")");}catch(e){eval("val = ModalPopUp("+menuName+"Items.toArray(),xpos,ypos);");if(val>0){try{eval(menuName+"_Click(val)");}catch(e1){}}}}
