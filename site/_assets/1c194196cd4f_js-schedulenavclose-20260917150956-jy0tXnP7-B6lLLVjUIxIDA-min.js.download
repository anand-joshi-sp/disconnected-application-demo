if(activeInput.value=="."||activeInput.value=='?'){activeInput.value='';LargeModalPopupWindow({page:AH.PrependBasePath('/help/diaglookup.esp'),title:'Find Diagnosis Code',onclose:function(responses){if(responses!==null){activeInput.value=responses;}
else{activeInput.value='';}
jQuery(activeInput).trigger('change');activeInput.focus();if(onselect){onselect();}
_PostProcess();}});}
else{if(onselect){onselect();}
if(activeInput.value!=''){_PostProcess();}}}
function LookupNDC(activeInput,pxcode,onselect){if(activeInput.value==''){if(onselect){onselect(activeInput);}
return;}
if(activeInput.value=="."||activeInput.value=='?'){activeInput.value='';var pxcodelink='';if(pxcode){pxcodelink='?lookuppxcode='+pxcode;}
var largemodaldimensions=_ConvertToStandardModalWidthHeight({size:'LARGE'});ModalPopupWindow({width:900,height:largemodaldimensions.height,page:AH.PrependBasePath('/help/ndclookup.esp'+pxcodelink),title:'Find NDC Number',additionalargs:{resizable:1},onclose:function(response){activeInput.value=(response)?SanitizeNDC(response):'';NDCBlur(activeInput);if(onselect){onselect(activeInput);}}});}
else{activeInput.value=SanitizeNDC(activeInput.value);if(onselect){onselect(activeInput);}}}
function SanitizeNDC(ndc){var re=/[^A-Za-z0-9=\-]/g;if(ndc.match(re)){ndc=ndc.replace(re,'');}
if(ndc.length>13){ndc=ndc.substr(0,13);}
return ndc;}
