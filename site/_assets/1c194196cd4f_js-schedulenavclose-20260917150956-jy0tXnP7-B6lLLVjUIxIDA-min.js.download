function ForceTimeDuration(args){var divname=args.DIVID;var starttimename=args.STARTTIMENAME;var endtimename=args.ENDTIMENAME;var minwindow=args.MINWINDOW;var donotchangename=args.DONOTCHANGENAME;var divj=jQuery('#'+divname);var startselectj=divj.find('select[name='+starttimename+']');var endselectj=divj.find('select[name='+endtimename+']');var starttime=startselectj.val();var endtime=endselectj.val();var randomday='1 Jan 1900 ';var startobj=new Date(randomday+starttime);var endobj=new Date(randomday+endtime);var delta=(endobj-startobj)/(1000*60*60);if(donotchangename===starttimename){if(delta<minwindow){endobj.setHours(startobj.getHours()+minwindow);endobj.setMinutes(startobj.getMinutes());endselectj.val(FormatTimeToString(endobj));}}
else{if(delta<minwindow){startobj.setHours(endobj.getHours()-minwindow);startobj.setMinutes(endobj.getMinutes());startselectj.val(FormatTimeToString(startobj));}}}
function FormatTimeToString(timeobj){var ampm='AM';var hour=timeobj.getHours();var minute=timeobj.getMinutes();if(hour>=12){ampm='PM';}
if(hour>12){hour-=12;}
if(hour<=9){hour="0"+hour;}
if(minute<=9){minute="0"+minute;}
return""+hour+":"+minute+" "+ampm;}
function ValidateTime(args){var divname=args.DIVID;var starttimename=args.STARTTIMENAME;var endtimename=args.ENDTIMENAME;var minwindow=args.MINWINDOW;var divj=jQuery('#'+divname);var startselectj=divj.find('select[name='+starttimename+']');var endselectj=divj.find('select[name='+endtimename+']');var starttime=startselectj.val();starttime=starttime[0];var endtime=endselectj.val();endtime=endtime[0];var randomday='1 Jan 1900 ';var startobj=new Date(randomday+starttime);var endobj=new Date(randomday+endtime);var delta=(endobj-startobj)/(1000*60*60);;if(delta<minwindow){alert("The Calling window must be atleast "+minwindow+" hours");return false;}}
