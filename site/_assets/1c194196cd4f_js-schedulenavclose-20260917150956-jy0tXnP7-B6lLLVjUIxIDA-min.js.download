function MakeGetString(query){if(query){var pairs=[];for(var key in query){if(isFunction(query[key])){continue;}
else if(isArray(query[key])){for(var i=0;i<query[key].length;i++){pairs.push(encodeURIComponent(key)+'='+encodeURIComponent(query[key][i]));}}
else{var value=query[key]?encodeURIComponent(query[key]):'';pairs.push(encodeURIComponent(key)+'='+value);}}
return pairs.join('&');}
return'';}
function MakeURL(url,query){var getstring='';if(query){getstring=MakeGetString(query);}
return url+'?'+getstring;}
