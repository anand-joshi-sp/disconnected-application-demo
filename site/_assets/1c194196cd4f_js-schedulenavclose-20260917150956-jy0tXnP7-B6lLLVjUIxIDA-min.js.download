function ValidatePhoneFaxNumber(fieldValue,allowExtension){var invalidNumberList=["0000000000","1111111111","2222222222","3333333333","4444444444","5555555555","6666666666","7777777777","8888888888","9999999999"];if(allowExtension){var ext=fieldValue.lastIndexOf('x');if(ext>=10){fieldValue=fieldValue.substring(0,ext);}}
var phoneNumber=fieldValue.replace(/[^0-9]/g,'');var invalidInput=false;if(!invalidInput&&!(phoneNumber.match(/^[2-9][0-8][0-9][2-9][0-9][0-9][0-9][0-9][0-9][0-9]$/))){invalidInput=true;}
if(!invalidInput&&phoneNumber.match(/^911.{7}$/)){invalidInput=true;}
if(!invalidInput&&phoneNumber.match(/^.{3}[5]{3}.{4}$/)){invalidInput=true;}
if(!invalidInput&&InList(phoneNumber,invalidNumberList)){invalidInput=true;}
if(invalidInput){return"Phone/Fax number is invalid. Please input valid number.";}
else{return"";}}
