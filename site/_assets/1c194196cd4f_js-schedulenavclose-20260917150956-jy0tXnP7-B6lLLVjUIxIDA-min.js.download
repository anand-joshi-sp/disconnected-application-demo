else if(modalwidth>400||modallength>400){MediumModalPopupWindow({page:modalpath,title:'Choose '+entitylabel,onclose:function(results){onclose(results);}});}
else{SmallModalPopupWindow({page:modalpath,title:'Choose '+entitylabel,onclose:function(results){onclose(results);}});}}}
