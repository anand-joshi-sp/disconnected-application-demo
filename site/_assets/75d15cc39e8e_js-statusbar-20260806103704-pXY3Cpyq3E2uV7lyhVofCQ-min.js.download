var GetStaticURL=(typeof GetStaticURL==='undefined')?function(initial_static_host){var stored_static_host=initial_static_host||'/static';return function(url){var slashurl=url.replace(/^\/?/,'/');return stored_static_host+slashurl;}}(typeof static_host==='undefined'?'':static_host):GetStaticURL;function _SelectNewValue(args){"use strict";var currentvalue,getstringparams={},newvalue,$dropdown;AssertFields(args,['CHANGEFLAG','CURRENTVALUE','DROPDOWN','VALUENAME'],['CHANGEFUNCTION']);$dropdown=jQuery(args.DROPDOWN);currentvalue=args.CURRENTVALUE;newvalue=$dropdown
.find("option:selected")
.val();$dropdown.val(currentvalue);if(newvalue===currentvalue){return false;}
else{getstringparams[args.CHANGEFLAG]=1;getstringparams[args.VALUENAME]=newvalue;if(args.CHANGEFUNCTION){args.CHANGEFUNCTION(newvalue);}
else{AH.Frames.Main.SetLocation(AH.PrependBasePath('/message/athenahome.esp?'+
MakeGetString(getstringparams)));}
jQuery('body').focus();return true;}}
