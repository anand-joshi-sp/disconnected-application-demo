else{CrossFrameEventsUtils.trigger('pattern-print-failed');}});CrossFrameEventsUtils.on('streamlined-schedule-closed',function(){var $statusBarScheduleWrapper=jQuery('.statusbar-schedule-wrapper');var $statusBarSchedule=$statusBarScheduleWrapper.find('.statusbar-schedule');var $pipes=$statusBarScheduleWrapper.find('.statusbar-pipe');$pipes.removeClass('display-none');$statusBarSchedule.removeClass('active');});CrossFrameEventsUtils.on('streamlined-schedule-opened',function(){var $statusBarScheduleWrapper=jQuery('.statusbar-schedule-wrapper');var $pipes=$statusBarScheduleWrapper.find('.statusbar-pipe');$pipes.addClass('display-none');var $statusBarSchedule=$statusBarScheduleWrapper.find('.statusbar-schedule');$statusBarSchedule.addClass('active');});CrossFrameEventsUtils.on('flagged-tasks-clicked-popup',function(){if(startpolling&&isMetricsFlaggedTasksOn){ClassicMetricsManager.LogMetric('airlock_event',{event:'flagged-tasks-clicked-popup'});}});});function OpenCareGapWorklist(){AH.Frames.Main.SetLocation(AH.GetGlobal('BASE_HREF')+"/clinicals/caregapsworklist.esp");require(['shared:/scripts/athena/utils/cross_frame_events'],function(CrossFrameEventsUtils){CrossFrameEventsUtils.trigger('user-tracking.track-event',{rollout_toggle_key:'AMPLITUDE_ANALYTICS',event_type:'STATUSFOOTER::GAPLIST::NA::NA::OPEN'});});}
function SetServerDateTime(serverDateTime){var oktaConfig=document.oktaconfig;if(oktaConfig&&oktaConfig.serverdatetime&&oktaConfig.serverdatetime.value){oktaConfig.serverdatetime.value=serverDateTime;}}
function InitOktaSessionManagement(){var oktaConfig=document.oktaconfig;if(oktaConfig&&oktaConfig.oktauserid&&oktaConfig.oktauserid.value){require(["@athena/identity-session-management"],function(SessionManagement){var config={clientId:oktaConfig.clientid.value,authServer:oktaConfig.authserver.value,scopes:["openid"],standardSessionKeepAlive:false,redirectUri:oktaConfig.redirecturl.value,serverDateTime:oktaConfig.serverdatetime.value,authenticatedUserId:oktaConfig.oktauserid.value};if(oktaConfig.loginframeurl.value){config.loginFrameUrl=oktaConfig.loginframeurl.value;}
AH.SetGlobal("oktaSessionManager",new SessionManagement.SessionManager(config));AH.SetGlobal("OKTAUSERID",oktaConfig.oktauserid.value);AH.SetGlobal('OKTASESSIONVERIFIED',false);AH.SetGlobal('SESSIONTERMINATIONLOGGED',false);AH.SetGlobal('OKTASESSIONVERIFIEDLOGGED',false);});try{var athenaoneBroadcastChannel=new BroadcastChannel('athenaoneBroadcastChannel');athenaoneBroadcastChannel.postMessage({message:'syncSessionWithRefreshTimeoutTab',username:AH.GetGlobal('USERNAME'),userauthntype:AH.GetGlobal('IDENTITYPROVIDERID')?'SSO':'NONSSO'});}
catch(error){jQuery.post('/login/loginscribelog.esp',{CATEGORY:'identity-services-sync-okta-session',LOGLINES:JSON.stringify([{CATEGORY:'FailedToSyncSession',DESCRIPTION:'Failed to broadcast syncSessionWithRefreshTimeoutTab event',DATA:{USERNAME:AH.GetGlobal('USERNAME'),ERROR:JSON.stringify(error),TIME:Date.now()}}])});}}}
