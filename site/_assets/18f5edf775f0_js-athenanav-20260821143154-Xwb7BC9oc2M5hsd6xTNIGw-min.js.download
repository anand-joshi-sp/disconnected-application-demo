var body=jQuery('body');var menucomponentselected=jQuery('#'+menuname+'menucomponentselected');var menucontainerobject=jQuery('#'+menuname+'menucontainer');var menucontainerobjectiframe=jQuery('#'+menuname+'menuiframe');CloseAthenaNav();if(menucomponentselected.length>0){menucomponentselected.show();}
else{menucomponentselected=CreateMenuComponentSelected(args);body.append(menucomponentselected);}
if(menucontainerobject.length>0){menucontainerobject.show();menucontainerobjectiframe.show();}
else{body.append(menucontainer);body.append(menuframe);menucontainerobject=menucontainer;}
if(homepagetoggle&&!args.HOMEPAGE){homepagetoggle.prop('selectedIndex',-1);}
if(window.RefreshFacit)RefreshFacit();PlaceOpenMenu({MENUNAME:menuname});menucontainerobject.focus();}
function SelectSupressMenuClose($element){$element.mousedown(function(){jQuery('#usermenucontainer').unbind('blur');})
.blur(function(){jQuery('#usermenucontainer').focus().blur(function(){CloseAllMenus();});if(!jQuery('#usermenucontainer').hasClass('hover-marker')){jQuery('#usermenucontainer').blur();}});return $element;}
