function HandleKeyDown(args){if(!navsearchobject){return true;}
if(args.EVENT.keyCode==38){navsearchobject.SelectPrev();return false;}
else if(args.EVENT.keyCode==40){navsearchobject.SelectNext();return false;}
else if(args.EVENT.keyCode==13){var globalnavcontainer=GetGlobalNavContainer();var search=globalnavcontainer.find('#searchinput');if(search.val()||jQuery('#searchmenucontainer:visible')){navsearchobject.PerformSearch({EVENT:args.EVENT});return false;}}
else if(args.EVENT.keyCode==27){navsearchobject.Hide();return false;}
return true;}
function HandleKeyUp(args){if(!navsearchobject){return;}
