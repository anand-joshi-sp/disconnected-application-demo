var actingasproviderselect;if(args.ACTINGASPROVIDERTOGGLE){jQuery('<div>')
.addClass('usermenusectiontitle')
.html('ACTING AS')
.appendTo(menucontainer);actingasproviderselect=jQuery('<select id="actingasproviderselect">')
.append(jQuery("<option/>",{text:'',value:''}))
.addClass('usermenusectionselect')
.appendTo(menucontainer);jQuery.each(args.ACTINGASPROVIDEROPTIONS,function(idx,elt){actingasproviderselect.append(jQuery("<option/>",{text:elt['TEXT'],value:elt['VALUE']}));});actingasproviderselect.val(args.CURRENTACTINGASPROVIDER);SelectSupressMenuClose(actingasproviderselect);actingasproviderselect.change(function(){var switchProviderURL=AH.BaseURL('/inpatient/recent_user_data/save_value');jQuery.ajax(switchProviderURL,{type:'POST',contentType:'application/json',processData:false,data:JSON.stringify({key:'ACTINGASPROVIDERUSERNAME',value:actingasproviderselect.val()}),success:function(data){CloseAllMenus();AH.Frames.GlobalNav.Reload();var location=AH.Frames.Main.GetLocation();var pathName=location.pathname;if(pathName.search(/\/inpatient/)!==-1){if(pathName.search(/\/chart/)!==-1){location.hash='';}
AH.Frames.Main.SetLocation(location);AH.Frames.Main.Reload();}}});});}
var airlock=jQuery('iframe#navbar-iframe').length;var airlockinclassicframeset=airlock?false:AH.GetGlobal('AIRLOCKINCLASSICFRAMESET');if(args.HOMEPAGETOGGLE){jQuery(document.createElement("DIV"))
.addClass('usermenusectiontitle')
.html('USER HOMEPAGE')
.appendTo(menucontainer);var homepagetoggle=jQuery(document.createElement("SELECT"));for(var preference in args.HOMEPAGEINFO){var optioninfo=args.HOMEPAGEINFO[preference];homepagetoggle.append(jQuery("<option/>",{text:optioninfo.NAME,value:preference,'data-homepage-url':optioninfo.URL}));}
homepagetoggle.val(args.HOMEPAGE)
.addClass('usermenusectionselect')
.attr('id','homepageswitcher')
.change(function(){var input=jQuery(this);var value=input.val();var nav=GetGlobalNavContainer();var logo=nav.find('div.menuitemlogo');var oldvalue=logo.attr('data-homepage-preference');var airlock=jQuery('iframe#navbar-iframe').length;var success_handler=function(){var selected=input.find(":selected");var selectedurl=selected.attr('data-homepage-url');var selectedvalue=selected.val();nav.find('div.menuitemlogo')
.attr('data-homepage-url',selectedurl)
.attr('data-homepage-preference',selectedvalue);};var error_handler=function(){input.val(oldvalue);success_handler();};success_handler();if(airlockinclassicframeset){CallRemote({SUB:'BusCall::User::ResourcedRecentUserDataSet',ARGS:{USERNAME:args.USERNAME,KEY:'AIRLOCK.HOMEPAGE',VALUE:value},ONFINISH:function(){var homepagetest=new RegExp('/(ax|bx_[^\/]+)/'+oldvalue+'(?:/|$)');var onhomepage=homepagetest.test(top.frMain.location.pathname);if(onhomepage&&value!==oldvalue){nav.find('div.menuitemlogo').click();input.attr('data-redirecting',1);}},ONERROR:error_handler});}
else{if(airlock){var homepagetest=new RegExp('/(ax|bx_[^\/]+)/'+oldvalue+'(?:/|$)');var onhomepage=homepagetest.test(document.location.pathname);var url=document.location.pathname
.replace(/\/(ax|bx_[^\/]+)\/.*$/,'/$1/recent_user_data/save_value');jQuery.ajax(url,{type:'POST',contentType:'application/json',processData:false,data:JSON.stringify({username:args.USERNAME,key:'AIRLOCK.HOMEPAGE',value:value}),success:function(data){if(onhomepage&&value!==oldvalue){nav.find('div.menuitemlogo').click();input.attr('data-redirecting',1);}},error:error_handler});}else{CallRemote({SUB:'BusCall::User::ResourcedRecentUserDataSet',ARGS:{USERNAME:args.USERNAME,KEY:'AIRLOCK.HOMEPAGE',VALUE:value},ONERROR:error_handler});}}})
.appendTo(menucontainer);SelectSupressMenuClose(homepagetoggle);}
