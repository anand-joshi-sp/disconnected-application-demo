function CheckSnomedAlreadyExists(checkbox,problemcode,problemdescription){if(!checkbox.checked){var container=GetParent(checkbox,'tagName','tbody');var problemrows=container.children;var totalproblemrows=problemrows.length;var problemcells=[];for(var i=0;i<totalproblemrows;i++){var problemcell=problemrows[i].children;if(problemcell['PATIENTPROBLEM_PROBLEMCODE_DEACTIVATED_'+problemcode]){problemcells.push(problemcell['PATIENTPROBLEM_PROBLEMCODE_DEACTIVATED_'+problemcode]);}
else if(problemcell['PATIENTPROBLEM_PROBLEMCODE_'+problemcode]){problemcells.push(problemcell['PATIENTPROBLEM_PROBLEMCODE_'+problemcode]);}}
for(var i=0;i<problemcells.length;i++){var problemrow=GetParent(problemcells[i],'tagName','tr');GetChild(problemrow,'tagName','input','value',problemcode).name.match(/PATIENTPROBLEM_PROBLEMCODE_(.*)/);var problemid=RegExp.$1;var deactivatecheckbox=GetChild(problemrow,'tagName','input','type','checkbox','name','PATIENTPROBLEM_HIDDEN_'+problemid);if(!deactivatecheckbox||(deactivatecheckbox&&!deactivatecheckbox.checked&&deactivatecheckbox!=checkbox)){alert("Patient already has problem "+problemdescription+' active.');return false;}}
CheckYNInSection('PROBLEMLIST_NOPROBLEMSREPORTED',false,checkbox);}
return true;}
