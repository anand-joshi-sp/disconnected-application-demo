model.wasmouseup=true;model.pickerclicked=false;});jQuery('#layout_content').bind("scroll.i10gpicker",function(){model.scrolled=true;});jQuery(document).bind("scroll.i10gpicker",function(){model.scrolled=true;});codecontainer.scroll(function(evt){model.scrolled=true;});var closebutton='';if(!nonmodal){searchinput.blur(function(){if(model.stayFocused){return false;}
else{ICD10PickerView.GlobalICD10PickerOnRemove();picker.remove();}});closebutton=jQuery("<div class='icd10globalpickerclosebutton' "+
