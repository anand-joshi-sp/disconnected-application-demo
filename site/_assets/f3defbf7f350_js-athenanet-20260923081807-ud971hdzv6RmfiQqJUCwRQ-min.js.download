function _AthenaShowModalDialogTablet(url,width,height){var leftpos=Math.floor((jQuery(window).width()-width)/2);var toppos=(jQuery(window).height()<1000)?2:75;var modaljs='<script>function modalclose() { jQuery.modal.close(); }</script>';var modaliframe=jQuery('<iframe></iframe>').attr({"id":'modaliframe',"src":url,"width":width,"height":height});var modaldiv=jQuery('<div></div>')
