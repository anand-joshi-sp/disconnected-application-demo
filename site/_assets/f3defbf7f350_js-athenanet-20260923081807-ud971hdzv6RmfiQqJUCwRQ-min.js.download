if(username===currentusername&&authState&&authState.sessionExists&&oktaSessionManager&&typeof oktaSessionManager.logout==='function'){var backgroundUserId;if(AH.GetGlobal("OKTAUSERID")){backgroundUserId=AH.GetGlobal("OKTAUSERID");}
else{backgroundUserId="";}
