if(args.CHARTID&&args.PATIENTID&&args.DEPARTMENTID){CallRemote({SUB:'Document::Class::PRESCRIPTION::GetWarningsHTMLWrapper',ARGS:{PATIENTID:args.PATIENTID,CHARTID:args.CHARTID,DEPARTMENTID:args.DEPARTMENTID,SELECTEDDOCUMENTID:nvl(args.SELECTEDDOCUMENTID,''),EXCLUDEDOCUMENTID:nvl(args.EXCLUDEDOCUMENTID,''),CLINICALORDERTYPEID:nvl(args.CLINICALORDERTYPEID,''),MEDICATIONID:nvl(args.MEDICATIONID,''),MEDICATIONNAME:nvl(args.MEDICATIONNAME,''),NEWORDERTYPEIDS:nvl(args.NEWORDERTYPEIDS,''),NEWMEDICATIONIDS:nvl(args.NEWMEDICATIONIDS,''),NEWALLERGYIDS:nvl(args.NEWALLERGYIDS,''),NEWDIAGNOSISCODES:nvl(args.NEWDIAGNOSISCODES,''),DELETEDORDERSTRING:nvl(args.DELETEDORDERSTRING,''),CLINICALENCOUNTERID:nvl(args.CLINICALENCOUNTERID,''),FIELDPREFIX:nvl(args.FIELDPREFIX,''),ISMEDICATIONLIST:nvl(args.ISMEDICATIONLIST,''),NEWINDEX:nvl(args.NEWINDEX,''),EDITABLE:nvl(args.EDITABLE,''),TYPE:nvl(args.TYPE,''),INITIALIZEDOSECHECKS:nvl(args.INITIALIZEDOSECHECKS,''),ALLOWRECONSOLNDOSECHECKS:nvl(args.ALLOWRECONSOLNDOSECHECKS,'')},ONFINISH:function(data){warningscontainer.innerHTML=nvl(data.WARNINGS,'');if(args.REFRESH){CheckForAlerts({ALERTS:data.ALERTS,CLINICALORDERTYPEID:nvl(args.CLINICALORDERTYPEID,''),CLINICALORDERTYPENAME:nvl(args.MEDICATIONNAME,''),MEDICATIONID:nvl(args.MEDICATIONID,'')},warningscontainer);}
SyncNewlyAddedOverrides(warningscontainer);ShowHiddenOverrideWarnings(document.getElementById('SHOWOVERRIDE'));if(args.ONCOMPLETE){args.ONCOMPLETE();}}});}
else{warningscontainer.innerHTML='';}}
