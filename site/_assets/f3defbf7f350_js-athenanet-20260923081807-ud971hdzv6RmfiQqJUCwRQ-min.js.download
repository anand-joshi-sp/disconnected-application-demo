complicationstable.deleteRow(complicationsrow.rowIndex);if(complicationstable.rows.length==1){jQuery('span.sprite-del-16x16',complicationstable.rows[0].cells[0]).hide();var selectobject=jQuery('select',complicationstable.rows[0].cells[0]).get(0);if(selectobject){selectobject.options[0].text='No Complications';}}
