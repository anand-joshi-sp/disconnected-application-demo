var specimensourcename=jQuery('option[value="'+this.value+'"]',this).html();var label=specimensourcename+' ('+documentdescription+' '+(newexisting=='NEW'?'New':'#'+documentid)+')';references.push({label:label,id:specimenid});});if(references.length>0){var blank=jQuery('option[value=]',field);var placeholder=jQuery('option[value=--]',field);if(!(placeholder&&placeholder.size())){placeholder=jQuery('<option value=-- disabled=1>----------------------------------------</option>');placeholder.insertAfter(blank);}
