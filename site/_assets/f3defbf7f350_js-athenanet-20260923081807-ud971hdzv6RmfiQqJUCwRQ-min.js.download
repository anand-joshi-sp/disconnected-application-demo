function CanvasChartPainterFactory(){return new CanvasChartPainter();}
function CanvasChartPainter(){this.base=AbstractChartPainter;};CanvasChartPainter.prototype=new AbstractChartPainter;CanvasChartPainter.prototype.create=function(el){while(el.firstChild){el.removeChild(el.lastChild);}
this.el=el;this.w=el.clientWidth;this.h=el.clientHeight;this.canvas=document.createElement('canvas');this.canvas.width=this.w;this.canvas.height=this.h;this.canvas.style.width=this.w+'px';this.canvas.style.height=this.h+'px';el.appendChild(this.canvas);if((!this.canvas.getContext)&&(typeof G_vmlCanvasManager!="undefined")){this.canvas=G_vmlCanvasManager.initElement(this.canvas);}};CanvasChartPainter.prototype.init=function(xlen,ymin,ymax,xgd,ygd,bLegendLabels){this.ctx=this.canvas.getContext('2d');this.chartx=0;this.chartw=this.w;this.charth=this.h;this.charty=0;this.xlen=xlen;this.ymin=ymin;this.ymax=ymax;this.xgd=xgd;this.ygd=ygd;this.calc(this.chartw,this.charth,xlen,ymin,ymax,xgd,ygd);};CanvasChartPainter.prototype.drawLegend=function(series){var legend,list,item,label;legend=document.createElement('div');legend.className='legend';legend.style.position='absolute';list=document.createElement('ul');for(i=0;i<series.length;i++){item=document.createElement('li');item.style.color=series[i].color;label=document.createElement('span');label.appendChild(document.createTextNode(series[i].label));label.style.color='black';item.appendChild(label);list.appendChild(item);}
legend.appendChild(list);this.el.appendChild(legend);legend.style.right='0px';legend.style.top=this.charty+(this.charth/2)-(legend.offsetHeight/2)+'px';this.legend=legend;this.chartw=this.w-(this.legend.offsetWidth+5);this.calc(this.chartw,this.charth,this.xlen,this.ymin,this.ymax,this.xgd,this.ygd);};CanvasChartPainter.prototype.drawVerticalAxis=function(ygd,precision){var axis,item,step,y,ty,n,yoffset,value,multiplier,w,items,pos;multiplier=Math.pow(10,precision);step=this.range/(ygd-1);axis=document.createElement('div');axis.style.position='absolute';axis.style.left='0px';axis.style.top='0px';axis.style.textAlign='right';this.el.appendChild(axis);this.ctx.fillStyle='black';w=0;items=new Array();for(n=0,i=this.ymax;(i>this.ymin)&&(n<ygd-1);i-=step,n++){item=document.createElement('span');value=parseInt(i*multiplier)/multiplier;item.appendChild(document.createTextNode(value));axis.appendChild(item);items.push([i,item]);if(item.offsetWidth>w){w=item.offsetWidth;}}
item=document.createElement('span');item.appendChild(document.createTextNode(this.ymin));axis.appendChild(item);items.push([this.ymin,item]);if(item.offsetWidth>w){w=item.offsetWidth;}
axis.style.width=w+'px';this.chartx=w+5;this.charty=item.offsetHeight/2;this.charth=this.h-((item.offsetHeight*1.5)+5);this.chartw=this.w-(((this.legend)?this.legend.offsetWidth:0)+w+10);this.calc(this.chartw,this.charth,this.xlen,this.ymin,this.ymax,this.xgd,this.ygd);n=this.range/this.charth;yoffset=(this.ymin/n);for(i=0;i<items.length;i++){item=items[i][1];pos=items[i][0];if(pos==this.ymin){y=this.charty+this.charth-1;}
else{y=this.charty+(this.charth-(pos/n)+yoffset);}
this.ctx.fillRect(this.chartx-5,y,5,1);ty=y-(item.offsetHeight/2);item.style.position='absolute';item.style.right='0px';item.style.top=ty+'px';}};CanvasChartPainter.prototype.drawHorizontalAxis=function(xlen,labels,xgd,precision){var axis,item,step,x,tx,n,multiplier;multiplier=Math.pow(10,precision);n=this.chartw/(xgd-1);axis=document.createElement('div');axis.style.position='absolute';axis.style.left='0px';axis.style.top=(this.charty+this.charth+5)+'px';axis.style.width=this.w+'px';this.el.appendChild(axis);this.ctx.fillStyle='black';for(i=0;i<xgd;i++){item=document.createElement('span');item.appendChild(document.createTextNode(labels[i]));axis.appendChild(item);x=this.chartx+(n*i);tx=x-(item.offsetWidth/2)
item.style.position='absolute';item.style.left=tx+'px';item.style.top='0px';this.ctx.fillRect(x,this.charty+this.charth,1,5);}};CanvasChartPainter.prototype.drawAxis=function(){this.ctx.fillStyle='black';this.ctx.fillRect(this.chartx,this.charty,1,this.charth-1);this.ctx.fillRect(this.chartx,this.charty+this.charth-1,this.chartw+1,1);};CanvasChartPainter.prototype.drawBackground=function(){this.ctx.fillStyle='white';this.ctx.fillRect(0,0,this.w,this.h);};CanvasChartPainter.prototype.drawChart=function(){this.ctx.fillStyle='silver';if(this.xgrid){for(i=this.xgrid;i<this.chartw;i+=this.xgrid){this.ctx.fillRect(this.chartx+i,this.charty,1,this.charth-1);}}
if(this.ygrid){for(i=this.charth-this.ygrid;i>0;i-=this.ygrid){this.ctx.fillRect(this.chartx+1,this.charty+i,this.chartw,1);}}};CanvasChartPainter.prototype.drawArea=function(color,values){var i,len,x,y,n,yoffset;n=this.range/this.charth;yoffset=(this.ymin/n);len=values.length;if(len){this.ctx.fillStyle=color;x=this.chartx+1;this.ctx.beginPath();this.ctx.moveTo(x,this.charty+this.charth-1);y=this.charty+this.charth-(values[0]/n)+yoffset;this.ctx.lineTo(x,y);for(i=1;i<len;i++){y=this.charty+this.charth-(values[i]/n)+yoffset;x+=this.xstep;this.ctx.lineTo(x,y);}
this.ctx.lineTo(x,this.charty+this.charth-1);this.ctx.closePath();this.ctx.fill();}};CanvasChartPainter.prototype.drawLine=function(color,values){var i,len,x,y,n,yoffset;n=this.range/this.charth;yoffset=(this.ymin/n);len=values.length;if(len){this.ctx.lineWidth=1;this.ctx.strokeStyle=color;x=this.chartx+1;y=this.charty+this.charth-(values[0]/n)+yoffset;this.ctx.beginPath();this.ctx.moveTo(x,y);for(i=1;i<len;i++){y=this.charty+this.charth-(values[i]/n)+yoffset;x+=this.xstep;this.ctx.lineTo(x,y);}
this.ctx.stroke();}};CanvasChartPainter.prototype.drawBars=function(color,values,xlen,xoffset,width){var i,len,x,y,n,yoffset;n=this.range/this.charth;yoffset=(this.ymin/n);len=values.length;if(len>xlen){len=xlen;}
if(len){this.ctx.fillStyle=color;x=this.chartx+xoffset+1;for(i=0;i<len;i++){y=this.charty+this.charth-(values[i]/n)+yoffset;this.ctx.beginPath();this.ctx.moveTo(x,this.charty+this.charth-1);this.ctx.lineTo(x,y);this.ctx.lineTo(x+width,y);this.ctx.lineTo(x+width,this.charty+this.charth-1);this.ctx.closePath();this.ctx.fill();x+=this.xstep;}}};function TogglePostingDetail(id){if(jQuery('#AnnouncementSummary'+id).css('display')=='none'){HidePostingDetail(id);}else{ShowPostingDetail(id);}}
function ShowPostingDetail(id){jQuery('#AnnouncementSummary'+id).hide();jQuery('#AnnouncementDetail'+id).show();if(!jQuery('#read'+id).prop('checked')){jQuery('#read'+id).click();}
var name=jQuery('#AnnouncementSummary'+id).siblings('.postingtitle').text();require(['shared:/scripts/athena/client_communication'],function(ClientCommunication){ClientCommunication.LogAction({id:id,name:name,action:'read'});});}
function LogAthenaNetworkLoad(){}
function HidePostingDetail(id){jQuery('#AnnouncementDetail'+id).hide();;jQuery('#AnnouncementSummary'+id).show();}
function MarkPostingFavorite(checked,globalpostingid){CallRemote({SUB:checked?'AthenaNetwork::GlobalPosting::MarkFavorite':'AthenaNetwork::GlobalPosting::UnmarkFavorite',ARGS:{'GLOBALPOSTINGID':globalpostingid},LOADINGINDICATORFLAG:1});}
function GetPostingFilename(){var filedata=document.zform.FILEDATA.value.split("\\");document.zform.FILENAME.value=filedata[filedata.length-1];}
var DEFAULTMAXNAMELENGTH=50;var DEFAULTMAXDESCRIPTIONLENGTH=250;var maxnamelength=DEFAULTMAXNAMELENGTH;var maxdescriptionlength=DEFAULTMAXDESCRIPTIONLENGTH;function ChangePostingType(){if(jQuery('#TYPE').attr('value')){var postingtype=jQuery('#TYPE').attr('value');if(postingtype=='ALERT'){ShowRow('NAME',true,'Posting Title');ShowRow('DESCRIPTION',true);HideRow('STARTDATE');HideRow('ENDDATE');HideRow('URL');HideRow('TARGETPAGE');HideRow('PRIORITY');ShowRow('PRACTICEIDS');ShowRow('CONTRACTTYPEIDS');ShowRow('STATES');HideRow('ANNOUNCEMENTTYPE');ShowRow('CLINICALSYN');ShowRow('COMMUNICATORYN');ShowRow('COORDINATORSENDYN');ShowRow('COORDINATORRECEIVEYN');ShowRow('COORDINATORPREREGYN');HideRow('FILENAME');HideRow('FILEDATA');HideRow('ATTACHMENTLIST');HideRow('SOURCE');HideRow('IMAGEURL');HideRow('IMAGEDESTINATIONURL');maxnamelength=DEFAULTMAXNAMELENGTH;maxdescriptionlength=325;jQuery('#PRIORITYROW .RequiredField').val('1');}else if(postingtype=='BANNER'){ShowRow('NAME',true,'Posting Name (Not visible to clients)');ShowRow('DESCRIPTION',true);ShowRow('STARTDATE',false);ShowRow('ENDDATE',false);HideRow('URL');ShowRow('TARGETPAGE',true);ShowRow('PRIORITY');ShowRow('PRACTICEIDS');ShowRow('CONTRACTTYPEIDS');ShowRow('STATES');HideRow('ANNOUNCEMENTTYPE');ShowRow('CLINICALSYN');ShowRow('COMMUNICATORYN');ShowRow('COORDINATORSENDYN');ShowRow('COORDINATORRECEIVEYN');ShowRow('COORDINATORPREREGYN');HideRow('FILENAME');HideRow('FILEDATA');HideRow('ATTACHMENTLIST');HideRow('SOURCE');HideRow('IMAGEURL');HideRow('IMAGEDESTINATIONURL');maxnamelength=DEFAULTMAXNAMELENGTH;maxdescriptionlength=4000;}else if(postingtype=='MESSAGE'){ShowRow('NAME',true,'Posting Title');ShowRow('DESCRIPTION',true);ShowRow('STARTDATE',false);ShowRow('ENDDATE',false);HideRow('URL');HideRow('TARGETPAGE');ShowRow('PRIORITY');ShowRow('PRACTICEIDS');ShowRow('CONTRACTTYPEIDS');ShowRow('STATES');HideRow('ANNOUNCEMENTTYPE');ShowRow('CLINICALSYN');ShowRow('COMMUNICATORYN');ShowRow('COORDINATORSENDYN');ShowRow('COORDINATORRECEIVEYN');ShowRow('COORDINATORPREREGYN');ShowRow('FILENAME',false,'Attachment Name');ShowRow('FILEDATA',false,'Upload Attachment');ShowRow('ATTACHMENTLIST');ShowRow('SOURCE',false,'From');ShowRow('IMAGEURL');ShowRow('IMAGEDESTINATIONURL');maxnamelength=DEFAULTMAXNAMELENGTH;maxdescriptionlength=4000;}else if(postingtype=='PROMO'){ShowRow('NAME',true,'Posting Title');ShowRow('DESCRIPTION',true);ShowRow('STARTDATE',false);ShowRow('ENDDATE',false);ShowRow('URL',false,'Read More  URL');HideRow('TARGETPAGE');HideRow('PRIORITY');ShowRow('PRACTICEIDS');ShowRow('CONTRACTTYPEIDS');ShowRow('STATES');HideRow('ANNOUNCEMENTTYPE');ShowRow('CLINICALSYN');ShowRow('COMMUNICATORYN');ShowRow('COORDINATORSENDYN');ShowRow('COORDINATORRECEIVEYN');ShowRow('COORDINATORPREREGYN');HideRow('FILENAME');HideRow('FILEDATA');HideRow('ATTACHMENTLIST');HideRow('SOURCE');HideRow('IMAGEURL');HideRow('IMAGEDESTINATIONURL');maxnamelength=45;maxdescriptionlength=140;}else if(postingtype=='RELEASENOTE'){ShowRow('NAME',true,'Posting Title');HideRow('DESCRIPTION');ShowRow('STARTDATE',true);ShowRow('ENDDATE',false);ShowRow('URL',false,'Release Notes  URL');HideRow('TARGETPAGE');HideRow('PRIORITY');ShowRow('PRACTICEIDS');ShowRow('CONTRACTTYPEIDS');ShowRow('STATES');HideRow('ANNOUNCEMENTTYPE');ShowRow('CLINICALSYN');ShowRow('COMMUNICATORYN');ShowRow('COORDINATORSENDYN');ShowRow('COORDINATORRECEIVEYN');ShowRow('COORDINATORPREREGYN');ShowRow('FILENAME',false,'PDF Name');ShowRow('FILEDATA',false,'Upload PDF');ShowRow('ATTACHMENTLIST');HideRow('SOURCE');HideRow('IMAGEURL');HideRow('IMAGEDESTINATIONURL');maxnamelength=DEFAULTMAXNAMELENGTH;maxdescriptionlength=0;}else if(postingtype=='TRAINING'){ShowRow('NAME',true,'Posting Title');ShowRow('DESCRIPTION',true);ShowRow('STARTDATE',false);ShowRow('ENDDATE',true);HideRow('URL');HideRow('TARGETPAGE');HideRow('PRIORITY');ShowRow('PRACTICEIDS');ShowRow('CONTRACTTYPEIDS');ShowRow('STATES');HideRow('ANNOUNCEMENTTYPE');ShowRow('CLINICALSYN');ShowRow('COMMUNICATORYN');ShowRow('COORDINATORSENDYN');ShowRow('COORDINATORRECEIVEYN');ShowRow('COORDINATORPREREGYN');HideRow('FILENAME');HideRow('FILEDATA');HideRow('ATTACHMENTLIST');HideRow('SOURCE');HideRow('IMAGEURL');HideRow('IMAGEDESTINATIONURL');maxnamelength=DEFAULTMAXNAMELENGTH;maxdescriptionlength=4000;}else if(postingtype=='VIDEO'){ShowRow('NAME',true,'Posting Title');ShowRow('DESCRIPTION',true);ShowRow('STARTDATE',false);ShowRow('ENDDATE',false);ShowRow('URL',true,'Video URL');HideRow('TARGETPAGE');HideRow('PRIORITY');ShowRow('PRACTICEIDS');ShowRow('CONTRACTTYPEIDS');ShowRow('STATES');HideRow('ANNOUNCEMENTTYPE');ShowRow('CLINICALSYN');ShowRow('COMMUNICATORYN');ShowRow('COORDINATORSENDYN');ShowRow('COORDINATORRECEIVEYN');ShowRow('COORDINATORPREREGYN');HideRow('FILENAME');ShowRow('FILEDATA',false,'Upload Thumbnail');HideRow('SOURCE');HideRow('IMAGEURL');HideRow('IMAGEDESTINATIONURL');maxnamelength=DEFAULTMAXNAMELENGTH;maxdescriptionlength=100;}else if(postingtype=='GENERAL'){ShowRow('NAME',true,'Posting Title');ShowRow('DESCRIPTION',true);ShowRow('STARTDATE',false);ShowRow('ENDDATE',false);HideRow('URL');HideRow('TARGETPAGE');HideRow('PRIORITY');ShowRow('PRACTICEIDS');ShowRow('CONTRACTTYPEIDS');ShowRow('STATES');HideRow('ANNOUNCEMENTTYPE');ShowRow('CLINICALSYN');ShowRow('COMMUNICATORYN');ShowRow('COORDINATORSENDYN');ShowRow('COORDINATORRECEIVEYN');ShowRow('COORDINATORPREREGYN');ShowRow('FILENAME',false,'Attachment Name');ShowRow('FILEDATA',false,'Upload Attachment');ShowRow('ATTACHMENTLIST');HideRow('SOURCE');HideRow('IMAGEURL');HideRow('IMAGEDESTINATIONURL');maxnamelength=100;maxdescriptionlength=4000;}else if(postingtype=='ATHENAPULSE'){ShowRow('NAME',true,'Posting Title');HideRow('DESCRIPTION');ShowRow('STARTDATE',true);ShowRow('ENDDATE',false);ShowRow('URL',false,'athenaPulse URL');HideRow('TARGETPAGE');HideRow('PRIORITY');ShowRow('PRACTICEIDS');ShowRow('CONTRACTTYPEIDS');ShowRow('STATES');HideRow('ANNOUNCEMENTTYPE');ShowRow('CLINICALSYN');ShowRow('COMMUNICATORYN');ShowRow('COORDINATORSENDYN');ShowRow('COORDINATORRECEIVEYN');ShowRow('COORDINATORPREREGYN');HideRow('FILENAME');HideRow('FILEDATA');HideRow('ATTACHMENTLIST');HideRow('SOURCE');HideRow('IMAGEURL');HideRow('IMAGEDESTINATIONURL');maxnamelength=DEFAULTMAXNAMELENGTH;maxdescriptionlength=0;}else if(postingtype=='ATHENAWISE'){ShowRow('NAME',true,'Posting Title');ShowRow('DESCRIPTION',true);ShowRow('STARTDATE',false);ShowRow('ENDDATE',false);ShowRow('URL',false,'Read More URL');HideRow('TARGETPAGE');HideRow('PRIORITY');ShowRow('PRACTICEIDS');ShowRow('CONTRACTTYPEIDS');ShowRow('STATES');HideRow('ANNOUNCEMENTTYPE');ShowRow('CLINICALSYN');ShowRow('COMMUNICATORYN');ShowRow('COORDINATORSENDYN');ShowRow('COORDINATORRECEIVEYN');ShowRow('COORDINATORPREREGYN');HideRow('FILENAME');HideRow('FILEDATA');HideRow('ATTACHMENTLIST');HideRow('SOURCE');HideRow('IMAGEURL');HideRow('IMAGEDESTINATIONURL');maxnamelength=45;maxdescriptionlength=140;}else{ShowRow('FILEDATA',false,'Upload Attachment');ShowRow('ATTACHMENTLIST');ShowRow('SOURCE',false,'From');ShowRow('IMAGEURL');ShowRow('IMAGEDESTINATIONURL');maxnamelength=DEFAULTMAXNAMELENGTH;maxdescriptionlength=4000;}
CheckNameAndDescriptionLength();}}
function ShowRow(fieldId,makeRequired,label){fieldId='#'+fieldId;var rowId=fieldId+'ROW';jQuery(rowId).show();if(makeRequired){jQuery(fieldId).addClass('RequiredField');}
else{jQuery(fieldId).removeClass('RequiredField');}
if(typeof label!='undefined'){var labelId=rowId+'LABEL';jQuery(labelId).html(label);}}
function HideRow(fieldId){fieldId='#'+fieldId;var rowId=fieldId+'ROW';jQuery(rowId).hide();jQuery(fieldId).removeClass('RequiredField');}
function CheckNameAndDescriptionLength(){var nameinput=new InputWrapper(document.getElementById("NAME"));var namelength=jQuery('#NAME').get(0).value.length;if(maxnamelength>0&&namelength>maxnamelength){nameinput.MarkInvalid("Posting Title has "+namelength+" characters.  Title must be equal or less than "+maxnamelength+" characters.");}else{nameinput.MarkValid();}
var descriptioninput=new InputWrapper(document.getElementById("DESCRIPTION"));var descriptionlength=jQuery('#DESCRIPTION').get(0).value.length;if(maxdescriptionlength>0&&descriptionlength>maxdescriptionlength){descriptioninput.MarkInvalid("Posting Text has "+descriptionlength+" characters. Posting Text must be equal or less than "+maxdescriptionlength+" characters.");}else{descriptioninput.MarkValid();}}
function SaveVisibleColumns(username){var configurecolumns=jQuery('[name="CONFIGURECOLUMNS"]');if(configurecolumns.filter(':checked').length===0){alert('Please select at least one column to include in the table.');return false;}
var visiblecolumns=[];configurecolumns.each(function(){if(this.checked){visiblecolumns.push(this.value);}});var visiblecoulumvalues=visiblecolumns.join('\t');var key=/hospitalactivitysummary\.esp/.test(AH.Frames.Main.frame.location)?'VISITDASHBOARD.CONFIGURECOLUMNS':'DASHBOARDCONFIGURECOLUMNS';CallRemote({SUB:'SetUserPreference',SUBSYSTEM:'User',ARGS:{KEY:key,VALUE:visiblecoulumvalues,USERNAME:username},LOADINGINDICATORFLAG:'false',ONFINISH:function(){AH.Frames.Main.Reload();}});return true;}
function OrganizationUserPositionArrayJS(organizationidelement,positionidelement,selectedval){var selectorganization=organizationidelement.value;var contracttypeid=jQuery('#CONTRACTTYPEID').val();var selectedorganizationarray=positionorganizationarray[selectorganization]||positionorganizationarray.DEFAULT;var selectedpositionarray=selectedorganizationarray[contracttypeid]||selectedorganizationarray.DEFAULT;for(i=0;i<positionidelement.options.length;i++){positionidelement[i].text="";positionidelement[i].value="";}
positionidelement.options.length=selectedpositionarray.length;for(i=0;i<selectedpositionarray.length;i++){positionidelement[i].text=selectedpositionarray[i].NAME;positionidelement[i].value=selectedpositionarray[i].ID;if(selectedpositionarray[i].ID==selectedval)positionidelement[i].selected=true;}
var defaultvalue=jQuery(positionidelement).attr('DefaultValue');function _ContainsDefaultValue(element){return element.ID==defaultvalue;}
if(jQuery.grep(selectedpositionarray,_ContainsDefaultValue).length===0){var defaultrow;for(var neighbor in selectedorganizationarray){if(selectedorganizationarray[neighbor]!=selectedpositionarray){defaultrow=jQuery.grep(selectedorganizationarray[neighbor],_ContainsDefaultValue)[0];if(defaultrow)break;}}
if(defaultrow){var i=positionidelement.options.length;positionidelement.options.length=i+1;positionidelement[i].text=defaultrow.NAME;positionidelement[i].value=defaultrow.ID;if(defaultrow.ID==selectedval)positionidelement[i].selected=true;}}}
function GoToTab(tabid,nosubmit){if(!PageChangedSinceLoad()&&jQuery('input[name=operation]').length){jQuery('input[name=operation]').val('');jQuery('input[name=operation]').attr('DefaultValue','');}
if(!nosubmit){EnableOrDisableComplianceForm();}
if(top){AH.SetGlobal('USERWIZARDTAB',tabid);}
var tabSwitch=0;if(jQuery('input[name=TAB]').attr('value')!==tabid){tabSwitch=1;}
if((nosubmit||tabSwitch||ValidateInputForm())&&document.zform&&document.zform.NEWTAB){var newTab=jQuery('input[name=NEWTAB]');newTab.val(tabid);var proceedSubmit=1;if(tabSwitch){newTab.attr('skipdirtycheck',1);jQuery('input[name=VIEW]').attr('skipdirtycheck',1);var formOperation=jQuery('input[name=operation]');if((formOperation&&formOperation.attr('value'))||PageChangedSinceLoad()){var confirmSwitchTab=confirm("There are unsaved data on this page. Moving away from this tab will result in loss of data.\nAre you sure you want to proceed?");if(confirmSwitchTab===true){proceedSubmit=1;formOperation.val('');}
else{proceedSubmit=0;}}}
if(document.zform.VIEW){document.zform.VIEW.value='';}
if(!nosubmit&&proceedSubmit){document.zform.submit();}}}
