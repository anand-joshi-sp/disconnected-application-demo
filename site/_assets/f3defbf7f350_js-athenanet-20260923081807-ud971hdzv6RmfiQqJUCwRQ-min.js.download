var recentsearch='@@@';var content=jQuery("<div></div>");var codecontainer=jQuery("<div class='icd10globalpickercontentcontainer'></div>");var headertext=snomedicd10model.HEADERTEXT;if(!headertext){var snomeddescdisplay=snomedicd10model.SNOMEDDESC||"[SNOMED]";headertext="Related to "+snomeddescdisplay;}
var searchtimer;var nextsearch;var issearching=false;var subsectionheading=jQuery("<div class='icd10globalsubsectionheading'>"+headertext+"<hr class='icd10hr'></div>");var picker=jQuery("<div class='icd10globalpicker'></div>");var searchinput=jQuery("<input class='icd10globalpickersearchinput'/>");if(nonmodal){picker.addClass('nonmodalicd10globalpicker');}
var model={SNOMEDICD10:snomedicd10model,PICKER:codecontainer.get(),ICD10ATTRS:{},$DIAGNOSISLATERALITYSELECT:$diagnosislateralityselect,ISGLOBALSEARCH:false};codecontainer.delegate(".icd10pickeritem","click",function(evt){var searchterm=searchinput.val();var sel=jQuery(this);var icdcodeallid=sel.data("icd10codeallid");var icdcode=sel.data("icd10code");var icddesc=sel.data("icd10desc");if(searchterm){var position=sel.data("icd10position");LogICD10Select(searchterm,icdcodeallid,position);}
onselect(icdcodeallid,icdcode,icddesc,sel);model.stayFocused=false;searchinput.blur();});var filters=CreateFilters(model);filters.addClass('icd10globalpickerfilters');var performsearch=function(searchstr){if(issearching){nextsearch=searchstr||" ";return;}
if(searchstr==recentsearch){return;}
recentsearch=searchstr;issearching=true;var spinner=new BusyIndicator();spinner.Start(content.get(0),{size:40,ticks:12,tickradius:15,tickwidth:7});ICD10PickerFetchICD10Data(searchstr,snomedicd10model,function(results){spinner.Stop(content.get(0));if(!nextsearch||nextsearch==recentsearch){ReplaceICD10Codes(codecontainer,results.ICD10,model.ICD10ATTRS);if(searchstr==''){model.ISGLOBALSEARCH=false;subsectionheading.show();}
else{model.ISGLOBALSEARCH=true;subsectionheading.hide();}
UpdateFilters(model,results,filters);ICD10PickerUpdateOptions(model);setTimeout(function(){ScrollToItem(picker,null,jQuery("#layout_content").get(0));},150);}
if(nextsearch){var psearch=nextsearch==' '?'':nextsearch;issearching=false;setTimeout(function(){performsearch(psearch);},0);nextsearch='';}
else{issearching=false;}});}
searchinput.keydown(function(evt){if(searchtimer){clearTimeout(searchtimer);}
var key=evt.which;if(key==13){evt.stopPropagation();}});searchinput.bind('input',function(evt){var curlen=searchinput.val().length;searchtimer=setTimeout(function(){searchtimer=0;var searchstr=searchinput.val();performsearch(searchstr);},curlen<2?0:curlen>2?500:1200);});picker.mousedown(function(){model.pickerclicked=true;model.stayFocused=true;model.scrolled=false;});jQuery(document).bind("mouseout.i10gpicker",function(evt){RefocusPicker(searchinput);});jQuery(document).bind("mousedown.i10gpicker",function(evt){model.stayFocused=true;model.wasmouseup=false;if(model.scrolled){model.pickerclicked=false;model.scrolled=false;}});jQuery(document).bind("mouseup.i10gpicker",function(evt){model.stayFocused=false;if(evt.target&&evt.target.tagName=='HTML'&&evt.target.className=='standards'){model.stayFocused=true;}
