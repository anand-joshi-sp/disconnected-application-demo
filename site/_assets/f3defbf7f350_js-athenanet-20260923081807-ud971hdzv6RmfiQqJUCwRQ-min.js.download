if(checkincomplete!=1||mainurl.match(/workflowend/)||mainurl.match(/apptworkflow/)||mainurl.match(/hcfanew.esp/)||mainurl.match(/claimadd.esp/)||mainurl.match(/encounter.esp/)){var appointmentid=args.APPOINTMENTID;var appointmentdate=args.APPOINTMENTDATE;var appointmentdept=args.APPOINTMENTDEPT;if(appointmentid&&appointmentdate&&appointmentdept){UpdateTaskbarForAppointment(appointmentdate,appointmentid,appointmentdept);}}
if(mainurl.match(/workflowend/)||mainurl.match(/apptworkflow/)||mainurl.match(/hcfanew.esp/)||mainurl.match(/claimadd.esp/)){AH.Frames.Main.SetLocation(AH.GetGlobal('contextURL'));}}};if(bannerwrapper){CallRemote({SUB:'Patient::Banner::GetBanner',ARGS:{CURRENTSTAGE:args.STAGE,ENCOUNTERID:args.CLINICALENCOUNTERID,APPOINTMENTID:args.APPOINTMENTID,INCLUDEQUICKLINKS:1,INCLUDESPECIALTYFILTER:1,INCLUDEALLERGYALERTS:1,STAGECHANGEARGS:{WAKEENCOUNTER:args.WAKEENCOUNTER,STAGE:args.STAGE,APPOINTMENTID:args.APPOINTMENTID,CLINICALENCOUNTERID:args.CLINICALENCOUNTERID,STAGEDONE:args.STAGEDONE,STARTSTAGE:args.STARTSTAGE}},ONFINISH:onfinish});}
else{CallRemote({SUB:'PatientWorkflow::HeaderHTML',ARGS:{WAKEENCOUNTER:args.WAKEENCOUNTER,STAGE:args.STAGE,APPOINTMENTID:args.APPOINTMENTID,CLINICALENCOUNTERID:args.CLINICALENCOUNTERID,STAGEDONE:args.STAGEDONE,STARTSTAGE:args.STARTSTAGE},ONFINISH:onfinish});}}
function FormHash(form,args){if(!args){args={};}
var output=args.EXISTINGOUTPUT;if(!output){output={};}
var inputs=JQueryMultiFind(['input','select','textarea'],form);var changed=0;for(var i=0;i<inputs.length;i++){var input=inputs[i];if(!changed&&!(args.ONLYCHANGED&&InputValue(input)==InputDefaultValue(input))){changed=1;}
if(args.ONLYCHANGED&&args.RESETDEFAULTVALUE){input.DefaultValue=InputValue(input);}
if(InList(input.type,['checkbox','radio'])&&!input.checked){continue;}
if(input.disabled){continue;}
var newvalue=InputValue(input);if(args.NOPOSTBLANK&&!newvalue&&!input.getAttribute('postblank')){continue;}
if(isDefined(output[input.name])){output[input.name]+="\t";}
else{output[input.name]="";}
output[input.name]+=typeof newvalue!='undefined'?newvalue:"";if(output[input.name]===""){output[input.name]="";}}
if(changed){return output;}
else{return'';}}
function SaveCheckIn(args){if(document.location.toString().match(/(apptworkflow|checkin)/)&&PageChangedSinceLoad()&&document.zform){var formdata=FormHash(document.zform,{ONLYCHANGED:1,RESETDEFAULTVALUE:1});if(formdata){CallRemote({SUB:'Appointment::SaveCheckIn',ARGS:{ID:formdata.ID,APPOINTMENTUPDATE:formdata,DONTPROCESSPAYMENTS:1},ONFINISH:args.ONFINISH});}}
else{args.ONFINISH()}}
var EPaymentWindowClosingCallback={};var epaymentwindowgetstring;var issimplifydevice=0;function OpenEPaymentApplication(url,getstring,callback,callbackfix){epaymentwindowgetstring=getstring;if(ADM&&ADM.IsEnabled()){ADM.ReloadModule('RDMCheckScanner');}
EPaymentWindowClosingCallback.wnd=window.open(url+getstring,'epaymentwindow','titlebar=no,'
+'directories=no,'
+'location=yes,'
+'menubar=no,'
+'status=yes,'
+'toolbar=no,'
+'top=0,'
+'scrollbars=yes,'
+'resizable=yes');if(callback){if(callbackfix&&callbackfix=='1'){var callbackfunction=new Function(callback);EPaymentWindowClosingCallback.callback=callbackfunction;}
else{EPaymentWindowClosingCallback.callback=callback;}}
else{EPaymentWindowClosingCallback.callback=EPaymentDefaultWindowClosingCallback;}
clearInterval(EPaymentWatchForWindowClosing.interval);EPaymentWatchForWindowClosing.interval=window.setInterval(EPaymentWatchForWindowClosing,500);}
function OpenEPaymentApplicationByPOST(url,args,callback,callbackfix){var form=document.createElement("form");form.action=url;form.method='POST';for(var key in args)
{var input=document.createElement('input');input.type='hidden';input.name=key;input.value=typeof args[key]==="object"?JSON.stringify(args[key]):args[key];form.appendChild(input);}
issimplifydevice=args.ISSIMPLIFYDEVICE;document.body.appendChild(form);EPaymentWindowClosingCallback.wnd=window.open('','epaymentwindow','titlebar=no,'
+'directories=no,'
+'location=yes,'
+'menubar=no,'
+'status=yes,'
+'toolbar=no,'
+'top=0,'
+'scrollbars=yes,'
+'resizable=yes');form.target='epaymentwindow';form.submit();document.body.removeChild(form);if(callback){if(callbackfix&&callbackfix=='1'){var callbackfunction=new Function(callback);EPaymentWindowClosingCallback.callback=callbackfunction;}
else{EPaymentWindowClosingCallback.callback=callback;}}
else{EPaymentWindowClosingCallback.callback=EPaymentDefaultWindowClosingCallback;}
clearInterval(EPaymentWatchForWindowClosing.interval);EPaymentWatchForWindowClosing.interval=window.setInterval(EPaymentWatchForWindowClosing,500);}
function EPaymentWatchForWindowClosing(){try{if(EPaymentWindowClosingCallback.wnd.closed){if(ADM&&ADM.IsEnabled()){var re=new RegExp("ISSIMPLIFYDEVICE=1");if(re.test(epaymentwindowgetstring)||issimplifydevice){ADM.ResetSimplify();}
ADM.CloseRDMCheckScanner({setShouldPreserve:false});ADM.StopBurroughsScanner();}
window.clearInterval(EPaymentWatchForWindowClosing.interval);var handled=EPaymentWindowClosingCallback.callback.apply();if(!handled)EPaymentDefaultWindowClosingCallback();}}
catch(e){}}
function EPaymentDefaultWindowClosingCallback(){return true;}
function SwipeTrackData(track1,track2,track3){this.Reset(track1,track2,track3);}
SwipeTrackData.prototype.Reset=function(track1,track2,track3){this.track1={data:track1,valid:false};this.track2={data:track2,valid:false};this.track3={data:track3,valid:false};this.validatedAs=false;}
SwipeTrackData.prototype.ValidateCreditCard=function(){if(this.validatedAs){this.Reset(this.track1.data,this.track2.data,this.track3.data);}
this.validatedAs='CREDIT';var track1regexp=/^%B(\d+)\^([A-Z\/ ]+)\^(\d{2})(\d{2})\d*\?$/;this.track1.valid=track1regexp.test(this.track1.data);this.track1.number=RegExp.$1;this.nameoncard=RegExp.$2;var names=this.nameoncard.split('/');if(names[1]){this.nameoncard=names[1]+' '+names[0];}
this.track1.year='20'+RegExp.$3;this.track1.month=RegExp.$4;var track2regexp=/^;(\d+)=(\d{2})(\d{2})\d*\?$/;this.track2.valid=track2regexp.test(this.track2.data);this.track2.number=RegExp.$1;this.track2.year='20'+RegExp.$2;this.track2.month=RegExp.$3;}
