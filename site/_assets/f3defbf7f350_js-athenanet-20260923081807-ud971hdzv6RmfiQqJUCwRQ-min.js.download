if(!document.querySelector('style[data-fescontainerquery]')){window.document.head.appendChild(fes_2_col_smuggledContainerQuery())}}
function fes_2_col_listenToSectionUpdates(){var observer=new MutationObserver(function(mutations){var bodyUpdate=mutations.find(function(m){return m.type==='childList'})
if(bodyUpdate&&!bodyUpdate.target.querySelector('.masonry')){fes_2_col_render()}});observer.observe(window.document.body,{childList:true})}
function fes_2_col_smuggledContainerQuery(){var style=document.createElement('style');style.toggleAttribute('data-fescontainerquery',true)
style.textContent='@container (width < 750px) {'+
'   body.two-column-summary #SECTIONCONTAINER:not(:has(.closedencountersummary)),'+
'   body.two-column-summary .closedencountersummary {'+
'       grid-template-columns: 1fr;'+
'       grid-auto-rows: auto;'+
'       #SUMMARYCONTAINER {'+
'           grid-column: span 1;'+
'           grid-row: span 1;'+
'       }'+
'   }'+
'   .divider {'+
'   display: none'+
'   }'+
'}'
return style;}
