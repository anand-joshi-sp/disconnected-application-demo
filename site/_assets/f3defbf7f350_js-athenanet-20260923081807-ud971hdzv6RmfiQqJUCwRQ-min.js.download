var resultType=jQuery(this);if(resultType.is(':visible')){var resultTypeValue=resultType.val();if(resultTypeValue.length&&resultTypeValue[0]){var resultValueElement=resultType.parent('td').parent('tr').find("[name*='RESULTVALUE']");if(resultValueElement){var resultValue=resultValueElement.val();if(!(resultValue.length&&resultValue[0])){isRequiredField=true;}}}}});return isRequiredField;}
function HideDocumentResultTable(){var structuredDocResults=jQuery('#structureddocresults');if(structuredDocResults.length&&structuredDocResults.is(":visible")){var table=jQuery("#DOCRESULTTABLE").get(0);if(table){var rowCount=table.rows.length;for(var index=rowCount-1;index>2;index--){table.deleteRow(index);}
for(var rowIndex=1;rowIndex<=2;rowIndex++){var tableRow=jQuery(table.rows[rowIndex]);if(tableRow.length){tableRow.find("select").children('option:not(:first)').remove();tableRow.find("input[name*='RESULTTYPEVALUEID']").val('');if(rowIndex===2){var rowDeleteLink=tableRow.find("a[name*='docresultdelete']").filter(':visible');if(rowDeleteLink.length){rowDeleteLink.hide();}}}}}
structuredDocResults.hide();}}
