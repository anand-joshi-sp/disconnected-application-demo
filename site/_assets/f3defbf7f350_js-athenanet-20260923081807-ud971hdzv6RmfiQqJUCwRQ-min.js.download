else{if(textarea.className.match(/autoresize_expandable/)){jqtextarea.addClass('autoresize_expanded');jqtextarea.removeClass('autoresize_expandable');}}};if(jqtextarea.height()==0){return;}
jqtextarea.css('height','');if(jqtextarea.val()==''){jqtextarea.css('overflow-y','auto').attr('rows',minrows);switchclass('');return;}
