fieldprefix=fieldjq
.attr('name')
.replace(/[{]?NOTEFORPHARMACYFROMPRESCRIBER[}]?/g,'');CallRemote({SUB:'Document::Class::PRESCRIPTION::NoteToPharmacyHTMLWrapper',ARGS:{CLINICALORDERTYPEID:args.CLINICALORDERTYPEID,DEPARTMENTID:args.DEPARTMENTID,DOCUMENTID:args.DOCUMENTID,DOCUMENTSUBCLASS:args.DOCUMENTSUBCLASS,PATIENTID:args.PATIENTID,PROVIDERID:args.PROVIDERID,FIELDPREFIX:fieldprefix,FIELDVALUE:fieldjq.val(),DISABLED:fieldjq.attr('disabled')},ONFINISH:function(data){if(data){notedivjq.replaceWith(data);}}});return;}
