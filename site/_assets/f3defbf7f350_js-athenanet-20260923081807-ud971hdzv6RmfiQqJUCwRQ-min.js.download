function _OpenDymoPrinterSelect(args){top.AthenaPattern_Popup.open({CONTENTHTML:args.POPUPHTML,OVERLAYTYPE:'LIGHTBOX',ONCLOSE:function(dymoprinter){if(dymoprinter){var expires=new Date(9999,11,31);var cookie='UNENCRYPTED_DYMOPRINTERNAME='+encodeURIComponent(dymoprinter);cookie+='; expires='+expires.toGMTString();cookie+='; path=/; domain=athenahealth.com';document.cookie=cookie;if(args.ADMENABLED){window.DYMOLabelPrinter.CallPrintWithPrinter(args.LABELURL,args.FIELDS,dymoprinter);}
else{PrintToSelectedDymoPrinter(args.FIELDS,args.LABELURL,dymoprinter,args.DYMOADDIN,args.DYMOLABEL);}
AH.SetGlobal('nodymoprinterselected',false);}
else{AH.SetGlobal('nodymoprinterselected',true);if(args.ADMENABLED){window.admdymomoduleisprinting=false;window.admdymolabels=[];}}
AH.SetGlobal('printerselectpopupopen',false);}});}
function PrintToSelectedDymoPrinter(fields,labelurl,dymoprinter,DymoAddIn,DymoLabel){if(!DymoAddIn.OpenURL(labelurl)){alert('Error: could not get label file from '+labelurl);return;}
for(var field in fields){DymoLabel.SetField(field,fields[field]);}
DymoAddIn.SelectPrinter(dymoprinter);DymoAddIn.Print(1,false);}
