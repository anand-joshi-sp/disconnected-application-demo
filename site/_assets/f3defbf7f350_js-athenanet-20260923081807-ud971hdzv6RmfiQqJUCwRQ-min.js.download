var rowindex=parseInt(sourcerow.rowIndex)+1;if(inencounter){var sourceindex=GetBlankLetterRowIndex(sourcetable);var newrow=AddBlankRow({TABLE:sourcetable,SOURCEINDEX:sourceindex,TARGETINDEX:rowindex});}
else{var newrow=sourcetable.insertRow(rowindex);newrow.appendChild(document.createElement('th'));newrow.cells[0].innerHTML="<span id='addresseetype'>Cc</span>";var clonecell=sourcetable.rows[1].cells[1].cloneNode(true);newrow.appendChild(clonecell);jQuery('#RECIPIENTPICKER_button',newrow).html('Add');jQuery('[name$="{RECIPIENTID}"]',newrow).val('');jQuery('[name$="{RECIPIENTTYPE}"]',newrow).val('');jQuery('[name$="{ID}"]',newrow).val('');jQuery('[name$="{PROVIDERNOTE}"]',newrow).remove();newrow.appendChild(document.createElement('th'));newrow.cells[2].innerHTML="Fax Number";var clonecell=sourcerow.cells[3].cloneNode(true);newrow.appendChild(clonecell);jQuery('[name$="{GENERATECCLETTER}"]',newrow).val('');jQuery('[name$="{CALLBACKNUMBER}"]',newrow).val('');var clonecell=sourcerow.cells[4].cloneNode(true);newrow.appendChild(clonecell);jQuery('[name$="{DELETE}"]',newrow).val('');}
jQuery('[name*="{NEW}"]',newrow).add('[name*="{EXISTING}"]',newrow).each(function(){if(this.name&&this.name.match(/.*\{.*\}\{\d*\}\{\d*(\}.*)$/)){this.name=prefix+letternumber+RegExp.$1;}});if(inencounter){var generateletter=jQuery('[name$="{GENERATELETTER}"]',newrow);generateletter.closest('label').css('display','none');generateletter.val('');var autoapprove=jQuery('[name$="{AUTOAPPROVE}"]',newrow);autoapprove.closest('label').css('display','none');autoapprove.val('');jQuery('#addresseetype',newrow).html('Cc: ');jQuery('span[recipientclass=Patient]',newrow).remove();jQuery('#deleteicon',newrow).closest('td').nextAll('td').children().not('[name$="{DELETE}"],[name$="{CALLBACKNUMBER}"]').remove();}
if(hideicons){jQuery('#deleteicon',newrow).css('display','none');jQuery('#addanothericon',newrow).css('display','none');}
else{jQuery('#deleteicon',newrow).css('display','inline');jQuery('#addanothericon',sourcerow).css('display','none');jQuery('#addanothericon',newrow).css('display','inline');}
if(autoopen=='1'){var picker=jQuery('#RECIPIENTPICKER_button',newrow).get(0);Picker.OpenContent('RECIPIENTPICKER',picker);}}
function ToggleCcCreation(generateletterfield){var parentstate=generateletterfield.checked?1:'';var prefix=generateletterfield.name.match(/(LETTER\{\D+\}\{\d+\}\{)\d+\}/)[1];jQuery(generateletterfield)
.parents("tr:first")
.siblings()
.find('[name*=GENERATECCLETTER][name*="'+prefix+'"]')
.each(function(){this.value=parentstate;});}
function DeleteLetter(sourceobject,suppresscc,environment){var lettertable=jQuery(sourceobject).closest("table.dataentry").get(0);var letterrow=jQuery(sourceobject).closest("table.dataentry > tbody > tr").get(0);var exampleinput=GetChild(letterrow,'name',/{DELETE}$/);if(exampleinput&&exampleinput.name&&exampleinput.name.match(/.*(\{\D*\}\{\d*\})\{(\d*)\}.*/)){var statuslettergroup=RegExp.$1;var position=RegExp.$2;if(position=='0'){for(var i=letterrow.rowIndex;i<lettertable.rows.length;i++){var deleteinput=GetChild(lettertable.rows[i],'name',/{DELETE}$/);if(deleteinput&&deleteinput.name.match(EscapeRegExp(statuslettergroup))){deleteinput.value=1;var generateinput=GetChild(lettertable.rows[i],'name',/{GENERATECCLETTER}$/);if(generateinput){generateinput.value='';}
lettertable.rows[i].style.display='none';}
else{break;}}}
else{exampleinput.value=1;var generateinput=GetChild(letterrow,'name',/{GENERATECCLETTER}$/);if(generateinput){generateinput.value='';}
letterrow.style.display='none';if(!suppresscc){var above;var aboveindex;var below;for(var i=letterrow.rowIndex;i>0;i--){var previousrow=lettertable.rows[i];if(previousrow&&previousrow.style&&previousrow.style.display=='none'){continue;}
else{aboveindex=i;if(jQuery('#addresseetype',previousrow).text().match(/^Cc/)){above='Cc';}
else if(jQuery('#addresseetype',previousrow).length){above='To';}
break;}}
for(var i=parseInt(letterrow.rowIndex)+1;i<lettertable.rows.length;i++){var nextrow=lettertable.rows[i];if(nextrow&&nextrow.style&&nextrow.style.display=='none'){continue;}
else{if(jQuery('#addresseetype',nextrow).text().match(/^Cc/)){below='Cc';}
else if(jQuery('#addresseetype',nextrow).length){below='To';}
break;}}
if(above=='Cc'&&below!='Cc'){jQuery('#addanothericon',lettertable.rows[aboveindex]).css('display','inline');}
else if(above!='Cc'&&below!='Cc'){AddCCRow(lettertable.rows[letterrow.rowIndex],0,1,environment);}}}}
var recipienttypename=jQuery('[name*=RECIPIENTTYPE]',letterrow).attr('name');var cclist;if(environment=='Document'){cclist=jQuery('#CCLIST').get(0);}
else{var prefix=recipienttypename.match(/(LETTER\{\D+\}\{\d+\}\{)\d+\}/)[1];cclist=jQuery('[name*=CCLIST][name*="'+prefix+'0}"]').get(0);}
UpdateLetterCC(recipienttypename,letterrow,cclist);var generatelettercheckbox=GetChild(letterrow,'name',/{GENERATELETTER}$/);if(generatelettercheckbox){generatelettercheckbox.checked=false;}
if(environment!='Document'){RefreshLetterTableStyles(lettertable);if(!jQuery('.lettertablerow:visible',lettertable).length){jQuery(lettertable).hide();}}}
function ChangeLetterTemplate(documentid,sourceobject){var lettertable=document.getElementById('LETTEREDIT');var jqdocumentversiontoken=jQuery('#DOCUMENTVERSIONTOKEN');if(lettertable){var edityn=jQuery('input[name=EDITYN]').val();if(edityn=='Y'){var confirmation=confirm('Changing the template will completely replace the contents of the letter. All edits will be lost. Are you sure you want to change the template?');if(!confirmation){sourceobject.value=sourceobject.oldvalue;return;}}
if(sourceobject.value){CallRemote({SUB:'Document::Class::LETTER::ChangeLetterTemplate',ARGS:{DOCUMENTID:documentid,DOCUMENTVERSIONTOKEN:jqdocumentversiontoken.val(),CLINICALPAPERFORMID:sourceobject.value},ONFINISH:function(){ChartTabsRefreshTab(String(documentid));require(['shared:/scripts/athena/utils/cross_frame_events'],function(CrossFrameEventUtils){CrossFrameEventUtils.trigger('letter-groups-refresh');CrossFrameEventUtils.trigger('document-iframe-template-changed',{documentId:documentid});CrossFrameEventUtils.trigger('document-save-complete',{documentID:String(documentid)})});},LOADINGINDICATORFLAG:true});}
else{lettertable.innerHTML='';ReinitializeSpeechEnabledFields();}
sourceobject.oldvalue=sourceobject.value;}}
function ChangeLetterRecipient(recipient,sourceobject,environment){var recipientjq=jQuery(recipient);var inencounter=environment=='Document'?false:true;var sourcerow=sourceobject.tagName=='TR'?sourceobject:jQuery(sourceobject).closest("table.dataentry > tbody > tr").get(0);var isccletter=jQuery('#addresseetype',sourcerow).text().match(/^Cc/);if(!isccletter&&inencounter){jQuery('[name*=GENERATELETTER]',sourcerow).get(0).checked=1;}
else{if(inencounter){var generatecc=jQuery('[name*=GENERATECCLETTER]',sourcerow);var prefix=generatecc.attr('name').match(/(LETTER\{\D+\}\{\d+\}\{)\d+\}/)[1];var generateletter=jQuery('[name*=GENERATELETTER][name*="'+prefix+'0}"]').get(0);var id=jQuery('[name*=ID][name*="'+prefix+'0}"]');if(generateletter.checked||id.val()){generatecc.val('1');}
else{generatecc.val('');}}
else{jQuery('[name*=GENERATECCLETTER]',sourcerow).val('1');}}
if(isccletter){var deleteicon=jQuery('#deleteicon:not(:visible)',sourcerow);if(deleteicon.length){deleteicon.show();jQuery('#addanothericon',sourcerow).show();}}
jQuery('#RECIPIENTPICKER_button',sourcerow).html(recipientjq.attr('LETTERRECIPIENTNAME'));var recipientid=jQuery('[name*=RECIPIENTID]',sourcerow);recipientid.val(recipient.ID).change();var recipientclass=jQuery('[name*=RECIPIENTCLASS]',sourcerow);recipientclass.val(recipient.RECIPIENTCLASS||'Other').change();var recipienttype=jQuery('[name*=RECIPIENTTYPE]',sourcerow);recipienttype.val(recipientjq.attr('ACTIVEID')).change();var sourcerowjq=jQuery(sourcerow);if(inencounter){var recipientclass=jQuery('#recipientclass',sourcerow);if(recipientjq.attr('RECIPIENTCLASS')&&recipientjq.attr('RECIPIENTCLASS')!='Patient'){recipientclass.show().html(recipientjq.attr('RECIPIENTCLASS'));}
else{recipientclass.hide();}
var newletterworkflow=sourcerowjq.siblings('.headerrow').length>1;var headerrow=sourcerowjq.prevAll('.headerrow:first');var ispatientsection=headerrow.attr('recipientclass')=='Patient';if(recipientjq.attr('RECIPIENTCLASS')=='Patient'){var nextrow=sourcerowjq.next('tr');while(nextrow.length){var addresseetype=jQuery('#addresseetype',nextrow);if(addresseetype.text().match(/^Cc/)){DeleteLetter(addresseetype,1,environment);nextrow=jQuery(nextrow).next('tr');}
else{nextrow=[];}}
if(newletterworkflow&&!ispatientsection){sourcerowjq.insertBefore(headerrow.prev());var table=jQuery('#addresseetype',sourcerow).closest('table');jQuery('td:nth-child(1)',table).hide();var providernotelabel=jQuery('#providernotelabel',table);providernotelabel.closest('td').next().prepend(providernotelabel);}}
else{if(!isccletter){if(newletterworkflow&&ispatientsection){sourcerowjq.insertAfter(sourcerowjq.nextAll('tr:last'));var table=jQuery('#addresseetype',sourcerow).closest('table');jQuery('td:nth-child(1)',table).show();var providernotelabel=jQuery('#providernotelabel',table);providernotelabel.closest('td').prev().prepend(providernotelabel);}
var nextrow=sourcerowjq.nextAll('tr:visible:first');if(!jQuery('#addresseetype',nextrow).text().match(/^Cc/)){AddCCRow(sourcerow,0,1,environment);}}}
RefreshLetterTableStyles(sourcerowjq.closest('table').get(0));if(isccletter){var prefix=recipienttype.attr('name').match(/(LETTER\{\D+\}\{\d+\}\{)\d+\}/)[1];var cclist=jQuery('[name*=CCLIST][name*="'+prefix+'0}"]').get(0);UpdateLetterCC(recipienttype.attr('name'),sourcerow,cclist);}
else{var newclinicalprovidername=InList(recipientjq.attr('ACTIVEID'),['CLINICALPROVIDERID','REFERRINGPROVIDERID'])?recipientjq.attr('LETTERRECIPIENTNAME'):'';jQuery('[name*=CLINICALPROVIDERNAME]',sourcerow).val(newclinicalprovidername);jQuery('[name*=LETTERRECIPIENTNAME]',sourcerow).val(recipientjq.attr('LETTERRECIPIENTNAME'));}}
var fax=jQuery('[name*=CALLBACKNUMBER]',sourcerow).get(0);if(fax){if(recipientjq.attr('FAX')&&recipientjq.attr('FAX').match(/(\d{3}).*(\d{3}).*(\d{4})/)){fax.value='('+RegExp.$1+') '+RegExp.$2+'-'+RegExp.$3;}
else{fax.value='';}}
var currentpaperformoptions=sourcerowjq.find(jQuery("[name*='CLINICALPAPERFORMID']"));var selectedoption=currentpaperformoptions.find(":selected").val();var nonpatientrecipient=(recipienttype.val()=='PATIENTID')?0:1;CallRemote({SUB:'Document::Class::LETTER::GetClinicalPaperFormsAsArrayRef',ARGS:{DEPARTMENTID:AH.GetGlobal('DEPARTMENTID'),NONPATIENTRECIPIENT:nonpatientrecipient},ONFINISH:function(clinicalpaperforms){currentpaperformoptions.empty();paperformselect=currentpaperformoptions.get(0);if(paperformselect!==undefined){paperformselect.options[0]=new Option();for(var i=0;i<clinicalpaperforms.length;i++){paperformselect.options[i+1]=new Option(clinicalpaperforms[i].NAME,clinicalpaperforms[i].ID);}
currentpaperformoptions.val(selectedoption);}}});if(inencounter){return;}
var lettertable=document.getElementById('LETTEREDIT');if(isccletter){var cclist=jQuery('#CCLIST',lettertable).get(0);if(cclist){UpdateLetterCC(recipienttype.attr('name'),sourcerow,cclist);}
return;}
jQuery(lettertable).find('#LETTERRECIPIENTNAME').each(function(i){jQuery(this).html(recipientjq.attr('LETTERRECIPIENTNAME'));});jQuery(lettertable).find('#CLINICALPROVIDERNAME').each(function(i){var clinicalprovidernamevalue=InList(recipientjq.attr('ACTIVEID'),['CLINICALPROVIDERID','REFERRINGPROVIDERID'])?recipientjq.attr('LETTERRECIPIENTNAME'):'';jQuery(this).html(clinicalprovidernamevalue);});}
function ChangeLetterRecipientDocView(recipient,sourceobject){ChangeLetterRecipient(recipient,sourceobject,'Document');}
function UpdateLetterCC(recipienttypename,sourcerow,cclist){if(!cclist){return;}
var recipienttable=jQuery(sourcerow).parents("table:first").get(0);var prefix=recipienttypename.match(/(LETTER\{\D+\}\{\d+\}\{)\d+\}/)[1];var typeid=new Array();jQuery('[name*=RECIPIENTTYPE][name*="'+prefix+'"]',recipienttable).not('[name*="{0}"]').each(function(){if(!this.value){return;}
var fullprefix=this.name.match(/(LETTER\{\D+\}\{\d+\}\{\d+\})/)[1];if(!jQuery('[name*=DELETE][name*="'+fullprefix+'"]',recipienttable).val()){var recipientid=jQuery('[name*=RECIPIENTID][name*="'+fullprefix+'"]',recipienttable);typeid.push([this.value,recipientid.val()]);}});if(typeid.length>0){CallRemote({SUB:'Document::Class::LETTER::GetCCList',ARGS:{TYPEID:typeid},ONFINISH:function(data){if(cclist.tagName=='SPAN'){jQuery(cclist).html(data);}
else{jQuery(cclist).val(data);}}});}
else{if(cclist.tagName=='SPAN'){jQuery(cclist).html('');}
else{jQuery(cclist).val(' ');}}}
function SplitProviderOrdertypeIds(field){var autoobject=field.autocompleteobj;var providerordertypeids=autoobject.autocompletionvalue;var ordertypename=TrimWhitespace(autoobject.autocompletionname);var ordertypenamespanid=document.getElementById(field.name+'_NAME');if(ordertypename){field.value='';if(ordertypename.split(':')[1]){ordertypenamespanid.innerHTML=ordertypename.split(':')[1];}
else{ordertypenamespanid.innerHTML=ordertypename;}}
var ordertypelist=providerordertypeids.split(":");var ordertypeid=ordertypelist[0];var providerordertypeid=ordertypelist[1];if(providerordertypeid==null){providerordertypeid='';}
if(field.name=='PROVIDERANDORDERTYPEID'){document.zform.CLINICALORDERTYPEID.value=ordertypeid;document.zform.CLINICALPROVIDERORDERTYPEID.value=providerordertypeid;}else if(field.name=='ADDNEWLABCLINICALORDERTYPEID'){document.zform.ADDNEWCLINICALORDERTYPEID.value=ordertypeid;document.zform.ADDNEWCLINICALPROVIDERORDERTYPEID.value=providerordertypeid;}}
function AddFlowsheetElement(elementinput){var addelementrow=document.getElementById("ADDELEMENTROW");if(!addelementrow){return;}
var isclassicflowsheet=jQuery(addelementrow).data('isClassicFlowsheet');var elementnameinput=jQuery('#ELEMENTNAME',addelementrow).get(0);var elementclassselector=jQuery('#ELEMENTCLASSSELECTOR',addelementrow).get(0);var elementkeyselector=jQuery("[name='"+elementinput.replace(/([\{\}\.\+\:])/g,'\\$1')+"']").get(0);if(!elementnameinput||elementnameinput.value==''){alert('You must have a column name.');return;}
var elementname=elementnameinput.value;var elementclass=elementclassselector.value;var elementclassdisplayname=selectText(elementclassselector);var elementkey=elementkeyselector?elementkeyselector.value:elementname;var elementkeydisplayname=elementkeyselector?selectText(elementkeyselector):'';var elementmapping=elementclassdisplayname+(elementkeydisplayname?' - '+elementkeydisplayname:'');var elementstable=document.getElementById('FLOWSHEETELEMENTSTABLE');var duplicate=GetChild(elementstable,'id',elementname,'elementclass',elementclass);if(duplicate){alert("this flowsheet already tracks "+elementname+" ("+elementclassdisplayname+")");elementnameinput.value='';return;}
var fieldprefix="ELEMENTS{"+elementclass+"}{"+elementkey+"}";elementstable.rows[0].insertCell().innerHTML="<span id='"+elementname+"' elementclass='"+elementclass+"'>"
+"<u>"+elementname+"</u><br>"+elementmapping
+"</span>"
+"<div nowrap>"
+"<span "
+"style='cursor:pointer; float:right;' "
+"onclick=';DeleteFlowsheetElement(event.srcElement);'>"
+"<span title='Delete Element' class=sprite-del-16x16></span>"
+"</span>"
+(isclassicflowsheet?"<span title='Rows in the flowsheet will only show up if a row-creating element has data on that date. If no elements are checked then all elements will create rows'>"
+"<input type=checkbox name='"+fieldprefix+"{CREATESROWYN}' value='Y'>"
+"</span>Creates Row"
+"</div>"
+"<div nowrap>Edit Layout Column <select type=select name='"+fieldprefix+"{EDITLAYOUTCOLUMN}'>"
+"<option value=''><option value='1'>1<option value='2'>2<option value='3'>3<option value='4'>4</select>"
+"</div>":'')
+"Ordering <input name='"+fieldprefix+"{ORDERING}' style='width: 30px' type=text value=0>"
+"</span>"
+"<input type=hidden name='"+fieldprefix+"{NAME}' value='"+elementname+"'>"
+"<input type=hidden name='"+fieldprefix+"{ELEMENTKEY}' value='"+elementkey+"'>"
+"<input type=hidden name='"+fieldprefix+"{ELEMENTCLASS}'"+" value='"+elementclass+"'>";elementnameinput.value='';UpdateOrdering(elementstable);}
function DeleteFlowsheetElement(deletebuttonimg){var holdercell=GetParent(deletebuttonimg,'tagName','TD');var elementstable=GetParent(holdercell,'id','FLOWSHEETELEMENTSTABLE');holdercell.parentNode.removeChild(holdercell);UpdateOrdering(elementstable);}
function UpdateOrdering(elementstable){var row=elementstable.rows[0];for(var i=0;i<row.cells.length;i++){var cell=row.cells[i];var orderinginput=GetChild(cell,'name',/{ORDERING}/);if(orderinginput){orderinginput.value=i;}}}
function UpdateSectionCount(showhidespan,count){var parentrow=GetRowContainer(showhidespan);var sectionstateid=showhidespan.id.replace(/\{SHOWHIDE\}/,'{STATE}{HEADER}');var sectionselectallid=showhidespan.id.replace(/\{SHOWHIDE\}/,'{SELECTALL}');var sectionselectid=showhidespan.id.replace(/\{SHOWHIDE\}/,'{ITEM}');var sectionheaderid=showhidespan.id.replace(/\{SHOWHIDE\}/,'{HEADER}');var sectionstate=document.getElementById(sectionstateid);var sectionheader=document.getElementById(sectionheaderid);var sectionselect=document.getElementById(sectionselectallid);if(!sectionselect){sectionselect=document.getElementById(sectionselectid);}
var counttext;if(!count){count=0;};counttext='('+count+')';if(sectionstate.value=='HIDDEN'){sectionstate.parentElement.shuttleobject.UpdateRowState(parentrow,sectionstateid,'AVAILABLE');}
showhidespan.innerText=counttext;if(count==0&&sectionselect.className!='letterselectallempty'){sectionselect.className='letterselectallempty';jQuery(sectionheader).children('#collapse').css('visibility','hidden');jQuery(sectionheader).children('#expand').css('visibility','hidden');}
else if(count>0&&sectionselect.className!='letterselectall'){sectionselect.className='letterselectall';jQuery(sectionheader).children('#collapse').css('visibility','visible');jQuery(sectionheader).children('#expand').css('visibility','visible');}}
function FilterAttachmentsByDate(args){var tableid=args.TABLEID;var idfilter=args.IDFILTER;var prefix=args.PREFIX;if(!prefix){prefix='';}
var formelement=document.getElementsByName(args.PARENTFORMNAME||'zform')[0];if(!formelement[prefix+'STARTDATE']||!formelement[prefix+'ENDDATE']){return;}
var startdate=jQuery(formelement).find("input[name='"+EscapeJQuerySelector(prefix)+"STARTDATE']").val();var enddate=jQuery(formelement).find("input[name='"+EscapeJQuerySelector(prefix)+"ENDDATE']").val();startdate=MakeDateComparable(startdate);enddate=MakeDateComparable(enddate);var selectspan=document.getElementById(tableid);var selectspanshuttle=jQuery(selectspan).prop('shuttleobject');var alldateitems=selectspanshuttle.alldateitems;var allshowhidespans=selectspanshuttle.allshowhidespans;var sectioncounts={};for(var i=0;i<alldateitems.length;i++){if(idfilter&&!alldateitems[i].id.match(idfilter)){continue;}
var itemdate=alldateitems[i].value;var parentrow=GetRowContainer(alldateitems[i]);var dateditemsectionname=alldateitems[i].name.match(/(.*)\{DATE\}/)[1];var stateid=alldateitems[i].name.replace(/\{DATE\}/,'{STATE}');var stateinput=selectspanshuttle.stateinputhash[stateid];var parentshuttleobject=jQuery(stateinput).closest("span.letteritem").prop("shuttleobject");if((!startdate||itemdate>=startdate)&&(!enddate||itemdate<=enddate)){if(stateinput.value=='HIDDEN'){parentshuttleobject.UpdateRowState(parentrow,stateid,'AVAILABLE');}
if(sectioncounts[dateditemsectionname]){sectioncounts[dateditemsectionname]++;}
else{sectioncounts[dateditemsectionname]=1;}}
else{if(stateinput.value=='AVAILABLE'){parentshuttleobject.UpdateRowState(parentrow,stateid,'HIDDEN');}
if(!sectioncounts[dateditemsectionname]){sectioncounts[dateditemsectionname]=0;}}}
for(var j=0;j<allshowhidespans.length;j++){var showhideid=allshowhidespans[j].id.match(/(.*)\{SHOWHIDE\}/)[1];if(!idfilter||showhideid.match(idfilter)){UpdateSectionCount(allshowhidespans[j],sectioncounts[showhideid]);}}}
function MakeDateComparable(datestring){if(datestring.match(/(\d+)\/(\d+)\/(\d+)/)){var month=RegExp.$1;var day=RegExp.$2;var year=RegExp.$3;return""+year+month+day;}
return'';}
var AttachmentPreviewer={timeout:null,overPreviewer:false,currentItemId:null,currentItemTitle:null,menudiv:null,noviewdocument:0,iswidget:0,newparenttag:'body',initialize:function(menudivid,viewdocumentstatus,_iswidget){this.menudiv=document.getElementById(menudivid);if(_iswidget){var jqmenudiv=jQuery(this.menudiv);if(jqmenudiv.css('z-index')==='auto'){var jqmenuparent=jqmenudiv.parent();var zindex;while(jqmenuparent.length){zindex=jqmenuparent.css('z-index');if(zindex!='auto'){jqmenudiv.css('z-index',Number(zindex)+1);break;}
jqmenuparent=jqmenuparent.parent();}}}
this.menudiv.style.position='absolute';noviewdocument=Number(viewdocumentstatus);iswidget=_iswidget;},DisplayAttachmentView:function(parent,delaytime,itemid){if(noviewdocument){return;}
var parenttag=this.menudiv.parentNode.tagName.toLowerCase();if(parenttag!=this.newparenttag){jQuery(this.menudiv).detach().appendTo(this.newparenttag);}
clearTimeout(this.timeout);var delaytime=delaytime||1000;if(this.menudiv.style.display=="inline"){this._HideAttachmentView();delaytime=500;}
var offsettop=0;if(jQuery(document.body).css('overflow')!="hidden"){offsettop=jQuery(window).scrollTop();}
var x=window.event.clientX;var y=window.event.clientY+offsettop;this.currentItemId=parent.id;this.currentItemTitle=parent.documenttitle;this.timeout=setTimeout(function(){AttachmentPreviewer._DisplayAttachmentView(parent,x,y);},delaytime);},_DisplayAttachmentView:function(parent,x,y){jQuery('#'+this.menudiv.id).addClass('legacybgcolorwhite');jQuery(this.menudiv).show();this.menudiv.style.left=(x+15)+"px";this.menudiv.style.top=(y-20)+"px";},HideAttachmentView:function(delaytime){if(noviewdocument){return;}
var delaytime=delaytime||250;clearTimeout(this.timeout);this.timeout=setTimeout(function(){AttachmentPreviewer._HideAttachmentView();},delaytime);},_HideAttachmentView:function(){if(this.overPreviewer){return;}
this.menudiv.style.display="none";},OverAttachmentView:function(parent){clearTimeout(this.timeout);this.overPreviewer=true;jQuery('#'+this.menudiv.id).addClass('transitionalbgcoloryellow');},LeaveAttachmentView:function(){clearTimeout(this.timeout);this.overPreviewer=false;jQuery('#'+this.menudiv.id).removeClass('transitionalbgcoloryellow');this.timeout=setTimeout(function(){AttachmentPreviewer._HideAttachmentView();},500);},GetPreview:function(viewdocumentnewwindow,currentitem){var currentitemid=currentitem?currentitem:this.currentItemId;var fields=currentitemid.replace(/^DOC\d+_(.*)$/,'$1').match(/(\w+)\{(\w+)\}\{(\w+)\}\{(\d+)\}/);var self=this;if(typeof this.menudiv!="undefined"){this.menudiv.style.display="none";}
this.overPreviewer=false;var documentid=fields[4];var documenturl=AH.PrependBasePath('/clinicals/documentview.esp?ID='+documentid);var documenttitle=currentitemid?jQuery('#'+EscapeJQuerySelector(currentitemid)).attr('documenttitle')||jQuery(viewdocumentnewwindow).attr('documenttitle'):this.currentItemTitle+" #"+documentid;if(InList(fields[1],['ENCOUNTERS','ORDERGROUPS'])){if(viewdocumentnewwindow==1){documenturl=AH.PrependBasePath('/ax/encounter/'+documentid+'/classic_summary');}
else{require(['shared:/scripts/athena/utils/cross_frame_events'],function(CrossFrameEventsUtils){var currentItem=currentitemid?jQuery('#'+EscapeJQuerySelector(currentitemid)):jQuery();var crossFrameEventArgs={targetURL:AH.PrependBasePath('/clinicals/encounter.esp?CLINICALENCOUNTERID='+documentid),sourceName:StreamlinedIframeUtils.GetIframeClass(),formState:jQuery('form').serialize()};if(currentItem.attr('data-ear-document-links-enabled')==='1'){var encounterId=currentItem.attr('data-encounter-id')||documentid;var isEncounterRestricted=currentItem.attr('data-is-encounter-restricted');crossFrameEventArgs.encounterId=encounterId;if(isEncounterRestricted==='1'||isEncounterRestricted==='0'){crossFrameEventArgs.isEncounterRestricted=(isEncounterRestricted==='1');}}
CrossFrameEventsUtils.trigger('streamlined-tab-link',crossFrameEventArgs);});return false;}}
else if(fields[1]=='FLOWSHEETS'){documenturl=AH.PrependBasePath('/clinicals/flowsheetview.esp?PATIENTID='+AH.GetGlobal('PATIENTID')+'&CHARTID='+AH.GetGlobal('CHARTID'));documentid='FLOWSHEETS';documenttitle='flowsheets';}
