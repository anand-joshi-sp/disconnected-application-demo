.css({"font-family":jqtextarea.css('font-family'),"font-size":jqtextarea.css('font-size'),"font-weight":jqtextarea.css('font-weight'),"font-variant":jqtextarea.css('font-variant'),"line-height":jqtextarea.css('line-height'),"word-wrap":'break-word',"box-sizing":jqtextarea.css('box-sizing'),"padding":jqtextarea.css('padding'),"border":jqtextarea.css('border'),"width":jqtextarea.width(),"visibility":'hidden',"position":'absolute',"top":0,"left":0})
.appendTo(jqbody);var lineheight=jqtextarea.data('lineheight');if(!lineheight){testdiv.html("A<br>A<br>A<br>A<br>A<br>A<br>A<br>A<br>A<br>A");lineheight=Math.floor(testdiv.height()/10.0);jqtextarea.data('lineheight',lineheight);}
var rows=0;var text=jqtextarea.val()
text=text.replace(/</gi,">");text=text.replace(/\n/g,"<br>");text=TrimWhitespace(text);if(text.match(/<br>$/)){text=text+'dummy text';}
testdiv.html(text);var height=testdiv.height();rows=Math.floor(height/lineheight);if(rows==0){rows=1;}
