if(paperformfieldjq.find('option:selected').text()==='Patient Care Summary'){onedayoptionjq.prop('disabled',false);}
else{if(onedayoptionjq.is(':selected')){autoapprovefieldjq.val('');}
onedayoptionjq.prop('disabled',true);}
