function ShowMappedDiagnosesRow(ischecked){if(ClaimUtils.GetPageName()==='CLAIMADD'){var jqmappeddiagnosisrows=jQuery('#ALLCHARGES').find('.mappeddiagnosisdatarow');jqmappeddiagnosisrows.each(function(i,elem){var jqrow=jQuery(elem);var chargelineindex=parseInt(jqrow.attr('i'),10);var jqchargelinerow=jQuery('.chargeline'+chargelineindex).first();if(!jqchargelinerow.hasClass('hidden')){if(ischecked){jqrow.removeClass('hidden');}
else{jqrow.addClass('hidden');}}});}
else{var ismanuallyedited=jQuery('input[name=MANUALLYEDITEDMAPS]').val()=='1';ClaimUtils.SetVisible('.mappeddiagnosisdataviewonlyrow',ischecked&&!ismanuallyedited);ClaimUtils.SetVisible('.mappingpopuplinkcontainer',ischecked&&!ismanuallyedited);ClaimUtils.SetVisible('.mappeddiagnosisdataeditrow, .manuallymappednote',ischecked&&ismanuallyedited);ClaimEdit.UpdateMappedDiagnosisRefsDisplay();}}
function ShowMappedDiagnosesRowOnChargeLine(ischecked,chargeline){var $context=jQuery('.chargeline'+chargeline);var $heading=jQuery('.mappeddiagnosisheading'+chargeline);var $inputrow=jQuery('.mappeddiagnosisdatainputrows'+chargeline);var $mappingpopup=$context.find('.mappingpopuplinkcontainer');var manuallyedited=$context.find('input[name=MANUALLYEDITEDMAPS]').val();if(ischecked){$heading.removeClass('hidden');if(manuallyedited==1){$inputrow.removeClass('hidden');}
else{$mappingpopup.removeClass('hidden');}}
else{$heading.addClass('hidden');$mappingpopup.addClass('hidden');if(manuallyedited==1){$inputrow.addClass('hidden');}}}
function UpdateViewOnlyMappedDiagnoses(pagename,mappeddiagnoses){if(pagename==='CLAIMEDIT'){if(mappeddiagnoses.length){jQuery('.mappeddiagnosisdataviewonly').html(jQuery.map(mappeddiagnoses,function(e){if(e.CODE!==''){return"<span title='"+e.DESCRIPTION+"'>"+e.CODE+"</span>";}}).join(', '));}
else{jQuery('.mappeddiagnosisdataviewonly').html("<span class='alerttext'>ICD-9 codes not found</span>");}}}
function ConfirmMappedDiagnosisEdit(){return confirm("If you edit the mapped ICD-9 codes, you will need to manually add ICD-9 codes for any ICD-10 codes that are subsequently added to the claim.");}
function ForceMappedDiagnosisEdit(chargelinenum){alert("The ICD-10 code you have entered is mapped to an invalid ICD-9 code.  You will have to manually edit the ICD-9 codes for this row and they will no longer automatically populate upon further changes to ICD-10 codes.");ShowMappedDiagnosisEdit(chargelinenum);}
function ShowMappedDiagnosisEdit(chargelinenum,setmanuallyedited){var $context=jQuery(chargelinenum===undefined?'#ALLCHARGES':'.chargeline'+chargelinenum);jQuery('.mappeddiagnosisdataeditrow',$context).removeClass('hidden');jQuery('.mappeddiagnosisdataviewonlyrow',$context).addClass('hidden');jQuery('.mappingpopuplinkcontainer',$context).addClass('hidden');jQuery('.manuallymappednote',$context).removeClass('hidden');jQuery('.popuplinkinwarnings',$context).addClass('hidden');if(chargelinenum!==undefined){jQuery('.mappeddiagnosisdatainputrows'+chargelinenum).removeClass('hidden');jQuery('#mappeddiagnosisdatasummary'+chargelinenum).addClass('hidden');jQuery('#mappeddiagnosisdatalink'+chargelinenum).addClass('hidden');}
if(setmanuallyedited){jQuery('input[name=MANUALLYEDITEDMAPS]',$context).val('1');}
jQuery('.mappeddiag',$context).each(function(i,elem){InitializeDiagnosisInput(jQuery(elem),true);ShowNextDiagnosisRow(elem);});ClaimEdit.UpdateMappedDiagnosisRefsDisplay();}
function ValidateProcedureCodeInput(inputelement){var inputindex=parseInt(inputelement.getAttribute("j"),10);var patientid=document.zform.PATIENTID.value;var wrapper=new InputWrapper(inputelement);var $input=jQuery(inputelement);var chargelineindex=parseInt($input.attr('i'),10);var jqchargeline=jQuery('.chargeline'+chargelineindex);if(/\S/.test(inputelement.value)&&inputelement.value!='.'){ClaimUtils.SubmitBlockingCallRemote({SUB:'Claim::HTML::GetChargeInfo',ARGS:{PATIENTID:patientid,PATIENTINSURANCEID:document.zform.PRIMARYPATIENTINSURANCEID.value,PROCEDURECODES:[inputelement.value.toUpperCase()],DIAGNOSISCODES:[],DEPARTMENTID:document.zform.DEPARTMENTID.value,SUPERVISINGPROVIDERID:document.zform.SUPERVISINGPROVIDERID.value,DATE:document.zform.SERVICEDATE.value,CHECKDUPE:0,CHECKEXPLODED:1,CHECKAPPOINTMENT:0,LOGAMACPTTOUCH:1},LOADINGINDICATORFLAG:true,ONFINISH:function(response){var onclaimaddpage=jqchargeline.find('[name^=PROCEDURECODE]').length>0;var $input=jqchargeline.find('[name=CHARGEPROCEDURECODE]');if(onclaimaddpage){$input=jqchargeline.find('[name=PROCEDURECODE'+inputindex+']');}
if(!response.HASEXPLODEDCODE){AddProcToInput(response.PROCEDURES[0],$input,onclaimaddpage,false);}
else{if(onclaimaddpage){var unabletoadd=[];jQuery.each(response.PROCEDURES,function(i,result){if(!$input||$input.length===0){unabletoadd.push(result.CODE);}
else{var inputelem=$input.get(0);var copydata=response.PROCEDURES.length-1===i?false:true;$input=AddProcToInput(result,$input,true,true,chargelineindex,copydata);ShowHideCodeCorrectLookup(inputelem);ShowNextChargeLine(inputelem);}});if(unabletoadd.length){alert('The maximum number of procedure codes has been exceeded.\nThe following were not added to this claim: '
+unabletoadd.join(', '));}}
else{wrapper.MarkInvalid();alert("Exploding codes can only be used on Charge Entry");}}}});}
else{ClaimUtils.MarkInputValid(inputelement);jqchargeline.next().find('.procinfo'+inputindex).hide();jqchargeline.find('.procdesc').html('Procedure');}}
function AddNDCInfo(chargeinfo,rownum){if(document.zform.CHARGENDC&&document.zform.CHARGENDC[rownum]){document.zform.CHARGENDC[rownum].value=chargeinfo.NDC||'';}
if(document.zform.EXTRATRANSACTION_GLOBAL_DRUGNAME&&document.zform.EXTRATRANSACTION_GLOBAL_DRUGNAME[rownum]){var $ndcsetter=jQuery(document.zform.NDC_Setter[rownum]);$ndcsetter.val(chargeinfo.NDC);$ndcsetter.keyup();NDCBlur($ndcsetter.get(0));var $drugname=jQuery(document.zform.EXTRATRANSACTION_GLOBAL_DRUGNAME[rownum]);$drugname.val(chargeinfo.DESCRIPTION||'');jQuery(document.zform.EXTRATRANSACTION_GLOBAL_DRUGDOSAGE[rownum]).val(chargeinfo.DRUGDOSAGE||'').blur();document.zform.EXTRATRANSACTION_GLOBAL_DRUGUNITQUALIFIER[rownum].value=chargeinfo.DRUGUNITQUALIFIER;document.zform.EXTRATRANSACTION_GLOBAL_DRUGUNITPRICE[rownum].value=chargeinfo.DRUGUNITPRICE||'';if($drugname.is(':hidden')){$drugname.closest('.customform').find('#SpecialtyShowHideControl').click();}}}
function RemoveNDCInfo(rownum){if(document.zform.CHARGENDC&&document.zform.CHARGENDC[rownum]){document.zform.CHARGENDC[rownum].value='';}
if(document.zform.EXTRATRANSACTION_GLOBAL_DRUGNAME&&document.zform.EXTRATRANSACTION_GLOBAL_DRUGNAME[rownum]){var $ndcsetter=jQuery(document.zform.NDC_Setter[rownum]);$ndcsetter.val('');NDCBlur($ndcsetter.get(0));var $drugname=jQuery(document.zform.EXTRATRANSACTION_GLOBAL_DRUGNAME[rownum]);$drugname.val('');document.zform.EXTRATRANSACTION_GLOBAL_DRUGDOSAGE[rownum].value='';document.zform.EXTRATRANSACTION_GLOBAL_DRUGUNITQUALIFIER[rownum].value='';document.zform.EXTRATRANSACTION_GLOBAL_DRUGUNITPRICE[rownum].value='';}}
function AddProcToInput(result,$input,isclaimadd,isexplodingcode,originallineindex,copyonfind){var code=result.CODE.toUpperCase();if(result.MODIFIERS){code+=','+result.MODIFIERS;}
var chargelineindex=parseInt($input.attr('i'),10);var $chargeline=jQuery('.chargeline'+chargelineindex);var $charges=$chargeline.find('.proc');var chargesperline=$charges.length;var procindex=$charges.index($input);var chargeindex=chargelineindex*chargesperline+procindex;if(result.NDC){AddNDCInfo(result,chargeindex);}
else{RemoveNDCInfo(chargeindex);}
if(result.UNITS){var $unitinput=(isclaimadd)?$chargeline.find('input[name=DAYS]'):$chargeline.find('input[name=CHARGEDAYS]');if($unitinput.length){$unitinput.val(result.UNITS);}
else{code+='.'+result.UNITS;}}
var pagename=isclaimadd?'CLAIMADD':'CLAIMEDIT';ClaimUtils.AddProcDescription(pagename,result,$chargeline,procindex);$input.val(code);var wrapper=new InputWrapper($input.get(0));if(!result.VALID){wrapper.MarkInvalid();}else{ClaimUtils.MarkInputValid($input.get(0));}
if(isexplodingcode){$input.data('lastvalue',code);var $lineprocs=$chargeline.find('input.proc');var dxcodestocarry=[];var $originalchargeline=jQuery('.chargeline'+originallineindex);var fromdate=$originalchargeline.find('input[name=FROMDATE]').val();var todate=$originalchargeline.find('input[name=TODATE]').val();var ndc=$originalchargeline.find('input[name=NDC]').val();var familyplan=$originalchargeline.find('input[name=FAMILYPLAN]').val();var epsdt=$originalchargeline.find('input[name=EPSDTYN_'+originallineindex+']').prop('checked');var emg=$originalchargeline.find('input[name=EMG_'+originallineindex+']').prop('checked');var pos=$originalchargeline.find('input[name=PLACEOFSERVICE]').val();$originalchargeline.find('input.diag').each(function(i,elem){var value=jQuery(elem).val();if(/\S/.test(value)){dxcodestocarry.push(value);}});if(procindex===0&&(chargelineindex!==originallineindex)){jQuery.each(dxcodestocarry,function(i,dxcode){var $linediags=$chargeline.find('input.diag');var $diag=$linediags.eq(i);if($diag.length){$diag.val(dxcode);var diagelement=$diag.get(0);ShowNextDiagnosisRow(diagelement);ValidateDiagnosisCodeInput(diagelement);}});}
var inputisblank=false;var $candidateinput=$lineprocs.eq(procindex);do{$candidateinput=$lineprocs.eq(++procindex);if($candidateinput.length&&!(/\S/.test($candidateinput.val()))){inputisblank=true;}}while(inputisblank===false&&$candidateinput.length>0);if(procindex>=$lineprocs.length){do{$chargeline=jQuery('.chargeline'+(++chargelineindex));if($chargeline.length===0){return null;}}while(!IsBlankChargeline(chargelineindex));procindex=0;}
if(copyonfind){$chargeline.find('input[name=FROMDATE]').val(fromdate);$chargeline.find('input[name=TODATE]').val(todate);$chargeline.find('input[name=NDC]').val(ndc);$chargeline.find('input[name=FAMILYPLAN]').val(familyplan);$chargeline.find('input[name=PLACEOFSERVICE]').val(pos);$chargeline.find('input[name=EPSDTYN_'+chargelineindex+']').prop('checked',epsdt);$chargeline.find('input[name=EMG_'+chargelineindex+']').prop('checked',emg);}
return $chargeline.find('[name=PROCEDURECODE'+procindex+']');}
return null;}
function IsBlankChargeline(chargelineindex){var isblank=true;jQuery('.chargeline'+chargelineindex).find('input.proc, input.diag').each(function(i,elem){if(jQuery(elem).val()!==''){isblank=false;return false;}});return isblank;}
function ScrollToAnchor(elem){var anchor=jQuery(elem).val();if(jQuery.isArray(anchor)){anchor=anchor[0];}
var $selector=jQuery('#'+anchor);if($selector.length){var position=FindScrollingPosition($selector.get(0));jQuery('.reskinscrolling_content, .scrolling_content').scrollTop(position.top);}}
function SetProc(procedure,boxnum){if(document.zform.WIZARDPROCEDURECODE[boxnum].status){for(i=0;i<5;i++){if(document.zform.PROCEDUREDATA0[i].value==''){document.zform.PROCEDUREDATA0[i].value=procedure;return;}}}
else{for(i=0;i<5;i++){if(document.zform.PROCEDUREDATA0[i].value==procedure){document.zform.PROCEDUREDATA0[i].value='';return;}}}}
function DeleteClaim(id){document.location=AH.PrependBasePath("/billing/hcfadelete.esp?operation=ShowConfirm&CLAIMID="+id);}
function ShowFax(manualdropynelement){if(manualdropynelement.value=='A'){alert("Please remember to fax claim attachments to athena at 781-894-9446. Thank you.");}}
function ShowClaimAttachmentMessage(manualdropynelement){if(manualdropynelement.value=='A'){alert("Please remember that all attachments should be forwarded using the Manage Attachments workflow.  Thank you.");}}
function ShowForceDropMessage(manualdropnelement){if(manualdropnelement.value=='Y'){alert("You have chosen to print this claim at your office. Please remember to generate this paper claim by using the \"Generate Claims (Forced Drop to Paper)\" link in the \"billing\" section of the Main Menu.");}}
function ChangeFromDate(activeInput,rownum){if(activeInput.value==''){if(AH.GetGlobal('DEFAULTFROMDATE')&&AH.GetGlobal('DEFAULTFROMDATE').value!=='')activeInput.value=AH.GetGlobal('DEFAULTFROMDATE');}else{AH.SetGlobal('DEFAULTFROMDATE',activeInput.value);}}
function ChangeServiceDate(activeInput){fromdate=new Array();for(var i=0;i<document.zform.CHARGEFROMDATE.length;i++){if(document.zform.CHARGEFROMDATE[i].value){fromdate[i]=document.zform.CHARGEFROMDATE[i].value;}}
var earliest=EarliestDate(fromdate);if(activeInput.value!==document.zform.SERVICEDATE.value){if((earliest!==document.zform.SERVICEDATE.value)&&confirm("Do you want to update the claim's date of service of "+document.zform.SERVICEDATE.value+" to be equal to the earliest charge's from date of "+earliest+"?")){document.zform.SERVICEDATE.value=earliest;jQuery(document.zform.SERVICEDATE).trigger('blur');}}}
function EarliestDate(dateArray){dateArray.sort(DateSort);return dateArray[0];}
function DateSort(a,b){var dateregx=/^(\d{2})\/(\d{2})\/(\d{4})/;a=a.replace(dateregx,"$3$1$2");b=b.replace(dateregx,"$3$1$2");if(a>b)return 1;if(a<b)return-1;return 0;}
function SyncServiceDate(activeInput,rownum){if(document.zform.CHARGETODATE[rownum].value=='')document.zform.CHARGETODATE[rownum].value=activeInput.value;}
function CheckFormHCFA(claimid){var $blankrequiredfields=jQuery('.RequiredField',document.zform).filter(function(){return jQuery(this).val()==='';});if($blankrequiredfields.length){var $firstblank=$blankrequiredfields.first();alert('The '+$firstblank.attr('data-displayname')+' is required.');FocusElement({selector:$firstblank});return false;}
if(AH.GetGlobal('isDirty')){AH.SetGlobal('waitingToSubmit',true);return false;}
if(document.zform.SERVICEDATE&&document.zform.EARLIESTDATEOFSERVICE&&document.zform.EARLIESTDATEOFSERVICE.value!==''&&Date.parse(document.zform.SERVICEDATE.value)<Date.parse(document.zform.EARLIESTDATEOFSERVICE.value)){alert("The date of service you entered is earlier than the earliest date of service on file ("
+document.zform.EARLIESTDATEOFSERVICE.value
+"). Please contact your Account Manager if you need to have the date on file updated.");document.zform.SERVICEDATE.focus();return false;}
var chargelength=(document.zform.CHARGEFROMDATE===undefined)?0:document.zform.CHARGEFROMDATE.length;for(var i=0;i<chargelength;i++){if(jQuery(document.zform.CHARGEFROMDATE[i]).hasClass("hidden")){continue;}
if(document.zform.CHARGEFROMDATE[i]&&document.zform.CHARGETODATE[i]&&IsDateAfter(document.zform.CHARGEFROMDATE[i].value,document.zform.CHARGETODATE[i].value)){alert("To Date must be on or after From Date.");try{document.zform.CHARGEFROMDATE[i].focus();}catch(e){};return false;}}
if(document.zform.KICKCODE.value=='INVALID'){alert('An invalid kickreason was chosen.');return false;}
if(document.zform.OUTSTANDING1.value==0&&document.zform.TRANSFERTYPE=='1'&&(document.zform.STATUS.value=='DROP'||document.zform.STATUS.value=='BILLED')&&document.zform.PRINTZERODOLLARCHARGESYN1.value!='Y'){alert("This claim has an invalid combination set. A claim cannot have its primary status in '"+document.zform.STATUS.value+"', an outstanding primary amount of '$0.00', and Print Zero-Dollar Charges set to 'No'.");return false;}
noNulls=new Array("PROVIDERID","SUPERVISINGPROVIDERID","DEPARTMENTID","PATIENTDEPARTMENTID");noNullsDescription=new Array("Provider","Supervising Provider","Facility","Patient Dept");if(document.zform.POSTDATE.value==''){alert('Postdate cannot be null.');FocusElement({selector:document.zform.POSTDATE});return false;}
for(i=0;i<noNulls.length;i++){if(eval("document.zform."+noNulls[i]+".value==''")){alert("Field "+noNullsDescription[i]+" cannot be blank.");try{eval("document.zform."+noNulls[i]+".focus()");}catch(e){};return false;}}
noNulls=new Array("CHARGEFROMDATE","CHARGEDIAGNOSISREF1","CHARGEDAYS");noNullsDescription=new Array("From","Diagnosis Reference","Days/Units");var enteredProcedureCodes=0;for(j=1;j<8;j++){if(document.zform['DIAGNOSIS'+j].value==''&&document.zform['DIAGNOSIS'+(j+1)].value!==''){alert('Diagnosis '+j+
' is empty, while diagnosis '+(j+1)+
