function AddBlankRow(args){if(!isDefined(args)){args={};}
if(!isDefined(args.TABLE)){args.TABLE=GetParent(event.srcElement,'tagName','TABLE');}
if(jQuery(args.TABLE).attr("overflowtable")){var overflowtable=jQuery(args.TABLE);var newleft=AddBlankRow({TABLE:jQuery("table[name=LEFT]",overflowtable).get(0),SOURCEINDEX:args.SOURCEINDEX,TARGETINDEX:args.TARGETINDEX,INSERTBEFORE:args.INSERTBEFORE});AddBlankRow({TABLE:jQuery("table[name=CENTER]",overflowtable).get(0),SOURCEINDEX:args.SOURCEINDEX,TARGETINDEX:args.TARGETINDEX,INSERTBEFORE:args.INSERTBEFORE});AddBlankRow({TABLE:jQuery("table[name=RIGHT]",overflowtable).get(0),SOURCEINDEX:args.SOURCEINDEX,TARGETINDEX:args.TARGETINDEX,INSERTBEFORE:args.INSERTBEFORE});ResizeOverflowTable(args.TABLE);return newleft;}
if(args.TABLE.rows.length==0){return;}
if(!isDefined(args.SOURCEINDEX)){if(args.INSERTBEFORE){args.SOURCEINDEX=args.TARGETINDEX;}
else{args.SOURCEINDEX=args.TABLE.rows.length-1;}}
if(!isDefined(args.TARGETINDEX)){args.TARGETINDEX=args.TABLE.rows.length;}
var sourcerow=args['TABLE'].rows[args.SOURCEINDEX];var newrow=args['TABLE'].insertRow(args.TARGETINDEX);if(args.INSERTBEFORE){for(var rowindex=args.TARGETINDEX+1;rowindex<args.TABLE.rows.length;rowindex++){var rowobj=args.TABLE.rows[rowindex];for(var cellindex=0;cellindex<rowobj.cells.length;cellindex++){var cellobj=rowobj.cells[cellindex];if(cellobj.id=='ORDERING'){var children=jQuery(cellobj).children();var orderingfield;if(children.length){orderingfield=children[0];orderingfield.value=parseInt(orderingfield.value)+1;}}}}}
for(var i=0;i<sourcerow.cells.length;i++){var sourcecellobj=sourcerow.cells[i];var newcellobj=newrow.insertCell(i);var html=_CloneTableCellInnerHTML(sourcecellobj,false,args.INDEXTOINCREMENT);if(args.POSTPROCESSFUNCTION){html=args.POSTPROCESSFUNCTION(html);}
newcellobj.innerHTML=html;var inputs=jQuery('input,select,textarea',newrow.cells[i]);BlankInputCells(inputs);_AddBlankCellsPostCopyProcess(sourcecellobj,newcellobj,args.TARGETINDEX);}
if(isDefined(args.LIMIT)&&args.LIMIT&&args.TABLE.rows.length>=args.LIMIT){jQuery('tbody > tr > td > .sprite-add',jQuery(args.TABLE)).hide();}
if(args.HIDESRCELEMENT){jQuery(event.srcElement).hide();}
ReinitializeSpeechEnabledFields();return newrow;}
function PostMultiNameAutoCompleteAddBlankRow(args){var jqButtonElement=jQuery(args.BUTTONELEMENT);if(jqButtonElement.hasClass('sprite-add')){var lastTableRow=jqButtonElement.closest('table.multiinputselect').find('tr:last-child');var input=lastTableRow.find("input[type='hidden']");if(input.length&&!input.val()){lastTableRow.find('div.nameautocompletevalue').empty();var nameAutoCompleteInput=lastTableRow.find("input[name $='{PROCEDURECODE}_search']");var onFocusString=nameAutoCompleteInput.attr('onfocus');var originalValueRegexp=/ORIGINALVALUE:\s+([^}]*\}')/;var newOnFocusString=onFocusString.replace(originalValueRegexp,'ORIGINALVALUE: \'{"VALUE":"", "NAME":""}\'');nameAutoCompleteInput.attr('onfocus',newOnFocusString);}}}
