function ValidateNoKnownSectionSelections(selectedItems,matchedItems,itemLookup){try{return _ValidateNoKnownSectionSelections(selectedItems,matchedItems,itemLookup);}
catch(err){console.error("Unable to validate noKnown section selections with args (",selectedItems,matchedItems,itemLookup,"): ",err);return false;}}
function _ValidateNoKnownSectionSelections(selectedItems,matchedItems,itemLookup){var isNoKnownItemSelected=false;var anyNonNoKnownItemSelected=false;jQuery.each(selectedItems,function(i,el){var decoded=DecodeDataRecHiddenFieldIdString(el.id);if(decoded){var item=itemLookup[decoded.prefix];isNoKnownItemSelected=isNoKnownItemSelected||(item.ISNOKNOWN==1&&(item.MATCH===item.SELECTION));anyNonNoKnownItemSelected=anyNonNoKnownItemSelected||(item.ISNOKNOWN!=1&&(item.MATCH===item.SELECTION||item.MATCH==='PARTIAL'));}});var isNoKnownItemMatched=false;var anyNonNoKnownItemMatched=false;jQuery.each(matchedItems,function(i,el){var decoded=DecodeDataRecHiddenFieldIdString(el.id);if(decoded){var item=itemLookup[decoded.prefix];isNoKnownItemMatched=isNoKnownItemMatched||item.ISNOKNOWN==1;anyNonNoKnownItemMatched=anyNonNoKnownItemMatched||(item.ISNOKNOWN!=1&&item.ISSECTIONNOTE!=1);}});return!((isNoKnownItemSelected||isNoKnownItemMatched)&&(anyNonNoKnownItemSelected||anyNonNoKnownItemMatched));}
