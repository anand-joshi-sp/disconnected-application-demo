function DrawFlotGraph(graphname){jQuery(window).ready(function(){var graphdiv=jQuery("#"+EscapeJQuerySelector(graphname));var replot=graphdiv.data("flotplot")?1:0;var numxticks=parseInt(graphdiv.attr("numxticks"));if(numxticks>0&&replot){var options=jQuery(graphdiv).data("flotoptions");var minx=parseInt(options['xaxes'][0]['min']);var maxx=parseInt(options['xaxes'][0]['max']);if(isNumber(minx)&&isNumber(maxx)){var ticks=[];if(numxticks==1){ticks.push((maxx-minx)/2);}
else if(numxticks>1){var ticksize=(maxx-minx)/(numxticks-1);ticks.push(minx);for(var i=1;i<numxticks-1;i++){ticks.push(minx+i*ticksize);}
ticks.push(maxx);}
options['xaxes'][0]['ticks']=ticks;jQuery(graphdiv).data("flotoptions",options);}}
jQuery(graphdiv).parents("tr:first").show();jQuery('#NONNUMERIC_MESSAGE_'+graphname).show();var plot=jQuery.plot(graphdiv,jQuery(graphdiv).data("flotdata"),jQuery(graphdiv).data("flotoptions"));jQuery(graphdiv).data("flotplot",plot);if(!replot){graphdiv.bind("plothover",function(event,pos,item){ShowGraphTooltip(item);});graphdiv.bind("mouseout",function(){ShowGraphTooltip();});var graphsetdiv=jQuery(graphdiv).closest("div[id^='GRAPHSET_']");if(jQuery(graphsetdiv).length&&jQuery(graphsetdiv).attr("crosshair")){graphdiv.bind("plothover",function(event,pos,item){SyncGraphSetCrosshairs(graphsetdiv,pos);});graphdiv.bind("mouseout",function(){SyncGraphSetCrosshairs(graphsetdiv);});}}});}
