function CheckAlarms(){if(!alarmstriggered&&document.zform.DEPARTMENTID.value&&document.zform.SERVICEDATE.value){var checkappointment=!document.zform.APPOINTMENTID||(document.zform.APPOINTMENTID&&document.zform.APPOINTMENTID.value=="");ClaimUtils.SubmitBlockingCallRemote({SUB:'Claim::HTML::GetChargeInfo',ARGS:{PATIENTID:document.getElementById('PatientActionMenu_DATA').getAttribute('PATIENTID'),PATIENTINSURANCEID:document.zform.PRIMARYPATIENTINSURANCEID.value,DEPARTMENTID:document.zform.DEPARTMENTID.value,SUPERVISINGPROVIDERID:document.zform.SUPERVISINGPROVIDERID.value,DATE:document.zform.SERVICEDATE.value,CHECKDUPE:1,CHECKEXPLODED:0,CHECKAPPOINTMENT:checkappointment},LOADINGINDICATORFLAG:true,ONFINISH:function(response){jQuery.each(response.ALARMS,function(i,alarm){alert(alarm);});if(response.APPOINTMENTSWITHOUTCLAIMS&&response.APPOINTMENTSWITHOUTCLAIMS.length){var appointmenttimes=jQuery.map(response.APPOINTMENTSWITHOUTCLAIMS,function(appointment,i){return appointment.STARTTIME;}).join(",");if(confirm("An appointment ("+appointmenttimes
+") exists for this patient at this department and on this date of service "
+"with no claim entered.\n\nWould you like to enter this claim into that "
+"appointment slot?  (OK=Yes, Cancel=No)")){jQuery.each(response.APPOINTMENTSWITHOUTCLAIMS,function(i,appointment){if(confirm("Enter this claim for the appointment slot at "+appointment.STARTTIME+"?  (OK=Yes, Cancel=No)")){AH.Frames.Main.SetLocation(AH.PrependBasePath("/billing/hcfanew.esp?APPOINTMENTID="+appointment.ID));}});}}}});alarmstriggered=true;}}
function LoadChargeInfo(patientid,pagename){pagename=pagename||'CLAIMADD';var lastnonemptyindex=0;var getvalues=function(element,index){if(element.value){lastnonemptyindex=index;}
return element.value;};var $allprocs=jQuery('.chargeline input.proc');var procedures=jQuery.map($allprocs,getvalues).slice(0,lastnonemptyindex+1);var $alldiags=jQuery('.chargeline input.diag:not(.otherdiag)');lastnonemptyindex=0;var diagnoses=jQuery.map($alldiags,getvalues).slice(0,lastnonemptyindex+1);var $allmappeddiags=jQuery('.mappeddiagnosisdatarow input.mappeddiag');lastnonemptyindex=0;var mappeddiagnoses=jQuery.map($allmappeddiags,getvalues).slice(0,lastnonemptyindex+1);var $allotherdiags=jQuery('input.otherdiag');lastnonemptyindex=0;var otherdiagnoses=jQuery.map($allotherdiags,getvalues).slice(0,lastnonemptyindex+1);var maindiagnoseselements={};var mappeddiagnoseselements={};var otherdiagnoseselements={};var mapDiagInputsByCode=function(diagnoseselements,$diaginputs){$diaginputs.each(function(index,elem){if(elem.value){var codestring=elem.value.toString();if(typeof diagnoseselements[codestring]==='undefined'){diagnoseselements[codestring]=[];}
diagnoseselements[codestring].push({inputelem:elem,infoelem:jQuery(elem).parents('.code').siblings('.diaginfo, .mappeddiaginfo').get(0)});}
else{jQuery(elem).parents('.code').siblings('.diaginfo, .mappeddiaginfo').html("");ClaimUtils.MarkInputValid(elem);}});};mapDiagInputsByCode(maindiagnoseselements,$alldiags);mapDiagInputsByCode(mappeddiagnoseselements,$allmappeddiags);mapDiagInputsByCode(otherdiagnoseselements,$alldiags);var $allextramappeddiags=jQuery('input.extramappeddiag');lastnonemptyindex=0;var extramappeddiagnoses=jQuery.map($allextramappeddiags,getvalues).slice(0,lastnonemptyindex+1);lastnonemptyindex=0;var $allmanuallyeditedmapinputs=jQuery('input.manuallyeditedmaps');var manuallyeditedmapinputvals=jQuery.map($allmanuallyeditedmapinputs,getvalues).slice(0,lastnonemptyindex+1);var showmappedcheckbox=jQuery('input[name=SHOWMAPPEDDIAGNOSES]');var allcodes=procedures.concat(diagnoses,mappeddiagnoses,extramappeddiagnoses);var nonnullcodes=jQuery.grep(allcodes,function(codevalue){if(codevalue.match(/\S/)){return true;}
return false;});if(nonnullcodes.length){ClaimUtils.SubmitBlockingCallRemote({SUB:'Claim::HTML::GetChargeInfo',ARGS:{PATIENTID:patientid,PATIENTINSURANCEID:document.zform.PRIMARYPATIENTINSURANCEID.value,PROCEDURECODES:procedures,DIAGNOSISCODES:diagnoses,MAPPEDDIAGNOSISCODES:mappeddiagnoses,EXTRAMAPPEDDIAGNOSISCODES:extramappeddiagnoses,OTHERDIAGNOSISCODES:otherdiagnoses,MANUALLYEDITEDMAPFLAGS:manuallyeditedmapinputvals,REFRESHALLMAPPEDDIAGNOSISCODES:(pagename=='CLAIMADD')?1:0,DEPARTMENTID:document.zform.DEPARTMENTID.value,SUPERVISINGPROVIDERID:document.zform.SUPERVISINGPROVIDERID.value,DATE:document.zform.SERVICEDATE.value,CHECKDUPE:0,CHECKEXPLODED:0,CHECKAPPOINTMENT:0,MAPMODE:pagename},LOADINGINDICATORFLAG:true,ONFINISH:function(response){if(response.ICDVERSION){ClaimUtils.SetPageICDVersion(response.ICDVERSION);}
