function MoveOrder(object,offset){var jqorderdiv=jQuery(object).closest("div[name='ORDERDIV']");var jqdiagnosisspan=jqorderdiv.closest("span[name='DIAGNOSIS_ORDERS']");var jqalldiagnoses=jqdiagnosisspan.closest('#ALLDIAGNOSISORDERS').find("span[name='DIAGNOSIS_ORDERS']");if(jqalldiagnoses.length>1){var sourcediagnosisindex;for(var j=0;j<jqalldiagnoses.length;j++){if(jqalldiagnoses[j].id==jqdiagnosisspan.attr('id')){sourcediagnosisindex=j;break;}}
var destinationdiagnosisindex=sourcediagnosisindex+offset;if(destinationdiagnosisindex>=0&&destinationdiagnosisindex<jqalldiagnoses.length){jqorderdiv.appendTo(jqalldiagnoses[destinationdiagnosisindex]);HandleMovedOrder(jqorderdiv.get(0),jQuery(jqalldiagnoses[sourcediagnosisindex]).closest('div.diagnosisblock').get(0),jQuery(jqalldiagnoses[destinationdiagnosisindex]).closest('div.diagnosisblock').get(0));}}}
function UpdateBlurredSummary(type,id,container){var summary=document.getElementById(type+'_SUMMARY_'+id);if(!summary){return;}
var summaryhtml='';if(type=='DIAGNOSIS'){summaryhtml=TextifyDiagnosisDetails(container,'ENCOUNTERDIAGNOSIS{'+id+'}');}
else{var form=document.getElementById(type+'_FORM_'+id);if(!form){return;}
var jqform=jQuery(form);var key=(type=='ORDER')?'EXISTING':'NEW';var prefix='ORDER{'+key+'}{'+id+'}';var editable=document.getElementById(prefix+'{EDITABLE}');if(editable&&editable.value=='0'){return;}
var customordercode=document.getElementById(prefix+'{CUSTOMORDERCODE}');if(customordercode&&customordercode.value!==''){var jqunlistedcustomname=jQuery(EscapeJQuerySelector("#"+prefix+"{ORDERDIV}{NAME}"));var oldcustomname=jqunlistedcustomname.html().substring(0,jqunlistedcustomname.html().indexOf(" - <"));jqunlistedcustomname.html(jqunlistedcustomname.html().replace(oldcustomname,customordercode.value.toUpperCase()));}
var colsblurred=document.getElementById(prefix+'{COLSBLURRED}');if(!colsblurred||!colsblurred.value){return;}
var fieldnames=colsblurred.value.split(':');for(var i=0;i<fieldnames.length;i++){var field=document.getElementById(prefix+'{'+fieldnames[i]+'}');if(!jQuery.browser.msie&&!field){field=jqform.find(EscapeJQuerySelector("[name='"+prefix+'{'+fieldnames[i]+"}']")).get(0);}
if(!field){continue;}
var fieldvalue=field.value;var showninput=field;if(field.getAttribute('summarydisplayfield')){var displayfield=document.getElementById(field.getAttribute('summarydisplayfield'));if(displayfield){fieldvalue=displayfield.value;}}
if(fieldnames[i]=='STANDINGORDERYN'){if(fieldvalue=='Y'){summaryhtml+='&nbsp;Standing order: '+GetStandingOrderText(prefix,container);}
continue;}
else if(fieldnames[i]=='SPECIMENDRAWLOCATION'){fieldvalue=jqform.find(EscapeJQuerySelector('input[name="'+prefix+'{SPECIMENDRAWLOCATION}"]:checked')).val();if(fieldvalue=='HOMEDRAW'){summaryhtml+=' &nbsp; &nbsp; Patient needs home draw';}
else if(fieldvalue=='ADDON'){summaryhtml+=' &nbsp; &nbsp; This is an add on test';}
continue;}
else if(fieldnames[i]=='DOCUMENTORDERCC'){var rows=jQuery(field).find(EscapeJQuerySelector("tr:has(input[name$='{NAME}'][value!=''])"));if(rows.length>0){summaryhtml+=' &nbsp; &nbsp; CC Results To: ';var ccproviderlist=rows.each(function(index,element){summaryhtml+=jQuery(element).find("input[name$='{NAME}']").val()+' ('+jQuery(element).find("input[name$='{FAX}']").val()+')';if(index+1<rows.length){summaryhtml+=', ';}});}
continue;}
if(fieldnames[i]=='CLINICALPROVIDERID'){var clinicalordertypegroupid=document.getElementsByName(prefix+"{CLINICALORDERTYPEGROUPID}")[0].value;var cpswspanjq=jQuery(field).closest('span[name="cpsw"]');var cptogglejq=jQuery(field).closest('span[name="cptogglespan"]');var cptext;if(!cpswspanjq.length&&cptogglejq.length){var selectedval=cptogglejq.find('input[name="'+prefix+'{cptogglewidget}"]:checked').val();if(selectedval.match(/INHOUSE/)){cptext='N/A (Point-of-care test)';}
else if(selectedval.match(/EXTERNAL/)){var cpswcontainerjq=cptogglejq.find('td#'+selectedval);cpswspanjq=cpswcontainerjq.find('span[name="cpsw"]');}}
if(!cptext&&cpswspanjq.length){var cpswtext=cpswspanjq.find('span[name="cpsw{link}{linktext}"] a').html()||cpswspanjq.find('span[name="cpsw{link}{linktext}"]').text();var cpswicons=cpswspanjq.find('span[name="cpsw{link}{icons}"]').html();if(cpswtext=='Search'){cpswtext='N/A';cpswicons='';}
cptext=cpswicons+cpswtext;}
if(cptext){if(InList(clinicalordertypegroupid,[10,16])){if(jQuery(EscapeJQuerySelector("[name='"+prefix+"{TYPE}']")).filter('input:checked').val()=='ORDER'){summaryhtml+='  Pharmacy: ';}
else{summaryhtml+='  ';continue;}}
else{summaryhtml+='  Send to: ';}
summaryhtml+=' '+cptext;continue;}}
if((field.getAttribute('type')&&field.getAttribute('type').toLowerCase()=='hidden')&&field.getAttribute('showninputname')){showninput=document.getElementById(field.getAttribute('showninputname'));if(showninput&&showninput.type.toLowerCase()=='checkbox'){field=showninput;}}
if(!showninput||!IsRendered(showninput,form)){continue;}
if(field.nodeName.toLowerCase()=='select'){fieldvalue=selectText(field);}
if(field.getAttribute('type')&&field.getAttribute('type').toLowerCase()=='checkbox'){if(field.getAttribute('checkedlabel')||field.getAttribute('uncheckedlabel')){fieldvalue=field.checked?field.getAttribute('checkedlabel'):field.getAttribute('uncheckedlabel');if(fieldvalue){fieldvalue='     '+fieldvalue;}}}
if(fieldnames[i]=='SPECIMENSOURCEID'&&fieldvalue){fieldvalue=fieldvalue.replace(/ - \(deleted\)$/,'');}
if(fieldnames[i]=='BILLINGNDC'&&!field.getAttribute('summarylabel')){field.setAttribute('summarylabel','NDC');}
if(fieldnames[i]=='MEDICATIONREASON'&&fieldvalue){fieldvalue=SpacesToCharacterEntities(EscapeHTML(fieldvalue));summaryhtml+=', for '+fieldvalue;continue;}
if(fieldvalue){fieldvalue=SpacesToCharacterEntities(EscapeHTML(fieldvalue));if(field.getAttribute('summarylabel')){summaryhtml+=' &nbsp; &nbsp; ';if(!field.getAttribute('skipblurredlabel')){summaryhtml+=field.getAttribute('summarylabel')+':';}}
if(field.getAttribute('prelabel')){summaryhtml+=' '+field.getAttribute('prelabel');}
if(field.getAttribute('summarytietofield')){var tietofield=document.getElementsByName(field.getAttribute('summarytietofield'))[0];if(tietofield){if(isDefined(tietofield.value)&&tietofield.value!=''){summaryhtml+=' '+fieldvalue;}}
else{summaryhtml+=' '+fieldvalue;}}
else{summaryhtml+=' '+fieldvalue;}
if(field.getAttribute('postlabel')){summaryhtml+=' '+field.getAttribute('postlabel');}}}}
summary.innerHTML=summaryhtml;}
function TextifyDiagnosisDetails(container,prefix,suppresshtml){var nodash=Picker.HasSplitOrders();var result='';var status=document.getElementsByName(prefix+"{STATUS}")[0];if(status&&!InList(jQuery(status).val(),['','undefined'])){result+=selectText(status);}
var laterality=jQuery(EscapeJQuerySelector("[name='"+prefix+"{LATERALITY}']"),container).get(0);if(laterality&&laterality.value!=''){result+=(!InList(jQuery(status).val(),['','undefined'])?', ':'')+upperCaseFirst(laterality.value.toLowerCase());}
var note=document.getElementsByName(prefix+"{NOTE}")[0];if(note&&note.value!=''){var noteresult=EscapeHTML(note.value);if(!suppresshtml){noteresult=Text2HTML(noteresult);}
if(result.length>0){result+=" - "+noteresult;}
else{result=noteresult;}}
if(result.length>0){result=(nodash?"<br>":" - ")+result;}
return result;}
function GetProblemActionHTML(status){var result="";if(!status.PROBLEM){return result;}
if(status.PATIENTPROBLEM){result='Problem List';}
if(status.PREGNANCYPROBLEM){result+=(result.length>0?" and ":"")+"Pregnancy Problem List";}
if(result.length>0){result="<span class='diagnosisproblemactionname'>"
+status.PROBLEM
+"</span> added to "
+result;}
return result;}
function DeleteRow(context,rowelement){if(rowelement){var table=rowelement.parentElement.parentElement.parentElement;var rowindex=rowelement.parentElement.parentElement.rowIndex;if(table.rows.length==2){ResetFieldElements(table.rows[rowindex]);return;}
else if(table.rows.length-1==rowindex){var prevrow=table.rows[rowindex-1];if(prevrow){var lastindex=prevrow.cells.length-1;prevrow.cells[lastindex].innerHTML=rowelement.parentElement.parentElement.cells[lastindex].innerHTML;}}
table.deleteRow(rowindex)}}
function DeleteNextRow(context,rowelement){if(rowelement){var table=rowelement.parentElement.parentElement.parentElement;var rowindex=rowelement.parentElement.parentElement.rowIndex+1;var row=table.rows[rowindex];if(row){if(table.rows.length==2){ResetFieldElements(row);}
table.deleteRow(rowindex);}}}
function AddRow(context){var table=document.getElementById(context);var indexoflastrow=table.rows.length;var newrow=table.insertRow(indexoflastrow);var prevrow=newrow.parentElement.parentElement.rows[newrow.rowIndex-1];var newrowinputindex;if(prevrow){for(var r=0;r<prevrow.cells.length;r++){var newcellhtml=prevrow.cells[r].innerHTML;if(newcellhtml.match(/([A-Z0-9][A-Z0-9_]*)\{(\d+)\}/)){var prefix=RegExp.$1;var oldindex=RegExp.$2;var cellinputoriginalname="{"+oldindex+"}";newrowinputindex=parseInt(oldindex)+1;while(document.all(prefix+"{"+newrowinputindex+"}")||document.getElementById(prefix+"{"+newrowinputindex+"}")){++newrowinputindex;}
var newname="{"+newrowinputindex+"}";var originalnameregexp=new RegExp(EscapeRegExp(cellinputoriginalname),"g");newrow.insertCell(r).innerHTML=newcellhtml.replace(originalnameregexp,newname);}
else{newrow.insertCell(r).innerHTML=prevrow.cells[r].innerHTML;}
var scripts=GetChildren(newrow.cells[r],'tagName','script');for(var j=0;j<scripts.length;j++){EvalInGlobalNamespace(scripts[j].text);}}
ResetFieldElements(newrow);prevrow.cells[prevrow.cells.length-1].innerHTML="<a href=# onclick='DeleteRow(\""+context+"\", this)' "+
" title='delete row' alt='delete row'><span class='sprite-del-16x16' style='cursor:pointer' border=0></span></a>";return newrowinputindex;}}
function ResetFieldElements(obj){var inputs=GetChildren(obj,'tagName',['input','select']);for(var j=0;j<inputs.length;j++){if(inputs[j].type.toUpperCase()=='CHECKBOX'){inputs[j].checked=false;}else{inputs[j].value='';}}}
function CheckAge(item,description){var firstindexofdecimal=item.value.indexOf('.');if(firstindexofdecimal==0)item.value="0"+item.value;var itemvalue=TrimWhitespace(item.value);if((itemvalue!='')&&(!itemvalue.match(/^[0-9\.]{0,12}$/g)||itemvalue<0)){alert("Invalid "+description);item.focus();return false;}
var lastindexofdecimal=itemvalue.lastIndexOf('.');if(itemvalue.indexOf('.')!=-1&&(firstindexofdecimal!=lastindexofdecimal)){alert("Invalid "+description);item.focus();return false;}}
function CheckNumeric(item,description){var itemvalue=TrimWhitespace(item.value);if((itemvalue!='')&&(!itemvalue.match(/^[0-9]{0,12}$/g)||itemvalue<0)){alert("Invalid "+description);item.focus();return false;}
return true;}
