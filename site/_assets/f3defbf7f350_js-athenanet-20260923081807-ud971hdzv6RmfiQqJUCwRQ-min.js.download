var firstemptyinput=GetChild(myform,'tagName',['input','select','textarea','checkbox'],'className',/\bRequiredField\b/,'value',/^\s*$/);if(firstemptyinput){alert((firstemptyinput.getAttribute('fieldtitle')||firstemptyinput.getAttribute('title')||firstemptyinput.name)
