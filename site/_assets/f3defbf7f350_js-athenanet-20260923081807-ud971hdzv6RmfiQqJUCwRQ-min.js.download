function RemoveICD9Row(item){var jqitem=jQuery(item);var icd9=jqitem.parent().parent();var sectioncontainer=GetSectionContainer(item);_RemoveICD9Row(icd9,sectioncontainer);}
function _RemoveICD9Row(icd9,sectioncontainer){var icd9block=icd9.parent();var jqcontainer=jQuery(sectioncontainer);var snomeddxid=icd9block.attr('ID');var reg=/DIAGNOSIS_ICD9BLOCK_(.*)/;var snomedordering=reg.exec(snomeddxid)[1];var icd9name=icd9.attr('id');var orderingregex=/DIAGNOSIS_ICD9_(.*)/;var icd9ordering=orderingregex.exec(icd9name)[1];var icd9select=jQuery(document.getElementsByName("ENCOUNTERDIAGNOSIS{"+snomedordering+"}{ICD9CODESELECT}")[0]);if(icd9select.length&&icd9select.val()=='undefined'){if(icd9ordering==="0"){icd9.remove();return;}
else{icd9ordering-=1;}}
var icd9s=GetICD9CodeData(snomedordering);var icd9codes=icd9s[0];var icd9descriptions=icd9s[1];var icd9codelist=icd9codes.val().split(/\t/);var icd9descriptionlist=icd9descriptions.val().split(/\t/);var removedcode=icd9codelist[icd9ordering];icd9codelist.splice(icd9ordering,1);icd9descriptionlist.splice(icd9ordering,1);var newicd9codevals='';var newicd9descriptionvals='';for(var i=0;i<icd9codelist.length;i++){newicd9codevals+=icd9codelist[i];newicd9descriptionvals+=icd9descriptionlist[i];if(i<icd9codelist.length-1){newicd9codevals+="\t";newicd9descriptionvals+="\t";}}
icd9codes.val(newicd9codevals);icd9descriptions.val(newicd9descriptionvals);icd9block.closest('.diagnosisblock').find('.orderform').each(function(){MedicalNecessity.VerifyEncounter({FIELD:this});});icd9.remove();MaybeRemoveICD9FromRegistry(removedcode);var orderingcount=0;icd9block.children('div').each(function(){var icd9div=this;var regex=/DIAGNOSIS_ICD9_(.*)/;var currentordering=regex.exec(icd9div.getAttribute('ID'))[1];if(orderingcount!=currentordering){icd9div.setAttribute('id','DIAGNOSIS_ICD9_'+orderingcount);}
