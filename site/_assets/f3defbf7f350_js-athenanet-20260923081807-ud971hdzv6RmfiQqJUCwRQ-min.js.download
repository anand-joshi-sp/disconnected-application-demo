if(ndctoggle){var newexploderow=servicetable.insertRow(newexploderowindex);newexploderow.id=procedurerowid+'{EXPLODEMESSAGE}';AddElement(newexploderow,'afterBegin','td');newexploderow.cells[0].setAttribute('colspan','8');}
var newprocedurerow=servicetable.insertRow(newrowindex);var newprocedureprefix=procedurerowid;var oldprocedureprefix=proceduretemplate.id;oldprocedureprefix=new RegExp(EscapeRegExp(oldprocedureprefix),"g");newprocedurerow.id=procedurerowid;newprocedurerow.setAttribute('name',proceduretemplate.getAttribute('name'));for(var i=0;i<proceduretemplate.cells.length;i++){var cellcopy=proceduretemplate.cells[i].cloneNode(true);newprocedurerow.appendChild(cellcopy);newprocedurerow.cells[i].innerHTML=newprocedurerow.cells[i].innerHTML.replace(oldprocedureprefix,newprocedureprefix);}
