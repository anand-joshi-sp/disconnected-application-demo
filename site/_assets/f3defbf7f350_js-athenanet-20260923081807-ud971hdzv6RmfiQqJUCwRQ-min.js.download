MakeGetString(urlgetparams)));return;}
function selectText(selectList){if(selectList&&selectList.options&&selectList.selectedIndex!=-1&&selectList.options[selectList.selectedIndex]){return selectList.options[selectList.selectedIndex].text;}}
function radioValue(radioObject){try{if(radioObject.length){for(var i=0;i<radioObject.length;i++){if(radioObject[i].checked){return radioObject[i].value;}}}
else{return radioObject.value;}}
catch(e){}}
