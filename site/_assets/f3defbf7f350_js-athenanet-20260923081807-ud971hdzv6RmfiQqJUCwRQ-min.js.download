else{remoteArgs={INTERFACEMESSAGEID:args};}
CallRemote({SUB:'Document::Class::LABRESULT::GetLabDemographicsHTML',ARGS:remoteArgs,ONFINISH:function(returnhtml){jQuery(link).replaceWith(returnhtml);}});}
function ResetCallbacknumber(){if(document.zform.CALLBACKNUMBERTYPE&&document.zform.CALLBACKNUMBERTYPE.value!=""){document.zform.CALLBACKNUMBER.value="";}}
function ScrollToScanPage(name,input_field,new_window_fix){var consolidated_view=false;var $scrolling_div=jQuery(".documentview");if($scrolling_div.length===0){$scrolling_div=jQuery(".documentviewcontent");if(new_window_fix&&$scrolling_div.length===0){$scrolling_div=jQuery(document);}
else{consolidated_view=true;}}
var $destination_page;if(name){$destination_page=jQuery("[name='"+name+"']");}
else if(input_field){var $input_field=jQuery(input_field);var inputValue=$input_field.val();if(inputValue&&parseInt(inputValue)){inputValue=parseInt(inputValue);$destination_page=jQuery("#page"+inputValue.toString());}
var input_id=$input_field.attr("id");var input_id_split=input_id.split("-");var current_page_num=input_id_split[input_id_split.length-1];$input_field.val(current_page_num);if(!$destination_page||$destination_page.length==0){return;}}
var destination_offset=$destination_page[0].offsetTop;var $scan_page_wrapper;var scan_page_wrapper_offset;if(consolidated_view){$scan_page_wrapper=$destination_page.closest(".scanimage");scan_page_wrapper_offset=$scan_page_wrapper[0].offsetTop;$image_wrapper_table=$scan_page_wrapper.closest("[name='imagewrappertable']");scan_page_wrapper_offset+=$image_wrapper_table[0].offsetTop;}
else{$scan_page_wrapper=$destination_page.closest(".scanimagewrapper");if(new_window_fix&&$scan_page_wrapper.length===0){scan_page_wrapper_offset=0;}
else{scan_page_wrapper_offset=$scan_page_wrapper[0].offsetTop;}}
if(consolidated_view){$scrolling_div.animate({scrollTop:scan_page_wrapper_offset},0);$scan_page_wrapper.animate({scrollTop:destination_offset-$scan_page_wrapper[0].offsetTop},0);}
else{if(new_window_fix){$scrolling_div.scrollTop(destination_offset+scan_page_wrapper_offset);}
else{$scrolling_div.animate({scrollTop:destination_offset+scan_page_wrapper_offset},0);}}}
function ResizeImages(imagenames,size){imagenames.forEach(function(imagename){ResizeImage(imagename,size);});var $oneImage=jQuery(document).find('.document_oneimagehtml_sub');var $smallerControl=$oneImage.find('.smaller-control');var $largerControl=$oneImage.find('.larger-control');if(size===2){$smallerControl.css('pointer-events','').css('color','');$largerControl.css('pointer-events','none').css('color','black');}
else{$smallerControl.css('pointer-events','none').css('color','black');$largerControl.css('pointer-events','').css('color','');}}
function ResizeImage(imagename,size){var image=eval("document.images."+imagename);var url=image.src;url=url.replace(/SIZE=[0-9]/,'SIZE='+size);image.src=url;image.style.width=image.style.height='auto';}
function ResizeImageToScale(args){ResizeImageToScaleAndSize({IMAGEELEMENT:args.IMAGEELEMENT,SCALE:args.SCALE,MAXHEIGHT:10000,MAXWIDTH:40000});}
function ResizeImageToScaleAndSize(args){AssertFields(args,['IMAGEELEMENT','MAXHEIGHT','MAXWIDTH','SCALE']);var jqimage=jQuery(args.IMAGEELEMENT);if(jqimage.length){var imageheight;var imagewidth;var desiredwidth=args.MAXWIDTH;var desiredheight=args.MAXHEIGHT;var scale=args.SCALE;var resize=function(){imageheight=jqimage.height();imagewidth=jqimage.width();if(imageheight>0&&!jqimage.attr('resized')){jqimage.height(imageheight*scale);jqimage.width(imagewidth*scale);imageheight=jqimage.height();imagewidth=jqimage.width();if(imageheight>desiredheight){jqimage.height(desiredheight);}
if(imagewidth>desiredwidth){jqimage.width(desiredwidth);}
jqimage.attr('resized',true);}
else{setTimeout(resize,25);}};resize();}}
function RotateAllImages(){var images=GetChildren(document.zform||document,'tagName','input','id',/^IMAGEROTATION_/);var distinctimages=[];for(var i=0;i<images.length;i++){if(!distinctimages[images[i].getAttribute('scanpageid')]){distinctimages[images[i].getAttribute('scanpageid')]=1;RotateImage(images[i].getAttribute('scanpageid'));}}}
function OpenPrintWindow(url){return LargeModalLookup({page:url,windowname:'documentimageviewer',title:'Document Image Viewer',mode:'MODELESS',additionalargs:{resizable:'yes',status:'yes',scrollbars:'yes'}});}
function ViewPrintWindow(url){var popupwindow=AH.Frames.Main.GetGlobal('DOCUMENTIMAGEVIEWER');if(!popupwindow||popupwindow.closed){AH.Frames.Main.SetGlobal('DOCUMENTIMAGEVIEWER',OpenPrintWindow(url));}
else{popupwindow.focus();if(!popupwindow.document.hasFocus()){popupwindow.close();AH.Frames.Main.SetGlobal('DOCUMENTIMAGEVIEWER',OpenPrintWindow(url));}
else{popupwindow.AH.Frames.Main.SetLocation(url);}}}
function BlankMetaFilterDate(prefix,formname){if(formname){document.getElementsByName(formname)[0][prefix+'META_FILTERDATE'].value='';}
else{document.zform[prefix+'META_FILTERDATE'].value='';}}
function ChangeDates(today,dateafterlastvisit,reportdates,tableid,prefix,formname){var formelement=document.getElementsByName(formname||'zform')[0];var filtervalue=formelement[prefix+'META_FILTERDATE'].value;var start=formelement[prefix+'STARTDATE'];var end=formelement[prefix+'ENDDATE'];if(filtervalue=='MTD'){start.value=reportdates['FirstDayCurrentMonth'];end.value=today;}
else if(filtervalue=='LM'){start.value=reportdates['FirstDayLastMonth'];end.value=reportdates['LastDayLastMonth'];}
else if(filtervalue=='QTD'){start.value=reportdates['FirstDayCurrentQuarter'];end.value=today;}
else if(filtervalue=='LQ'){start.value=reportdates['FirstDayLastQuarter'];end.value=today;}
else if(filtervalue=='YTD'){start.value=reportdates['FirstDayCurrentYear'];end.value=today;}
else if(filtervalue=='LY'){start.value=reportdates['FirstDayLastYear'];end.value=reportdates['LastDayLastYear'];}
else if(filtervalue=='AT'){start.value='';end.value=today;}
else if(filtervalue=='SLV'){start.value=dateafterlastvisit;end.value=today;}
else{start.value='';end.value='';}
FilterAttachmentsByDate({TABLEID:tableid,PREFIX:prefix,PARENTFORMNAME:formname||'zform'});}
function ActionReasonChosen(){var radiochosen=radioValue(document.zform.DOCUMENTACTIONGROUPID);if(radiochosen){var selected=jQuery('[name=DOCUMENTACTIONREASONID'+radiochosen+']').val();return selected;}}
function SetActionAttributes(select){var jqselectedoption=jQuery(select).children('option:selected');if(jqselectedoption.attr('DOCUMENTSUBCLASS')){document.zform.ACTIONDOCUMENTSUBCLASS.value=jqselectedoption.attr('DOCUMENTSUBCLASS');document.zform.ACTIONONAFTERACTIONRULE.value=jqselectedoption.attr('ONAFTERACTIONRULE');document.zform.ACTIONNAME=jqselectedoption.get(0).NAME;}
if(jqselectedoption.attr('DOCUMENTCATEGORY')){document.zform.ACTIONDOCUMENTCATEGORY.value=jqselectedoption.attr('DOCUMENTCATEGORY');document.zform.ACTIONNAME=jqselectedoption.get(0).NAME;}}
function ClearActionAttributes(){if(document.zform.ACTIONDOCUMENTSUBCLASS){document.zform.ACTIONDOCUMENTSUBCLASS.value=null;}
if(document.zform.ACTIONONAFTERACTIONRULE){document.zform.ACTIONONAFTERACTIONRULE.value=null;}
if(document.zform.ACTIONDOCUMENTCATEGORY){document.zform.ACTIONDOCUMENTCATEGORY.value=null;}}
function ChangeActionGroup(actiongroupindex){jQuery('#ACTIONOPTIONS [name=DOCUMENTACTIONGROUPID][value='+actiongroupindex+']')[0].checked=true;}
function FillHelpText(field,actionhelptexthash){if(!field||isNaN(field.value)){_FillHelpText('');return;}
var actionnotehash=actionhelptexthash;var form=document.zform;var actionidvalue;if(field.name.substr(0,field.name.length-1)=='DOCUMENTACTIONREASONID'&&field.getAttribute('type')=='SELECT'){actionidvalue=field.value;}
else{var documentactionid=jQuery(field).next("[type='SELECT']").get(0);if(documentactionid){actionidvalue=documentactionid.value;if(form.ACTIONNOTE.value){return;}}
else{_FillHelpText('',actionhelptexthash);return;}}
_FillHelpText(nvl(actionnotehash[actionidvalue],''),actionhelptexthash);}
function _FillHelpText(data,actionhelptexthash){var form=document.zform;var actionnotehash=actionhelptexthash;var samestring=0;for(var i in actionnotehash){if(form.ACTIONNOTE.value==actionnotehash[i])
samestring=1;}
if(!data&&!samestring){return;}
if(form.ACTIONNOTE.value&&form.ACTIONNOTE.value!=data){if(!data&&!confirm('Clear Action Note field?')){return;}
if(data&&!confirm('Update Action Note field?')){return;}}
form.ACTIONNOTE.value=data?data:'';SetScrollOverflow(form.ACTIONNOTE);}
function ShowPatientRecordRows(methodselect){var recordreleaseinfotable=jQuery(methodselect).parents("table[name='recordreleaseinfo']");var faxrow=jQuery("tr[name='faxnumber']",recordreleaseinfotable);faxrow.css('display','none');var pdfrow=jQuery("tr[name='pdfpassword']",recordreleaseinfotable);pdfrow.css('display','none');var chartmanagementrow=jQuery("tr[name='chartmanagementpartner']",recordreleaseinfotable);if(chartmanagementrow!=undefined){chartmanagementrow.css('display','none');}
var directaddressrow=jQuery("tr[name='directaddress']",recordreleaseinfotable);if(directaddressrow!=undefined){directaddressrow.css('display','none');}
var directfallbackpromt=jQuery("span[name='directfallbackpromt']",recordreleaseinfotable);if(directfallbackpromt!=undefined){directfallbackpromt.css('display','none');}
var patientrequestedynrow=jQuery("tr[name='patientrequestedyn']",recordreleaseinfotable);var selectedtext=jQuery('select option:selected',recordreleaseinfotable).text();if(selectedtext.toUpperCase().match(/FAX/)){faxrow.css('display','');jQuery("input[name='CALLBACKNUMBER']").addClass('RequiredFieldColor');}
if(chartmanagementrow!=undefined&&selectedtext.toUpperCase().match(/BY INTERFACE/)){chartmanagementrow.css('display','');}
if(selectedtext.toUpperCase().match(/ENCRYPTED PDF/)){pdfrow.css('display','');patientrequestedynrow.css('display','');}
if(directaddressrow!=undefined&&selectedtext.toUpperCase().match(/DIRECT/)){directaddressrow.css('display','');var faxoption=jQuery("option:contains('AthenaFax')",methodselect).get(0);if(faxoption){faxrow.css('display','');jQuery("input[name='CALLBACKNUMBER']").removeClass('RequiredFieldColor');directfallbackpromt.css('display','');}}
else{jQuery(':checked',patientrequestedynrow).each(function(){this.click();});patientrequestedynrow.css('display','none');if(chartmanagementrow!=undefined){jQuery("input[name='chartmanagementpartnerrecordid']").val('');}}}
function EncounterSummaryOnClick(objectclass,lasttabid){var contentset=document.getElementById('contentset');var requirementargs={CONTEXT:contentset,CONTAINERTYPE:'SECTIONCONTAINER',FILTER:[{ATTRIBUTEKEY:'sectionname',ATTRIBUTEVALUE:objectclass}]};var section=GetEncounterContainer(requirementargs);requirementargs.CONTAINERTYPE='SUMMARYCONTAINER';var summary=GetEncounterContainer(requirementargs);if(section.saving){return;}
var opencontainers=GetOpenSummaryContainers({CONTENTSET:contentset});if(opencontainers.length){var savesuccess=SaveTab({SKIPTOGGLE:[summary.sectionname]});if(!savesuccess){return;}}
ScrollToSection(jQuery(summary).attr('sectionname'));}
function EncounterSummaryOnMouseEnter(summarycontent){var summary=GetParent(summarycontent,'id','SUMMARYCONTAINER');if(summary&&GetSectionObject(summary).hovermessage==undefined&&!summary.saving){GetSectionObject(summary).hovermessage=new TextOverlay();GetSectionObject(summary).hovermessage.Start(summarycontent,{text:'Click to edit',cursor:'pointer',transparenttext:1});}}
function EncounterSummaryOnMouseLeave(summarycontent){var summary=GetParent(summarycontent,'id','SUMMARYCONTAINER');if(summary&&GetSectionObject(summary).hovermessage){GetSectionObject(summary).hovermessage.Stop(summarycontent);GetSectionObject(summary).hovermessage=undefined;}}
(function(){var timeout;window.ShowUnsavedWarning=function(){if(!timeout&&!document.getElementById('unsavedwarning')){timeout=setTimeout(function(){timeout=null;var insertwarningafter=jQuery('#jumptonav,#layout_footer input[type=button]').last();jQuery('<span></span>')
.attr('id','unsavedwarning')
.addClass('unsavedwarning')
.text('You may have unsaved changes.')
.insertAfter(insertwarningafter)
.show();},5000);}};window.HideUnsavedWarning=function(){clearTimeout(timeout);timeout=null;jQuery('#unsavedwarning').remove();};})();function GetSummaryContainer(key){if(!key){return undefined;}
var contentset=document.getElementById('contentset');if(!contentset){return undefined;}
if(isString(key)){var summarycontainer=GetEncounterContainer({CONTEXT:contentset,CONTAINERTYPE:'SUMMARYCONTAINER',FILTER:[{ATTRIBUTEKEY:'sectionname',ATTRIBUTEVALUE:key}]});return summarycontainer;}
else if(key.id=='SUMMARYCONTAINER'){return key;}
else{return GetParent(key,'id','SUMMARYCONTAINER');}}
function GetRWMode(summarycontainer){if(!summarycontainer){return'';}
return jQuery(summarycontainer).attr('rwmode');}
function SetRWMode(summarycontainer,tomode,callback){if(!summarycontainer){return;}
var summarycontainerjq=jQuery(summarycontainer);var contentset=document.getElementById('contentset');var section=GetEncounterContainer({CONTEXT:contentset,CONTAINERTYPE:'SECTIONCONTAINER',FILTER:[{ATTRIBUTEKEY:'sectionname',ATTRIBUTEVALUE:summarycontainerjq.attr('sectionname')}]});var sectionobject=GetSectionObject(section);if(tomode=='R'){if(section.style.display!='none'){section.style.display='none';}
if(summarycontainer.style.display=='none'){summarycontainer.style.display='';}
if(isFunction(callback)){callback();}
summarycontainerjq.attr('rwmode','R');sectionobject.StopFocusTimer(section);}
else if(tomode=='W'){summarycontainerjq.hide('fast',function(){jQuery(section).show();RedrawSVGJotter({CONTEXT:window,CONTAINER:section});jQuery(section).find('.overflowmaintable, textarea[autoresizing=1]').trigger('resize');jQuery('textarea[autoresizing=1]',section).each(function(){if(this.onreflow){this.onreflow();}});if(isFunction(callback)){callback();}});summarycontainerjq.attr('rwmode','W');sectionobject.StartFocusTimer(section);}
else{alert('Unknown section mode: '+tomode);}}
function GetOpenSummaryContainers(args){if(!args){var args={};}
var contentset=args.CONTENTSET||document.getElementById('contentset');var opensummaries=GetEncounterContainer({CONTEXT:contentset,CONTAINERTYPE:'SUMMARYCONTAINER',FILTER:[{ATTRIBUTEKEY:'rwmode',ATTRIBUTEVALUE:'W'},{ATTRIBUTEKEY:'nosummary',ATTRIBUTEVALUE:''}],RETURNARRAY:1});return opensummaries;}
function CloseSummaryContainers(args){if(!args){var args={};}
var opensummaries=GetOpenSummaryContainers(args);for(var i=0;i<opensummaries.length;i++){var summarycontainer=opensummaries[i];if(summarycontainer&&GetRWMode(summarycontainer)=='W'&&!(args.SKIPTOGGLE&&InList(summarycontainer.sectionname,args.SKIPTOGGLE))){SetRWMode(summarycontainer,'R');}}
return opensummaries.length;}
function DisableLinks(parentelement,newclass){var anchors=GetChildren(parentelement,'tagName','a');for(var i=0;i<anchors.length;i++){anchors[i].onclick=function(){return false;};if(newclass){if(!anchors[i].className.match(newclass)){anchors[i].className+=' '+newclass;}}
else{anchors[i].disabled=true;}}}
function InitializeTemplateEventHandler(initjs){var jqtable=jQuery(initjs).closest("table[id=TEMPLATECONTAINER]");jqtable.delegate('tr[id=SENTENCECONTAINER], td[id=SENTENCECONTAINER]','mouseover mouseout click dblclick selectstart',function(){TemplateEventHandler(this);})
.delegate('span[id=rollupspan]','mouseover mouseout click',function(){TemplateEventHandler(this);});if(isTablet()){jqtable.find("span[id^=EXAMVALUE],span[id^=HPI_EXAMVALUE]").bind('touchstart',function(e){var t2=e.timeStamp,t1=jQuery(this).data('lastTouch')||t2,dt=t2-t1,fingers=e.originalEvent.touches.length;jQuery(this).data('lastTouch',t2);if(!dt||dt>500||fingers>1)return;e.preventDefault();TemplateEventHandler(this);});}}
function UpdateDICOM(){if(document.zform.IMAGEFILE.value.match(/\.dcm$/i)){document.zform.DICOM.checked=1;document.zform.DICOM.disabled=1;}else if(document.zform.IMAGEFILE.value.match(/\.pdf$/i)){document.zform.DICOM.checked=0;document.zform.DICOM.disabled=1;}else{if(document.zform.DICOM.disabled==1){document.zform.DICOM.checked=0;document.zform.DICOM.disabled=0;}}}
function ReturnToShiftReturn(){var keyevent=window.event;if(keyevent.keyCode==13&&!keyevent.shiftKey){if(window.getSelection){var selection=window.getSelection();var range=selection.getRangeAt(0);range.deleteContents();var container=selection.getRangeAt(0).startContainer.parentNode;AppendCursorPositioningHTML({EDITABLEELEMENT:container});var newNode=document.createElement("br");range.insertNode(newNode);range.setStartAfter(newNode);range.collapse(false);selection.removeAllRanges();selection.addRange(range);}
else if(document.selection){var selectedrange=document.selection.createRange();selectedrange.pasteHTML("<br>");selectedrange.moveEnd("character",1);selectedrange.collapse(false);selectedrange.moveStart("character",-1);selectedrange.collapse(true);selectedrange.select();}
return false;}}
function ClearHasLayout(element){if(IsChrome()||IsSafari()||IsEdge()){return;}
jQuery(element)
.find('div:not(.athenawidget):not(.athenawidget *)')
.each(function(index,innerelement){var $innerelement=jQuery(innerelement);if($innerelement.css('zoom')!=='normal'){$innerelement.css('zoom','normal');}
if($innerelement.width()!=='auto'){$innerelement.width('auto');}
if($innerelement.height()!=='auto'){$innerelement.height('auto');}});return;}
function VerifyScrubbedHTML(field,sectionname,datatypename){var tags=[{NAME:"Script",REGEXP:/<\s*script[^>]*>/gi},{NAME:"Form",REGEXP:/<\s*form[^>]*>/gi}];for(var i=0;i<tags.length;i++){var tag=tags[i];if(field.value.match(tag.REGEXP)){alert(tag.NAME+" tags not allowed in the "+sectionname+
". Please enter valid "+datatypename+" data.");field.focus();return false;}}
return true;}
function ToggleMultispecialtyFilter(radioobj,specialties){if(!isDefined(radioobj)){radioobj=document.getElementById('specialtyfilter');}
if((radioValue(radioobj)==1&&AH.GetGlobal('SPECIALTIES')=='')||(radioValue(radioobj)==0&&AH.GetGlobal('SPECIALTIES')!='')){return;}
if(radioobj.value==1){AH.SetGlobal('SPECIALTIES','');}
else{AH.SetGlobal('SPECIALTIES',specialties);}
var multispecspan;var multispecradio;if(AH.Frames.Main.GetLocation().pathname.match(/charttabs/)){multispecspan=AH.Frames.Main.getElementById('multispecshowall');multispecradio=jQuery(multispecspan).find('input#specialtyfilter').get();radioSetValue(multispecradio,radioobj.value);}}
function InitializeMultispecialtyFilter(targetdocument){if(!targetdocument){targetdocument=document;}
if(isDefined(AH.GetGlobal('SPECIALTIES'))&&AH.GetGlobal('SPECIALTIES')==''){var specialtyinputs=jQuery("#multispecshowall input[name='SPECIALTIES']",targetdocument).get();if(specialtyinputs.length){radioSetValue(specialtyinputs,'1');}}}
function EncounterPrint(encounterid,htmldocument){if(!(htmldocument&&htmldocument.parentWindow&&htmldocument.parentWindow.frameElement&&htmldocument.parentWindow.frameElement.currentStyle.display=='none')){CallRemote({SUB:"AthenaSecurity::ExternalAuditNote",ARGS:{PAGE:'PRINTENCOUNTER',CLINICALENCOUNTERID:encounterid}});}
return true;}
