function HideOptionChange(args){AssertFields(args,['CONTEXT','SECTION','ITEMNAME','ID'],[]);var sectionconfig={PROBLEM:{WARNINGTEXT:"If you delete "+args.ITEMNAME+", it will be removed permanently from this patient's chart.",HIDDENFIELDNAME:'PATIENTPROBLEM_ADDEDINERROR_'+args.ID},ALLERGY:{WARNINGTEXT:"If you delete "+args.ITEMNAME+", it will be removed permanently from this patient's chart.",HIDDENFIELDNAME:'PATIENTALLERGY_ADDEDINERROR_'+args.ID},PREGNANCYPROBLEM:{WARNINGTEXT:"If you delete "+args.ITEMNAME+", it will be removed permanently from this patient's chart.",HIDDENFIELDNAME:'PREGNANCYPROBLEMS_EXISTING_'+args.ID+'_ADDEDINERROR'}};var config=sectionconfig[args.SECTION];if(!config){return;}
var jcontext=jQuery(args.CONTEXT);if(jcontext.find(":selected").val()!=='ADDEDINERROR'){return;}
else if(!confirm(config.WARNINGTEXT)){jcontext.val('');return;}
var row=GetParent(args.CONTEXT,'tagName','tr');var sectioncontainer=GetSectionContainer(args.CONTEXT);row.parentNode.deleteRow(row.rowIndex);InsertAdjacentHTML(sectioncontainer,'beforeEnd','<input type="hidden" name="'+config.HIDDENFIELDNAME+'" value="1">');}
function MedicationHideOptionChange(args){AssertFields(args,['CONTEXT','ITEMNAME','ID'],[]);var warningtext="If you delete "+args.ITEMNAME+", it will be removed permanently from this patient's chart.";var hiddenfieldname='PATIENTMEDICATION_ADDEDINERROR_'+args.ID;var jcontext=jQuery(args.CONTEXT);if(jcontext.find(":selected").val()!=='ADDEDINERROR'){return;}
else if(!confirm(warningtext)){jcontext.val('');return;}
var sectioncontainer=GetSectionContainer(args.CONTEXT);var removeeditgroup='PATIENTMEDICATION_ROW_'+args.ID;var jmedicationtable=jcontext.closest('tbody');jmedicationtable.children("tr[clicktoeditgroup='"+removeeditgroup+"']").remove();var jmedrollupcontrol=jmedicationtable.find("div[class='medrollupcontrol']");var removemedicationheader=false;if(jmedrollupcontrol.length){var medrollupcontrol=jmedrollupcontrol.get(0);jQuery.each(medrollupcontrol.attributes,function(index,attribute){if(!attribute.name.match(/^show([a-z0-9]+)/)){return true;}
var rolluptype=RegExp.$1;var medlist=jmedrollupcontrol.attr(attribute.name).split(',');medlist.splice(jQuery.inArray(removeeditgroup,medlist),1);var newmedliststring=medlist.join();if((rolluptype=='all')&&(!medlist.length)){removemedicationheader=true;}
jmedrollupcontrol.attr(attribute.name,newmedliststring);});}
else{removemedicationheader=true;}
if(removemedicationheader){var isalternate=jmedicationtable.hasClass('encounteralternaterow');jmedicationtable.nextAll('tbody[id]').each(function(){var jthis=jQuery(this);var childtrtdselector=jthis.children('tr, td');if(isalternate){jthis.addClass('encounteralternaterow');childtrtdselector.addClass('encounteralternaterow');}
else{jthis.removeClass('encounteralternaterow');childtrtdselector.removeClass('encounteralternaterow');}
isalternate=!isalternate;});jmedicationtable.remove();}
InsertAdjacentHTML(sectioncontainer,'beforeEnd','<input type="hidden" name="'+hiddenfieldname+'" value="1">');}
function PaperFormNameOnFocus(field){var $field=jQuery(field);$field.data('oldvalue',$field.val());}
function PaperFormNameOnChange(field){var $field=jQuery(field);var value=$field.val();if(value==='Patient Care Summary'||value==='Summary of Care Record'){alert('The name "'
+value
+'" is reserved for a special form.  Please choose a different name.');$field.val($field.data('oldvalue'));}}
function GetEncounterContainer(args){var filterset=[{ATTRIBUTEKEY:'id',ATTRIBUTEVALUE:args.CONTAINERTYPE}];filterset=args.FILTER?filterset.concat(args.FILTER):filterset;var requirement={CONTEXT:args.CONTEXT,FILTER:filterset,USEFALLBACK:args.USEFALLBACK};if(args.RETURNARRAY){return GetImmediateChildren(requirement);}
return GetImmediateChild(requirement);}
function GetEmptySummary(summarycontainer){var spans=summarycontainer.getElementsByTagName('span');var totalspans=spans.length;for(var i=0;i<totalspans;i++){var span=spans[i];if(span.getAttribute('id')=='emptysummary'){return span;}}}
function RecordOrderBehaviorMetrics(args){AssertFields(args,['ACTION','METRICDATA'],[]);CallRemote({SUB:'Document::Class::ORDER::RecordOrderBehaviorMetrics',ARGS:{ACTION:args.ACTION,METRICDATA:args.METRICDATA}});}
function ReloadFrames(openschedulenav){top.AH.SetGlobal('SKIPLOGOUTDIALOG',1);var mainpath=document.location.pathname+document.location.search;var schedulenavpath=top.AH.Frames.ScheduleNav.GetLocation().pathname;schedulenavpath+=top.AH.Frames.ScheduleNav.GetLocation().search;var windowpath=top.GetBaseHref()+'/globalframeset.esp';windowpath+='?MAIN='+escape(mainpath);windowpath+='&SCHEDULENAV='+escape(schedulenavpath);if(openschedulenav){windowpath+='&AXLEFTNAV=1';}
top.AH.Frames.Top.SetLocation(windowpath);}
function ServiceTypeAddOnsCheckForm(){var sectionjq=jQuery('div[id="SECTIONCONTAINER"][sectionname="ServiceTypeAddOn"]'),passcheck=true;if(sectionjq.length){sectionjq
.find('div[controlscustomform]:visible .RequiredField')
.each(function(index,field){var fieldjq=jQuery(field),value,fieldname;value=GetAmbiguousFieldValue({FIELD:fieldjq});if(!value){passcheck=false;fieldname=fieldjq.data('requiredfieldname');alert(fieldname?('A value must be entered for '+fieldname+'.'):'A value must be entered for a required Service Type Add On field.');fieldjq.focus();return false;}});}
return passcheck;}
function GetAmbiguousFieldValue(args){AssertFields(args,['FIELD'],[]);var value,fieldjq=jQuery(args.FIELD);if(fieldjq.is('select')){value=fieldjq
.find(':selected')
.val();}
else if(fieldjq.is(':checkbox')){if(fieldjq.is(':checked')){value=fieldjq.val();}}
else{value=fieldjq.val();}
return value;}
function SwitchDepartmentAndRedirectToAirlock(args){CallRemote({SUB:'AthenaSecurity::ChartIsAccessibleFromDepartment',ARGS:{CHARTID:args.CHARTID,PATIENTID:args.PATIENTID,AUTOSWITCH:1,FORCESWITCHPG:1,RETURNDATA:1,PREFERREDDEPARTMENTID:args.PREFERREDDEPARTMENTID,COPYPATIENTMESSAGE:'SwitchDepartmentAndRedirectToAirlock'},ONFINISH:function(data){var streamlinedurl;if(args.ENCOUNTERID){streamlinedurl=buildAirlockURL({'name':'encounter','id':args.ENCOUNTERID,'stage':args.STAGE,'status':args.STATUS,'briefing':args.BRIEFING,'section':args.SECTION});}
else if(args.CONSOLIDATED){streamlinedurl=buildAirlockURL({'name':'document_workspace','id':args.CHARTID,'documentclass':args.DOCUMENTCLASS,'status':args.STATUS,'assignedto':args.ASSIGNEDTO,'consolidated':args.CONSOLIDATED});}
else{if(args.FULLY_DEIFRAME_ADMIN_AND_PHONEMESSAGE){streamlinedurl=buildAirlockURL({'name':'briefing','id':args.CHARTID,'documentclass':args.DOCUMENTCLASS,'documentid':args.DOCUMENTID});}
else{streamlinedurl=buildAirlockURL({'name':'briefing','id':args.CHARTID,'documentid':args.DOCUMENTID});}}
var inpatienturl=buildInpatientURL({'chartid':args.CHARTID})
if(data&&data.DEPARTMENTSWITCHDATA){var toinpatient=data.TOINPATIENT;ChangeDepartmentAndSetMainLocation(data.DEPARTMENTSWITCHDATA.DEPARTMENTID,'',toinpatient?inpatienturl:streamlinedurl);}
else{redirectToAirlock(args.FROMINPATIENT?inpatienturl:streamlinedurl);}}});}
function RegisterDictationErrorListeners(){window.dictationerrormodules={};require(['shared:/scripts/athena/utils/cross_frame_events'],function(CrossFrameEventsUtils){CrossFrameEventsUtils.on('on-dictation-adm-error',function(errorobj){var sectionname=errorobj.sectionname;var error=errorobj.errorhtml;jQuery.each(window.dictationerrormodules,function(key,dictationerrormodule){dictationerrormodule.admerror(error);});if(sectionname&&typeof window.dictationerrormodules[sectionname]==='undefined'){var errormodule={name:sectionname+'DictationError',quiet:true,errorid:sectionname+'-adm-error-Dictation',onregister:function(){this.admerror(error);}};window.dictationerrormodules[sectionname]=errormodule;ADM.RegisterModule(errormodule);}});});}
function GetAge(args){AssertFields(args,['DATEOFBIRTH']);var today=new Date();var birthDate=new Date(args.DATEOFBIRTH);var age=today.getFullYear()-birthDate.getFullYear();var month=today.getMonth()-birthDate.getMonth();if(month<0||(month===0&&today.getDate()<birthDate.getDate())){age--;}
return age;}
function UpdateTeenPortalAccess(args){AssertFields(args,[],['DATEOFBIRTH']);var patientage;if(args.DATEOFBIRTH){patientage=GetAge(args)}
var teenaccessbeginagefield=jQuery('#REGISTRATIONTEENACCESSBEGINAGE');var teenaccessendagefield=jQuery('#REGISTRATIONTEENACCESSENDAGE');if(teenaccessbeginagefield&&teenaccessendagefield){var teenaccessbeginage=teenaccessbeginagefield.val();var teenaccessendage=teenaccessendagefield.val();var warningtextdiv=jQuery('#TEENPORTALWARNINGTEXT');var pcswidget=jQuery('input[name="CARESUMMARYDELIVERYPREFERENCE"]');var pcsdeniedfield=jQuery('input[name="checkbox_yesno_PATIENTDECLINEDSUMMARY"]');if(pcswidget.length){if(patientage&&patientage>=teenaccessbeginage&&patientage<=teenaccessendage){if((!pcsdeniedfield.length||!pcsdeniedfield.prop('checked'))){pcswidget.each(function(){ToggleLabelEnabled(this,false);});}
if(warningtextdiv){warningtextdiv.show();}}
else if(!patientage||(patientage<=teenaccessbeginage||patientage>=teenaccessendage)){if((!pcsdeniedfield.length||!pcsdeniedfield.prop('checked'))){pcswidget.each(function(){ToggleLabelEnabled(this,true);});}
if(warningtextdiv){warningtextdiv.hide();}}}}}
function UpdatePrenatalBPNotPerformed(field){var checkbox=jQuery(field);var container=checkbox.closest('.vitalsdata');var dropdown=container.find('.vitals-blood-pressure-refused-reason');var valueFields=container.find('.vitals-blood-pressure-value');if(checkbox.is(':checked')){valueFields.val('');valueFields.prop('disabled',true);dropdown.removeClass('hidden');}
else{dropdown.val('');valueFields.prop('disabled',false);dropdown.addClass('hidden');}}
function UpdatePrenatalWeightNotPerformed(field){var checkbox=jQuery(field);var container=checkbox.closest('.vitalsdata');var valueFields=container.find('.vitals-weight-value');if(checkbox.is(':checked')){valueFields.val('');valueFields.prop('disabled',true);}
else{valueFields.prop('disabled',false);}}
function BillTheseCodesLinkClicked(link,ordered_service_id_list){var all_checkboxes=[];if(ordered_service_id_list&&ordered_service_id_list.length>0){all_checkboxes=FindCPTIICheckboxes(ordered_service_id_list);}
else{all_checkboxes=FindCPTIICheckboxes();}
var current_link_text=link.text.trim();var checkText="Bill these codes";var uncheckText="Don't bill these codes";all_checkboxes.forEach(function(checkbox){if(checkbox&&checkbox.type=="checkbox"){if((current_link_text===checkText&&checkbox.checked===false)||(current_link_text===uncheckText&&checkbox.checked===true)){checkbox.click();}}});}
function MaybeToggleBillTheseCodesLink(){var checkText="Bill these codes";var uncheckText="Don't bill these codes";var all_checkboxes=FindCPTIICheckboxes();var all_checkboxes_same_state=all_checkboxes.every(function(val,i,all){if(val.disabled){return true;}
return val.checked===all[0].checked;});if(all_checkboxes_same_state&&all_checkboxes.length){var link=jQuery('#bill_all_link');var current_link_text=link.text().trim();var expected_text=all_checkboxes[0].checked?uncheckText:checkText;if(current_link_text!==expected_text){link.text(expected_text);}}}
function FindCPTIICheckboxes(ordered_service_id_list){var all_checkboxes=jQuery.find("input[name*='checkbox_yesno_SERVICE{NEW}{CPTII}{PROCEDURECODE}']");if(ordered_service_id_list&&ordered_service_id_list.length>0){ordered_service_id_list.forEach(function(ordered_service_id){all_checkboxes=all_checkboxes.concat(jQuery.find("input[name*='checkbox_yesno_SERVICE{EXISTING}{"+ordered_service_id+"}{PROCEDURECODE}']"));});}
else{jQuery.find("[name=clinicalservicerow][servicetype=CPTII]").forEach(function(field_prefix){all_checkboxes=all_checkboxes.concat(jQuery.find("input[name*='checkbox_yesno_"+field_prefix.id+"{PROCEDURECODE}']"));});}
return all_checkboxes;}
function CheckIfRowIsCPTII(cptiirow,currentrow){if(jQuery(currentrow).is("tr[id*='SERVICE{NEW}{CPTII}{PROCEDURECODE}']")){return true;}
if(cptiirow&&cptiirow.length>0){for(var i=0;i<cptiirow.length;i++){if(jQuery(currentrow).is("tr[id*='"+cptiirow[i].id+"{PROCEDURECODE}']")){return true;}}}
return false;}
function trackCheckboxClick(e){if(e.originalEvent.isTrusted){trackInputClick(e);}}
function _trackLegacyBillingTabEvent(component,action,eventProperties){require(['shared:/scripts/athena/utils/cross_frame_events'],function(CrossFrameEventsUtils){CrossFrameEventsUtils.trigger('user-tracking.track-event',{rollout_toggle_key:'BILLING_TAB_AMPLITUDE',event_type:'BillingTab',event_properties:jQuery.extend({username:USERNAME,component:component,action:action,react_billing_tab:false,display_mode:'CLASSIC',clinical_encounter_id:CLINICAL_ENCOUNTER_ID,},eventProperties||{})});});}
function trackClassicBillingTabLoadComplete(args){_trackLegacyBillingTabEvent('Load','Complete',{visit_id:args.visitId,result_type:args.resultType,load_time_ms:args.loadTimeMs,run_id:args.runId,encounter_stage:args.encounterStage,});}
function trackInputClick(e){var event=e.type;var isNavigateKey=['Tab','Enter'].includes(e.originalEvent.key);if(event==='keyup'&&!isNavigateKey){return;}
var elem=jQuery(e.target);if(event==='mousedown'&&elem.is(jQuery(document.activeElement))){return;}
var fieldName=elem.attr('name');var name=_getInputName(fieldName);if(!name){return;}
_trackEvent({event_type:'Click',event_properties:{name:name,type:elem.attr('type').toLowerCase(),service:_getServiceType(elem)}});}
function trackSelectChange(e){var elem=jQuery(e.target);var fieldName=elem.attr('name');var name=_getInputName(fieldName);if(!name){return;}
_trackEvent({event_type:'Click',event_properties:{name:name,type:elem.attr('type').toLowerCase()}});}
function trackAutoCompleteSelection(e){var elem=jQuery(e.target);var fieldName=elem
.closest('.autocomplete')
.siblings('input:enabled:visible')
.attr('name')||'';var name=_getInputName(fieldName);if(!name){return;}
_trackEvent({event_type:'Click',event_properties:{name:name,type:'autocomplete',service:_getServiceType(elem)}});}
function trackLinkClick(e){var elem=jQuery(e.target);var text=elem.text()||'';var trimmed=text.replaceAll('\t','').replaceAll('\n','').trim();var linkText=_getLinkText(trimmed);if(!linkText){return;}
_trackEvent({event_type:'Click',event_properties:{name:linkText,type:'link',service:_getServiceType(elem)}});}
function trackIconClick(e){var elem=jQuery(e.target);var name=elem.attr('title')||'';if(!name){return;}
var capitalizedName=name.charAt(0).toUpperCase()+name.slice(1);_trackEvent({event_type:'Click',event_properties:{name:capitalizedName,type:'icon',service:_getServiceType(elem)}});}
function _getServiceType(elem){var sectionFromChargeRow=elem
.closest("tr[name=clinicalprocedurerow]")
.prevAll("tr[name=clinicalservicerow]")
.first();var sectionFromHeader=elem
.closest("tr[id$=_header]")
.nextAll("tr[name=clinicalservicerow]")
.first();var sections=[sectionFromChargeRow,sectionFromHeader]
.filter(function(elem){return elem.length});var matchingSection=sections[0];if(matchingSection){return matchingSection.attr('servicetype');}}
function _getLinkText(text){var hasValidPrefix=['Apply',"Don't bill","Bill"]
.some(function(prefix){return text.startsWith(prefix);});if(hasValidPrefix){return text;}
var linkText={'check now':'Prescription Check','Audit history':'Audit History'};return linkText[text]||'';}
function _getInputName(name){var fieldNames={ADDSERVICE:'Add Service',ADDSERVICECODE:'Add Service',BILLFORSERVICEYN:'Bill?',DIAGNOSIS:'Diagnosis Code',EBILLINGSLIP_SIGNOFF:'Provider Review',EBILLINGSLIP_FREETEXT:'Notes',EBILLINGSLIP_AMENDMENT:'Amendment Notes',MODIFIER:'Modifier',SPECIALTYFIELDGROUP:'Clinical Add-On',SUPERVISINGPROVIDERID:'Supervising Provider',UNITS:'Units',VALUE:'Procedure Code'};var nameMatch=name.match(/.*SERVICE\{\w+\}\{(?:\d+|\w+)\}\{PROCEDURECODE\}\{\w+\}\{\d+}\{(\w+)\}.*/);var fieldKey=(nameMatch&&nameMatch[1])?nameMatch[1]:name;return fieldNames[fieldKey]||'';}
function _buildEventType(args){var eventTypeParts=['BillingTab'];if(args.event_properties.service){eventTypeParts.push('Service');}
eventTypeParts.push(args.event_type);return eventTypeParts.join('::');}
function _trackEvent(args){if(!args.event_properties.service){delete args.event_properties.service;}
require(['shared:/scripts/athena/utils/cross_frame_events'],function(CrossFrameEventsUtils){CrossFrameEventsUtils.trigger('user-tracking.track-event',{rollout_toggle_key:'BILLING_TAB_AMPLITUDE',event_type:_buildEventType(args),event_properties:jQuery.extend({},{username:USERNAME,clinicalEncounterId:CLINICAL_ENCOUNTER_ID},args.event_properties)});});}
function HandlePatientRecordRecipientSelect(clinicalproviderlookup){var directaddressinput=jQuery('#DIRECTADDRESS');directaddressinput.val('No Direct Address available');var methodselect=jQuery("select[id^='DOCUMENTACTIONREASONID']");methodselect.children("option:selected").removeAttr("selected");var selectedclinicalprovidername=clinicalproviderlookup.autocompletionname;if(selectedclinicalprovidername&&selectedclinicalprovidername.match(/Direct Address (.+)/i)){var directaddress=RegExp.$1;if(ValidateEmailCore(directaddress)){directaddressinput.val(directaddress);methodselect.children("option[text='Direct']").removeAttr("disabled");methodselect.children("option[text='Direct']").attr("selected",true);methodselect.trigger('change');return;}}
methodselect.children("option[text='Direct']").attr("disabled",true);if(jQuery('input[name=CALLBACKNUMBER]').val()!=''){methodselect.children("option[text='AthenaFax']").attr("selected",true);}
methodselect.trigger('change');}
function DisablePatientRecordDirectMethodOption(){var methodselect=jQuery('select[id^=DOCUMENTACTIONREASONID]');methodselect.children("option[text='Direct']").removeAttr("selected");methodselect.children('option[text=Direct]').attr('disabled',true);jQuery('#PATIENTRECORDMETHOD').val('');}
function validateCPOTName(){var currentName=jQuery('[name="NAME"]').val();var formattedName=TrimWhitespace(currentName.toUpperCase()).replace(/\s+/g,' ');var isNameInput=formattedName.length>0;var validName=true;if(isNameInput){var isOrderable=jQuery('[name="ORDERABLEYN"]').val()[0]==='Y';if(isOrderable){var existingNames=jQuery('[name="EXISTINGCPOTINFO"]').data('existingcpotinfo').ORDERABLECPOTNAMES;validName=!existingNames[formattedName];}}
jQuery('#cpot-name-checkmark').toggle(isNameInput&&validName);jQuery('#cpot-name-warning-message').toggle(isNameInput&&!validName);return validName;}
function validateOrderCode(){var currentOrderCode=jQuery('[name="ELECTRONICORDERCODE"]').val();var formattedOrderCode=TrimWhitespace(currentOrderCode.toUpperCase());var isOrderCodeInput=formattedOrderCode.length>0;var validOrderCode=true;if(isOrderCodeInput){var existingOrderCodes=jQuery('[name="EXISTINGCPOTINFO"]').data('existingcpotinfo').ELECTRONICORDERCODES;validOrderCode=!existingOrderCodes[formattedOrderCode]}
jQuery('#cpot-order-code-checkmark').toggle(isOrderCodeInput&&validOrderCode);jQuery('#cpot-order-code-warning-message').toggle(isOrderCodeInput&&!validOrderCode);return validOrderCode;}
function validateCompendiumFields(){var isNameValid=validateCPOTName();var isOrderCodeValid=validateOrderCode();var disableSave=!(isNameValid&&isOrderCodeValid);jQuery('[name="SAVE"]').attr("disabled",disableSave);jQuery('[name="SAVEANOTHER"]').attr("disabled",disableSave);return;}
