else{jQuery(deactivatedrows[i]).hide();}}
ReinitializeSpeechEnabledFields();}
function ScrollForObjectDisplay(scrollobject){var position=FindScrollingPosition(scrollobject);if(position.positionedparent){var minimumscrolltop=position.top+scrollobject.offsetHeight-position.positionedparent.clientHeight;if(position.positionedparent.scrollTop>position.top||position.positionedparent.scrollTop<minimumscrolltop){position.positionedparent.scrollTop=scrollobject.offsetHeight<=position.positionedparent.clientHeight?minimumscrolltop:position.top;}}}
function MedicationListSwitchSig(fieldprefix,medicationid,structuredunstructured,sourceobject){var structureddisplay;var unstructureddisplay;if(structuredunstructured=='structured'){jQuery("[name='"+fieldprefix+"_SIGLINK_STRUCTURED_"+medicationid+"']").show();jQuery("[name='"+fieldprefix+"_SIGLINK_UNSTRUCTURED_"+medicationid+"']").hide();jQuery("[name='"+fieldprefix+"_SIGSPAN_STRUCTURED_"+medicationid+"']").show();jQuery("[name='"+fieldprefix+"_SIGSPAN_UNSTRUCTURED_"+medicationid+"']").hide();jQuery("[name='"+fieldprefix+"_ISSIGSTRUCTURED_"+medicationid+"']").get(0).value='Y';CheckDose({FIELDPREFIX:fieldprefix+'_',FIELDSUFFIX:'_'+medicationid,SOURCEOBJECT:sourceobject});}
else{jQuery("[name='"+fieldprefix+"_SIGLINK_STRUCTURED_"+medicationid+"']").hide();jQuery("[name='"+fieldprefix+"_SIGLINK_UNSTRUCTURED_"+medicationid+"']").show();jQuery("[name='"+fieldprefix+"_SIGSPAN_STRUCTURED_"+medicationid+"']").hide();jQuery("[name='"+fieldprefix+"_SIGSPAN_UNSTRUCTURED_"+medicationid+"']").show();jQuery("[name='"+fieldprefix+"_ISSIGSTRUCTURED_"+medicationid+"']").get(0).value='N';SetDoseCheckWarnings({FIELDPREFIX:fieldprefix+'_',FIELDSUFFIX:'_'+medicationid,KEY:'NORECORD',SOURCEOBJECT:sourceobject});}}
function TabLink(inputargs){var args={};if(inputargs){jQuery.extend(args,inputargs);}
if(inputargs.RETURNPOINT){setReturnPathway({name:inputargs.RETURNPOINT,url:inputargs.RETURNPOINTURL,schedulenav:inputargs.SCHEDULENAV,schedulenavurl:inputargs.SCHEDULENAVURL});}
var mainframe=AH.Frames.Main.GetLocation().toString();var patientid=args.PATIENTID?args.PATIENTID:AH.GetGlobal('PATIENTID');var globalchartid=GetChartID();var chartid=isDefined(args.CHARTID)?args.CHARTID:globalchartid;var openencounter=0;if(globalchartid&&(globalchartid==chartid)&&mainframe.match("charttabs.esp")){var tab=AH.Frames.Main.getElementById('tab_'+args.ID);if(!tab||!args.ID.match(/E\d+/)||!args.SECTION){var currentencounterexists=0;if(args.CHECKOPENENCOUNTER){var tabs=GetChildren(AH.Frames.Main.Document(),'tagName','div','id',/tab_E+/);for(var j=0;j<tabs.length;j++){if(tabs[j].title=="current encounter"){currentencounterexists=1;}}
if(!currentencounterexists){var clinicalencounterid=args.ID.replace(/E/,"");if(!isNaN(clinicalencounterid)){var bannerwrapper=AH.Frames.Main.getElementById('patient-banner-wrapper');CallRemote({SUB:'PatientWorkflow::GetHeaderHTMLandEncounterStage',ARGS:{CLINICALENCOUNTERID:clinicalencounterid,USEBANNER:bannerwrapper?1:0},ONFINISH:function(returnvalues){if(returnvalues&&returnvalues.HEADERHTML&&returnvalues.STAGE){var returnhtml=returnvalues.HEADERHTML;var stage=returnvalues.STAGE;var charttabswrapper=AH.Frames.Main.getElementById('charttabsheader');var headingcontainer=AH.Frames.Main.getElementById('patientworkflowhtmlwrapper');if(bannerwrapper&&charttabswrapper){charttabswrapper.innerHTML=returnhtml;}
else if(headingcontainer){headingcontainer.innerHTML=returnhtml;}
var destination='PATIENTID='+patientid+'&CHARTID='+chartid+'&CLINICALENCOUNTERID='+clinicalencounterid+'&STAGE='+stage;var url=AH.PrependBasePath('/clinicals/encounter.esp?'+destination);ChartTabsAddTab(args.ID,'current encounter',url,args.SECTION,args.REFRESH,1,args.NOSELECT);AH.Frames.Main.Frame().ResizePage();}
else{ChartTabsAddTab(args.ID,args.TITLE,args.URL,args.SECTION,args.REFRESH,undefined,args.NOSELECT);}}});openencounter=1;}}}
if(!openencounter){ChartTabsAddTab(args.ID,args.TITLE,args.URL,args.SECTION,args.REFRESH,undefined,args.NOSELECT);}}
if(isDefined(args.SECTION)&&args.SECTION!=''){if(args.ID.match(/E\d+/)){var encounter=null;var encounterdocument;try{encounterdocument=AH.Frames.Main.SubFrame('content_'+args.ID).document;encounter=encounterdocument.body;}catch(e){}
if(!encounter||encounter.innerHTML===""){window.setTimeout(function(){TabLink(args);},100);if(event){event.cancelBubble=true;}
return false;}
var tablist=jQuery(encounter).find('#contentset').attr('tablist');if(tablist){var tabhash=eval('('+tablist+')');var encountertabset=encounterdocument.getElementById('encountertabset');var encountertabs=GetChildren(encountertabset,'className',/^tab(?! hidden)/);var isclosedencounter=0;var matchingtab=-1;var i;for(i=0;i<encountertabs.length;i++){var id=encountertabs[i].id.match(/\d+/)[0];if(tabhash[id]){if(jQuery.inArray(args.SECTION,tabhash[id])>=0){matchingtab=id;break;}
else if(jQuery.inArray(args.SECTION+'_Summary',tabhash[id])>=0){args.SECTION+='_Summary';matchingtab=id;break;}
if(jQuery.inArray('ClosedEncounterSummary',tabhash[id])>=0){isclosedencounter=1;}}}
if(matchingtab!=-1){if(!encountertabs[i].className.match(/selected/)){AH.Frames.Main.SubFrame('content_'+args.ID).window.EncounterSelectTab.apply(AH.Frames.Main.SubFrame('content_'+args.ID).window,[matchingtab,args.SECTION]);}
else{ChartTabsScrollHistorypage(args.ID,args.SECTION);}}
else if(!args.IGNORECLOSED){if(isclosedencounter){alert('The encounter section you are trying to reach is in a closed encounter.');}
else{alert('The encounter section you are trying to reach has not been configured in this encounter stage.');}}
if(args.IGNORECLOSED){ChartTabsScrollHistorypage(args.ID,args.SECTION);}}}
else{ChartTabsScrollHistorypage(args.ID,args.SECTION);}}
var tabcontent=AH.Frames.Main.getElementById('content_'+args.ID);var currenttab=jQuery(AH.Frames.Main.getElementById('tab_'+args.ID));if(!openencounter&&(tabcontent.src===''||tabcontent.src.indexOf('blank.html')>-1)||currenttab.attr('status')!='loaded'){currenttab.click();}
if(event){event.cancelBubble=true;}
return false;}else{var destination='PATIENTID='+patientid+'&CHARTID='+chartid;if(isDefined(AH.GetGlobal('SPECIALTIES'))){destination=AddMultispecialtyFilterToURL(destination);}
if(isDefined(args.CHECKOPENENCOUNTER)&&args.CHECKOPENENCOUNTER&&args.ID.match(/E\d+/)){if(isDefined(args.ID)){destination+='&CLINICALENCOUNTERID='+args.ID.replace(/E/,"");}}
else{if(isDefined(args.ID)){destination+='&SELECTTAB='+args.ID;}
if(isDefined(args.TITLE)){destination+='&TITLE='+escape(args.TITLE);}
if(isDefined(args.URL)){destination+='&URL='+escape(args.URL);}}
if(isDefined(args.SECTION)){destination+='&SECTION='+args.SECTION;}
var charttabsurl=AH.PrependBasePath('/clinicals/charttabs.esp?'+destination);if(args.RETURNURL){return charttabsurl;}
else{AH.Frames.Main.SetLocation(charttabsurl);return false;}}}
function GenerateTabLink(id,title,url){var link;link="<a onclick=\"; return TabLink({ ID:'"+id+"', TITLE:'"+title+"', URL:'"+url+"'});\" href=\"#\">"+title+"</a>";return link;}
function buildInpatientURL(context){var chartid=context.chartid;var url=AH.GetGlobal('AIRLOCK_URL')+AH.GetGlobal('BASE_HREF')+"/inpatient/chart/"+context.chartid;if(context.stayid){url+='?stay_id='+context.stayid;}
return url;}
function buildAirlockURL(context){var airlockurlprefix=AH.GetGlobal('AIRLOCK_URL_PREFIX')||'ax';var url=AH.GetGlobal('AIRLOCK_URL')
+AH.GetGlobal('BASE_HREF')+"/"+airlockurlprefix+"/";if(context.returnpoint){setReturnPathway({name:context.returnpoint,url:context.returnpointurl,schedulenav:context.schedulenav});}
if(context.url){return url+(context.url.charAt(0)==='/'?context.url.substr(1):context.url);}
else if(context.name==='document_workspace'){url=url+context.name;}
else if(context.name==='documents'){url=url+context.name;}
else{url=url+context.name+'/'+context.id;}
var section;if(context.name==='encounter'){if(context.status==='closed'){url=url+'/summary?force=true';}
else if(context.stage==='EXAM'||context.stage==='SIGNOFF'){url=url+'/exam?force=true';if(!context.briefing){section='review';if(context.stage==='SIGNOFF'){section='summary';url=url+'&reassignEncounter=true';}
url=url+'#chart?section=problems/encounterNavigation?page=main&section='+section;}}
else if(context.stage==='INTAKE'){url=url+'/intake?force=true#encounterNavigation?section=';url=url+(context.section?context.section:'encounter_reason');url=url+'&page='+(context.briefing?'briefing':'main');}
else{url=url+'/exam';}}
else if(context.name==='appointment'){url=url+'/briefing';}
else if(context.name==='inbox'){url=url+'/dashboard#inbox?'
+'bucket='+context.bucket;}
if(context.name==='briefing'&&(context.documentclass||context.documentid)){if(context.departmentid){url=url+'?department_id='+context.departmentid;if(context.documentid){url=url+'&documentIds='+context.documentid;}}
if(context.carousel){url=url
+'#carouselView?documentClass='+context.documentclass;}
else{url=url
+'#documentPane?documentClass='+context.documentclass;}
if(context.documentid){url=url+'&documentIds='+context.documentid;}
else{url=url
+'&newDocumentClass='+context.documentclass
+'&chartId='+context.id
+'&patientId='+context.patientid;}
if(context.delegateOrders){url=url
+'&delegateOrders='+context.delegateOrders
+'&providerAckAssignedTo='+encodeURIComponent(context.providerAckAssignedTo);}
if(context.multipleSignOff){url=url
+'&multipleSignOff='+context.multipleSignOff
+'&multipleSignOffOrderType='+context.multipleSignOffOrderType
+'&multipleSignOffAssignedTo='+encodeURIComponent(context.multipleSignOffAssignedTo);}}
else if(context.name==='briefing'&&context.lightbox){url=url
+'#lightbox?type='+context.lightbox
+'&loadArgs='+JSON.stringify({queryParamMap:{PATIENTID:context.patientid,CHARTID:context.id,NOHEADER:1,FACESHEET:1}});}
else if(context.name==='briefing'&&context.patientaction){if(context.patientaction==='adddocument'){var eventInfo={username:AH.GetGlobal('USERNAME'),patientId:context.patientid,chartId:context.id};var eventType;if(context.hasOwnProperty('lightbox')){eventType='QUICK_VIEW';}
else{eventType='PATIENT_SEARCH';}
require(['shared:/scripts/athena/utils/cross_frame_events'],function(CrossFrameEventsUtils){try{CrossFrameEventsUtils.trigger('user-tracking.track-event',{rollout_toggle_key:'ADD_DOCUMENT_AMPLITUDE_TRACKING',event_type:'UPLOAD_ADD_DOCUMENT::'+eventType,event_properties:eventInfo});}
catch(err){}});}
url=url+'#patientAction?type='+context.patientaction;}
else if(context.name==='document_workspace'){if(context.consolidated){url=url
+'/document/'+context.documentclass+'/consolidated'
+'?chart_id='+context.id
+'&status='+context.status
+'&assigned_to='+encodeURIComponent(context.assignedto);}
else{url=url
+'/document/'+context.documentid
+'/'+context.documentclass
+'?department_id='+context.departmentid;}}
else if(context.name==='documents'){url=url
+'/document/'+context.documentid
+'/'+context.documentclass
+'/standalone';if(context.returnurl){url=url+'?return_url='+encodeURIComponent(context.returnurl);}}
if(context.name==='briefing'&&context.abstraction){url=url+'?abstraction=1#chart?section=allergies';}
if(context.inboxType){url=url+'&inboxType='+context.inboxType;}
return url;}
function setReturnPathway(args){var pathwaystoragekey='ATHENAX_RETURN_PATHWAY';var schedulenavurl;if(args.schedulenav){if(args.schedulenavurl){schedulenavurl=args.schedulenavurl;}
else{schedulenavurl=AH.Frames.ScheduleNav.frame.location.href;}}
if(args.name=='Missing Slip Worklist'){var startindex=schedulenavurl.indexOf('ACTIVATESLIPONLOAD=');var endindex;if(startindex>0){endindex=schedulenavurl.indexOf('&',startindex);}
else{startindex=schedulenavurl.indexOf('.esp?')+5;endindex=startindex;}
var appointmentid=jQuery(AH.Frames.ScheduleNav.Document()).find(".card.active").attr('data-appointmentid');if(endindex>0){schedulenavurl=schedulenavurl.substring(0,startindex)
+'ACTIVATESLIPONLOAD='+appointmentid+'&'
+schedulenavurl.substring(endindex);}}
if(window.sessionStorage&&typeof(window.sessionStorage.setItem)==='function'){window.sessionStorage.setItem(pathwaystoragekey,JSON.stringify({url:(args.url?args.url:AH.Frames.Main.frame.location.href),name:args.name,schedulenav_url:(args.schedulenav?schedulenavurl:'')}));}}
function getPatientBanner(){var maindocument=AH.Frames.Main.Document();return maindocument.getElementById('patientworkflowheading');}
function NavigateBack(encountercontext){if(encountercontext){window.location=AH.GetGlobal('encounterURL');}
else{window.location=AH.GetGlobal('contextURL');}}
function UrlInDepartment(basehref,departmentid,url){return basehref+'/loadpageindepartment.esp?DEPARTMENTID='+departmentid+'&URL='+escape(url);}
function GoToPractice(practiceid,stacknumber,departmentid){var basehref='/'+practiceid+'/'+stacknumber;if(AH.Frames.GlobalNav.GetGlobal('contextid')!=practiceid||AH.GetGlobal('DEPARTMENTID')!=departmentid){AH.SetGlobals({BASE_HREF:basehref,DEPARTMENTID:departmentid});if(AH.Frames.GlobalNav.GetGlobal('contextid')!=practiceid){SetFocusonPracticeChange(practiceid,departmentid);navbarurl=basehref+'/globalnav.esp';if(departmentid){navbarurl=UrlInDepartment(basehref,departmentid,navbarurl);}
AH.Frames.GlobalNav.SetLocation(navbarurl);}}}
function SetFocusonPracticeChange(practiceid,departmentid){var timeinterval=setInterval(function(){if(AH.Frames.GlobalNav.GetGlobal('contextid')==practiceid){if(departmentid){if(AH.GetGlobal('DEPARTMENTID')==departmentid){clearInterval(timeinterval);if(jQuery("[id='labresultincde']").attr('id')){jQuery("[name='SPECIMEN{2}{TIETOORDERDOCUMENTID}_LINK']").focus();}
else{jQuery('#depanel :input:visible:enabled:first').focus();}}}
else{clearInterval(timeinterval);if(jQuery("[id='labresultincde']").attr('id')){jQuery("[name='SPECIMEN{2}{TIETOORDERDOCUMENTID}_LINK']").focus();}
else{jQuery('#depanel :input:visible:enabled:first').focus();}}}},1000);}
function GoToDocument(practiceid,stacknumber,documentid,departmentid,viewunknownproviderdocument){var basehref='/'+practiceid+'/'+stacknumber;GoToPractice(practiceid,stacknumber,departmentid);if(viewunknownproviderdocument){viewdocumenturl=basehref+'/clinicalsadmin/unknownproviderdocuments.esp?PRACTICEID='+practiceid+'&DOCUMENTID='+documentid+'&VIEW='+viewunknownproviderdocument;}else{viewdocumenturl=basehref+'/clinicals/documentview.esp?ID='+documentid;if(departmentid){viewdocumenturl=UrlInDepartment(basehref,departmentid,viewdocumenturl);}}
AH.Frames.Main.SetLocation(viewdocumenturl);}
function OpenDocumentinNewWindow(practiceid,stacknumber,documentid,departmentid){documentview='clinicals/documentview.esp?ID='+documentid;basehref='/'+practiceid+'/'+stacknumber;mainurl=basehref+'/globalframeset.esp?SKIPLOGOUTDIALOG=1&MAIN='+escape(documentview);if(departmentid){mainurl=UrlInDepartment(basehref,departmentid,mainurl);}
thewindow=window.open(mainurl,'document'+practiceid+'v'+documentid);thewindow.focus();}
function OpenPageInNewWindow(basehref,mainurl,windowname){var url=basehref+'/globalframeset.esp?SKIPLOGOUTDIALOG=1&MAIN='+escape(mainurl);thewindow=window.open(url,windowname);thewindow.focus();}
function IsRendered(startnode,stopnode){if(!stopnode){stopnode=document;}
var n=startnode;do{if(jQuery(n).css('display')=='none'&&!(n.tagName=='INPUT'&&n.type=='hidden')){return false;}
n=n.parentElement;}while(n&&n!=stopnode);return true;}
