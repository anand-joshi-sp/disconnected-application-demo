else{DeleteExistingOrderItem(prefix,object);}
deletedanorder=1;break;}}
if(!deletedanorder){var prefix=orderwidgets[orderwidgets.length-1].id.replace(/{ORDERDIV}/,'');if(prefix.match(/\{NEW\}/)){DeleteNewOrderItem(prefix,object);}
else{DeleteExistingOrderItem(prefix,object);}}}
