Notifier.RunIfDocumentReady(function(){Notifier._Update(html);});},_Update:function(html){Notifier.element=Notifier.parentdocument.getElementById('tasknotifier');if(!Notifier.element&&Notifier.parentdocument.body){Notifier.emphasized=false;Notifier.element=Notifier.parentdocument.createElement('div');Notifier.element.id='tasknotifier';Notifier.element.setAttribute('class','safari');if(isTablet()){Notifier.element.setAttribute('class','safari ipad');}
