var finishedloadingexam=1;var examdatastore=new Object();var socialdatastore=new Object();function CopyOldData(encountersection,section){var container=section?section:document.zform;if(!finishedloadingexam){return void(0);}
finishedloadingexam=0;jQuery('[name]',container).each(function(index,item){var itemname=item.getAttribute('name');if(encountersection=='WellChildROS'||(encountersection=='ReviewOfSystems'&&itemname.match(/^EXAMELEMENT/))||itemname.match(/^EXAMVALUE/)||itemname.match(/^EXAMSENTENCEFREETEXT/)){examdatastore[itemname]=item.value;}
else if(encountersection=='SOCIALHISTORY'&&itemname.match(/^SOCIALHISTORY\./)){socialdatastore[itemname]=item.value;}});}
function PasteOldData(encountersection,section){var container=section?section:document.zform;jQuery('[name]',container).each(function(index,item){var itemname=item.getAttribute('name');if(item.encountersection==encountersection&&itemname.match(/^(EXAMELEMENT|EXAMVALUE|EXAMSENTENCEFREETEXT)/)){if(isDefined(examdatastore[itemname])&&examdatastore[itemname]!=item.value){item.value=examdatastore[itemname];if(itemname.match(/^(EXAMSENTENCEFREETEXT|EXAMVALUEFREETEXT)/)&&item.value!=''){item.style.display='';}
else{var span=jQuery(EscapeJQuerySelector('span[name="'+itemname+'_span"]'),container).get(0);if(span){var classes=span.className.split(' ');if(classes[0]=='abnormalreading'&&item.value=='NORMAL'){span.className='abnormalreading normal strikethrough';}else if(item.value=='NORMAL'){span.className=classes[0]+' normal';}else if(item.value=='ABNORMAL'){span.className=classes[0]+' abnormal';}else if(item.value==''){span.className=classes[0]+' inactive';}}}}}
if(encountersection=='SOCIALHISTORY'&&itemname.match(/^SOCIALHISTORY\./)){if(isDefined(socialdatastore[itemname])&&socialdatastore[itemname]!=item.value){item.value=socialdatastore[itemname];}}});finishedloadingexam=1;}
