this.ClearTooltip();jQuery(this.input).removeClass('InvalidInput');};InputWrapper.prototype.MarkInvalid=function(errorstring){this.input.invalid=true;if(this.input.title){this.input.hiddentitle=this.input.title;this.input.title='';}
this.AddToolTip(errorstring);jQuery(this.input).addClass('InvalidInput');};InputWrapper.prototype.AddToolTip=function(tooltiphtml){jQuery(this.input).attr('tooltiphtml',tooltiphtml);this.input.onmouseover=function(){ShowTip(this)};};InputWrapper.prototype.ClearTooltip=function(){jQuery(this.input).attr('tooltiphtml','');};InputWrapper.prototype.AddClass=function(classname){if(isDefined(this.input.className)&&this.input.className!=''){if(!this.input.className.match(new RegExp('\b'+classname+'\b'))){this.input.className+=' '+classname;}}
else{this.input.className=classname;}};InputWrapper.prototype.RemoveClass=function(removeclass){if(isDefined(this.input.className)&&this.input.className!=''){var oldClassList=this.input.className.split(/ +/);var newClassList=[];for(var i=0;i<oldClassList.length;i++){if(oldClassList[i]!=removeclass){newClassList.push(oldClassList[i]);}}
this.input.className=newClassList.join(' ');}};InputWrapper.prototype.ToggleClass=function(classname,condition){if(condition){this.AddClass(classname);}
else{this.RemoveClass(classname);}};InputWrapper.AddClass=function(input,classname){var wrapper=new InputWrapper(input);wrapper.AddClass(classname);};InputWrapper.RemoveClass=function(input,classname){var wrapper=new InputWrapper(input);wrapper.RemoveClass(classname);};InputWrapper.ToggleClass=function(input,classname,condition){var wrapper=new InputWrapper(input);wrapper.ToggleClass(classname,condition);};function ShowTip(element,zindex){if(!document.all('_tooltip')){var additionalstyle=jQuery(element).attr('additionalstyle');var tiphtml='<div id=_tooltip class=tooltip style="display: none;';if(additionalstyle&&additionalstyle!=''){tiphtml+=additionalstyle;}
tiphtml+='"></div>';document.body.insertAdjacentHTML('BEFOREEND',tiphtml);}
if(!document.all('_tooltipiframe')){var iframehtml='<iframe id=_tooltipiframe style="display: none; position: absolute; z-index=90" src="javascript:false;" frameBorder="0" scrolling="no"></iframe>';document.body.insertAdjacentHTML('BEFOREEND',iframehtml);}
var tooltip=document.all('_tooltip');var iframe=document.all('_tooltipiframe');var tipdelay=500;var mousex=event.clientX;var mousey=event.clientY;var tipdisplay=setTimeout(function(){var tooltiphtml=jQuery(element).attr('tooltiphtml');if(!tooltiphtml||tooltiphtml==''){return;}
tipdisplay=0;tooltip.innerHTML=tooltiphtml;tooltip.style.display="";var x=mousex+20;var y=mousey+10;var xoffset=jQuery(element).attr('xoffset');if(xoffset&&xoffset!=''){x=mousex+parseInt(xoffset);}
var yoffset=jQuery(element).attr('yoffset');if(yoffset&&yoffset!=''){y=mousey+parseInt(yoffset);}
var tipheight=tooltip.offsetHeight;var windowheight=document.body.clientHeight;if(y+tipheight>windowheight&&tipheight<windowheight){y-=(y+tipheight)-windowheight;}
var tipwidth=tooltip.offsetWidth;var windowwidth=document.body.clientWidth;if(x+tipwidth>windowwidth&&tipwidth<windowwidth){x-=(x+tipwidth)-windowwidth+10;}
var left=document.body.scrollLeft||document.documentElement.scrollLeft;var top=document.body.scrollTop||document.documentElement.scrollTop;tooltip.style.left=String(x+left)+'px';tooltip.style.top=String(y+top)+'px';iframe.style.top=tooltip.style.top;iframe.style.left=tooltip.style.left;iframe.style.width=tooltip.offsetWidth;iframe.style.height=tooltip.offsetHeight;if(zindex){tooltip.style.zIndex=zindex;}
iframe.style.display='';},tipdelay);var oldonmouseout=element.onmouseout;var oldonmouseup=element.onmouseup;element.onmouseout=function(){if(tipdisplay){clearTimeout(tipdisplay);}
else{tooltip.style.display='none';iframe.style.display='none';}
element.onmouseout=oldonmouseout;};element.onmouseup=function(){if(tipdisplay){clearTimeout(tipdisplay);}
else{tooltip.style.display='none';iframe.style.display='none';}
element.onmouseup=oldonmouseup;};}
function ZipToZipPlusFour(zipinput){zip=zipinput.value;zip=zip.replace(/(\d{5})(\d{1,})/g,"$1-$2");if(zip.length>10){zip=zip.substring(0,10);}
else if(zip.length<=6){zip=zip.replace(/-/,"");}
zipinput.value=zip;}
function SSIShowHighlightedHCFA(rectangles,attributes){LargeModalPopupWindow({page:AH.PrependBasePath('/ssi/medicalgroup/hcfaview.esp'),title:'CMS-1500 Claim Form',additionalargs:{rectangles:rectangles}});}
function EscapeWhitespaceCharacter(whitespacecharacter){var escapemap={'\n':'\\n','\r':'\\r','\t':'\\t','\f':'\\f','\b':'\\b'};return escapemap[whitespacecharacter];}
function ObjectToJSON(object,level){if(!level)level=1;if(level>100){var message="ObjectToJSON: recursion past level 100 detected (probably a circular structure).  Aborting.";throw{name:'Deep recursion error',description:message,message:message};}
switch(typeof object){case'string':object=object.replace(/\\/g,'\\\\');object=object.replace(/\"/g,'\\"');object=object.replace(/([\n\r\t\f\b])/g,EscapeWhitespaceCharacter);return'"'+object+'"';case'undefined':return'null';case'boolean':return object?'true':'false';case'function':case'number':return object.toString();default:var result='';if(!object){return'null';}
else if(object.constructor==Array){result='[ ';for(var i=0;i<object.length;i++){result+=ObjectToJSON(object[i],level+1);if(i<object.length-1)
result+=", ";}
result=result.replace(/, $/,' ');result+=' ]';if(object.length==0)result='[]';}
else{result='{ ';var keys=[];var proto=object.constructor&&object.constructor.prototype?object.constructor.prototype:{};for(var property in object){if(object[property]==proto[property])continue;keys.push(property);}
for(var j=0;j<keys.length;j++){result+=('"'+keys[j].replace(/\"/,'\\"')+'": '+ObjectToJSON(object[keys[j]],level+1));result+=", ";}
result=result.replace(/, $/,' ');result+=' }';if(keys.length==0)result='{}';}
return result;}}
function map(){var mapper=arguments[0];var returnArray=new Array;if(!isFunction(mapper)){throw("First argument to map must be a function, at:\n"+StackTrace());}
for(var i=1;i<arguments.length;i++){try{returnArray=returnArray.concat(mapper.apply(arguments[i],[arguments[i]]));}
catch(e){}}
return returnArray;}
if(!Array.prototype.map){Array.prototype.map=function(mapper){var tmpArray=this;tmpArray.unshift(mapper);return map.apply(this,tmpArray);};}
function DefineRemoveNode(){if(window.Node&&!Node.prototype.removeNode){Node.prototype.removeNode=function(removeChildren){var jqObject=jQuery(this);if(jqObject){if(removeChildren){jqObject.remove();}
else{jqObject.replaceWith(jqObject.children());}}}}}
function RunWhenDocumentReady(winFactory,action,timeout,timeouthandler){var checkinterval=250;if(timeout==null){timeout=25;}
var win=(typeof winFactory==='function')?winFactory():winFactory;var ready=0;try{ready=win&&win.document&&win.document.readyState=='complete';}catch(e){}
if(ready){try{action();}
catch(e){ReportError(e,"Error while executing action for ["+win+"]: ["+action+"]");}}
else if(timeout>0){timeout-=checkinterval/1000.0;setTimeout(function(){RunWhenDocumentReady(winFactory,action,timeout,timeouthandler)},checkinterval);}
else if(typeof(timeouthandler)=='function'){timeouthandler();}}
function DelayForFrameLoad(framepath,action){if(!DelayForFrameLoad.Cache){DelayForFrameLoad.Cache=[];}
if(!DelayForFrameLoad.Cache[framepath]){DelayForFrameLoad.Cache[framepath]=[];}
if(!isDefined(DelayForFrameLoad.Cache[framepath].RetryCount)){DelayForFrameLoad.Cache[framepath].RetryCount=0;}
if(!DelayForFrameLoad.Cache[framepath].Actions){DelayForFrameLoad.Cache[framepath].Actions=[];}
if(action){DelayForFrameLoad.Cache[framepath].Actions.push(action);}
var frame;try{eval('frame = '+framepath+';');}
catch(e){ReportError(e,"Couldn't get frame")};var ready=0;try{ready=frame&&frame.document&&frame.document.readyState=='complete';}
catch(e){}
if(ready){for(var i=0;i<DelayForFrameLoad.Cache[framepath].Actions.length;i++){var action=DelayForFrameLoad.Cache[framepath].Actions[i];try{action();}
catch(e){ReportError(e,"Error while executing action for ["+framepath+"]: ["+action+"]");};}
DelayForFrameLoad.Cache[framepath].RetryCount=0;DelayForFrameLoad.Cache[framepath].Actions=[];}
else if(DelayForFrameLoad.Cache[framepath].RetryCount<100){DelayForFrameLoad.Cache[framepath].RetryCount++;setTimeout(function(){DelayForFrameLoad(framepath)},250);}
else{DelayForFrameLoad.Cache[framepath].RetryCount=0;}}
function IsDateAfter(date1,date2){d1=new Date(date1);d2=new Date(date2);return(d2<d1);}
function FormatMiscCode(input){if(input.value&&!input.value.match(/^MISC/)){input.value='MISC'+input.value;}}
