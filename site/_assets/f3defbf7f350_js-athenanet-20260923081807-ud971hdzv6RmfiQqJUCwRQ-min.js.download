+" onclick='DeleteHistoricalPregnancyRow(\"HISTORICPREGNANCIES\", this);'></span>";}
function DeleteHistoricalPregnancyRow(context,rowelement){if(rowelement){var table=rowelement.parentNode.parentNode.parentNode;var rowindex=rowelement.parentNode.parentNode.rowIndex;if(table.rows.length-2==rowindex){ResetFieldElements(table.rows[rowindex]);return;}
else{DeleteRow(context,rowelement);}}}
function CheckGAValue(field){var gavalue=TrimWhitespace(field.value);if(gavalue&&!gavalue.match(/^\d{1,2}(\.\d)?$/)){alert("Invalid gestational age value. Please use only numerical values and only have up to one decimal value if present.");field.focus();}}
function TogglePrenatalViewEdit(obj,id,prefix){var table=jQuery(obj).parents("table[name=HISTORICALPRENATALS]").get(0);var viewrows=jQuery("tr[name='"+prefix+"VIEW_"+id+"']",table).get();var editrows=jQuery("tr[name='"+prefix+"EDIT_"+id+"']",table).get();if(!viewrows||!editrows){return;}
var block=0;if(viewrows[0].style.display==''){block=1;}
for(var i=0;i<viewrows.length;i++){viewrows[i].style.display=((block)?'none':'');}
for(var i=0;i<editrows.length;i++){editrows[i].style.display=((block)?'':'none');}}
function DeletePrenatalRow(obj,id,prefix){var table=jQuery(obj).parents("table[name=HISTORICALPRENATALS]").get(0);jQuery("tr[name='"+prefix+"VIEW_"+id+"']",table).remove();jQuery("tr[name='"+prefix+"EDIT_"+id+"']",table).remove();FireAncestorOnClick(obj);AddToDeleteList(id,prefix);}
function AddHistoricalPrenatalRow(obj,patientid,chartid){var jqobj=jQuery(obj);var clinicalencounterid=jqobj.attr('nextencounterid');clinicalencounterid='A'+clinicalencounterid;CallRemote({SUB:'Clinical::Patient::HistoricalPrenatalFlowsheet::GetNewEditEncounterHTML',ARGS:{CLINICALENCOUNTERID:clinicalencounterid,PATIENTID:patientid,CHARTID:chartid},ONFINISH:function(html){var objrow=jqobj.parents("tr:first").get(0);var objcell=jQuery(objrow).find('td').get(0);var newrow=document.createElement('TR');var jqnewrow=jQuery(newrow);jqnewrow.attr('name','HISTORICALPRENATALFLOWSHEET_EDIT_'+clinicalencounterid);jqnewrow.addClass('flowsheettopborder');var newcell=document.createElement('TD');var jqnewcell=jQuery(newcell);newcell.colSpan=objcell.colSpan;jqnewcell.css('backgroundColor',((objcell.style.backgroundColor=='#fff')?'#f9f9f9':'#fff'));SetInnerHTML(newcell,html);newrow.appendChild(newcell);jqobj.attr('nextencounterid',parseInt(jqobj.attr('nextencounterid'))+1);var success=objrow.parentNode.insertBefore(newrow,objrow);}});}
function UpdateWeeksGestation(encounterdatefield,startdate){if(!encounterdatefield||!startdate){return;}
var tablerow=jQuery(encounterdatefield).parents("tr:first").get(0);if(tablerow){var weeks=jQuery("input[name*='WEEKSGESTATION.WKS']",tablerow).get(0);var days=jQuery("input[name*='WEEKSGESTATION.DAYS']",tablerow).get(0);if(weeks&&days){var daysgestation=DateDiff(startdate,encounterdatefield.value);if(Number(daysgestation)||daysgestation==0){var negativevalues=(daysgestation/7<0)||(daysgestation%7<0);weeks.value=negativevalues?'':Math.floor(daysgestation/7);days.value=negativevalues?'':daysgestation%7;}}}}
function SetFocusToElement(id){document.location.href=document.location.href.toString().replace(/#.*/,'')+'#'+id;}
function AddToDeleteList(id,prefix){var deletelist=jQuery("[name='"+EscapeJQuerySelector(prefix)+"DELETEIDS']").get(0);deletelist.value+=","+id;}
