AH.SetGlobal('OKTARELOGINCOMPLETED',false);}
if(authState&&!expired){SetCookieValue('OKTASESSION',{SESSIONEXIST:authState.sessionExists});if(!authState.sessionExists){_OktaSessionLogs('oktaSessionNotFound','Session would be terminated as the Okta session does not exist, but the aNet session exists.','SESSIONTERMINATIONLOGGED');if(oktaSessionVerified){expired=true;}}
else{if(authState.userId!==AH.GetGlobal("OKTAUSERID")&&(AH.GetGlobal('SET_OKTA_USERID_COOKIE')?authState.userId!==GetCookieValue('OKTA_USERID'):true)){_OktaSessionLogs('userSessionSwitched','Session would be terminated as Okta userId has changed in the background','SESSIONTERMINATIONLOGGED',authState.userId,AH.GetGlobal("OKTAUSERID"));if(oktaSessionVerified){expired=true;}}
