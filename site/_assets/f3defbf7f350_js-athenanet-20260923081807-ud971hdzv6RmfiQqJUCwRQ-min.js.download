var input=jQuery('#AUTHENTICATIONDOMAINID');if(selectlisthtml){input.prop("disabled",false);jQuery('#AUTHENTICATIONDOMAINIDROW').show();selectSetInnerHTML(document.getElementById('AUTHENTICATIONDOMAINID'),selectlisthtml);}
else{DisableInputField(input);jQuery('#AUTHENTICATIONDOMAINIDROW').hide();}}}
