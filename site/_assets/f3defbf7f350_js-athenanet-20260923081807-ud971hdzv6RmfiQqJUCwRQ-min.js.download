if(freetext){freetext.style.display='none';ReinitializeSpeechEnabledFields();}}
function SetParagraphNormal(paragraph){AutoScroll(false,event.srcElement);var paragraphjq=jQuery(paragraph);var encountersectionattr=paragraphjq.attr('encountersection');if(paragraph.parentNode.className=='collapse'){Rollup(paragraph.parentNode,encountersectionattr);}
var paragraphisnormal=paragraphjq.hasClass('normal');var sentencetagname=encountersectionattr=='PhysicalExam_Grid'?'td':'tr';var sentencecontainers=GetChildrenByTagName({CONTEXT:GetParent(paragraph,'tagName','tbody'),TAGNAME:sentencetagname,FILTER:[{ATTRIBUTEKEY:'id',ATTRIBUTEVALUE:'SENTENCECONTAINER'},{ATTRIBUTEKEY:'paragraphid',ATTRIBUTEVALUE:paragraph.getAttribute('paragraphid')}]});var sentencecontainercount=sentencecontainers.length;var templateidattr=paragraph.getAttribute('templateid');var setparagraphnormal=false;for(var index=0;index<sentencecontainercount;index++){var sentencecontainer=sentencecontainers[index];var sentenceidattr=sentencecontainer.getAttribute('sentenceid');var sentencecontext=(encountersectionattr=='PhysicalExam_Grid')?sentencecontainer:sentencecontainer.children[1];var elementspan=sentencecontext.children['ELEMENT_'+sentenceidattr+'_row'].children['ELEMENT_'+sentenceidattr+'_span'];var elementspanjq=jQuery(elementspan);if(!templateidattr||templateidattr==elementspan.getAttribute('templateid')){var sentenceisnormal=elementspanjq.hasClass('normal');if((paragraphisnormal&&sentenceisnormal)||(!paragraphisnormal&&!sentenceisnormal)){SetElementNormal(sentenceidattr,encountersectionattr,true);if(!elementspanjq.hasClass('inactive')){setparagraphnormal=true;}}}}
var arrow=GetImmediateChild({CONTEXT:paragraph,FILTER:[{ATTRIBUTEKEY:'id',ATTRIBUTEVALUE:'paragrapharrow'}]});if(paragraphisnormal){paragraph.className='paragraph';if(encountersectionattr!='PhysicalExam_Grid'){arrow.className='sprite-play-down-m-FFF';}}
else if(setparagraphnormal){paragraph.className='paragraph normal';if(encountersectionattr!='PhysicalExam_Grid'){arrow.className='sprite-play-down-m-DFC';}}}
function SetElementNormal(elementid,encountersection,fromparagraph){if(!fromparagraph)AutoScroll(false,event.srcElement);var section=GetTemplateContainer();if(!section)section=document;var rowtagname=encountersection=='PhysicalExam_Grid'?'div':'span';var row=jQuery(rowtagname+'#ELEMENT_'+elementid+'_row',section).get(0);var elementspan=jQuery('span#ELEMENT_'+elementid+'_span',section).get(0);var normals=[];if(!InList(encountersection,['PhysicalExam_Grid','HPI_Templated'])){var normalcandidates=elementspan.childNodes;for(var i=0;i<normalcandidates.length;i++){var normalcandidatename=jQuery(normalcandidates[i]).attr('name');if(normalcandidates[i].tagName=='INPUT'&&normalcandidatename&&normalcandidatename.match(/EXAMVALUE_/)){normals.push(normalcandidates[i]);}}}
else{normals=GetChildren(row,'valuetype','NORMAL');}
var normalspans=GetChildren(row,'className',/^normalreading/,'tagName','span');var arrowimage=elementspan.children[0].children['sentencearrow'];var paragraphid=elementspan.getAttribute('paragraphid');var paragraph;var paragrapharrow;if(ClearNormals(normals,normalspans)==normalspans.length){elementspan.className='normalcomponent inactive';if(encountersection!='PhysicalExam_Grid'){arrowimage.className='sprite-play-m-FFF';}
if(!fromparagraph){paragraph=GetParagraphSpan(row,paragraphid);if(paragraph.className=='paragraph normal'){paragraph.className='paragraph';if(encountersection!='PhysicalExam_Grid'){paragrapharrow=GetImmediateChild({CONTEXT:paragraph,FILTER:[{ATTRIBUTEKEY:'id',ATTRIBUTEVALUE:'paragrapharrow'}]});paragrapharrow.className='sprite-play-down-m-FFF';}}}}
else{elementspan.className='normalcomponent normal';if(encountersection!='PhysicalExam_Grid'){arrowimage.className='sprite-play-m-DFC';}
SetNormals(normals,normalspans);if(!fromparagraph){paragraph=GetParagraphSpan(row,paragraphid);if(!paragraph.className.match(/normal/)){if(CheckAllSentencesNormal(paragraph)){paragraph.className='paragraph normal';if(encountersection!='PhysicalExam_Grid'){paragrapharrow=GetImmediateChild({CONTEXT:paragraph,FILTER:[{ATTRIBUTEKEY:'id',ATTRIBUTEVALUE:'paragrapharrow'}]});paragrapharrow.className='sprite-play-down-m-DFC';}}}}}
var abnormalsneutrals=GetChildren(row,'valuetype',/ABNORMAL|NEUTRAL/);var abnormalneutralspans=GetChildren(row,'className',/abnormalreading|neutralreading/,'tagName','span');ClearAbnormalsNeutrals(abnormalsneutrals,abnormalneutralspans);}
function CheckAllSentencesNormal(paragraph){var encountersectionname=paragraph.getAttribute('encountersection');var sentencecontainers=GetSentenceContainer(paragraph,1,encountersectionname);var sentencecontainer,sentenceid,elementspans;for(var i=0;i<sentencecontainers.length;i++){sentencecontainer=sentencecontainers[i];sentenceid=sentencecontainer.getAttribute('sentenceid');if(paragraph.getAttribute('paragraphid')==sentencecontainer.getAttribute('paragraphid')){var sentencecontext=(encountersectionname=='PhysicalExam_Grid')?sentencecontainer:sentencecontainer.children[1];elementspans=sentencecontext.children['ELEMENT_'+sentenceid+'_row'].children['ELEMENT_'+sentenceid+'_span'];var sentenceisnormal=jQuery(elementspans).hasClass('normal');if(!sentenceisnormal){return false;}}}
return true;}
function SetNormals(normals,normalspans){for(var i=0;i<normalspans.length;++i){normalspans[i].className='normalreading normal';if(normalspans[i].innerText.match(/_{2,}/)){ShoweditValuenameFreetext(normalspans[i]);}}
for(var i=0;i<normals.length;++i){normals[i].value='NORMAL';}}
function ClearNormals(normals,normalspans){var normalspanscount=0;for(var i=0;i<normals.length;++i){normals[i].value='';}
for(var i=0;i<normalspans.length;++i){if(normalspans[i].className=='normalreading normal'){++normalspanscount;}
normalspans[i].className='normalreading inactive';}
return normalspanscount;}
function ClearAbnormalsNeutrals(elements,spans){for(var i=0;i<elements.length;++i){elements[i].value='';}
for(var i=0;i<spans.length;++i){var type=spans[i].className.match(/abnormalreading|neutralreading/);spans[i].className=type+' inactive';}}
function RedrawResultsTable(){var jqform=jQuery(document.zform);var resultstable=jqform.find('#RESULTSTABLE').get(0);var specstable=jqform.find('#RESULTSTABLESPECS').get(0);if(!specstable||!resultstable){return'';}
var rowselect=GetChild(specstable,'tagName','select','name',/^NUMROWS/);var colselect=GetChild(specstable,'tagName','select','name',/^NUMCOLUMNS/);var colheader=GetChild(specstable,'tagName','input','name',/^HEADERCOLUMN/);var rowheader=GetChild(specstable,'tagName','input','name',/^HEADERROW/);var selectnumcol=colselect.value;var selectnumrow=rowselect.value;var currentnumcol=0;if(resultstable.cells){currentnumcol=resultstable.cells.length/resultstable.rows.length;}
var currentnumrow=resultstable.rows.length;if(currentnumrow<selectnumrow){for(var i=currentnumrow;i<selectnumrow;i++){resultstable.insertRow(-1);}}
else{for(var i=selectnumrow;i<currentnumrow;i++){resultstable.deleteRow(-1);}}
currentnumrow=resultstable.rows.length;for(var i=0;i<currentnumrow;i++){var cellsinrow=resultstable.rows[i].cells.length;if(cellsinrow<selectnumcol){for(var j=cellsinrow;j<selectnumcol;j++){var newcell=resultstable.rows[i].insertCell(-1);if((i==0&&rowheader.checked)||(j==0&&colheader.checked)){FillCellWithHeader(resultstable,newcell,i,j);}
else{FillCellWithDataType(resultstable,newcell,i,j);}}}
else{for(var j=selectnumcol;j<cellsinrow;j++){resultstable.rows[i].deleteCell(-1);}}}
if(colheader.checked){for(var i=0;i<selectnumrow;i++){var selectobj=GetChild(resultstable.rows[i].cells[0],'tagName','select','name',/^RESULTFIELD/);if(selectobj){var cell=selectobj.parentNode;FillCellWithHeader(cell.parentNode.parentNode,cell,i,0);}}}
else{for(var i=1;i<selectnumrow;i++){var inputobj=GetChild(resultstable.rows[i].cells[0],'tagName','input','name',/^RESULTFIELD/);if(inputobj){var cell=inputobj.parentNode
FillCellWithDataType(cell.parentNode.parentNode,cell,i,0);}}}
if(rowheader.checked){for(var i=0;i<selectnumcol;i++){var selectobj=GetChild(resultstable.rows[0].cells[i],'tagName','select','name',/^RESULTFIELD/);if(selectobj){var cell=selectobj.parentNode;FillCellWithHeader(cell.parentNode.parentNode,cell,0,i);}}}
else{for(var i=1;i<selectnumcol;i++){var inputobj=GetChild(resultstable.rows[0].cells[i],'tagName','input','name',/^RESULTFIELD/);if(inputobj){var cell=inputobj.parentNode;FillCellWithDataType(cell.parentNode.parentNode,cell,0,i);}}}
if(!colheader.checked&&!rowheader.checked){var inputobj=GetChild(resultstable.rows[0].cells[0],'tagName','input','name',/^RESULTFIELD/);if(inputobj){var cell=inputobj.parentNode;FillCellWithDataType(cell.parentNode.parentNode,cell,0,0);}}
FixScrollWidth();}
function FillCellWithHeader(resultstable,cellobj,i,j){cellobj.innerHTML="<INPUT size=15 name = 'RESULTFIELD{"+(+i+1)+"}{"+(+j+1)+"}'>";var cellcontents=GetChild(resultstable.rows[i].cells[j],'name',/^RESULTFIELD/);jQuery(cellcontents).addClass('RequiredField');}
