if(jqpickercontent.length){if(fieldname&&jqpickercontent.attr('orderingimprovement')==='ON'){Picker.UpdateOrderCounter({INCREMENT:false,FIELDNAME:fieldname,CLINICALPROVIDERID:clinicalproviderid,CLINICALORDERTYPEID:clinicalordertypeid,CLINICALPROVIDERORDERTYPEID:clinicalproviderordertypeid});return;}}
var prefix=args.PREFIX;var index=clinicalordertypeid;if(!isDefined(index)){return;}
var diagnosisordercontents=jQuery('#diagnosisordersorderpickercontainer').children('div.diagnosisordercontents');if(diagnosisordercontents.size()==0){diagnosisordercontents=jQuery("#masterorderpickercontainer DIV.orderpickercontent");}
var count=0;if(isDefined(window.diagnosisorderscounter)&&isDefined(window.diagnosisorderscounter[index])){if(window.diagnosisorderscounter[index]>1){window.diagnosisorderscounter[index]--;count=window.diagnosisorderscounter[index];}
else{delete window.diagnosisorderscounter[index];}}
jQuery('span.pickeritem[id='+index+']',diagnosisordercontents).each(function(){FixOrderCounter(this,count);});}
function SyncOrderCounts(contentdiv){if(!isDefined(window.diagnosisorderscounter)){window.diagnosisorderscounter={};}
for(var clinicalordertypeid in window.diagnosisorderscounter){jQuery('span.pickeritem[id='+clinicalordertypeid+']',contentdiv).each(function(){FixOrderCounter(this,window.diagnosisorderscounter[clinicalordertypeid]);});}}
function ShowDelete(object){if(jQuery(object).hasClass('selected')&&jQuery(object).hasClass('hover')&&jQuery('span.sprite-close-16x16',object).length==0){jQuery("<span class='sprite-close-16x16' style='position: absolute; right: 2px; top: 2px; cursor: pointer;' title='delete'></span>").appendTo(object);}}
function HideDelete(object){jQuery('span.sprite-close-16x16',object).remove();}
