function RefreshDDIMessagesOnAdd(args,container){var newddispan=jQuery(container).find('span#NEWDDIWARN').get(0);if(newddispan){if(newddispan.getAttribute('clinicalordertypeid')==args.clinicalordertypeid||newddispan.getAttribute('medicationid')==args.medicationid){var images=GetChildren(newddispan,'tagName','SPAN','className',/sprite/);for(var j=0;j<images.length;j++){var currentimage=images[j];var typeid=currentimage.getAttribute('conflictordertypeid');var medicationid=currentimage.getAttribute('conflictmedicationid');if(typeid||medicationid){var conflictordertypeinfo={'clinicalordertypeid':args.clinicalordertypeid,'clinicalordertypename':args.clinicalordertypename,'medicationid':currentimage.getAttribute('medicationid'),'conflictordertypeid':typeid,'conflictmedicationid':medicationid,'imageobject':currentimage};_RefreshMessagesOnAdd(conflictordertypeinfo,container);}}}
newddispan.id='DDIWARN';}
return 0;}
function RefreshDDIMessagesOnDelete(args,container){if(typeof diagnosisordersexistingrxordertypeidlist!='undefined'&&args.clinicalordertypeid){var index=diagnosisordersexistingrxordertypeidlist.indexOf(args.clinicalordertypeid+':');if(index>=0){return 0;}}
var contentset=nvl(jQuery(container).find('div#contentset').get(0),document);var ddispans=jQuery(contentset).find(".ddiwarning").toArray();if(!ddispans||ddispans.length==0){return;}
var conflictordertypes=new Array();var cnt=0;var found=0;for(var i=0;i<ddispans.length;i++){if((ddispans[i].getAttribute('clinicalordertypeid')==args.clinicalordertypeid&&args.clinicalordertypeid)||(ddispans[i].getAttribute('medicationid')==args.medicationid&&args.medicationid)){found=1;break;}
else{var images=jQuery(ddispans[i]).find('span#WARNINGIMAGE').toArray();for(var j=0;j<images.length;j++){var typeid=images[j].getAttribute('conflictordertypeid');if((images[j].getAttribute('conflictordertypeid')==args.clinicalordertypeid&&args.clinicalordertypeid)||(images[j].getAttribute('conflictmedicationid')==args.medicationid&&args.medicationid)){conflictordertypes[cnt]={'ordertypeid':args.clinicalordertypeid,'imageobject':images[j]};cnt++;}}}}
if(!found){for(var j=0;j<conflictordertypes.length;j++){var deleteargs=conflictordertypes[j];var imageobject=deleteargs['imageobject'];if(imageobject&&imageobject.parentNode){jQuery(imageobject.parentNode).remove();}}}
return 0;}
function redirectToAirlock(url){if(AH.GetGlobal('AIRLOCKINCLASSICFRAMESET')){AH.Frames.ScheduleNav.Hide();AH.SetGlobal('DISABLESHOWNAVIGATION',true);AH.Frames.ScheduleNav.SetLocation(AH.PrependBasePath(GetMDCCompatibleHTMLURL('blank.html')));AH.Frames.Main.SetLocation(url);}
else{AH.Frames.Top.SetLocation(url);}}
function _RefreshMessagesOnAdd(args,container){var imageobject=args['imageobject'];var contentset=nvl(jQuery(container).closest('div#contentset').get(0),document);var ddispans=jQuery(contentset).find("span.ddiwarning");ddispans.each(function(){if(this.parentNode.id.toString().match(/ORDER{(\w+)}{(\d+)}{WARNINGS}/)){return true;}
if((this.getAttribute('clinicalordertypeid')==args.conflictordertypeid&&args.conflictordertypeid)||(this.getAttribute('medicationid')==args.conflictmedicationid&&args.conflictmedicationid)){var conflictspan=this;var images=GetChildrenByTagName({CONTEXT:this,TAGNAME:'span',FILTER:[{ATTRIBUTEKEY:'id',ATTRIBUTEVALUE:'WARNINGIMAGE'}]});var found=0;for(j=0;j<images.length;j++){var currentimage=images[j];if(currentimage.getAttribute('conflictordertypeid')==args.clinicalordertypeid||currentimage.getAttribute('conflictmedicationid')==args.medicationid){found=1;return false;}}
