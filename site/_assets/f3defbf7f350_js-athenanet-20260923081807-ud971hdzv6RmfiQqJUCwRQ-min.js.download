else{var resultTypeOptions=jQuery(this).data('resulttypeoptions');if(resultTypeOptions){var resultTypeValues=resultTypeOptions[resultType];if(resultTypeValues&&resultTypeValues.length){resultTypeValues.some(function(resultTypeValue){if(resultTypeValue.RESULTVALUE===resultValue){resultTypeValueId=resultTypeValue.RESULTTYPEVALUEID;}
return resultTypeValueId;});}}}});}}
currentRow.find("[name*='RESULTTYPEVALUEID']").val(resultTypeValueId);}
