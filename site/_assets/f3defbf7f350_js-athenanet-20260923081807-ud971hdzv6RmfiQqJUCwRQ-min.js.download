'SUB='+escape('Document::Class::PATIENTRECORD::DownloadEncryptedPDF')+
'&ARGS='+ObjectToJSON({DOCUMENTID:documentid})+
'&CONTENTTYPE='+escape('application/pdf')));}
function TemplateEventHandler(element){var sentencecontainer,paragraphidattr,rollupspan,paragraph;if(element.id=='SENTENCECONTAINER'){sentencecontainer=element;paragraphidattr=jQuery(element).attr('paragraphid');element=event.srcElement;}
else if(element.id=='rollupspan'){rollupspan=element;element=event.srcElement;}
if(element.id=='sentencearrow'){element=GetParent(element,'tagName','span');}
else if(element.id=='paragrapharrow'){element=GetParent(element,'tagName','span');}
if(element.title&&element.title=='additional notes'){element=GetParent(element,'tagName','span');}
var elementid=element.id;var elementjq=jQuery(element);var elementnameattr=elementjq.attr('name');var sentenceelementidattr=elementjq.attr('sentenceelementid');var templateevent=event.type;if(!isDefined(elementid)&&templateevent=='selectstart'){return false;}
if(elementid.match(/PARAGRAPH/)){if(templateevent=='click'){SetParagraphNormal(element);}
else if(!jQuery(element).hasClass('normal')){if(templateevent=='mouseover'){element.className='paragraphhover';}
else if(templateevent=='mouseout'){element.className='paragraph';}
var arrow=jQuery('span#paragrapharrow',element).get(0);if(!arrow){return;}
if(GetParent(element,'id','rollupspan').className=='collapse'){if(templateevent=='mouseover'){arrow.className='sprite-play-mfill-FFF';}
else if(templateevent=='mouseout'){arrow.className='sprite-play-m-FFF';}}
else{if(templateevent=='mouseover'){arrow.className='sprite-play-down-mfill-FFF';}
else if(templateevent=='mouseout'){arrow.className='sprite-play-down-m-FFF';}}}}
else if(sentenceelementidattr){if(templateevent=='click'){paragraph=GetParagraphSpan(sentencecontainer,paragraphidattr);SetElementNormal(sentenceelementidattr,jQuery(paragraph).attr('encountersection'));}
else{if(templateevent=='mouseover'){element.className='sentenceprefixhover';}
else if(templateevent=='mouseout'){element.className='sentenceprefix';}
var arrowimage=jQuery('span#sentencearrow',element).get(0);if(!arrowimage){return;}
if(GetParent(element,'id','ELEMENT_'+sentenceelementidattr+'_span').className=='normalcomponent normal'){return;}
if(templateevent=='mouseover'){arrowimage.className='sprite-play-mfill-FFF';}
else if(templateevent=='mouseout'){arrowimage.className='sprite-play-m-FFF';}}}
else if(elementid.match(/EXAMELEMENTNEUTRAL/)){if(templateevent=='mouseover'){element.style.borderColor="#0F83EE";}
else if(templateevent=='mouseout'){element.style.borderColor="";}
else if(templateevent=='click'){var showfreetexttemplate=GetImmediateChild({CONTEXT:element,FILTER:[{ATTRIBUTEKEY:'id',ATTRIBUTEVALUE:'FreeTextTemplate'}]});if(element.className=='sentencefreetext'&&(!showfreetexttemplate||showfreetexttemplate.style.display=='none')){ShowValueFreetext(element);}
else{ToggleValue(element);}}
else if(templateevent=='dblclick'){ShowValueFreetext(element);}}
else if(elementnameattr&&(elementnameattr.match(/EXAMSENTENCEFREETEXT/)||elementnameattr.match(/EXAMVALUENAMEFREETEXT/)||elementnameattr.match(/EXAMVALUEFREETEXT/))){if(templateevent=='click'){event.cancelBubble=true;return true;}
else if(templateevent=='selectstart'){return true;}}
else if(elementid=='rollup'){if(templateevent=='click'){paragraph=GetImmediateChild({CONTEXT:rollupspan,FILTER:[{ATTRIBUTEKEY:'id',ATTRIBUTEVALUE:'PARAGRAPH_'+rollupspan.getAttribute('paragraphid')+'_span'}]});Rollup(element.parentNode,jQuery(paragraph).attr('encountersection'));}}
else if(elementnameattr&&elementnameattr.match(/EXAMVALUENAMEDROPDOWN/)){if(templateevent=='click'){event.cancelBubble=true;return true;}}
else if(elementid.match(/EXAMVALUE_/)){if(templateevent=='mouseover'){if(element.className.match(/^normalreading/)){element.style.borderColor="#3A3";}
else if(element.className.match(/abnormalreading/)){element.style.borderColor="#A33";}
else{paragraph=GetParagraphSpan(sentencecontainer,paragraphidattr);if(jQuery(paragraph).attr('encountersection')=='PhysicalExam_Grid'){element.style.borderColor="#33A";}
else{element.style.borderColor="#0F83EE";}}}
else if(templateevent=='mouseout'){element.style.borderColor="";}
else if(templateevent=='click'){if(element.className=='sentencefreetext'&&(!GetChild(element,'id','FreeTextTemplate')||GetChild(element,'id','FreeTextTemplate').style.display=='none')){ShowValueFreetext(element);}
else{if(element.innerText.match(/_{2,}/)){ShoweditValuenameFreetext(element);}
ToggleValue(element);AutoScroll(true,element);}}
else if(InList(templateevent,['dblclick','touchstart'])){ActivateValue(element);ShowValueFreetext(element);}}}
function CancelLink(noheader,id,edit){var noheader=noheader;var documentid=id;var editreviewdocument=edit;if(AH.GetGlobal('contextURL')){if(editreviewdocument==1){document.location="documentview.esp?ID="+documentid+"&NOHEADER="+noheader;}
else if(AH.GetGlobal('contextURL').match('&NOHEADER=1')){AH.SetGlobal('contextURL',AH.GetGlobal('contextURL').replace(/&NOHEADER=1/,''));AH.Frames.Main.SetLocation(AH.GetGlobal('contextURL'));}else{AH.Frames.Main.SetLocation(AH.GetGlobal('contextURL'));}}else{return false;}}
function CrossCheckPatientNameDOB(args){var patientfield=(args&&isDefined(args.SELF))?args.SELF:document.zform.PATIENTID;var patientnamefield=(args&&isDefined(args.PATIENTNAMEFIELD))?args.PATIENTNAMEFIELD:document.getElementById("PATIENTNAME");var patientautocompleteobj;if(patientfield&&patientfield.value){if(isNaN(patientfield.value)){alert("Invalid Patient Id. Please change Patient Id.");return false;}
patientautocompleteobj=patientfield.autocompleteobj;if(!patientfield.autocompleteobj){return true;}
if(!isDefined(patientautocompleteobj.autocompletiondata)){var completionserviceargs=(args&&isDefined(args.PROVIDERGROUPID))?{PROVIDERGROUPID:args.PROVIDERGROUPID,FIELDVALUE:patientfield.value}:{};if(isDefined(args.SEARCHARGS)){completionserviceargs['SEARCHARGS']=args.SEARCHARGS;}
CallRemote({SUB:'Clinical::Patient::Autocomplete',LOADINGINDICATORFLAG:true,ARGS:completionserviceargs,ONFINISH:function(data){if(data.length==1&&data[0]['DATA']){patientautocompleteobj.autocompletiondata=data[0]['DATA'];patientautocompleteobj.autocompleteinputvaluestatus='SINGLETONMATCH';}
else if(data.length==1&&data[0]['ERRORVALUE']){patientautocompleteobj.autocompletiondata=null;patientautocompleteobj.autocompleteinputvaluestatus=data[0]['ERRORVALUE'];}
else if(data.length==0){patientautocompleteobj.autocompletiondata=null;patientautocompleteobj.autocompleteinputvaluestatus='INVALID';}
else{patientautocompleteobj.autocompletiondata=null;}}});return false;}
if(patientautocompleteobj.autocompleteinputvaluestatus=='INVALID'){alert("Invalid Patient Id. Please change Patient Id.");return false;}
if(patientautocompleteobj.autocompleteinputvaluestatus=='PROVIDERGROUPMISMATCH'){alert("This patient belongs to a different provider group.  Please choose a different department or a different patient.");if(document.zform.DEPARTMENTID){document.zform.DEPARTMENTID.focus();}
return false;}
if(patientautocompleteobj.autocompletiondata&&patientnamefield){if(isDefined(args.NOPATIENTLINK)){patientnamefield.innerHTML=patientautocompleteobj.autocompletiondata.PATIENTNAME;}
else if(isDefined(args.SHOWFULLDEMOGRAPHICS)){var demographics=patientautocompleteobj.autocompletiondata;var dob=new Date(demographics.DOB);if(dob){demographics.DOB="";if(dob.getMonth()<9){demographics.DOB='0';}
demographics.DOB+=(dob.getMonth()+1)+'-';if(dob.getDate()<10){demographics.DOB+='0';}
demographics.DOB+=dob.getDate()+'-'+dob.getFullYear();}
var phone;if(demographics.HOMEPHONE){phone=""+demographics.HOMEPHONE;}
else if(demographics.MOBILEPHONE){phone=""+demographics.MOBILEPHONE;}
if(phone){phone=phone.replace(/\D/g,'');if(phone.length>=10){demographics.PHONENUMBER="("+phone.substr(0,3)+") "+phone.substr(3,3)+"-"+phone.substr(6,4);if(phone.length>10){demographics.PHONENUMBER+="x"+phone.substr(10);}}
else if(phone.length==7){demographics.PHONENUMBER="() "+phone.substr(0.3)+"-"+phone.substr(3,4);}
else{demographics.PHONENUMBER=phone;}}
var zip=demographics.ZIP;if(zip){zip=zip.replace(/\D/g,'');if(zip.length==10){demographics.ZIP=zip.substr(0,5)+'-'+zip.substr(5);}}
var ssn=demographics.SSN;if(ssn){ssn=ssn.replace(/\D/g,'');}
if(ssn&&ssn.length==9){demographics.SSN=ssn.substr(0,3)+'-'+ssn.substr(3,2)+'-'+ssn.substr(5);}
demographics.HASADDRESS=demographics.ADDRESS1!=null||demographics.ADDRESS2!=null||demographics.CITY!=null||demographics.STATE!=null||demographics.ZIP!=null;require(['template!shared:/templates/interface/patientmatch/demographics'],function(demographicstemplate){patientnamefield.innerHTML=demographicstemplate(demographics);});}
else{var dobstring=isDefined(patientautocompleteobj.autocompletiondata.DOB)?"  dob : "+patientautocompleteobj.autocompletiondata.DOB:'';patientnamefield.innerHTML="<a href='"+patientautocompleteobj.autocompletiondata.PATIENTURL+"' target='frMain'>"+patientautocompleteobj.autocompletiondata.PATIENTNAME+dobstring+"</a>";}}}
else if(patientfield&&!patientfield.value&&patientnamefield&&patientnamefield.innerHTML!=''){patientnamefield.innerHTML='';return true;}
else{return true;}
if(document.zform.PATIENTDOB){SetDate(0,document.zform.PATIENTDOB);}
if(!document.zform.PATIENTDOB||document.zform.PATIENTDOB.value==''||!IsDate(document.zform.PATIENTDOB.value)){return true;}
if(warneddob!=''&&warneddob==document.zform.PATIENTDOB.value&&warnedpatientid!=''&&warnedpatientid==patientfield.value){return true;}
if(patientautocompleteobj.autocompletiondata&&isDefined(patientautocompleteobj.autocompletiondata.DOB)&&patientautocompleteobj.autocompletiondata.DOB!=''&&patientautocompleteobj.autocompletiondata.DOB!=document.zform.PATIENTDOB.value){warneddob=document.zform.PATIENTDOB.value;warnedpatientid=document.zform.PATIENTID.value;alert('The date of birth does not match the patient entered. Please double-check.');return false;}
return true;}
function CheckPatientDetails(field){if(!field.autocompleteobj){return;}
var autoobject=field.autocompleteobj;var data=autoobject.autocompletiondata;var baseuri=field.baseURI;function BTGOnAccess(){redirectToAirlock(baseuri);}
if(data&&data.USEAUTHZPERMISSIONLOGIC&&data.BLOCKED&&data.ACCESSLEVEL!=="FREEACCESS"){require(['shared:/scripts/athena/dataprivacy/break_the_glass_widget'],function(BreakTheGlassWidget){BreakTheGlassWidget.checkBlockedPatientAccess({patientId:data.PATIENTID,dpWorkflow:"Autocomplete access blocked patient",onAccess:BTGOnAccess});});}
else if(!data||!data.USEAUTHZPERMISSIONLOGIC){var namevalue=TrimWhitespace(autoobject.autocompletionname);if(namevalue=='XXXX, XXXX'){alert('You do not have permission to view this record. Please contact your supervisor if you require access');}}}
function SetDefaultRegardingProvider(){if(document.zform&&document.zform.PROVIDERUSERNAME){if(document.zform.PROVIDERUSERNAME.options&&document.zform.PROVIDERUSERNAME.options.length==2){if(document.zform.PROVIDERUSERNAME.options[1]){document.zform.PROVIDERUSERNAME.options[1].selected=true;var supervisingprovider=jQuery("[name='SUPERVISINGPROVIDERUSERNAME']");if(supervisingprovider&&supervisingprovider.val()==''){jQuery("[name='PROVIDERUSERNAME']").change();}}}}
var $ticklerspan=jQuery("#RETURNTOOFFICE_PROVIDERINPUT\\{0\\}");var $providerselect=$ticklerspan.children("[name=APPOINTMENTTICKLER_PROVIDERID\\{0\\}]");if($providerselect.children().length==2){var $provideroption=jQuery($providerselect.children('option').get(1));$providerselect.attr("DefaultValue",$provideroption.val());$provideroption.attr("selected",true);}}
function DocumentViewConfirmExit(){if(!submitting&&(FormChanged()||IsDocumentActionChanged())){return'Some changes to this document have not yet been saved';}}
function IsDocumentActionChanged(){var documentactions=document.getElementsByName('DOCUMENTACTIONGROUPID');for(i=0;i<documentactions.length;i++){if(documentactions[i].checked){return true;}}}
function SetTabIndexes(documentclass,documentstatus){var currentdocumentclass=documentclass;var currentdocumentstatus=documentstatus;var documentstatuses=['SPLIT','CATEGORIZE','PRECLASSIFY','CLASSIFY','DOUBLECLASSIFY','DATAENTRY','DATACAPTURE','DOUBLEDATACAPTURE','DATASELECT','DOUBLEDATASELECT','CLINICALDATAENTRY','WAIT','DATAQA','CLINICALQA','CAPTUREQA','CAPTURERECONCILE','DATARECONCILE'];if(!(fieldclassnames[currentdocumentclass]&&InList(currentdocumentstatus,documentstatuses))){return;}
var tabindexnum=1;var labresultincde;for(i=0;i<fieldclassnames[currentdocumentclass].length;i++){if(currentdocumentclass=='LABRESULT'&&currentdocumentstatus=='CLINICALDATAENTRY'&&fieldclassnames[currentdocumentclass][i]=='OBSERVATIONDATE'&&!labresultincde){labresultincde=1;fieldclassnames[currentdocumentclass].splice(i,1);fieldclassnames[currentdocumentclass].push('OBSERVATIONDATE');}
var fieldobj=jQuery("[name='"+fieldclassnames[currentdocumentclass][i]+"']");var otherfields=['ACTIONPANEL','SUBMITPANEL','SPECIMENSDATATABLE'];if(!InList(fieldclassnames[currentdocumentclass][i],otherfields)&&fieldobj){if(tabindexnum==1&&!fieldobj.prop('disabled')){try{fieldobj.focus();}
catch(e){}}
if(fieldobj.attr('tagName')=='SPAN'&&fieldobj.attr('id')=='PATIENTNAME'){continue;}
fieldobj.attr("tabIndex",tabindexnum++);}
else if(fieldclassnames[currentdocumentclass][i]=='ACTIONPANEL'){var radiogroupobj=document.getElementsByName('DOCUMENTACTIONGROUPID');var assignedtoobj=jQuery("[name='ASSIGNEDTO']");for(var r=0;r<radiogroupobj.length;r++){if(radiogroupobj[r]){radiogroupobj[r].tabIndex=tabindexnum;}}
tabindexnum++;for(var l=0;l<radiogroupobj.length-1;l++){var selectobj=jQuery("[name='DOCUMENTACTIONREASONID"+l+"']");if(selectobj){selectobj.attr("tabindex",tabindexnum++);}}
if(assignedtoobj){assignedtoobj.attr("tabIndex",tabindexnum++);}}
else if(fieldclassnames[currentdocumentclass][i]=='SUBMITPANEL'){var saveandnextinqueueobj=document.getElementById('SAVEANDNEXTINQUEUE');var cancelobj=document.getElementsByName('CANCEL');var saveobj=document.getElementById('SAVE');var saveandnextobj=document.getElementById('SAVEANDNEXT');if(saveandnextinqueueobj){saveandnextinqueueobj.tabIndex=tabindexnum++;}
if(cancelobj.length>0){cancelobj[0].tabIndex=tabindexnum++;}
if(saveobj){saveobj.tabIndex=tabindexnum++;}
if(saveandnextobj){saveandnextobj.tabIndex=tabindexnum++;}}
else if(fieldclassnames[currentdocumentclass][i]=='SPECIMENSDATATABLE'){var setfocus=0;if(tabindexnum==1){setfocus=1;}
for(var j=1;j<=20;j++){var externalaccessionidentifierobj=jQuery("[name='SPECIMEN{"+j+"}{EXTERNALACCESSIONIDENTIFIER}']");var observationdateobj;var observationtimeobj;if(currentdocumentclass!='LABRESULT'||!jQuery('#depanel').attr('id')){observationdateobj=jQuery("[name='SPECIMEN{"+j+"}{OBSERVATIONDATE}']")||jQuery("[name='OBSERVATIONDATE']");observationtimeobj=jQuery("[name='SPECIMEN{"+j+"}{OBSERVATIONTIME}']")||jQuery("[name='OBSERVATIONTIME']");}
var tietoorderdocumentidobj=document.getElementById('SPECIMEN{'+j+'}{TIETOORDERDOCUMENTID}_LINK')||document.getElementById('TIETOORDERDOCUMENTID_LINK');var resultstatusobj=jQuery("[name='SPECIMEN{"+j+"}{RESULTSTATUS}']")||jQuery("[name='RESULTSTATUS']");var ordtypesearchobj=jQuery("[name='SPECIMEN{"+j+"}{CLINICALORDERTYPEID}_SEARCH']");var ordtypeclearobj=jQuery("[name='SPECIMEN{"+j+"}{CLINICALORDERTYPEID}_CLEAR']");var addlinkobj=document.getElementById('addlink'+j);var dellinkobj=document.getElementById('dellink'+j);if(externalaccessionidentifierobj&&!jQuery('#depanel').attr('id')){if(setfocus==1&&j>1){externalaccessionidentifierobj.focus();setfocus=0;}
externalaccessionidentifierobj.attr("tabIndex",tabindexnum++);}
if(observationdateobj){if(setfocus==1&&j>1){observationdateobj.focus();setfocus=0;}
observationdateobj.attr("tabIndex",tabindexnum++);}
if(observationtimeobj){observationtimeobj.attr("tabIndex",tabindexnum++);}
if(tietoorderdocumentidobj){if(setfocus==1&&j>1){tietoorderdocumentidobj.focus();setfocus=0;}
if(j>1||!jQuery('#depanel').attr('id')){tietoorderdocumentidobj.tabIndex=tabindexnum++;}}
if(externalaccessionidentifierobj&&jQuery('#depanel').attr('id')&&j>1){externalaccessionidentifierobj.attr("tabIndex",tabindexnum++);}
if(resultstatusobj&&(j>1||!jQuery('#depanel').attr('id'))){resultstatusobj.attr("tabIndex",tabindexnum++);}
if((j>1)&&ordtypesearchobj){ordtypesearchobj.attr("tabIndex",tabindexnum++);}
if((j>1)&&ordtypeclearobj){ordtypeclearobj.attr("tabIndex",tabindexnum++);}
if((j>1)&&addlinkobj){addlinkobj.tabIndex=tabindexnum++;}
if((j>1)&&dellinkobj){dellinkobj.tabIndex=tabindexnum++;}}
tabindexnum=300;}}}
function ValidateTimeFormat(field,validtimeregexp){if(field.value!=''&&!field.value.match(validtimeregexp)){alert('Invalid format for start time.  Should be like "16:00" or "10:45"');setTimeout(function(){field.focus();},0);jQuery(field).addClass('InvalidInput');return false;}
else{jQuery(field).removeClass('InvalidInput');}}
function ClinicalDocumentUpdateTieToOrder(field,documentclass,documentsubclass,documentid){if(field.previousvalue==field.value){return;}
var patientid=document.zform.PATIENTID;var tietoorderlinkobj=GetChild(document,'name',/TIETOORDERDOCUMENTID/,'inputclass','AUTOCOMPLETESELECT');var tietoorderinputobj=GetChild(document,'name',/TIETOORDERDOCUMENTID/,'type','hidden');if(patientid&&tietoorderlinkobj){CallRemote({SUB:'Document::CreateTieToOrderOptions',ARGS:{CLINICALORDERID:tietoorderlinkobj.value,DOCUMENTCLASS:documentclass,DOCUMENTID:documentid,DOCUMENTSUBCLASS:documentsubclass,OBSERVATIONDATE:field.value,PATIENTID:patientid.value},ONFINISH:function(orders){var orderids=[];var ordernames=[];var ordersbyid={};for(var i=0;i<orders.length;i++){var currorder=orders[i];var currorderid=currorder.VALUE;orderids.push(currorderid);ordernames.push(currorder.NAME);ordersbyid[currorderid]=currorder;}
if(!tietoorderlinkobj.autocompleteobj){jQuery(tietoorderlinkobj).trigger("onfocus");}
if(!InList(tietoorderlinkobj.value,orderids)){tietoorderlinkobj.innerHTML="select";tietoorderinputobj.value="";}
tietoorderlinkobj.autocompleteobj.defaultselections=[orderids,ordernames];jQuery(tietoorderlinkobj).attr('fieldoptions',ObjectToJSON(ordersbyid));}});}
field.previousvalue=field.value;}
function SwitchFlowsheetInputRow(flowsheetselector){var allflowsheetsspan=GetParent(flowsheetselector,'id','RELEVANTFLOWSHEETS');var flowsheetspans=GetChildren(allflowsheetsspan,'flowsheetspan','1');for(var i=0;i<flowsheetspans.length;i++){if(flowsheetspans[i].id==flowsheetselector.value){flowsheetspans[i].style.display='inline';}
else{flowsheetspans[i].style.display='none';}}}
function LabResultUpdateTieToOrder(field,documentclass,documentsubclass,documentid,departmentid){if(field.previousvalue==field.value){return;}
var patientid=GetChild(document.zform,'tagName','input','name','PATIENTID');if(!patientid){patientid=GetChild(document.zform,'tagName','input','name','NEWPATIENTID');}
var tietoorderfields=GetChildren(document.zform,'name',/TIETOORDERDOCUMENTID/);if(patientid&&tietoorderfields){var tietoordername=field.name.replace(/OBSERVATIONDATE/,"TIETOORDERDOCUMENTID");var row=GetParent(field,'tagName','tr');var tietoorderinput=GetChild(row,'tagName','input','name',tietoordername);var tietoorderlinkobj=GetChild(row,'name',tietoordername+'_LINK');if(tietoorderinput&&tietoorderlinkobj){CallRemote({SUB:'Document::CreateTieToOrderOptions',ARGS:{CLINICALORDERID:tietoorderinput.value,DEPARTMENTID:departmentid,DOCUMENTCLASS:documentclass,DOCUMENTID:documentid,DOCUMENTSUBCLASS:documentsubclass,OBSERVATIONDATE:field.value,PATIENTID:patientid.value},ONFINISH:function(orders){var orderids=[];var ordernames=[];var ordersbyid={};for(var i=0;i<orders.length;i++){var currorder=orders[i];var currorderid=currorder.VALUE;orderids.push(currorderid);ordernames.push(currorder.NAME);ordersbyid[currorderid]=currorder;}
if(!tietoorderlinkobj.autocompleteobj){jQuery(tietoorderlinkobj).trigger("onfocus");}
if(!InList(tietoorderinput.value,orderids)){tietoorderlinkobj.innerHTML="select";tietoorderinput.value="";}
tietoorderlinkobj.autocompleteobj.defaultselections=[orderids,ordernames];jQuery(tietoorderlinkobj).attr('fieldoptions',ObjectToJSON(ordersbyid));}});}}}
function ValidateDateOrder(earlierdateobj,laterdateobj){earlierdate=new Date(earlierdateobj.value);laterdate=new Date(laterdateobj.value);if(earlierdate>laterdate){alert(earlierdateobj.name+"  should be earlier than or equal to  "+laterdateobj.name);return;}
if(DateDiff(earlierdate,laterdate)==0){earliertime=earlierdateobj.name.replace('DATE',"TIME");var earliertimeobj=document.getElementsByName(earliertime);latertime=laterdateobj.name.replace('DATE',"TIME");var latertimeobj=document.getElementsByName(latertime);if(earliertimeobj[0].value&&latertimeobj[0].value){var earliertimearray=earliertimeobj[0].value.split(":");earliertimevalue=earliertimearray[0]*60+earliertimearray[1];latertimearray=latertimeobj[0].value.split(":");latertimevalue=latertimearray[0]*60+latertimearray[1];if(earliertimevalue>latertimevalue){alert(earliertime+"  should be earlier than "+latertime);return;}}}}
function PopulateFromDuplicate(documentid){CallRemote({SUB:"Document::Class::LABRESULT::AnalyteFormFromDuplicate",ARGS:{DOCUMENTID:documentid},ONFINISH:function(data){SetInnerHTML(document.getElementById('RESULTSTABLESPAN'),data);}});}
function PopulateFromTemplate(clinicalresulttemplateid){CallRemote({SUB:'Document::Class::LABRESULT::AnalyteFormFromTemplate',ARGS:{CLINICALRESULTTEMPLATEID:clinicalresulttemplateid},ONFINISH:function(data){SetInnerHTML(document.getElementById('RESULTSTABLESPAN'),data);}});}
function TemplateDuplicateSearch(resultid){if(resultid==''){return;}
document.getElementById('TEMPLATEDUPLICATES').innerHTML="<em>Searching...</em>";CallRemote({SUB:'Document::Class::LABRESULT::DuplicateTemplateSearch',ARGS:{PATIENTID:document.zform.PATIENTID.value,DOCUMENTID:resultid,CLINICALPROVIDERID:document.zform.CLINICALPROVIDERID.value,CLINICALORDERTYPEID:document.zform.CLINICALORDERTYPEID.value,OBSERVATIONDATE:document.zform.OBSERVATIONDATE.value,OBSERVATIONTIME:document.zform.OBSERVATIONTIME.value,EXTERNALACCESSIONIDENTIFIER:document.zform.EXTERNALACCESSIONIDENTIFIER.value},ONFINISH:function(data){var templateduplicateelement=document.getElementById('TEMPLATEDUPLICATES');SetInnerHTML(templateduplicateelement,data);}});}
function LabResultAddRow(obj,insertBefore,tablename){var table=document.getElementById(tablename);if(!obj||!table)
return false;var rowNum=table.rows.length;rowNum=rowNum-1;var currentrow=obj.parentElement;while(currentrow&&currentrow.tagName!='TR'){currentrow=currentrow.parentElement;}
if(!currentrow){return;}
var rowIndex=currentrow.rowIndex;if(insertBefore){rowNum=rowIndex;}
if(obj.value!=''&&rowNum==rowIndex){var indexoflastrow;if(insertBefore){indexoflastrow=rowNum;}
else{indexoflastrow=table.rows.length;}
AddBlankRow({TABLE:table,TARGETINDEX:indexoflastrow,SOURCEINDEX:1});if(tablename!=='DOCRESULTTABLE'&&indexoflastrow>1){var fieldindex=indexoflastrow-1;var fieldnames=new Array('EXTERNALACCESSIONIDENTIFIER','OBSERVATIONDATE','OBSERVATIONTIME');for(var i=0;i<fieldnames.length;i++){var copyfields=GetChildren(table,'name',new RegExp('/\{'+fieldnames[i]+'\}\$/'));if(copyfields.length>=fieldindex){copyfields[fieldindex].value=copyfields[fieldindex-1].value}}}
var newrow=table.rows[indexoflastrow];if(tablename==='DOCRESULTTABLE'&&newrow){var tableSize=table.rows.length;var selectedResultTypes=[];for(var j=2;j<tableSize;j++){var tablerow=table.rows[j];var resultTypeElement=jQuery(tablerow).find("select[name*='RESULTTYPE']");if(resultTypeElement&&resultTypeElement.length&&resultTypeElement[0].value){selectedResultTypes.push(resultTypeElement[0].value);}}
var resultTypeRow=jQuery(newrow).find("select[name*='RESULTTYPE']");if(resultTypeRow&&resultTypeRow.length){selectedResultTypes.map(function(resultType){resultTypeRow.children('option[value="'+resultType+'"]').remove();});}}
var newfields=GetChildren(newrow,'tagName',['input','a','select']);for(var i=0;i<newfields.length;i++){if(newfields[i].tabIndex>0){newfields[i].tabIndex+=indexoflastrow*10;}}
return;}}
function SetUpResultTypeField(cotid,resultTypeInfoElement){var hideResultTypeField=1;if(cotid&&resultTypeInfoElement.length){var resultTypeMappings=resultTypeInfoElement.data('cotresulttypemappings');if(resultTypeMappings){var newResultTypeOptions=resultTypeMappings[cotid];var prevResultTypeOptions=resultTypeInfoElement.data('resulttypeoptions');resultTypeInfoElement.data('resulttypeoptions',null);if(newResultTypeOptions){resultTypeInfoElement.data('resulttypeoptions',newResultTypeOptions);var resultTypeFields=jQuery("#DOCRESULTTABLE").find("select[name*='RESULTTYPE']");var resultTypes=Object.keys(newResultTypeOptions);resultTypeFields.each(function(index,resultTypeField){resultTypes.map(function(resultType){var option=jQuery(resultTypeField).find('option[value="'+resultType+'"]');if(option&&option.length===0){var newOption=new Option(resultType,resultType);resultTypeField.options.add(newOption);}});});}
var prevResultTypes=[];if(prevResultTypeOptions){prevResultTypes=Object.keys(prevResultTypeOptions);}
hideResultTypeField=RemoveUnnecessaryResultTypes(prevResultTypes);}}
if(hideResultTypeField){HideDocumentResultTable();}
else{jQuery('#structureddocresults').show();}}
function ClearResultValueOptions(){var table=jQuery("#DOCRESULTTABLE").get(0);for(var i=1;i<table.rows.length;i++){var tablerow=table.rows[i];var resultTypeElement=jQuery(tablerow).find("select[name*='RESULTTYPE']");var selectedVal;if(resultTypeElement&&resultTypeElement.length){selectedVal=resultTypeElement[0].value;}
if(!selectedVal){var resultValueFields=jQuery(tablerow).find("select[name*='RESULTVALUE']");resultValueFields.children('option:not(:first)').remove();jQuery(tablerow).find("[name*='RESULTTYPEVALUEID']").val('');}}}
function RemoveUnnecessaryResultTypes(prevResultTypes){var allResultTypes=[];var hideResultTypeField=1;jQuery('.structured-result-types').each(function(){var resultTypeOptions=jQuery(this).data('resulttypeoptions');if(resultTypeOptions){jQuery.merge(allResultTypes,Object.keys(resultTypeOptions));}});allResultTypes=jQuery.unique(allResultTypes);if(allResultTypes.length){hideResultTypeField=0;var resultTypesToRemove=[];if(prevResultTypes.length){prevResultTypes.map(function(prevResultType){if(jQuery.inArray(prevResultType,allResultTypes)<0){resultTypesToRemove.push(prevResultType);}});if(resultTypesToRemove.length){var resultTypeFields=jQuery("#DOCRESULTTABLE").find("select[name*='RESULTTYPE']");resultTypeFields.each(function(){var resultTypeField=this;resultTypesToRemove.map(function(resultTypeToRemove){var resultTypeOption=jQuery(resultTypeField).find('option[value="'+resultTypeToRemove+'"]');if(resultTypeOption){resultTypeOption.remove();}});});ClearResultValueOptions();}}}
return hideResultTypeField;}
