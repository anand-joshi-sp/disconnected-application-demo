function AutofillLastDiagnosisInfo(diagnosiscode,nextordering,alldiagnosisorders){var chartid=GetChartID();if(AH.GetGlobal('PATIENTID')&&chartid){var clinicalencounterid=null;if(isDefined(window.encounterid)){clinicalencounterid=encounterid;}
var providerusernamevalue=jQuery('#PROVIDERUSERNAME').children(':selected').val();CallRemote({SUB:'Clinical::Encounter::Section::DiagnosisOrders::GetLastDiagnosisInfo',ARGS:{PATIENTID:AH.GetGlobal('PATIENTID'),CHARTID:chartid,DIAGNOSISCODE:diagnosiscode,CLINICALENCOUNTERID:clinicalencounterid,PROVIDERUSERNAME:providerusernamevalue},ONFINISH:function(dxinfo){FillDiagnosisInfo(jQuery.parseJSON(dxinfo),diagnosiscode,nextordering,alldiagnosisorders);}});}}
function SelectOrderTab(){if(jQuery('div#contentset').length==0){return;}
var closeencountercheckbox=jQuery('#CLOSEENCOUNTER').get(0);var ordersignoffcheckbox=jQuery('#ORDERSSIGNOFF').get(0);if(!closeencountercheckbox||!ordersignoffcheckbox){return;}
var selectedtab=GetChild(document.getElementById('encountertabset'),'tagName','span','className',/tab selected/);var selectedtabid=GetTabId(selectedtab.id);var tabhash=eval('('+jQuery('#contentset').attr('tablist')+')');var selectedtabsections=tabhash[selectedtabid];var diagnosisorderstab;var assessmentplantab;if(InList('DiagnosisOrders',selectedtabsections)||InList('DiagnosisOrders_Summary',selectedtabsections)){diagnosisorderstab=selectedtabid;}
else if(InList('AssessmentPlan',selectedtabsections)||InList('AssessmentPlan_Summary',selectedtabsections)){assessmentplantab=selectedtabid;}
else{for(var tabid in tabhash){if(InList('DiagnosisOrders',tabhash[tabid])){diagnosisorderstab=tabid;break;}
else if(InList('AssessmentPlan',tabhash[tabid])){assessmentplantab=tabid;break;}}}
var closeencounterchecked=closeencountercheckbox.checked;if(diagnosisorderstab){closeencountercheckbox.checked=false;EncounterClean(GetSectionContainer(ordersignoffcheckbox));EncounterSelectTab(diagnosisorderstab,'DiagnosisOrders');}
else if(assessmentplantab){closeencountercheckbox.checked=false;EncounterClean(GetSectionContainer(ordersignoffcheckbox));EncounterSelectTab(assessmentplantab,'AssessmentPlan');}
if(closeencounterchecked){ordersignoffcheckbox.checked=true;}}
function FocusFirstOONROrder(alldiagnosisorders){var firstdisplay;var firstselect;var selectnodelist=document.getElementsByName("outofnetworkreferralreasonselect");var selectnodelistlength=selectnodelist.length;for(var i=0;i<selectnodelistlength;++i){var selectnode=selectnodelist[i];var parentnode=selectnode;for(var j=0;j<3;++j){if(parentnode){parentnode=parentnode.parentNode;}}
if(parentnode&&parentnode.tagName==="TR"&&parentnode.className==="outofnetworkreferralreasondisplay"&&parentnode.style.display!=="none"){firstdisplay=parentnode;firstselect=selectnode;break;}}
if(!firstdisplay||!firstselect){return false;}
var orderdiv=GetParent(firstdisplay,'tagName','div','className',/orderitem/);if(!orderdiv){return false;}
if(orderdiv.id.match(/NEW/)){Focus('NEWORDER',jQuery(orderdiv).attr('neworderid'),orderdiv,1);}
else{Focus('ORDER',jQuery(orderdiv).attr('documentid'),orderdiv,1);}
firstselect=jQuery(firstselect);_OutOfNetworkFocusSelect(firstselect);return true;}
function FocusFirstUnsignedOrder(alldiagnosisorders){if(!isDefined(window.diagnosisordersfocusitem)){return;}
if(Picker.GetOpenedContent()){return;}
var firstorderdeletelink=jQuery('a#orderdeletelink',alldiagnosisorders).get(0);var orderdiv=GetParent(firstorderdeletelink,'tagName','div','className',/orderitem/);if(!orderdiv){return;}
if(orderdiv.id.match(/NEW/)){Focus('NEWORDER',jQuery(orderdiv).attr('neworderid'),orderdiv,1);}
else{Focus('ORDER',jQuery(orderdiv).attr('documentid'),orderdiv,1);}}
function AnyFocusedOrderItemsExist(){return jQuery("#ALLDIAGNOSISORDERS").find(".orderform").is(":visible");}
function Focus(type,id,source,noscroll,haschangedimoterm){if(id==diagnosisordersfocusitem.ID&&type==diagnosisordersfocusitem.TYPE&&source.scrollWidth&&!haschangedimoterm){return;}
var summary=jQuery(EscapeJQuerySelector('#'+type+'_SUMMARY_'+id)).get(0);if(!summary){return;}
var form=jQuery(EscapeJQuerySelector('#'+type+'_FORM_'+id)).get(0);if(!form){return;}
if(!noscroll&&isObject(event)&&isDefined(event.srcElement)){var eventsc=GetSectionContainer(event.srcElement);var sourcesc=GetSectionContainer(source);if(eventsc!==sourcesc){SelectOrderTab();}}
var offset=0;var dofi=diagnosisordersfocusitem;if((dofi.TYPE=="ORDER"||dofi.TYPE=="NEWORDER")&&jQuery(dofi.SOURCE).offset().top<jQuery(source).offset().top){offset=-(jQuery('#'+dofi.TYPE+'_FORM_'+dofi.ID,dofi.SOURCE).innerHeight());}
BlurCurrent();summary.style.display='none';form.style.display='block';RedrawSVGJotter({CONTEXT:window,CONTAINER:source});if(!noscroll){var parentdx=jQuery(source).parents('.diagnosisblock');if(parentdx.length===1){ScrollToItem(parentdx[0],source,jQuery('#layout_content')[0],offset);}}
var icdtext=jQuery(EscapeJQuerySelector('#'+type+'_ICD'+(IsICD10(source)?'10':'9')+'_DESCRIPTION_'+id)).get(0);if(icdtext){icdtext.style.display='none';}
if(source&&source.style){Bright(source);source.style.cursor='';diagnosisordersfocusitem.onmouseover=source.onmouseover;diagnosisordersfocusitem.onmouseout=source.onmouseout;source.onmouseover=null;source.onmouseout=null;}
diagnosisordersfocusitem.TYPE=type;diagnosisordersfocusitem.ID=id;diagnosisordersfocusitem.SOURCE=source;var alldiagnosisorders=jQuery('#ALLDIAGNOSISORDERS').get(0);var diagnosisordering;if(type=='DIAGNOSIS'){RefreshDiagnosis(alldiagnosisorders,id);var jqdxblock=jQuery(source).closest('.diagnosisblock');var note=document.getElementsByName("ENCOUNTERDIAGNOSIS{"+id+"}{NOTE}")[0];if(note&&note.style.display!='none'){try{if(jqdxblock.data('focusicd10picker')!==true){note.focus();}else{setTimeout(function(){var pickerinput=jqdxblock.find('input.icd10pickerselectortext');if(pickerinput.length){pickerinput.get(0).focus();pickerinput[0].selectionEnd=pickerinput[0].selectionStart;}},400);jqdxblock.removeData();}}catch(e){}}
var func;if(typeof(func=jqdxblock.data('runfunctionfordxblock'))==='function'){jqdxblock.removeData('runfunctionfordxblock');func();}
diagnosisordering=id;}
else{var key=(type=='ORDER'?'EXISTING':'NEW');var orderdiv=jQuery(EscapeJQuerySelector('#ORDER{'+key+'}{'+id+'}{ORDERDIV}'));if(orderdiv){diagnosisordering=orderdiv.attr('diagnosisordering');var monographlinkjq=jQuery('#'+type+'_MONOGRAPH_'+id);var widget=MonographDialog.GetWidgetContainer(monographlinkjq.get(0));if(widget&&(typeof(widget.MonographValid)==='function')&&widget.MonographValid()){monographlinkjq.show();}
var epocrateswidget=EpocratesDrugMonographDialog.FindWidget(orderdiv.get(0));if(epocrateswidget&&isFunction(epocrateswidget.ShowAnchor)){epocrateswidget.ShowAnchor();}
jQuery('#'+type+'_OUTERWARNINGS_'+id).addClass("orderformbackgroundcolor");orderdiv.find('.orderwrap').addClass('orderheader');}}}
function FocusOrder(args){AssertFields(args,['ORDERDIV'],['NOSCROLL']);var jqorderdiv=jQuery(args.ORDERDIV);var ordertype=jqorderdiv.attr('documentid')?'ORDER':'NEWORDER';var orderid=jqorderdiv.attr('documentid')?jqorderdiv.attr('documentid'):jqorderdiv.attr('neworderid');return Focus(ordertype,orderid,args.ORDERDIV,args.NOSCROLL);}
function Blur(type,id,source){if(!source){return;}
var container=GetSectionContainerIfPossible(source);if(!container){diagnosisordersfocusitem=new Object();return;}
var summary=jQuery('#'+type+'_SUMMARY_'+id,source).get(0);if(!summary||summary.style.display!='none'){return;}
var form=jQuery('#'+type+'_FORM_'+id,source).get(0);if(!form){return;}
UpdateBlurredSummary(type,id,jQuery('#ALLDIAGNOSISORDERS').get(0));summary.style.display='';if(form.className.indexOf('orderform')!==-1){jQuery(form).slideUp();}else{form.style.display='none';}
var icdtext=jQuery(EscapeJQuerySelector('#'+type+'_ICD'+(IsICD10(source)?'10':'9')+'_DESCRIPTION_'+id)).get(0);if(icdtext){icdtext.style.display='';}
if(source&&source.style){UnBright(source);source.style.cursor='pointer';source.onmouseover=diagnosisordersfocusitem.onmouseover;source.onmouseout=diagnosisordersfocusitem.onmouseout;}
diagnosisordersfocusitem=new Object();var alldiagnosisorders=jQuery('#ALLDIAGNOSISORDERS').get(0);var diagnosisordering;if(type=='DIAGNOSIS'){RefreshDiagnosis(alldiagnosisorders,id);diagnosisordering=id;}else{var key=type=='ORDER'?'EXISTING':'NEW';var orderdiv=jQuery(EscapeJQuerySelector('div#ORDER{'+key+'}{'+id+'}{ORDERDIV}'),alldiagnosisorders);if(orderdiv){diagnosisordering=orderdiv.attr('diagnosisordering');var monographlinkjq=jQuery('#'+type+'_MONOGRAPH_'+id,orderdiv.get(0));monographlinkjq.hide();var epocrateswidget=EpocratesDrugMonographDialog.FindWidget(orderdiv.get(0));if(epocrateswidget&&isFunction(epocrateswidget.HideAnchor)){epocrateswidget.HideAnchor();}
var outerwarningsdiv=jQuery('div#'+type+'_OUTERWARNINGS_'+id,orderdiv.get(0));if(outerwarningsdiv){outerwarningsdiv.removeClass('orderformbackgroundcolor');}
orderdiv.find('.orderwrap').removeClass('orderheader');}}}
function BlurCurrent(){Blur(diagnosisordersfocusitem.TYPE,diagnosisordersfocusitem.ID,diagnosisordersfocusitem.SOURCE);Picker.CloseOpenedContent();}
function RefreshDiagnosis(alldiagnosisorders,id){var form=jQuery('table#DIAGNOSIS_FORM_'+id,alldiagnosisorders).get(0);if(!form){return;}
var orders=jQuery('span#DIAGNOSIS_ORDERS_'+id,alldiagnosisorders).get(0);if(!orders){return;}
var updatedisplayvalue=jQuery("[signed='1'][internal='0']",orders).length>0?'none':'';var deletedisplayvalue=jQuery(orders).children("[signed='1']").length>0?'none':'';var ordersetenhanceddiagnosesenabled=OrderSetEnhancedDiagnosesEnabled&&OrderSetEnhancedDiagnosesEnabled();var diagnosislinks="";if(ordersetenhanceddiagnosesenabled){diagnosislinks=jQuery('span.diagnosis-update-'+id,alldiagnosisorders);diagnosislinks.each(function(index,diagnosislink){if(diagnosislink&&diagnosislink.style){diagnosislink.style.display=(diagnosisordersfocusitem.TYPE=='DIAGNOSIS'&&diagnosisordersfocusitem.ID==id)?updatedisplayvalue:'none';}});var deleteimodisplayvalue='none';var imodiagnosis=jQuery('[name="ENCOUNTERDIAGNOSIS{'+id+'}{IMODIAGNOSIS}"]');var imodiagnosisvalue=imodiagnosis.length&&imodiagnosis.val();if(imodiagnosisvalue&&imodiagnosisvalue!=='undefined'){var parsedimodiagnosis=JSON.parse(imodiagnosisvalue);if(parsedimodiagnosis.length>1){deleteimodisplayvalue='';}}
deletediagnosislinks=jQuery('span.delete-order-set-diagnosis-picker',diagnosislinks);deletediagnosislinks.each(function(index,diagnosislink){if(diagnosislink&&diagnosislink.style){diagnosislink.style.display=(diagnosisordersfocusitem.TYPE=='DIAGNOSIS'&&diagnosisordersfocusitem.ID==id)?deleteimodisplayvalue:'none';}});}
if(!ordersetenhanceddiagnosesenabled||!diagnosislinks.length){var diagnosislink=jQuery('span#DIAGNOSIS_UPDATE_'+id,alldiagnosisorders).get(0);if(diagnosislink&&diagnosislink.style){diagnosislink.style.display=(diagnosisordersfocusitem.TYPE=='DIAGNOSIS'&&diagnosisordersfocusitem.ID==id)?updatedisplayvalue:'none';}}
var sectioncontainer=GetSectionContainer(alldiagnosisorders);var diagnosislinks=jQuery('a#DIAGNOSIS_DELETE_'+id,sectioncontainer).toArray();if(diagnosislinks){for(var i=0;i<diagnosislinks.length;i++){if(diagnosislinks[i].style){diagnosislinks[i].style.display=deletedisplayvalue;}}}}
function MoveDiagnosis(id,offset,startingobject){var sectionobj=GetSectionContainer(startingobject);var alldiagnosisorders=jQuery('#ALLDIAGNOSISORDERS').get(0);if(offset==0){return;}
var diagnosis=jQuery('div#DIAGNOSIS_'+id).get(0);var swapordering;if(diagnosis){var alldiagnoses=GetImmediateChildrenByAttribute(alldiagnosisorders,'name','DIAGNOSIS');if(jQuery(alldiagnoses[alldiagnoses.length-1]).hasClass("nodiagnosis")){alldiagnoses.pop();}
for(var i=0;i<alldiagnoses.length;i++){if(jQuery(alldiagnoses[i]).attr('diagnosisordering')==id){swapindex=i+offset;if(swapindex>=0&&swapindex<alldiagnoses.length){var swapdiagnosis=alldiagnoses[swapindex];swapordering=swapdiagnosis.diagnosisordering;swapNodes(diagnosis,swapdiagnosis);break;}}}}
var selecteddiagnosescontainer=jQuery("div[name='selecteddiagnoses']",sectionobj).get(0);var allselecteddiagnoses=jQuery("div[name='selecteddiagnosis']",selecteddiagnosescontainer).toArray();for(var i=0;i<allselecteddiagnoses.length;i++){if(jQuery(allselecteddiagnoses[i]).attr('ordering')==id){swapindex=i+offset;if(swapindex>=0&&swapindex<allselecteddiagnoses.length){var swapdiagnosis=allselecteddiagnoses[swapindex];if((!isDefined(swapordering)&&swapdiagnosis.style.display!='none')||swapordering==jQuery(swapdiagnosis).attr('ordering')){swapordering=jQuery(swapdiagnosis).attr('ordering');swapNodes(allselecteddiagnoses[i],swapdiagnosis);}
break;}}}
