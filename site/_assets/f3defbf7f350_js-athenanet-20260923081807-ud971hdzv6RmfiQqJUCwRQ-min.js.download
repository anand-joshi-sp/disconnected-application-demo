function ValidatePrescriptionQuantityUnitsField(valuefieldname,dropdownfieldname){var quantityunitvaluefield=jQuery("[name='"+valuefieldname+"']");var quantityunitdropdown=jQuery("[name='"+dropdownfieldname+"']");quantityunitvaluefield.value=quantityunitvaluefield.val();if(isArray(quantityunitvaluefield.value)){quantityunitvaluefield.value=quantityunitvaluefield.value[0];}
if(quantityunitdropdown.length&&quantityunitdropdown.eq(0).is(':visible')&&quantityunitdropdown[0].className!=='readonly'&&!ValidateField({FIELD:quantityunitvaluefield,DISPLAYMESSAGE:'Please specify the units for this quantity.',REQUIRED:true})){quantityunitdropdown.focus();return false;}
else if(quantityunitdropdown.length==0&&quantityunitvaluefield.attr('type')&&quantityunitvaluefield.attr('type').toLowerCase()=='text'&&!quantityunitvaluefield.attr('disabled')){if(!ValidateField({FIELD:quantityunitvaluefield,DISPLAYMESSAGE:'Please specify the units for this quantity.',REQUIRED:true})){quantityunitvaluefield.focus();return false;}
