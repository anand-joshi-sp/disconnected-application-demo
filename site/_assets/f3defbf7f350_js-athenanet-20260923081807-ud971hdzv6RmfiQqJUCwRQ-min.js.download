return true;}
function AddClinicalServiceModifier(addsprite,explodetoggle,value){EncounterDirty(GetSectionContainer(addsprite));var modifiertable=GetParent(addsprite,'tagName','table','name','modifiertable');var indexoflastrow=modifiertable.rows.length;var newrow=modifiertable.insertRow(indexoflastrow);var prevrow=modifiertable.rows[newrow.rowIndex-1];var prevvalue=GetChild(prevrow,'tagName','input','name',/\{VALUE\}/);var prevvaluename=prevvalue.getAttribute('name');if(prevvaluename.match(/(.*)\{(\d+)\}\{VALUE\}/)){var prefix=RegExp.$1;var oldindex=RegExp.$2;var newindex=parseInt(oldindex)+1;var oldprefix=prefix+'{'+oldindex+'}';oldprefix=new RegExp(EscapeRegExp(oldprefix),"g");var newprefix=prefix+'{'+newindex+'}';var oldhtml=prevrow.cells[0].innerHTML;newrow.insertCell(0).innerHTML=oldhtml.replace(oldprefix,newprefix);newrow.insertCell(1).innerHTML=" <span class='sprite-del-16x16 clinicalserviceicon' title='delete modifier' style='cursor:pointer; display:inline-block; vertical-align:baseline;' "+
" onclick='DeleteClinicalServiceModifier(this, "+!!explodetoggle+");'></span>"+
" <span class='sprite-add clinicalserviceicon' title='add modifier' style='cursor:pointer; display:inline-block; vertical-align:baseline;' "+
" onclick='AddClinicalServiceModifier(this, "+!!explodetoggle+", null);'></span>";var newvalue=GetChild(newrow,'tagName','input','name',/\{VALUE\}/);if(newvalue){newvalue.value=value||'';}
var prevadd=GetChild(prevrow,'tagName','span','className',/sprite-add/);if(prevadd){prevadd.style.visibility='hidden';}}}
function DeleteClinicalServiceModifier(deletesprite,explodetoggle){EncounterDirty(GetSectionContainer(deletesprite));var modifiertable=GetParent(deletesprite,'tagName','table','name','modifiertable');var lastrowindex=modifiertable.rows.length-1;var currentrow=GetParent(deletesprite,'tagName','tr');var currentrowindex=currentrow.rowIndex;var modifierinput=GetChild(currentrow,'tagName','input','name',/\{VALUE\}/);if(lastrowindex==currentrowindex){if(lastrowindex==0){if(modifierinput){modifierinput.value='';}
CheckDistinctProcedureCode(modifiertable);DisplayCodeName(modifiertable);if(explodetoggle){DisplayExplodingMessage(modifiertable);}
return;}
else{var prevrow=modifiertable.rows[lastrowindex-1];var prevadd=GetChild(prevrow,'tagName','span','className',/sprite-add/);if(prevadd){prevadd.style.visibility='visible';}}}
modifiertable.deleteRow(currentrowindex);CheckDistinctModifier(modifiertable);CheckDistinctProcedureCode(modifiertable);DisplayCodeName(modifiertable);if(explodetoggle){DisplayExplodingMessage(modifiertable);}}
function AddClinicalServiceDiagnosis(addsprite,dxvalue){var diagnosistable=GetParent(addsprite,'tagName','table','name','diagnosistable');var indexoflastrow=diagnosistable.rows.length;EncounterDirty(GetSectionContainer(addsprite));var newrow=diagnosistable.insertRow(indexoflastrow);var prevrow=diagnosistable.rows[newrow.rowIndex-1];var prevvalue=GetChild(prevrow,'tagName','input','name',/\{VALUE\}/);var prevvaluename=prevvalue.getAttribute('name');if(prevvaluename.match(/(.*)\{(\d+)\}\{VALUE\}/)){var prefix=RegExp.$1;var oldindex=RegExp.$2;var newindex=parseInt(oldindex)+1;var oldprefix=prefix+'{'+oldindex+'}';oldprefix=new RegExp(EscapeRegExp(oldprefix),"g");var newprefix=prefix+'{'+newindex+'}';var oldhtml=prevrow.cells[0].innerHTML;newrow.insertCell(0).innerHTML=oldhtml.replace(oldprefix,newprefix);newrow.insertCell(1).innerHTML=" <span class='sprite-del-16x16 clinicalserviceicon' title='delete diagnosis' style='cursor:pointer; display:inline-block; vertical-align:baseline;' "+
" onclick='DeleteClinicalServiceDiagnosis(this);'></span>"+
" <span class='sprite-add clinicalserviceicon' title='add diagnosis' style='cursor:pointer; display:inline-block; vertical-align:baseline;' "+
" onclick='AddClinicalServiceDiagnosis(this);'></span>";if(indexoflastrow>2){var newadd=GetChild(newrow,'tagName','span','className',/sprite-add/);if(newadd){newadd.style.visibility='hidden';}}
var newvalue=GetChild(newrow,'tagName','input','name',/\{VALUE\}/);if(newvalue){if(dxvalue){newvalue.value=dxvalue;}
else{newvalue.value='';}}
var prevadd=GetChild(prevrow,'tagName','span','className',/sprite-add/);if(prevadd){prevadd.style.visibility='hidden';}}}
function DeleteClinicalServiceDiagnosis(deletesprite){EncounterDirty(GetSectionContainer(deletesprite));var diagnosistable=GetParent(deletesprite,'tagName','table','name','diagnosistable');var lastrowindex=diagnosistable.rows.length-1;var currentrowindex=GetParent(deletesprite,'tagName','tr');currentrowindex=currentrowindex.rowIndex;if(currentrowindex==lastrowindex&&currentrowindex==0){var lastvalue=GetChild(diagnosistable,'tagName','input','type','text','name',/\{VALUE\}/);if(lastvalue){lastvalue.value='';CheckClinicalProcedureCodeBillable(lastvalue);}
return;}
diagnosistable.deleteRow(currentrowindex);lastrowindex=diagnosistable.rows.length-1;var lastrowadd=GetChild(diagnosistable.rows[lastrowindex],'tagName','span','className',/sprite-add/);if(lastrowadd){lastrowadd.style.visibility='visible';}
CheckDistinctDiagnosis(diagnosistable);CheckClinicalProcedureCodeBillable(diagnosistable);}
function PropagateClinicalServiceDiagnosis(form,args){AssertFields(args,['PATIENTID','CHARTID','CLINICALENCOUNTERID','ENCOUNTERDATE'],['SERVICETYPE']);CallRemote({SUB:'Clinical::Encounter::Section::EBillingSlip::PropagateClinicalServiceDiagnosis',ARGS:{PATIENTID:args.PATIENTID,CHARTID:args.CHARTID,CLINICALENCOUNTERID:args.CLINICALENCOUNTERID,ENCOUNTERDATE:args.ENCOUNTERDATE},LOADINGINDICATORFLAG:true,ONFINISH:function(diagnoses){var sectioncontainer=GetSectionContainer(form);var diagnosistables=[];if(args.SERVICETYPE){var servicetable=jQuery(sectioncontainer).find('tr[servicetype^='+args.SERVICETYPE+']').next();while(servicetable.length&&(servicetable.prop("id").indexOf("header")==-1)){var table=jQuery(servicetable).find('table[name="diagnosistable"]').get(0);if(table){diagnosistables.push(table);}
servicetable=servicetable.next();}}
else{diagnosistables=jQuery(sectioncontainer).find('table[name="diagnosistable"]').get();}
var diagnoseshold=[];for(var m=0;m<diagnoses.length;m++){diagnoseshold.push(diagnoses[m]);}
for(var i=0;i<diagnosistables.length;i++){diagnoses=[];for(var m=0;m<diagnoseshold.length;m++){diagnoses.push(diagnoseshold[m]);}
var rows=jQuery(diagnosistables[i]).find('tr');var k=0;var diagcount=0;if(rows.length>=1){for(k=0;k<rows.length;k++){var l;for(l=0;l<diagnoses.length;l++){if(jQuery(rows[k]).find('input[type=text]').val()==diagnoses[l]){diagnoses[l]=-1;}}
if(jQuery(rows[k]).find('input[type=text]').val()==''&&diagnoses[diagcount]!=-1){jQuery(rows[k]).find('input[type=text]').val(diagnoses[diagcount]);diagcount++;}}}
var added=0;for(var j=diagcount;j<diagnoses.length;j++){if(diagnoses[j]!=-1&&(rows.length+added<4)){var value=jQuery(diagnosistables[i]).find('input[type=text]').val();var sprite=jQuery(diagnosistables[i]).find('span.clinicalserviceicon').get(0);AddClinicalServiceDiagnosis(sprite,diagnoses[j]);added++;}}
CheckClinicalProcedureCodeBillable(diagnosistables[i]);}}});return;}
function CheckDistinctModifier(changedelement){var clinicalprocedure=GetParent(changedelement,'tagName','tr','name','clinicalprocedurerow');var servicetable=GetParent(clinicalprocedure,'tagName','table','id','servicetable');var procedureprefix=clinicalprocedure.id;var othermodifiers=new RegExp(EscapeRegExp(procedureprefix+'{MODIFIER}'));var modifierlist=GetChildren(servicetable,'tagName','input','type','text','name',othermodifiers);var modifiervalues=[];for(var i=0;i<modifierlist.length;i++){modifiervalues.push(modifierlist[i].value);}
_CheckDistinctBillingInput(changedelement,'Modifier',modifiervalues);}
function CheckDistinctDiagnosis(changedelement){var clinicalprocedure=GetParent(changedelement,'tagName','tr','name','clinicalprocedurerow');var servicetable=GetParent(clinicalprocedure,'tagName','table','id','servicetable');var procedureprefix=clinicalprocedure.id;var otherdxs=new RegExp(EscapeRegExp(procedureprefix+'{DIAGNOSIS}'));var dxlist=GetChildren(servicetable,'tagName','input','type','text','name',otherdxs);var dxvalues=[];for(var i=0;i<dxlist.length;i++){dxvalues.push(dxlist[i].value);}
_CheckDistinctBillingInput(changedelement,'Diagnosis',dxvalues);}
function CheckDistinctProcedureCode(changedelement){var servicetable=GetParent(changedelement,'tagName','table','id','servicetable');var procedurerow=GetParent(changedelement,'tagName','tr','name','clinicalprocedurerow');var newmatches=/(.*)\{PROCEDURECODE\}/.exec(procedurerow.id);var serviceprefix=newmatches[1];var allprocedurecoderows=new RegExp(EscapeRegExp(serviceprefix)+'\\{PROCEDURECODE\\}');var procedurerowlist=GetChildren(servicetable,'tagName','tr','name','clinicalprocedurerow','id',allprocedurecoderows);var fullprocedurecodevalues={};var duplicatevalues={};for(var i=0;i<procedurerowlist.length;i++){var codeinfo=_FullProcedureCode(procedurerowlist[i],1);if(codeinfo[0].charAt(0)!=''){if(fullprocedurecodevalues[codeinfo[0]]){duplicatevalues[codeinfo[0]]=1;}
else{fullprocedurecodevalues[codeinfo[0]]=1;}}}
for(var i=0;i<procedurerowlist.length;i++){var codeinfo=_FullProcedureCode(procedurerowlist[i],1);DeleteServiceWarning(procedurerowlist[i],'DUPLICATEPROCEDURECODE');if(duplicatevalues[codeinfo[0]]){AddServiceWarning(procedurerowlist[i],'DUPLICATEPROCEDURECODE','Duplicate procedure code ('+codeinfo[0]+')',1);}}}
function _CheckDistinctBillingInput(changedelement,type,allinputvalues){var servicetable=GetParent(changedelement,'tagName','table','id','servicetable');var clinicalprocedure=GetParent(changedelement,'tagName','tr','name','clinicalprocedurerow');var values={};for(var i=0;i<allinputvalues.length;i++){if(values[allinputvalues[i]]){AddServiceWarning(clinicalprocedure,'DUPLICATE'+type.toUpperCase(),'Duplicate '+type,(type!='Diagnosis'));return;}
if(allinputvalues[i]!=''){values[allinputvalues[i]]=1;}}
DeleteServiceWarning(clinicalprocedure,'DUPLICATE'+type.toUpperCase());}
function _FullProcedureCode(procedurecoderow,sort){var completecode='';var procedureprefix=procedurecoderow.id;var procedurecodeinput=GetChild(procedurecoderow,'tagName','input','name',procedureprefix+'{VALUE}');var modifiervalueregex=new RegExp(EscapeRegExp(procedureprefix)+'\\{MODIFIER\\}\\{\\d+\\}\\{VALUE\\}');var modifierinputs=GetChildren(procedurecoderow,'tagName','input','name',modifiervalueregex);var procedurecodevalue=procedurecodeinput.value;var completecode=procedurecodevalue;var modifiervalues=[];for(var i=0;i<modifierinputs.length;i++){if(modifierinputs[i].value){modifiervalues.push(modifierinputs[i].value);}}
if(sort){modifiervalues=modifiervalues.sort();}
for(var i=0;i<modifiervalues.length;i++){completecode+=','+modifiervalues[i];}
return[completecode,procedurecodevalue,modifiervalues];}
function _CheckInvalidCompletion(changedelement){if(!changedelement){return false;}
if(changedelement.value==''){return false;}
if(!changedelement.autocompleteobj){var previouselementinfocus=document.activeElement;changedelement.onfocus();if(previouselementinfocus&&typeof previouselementinfocus.onfocus=="function"){previouselementinfocus.onfocus();}
if(!changedelement.autocompleteobj||!changedelement.autocompleteobj.completions){return false;}}
var completions=changedelement.autocompleteobj.completions;var valueregex=/^(\S+)\s.*$/;for(var i=0;i<completions.length;i++){var matches=valueregex.exec(completions[i]);if(matches){var completionvalue=matches[1];completionvalue=completionvalue.replace(/\./,"");if(completionvalue==changedelement.value){return false;}}}
return true;}
function CheckClinicalProcedureCodeBillable(changedelement){var clinicalprocedure=GetParent(changedelement,'tagName','tr','name','clinicalprocedurerow');if(!clinicalprocedure){return;}
var procedureprefix=clinicalprocedure.id;var procedurecodename=procedureprefix+'{VALUE}';var dxprefix=new RegExp(EscapeRegExp(procedureprefix+'{DIAGNOSIS}'));var modprefix=new RegExp(EscapeRegExp(procedureprefix+'{MODIFIER}'));var unitsprefix=new RegExp(EscapeRegExp(procedureprefix+'{UNITS}'));var billablename=procedureprefix+'{BILLFORSERVICEYN}';var procedurecodetext=GetChild(clinicalprocedure,'name',procedurecodename);var diagnosislist=GetChildren(clinicalprocedure,'tagName','input','type','text','name',dxprefix);var modifierlist=GetChildren(clinicalprocedure,'tagName','input','type','text','name',modprefix);var units=GetChild(clinicalprocedure,'name',unitsprefix);var billableyn=GetChild(clinicalprocedure,'name','checkbox_yesno_'+billablename);procedurecodehasvalue=procedurecodetext.value;DeleteServiceWarning(clinicalprocedure,'NOPROCEDURECODE');DeleteServiceWarning(clinicalprocedure,'UNKNOWNPROCEDURECODE');DeleteServiceWarning(clinicalprocedure,'UNKNOWNMODIFIER');DeleteServiceWarning(clinicalprocedure,'NODIAGNOSIS');DeleteServiceWarning(clinicalprocedure,'UNKNOWNDIAGNOSIS');DeleteServiceWarning(clinicalprocedure,'UNDOCUMENTEDDIAGNOSIS');DeleteServiceWarning(clinicalprocedure,'ZEROUNITS');if(!procedurecodehasvalue){AddServiceWarning(clinicalprocedure,'NOPROCEDURECODE','Missing Procedure Code');}
else{var descriptionelement=GetChild(clinicalprocedure,'name','codedescription');if(!descriptionelement||descriptionelement.getAttribute('foundcode')==0){AddServiceWarning(clinicalprocedure,'UNKNOWNPROCEDURECODE','Unknown Procedure Code');}}
var invalidmodifier;for(var i=0;i<modifierlist.length;i++){invalidmodifier=invalidmodifier||_CheckInvalidCompletion(modifierlist[i]);}
if(invalidmodifier){AddServiceWarning(clinicalprocedure,'UNKNOWNMODIFIER','Unknown Modifier (Non Fee-Affecting)');}
if(units.value!==''&&units.value==0){AddServiceWarning(clinicalprocedure,'ZEROUNITS','Unit must be higher than 0 to mark as billable');}
var diagnosishasvalue;var invaliddiagnoses=[];for(var i=0;i<diagnosislist.length;i++){diagnosishasvalue=diagnosishasvalue||diagnosislist[i].value;if(_CheckInvalidCompletion(diagnosislist[i])){invaliddiagnoses.push(diagnosislist[i].value);}}
if(!diagnosishasvalue){AddServiceWarning(clinicalprocedure,'NODIAGNOSIS','Missing Diagnosis');}
else if(invaliddiagnoses.length>0){var useicd10=jQuery('input:hidden[name="USEICD10"]').val();var encounterdate=jQuery('input:hidden[name="ENCOUNTERDATE"]').val();CallRemote({SUB:'Clinical::Encounter::Section::EBillingSlip::ValidDiagnosisCodes',ARGS:{DIAGNOSISCODES:invaliddiagnoses,USEICD10:useicd10,DATEOFSERVICE:encounterdate},ONFINISH:function(validcodes){DeleteServiceWarning(clinicalprocedure,'UNDOCUMENTEDDIAGNOSIS');DeleteServiceWarning(clinicalprocedure,'UNKNOWNDIAGNOSIS');if(validcodes){for(var i=0;i<invaliddiagnoses.length;i++){var valid=0;for(var j=0;j<validcodes.length;j++){if(invaliddiagnoses[i]==validcodes[j]){AddServiceWarning(clinicalprocedure,'UNDOCUMENTEDDIAGNOSIS','Undocumented Diagnosis ('+validcodes[j]+')',1);valid=1;break;}}
if(!valid){AddServiceWarning(clinicalprocedure,'UNKNOWNDIAGNOSIS','Invalid Diagnosis ('+invaliddiagnoses[i]+')');}}}
DetermineBillableCheckboxState(billableyn,clinicalprocedure);}});}
DetermineBillableCheckboxState(billableyn,clinicalprocedure);}
function DetermineBillableCheckboxState(billableyn,clinicalprocedure){var cptiiheaderrow=jQuery.find("tr[servicetype*='CPTII']");if(cptiiheaderrow.length>0){if(CheckIfRowIsCPTII(cptiiheaderrow,clinicalprocedure)){billableyn.disabled=false;billableyn.onchange();return;}}
var procedureprefix=clinicalprocedure.id;if(_HaveServiceWarnings(procedureprefix)){billableyn.checked=false;billableyn.disabled=true;}
else{if(billableyn.disabled){billableyn.checked=true;}
billableyn.disabled=false;}
billableyn.onchange();}
function _HaveServiceWarnings(procedureprefix){var warningrow=document.getElementById(procedureprefix+'{WARNING}');var warningdivs=GetChildren(warningrow,'tagName','div','className','clinicalservicewarningitem');if(!warningdivs||warningdivs.length==0){return false;}
for(var i=0;i<warningdivs.length;i++){if(!warningdivs[i].innerHTML.match('alert-unknown')){return true;}}
return false;}
function DisplayNDC(changedelement,aid,eid){var clinicalprocedure=GetParent(changedelement,'tagName','tr','name','clinicalprocedurerow');var procedureprefix=clinicalprocedure.id;var procedurecodeinput=GetChild(clinicalprocedure,'tagName','input','name',procedureprefix+'{VALUE}');var procedurecodecell=GetParent(procedurecodeinput,'tagName','td');var descriptioncell=clinicalprocedure.cells[procedurecodecell.cellIndex+1];var appointmentid=aid;var clinicalencounterid=eid||window.encounterid;var procedurecodeinfo=_FullProcedureCode(clinicalprocedure);var completecode=procedurecodeinfo[0];var procedurecodevalue=procedurecodeinfo[1];if(completecode){CallRemote({SUB:'Clinical::Encounter::Section::EBillingSlip::NDCRecord',ARGS:{CODE:procedurecodevalue,AID:appointmentid,CID:clinicalencounterid},ONFINISH:function(obj){if(obj){AddElement(descriptioncell,'beforeEnd','div');var ndcmessagerow=GetChild(descriptioncell,'tagName','div');var info=obj.INFO;SetInnerHTML(ndcmessagerow,info);}}});}
return;}
function DisplayCodeName(changedelement){var clinicalprocedure=GetParent(changedelement,'tagName','tr','name','clinicalprocedurerow');var procedureprefix=clinicalprocedure.id;var procedurecodeinput=GetChild(clinicalprocedure,'tagName','input','name',procedureprefix+'{VALUE}');var procedurecodecell=GetParent(procedurecodeinput,'tagName','td');var descriptioncell=clinicalprocedure.cells[procedurecodecell.cellIndex+1];var procedurecodeinfo=_FullProcedureCode(clinicalprocedure);var completecode=procedurecodeinfo[0];var procedurecodevalue=procedurecodeinfo[1];var modifiervalues=procedurecodeinfo[2];var orderspan=GetChild(clinicalprocedure,'tagName','span','name','orderlink');var orderspanhtml=' ';if(orderspan){orderspanhtml=orderspan.outerHTML;}
if(procedurecodevalue){var descriptionelement=GetChild(descriptioncell,'name','codedescription');if(descriptionelement&&descriptionelement.getAttribute('code')==completecode){return;}
CallRemote({SUB:'FeeSchedule::GetCodeLink',ARGS:{CODE:procedurecodevalue,MODIFIERS:modifiervalues,USEICON:'sprite-info-16x16'},ONFINISH:function(obj){if(obj){var descriptionhtml=obj.LINKHTML;if(orderspan){descriptionhtml+='<br>'+orderspanhtml;}
var newprocedurecodeinput=GetChild(clinicalprocedure,'tagName','input','name',procedureprefix+'{VALUE}');if(newprocedurecodeinput&&newprocedurecodeinput.value!=procedurecodevalue){return;}
SetInnerHTML(descriptioncell,descriptionhtml);CheckClinicalProcedureCodeBillable(changedelement);}}});}
else{SetInnerHTML(descriptioncell,orderspanhtml);CheckClinicalProcedureCodeBillable(changedelement);}}
function DisplayExplodingMessage(changedelement){var clinicalprocedure=GetParent(changedelement,'tagName','tr','name','clinicalprocedurerow');var procedureprefix=clinicalprocedure.id;var procedurecodeinfo=_FullProcedureCode(clinicalprocedure);var completecode=procedurecodeinfo[0];var servicetablebody=GetParent(clinicalprocedure,'tagName','tbody','id','servicetablebody');var messagerow=GetChild(servicetablebody,'tagName','tr','id',procedureprefix+'{EXPLODEMESSAGE}');var messagedata=GetChild(messagerow,'tagName','td');var encounterid=window.encounterid;var supervisingproviderid;try{if(document.getElementById("SupervisingProvider").value!=' '){supervisingproviderid=document.getElementById("SupervisingProvider").value;}}
catch(e){}
if(completecode){CallRemote({SUB:'Clinical::Encounter::Section::EBillingSlip::ExplodingCodeHTML',ARGS:{CODE:completecode,CLINICALENCOUNTERID:encounterid,SUPERVISINGPROVIDERID:supervisingproviderid},ONFINISH:function(returnedvalue){var explodinghtml=' ';if(returnedvalue){explodinghtml=returnedvalue;SetInnerHTML(messagedata,explodinghtml);}
else{SetInnerHTML(messagedata,explodinghtml);}}});}
else{SetInnerHTML(messagedata,' ');}}
function ShowHideClinicalServiceHeader(serviceheaderrow,servicetable){if(!servicetable){servicetable=GetParent(serviceheaderrow,'tagName','table','id','servicetable');}
var serviceheaderrowid=serviceheaderrow.rowIndex;nextrow=servicetable.rows[serviceheaderrowid+1];if(nextrow&&nextrow.id.match(/^SERVICE/)&&!nextrow.id.match(/\{TEMPLATE\}/)){jQuery(serviceheaderrow).show();}
else{jQuery(serviceheaderrow).hide();}}
var uniqueserviceid=0;function AddClinicalService(addserviceelement,ndctoggle){EncounterDirty(GetSectionContainer(addserviceelement));var addservicetable=GetParent(addserviceelement,'id','addservicetable');var servicecptinput;if(addserviceelement.getAttribute('name')=='ADDSERVICECODE'){var keycode=window.event.keyCode||window.event.charCode;if(keycode!=13){return;}
servicecptinput=addserviceelement;}
else{servicecptinput=GetChild(addservicetable,'tagName','input','name','ADDSERVICECODE');}
if(!servicecptinput.value){alert('Please enter the procedure code you would like to add.');return;}
servicecptinput.value=servicecptinput.value.toUpperCase();CallRemote({SUB:'Clinical::ProcedureCodeMappings::GetProcedureCodeOrderTypeGroup',ARGS:{PROCEDURECODE:servicecptinput.value},ONFINISH:function(servicetype){if(servicetype=='MISC'){var checkboxobj=GetChild(addservicetable,'tagName','input','type','checkbox','code',servicecptinput.value);if(!checkboxobj.checked){checkboxobj.click();}
else{alert('Already added that service.');}}
else{_AddClinicalService(servicetype,servicecptinput.value,'',ndctoggle);}
servicecptinput.value='';}});}
function _AddClinicalService(servicetype,procedurecode,callback,ndctoggle){GetServiceTemplateRow(window.clinicalencounterid,servicetype,function(servicetemplate,proceduretemplate){var servicetable=document.getElementById('servicetable');var serviceheaderrow=document.getElementById(servicetype+'_header');jQuery(serviceheaderrow).find('div').show();var servicerow;var previousprocedurerow=undefined;if(servicetype!='EMCODE'){servicerow=servicetable.insertRow(serviceheaderrow.rowIndex+1);uniqueserviceid++;var newprefix='SERVICE{MANUAL}{'+uniqueserviceid+'}';var oldprefix=servicetemplate.id;oldprefix=new RegExp(EscapeRegExp(oldprefix),"g");servicerow.id=newprefix;servicerow.setAttribute('name',servicetemplate.getAttribute('name'));servicerow.setAttribute('servicetype',servicetype);for(var i=0;i<servicetemplate.cells.length;i++){var cellcopy=servicetemplate.cells[i].cloneNode(true);servicerow.appendChild(cellcopy);servicerow.cells[i].innerHTML=servicerow.cells[i].innerHTML.replace(oldprefix,newprefix);}}
else{servicerow=GetChild(servicetable,'tagName','tr','name','clinicalservicerow','servicetype','EMCODE');previousprocedurerow=GetProcedureRow(servicerow.id,-1);var addsprite=GetChild(previousprocedurerow,'tagName','span','className',/sprite-add/,'title',/add procedure/);if(addsprite){addsprite.style.visibility='hidden';}}
var newprocedurerow=_AddClinicalServiceProcedureCode(servicetable,servicetype,servicerow,previousprocedurerow,procedurecode,proceduretemplate,ndctoggle,undefined,undefined,undefined);jQuery(servicerow).show();ShowHideClinicalServiceHeader(serviceheaderrow,servicetable);if(isFunction(callback)){callback.apply(servicetable,[]);}});}
function DeleteClinicalService(servicerowchild,explodetoggle){EncounterDirty(GetSectionContainer(servicerowchild));var servicerow=GetParent(servicerowchild,'tagName','tr','name','clinicalservicerow');var servicetable=document.getElementById('servicetable');var servicetypeinput=GetChild(servicerow,'tagName','input','name',/TYPE/);var servicetype=servicetypeinput.value;var servicerowid=servicerow.id;if(servicerowid.match(/SERVICE\{EXISTING\}\{(\d+)\}/)){var serviceid=RegExp.$1;var deletedinput=document.createElement('input');deletedinput.setAttribute('name','SERVICE{DELETED}{'+serviceid+'}');deletedinput.id='SERVICE{DELETED}{'+serviceid+'}';deletedinput.type='hidden';servicetable.appendChild(deletedinput);}
var procedurerowregexp=new RegExp(EscapeRegExp(servicerowid+'{PROCEDURECODE}'));var procedurerows=GetChildren(servicetable,'tagName','tr','name','clinicalprocedurerow','id',procedurerowregexp);for(var i=procedurerows.length-1;i>=0;i--){_DeleteClinicalServiceProcedureCode(procedurerows[i],0,explodetoggle);}
servicetable.deleteRow(servicerow.rowIndex);var serviceheaderrow=document.getElementById(servicetype+'_header');ShowHideClinicalServiceHeader(serviceheaderrow,servicetable);}
function GetServiceTemplateRow(clinicalencounterid,servicetype,onfinish){window.servicetemplaterows=window.servicetemplaterows||{};var templatehtml=window.servicetemplaterows[servicetype];if(templatehtml){onfinish.apply(document,_GetServiceTemplateRows(templatehtml,servicetype));}
else{CallRemote({SUB:'Clinical::Encounter::Section::EBillingSlip::GetServiceTemplateRow',ARGS:{CLINICALENCOUNTERID:encounterid,SERVICETYPE:servicetype,DEPARTMENTID:AH&&AH.GetGlobal('DEPARTMENTID')},ONFINISH:function(html){window.servicetemplaterows=window.servicetemplaterows||{};window.servicetemplaterows[servicetype]=html;var templaterows=_GetServiceTemplateRows(html,servicetype);if(templaterows[0]&&templaterows[1]){onfinish.apply(document,templaterows);}
else{window.servicetemplaterows[servicetype]='';throw new Error('Unable to find template row in HTML returned from GetServiceTemplateRow:'+html);}}});}}
function _GetServiceTemplateRows(html,servicetype){var div=document.createElement('div');div.innerHTML="<table>"+html+"</table>";var servicetemplaterow=GetChild(div,'tagName','tr','id','SERVICE{TEMPLATE}{'+servicetype+'}');var proceduretemplaterow=GetChild(div,'tagName','tr','name',/clinicalprocedurerow/,'id',new RegExp(EscapeRegExp('SERVICE{TEMPLATE}{'+servicetype+'}')));return[servicetemplaterow,proceduretemplaterow];}
