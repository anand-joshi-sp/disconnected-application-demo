indexofaddedrow+"}{SURGERYDATE}','PATIENTSURGICALHISTORY{_"+indexofaddedrow+"}{SURGERYDATEMASK}',this);>"+"<a style='cursor:pointer' "+
"onclick='PickDate(this.parentElement.children[0])'><span class='sprite-cal' style='cursor:pointer' border=0></span></a><input type='hidden' "+
