function SetInnerHTMLNoStyles(element,html){if(element){element.innerHTML=html;var iframeobj=element.document||element.ownerDocument;if(iframeobj)iframeobj=iframeobj.parentWindow||iframeobj.defaultView;EvaluateScriptTags(html,{'withobj':iframeobj});RunInitJS(element);}}
function InsertAdjacentHTML(element,location,html){element.insertAdjacentHTML(location,html);var iframeobj=element.document||element.ownerDocument;if(iframeobj)iframeobj=iframeobj.parentWindow||iframeobj.defaultView;FixInnerHTML(html,{'evalargs':{'withobj':iframeobj},element:element});}
function FixInnerHTML(html,args){if(args&&args.evalargs)EvaluateScriptTags(html,args.evalargs);else EvaluateScriptTags(html);AddStyleSheets(html,args);}
function AddStyleSheets(html,args){var stylepattern=/<style[^>]*>([\s\S]*?)<\/style>/gi;while((match=stylepattern.exec(html))!=null){var styletag=document.createElement("style");styletag.setAttribute("type","text/css");if(jQuery.browser.msie){styletag.styleSheet.cssText=match[1];}
else{var styleText=document.createTextNode(match[1]);styletag.appendChild(styleText);}
(args.element||document.body).appendChild(styletag);}}
function ReduceHiddenPageHeader(maxwidth){var pageheader=jQuery('div.pageheader');if(pageheader.length===1){var headerclone=pageheader.clone();headerclone.removeClass('printonly');var organization=jQuery('div.organization',headerclone);if(organization.length===1){var spanhtml='<span style="white-space:nowrap"></span>';organization.wrapInner(spanhtml);var textspan=organization.children('span');jQuery('body').append(headerclone);if(textspan.width()>maxwidth){var fontsize=parseInt(textspan.css('font-size'));while(textspan.width()>maxwidth&&fontsize>4){var fontsize=parseInt(textspan.css('font-size'));fontsize--;textspan.css('font-size',fontsize);}
jQuery('div.organization',pageheader).css('font-size',fontsize);}
headerclone.remove();}}}
function FixAllImagesForPrint(args){AssertFields(args,['OBJECT'],['DOCUMENTCLASS','FORSCREEN','CHARTATTACHMENTS','DOCUMENTVIEWPRINTFROMHIDDEN','ONLYSCANPAGES','ENCOUNTERPAGESIZE']);jQuery("img",args.OBJECT.document).each(function(index,image){FixImageForPrint({ELEMENT:image,DOCUMENTCLASS:args.DOCUMENTCLASS,FORSCREEN:args.FORSCREEN,CHARTATTACHMENTS:args.CHARTATTACHMENTS,DOCUMENTVIEWPRINTFROMHIDDEN:args.DOCUMENTVIEWPRINTFROMHIDDEN,ONLYSCANPAGES:args.ONLYSCANPAGES,ENCOUNTERPAGESIZE:args.ENCOUNTERPAGESIZE});});if(AH){AH.SetGlobal('FIXALLIMAGESFORPRINTARGS',args);}}
function FixImageForPrint(args){AssertFields(args,['ELEMENT'],['DOCUMENTCLASS','FORSCREEN','CHARTATTACHMENTS','DOCUMENTVIEWPRINTFROMHIDDEN','ONLYSCANPAGES','ENCOUNTERPAGESIZE']);var MAXIMAGEPRINTWIDTH;var MAXIMAGEPRINTHEIGHT;if(args.ONLYSCANPAGES){MAXIMAGEPRINTWIDTH=768;MAXIMAGEPRINTHEIGHT=1008;}
else{MAXIMAGEPRINTWIDTH=720;switch(args.DOCUMENTCLASS){case'PATIENTRECORD':MAXIMAGEPRINTHEIGHT=938;break;case'LETTER':MAXIMAGEPRINTHEIGHT=965;break;default:MAXIMAGEPRINTHEIGHT=1000;}
if(args.CHARTATTACHMENTS){MAXIMAGEPRINTHEIGHT=938;}
if(args.DOCUMENTVIEWPRINTFROMHIDDEN||args.ENCOUNTERPAGESIZE){MAXIMAGEPRINTHEIGHT=890;}}
var element=args.ELEMENT;var imagewidth=element.width;var imageheight=element.height;if(imagewidth>MAXIMAGEPRINTWIDTH&&imageheight>MAXIMAGEPRINTHEIGHT&&element.naturalWidth>0&&element.naturalHeight>0){imagewidth=element.naturalWidth;imageheight=element.naturalHeight;}
element['-origwidth']=imagewidth;element['-origheight']=imageheight;var rotating=false;if(imagewidth>MAXIMAGEPRINTWIDTH){element.style.msInterpolationMode='bicubic';if(!args.FORSCREEN&&imagewidth>imageheight&&InList(element.className,["scanpage","upload"])){element.style.filter='progid:DXImageTransform.Microsoft.BasicImage(rotation=1)';rotating=true;if(imageheight>MAXIMAGEPRINTWIDTH){element.style.height=MAXIMAGEPRINTWIDTH+'px';}}
else{element.style.width=MAXIMAGEPRINTWIDTH+'px';}}
if(rotating){if(imagewidth>MAXIMAGEPRINTHEIGHT){element.style.width=MAXIMAGEPRINTHEIGHT+'px';}}
else{if(imageheight>MAXIMAGEPRINTHEIGHT){element.style.height=MAXIMAGEPRINTHEIGHT+'px';}}}
function RestoreAllImagesAfterPrint(obj){var images=GetChildren(obj.document||obj.ownerDocument,"tagName","img");for(var i=0;i<images.length;i++){var element=images[i];if(element.style.removeAttribute){element.style.removeAttribute('filter');}
if(element['-origwidth']){element.style.width=element['-origwidth']+'px';element['-origwidth']=null;}
if(element['-origheight']){element.style.height=element['-origheight']+'px';element['-origheight']=null;}}}
function ClearAutoCompleteName(fieldname){var container;if(event&&event.srcElement){container=GetSectionContainer(event.srcElement);}
if(!container){container=document;}
jqcontainer=jQuery(container);escapedfieldname=EscapeJQuerySelector(fieldname);jqcontainer.find('[name='+escapedfieldname+']').val('').trigger('change');jqcontainer.find('#'+escapedfieldname+'_NAME,[name='+escapedfieldname+'_NAME]').html('');}
function ToggleAddResultInfoBoxField(newordertypepicker){jQuery("[id*='addresultinfobox_row']").each(function(){var addresultinfoboxfield=jQuery(this);if(addresultinfoboxfield){var clinicalordertypename;if(newordertypepicker){clinicalordertypename=addresultinfoboxfield.prev('div').children('.select-body').children('span').text();}
else{clinicalordertypename=addresultinfoboxfield.closest('td').children('span').text();}
if(clinicalordertypename){addresultinfoboxfield.show();}
else{addresultinfoboxfield.hide();}}});return;}
function ClearAutoCompleteHiddenValues(name){if(name=='PROVIDERANDORDERTYPEID'){document.zform.CLINICALORDERTYPEID.value='';document.zform.CLINICALPROVIDERORDERTYPEID.value='';}else if(name=='ADDNEWLABCLINICALORDERTYPEID'){document.zform.ADDNEWCLINICALORDERTYPEID.value='';document.zform.ADDNEWCLINICALPROVIDERORDERTYPEID.value='';}}
function MaybeRestoreUnknownClinicalOrderType(jqhiddenfield,unknownordertypeid){if(!jqhiddenfield.val()){jqhiddenfield.val(unknownordertypeid);var jqnamespan=jQuery('#'+jqhiddenfield.attr('name')+'_NAME');jqnamespan.html('UNKNOWN');}}
function CheckAllergyAlreadyActive(checkbox,allergyid,rowid){if(!checkbox.checked){var container=GetSectionContainer(checkbox);var allrows=GetChildren(container,'tagName','tr');var regexstring='PATIENTALLERGY_ALLERGYID_'+allergyid;for(var i=0;i<allrows.length;i++){if(allrows[i].id&&allrows[i].id.match(regexstring)){var deactivatecheckbox=GetChild(allrows[i],'tagName','input','type','checkbox');if(deactivatecheckbox.name==('PATIENTALLERGY_DEACTIVATEDDATE_'+rowid)){continue;}
if(!deactivatecheckbox.checked){var allergyname=jQuery('.activeallergy',allrows[i]).text();alert('Patient already has allergy '+allergyname+' active.');return false;}}}}
return true;}
function CheckIfMedsExist(nomedscheckbox,nowarn){var table=document.getElementById('PATIENTMEDICATIONCART');var allrows=jQuery(table).find('tr').toArray();for(var i=0;i<allrows.length;i++){if(allrows[i].id&&allrows[i].id.match(/CLINICALPRESCRIPTION_ROW_\d+|PATIENTMEDICATION_ROW_\d+|{NEW}MEDICATION\d+/)){var rowjq=jQuery(allrows[i]);var isnew=allrows[i].id.match(/{NEW}MEDICATION\d+/);var hidecheckbox=rowjq.find('#'+EscapeJQuerySelector("{EXISTING}"+allrows[i].id.replace('ROW','HIDE'))).get(0);if(isnew||(hidecheckbox&&!hidecheckbox.checked)){var stopdatetextbox=rowjq.find("[name='"+EscapeJQuerySelector("{EXISTING}"+allrows[i].id.replace('ROW','STOPDATE'))+"']").get(0);var datediff=-1;if(stopdatetextbox&&stopdatetextbox.value){var dt=new Date();var today_date=(dt.getMonth()+1)+'/'+dt.getDate()+'/'+dt.getFullYear();datediff=DateDiff(stopdatetextbox.value,today_date);}
if(datediff<0){if(!nowarn){alert("Note: you have indicated no medications reported, though medications have been entered");}
nomedscheckbox.checked=false;return;}}}}}
function FormatNumber(obj,length,stripleadingzeros){var input;var fieldvalue;var decimalplaces;var replaceregex;if(event&&IsNavigationKey(event.keyCode)){return false;}
input=isDefined(obj)?obj:event.srcElement;fieldvalue=input.value||'';fieldvalue=fieldvalue.toString();fieldvalue=fieldvalue.replace(/\s/g,'');fieldvalue=fieldvalue.replace(/[^0-9\.]/g,'');fieldvalue=fieldvalue.replace(/^0+(?!\.|$)/,'')
if(stripleadingzeros){fieldvalue=fieldvalue.replace(/^0+/,'');}
if(length===0){fieldvalue=fieldvalue.replace(/\..*/,'');}
else{decimalplaces=length||2;replaceregex=new RegExp('(\\.\\d{'+decimalplaces+'})\\d+');fieldvalue=fieldvalue.replace(replaceregex,'$1');fieldvalue=fieldvalue.replace(/(\.)(.*)(\.)/g,'$1$2');}
input.value=fieldvalue;}
function FormatTemperature(){if(IsNavigationKey(event.keyCode)){return false;}
var temperature=event.srcElement.value||'';temperature=temperature.toString();temperature=temperature.replace(/\s/g,'');temperature=temperature.replace(/[^0-9\.]/g,'');temperature=temperature.replace(/^0+/,'');temperature=temperature.replace(/(\.)(.*)(\.)/g,'$1$2');event.srcElement.value=temperature;if(event.keyCode==190||event.keyCode==110){if(temperature.indexOf('.')!=-1){var firstindexofdecimal=temperature.indexOf('.');if(temperature.indexOf('.',(firstindexofdecimal+1))!=-1){temperature=temperature.replace(/\./g,"");event.srcElement.value=temperature;}}}
var charbeforedecimal=(InList(temperature.charAt(0),[1,2]))?3:2;if(temperature.indexOf('.')!=-1&&temperature.indexOf('.')!=charbeforedecimal){temperature=temperature.replace(/\./g,"");event.srcElement.value=temperature;}
if(temperature.length==(charbeforedecimal+1)&&temperature.indexOf('.')==-1||temperature.length>charbeforedecimal&&temperature.indexOf('.')==-1){event.srcElement.value=temperature.substr(0,charbeforedecimal)+'.'+temperature.substr(charbeforedecimal,(temperature.length-charbeforedecimal));}}
function EnableDisableSignOff(flag){DelayForSectionLoad(function(){var orderssignoffcheckbox=jQuery('#ORDERSSIGNOFF').get(0),authorizewidget;GetSignOffMessage();var closeencountercheckbox=jQuery('#CLOSEENCOUNTER').get(0);if(closeencountercheckbox){if(DetermineandDisableSignOff(closeencountercheckbox)){return true;}
authorizewidget=EPCS_AuthorizeDialog_Encounter.FindWidget();if(orderssignoffcheckbox){if(orderssignoffcheckbox.checked==false){if(!CheckForDiagnosesWithoutICD9(closeencountercheckbox,orderssignoffcheckbox)&&!CheckForDiagnosesNeedingVerification(closeencountercheckbox,orderssignoffcheckbox)&&(!authorizewidget||!authorizewidget.FindAndAddOrderEPCSData().HasOrderNeedingAuthorization({IGNOREVALIDATIONISSUES:true}))){closeencountercheckbox.disabled=false;}}
else{closeencountercheckbox.disabled=false;}
return true;}
if(flag==1){closeencountercheckbox.disabled=true;closeencountercheckbox.checked=false;return true;}
else if(flag==0){closeencountercheckbox.checked=true;closeencountercheckbox.disabled=false;return true;}}});}
function CheckForDiagnosesWithoutICD9(closeencountercheckbox,orderssignoffcheckbox){if(OnOrderSetAdminPage()){return;}
var needsicd9=document.getElementsByName('ENCOUNTERDIAGNOSIS_NEEDSICD9CODE')[0];if(!needsicd9){return false;}
if(needsicd9.value==1){closeencountercheckbox.disabled=true;closeencountercheckbox.checked=false;return true;}}
function CheckForDiagnosesNeedingVerification(closeencountercheckbox,orderssignoffcheckbox){if(OnOrderSetAdminPage()){return false;}
var alldiagnosisorders=jQuery('#ALLDIAGNOSISORDERS');var diagnoses=alldiagnosisorders.children("[name='DIAGNOSIS']").toArray();for(var i=0;i<diagnoses.length;i++){var needsverification=jQuery("#"+EscapeJQuerySelector("ENCOUNTERDIAGNOSIS{"+i+"}{CODECONVERSIONWARNING}"));if(needsverification.val()>0){closeencountercheckbox.disabled=true;closeencountercheckbox.checked=false;return true;}}
return false;}
function CheckForUnsignedOrders(closeencountercheckbox,verbose,orderssignoffcheckbox){if(OnOrderSetAdminPage()){return;}
if(!orderssignoffcheckbox){ReportError("No orderssignoffcheckbox in CheckForUnsignedOrders");return;}
var dxcontainer=GetSectionContainer(orderssignoffcheckbox);var dxcontainerjq=jQuery(dxcontainer);var deleteobj=document.getElementById('orderdeletelink');var reopenobj=document.getElementById('orderreopenlink');var unsignedorders=deleteobj?true:false;if(unsignedorders&&verbose){alert(""+GetSignOffMessage(1,0)+"");}
var jqsignoffenabledspan=jQuery(document.getElementById('SIGNOFFENABLED'));var jqsignoffdisabledspan=jQuery(document.getElementById('SIGNOFFDISABLED'));if(unsignedorders){jqsignoffenabledspan.show();jqsignoffdisabledspan.hide();}
else{orderssignoffcheckbox.checked=false;jqsignoffenabledspan.hide();if(reopenobj){jqsignoffdisabledspan.show();}
else{jqsignoffdisabledspan.hide();}}
if(!closeencountercheckbox){closeencountercheckbox=document.getElementById('CLOSEENCOUNTER');}
if(closeencountercheckbox){if(DetermineandDisableSignOff(closeencountercheckbox)){return true;}
if(orderssignoffcheckbox&&orderssignoffcheckbox.checked==true){closeencountercheckbox.disabled=false;return true;}
if(unsignedorders){closeencountercheckbox.checked=false;closeencountercheckbox.disabled=true;}
else{closeencountercheckbox.disabled=false;}
return true;}}
function DetermineandDisableSignOff(closeencountercheckbox){var disablesignoff;if(closeencountercheckbox.className==='RequiresRenderingProvider'){disablesignoff=1;}
if(AH.DictationNavigator&&isObject(AH.DictationNavigator)){if(AH.DictationNavigator.HasUntranscribedDictations(jQuery('form[name=zform] > input[name=CLINICALENCOUNTERID]').val())){disablesignoff=1;}}
if(disablesignoff){closeencountercheckbox.checked=false;closeencountercheckbox.disabled=true;return true;}
return false;}
function GetSignOffMessage(returnmessage,returncount){var deletecount=0;var diagnosistable=document.getElementById('DIAGNOSISORDER_TABLE');if(diagnosistable){var deleteobj=diagnosistable.getElementsByTagName("A");if(deleteobj){for(var i=0;i<deleteobj.length;i++){if(deleteobj[i].id=='orderdeletelink'){deletecount++;}}}}
SetSignOffMessage(deletecount,returnmessage);if(returnmessage&&deletecount>0){return alertmessage;}
if(returncount){return deletecount;}}
function SetSignOffMessage(deletecount,returnmessage){alertmessage='';if(deletecount>1){alertmessage='There are '+deletecount+' unsigned orders for this encounter';}
else if(deletecount==1){alertmessage='There is '+deletecount+' unsigned order for this encounter';}
var closeencountercheckbox=document.all('CLOSEENCOUNTER');if(closeencountercheckbox){closeencountercheckbox.title=alertmessage;}
if(returnmessage){return alertmessage;}}
function FormatBloodPressure(systolicfield){if(IsNavigationKey(event.keyCode)){return false;}
var bp=event.srcElement.value||'';bp=bp.toString();bp=bp.replace(/^0+|[\s\D]/g,'');event.srcElement.value=bp;var maxcharlength=(InList(bp.charAt(0),[1,2]))?3:2;if(typeof systolicfield!='undefined'){if(event.keyCode==107||event.keyCode==187&&event.shiftKey){return false;}
var container=GetRowContainer(systolicfield);if(bp.length>=maxcharlength&&container){var name=systolicfield.name;name=name.replace(/SYSTOLIC/,'DIASTOLIC');var diastolicfield=jQuery(container).find(EscapeJQuerySelector('[name="'+name+'"]'));diastolicfield.focus();}}
if(bp.length>maxcharlength){bp=bp.substr(0,maxcharlength);event.srcElement.value=bp;}}
function FormatWeeksGestation(){if(IsNavigationKey(event.keyCode)){return false;}
var wg=event.srcElement.value.toString();wg=wg.replace(/^0+|[\s\D]/g,'');event.srcElement.value=wg;}
function GetTableElements(tableid){var tableobj=document.getElementById(tableid);var childnodes=GetChildren(tableobj);var objectcollection=new Array();for(i=0;i<childnodes.length;i++){if(childnodes[i].name){if(childnodes[i].type){if(childnodes[i].type=='text'||childnodes[i].type.match(/select/i)){objectcollection.push(childnodes[i]);}}}}
return objectcollection;}
function NavigateHorizontal(tableid){var prevfield;var nextfield;if(!tableid){tableid='RESULTSTABLE';}
if(event.shiftKey){if(event.keyCode==37){event.returnValue=false;var objcollection=GetTableElements(tableid);for(i=0;i<objcollection.length;i++){if(objcollection[i].name==event.srcElement.name){var prev;if(i==0){prev=objcollection.length-1;}
else{prev=i-1;}
if(objcollection[prev]){prevfield=objcollection[prev];prevfield.focus();return;}}}}
if(event.keyCode==39){event.returnValue=false;var objcollection=GetTableElements(tableid);for(j=0;j<objcollection.length;j++){if(objcollection[j].name==event.srcElement.name){var next;if(j==(objcollection.length-1)){next=0;}
else{next=j+1;}
if(objcollection[next]){nextfield=objcollection[next];nextfield.focus();return;}}}}}
else{return false;}}
function NavigateFields(){var indexshift=0;if(event.keyCode==38){indexshift--;}else if(event.keyCode==40){indexshift++;}else{return false;}
if(indexshift){var fieldname=event.srcElement.name;var fieldnamebase=fieldname.toString().replace(/\d+/g,'\\d+');var matcharray=GetChildren(document.zform,'tagName',event.srcElement.tagName,'type',event.srcElement.type,'name',new RegExp(fieldnamebase));var length=matcharray.length
for(var i=0;i<length;i++){if(matcharray[i].name==fieldname){var nextindex=i+indexshift;if(nextindex>=0&&nextindex<length){var nextfield=matcharray[nextindex];if(nextfield.type!='hidden'){nextfield.focus();return true;}}}}
document.zform.focus();}}
function ChangeOuncesToPounds(obj){var fieldindex;if(obj==null){fieldindex=0;}
else{var match=obj.name.match(/\w+{(A?\d+)}/);fieldindex=match[1];}
var container=GetSectionContainer(obj);var jqcontainer=jQuery(container);var ouncesobj=jqcontainer.find(EscapeJQuerySelector("input[name='HISTORICALPREGNANCIES_BIRTHWEIGHTOUNCES{"+fieldindex+"}']")).get(0);var ouncesval=TrimWhitespace(ouncesobj.value);var poundsobj=jqcontainer.find(EscapeJQuerySelector("input[name='HISTORICALPREGNANCIES_BIRTHWEIGHTPOUNDS{"+fieldindex+"}']")).get(0);var poundsval=TrimWhitespace(poundsobj.value);if(ouncesval){if(ouncesval<16){return false;}
if(ouncesval>=16){poundsval=0+parseInt(poundsval,10);if(!poundsval){poundsval=0;}
poundsobj.value=poundsval+parseInt(ouncesval/16,10);if(ouncesval%16){ouncesobj.value=ouncesval%16;}
else{ouncesobj.value='';}}}}
function RefreshDocumentWorklist(){var schedulenav=AH.Frames.ScheduleNav;if(schedulenav.IsVisible()){var queueurl=schedulenav.GetLocation().toString().match(/.*documentqueue.esp/);if(queueurl){schedulenav.SetLocation(queueurl+'?MINE=1');}}}
function Bright(item){if(!item.className.match(/( |\b)Bright\b/)){item.className+=' Bright';}}
function UnBright(item){item.className=item.className.replace(/( |\b)Bright\b/,'');}
function SpacesToCharacterEntities(text){var mytext=text.replace(/([ ]+(?= ))/g,function(match,p1,offset,string){return"&nbsp;".repeat(p1.length);});return mytext;}
function RefreshOptionFields(){var inputtype=jQuery("[name^='INPUTTYPE']",document.zform).val();if(!inputtype){return;}
if(inputtype=='DROPDOWN'){jQuery(document.getElementById("OPTIONSTABLEROW")).show();var options=GetChildren(document.getElementById('OPTIONSLIST'),'tagName','input');for(var i=0;i<options.length;i++){options[i].value=TrimWhitespace(options[i].value);if(options[i].value==''){return false;}}
var previousid=options.length-1;var fieldcount;if(previousid>-1){fieldcount=options[previousid].getAttribute('currentid');}
else{fieldcount=0;}
var previousanchor=document.getElementById("addtag_"+fieldcount);if(previousanchor){previousanchor.innerHTML="";previousanchor.parentNode.removeChild(previousanchor);}
fieldcount++;var deleteoptionsicon=jQuery("<span>").attr({"class":'sprite-del-16x16',style:'cursor:pointer',border:0});var deleteoptionslink=jQuery("<a>").attr({href:'#',onclick:"DeleteOptionRow('"+fieldcount+"')",id:'deletetag_'+fieldcount,style:'padding-left: 10px'});var optionsinput=jQuery("<input>").attr({currentid:fieldcount,type:'TEXT',name:'SELECTOPTIONS',id:'texttag_'+fieldcount});var addoptionsicon=jQuery("<span>").attr({"class":'sprite-add',style:'cursor:pointer',border:0});var addoptionslink=jQuery("<a>").attr({href:'#',onclick:"RefreshOptionFields()",id:'addtag_'+fieldcount,style:'padding-left: 5px'});var optionsdivider=jQuery("<div>").attr({id:'dividetag_'+fieldcount});var deleteelement=deleteoptionslink.append(deleteoptionsicon);var addelement=addoptionslink.append(addoptionsicon);var optionsrow=optionsdivider.append(optionsinput).append(deleteelement).append(addelement);var optionslist=jQuery(document.getElementById("OPTIONSLIST")).append(optionsrow);optionslist.show();}
else{jQuery(document.getElementById("OPTIONSTABLEROW")).hide();}
return true;}
function DeleteOptionRow(elementid){var options=GetChildren(document.getElementById('OPTIONSLIST'),'tagName','input');if(options.length==1){options[0].value="";return;}
var dividetag=jQuery("#dividetag_"+elementid);var addtag=jQuery("#addtag_"+elementid);if(addtag){var addelement=jQuery(addtag).detach();dividetag.remove();var previousid=options.length-2;var fieldcount=options[previousid].getAttribute('currentid');addelement.attr({id:'addtag_'+fieldcount});jQuery('#OPTIONSLIST div:last-child',AH.Frames.Main.Document()).append(addelement);}
else if(dividetag)
{dividetag.remove();}}
function OptionsSpecified(){var options=GetChildren(document.getElementById('OPTIONSLIST'),'tagName','input');for(var i=0;i<options.length;i++){options[i].value=TrimWhitespace(options[i].value);if(options[i].value!=''){return true;}}
return false;}
function InitializeSVGJotterObject(params){if(typeof window.Raphael.SketchpadShim=='function')window.Raphael.SketchpadShim(params);var targetelementname;if(params.TARGETELEMENTNAME&&params.TARGETELEMENTNAME!='undefined'){targetelementname=params.TARGETELEMENTNAME;}
else{targetelementname=params.TYPE+'_'+params.ID;}
var svgobjargs={'IFRAME':params.IFRAME,'SECTION':EscapeJQuerySelector(params.SECTIONNAME),'SVGJOTTERCONTAINERID':targetelementname};if(params.IFRAME){var targetframe=params.TARGETFRAME;var jotterobject=new targetframe.contentWindow.SVGJotter(svgobjargs);params.JOTTEROBJECTHOLDER.svgjotterobject=jotterobject;targetframe.contentWindow[params.IFRAMEJOTTEROBJECTNAME]=jotterobject;}
else{params.JOTTEROBJECTHOLDER.svgjotterobject=new SVGJotter(svgobjargs);}}
function LoadSVGJotter(params){AssertRequiredFields(params,['SECTION']);if(!params.STARTINGOBJECT.getAttribute("svgjotterloaded")){var container=nvl(GetSectionContainer(params.SECTION),document);var jotterobject;if(params.JOTTEROBJECT){jotterobject=params.JOTTEROBJECT;}
else{if(params.IFRAME){var targetframe=jQuery(container).find('#'+'SVGJOTTERIFRAME'+params.SECTIONNAME).get(0);jotterobject=targetframe.contentWindow[params.IFRAMEJOTTEROBJECTNAME];}
else{jotterobject=SVGJotter.GetJotter({'SECTIONNAME':params.SECTIONNAME});}}
var args={'JOTTERSTROKES':params.JOTTERSTROKES,'JOTTERHEIGHT':params.JOTTERHEIGHT,'JOTTERWIDTH':params.JOTTERWIDTH,'PENCOLOR':params.PENCOLOR,'ANATOMICAL':params.ANATOMICAL};var useenhancements=jQuery('#'+params.SECTIONNAME+'USEJOTTERENHANCEMENTS').val();if(useenhancements){args.USEJOTTERENHANCEMENTS=1;}
jotterobject.PutSketchpad(args);params.STARTINGOBJECT.setAttribute("svgjotterloaded",1);}}
