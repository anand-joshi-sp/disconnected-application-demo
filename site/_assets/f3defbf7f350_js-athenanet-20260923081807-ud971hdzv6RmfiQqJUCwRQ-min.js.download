.width(width)
.height(height)
.append(modaljs,modaliframe);jQuery.modal(modaldiv,{"position":[toppos,leftpos],"closeHTML":'',"containerCss":{"width":width,"height":height,"background-color":'#fff',"border-color":'#fff',"padding":0},"onShow":function(dialog){dialog.overlay.bind('touchmove',function(event){event.preventDefault();});}});return undefined;}
function ResizeTabletLayout(mainheight,parent){var otherdivsheight=0;var footershim=document.getElementById('footershim');if(footershim){swapNodes(footershim,document.getElementById('layout_footer'));jQuery(footershim).remove();}
var contentdiv=document.getElementById('layout_content');if(contentdiv){jQuery(parent+' > div[id!=layout_content]',document).each(function(){otherdivsheight+=jQuery(this).outerHeight();});jQuery(contentdiv).outerHeight(mainheight-otherdivsheight);}}
function _GetTab(tabid){return jQuery('#TABCELL'+tabid).find('div[tabid="'+tabid+'"]');}
function TabsOnClick(tabsid,tabid,userfunction){var tab=_GetTab(tabid);if(tab.hasClass('unselectedtab')){var userfunctionoutput=userfunction();if(typeof userfunctionoutput==='undefined'||userfunctionoutput){SwitchSelectedTab(tabsid,tabid);return userfunctionoutput;}
else{return 0;}}}
function SwitchSelectedTab(tabsid,tabid){var tabs=jQuery('#'+tabsid);tabs.find('div').each(function(index){var localtabid=jQuery(this).attr('tabid');if(typeof localtabid==='undefined'){}
else if(localtabid==tabid){jQuery(this).attr('class','selectedtab');}
else{if(jQuery(this).hasClass('disabledtab')){}
else{jQuery(this).attr('class','unselectedtab');}}});}
function TabsEnableTab(tabid){var tab=_GetTab(tabid);if(tab.hasClass('disabledtab')){jQuery(tab).attr('class','unselectedtab');}}
function TabsDisableTab(tabid){var tab=_GetTab(tabid);if(tab.hasClass('unselectedtab')){jQuery(tab).attr('class','disabledtab');}}
function TabsShowTab(tabsid,tabid){jQuery('#TABCELL'+tabid).attr('display','block');var tab=_GetTab(tabid);jQuery(tab).attr('display','block');}
function TabsHideTab(tabsid,tabid){var tab=_GetTab(tabid);if(tab.hasClass('unselectedtab')){jQuery.find('#TABCELL'+tabid).attr('display','none');jQuery(tab).attr('display','none');}}
function TabsNextTab(tabsid){var enabledtabs=jQuery("#"+tabsid).find("td[id^='TABCELL']").filter(':visible').find('div[class=selectedtab],div[class=unselectedtab]');var nexttabindex=enabledtabs.index(enabledtabs.filter('div[class=selectedtab]'))+1;if(nexttabindex<enabledtabs.length){enabledtabs.eq(nexttabindex).click();}}
function TabsPreviousTab(tabsid){var enabledtabs=jQuery("#"+tabsid).find("td[id^='TABCELL']").filter(':visible').find('div[class=selectedtab],div[class=unselectedtab]');var prevtabindex=enabledtabs.index(enabledtabs.filter('div[class=selectedtab]'))-1;if(prevtabindex>=0){enabledtabs.eq(prevtabindex).click();}}
function LegacyDoNotUseDisableTabsForSubmit(tabsid){jQuery("#"+tabsid).find("div").each(function(x){this.style.cursor='wait';this.disabled=1;});}
function TabUnselect(tabsid,tabid){var tab=_GetTab(tabid);if(tab.length==1&&tab.hasClass('selectedtab')){tab.attr('class','unselectedtab');}}
function ToggleEditSection(id){jQuery(event.target).closest('.formsectionheader').addClass('hidden');jQuery('#'+id+' .fieldset, #sectionheader_'+id).removeClass('hidden');jQuery('#readonly_'+id).addClass('hidden');}
ClinicalProviderQuestion={GenericAnswerRowTemplate:"\
		<tr>\
			<td>\
				<input name='QUESTIONOPTION{%s}' maxlength='100' type='TEXT' %s/>\
			</td>\
			<td>\
				<input name='QUESTIONOPTIONHIDDENVALUE{%s}' maxlength='100' type='TEXT' %s/>\
			</td>\
			<td>\
				<a href='#' onclick='DeleteTableRow(this)' title='delete row'>\
					<span class='sprite-del-16x16' style='cursor:pointer' title='delete row' border='0'></span>\
				</a>\
			</td>\
		</tr>",LastAnswerRowTemplate:"\
		<tr>\
			<td>\
				<input name='QUESTIONOPTION{%s}' maxlength='100' type='TEXT' %s/>\
			</td>\
			<td>\
				<input name='QUESTIONOPTIONHIDDENVALUE{%s}' maxlength='100' type='TEXT' %s/>\
			</td>\
			<td>\
				<a href='#' onclick='AddBlankRow(); SwitchToDeleteLink(this);' title='Add Row'>\
					<span class='sprite-add' style='cursor:pointer' title='Add Row'></span>\
				</a>\
			</td>\
		</tr>",MainRowTemplate:"\
		<tr id='RESPONSESROW' class='formelement'>\
			<th title class='fieldlabel'>Options</th>\
			<td id='responses' class='fieldinput'>\
				<table style='margin:0px;'>\
					<tbody><tr><td>Option</td><td>Value</td></tr>%s</tbody>\
				</table>\
			</td>\
		</tr>",LoadQuestionInfo:function(questionid){var jqform=jQuery('form[name=zform]');CallRemote({SUB:'Clinical::Provider::AskAtOrderEntry::_GetStandardQuestionInfo',ARGS:{STANDARDQUESTIONID:questionid},ONFINISH:function(standardquestion){var content='';var lastanswer='';var i=0;jQuery('#questiontype').val(standardquestion.TYPE);jQuery('#RESPONSESROW').remove();if(standardquestion.TYPE=='DROPDOWN'&&standardquestion.OPTIONS.length>0){for(;i<standardquestion.OPTIONS.length-1;i++){content+=sprintf(ClinicalProviderQuestion.GenericAnswerRowTemplate,i,standardquestion.OPTIONS[i],i,'');}
lastanswer=standardquestion.OPTIONS[i];}
content+=sprintf(ClinicalProviderQuestion.LastAnswerRowTemplate,i,lastanswer,i,'');jqform.find('tr#TYPEROW').after(sprintf(ClinicalProviderQuestion.MainRowTemplate,content));ClinicalProviderQuestion.QuestionTypeChanged({QUESTIONTYPE:jqform.find('select[name=TYPE]').val()});},LOADINGINDICATORFLAG:1});return false;},LoadContent:function(args){var jqform=jQuery('form[name=zform]');var existingquestionid=jqform.find('input[name=ID]').val();if(existingquestionid){var existingstdid=jqform.find('select[name*=CLINSTDORDERTYPEQUESTIONID]').val();if(existingstdid.length>0){CallRemote({SUB:'Clinical::Provider::AskAtOrderEntry::_GetStandardQuestionInputOptions',ARGS:{FILTERID:existingstdid[0],SELECTEDID:existingstdid[0]},ONFINISH:function(html){jQuery('select[name*=CLINSTDORDERTYPEQUESTIONID]').html(html);},LOADINGINDICATORFLAG:1});}
CallRemote({SUB:'Clinical::Provider::AskAtOrderEntry::_GetExistingCustomQuestionOptions',ARGS:{QUESTIONID:existingquestionid},ONFINISH:function(answers){var content='';var lastanswer='';var lasthidden='';var i=0;if(answers.length>0){for(;i<answers.length-1;i++){content+=sprintf(ClinicalProviderQuestion.GenericAnswerRowTemplate,i,answers[i].VALUE,i,answers[i].EXTERNALVALUE);}
