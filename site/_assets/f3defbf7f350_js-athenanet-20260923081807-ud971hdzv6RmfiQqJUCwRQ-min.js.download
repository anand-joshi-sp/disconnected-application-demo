else{UnBright(selecteddiagnosisheader);selecteddiagnosisform.style.display='none';selecteddiagnosisheader.onmouseover=selecteddiagnosesfocusitem.onmouseover;selecteddiagnosisheader.onmouseout=selecteddiagnosesfocusitem.onmouseout;}}
function SyncDiagnosisForm(sourcecontainer){if(IsParent(sourcecontainer,document.activeElement)){return;}
var sectioncontainer=GetSectionContainer(sourcecontainer);var ordering;var sourceprefix;var destprefix;var destcontainer;var selecteddiagnosiscontainer;var diagnosisblock;var fieldstosync=['NOTE','STATUS','LATERALITY','QUICKPICK','PROBLEMLIST','PREGNANCYPROBLEMLIST'];if(sourcecontainer.className=='selecteddiagnosisform'){sourceprefix='SELECTEDDIAGNOSIS';destprefix='ENCOUNTERDIAGNOSIS';var selecteddiagnosis=jQuery(sourcecontainer).closest("div[name='selecteddiagnosis']").get(0);ordering=jQuery(selecteddiagnosis).attr('ordering');destcontainer=GetChild(sectioncontainer,'tagName','div','className',/diagnosisblock/,'diagnosisordering',ordering);selecteddiagnosiscontainer=selecteddiagnosis;diagnosisblock=destcontainer;}
else if(sourcecontainer.className=='diagnosisform'){sourceprefix='ENCOUNTERDIAGNOSIS';destprefix='SELECTEDDIAGNOSIS';diagnosisblock=GetParent(sourcecontainer,'tagName','div','className',/diagnosisblock/);ordering=jQuery(diagnosisblock).attr('diagnosisordering');destcontainer=jQuery("div[name='selecteddiagnosis'][ordering='"+ordering+"']",sectioncontainer).get(0);selecteddiagnosiscontainer=destcontainer;}
if(!isDefined(destcontainer)){return;}
var problemselect=jQuery(sectioncontainer).find("select[name='"+sourceprefix+"{"+ordering+"}{PROBLEMSELECT}']");if(problemselect.size()>0){fieldstosync.push("PROBLEMSELECT");}
var sourcefield;var destfield;for(var i=0;i<fieldstosync.length;i++){sourcefield=jQuery(EscapeJQuerySelector("[name='"+sourceprefix+'{'+ordering+'}{'+fieldstosync[i]+"}']"),sourcecontainer).get(0);destfield=jQuery(EscapeJQuerySelector("[name='"+destprefix+'{'+ordering+'}{'+fieldstosync[i]+"}']"),destcontainer).get(0);if(sourcefield&&destfield){if(fieldstosync[i]=='LATERALITY'){var buttongroup=GetParent(destfield,'tagName','span','className',/buttongroup/);ButtonGroup.SetValue(buttongroup,sourcefield.value);}
else if(sourcefield.tagName=='INPUT'&&sourcefield.type=='checkbox'){destfield.checked=sourcefield.checked;}
else if(sourcefield.tagName=='INPUT'||sourcefield.tagName=='SELECT'||sourcefield.tagName=='TEXTAREA'){destfield.value=sourcefield.value;}}}
