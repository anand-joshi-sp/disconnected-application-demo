return MultiLineSelect.AllInstances;},ShowHide:function(obj){var selectdiv=jQuery(obj).siblings('.MultiLineSelect');MultiLineSelect.GetAllInstances().not(selectdiv).addClass('hidden');selectdiv.toggleClass('hidden');event.cancelBubble=true;},Choose:function(obj){var option=jQuery(obj);var selectbox=option.parent().siblings('SELECT').children();selectbox.val(option.attr('value')||'');selectbox.text(option.attr('shorttext')||option.html());option.parent().addClass('hidden');}};function ValidateEmailCore(email){if(email&&!(email.length<=254&&email.match(/^[^\@]{1,64}\@[^\@]{1,253}$/)&&email.match(/^[\w\!\#\$\%\&\'\*\+\-\/\=\?\^\`\{\|\}\~\.\@]+$/)&&email.match(/^.+\@.+\..+$/)&&!email.match(/\.\./)&&!email.match(/^\./)&&!email.match(/\.\@/)&&!email.match(/\@\./)&&!email.match(/\.$/))){return false;}
return true;}
