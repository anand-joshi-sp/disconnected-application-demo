var selectedvalue=jQuery("#"+EscapeJQuerySelector(dropdownid)).val().toString();if(selectedvalue){var matches=selectedvalue.match(/CANONICAL\{(.*)\}/);if(matches&&matches[1]){var canonicalid=matches[1];GetCanonicalHTML(canonicalid,viewpaneid,population);}
else{GetTemplateHTML(selectedvalue,viewpaneid,population);}}}
