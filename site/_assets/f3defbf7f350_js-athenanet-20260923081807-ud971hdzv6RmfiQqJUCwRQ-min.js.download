else{jQuery('#skipstage',encountertab.contentWindow.document).hide();jQuery('#layout_header,#layout_content',encountertab.contentWindow.document).show();jQuery(encountertab.contentWindow.document).ready(function(){jQuery('#layout_footer',encountertab.contentWindow.document).show();});}
