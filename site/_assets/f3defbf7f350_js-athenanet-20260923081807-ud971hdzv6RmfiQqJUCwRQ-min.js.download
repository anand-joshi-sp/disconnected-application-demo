"onclick='this.parentElement.parentElement.parentElement.deleteRow(this.parentElement.parentElement.rowIndex)'>remove</a>";newrow.insertCell(4).innerHTML="hx";procedureobj.selectedIndex=-1;jqcontainer.find("span[name='PROCEDURECODELABEL']").html('[e.g. CABG]');jqcontainer.find("input[name='SURGICALHISTORYPROCEDURECODE']").val('');CheckProcedure('',container);jqcontainer.find(EscapeJQuerySelector("input[name='DISPLAY_PATIENTSURGICALHISTORY{_"+indexofaddedrow+"}{SURGERYDATE}']")).focus();ReinitializeSpeechEnabledFields();}
function ToggleDisplayByLink(args){if(!args.CONTAINER){args.CONTAINER=document;}
var target=document.getElementById(args.TARGETNAME);if(!target){return false;}
if(target.style.display=='none'){target.style.display='';if(args.REPLACEMENTLINKTEXT!==undefined){args.LINK.innerText=args.REPLACEMENTLINKTEXT;}
if(args.SHIMID){ShowShim(target,args.SHIMID);}}
else{target.style.display='none';args.LINK.innerText=args.LINKTEXT;if(args.SHIMID){HideShim(0,args.SHIMID);}}}
function ValidatePhoneNumber(field){if(field.value){var fax=field.value;var newfax="";for(var i=0;i<fax.length;i++){var curchar=fax.substr(i,1);if(!isNaN(curchar)&&curchar!=" "){newfax+=curchar;}
else if(curchar!="("&&curchar!=")"&&curchar!="-"&&curchar!=" "){alert("The phone/fax field should be in the form (999) 999-9999");field.focus();return false;}}
if(newfax.length==10){field.value="("+newfax.substr(0,3)+") "+newfax.substr(3,3)+"-"+newfax.substr(6,4);var str=ValidatePhoneFaxNumber(field.value);if(str!=""){alert(str);field.focus();return false;}}
else{alert("The phone/fax field should be in the form (999) 999-9999");try{field.focus();}
catch(e){}
return false;}}
return true;}
function ValidateDirectAddress(field){if(field.value){var regex=/^\w+@\w+$/;field.value=TrimWhitespace(field.value);if(field.value!==''&&!(regex.test(field.value)||ValidateEmailCore(field.value))){alert("Direct Address Field should be of the format name@domain");field.focus();return false;}}
return true;}
function ValidateDEANumber(field){if(field.value){var dea=TrimWhitespace(field.value);if(dea&&IsDEANumber(dea)){return true;}
else{return false;}}
return true;}
function ValidateNPINumber(field){if(field.value){var npi=TrimWhitespace(field.value);if(npi&&IsNPINumber(npi)){return true;}
else{return false;}}
return true;}
function GetTabId(id){return id.replace(/^([^_]*)_/,"");}
function AddMedication(field,options){var autoobject=field.autocompleteobj;if(autoobject.autocompletionname==''||field.value==''||autoobject.autocompletionvalue!=field.value){return;}
var namevalue=TrimWhitespace(autoobject.autocompletionname);var container=GetSectionContainer(field);var escapedname=field.value.replace(/\'/g,"%27");var table=jQuery('#PATIENTMEDICATIONCART',container);var newindex=parseInt(table.attr('lastaddedrow'));newindex++;var lastexistingrow=jQuery('tbody:last[id*=MEDICATIONGROUP]',table);var newrowclass='';if(!lastexistingrow.size()){lastexistingrow=jQuery('thead:first',table);}
else{newrowclass=lastexistingrow.hasClass('encounteralternaterow')?"":" class='encounteralternaterow'";}
var newrowhtml="<tbody id='MEDICATIONGROUP_NEW"+newindex+"'"+newrowclass+">";newrowhtml+="<tr id='{NEW}MEDICATION"+newindex+"'>";newrowhtml+="<td style='text-align: center'><a href=# onclick='DeleteNewMedication(this, "+newindex+")'>del</a></td>";newrowhtml+="<td><input name={NEW}PATIENTMEDICATION_MEDICATIONID_"+newindex+" type=hidden value='"+escapedname+"'>"+namevalue+"</td>";newrowhtml+="<td colspan=5 id='{NEW}MEDICATIONEDIT_"+newindex+"'></td>";newrowhtml+="<td>"+AH.GetGlobal('USERNAME')+"</td>";newrowhtml+="</tr>";newrowhtml+="<tr id='{NEW}WARNINGS"+newindex+"'>";newrowhtml+="<td></td><td colspan=6><span id=FDBWARNINGS"+newindex+"></span></td>";newrowhtml+="<td></td>";newrowhtml+="</tr>\n";newrowhtml+="</tbody>";lastexistingrow.after(newrowhtml);table.attr('lastaddedrow',newindex);var medtable=jQuery(table).parents("div#PATIENTMEDICATIONDATATABLE");var medicationid=field.value;var patientid=medtable.attr('patientid');var chartid=medtable.attr('chartid');var departmentid=medtable.attr('departmentid');var clinicalencounterid=medtable.attr('clinicalencounterid');CallRemote({SUB:'Clinical::Patient::MedicationList::GetMedicationEditData',ARGS:{PATIENTID:patientid,CHARTID:chartid,CLINICALENCOUNTERID:clinicalencounterid,MEDICATIONID:medicationid,MEDICATIONTYPE:'NEW',NEWINDEX:newindex},ONFINISH:function(data){jQuery('#'+EscapeJQuerySelector('{NEW}MEDICATIONEDIT_'+newindex),table).html(data.HTML);newmedicationids+=medicationid+'::';var contentset=nvl(GetParent(field,'id','contentset'),document.zform);var newordertypesobj=GetChild(contentset,'tagName','input','type','hidden','name',"NEWORDERTYPEIDS");var newordertypeids=newordertypesobj?newordertypesobj.value:'';var alldiagnosisorders=jQuery('#ALLDIAGNOSISORDERS');var newdiagnosiscodes=[];alldiagnosisorders.find('.diagnosisblock').each(function(){var dxcode=jQuery(this).attr('diagnosiscode');if(dxcode){newdiagnosiscodes.push(dxcode);}});var allproblems=jQuery('#PATIENTPROBLEMCART');allproblems.find('input[id^=PATIENTPROBLEM_PROBLEMCODE]').each(function(){var dxcode=this.value;if(dxcode){newdiagnosiscodes.push(dxcode);}});UpdateFDBWarnings(field,{PATIENTID:patientid,CHARTID:chartid,DEPARTMENTID:departmentid,CLINICALENCOUNTERID:clinicalencounterid,MEDICATIONNAME:namevalue,MEDICATIONID:medicationid,NEWORDERTYPEIDS:newordertypeids,NEWMEDICATIONIDS:newmedicationids,NEWDIAGNOSISCODES:newdiagnosiscodes,NEWALLERGYIDS:AH.GetGlobal('newallergies'),FIELDPREFIX:'NEW',TARGET:'FDBWARNINGS'+newindex,REFRESH:1,ISMEDICATIONLIST:1,NEWINDEX:newindex,EDITABLE:1,TYPE:'PATIENTMEDICATION',INITIALIZEDOSECHECKS:1,ALLOWRECONSOLNDOSECHECKS:1});var notesfield=jQuery("textarea[name='{NEW}PATIENTMEDICATION_PROVIDERNOTE_"+newindex+"']",table).get(0);if(notesfield){SetDelayBeforeFocus(notesfield);}
ReinitializeSpeechEnabledFields();},LOADINGINDICATORFLAG:true});CheckInSection("MEDICATIONLIST_NOMEDSREPORTED",false,field);field.value='';}
function HideUnhideMedicationName(medicationname,field){var namevalue=medicationname+"::";if(field.checked){newmedicationnames=newmedicationnames.replace(namevalue,'');}else{newmedicationnames+=namevalue;CheckInSection('MEDICATIONLIST_NOMEDSREPORTED',false,field);}}
function DeleteNewMedication(source,rowid){var container=GetSectionContainer(source);var containerjq=jQuery(container);var table=containerjq.find('table#PATIENTMEDICATIONCART').get(0);var warningsrow=containerjq.find(EscapeJQuerySelector('tr#{NEW}WARNINGS')+rowid).get(0);if(warningsrow){table.deleteRow(warningsrow.rowIndex);}
var medicationrow=containerjq.find(EscapeJQuerySelector('tr#{NEW}MEDICATION')+rowid).get(0);if(medicationrow){var medicationidobj=jQuery(medicationrow).find("input[name='"+EscapeJQuerySelector('{NEW}PATIENTMEDICATION_MEDICATIONID_')+rowid+"']").get(0);table.deleteRow(medicationrow.rowIndex);if(newmedicationids&&medicationidobj){var re=new RegExp(medicationidobj.value+'::');newmedicationids=newmedicationids.replace(re,'');}
RefreshDDIMessagesOnDelete({medicationid:medicationidobj.value},container);}}
function ShowHiddenMedications(checkbox){ReloadMedicationList(checkbox);}
function ReloadMedicationList(object,args){var container=GetSectionContainer(object);var medtable=jQuery(container).find('div#PATIENTMEDICATIONDATATABLE');var addedinerroritems=jQuery(container).find("input[name^='PATIENTMEDICATION_ADDEDINERROR_']");if(!isDefined(args)){args={};}
if(medtable.size()>0){ShowLoadingIndicator();var savedfields=SaveMedicationFormFields(container,medtable);var editrows=[];jQuery.each(savedfields,function(key,value){if(key.match(/^{EXISTING}([A-Z]+)_STARTDATE_([0-9]+)/)){editrows.push(RegExp.$1+':'+RegExp.$2);}});var excluderows=[];jQuery.each(addedinerroritems,function(key,value){if(jQuery(value).attr('name').match(/^PATIENTMEDICATION_ADDEDINERROR_([0-9]+)/)){excluderows.push('PATIENTMEDICATION:'+RegExp.$1);}});var sortby=isDefined(args.SORTBY)?args.SORTBY:jQuery('#Medications_Sort_Alpha_Selected').css('display')!='none'?'Alpha':jQuery('#Medications_Sort_Date_Selected').css('display')!='none'?'Date':'Class';CallRemote({SUB:'Clinical::Patient::MedicationList::GetMedicationListHTML',ARGS:{SORTBY:sortby,SHOWALL:jQuery('#MEDICATIONLIST_SHOWINACTIVE:checked').size(),PATIENTID:medtable.attr('patientid'),CHARTID:GetChartID(),CLINICALENCOUNTERID:medtable.attr('clinicalencounterid'),EDITROWS:editrows,EXCLUDEROWS:excluderows},ONFINISH:function(data){var medtableinstantiation=medtable.get(0);medtableinstantiation.innerHTML=jQuery(data).html();if(isDefined(args.SORTBY)){var possiblesortby=new Array('Alpha','Date','Class');for(var i=0;i<possiblesortby.length;i++){var name=possiblesortby[i];if(name==args.SORTBY){jQuery('#Medications_Sort_'+name+'_Selected').show();jQuery('#Medications_Sort_'+name+'_Link').hide();}
else{jQuery('#Medications_Sort_'+name+'_Selected').hide();jQuery('#Medications_Sort_'+name+'_Link').show();}}}
RestoreMedicationFormFields(container,medtable,savedfields);ClearLoadingIndicator();}});}
return false;}
function CheckAllHideBoxes(checkbox,headerid){var sectioncontainer=GetSectionContainer(checkbox);var rollupcontrol=jQuery(sectioncontainer).find(".medrollupcontrol[medicationid="+headerid+"]");if(rollupcontrol.size()){FetchMedications(rollupcontrol.get(0),{LIST:'all',CHECKBOX:checkbox});}
_CheckAllHideBoxes(checkbox,headerid);}
function _CheckAllHideBoxes(checkbox,headerid){var sectioncontainer=GetSectionContainer(checkbox);var hideallcheckbox=GetChild(sectioncontainer,'tagName','input','name','SHOWINACTIVE');var rows=GetChildren(sectioncontainer,'tagName','tr','headerid',headerid);for(var i=0;i<rows.length;i++){var rowcheckbox=GetChild(rows[i],'id',/(CLINICALPRESCRIPTION|PATIENTMEDICATION)_HIDE/);if(rowcheckbox&&(hideallcheckbox.checked||!rows[i].className.match(/\bhiddenmed\b/))){if(rowcheckbox.checked!==checkbox.checked){rowcheckbox.click();}}}
if(!checkbox.checked){CheckInSection('MEDICATIONLIST_NOMEDSREPORTED',false,checkbox);}}
function RollupMedications(link,listtoshow){if(link.href){var sectioncontainer=GetSectionContainer(link);var sectioncontainerjq=jQuery(sectioncontainer);var rollupcontrol=GetParent(link);var rollupcontroljq=jQuery(rollupcontrol);DeactivateMedicationsRollupLink(rollupcontroljq);link.removeAttribute("href");link.style.color='black';var hidecheckbox=sectioncontainerjq.find("input[name='SHOWINACTIVE']").get(0);var showhidden=hidecheckbox.checked;var torollstr=rollupcontroljq.attr('show'+rollupcontroljq.attr('nowshowing'));if(torollstr){var toroll=torollstr.split(',');jQuery.each(toroll,function(index,rowname){var rows=sectioncontainerjq.find('tr#'+rowname);rows.hide();});}
FetchMedications(rollupcontrol,{LIST:listtoshow,UNROLL:1});rollupcontroljq.attr('nowshowing',listtoshow);}}
function ShowAllMedications(medicationcontainer){var rollupcontroljq=jQuery(medicationcontainer).find('.medrollupcontrol');DeactivateMedicationsRollupLink(rollupcontroljq);FetchMedications(rollupcontroljq.get(0),{LIST:'all',UNROLL:1});rollupcontroljq.attr('nowshowing','all');}
function DeactivateMedicationsRollupLink(rollupcontroljq){var activelinkjq=rollupcontroljq.find('a').not('[href]');activelinkjq.attr('href','#');activelinkjq.css('color','');}
function FetchMedications(rollupcontrol,args){AssertFields(args,['LIST'],['UNROLL','CHECKBOX']);var listtoshow=args.LIST;var rollupcontroljq=jQuery(rollupcontrol);var tounrollstr=rollupcontroljq.attr('show'+listtoshow);if(tounrollstr){var tounroll=tounrollstr.split(',');var sectioncontainer=GetSectionContainer(rollupcontrol);var sectioncontainerjq=jQuery(sectioncontainer);var needtoload=[];var needtoloadnames=[];jQuery.each(tounroll,function(index,rowname){var rows=sectioncontainerjq.find('tr#'+rowname);if(rows.size()>0){if(args.UNROLL){rows.show();rows.attr('unrolledby',listtoshow);}}
else{needtoload.push(rowname.replace('_ROW_',':'));needtoloadnames.push(rowname);}});if(needtoload.length>0){var medicationgroupbody=rollupcontroljq.parents('tbody:first');var headermedicationid=medicationgroupbody.attr('id').replace('MEDICATIONGROUP_','').replace('_',':');var medtable=sectioncontainerjq.find("div#PATIENTMEDICATIONDATATABLE");CallRemote({SUB:'Clinical::Patient::MedicationList::GetMedicationHTML',ARGS:{IDLIST:needtoload,HEADERMEDICATIONID:headermedicationid,PATIENTID:medtable.attr('patientid'),CHARTID:medtable.attr("chartid"),CLINICALENCOUNTERID:medtable.attr('clinicalencounterid')},ONFINISH:function(data){if(!sectioncontainerjq.find('tr#'+needtoloadnames[0]).size()){medicationgroupbody.append(data);}
jQuery.each(needtoloadnames,function(index,rowname){var row=sectioncontainerjq.find('tr#'+rowname);if(args.UNROLL){row.attr('unrolledby',listtoshow);}
else{if(!row.attr('unrolledby')){row.hide();}}});if(args.CHECKBOX){_CheckAllHideBoxes(args.CHECKBOX,rollupcontroljq.attr('medicationid'));}}});}}}
function AllMedicationsHidden(summarycontainer){if(!summarycontainer){return 0;}
var allmedrows=GetChildren(summarycontainer,'className',/medicationbullet/);var hiddenmedrows=GetChildren(summarycontainer,'className',/hiddenmed/);if(hiddenmedrows.length&&hiddenmedrows.length==allmedrows.length){return 1;}
return 0;}
function ToggleAllMedsHidden(summarycontainer,hiddenmedsvisible){if(summarycontainer.id!='SUMMARYCONTAINER'){summarycontainer=GetChild(summarycontainer,'id','SUMMARYCONTAINER');}
var allmedshiddendiv=GetChild(summarycontainer,'id','ALLMEDSHIDDEN');if(allmedshiddendiv){if(AllMedicationsHidden(summarycontainer)&&!hiddenmedsvisible&&allmedshiddendiv.nomessages){allmedshiddendiv.style.display='block';}
else{allmedshiddendiv.style.display='none';}}}
function ShowHiddenOverrideWarnings(checkbox){if(!checkbox){return;}
var displayvalue=checkbox.checked?'block':'none';var maybesectioncontainer=jQuery(GetSectionContainer(checkbox));maybesectioncontainer.find('div[override=1]').css('display',displayvalue);}
function HideMedicationDisclaimer(link,hidefieldname){var container=link.parentNode;container.style.display='none';var hidefield=jQuery(container).find("[name='"+EscapeJQuerySelector(hidefieldname)+"']").get(0);if(hidefield){hidefield.value=1;}}
function SaveMedicationFormFields(container,object){var fields=jQuery('input,textarea,select',object);var savedfields={};savedfields.newmeds=[];savedfields.lastaddedrow=jQuery("table:first[id='PATIENTMEDICATIONCART']",container).get(0).lastaddedrow;var tablerows=jQuery('tr',object);tablerows.each(function(index){if(this.id&&this.id.match(/^{NEW}/)){var clonednode=this.cloneNode(true);var jqclonednode=jQuery(clonednode);jQuery('input',this).each(function(index){jqclonednode.find(EscapeJQuerySelector('input[name="'+this.name+'"]')).attr("value",this.value);});jQuery('select',this).each(function(index){jqclonednode.find(EscapeJQuerySelector('select[name="'+this.name+'"]')).children(EscapeJQuerySelector('option[value="'+this.value+'"]')).attr("selected",'selected');});jQuery('textarea',this).each(function(index){jqclonednode.find(EscapeJQuerySelector('textarea[name="'+this.name+'"]')).attr("value",this.value);});savedfields.newmeds.push(clonednode);}});fields.each(function(index){if((/ISSIGSTRUCTURED/.test(this.name)||this.type!='hidden'||this.savedfield)&&this.name&&!this.name.match(/^{NEW}/)){var value;if(this.type=='checkbox'){value=this.checked?'1':'';}else{value=this.value;}
var id;if(/ISSIGSTRUCTURED/.test(this.name)){id=/ISSIGSTRUCTURED_(\d+)$/.exec(this.name)[1];}
savedfields[this.name]={};savedfields[this.name].type=this.type;savedfields[this.name].value=value;if(id){savedfields[this.name].editable=!jQuery('span[name="{EXISTING}PATIENTMEDICATION_SIGFROZEN_'+id+'"]').is(':visible');}}});return savedfields;}
function RestoreMedicationFormFields(container,object,savedfields){var fields=jQuery('input,textarea,select',object);fields.each(function(){if(this.type!='hidden'){if(savedfields[this.name]&&InList(savedfields[this.name].type,[this.type,'hidden'])){if(this.type=='checkbox'){this.checked=savedfields[this.name].value?true:false;if(this.checked){if(this.name.match(/^{EXISTING}.+?_HIDE_/)){var id=/^{EXISTING}.+?_HIDE_(\d+)$/.exec(this.name)[1];jQuery('#'+EscapeJQuerySelector('{EXISTING}PATIENTMEDICATION_HIDEOPTION_'+id)).removeClass('invisible');}}}else{this.value=savedfields[this.name].value;}
delete savedfields[this.name];}}
else{if(/ISSIGSTRUCTURED/.test(this.name)){this.value=savedfields[this.name].value;var id=/ISSIGSTRUCTURED_(\d+)$/.exec(this.name)[1];if(savedfields[this.name].editable){jQuery('span[name="{EXISTING}PATIENTMEDICATION_SIGFROZEN_'+id+'"]').hide();if(this.value=='Y'){jQuery('span[name^="{EXISTING}PATIENTMEDICATION_SIG"][name$="_STRUCTURED_'+id+'"]').show();jQuery('span[name^="{EXISTING}PATIENTMEDICATION_SIG"][name$="_UNSTRUCTURED_'+id+'"]').hide();}
else{jQuery('span[name^="{EXISTING}PATIENTMEDICATION_SIG"][name$="_UNSTRUCTURED_'+id+'"]').show();jQuery('span[name^="{EXISTING}PATIENTMEDICATION_SIG"][name$="_STRUCTURED_'+id+'"]').hide();}}
