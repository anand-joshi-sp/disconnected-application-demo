function ProcessInChunks(items,process,context,callback){Assert(isFunction(process),"Missing argument 'process' in ProcessInChunks.");Assert(isEmpty(items)||isArray(items),"Invalid argument 'items' in ProcessInChunks.");if(isArray(items)&&items.length<1){if(isFunction(callback)){callback(items);}
return;}
var todo=items.concat();setTimeout(function(){var start=+new Date();do{process.call(context,todo.shift());}while(todo.length>0&&(+new Date()-start<50));if(todo.length>0){setTimeout(arguments.callee,0);}else{if(isFunction(callback)){callback(items);}}},25);}
