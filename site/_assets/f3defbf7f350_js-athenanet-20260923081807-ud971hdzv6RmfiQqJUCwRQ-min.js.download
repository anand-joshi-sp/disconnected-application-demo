function LogSnomedSelect(searchobj){var snomedcode=searchobj.autocompletionvalue;var searchstring=searchobj.searchstring;var resultslist=searchobj.popuparrayvalues;var searchtype;if(!searchstring){searchtype='DEFAULTDROPDOWN';}
else if(searchstring.match(/^[BEMNSV]?[0-9.]{3,}$|^MRF$|^EPS$/i)){searchtype='ICD9';}
else{searchtype='KEYWORDSEARCH';}
var position=0;for(var i=0;i<resultslist.length;i++){var code=resultslist[i];if(code==snomedcode){position=i-1;break;}}
var logargs={SNOMEDCODE:snomedcode,SEARCHSTRING:searchstring,SEARCHTYPE:searchtype,POSITION:position};var chartid=GetChartID();if(chartid){logargs['CHARTID']=chartid;}
if(window.encounterid){logargs['CLINICALENCOUNTERID']=window.encounterid;}
CallRemote({SUB:'Clinical::Picker::SnomedSearch::LogSnomedSelect',ARGS:logargs});}
function AddRowInSectionsTable(table,cellcontents,fromlast,rowid,colspan,column){if(!fromlast){fromlast=1;}
var indexoflastrow=table.rows.length;var row=table.insertRow(indexoflastrow-fromlast);if(rowid){row.id=rowid;}
for(var i=0;i<cellcontents.length;i++){var cell=row.insertCell(-1);if(colspan&&column==i){cell.setAttribute('colSpan',colspan);}
cell.innerHTML=cellcontents[i];}
var jqtable=jQuery(table);var lastaddedrow=parseInt(jqtable.attr('lastaddedrow'));jqtable.attr('lastaddedrow',lastaddedrow+1);return row;}
function SetDelayBeforeFocus(inputobject,delay){if(!delay){delay=10;}
setTimeout(function(){try{inputobject.focus();}catch(e){}},delay);}
function PopulateFaxNumber(clinicalproviderlookup,faxnumberfield){var selectedclinicalprovidername=clinicalproviderlookup.autocompletionname;if(selectedclinicalprovidername.match(/Fax ([ 0-9()-]+)/i)){faxnumberfield.value=RegExp.$1;}else{faxnumberfield.value='';}}
function GetObjectLength(obj){if(typeof obj=='object'){var length=0;for(var property in obj){length++;}
return length;}}
function RollupAll(checkbox,encountersection){var rollupstate=checkbox.checked?'expand':'collapse';var tablerows=GetParent(checkbox,'tagName','tbody').children;var tablerowscount=tablerows.length;for(var i=0;i<tablerowscount;i++){var row=tablerows[i];if(row.getAttribute('id')=='PARAGRAPHCONTAINER'){var rollupspan=row.children[0].children['rollupspan'];if(rollupspan.tagName=='SPAN'&&rollupspan.className==rollupstate){Rollup(rollupspan,encountersection);}}}}
function Rollup(rollupbox,encountersection){var section=GetTemplateContainer(rollupbox);if(!section)section=document;var allrows=jQuery(section).find('tr,td').filter('#SENTENCECONTAINER');var rows=[];var rollupboxjq=jQuery(rollupbox);var templateidattr=rollupboxjq.attr('templateid');var paragraphidattr=rollupboxjq.attr('paragraphid');if(templateidattr){for(var i=0;i<allrows.length;++i){var row=jQuery(allrows[i]);if(row.attr('paragraphid')==paragraphidattr&&row.attr('templateid')==templateidattr){rows.push(allrows[i]);}}}
else if(rollupboxjq.attr('documentid')){for(var i=0;i<allrows.length;++i){var row=jQuery(allrows[i]);if(row.attr('paragraphid')==paragraphidattr&&row.attr('documentid')==rollupboxjq.attr('documentid')){rows.push(allrows[i]);}}}
else{for(var i=0;i<allrows.length;++i){var row=jQuery(allrows[i]);if(row.attr('paragraphid')==paragraphidattr){rows.push(allrows[i]);}}}
if(rollupbox.className=='expand'){for(var i=0;i<rows.length;++i){if(GetChild(rows[i],'name',/EXAMVALUE_-?\d+/,'value',/NORMAL|ABNORMAL|NEUTRAL|1/))return;if(GetChild(rows[i],'name',/EXAMSENTENCEFREETEXT_-?\d+/,'value',/[^ ]+/))return;}}
var rollupvaluename='EXAMVALUEPARAGRAPHROLLUP_'+paragraphidattr;if(templateidattr)rollupvaluename='HPI_'+rollupvaluename+'_'+templateidattr;var paragrapharrow;if(encountersection!='PhysicalExam_Grid'){var rollupcontent=rollupbox.getElementsByTagName('span');var rollupcontentsize=rollupcontent.length;for(var j=0;j<rollupcontentsize;j++){if(rollupcontent[j].getAttribute('id')=='paragrapharrow'){paragrapharrow=rollupcontent[j];}}}
if(rollupbox.className=='expand'){rollupbox.className='collapse';jQuery('span#rollup',rollupbox).removeClass().addClass('sprite-plus');if(encountersection!='PhysicalExam_Grid'){paragrapharrow.className='sprite-play-m-FFF';}
GetChild(rollupbox.parentNode.parentNode,'name',new RegExp(rollupvaluename)).value=paragraphidattr;}
else{rollupbox.className='expand';jQuery('span#rollup',rollupbox).removeClass().addClass('sprite-minus');if(encountersection!='PhysicalExam_Grid'){paragrapharrow.className='sprite-play-down-m-FFF';}
GetChild(rollupbox.parentNode.parentNode,'name',new RegExp(rollupvaluename)).value='';}
if(rows.length){if(rollupbox.className=='expand'){jQuery(rows).show();}
else{jQuery(rows).hide();}}}
function GetBlankLetterRowIndex(sourceobject){return jQuery('.lettertablerow',sourceobject).index(jQuery('.headerrow[recipientclass!=Patient]',sourceobject))+1;}
