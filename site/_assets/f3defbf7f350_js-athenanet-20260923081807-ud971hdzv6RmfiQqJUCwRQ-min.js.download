else if(jQuery('input[name="'+EscapeJQuerySelector(args.PREFIX+'{TYPE}')+'"]:checked').val()==='ADMINISTER'){checkbox=document.getElementById("checkbox_yesno_"+args.PREFIX+"{HASBEENADMINISTERED}");clinicalvaccinesiteid=document.getElementById(args.PREFIX+"{CLINICALVACCINESITEID}");lotnumber=document.getElementById(args.PREFIX+"{LOTNUMBER}");manufacturer=jQuery("select[name='"+EscapeJQuerySelector(args.PREFIX+'{MVX}')+"']").get(0);administeredquantity=document.getElementById(args.PREFIX+"{QUANTITY}");administeredunits=document.getElementById(args.PREFIX+"{NDC}");}
else{return true;}
if(!args.IGNOREADMINISTEREDCHECKBOX&&!hasBeenAdministered){return true;}
else if(args.ADMINISTEREDQUANTITYREQUIRED&&administeredquantity&&(!isNumber(parseFloat(administeredquantity.value))||parseFloat(administeredquantity.value)===0)&&_IsVaccineFieldRequiredForAdministration('QUANTITY',args.ISEXISTINGADMINISTRATION,args.EXISTINGADMINISTRATIONDETAILS)){errormessage='Please Enter Administered Quantity';focuselement=administeredquantity;}
else if(args.ADMINISTEREDQUANTITYREQUIRED&&administeredunits&&jQuery(administeredunits).is(':visible')&&!administeredunits.value&&_IsVaccineFieldRequiredForAdministration('DISPLAYQUANTITYUNITS',args.ISEXISTINGADMINISTRATION,args.EXISTINGADMINISTRATIONDETAILS)){errormessage='Please Enter Administered Units';focuselement=administeredunits;}
else if(date&&jQuery(date).hasClass('InvalidInput')){errormessage='Please Enter Valid Date';focuselement=date;}
else{missingadministrationfields=[];if(!TrimWhitespace(lotnumber.value)&&_IsVaccineFieldRequiredForAdministration('LOTNUMBER',args.ISEXISTINGADMINISTRATION,args.EXISTINGADMINISTRATIONDETAILS)){missingadministrationfields.push('Lot Number');focuselement=focuselement||lotnumber;}
if((!manufacturer.value||manufacturer.value==='UNK')&&_IsVaccineFieldRequiredForAdministration('MVX',args.ISEXISTINGADMINISTRATION,args.EXISTINGADMINISTRATIONDETAILS)){missingadministrationfields.push('Manufacturer');focuselement=focuselement||manufacturer;}
if(!clinicalvaccinesiteid.value&&_IsVaccineFieldRequiredForAdministration('CLINICALVACCINESITEID',args.ISEXISTINGADMINISTRATION,args.EXISTINGADMINISTRATIONDETAILS)){missingadministrationfields.push('Site');focuselement=focuselement||clinicalvaccinesiteid;}
if(visgiven&&visgiven.length){visgiven.each(function(){if(jQuery(this).is(':checked')){atLeastOneVISGiven=true;}});if(!atLeastOneVISGiven&&_IsVaccineFieldRequiredForAdministration('VISGIVEN',args.ISEXISTINGADMINISTRATION,args.EXISTINGADMINISTRATIONDETAILS)){missingadministrationfields.push('VIS Given');focuselement=focuselement||visgiven.get(0);}}
else if(visgiven.length===0&&_IsVaccineFieldRequiredForAdministration('VISGIVEN',args.ISEXISTINGADMINISTRATION,args.EXISTINGADMINISTRATIONDETAILS)){missingadministrationfields.push('VIS Given');}
