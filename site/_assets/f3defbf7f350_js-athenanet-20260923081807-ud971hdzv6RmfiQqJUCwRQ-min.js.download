if(rowelement.cells[5].innerHTML!=''&&rowelement.rowIndex>1){var prevrow=rowelement.parentElement.parentElement.rows[rowelement.rowIndex-1];if(prevrow){var prevrelationvalue;var prevkeyidvalue;var rowid=prevrow.id;var nextrowflag=true;if(rowid.toString().match(/^NEW_/)){nextrowflag=false;}
