ABORYN{A0}' shortname='Preterm Labor' title='Preterm Labor' type=SELECT><option value=''><option value='Y' >Yes<option value='N' >No</select>";cellobj=rowobj.insertCell(-1);cellobj.innerHTML="<textarea name='HISTORICALPREGNANCIES_NOTES{A0}' autoresizing='1' class='autoresize_expandable autoresizinginput' cols='10' maxlength='2000' maxrows='3' minrows='1' onkeydown=\"MaxLengthTA(this,2000);ScrollHeightResize(this);\" onkeyup=\"MaxLengthTA(this,2000);ScrollHeightResize(this);\" onpaste=\"var thisalias = this; setTimeout(function () { MaxLengthTA(thisalias,2000) },0)\" rows='1' shortname='Notes' title='Comments / Complications' type='TEXTAREA'></textarea>";cellobj=rowobj.insertCell(-1);cellobj.innerHTML="<span>hx</span>";cellobj=rowobj.insertCell(-1);cellobj.innerHTML="<span class='sprite-del-16x16' style='cursor:pointer' title='delete row' border=0 onclick='DeleteHistoricalPregnancyRow(\"HISTORICPREGNANCIES\", this);'></span><span class='sprite-add' style='cursor:pointer' title='add row' onclick='AddHistoricalPregnancyRow(this);'></span>";lastrowobj.cells[lastrowobj.cells.length-1].innerHTML="";return;}
var cellobj=rowobj.insertCell(-1);cellobj.innerHTML=emptycellhtml;for(var i=1;i<lastrowobj.cells.length;i++){var emptycell=jQuery(lastrowobj.cells[i]).clone();emptycell.html(emptycell.html().replace(/{A\d+}/g,'{A'+datarowindex+'}'));emptycell.html(emptycell.html().replace(/selected/,''));emptycell.html(emptycell.html().replace(/(<input.*?)value=('[^']+'|"[^"]+"|[^\s>]*)/ig,'$1'));emptycell.html(emptycell.html().replace(/(<textarea.*>)(.*)(<\/textarea>)/ig,'$1$3'));emptycell.find("input[data-type='DATE']").removeClass('hasDatepicker').attr('id','').removeData('datepicker').unbind();jQuery(rowobj).append(emptycell);}
