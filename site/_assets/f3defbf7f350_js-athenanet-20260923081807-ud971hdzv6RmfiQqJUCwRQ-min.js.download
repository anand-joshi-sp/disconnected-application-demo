var $nextselect=jQuery($lineselects.get(nextindex));var manuallyeditedmaps=jQuery('input[name=MANUALLYEDITEDMAPS]').first().val();if($select.val()!=''){if(inputclassname=='mappeddiagref'&&manuallyeditedmaps==0){}
else{$nextselect.parents('.chargeline').first().removeClass('hidden');$nextselect.removeClass('hidden');}}}
