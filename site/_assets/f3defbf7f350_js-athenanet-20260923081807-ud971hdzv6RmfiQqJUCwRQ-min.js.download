function SyncShownTemplates(section,showall,common){var sectionname=jQuery(section).attr('sectionname');sectionname=sectionname.replace("_Grid","");var sectionlink=jQuery('#'+sectionname+'Link',section).get(0);if(!sectionlink){return;}
var sectionheader=jQuery('[id^="'+sectionname+'"][id$=_checkboxes]:first',section);var alltemplates=(sectionname=='ProcedureDocumentation')?jQuery('input:checkbox[name^="checkbox_yesno_SELECTED"]',sectionheader):jQuery('input:checkbox',sectionheader);var alltemplatesjq=jQuery(alltemplates);var commontemplates=alltemplatesjq.filter('[common=1]');var notcommontemplates=alltemplatesjq.filter('[common!=1]');var checkednotcommontemplates=jQuery(notcommontemplates).filter(':checked');if(commontemplates.length===0){sectionlink.onclick='';jQuery(sectionlink).addClass('disabledlink');return;}
var toggletoshowall;if(showall||(checkednotcommontemplates.length>0)){toggletoshowall=1;}
else if(common){toggletoshowall=0;}
else{var hiddenfieldjq=jQuery('[name="'+sectionname.toUpperCase()+'.SHOWALL"]',section);toggletoshowall=(hiddenfieldjq.val()=='1')?1:0;}
var numbervisible=0;var templatestotoggle=jQuery(notcommontemplates).parents('span[toptemplatespan]');if(toggletoshowall){sectionlink.innerText='Show Most Used';templatestotoggle.show();numbervisible=alltemplates.length;}
else{sectionlink.innerText='Show All';templatestotoggle.hide();numbervisible=commontemplates.length;}
var templatestodistribute=[];alltemplatesjq.each(function(){templatestodistribute.push(jQuery(this).parents('span:first[toptemplatespan]').get(0));});var visiblesofar=0;var leftcolumn=jQuery('#left',sectionheader);var middlecolumn=jQuery('#middle',sectionheader);var rightcolumn=jQuery('#right',sectionheader);leftcolumn.empty();middlecolumn.empty();rightcolumn.empty();jQuery(templatestodistribute).each(function(){if(this.outerHTML=='<br>'){next;}
var includebreak=0;if(toggletoshowall){visiblesofar++;includebreak=1;}
else{var checkboxjq=(sectionname=='ProcedureDocumentation')?jQuery('input:checkbox[name^="checkbox_yesno_SELECTED"]',this):jQuery('input:checkbox',this);if(checkboxjq.attr('common')){visiblesofar++;includebreak=1;}}
var targetcolumn;if(visiblesofar<Math.ceil(numbervisible/3)+1){targetcolumn=leftcolumn;}
else if(visiblesofar<Math.ceil(2*numbervisible/3)+1){targetcolumn=middlecolumn;}
else{targetcolumn=rightcolumn;}
jQuery(this).appendTo(targetcolumn);if(includebreak){jQuery('<br>').appendTo(targetcolumn);}});return toggletoshowall;}
function ValidateNumericFields(fieldcaption,field){if(!document.hasFocus()){return false;}
field.value=TrimWhitespace(field.value);if((field.value!=''&&isNaN(field.value))||field.value<0){alert(fieldcaption+' must be valid number');setTimeout(function(){field.focus();},0);return false;}}
function ValidateNumericFieldWithMax(fieldcaption,field,max){if(!document.hasFocus()){return false;}
ValidateNumericFields(fieldcaption,field);if(field.value>max){alert('Enter a value for '+fieldcaption+' that does not exceed '+max);setTimeout(function(){jQuery(field).focus();},0);return false;}}
function ValidateField(args){AssertFields(args,['FIELD'],['TYPE','DISPLAYNAME','DISPLAYMESSAGE','LOWERLIMIT','UPPERLIMIT','MODE','FIELDREGEXP','SILENT','SECTION','SECTIONFORMHASH','REQUIRED','BEFOREALERT']);var container=args.SECTION?args.SECTION:document;var field;if(isObject(args.FIELD)){field=args.FIELD;}else{if(args.FIELDREGEXP){field=new Array();var namefilter=EscapeJQuerySelector('[name^="'+args.FIELD+'"]');var selectors=jQuery.map(['input','textarea','select','button'],function(type){return type+namefilter});var tempfields=JQueryMultiFind(selectors,container);for(var i=0;i<tempfields.length;i++){if(tempfields[i].name.match(args.FIELD+"{"+"\\d+"+"}")){field.push(tempfields[i]);}}}
else{field=FindField(args.FIELD,container);}}
if(isArray(field)){for(i=0;i<field.length;i++){args.FIELD=field[i];var copyofargs=new Object();for(var p in args){copyofargs[p]=args[p];}
if(!_ValidateFieldObject(copyofargs)){return false;}}
return true;}else if(field){args.FIELD=field;return _ValidateFieldObject(args);}
else{return true;}}
function FindField(fieldname,container){var types=['input','textarea','select','button'];var firstfield;var namefilter=EscapeJQuerySelector('[name="'+fieldname+'"]');var idfilter=EscapeJQuerySelector('#'+fieldname);for(var i=0;i<types.length;i++){var selector=types[i]+namefilter+","+types[i]+idfilter;firstfield=jQuery(selector,container).get(0);if(firstfield)
break;}
return firstfield;}
function ValidateFields(args){AssertRequiredFields(args,['FIELDSPECS']);AssertValidFields(args,['FIELDSPECS','SECTION','SECTIONFORMHASH']);var section=args.SECTION?args.SECTION:GetSectionContainer();var myvalidator=ValidateField;for(var i=0;i<args.FIELDSPECS.length;i++){var fieldspec=args.FIELDSPECS[i];fieldspec.SECTION=section;fieldspec.SECTIONFORMHASH=args.SECTIONFORMHASH;if(!myvalidator(fieldspec)){return false;}}
return true;}
function _ValidateFieldObject(args){var field=args.FIELD;var type=args.TYPE;if(args.REQUIRED&&TrimWhitespace(field.value)==''){args.TYPE='NONNULL';_AlertFieldObject(args);return false;}
if(type=='DATE'){return SetDate(0,field,1);}
if(type=='NONNEGATIVE'){if(field.value!=''&&field.value<0){_AlertFieldObject(args);return false;}
type='NUMERIC';}else if(type=='POSITIVE'){if(field.value!=''&&field.value<=0){_AlertFieldObject(args);return false;}
type='NUMERIC';}
if(type=='NUMERIC'){field.value=TrimWhitespace(field.value);if(field.value!=''&&isNaN(field.value)){_AlertFieldObject(args);return false;}
if(args.MODE!=null&&args.MODE=='NONZEROPOSITIVE'){if(field.value!=''&&field.value<=0){_AlertFieldObject(args);return false;}}}
else if(type=='NONNULL'){if(field.value==''){_AlertFieldObject(args);return false;}}
else if(type=='NUMERICRANGE'){field.value=TrimWhitespace(field.value);if(field.value!=''&&isNaN(field.value)){_AlertFieldObject(args);return false;}
if(isNaN(args.LOWERLIMIT)||isNaN(args.UPPERLIMIT)){return true;}
if((parseInt(field.value)<parseInt(args.LOWERLIMIT))||(parseInt(field.value)>parseInt(args.UPPERLIMIT))){_AlertFieldObject(args);return false;}}
return true;}
function _AlertFieldObject(args){if(args.SILENT==1){return;}
if(args.BEFOREALERT){args.BEFOREALERT();}
if(args.TYPE=='NUMERICRANGE'){if(args.DISPLAYNAME){alert('Please enter '+args.DISPLAYNAME+' in range '+args.LOWERLIMIT+'-'+args.UPPERLIMIT);}
else if(args.DISPLAYMESSAGE){alert(args.DISPLAYMESSAGE);}
else{alert('Please enter the value in range '+args.LOWERLIMIT+'-'+args.UPPERLIMIT);}}
else if(args.TYPE=='NUMERIC'&&args.MODE=='NONZEROPOSITIVE'){if(args.DISPLAYNAME){alert(upperCaseFirst(args.DISPLAYNAME)+' must be positive and non-zero.');}
else if(args.DISPLAYMESSAGE){alert(args.DISPLAYMESSAGE);}
else{alert('Please enter a positive, non-zero value');}}
else{if(args.DISPLAYNAME){if(args.TYPE&&args.TYPE!='NONNULL'){alert(upperCaseFirst(args.DISPLAYNAME)+' must be '+args.TYPE.toLowerCase()+'.');}
else{alert('Please enter '+args.DISPLAYNAME.toLowerCase()+'.');}}
else if(args.DISPLAYMESSAGE){alert(args.DISPLAYMESSAGE);}
else{alert('Please enter a '+args.TYPE.toLowerCase()+' value.');}}
if(args.FIELD.type!='hidden'){var summarycontainer=GetSummaryContainer(args.FIELD);if(summarycontainer&&GetRWMode(summarycontainer)=='R'){var rwmodecallback=function(){try{args.FIELD.focus()}catch(e){}};SetRWMode(summarycontainer,'W',rwmodecallback);}
else{try{args.FIELD.focus()}catch(e){}}}}
function TrimSectionTextAreas(args){AssertValidFields(args,['SECTION']);var section=args.SECTION?args.SECTION:GetSectionContainer();jQuery(section).find('input,textarea').each(function(){var $textarea=jQuery(this);if(typeof $textarea.val()==='string'){$textarea.val(TrimWhitespace($textarea.val()));}});}
var cache=top.cache;function CollectData(){var tags=document.getElementsByTagName("a");var textdata='';for(i=0;i<tags.length;i++){if(tags[i].id){var classes=tags[i].className.split(' ');if(classes[0]=='component'){textdata+=tags[i].id+',';textdata+=classes[1]+',';if(classes[1]!='inactive'){textdata+=tags[i].innerText;}
textdata+='\n';}}}
return textdata;}
function updateO2Saturation(obj){if(!obj){return;}
var airtype;var quantityairtypes=['Oxygen','Oxygen at Rest','Ambulating with Oxygen'];if(!obj.name.match(/AIRTYPE/)){airtype=jQuery(obj).siblings('select[name*=AIRTYPE]');}
else{airtype=jQuery(obj);}
var quantity=airtype.siblings("#o2quantity");var emptydiv=airtype.siblings("#emptydiv");if(InList(airtype.val(),quantityairtypes)){if(!quantity.is(":visible")){quantity.show();var overflowtable=jQuery(obj).closest("[overflowtable]");if(jQuery(overflowtable).find('#emptydiv')){emptydiv.hide();}
if(overflowtable){ResizeOverflowTable(overflowtable);airtype.focus();}}}
else{quantity.children('input[name*=OXYGENQUANTITY]').val('');quantity.hide();if(jQuery(overflowtable).find('#emptydiv')){emptydiv.show();}}}
function ConvertWeightObjectToKG(weightobj){if(weightobj.name.match(/WEIGHT\.(\w+)\}?\{/)){var fromunit=RegExp.$1.toLowerCase();if(fromunit=='kg'){return weightobj.value;}
else if(fromunit=='g'||fromunit=='lbs'||fromunit=='oz'){return Unit.ConvertUnits({FROM:fromunit.toLowerCase(),TO:'kg',VALUE:weightobj.value,DONTDIE:true});}
else{return;}}
return;}
function ConvertHeightObjectToM(heightobj){if(heightobj.name.match(/HEIGHT\.(\w+)\}?\{/)){var fromunit=RegExp.$1.toLowerCase();if(fromunit=='m'){return heightobj.value;}
else if(fromunit=='ft'||fromunit=='in'||fromunit=='cm'){return Unit.ConvertUnits({FROM:fromunit.toLowerCase(),TO:'m',VALUE:heightobj.value,DONTDIE:true});}
else{return;}}
return;}
function updateHeightWeightCalculatedVitals(obj){if(!obj){return;}
var relatedobjects;var relatedweightobjects;if(obj.name.match(/(FLOWSHEET\{-?\d+\}\{VITAL\})\{-?\d+\}(\{\w+\})\{VITALS\./)){var prefix=RegExp.$1;var index=RegExp.$2;relatedobjects=jQuery('input[name^="'+prefix+'"][name*="'+index+'{VITALS"]');}
else if(obj.name.match(/^(HISTORICALVITALS|PRE|INTRA|POSTPERIODIC)_VITALS.+\{(\w+)\}$/)){var prefix=RegExp.$1;var index=RegExp.$2;relatedobjects=jQuery('input[name^="'+prefix+'_VITALS"][name$="{'+index+'}"]');}
else if(obj.name.match(/(.*)VITALS\./)){var prefix=RegExp.$1;var sectioncontainer=GetSectionContainer(obj);if(!sectioncontainer){sectioncontainer=document;}
var weightindex=0;var firstweightobj=jQuery(obj).closest("tr").find("input:first[name*='VITALS.WEIGHT'][type='NUMERIC']").get(0);if(firstweightobj){var matches=firstweightobj.name.match(/\{(\d+)\}$/);if(matches){weightindex=matches[1];}}
if(prefix){relatedobjects=jQuery(EscapeJQuerySelector('input[name^="'+prefix+'"][name$="{0}"]'),sectioncontainer);if(weightindex!=0){relatedweightobjects=jQuery(EscapeJQuerySelector('input[name^="'+prefix+'"][name$="{'+weightindex+'}"]'),sectioncontainer);}}
else{relatedobjects=jQuery(EscapeJQuerySelector('input[name$="{0}"]'),sectioncontainer);if(weightindex!=0){relatedweightobjects=jQuery(EscapeJQuerySelector('input[name$="{'+weightindex+'}"]'),sectioncontainer);}}}
else{return;}
var bmifield=jQuery(relatedobjects).filter('input[name*=BMI]').get(0);var bsafield=jQuery(relatedobjects).filter('input[name*=BODYSURFACEAREA]').get(0);if(!bmifield&&!bsafield){return;}
var heightobjects=jQuery(relatedobjects).filter('input[name*=HEIGHT]');var weightobjects;if(relatedweightobjects){weightobjects=jQuery(relatedweightobjects).filter("input[name*='VITALS.WEIGHT']");}
else{weightobjects=jQuery(relatedobjects).filter("input[name*='VITALS.WEIGHT']");}
var weight=0;jQuery(weightobjects).each(function(){var weightinkg=ConvertWeightObjectToKG(this);if(!isNaN(weightinkg)){weight+=weightinkg;}});var height=0;jQuery(heightobjects).each(function(){var heightinm=ConvertHeightObjectToM(this);if(!isNaN(heightinm)){height+=heightinm;}});if(isNaN(height)||height==0||isNaN(weight)||weight==0){if(bmifield){bmifield.value='';}
if(bsafield){bsafield.value='';}}
else{if(bmifield){var bmivalue=(weight/(height*height));bmifield.value=Math.round(bmivalue*10)/10;}
if(bsafield){var bsavalue=Math.sqrt(height*weight/36);bsafield.value=Math.round(bsavalue*100)/100;}}}
function updateAldrete(obj){if(!obj){return;}
if(obj.name.match(/(.*VITALS\.ALDRETE)\.\w+\}?{(\d+)}/)){var prefix=RegExp.$1;var fieldindex=RegExp.$2;}
else{return;}
var parenttable=jQuery(obj).parents("table:first").get(0);var	aldretefields=jQuery('select[name^="'+prefix+'"][name*="{'+fieldindex+'}"]',parenttable);var aldretetotal=jQuery('input[name^='+prefix+'\.TOTAL][name*="{'+fieldindex+'}"]',parenttable);var sum=0;jQuery(aldretefields).each(function(){if(this.value!=null&&this.value!=''){sum+=parseInt(this.value);}});if(aldretetotal){aldretetotal.val(sum);}}
function GetAllInputUniqueIDs(dontsort){var allelements=GetFields(document.zform);var elementuniqueids=[];for(var i=0;i<allelements.length;i++){elementuniqueids.push(allelements[i].uniqueID);}
if(!dontsort){elementuniqueids=elementuniqueids.sort();}
document.initialformelements=elementuniqueids.join(',');}
function FormChanged(container,dontsort){if(!container){container=document.zform;}
var inputs=GetFields(container);var inputuniqueids=[];for(var i=0;i<inputs.length;i++){var input=inputs[i];if(InputValue(input)!=InputDefaultValue(input)){return true;}
inputuniqueids.push(input.uniqueID);}
if(!dontsort){inputuniqueids=inputuniqueids.sort();}
if(document.initialformelements&&document.initialformelements!=inputuniqueids.join(',')){return true;}
return false;}
function CheckValidAutocomplete(selectobject){var jqselectobject=jQuery(selectobject);if(jqselectobject.hasClass('htmlautocomplete')){return AutocompleteValidate(jqselectobject.attr('id'));}
if(!jqselectobject.attr('defaultselectionalways')){ReportError("Function CheckValidAutocomplete only works with autocompletes that always use the default selection.\n"
+"Invalid input's name: "+jqselectobject.attr('name'));return false;}
if(/InvalidInput/.test(selectobject.className)){return false;}
if(!selectobject.autocompleteobj){return true;}
if(selectobject.autocompleteobj.blankok&&selectobject.value==''){return true;}
var completions=selectobject.autocompleteobj.defaultselections[0];for(i=0;i<completions.length;i++){if(completions[i]==selectobject.value){return true;}}
var showalllists=selectobject.autocompleteobj.showalloptions;if(isArray(showalllists)){for(i=0;i<showalllists[0].length;i++){if(showalllists[0][i]==selectobject.value){return true;}}}
return false;}
