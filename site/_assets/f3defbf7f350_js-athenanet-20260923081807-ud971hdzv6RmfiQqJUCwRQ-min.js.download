BasicAdmin.RemoteDeleteOnfinish=function(returnobj,operation,itemname,element,id,refreshondelete){if(returnobj["WARNING"]){jQuery("#adminnoteplaceholder").html(returnobj["WARNING"]).removeClass("adminsuccess").addClass("adminwarning").slideDown("fast",function(){BasicAdmin.ResizeWindow();});return false;}
else if(returnobj["PROCESSFORM"]==1){var numdeleted=jQuery('#numdeleted');var row=element.closest('tr');if(showdeleted){jQuery('div.adminnotificationmessage').slideUp(jsanimationtime_slide_ms);if(operation=='SoftDelete'){BasicAdmin.HideFormDiv();row.addClass('softdeletedtext');numdeleted.html(parseInt(numdeleted.html(),10)+1);}
else if(operation=='SoftUndelete'){row.removeClass('softdeletedtext');numdeleted.html(parseInt(numdeleted.html(),10)-1);}
var child=row.children(':first');child.html(returnobj['LINKTEXT']);BasicAdmin.HighlightRow(row);}
else{if(operation=='SoftDelete'||operation=='Delete'){row.addClass('donotstripe');row.hide(0);numdeleted.html(parseInt(numdeleted.html(),10)+1);jQuery('.lastdeleted').removeClass('lastdeleted');row.addClass('lastdeleted');var note=jQuery('#adminnoteplaceholder');note.removeClass("adminwarning").addClass("adminsuccess")
if(operation=='SoftDelete'){var link=returnobj["LINKTEXT"].replace(/this/,"'.lastdeleted'")
if(link){link=' | '+link;}
note.html("Successfully deleted <"+"strong>"+itemname+"<"+"/strong>"+link).show(0);}
else{note.html("Successfully deleted <"+"strong>"+itemname+"<"+"/strong>").show(0);}
var headrow=jQuery('#headrow');if(headrow.length>0){headrow.children('th').each(function(){jQuery(this).click(function(){jQuery('div.adminnotificationmessage').slideUp(jsanimationtime_slide_ms);});});headrow.attr('id','');}
BasicAdmin.UpdateStriping(row);if(!BasicAdmin.IsReSkin()){note.css({'background-color':BasicAdmin.greentransitioncolor});note.animate({'background-color':BasicAdmin.greennotebackgroundcolor},jsanimationtime_fade_ms);}
var numitems=row.parent().children("tr").not(':hidden').length;if(numitems==0){row.parent().addClass('nowhidden');row.parent().hide(0);var itemtable=jQuery('#itemtable');itemtable.html(itemtable.html()+"<"+"div id='noitems'>No items found<"+"/div>");}}
else if(operation=='SoftUndelete'){jQuery('div.adminnotificationmessage').hide(0);row.show(0);row.removeClass('donotstripe');BasicAdmin.UpdateStriping(row);BasicAdmin.HighlightRow(row);numdeleted.html(parseInt(numdeleted.html(),10)-1);var child=row.children(':first');child.html(returnobj['LINKTEXT']);if(row.parent().hasClass('nowhidden')){row.parent().show(0);jQuery('#noitems').remove();}}}
if(operation!='Delete'){if(parseInt(numdeleted.html(),10)==0){jQuery('#showhidedeleted').hide(0);}
else{jQuery('#showhidedeleted').css('display','inline');}}
BasicAdmin.ResizeWindow();}
else{alert('An error has occured. Please contact the CSC if the problem persists.');}
if(refreshondelete){document.location.reload(true);}}
BasicAdmin.HighlightRow=function(row,updatestripes){var rowandcells=row.add(row.children('td'));if(row.hasClass('AlternateRow')){var color=BasicAdmin.IsReSkin()?BasicAdmin.purplealternaterowcolor:BasicAdmin.greenalternaterowcolor;}
else{var color=BasicAdmin.IsReSkin()?BasicAdmin.purplerowcolor:BasicAdmin.greenrowcolor;}
rowandcells.css({'background-color':BasicAdmin.IsReSkin()?BasicAdmin.purpletransitioncolor:BasicAdmin.greentransitioncolor});var callback=function(){if(updatestripes){BasicAdmin.UpdateStriping(row);}};rowandcells.animate({'background-color':color},jsanimationtime_fade_ms,callback);}
BasicAdmin.UpdateStriping=function(row){var count=0;row.parent().children('tr').each(function(){if(jQuery(this).hasClass('donotstripe')){return true;}
if(count%2==1){jQuery(this).css({'background-color':BasicAdmin.IsReSkin()?BasicAdmin.purplealternaterowcolor:BasicAdmin.greenalternaterowcolor}).addClass('AlternateRow');}
else{jQuery(this).css({'background-color':BasicAdmin.IsReSkin()?BasicAdmin.purplerowcolor:BasicAdmin.greenrowcolor}).removeClass('AlternateRow');}
count++;});}
BasicAdmin.PreviewExistingRow=function(id,displaytableactionargsstring){var row={};row['ID']=id;BasicAdmin.PreviewRow(row,displaytableactionargsstring);}
BasicAdmin.PreviewExistingGlobalRow=function(id,displaytableactionargsstring){var row={};row['ID']=id;row['GLOBAL']=1;BasicAdmin.PreviewRow(row,displaytableactionargsstring);}
BasicAdmin.PreviewNewRow=function(displaytableactionargsstring){if(CheckForm()){var row=FormHash(document.zform);delete row['UNIQUEID'];BasicAdmin.PreviewRow(row,displaytableactionargsstring);}}
BasicAdmin.ResetOriginalHTML=function(args,sync){BasicAdmin.SetPageName();resettingoriginalhtml=1;var url=baseurl+"&FORMONLY=1"+displaytableaction;if(BasicAdmin.pagename){url+="&PAGENAME="+BasicAdmin.pagename;}
var ajaxparam={url:url,success:BasicAdmin.ResetOriginalHTMLCallback,dataType:'html'};if(sync===true){ajaxparam.async=false;}
jQuery.ajax(ajaxparam);}
BasicAdmin.FormChange=function(args){BasicAdmin.SetPageName();if(!BasicAdmin.ActionTaken()){return false;}
dirty=false;var operation;if(args.TYPE=='Update'){operation='nextoperation=Update';}
else if(args.TYPE=='Copy'){operation='nextoperation=Add';}
else if(args.TYPE=='Preview'){operation='nextoperation=Copy';}
else if(args.TYPE=='View'){operation='nextoperation=View';}
var URL=baseurl+operation;if(args.ID!==undefined){URL+="&ID="+args.ID;}
if(args.DISPLAYTABLEACTIONARGS!==undefined){URL+=args.DISPLAYTABLEACTIONARGS;}
URL+="&FORMONLY=1";if(args.GLOBAL){URL+='&GLOBAL=1';}
if(BasicAdmin.pagename){URL+="&PAGENAME="+BasicAdmin.pagename;}
var mydiv=jQuery('#form');loadingindicatortimeoutid=setTimeout(ShowLoadingIndicator,jsanimationtime_slide_ms);BasicAdmin.SetNextOperation(args.TYPE);jQuery.get(URL,{},BasicAdmin.FormChangeCallback,'html');}
BasicAdmin.FilterChange=function(args){BasicAdmin.SetPageName();var url=baseurl+"ITEMTABLEONLY=1&";if(args.DISPLAYTABLEACTIONARGS!==undefined){url+=args.DISPLAYTABLEACTIONARGS+"&";}
if(BasicAdmin.pagename){url+="PAGENAME="+BasicAdmin.pagename+"&";}
if(showdeleted){url+="SHOWDELETEDYN=Y&";}
else
{url+="SHOWDELETEDYN=N&";}
if(showexpired){url+="SHOWEXPIREDYN=Y&";}
else
{url+="SHOWEXPIREDYN=N&";}
if(showinactive){url+="SHOWINACTIVEYN=Y&";}
else
{url+="SHOWINACTIVEYN=N&";}
jQuery('#adminnoteplaceholder').hide();var mydiv=jQuery('#itemtablesection');url+=jQuery('form','#filterform').serialize();loadingindicatortimeoutid=setTimeout(ShowLoadingIndicator,jsanimationtime_slide_ms);jQuery.get(url,function(data){mydiv.empty().html(jQuery("<div/>").append(data).find('#itemtablesection'));},'html')
.always(function(){clearTimeout(loadingindicatortimeoutid);ClearLoadingIndicator();if(typeof BasicAdmin.FilterChangeCallback==="function"){BasicAdmin.FilterChangeCallback();}});}
BasicAdmin.PreviewRow=function(row,displaytableactionargsstring){row['operation']='Preview';var allargs=MakeGetString(row);if(displaytableactionargsstring){allargs+=displaytableactionargsstring;}
row=ParseFragmentURLAsHash(allargs);jQuery.post(baseurl,row,function(response){if(window.previewwindow)window.previewwindow.close();var previewwindow=window.open(GetMDCCompatibleHTMLURL('blank.html'),'previewwindow','scrollbars=yes,resizable=yes,status=yes,height=480,width=720');RunWhenDocumentReady(previewwindow,function(){previewwindow.document.write(response);previewwindow.document.close();previewwindow.focus();});});}
var BasicAdminBuilder={};BasicAdminBuilder.additionalpagekeycheckjson={FILTERHEADER:"FILTERHEADER",FILTERREADONLY:"FILTERREADONLY",NOHEADER:"NOHEADER",ALLOWCOPY:"ALLOWCOPY",HIDEADDNEW:"HIDEADDNEW",HIDESAVEADDANOTHER:"HIDESAVEADDANOTHER",HIDESHOWDELETED:"HIDESHOWDELETED",HIDEEDIT:"HIDEEDIT",HIDEDELETE:"HIDEDELETE",ALLOWPREVIEW:"ALLOWPREVIEW",ALLOWVIEW:"ALLOWVIEW",DUPECHECKINCLUDEDELETED:"DUPECHECKINCLUDEDELETED",DUPECHECKINCLUDEDELETED:"DUPECHECKINCLUDEDELETED",SKIPUNDELETEDUPECHECK:"SKIPUNDELETEDUPECHECK"};BasicAdminBuilder.additionalpagekeytextjson={DUPECHECKCOLUMNS:"DUPECHECKCOLUMNS",DUPECHECKCOLUMNESCAPE:"DUPECHECKCOLUMNESCAPE",DISPLAYTABLECOLUMNS:"DISPLAYTABLECOLUMNS",DISPLAYTABLECOLUMNHEADERS:"DISPLAYTABLECOLUMNHEADERS",DISPLAYTABLENAME:"DISPLAYTABLENAME",ITEMNAME:"ITEMNAME",PAGETITLE:"PAGETITLE",DISPLAYTABLEWRAPCOLUMNS:"DISPLAYTABLEWRAPCOLUMNS",DISPLAYTABLESORTCOLUMNS:"DISPLAYTABLESORTCOLUMNS"};BasicAdminBuilder.CheckForm=function(){var myform=document.zform;var firstemptyinput=GetChild(myform,'tagName',['input','select','textarea'],'className',/\bRequiredField\b/,'value',/^\s*$/);if(firstemptyinput===undefined){firstemptyinput=GetChild(myform,'tagName','input','type','checkbox','className',/\bRequiredField\b/,'checked',false);}
if(firstemptyinput){var fieldidentifier=firstemptyinput.name.split("_");if(fieldidentifier.length>1){if(fieldidentifier[1]=='SIMPLE'){alert("All additional page simple keys/values are required. Either enter a value or delete the row to proceed.");}
else if(fieldidentifier[1]=='COMPLEX'){alert("All additional page complex keys/values are required. Either enter a value or delete the row to proceed.");}
else{if(fieldidentifier[0]=='SELECTVALUE'){alert(fieldidentifier[1]+' is required for '+fieldidentifier[2]+' Field '+fieldidentifier[3]+
' if selected. Either enter the value or delete the row to proceed.');}else if(fieldidentifier[0]=='ATHENAINPUTATTRIBUTE'||fieldidentifier[0]=='HTMLATTRIBUTE'){var fieldlevelattribute=fieldidentifier[0].replace('ATTRIBUTE','');alert(fieldlevelattribute+' is required for '+fieldidentifier[1]+' Field '+fieldidentifier[2]+
' if selected. Either enter the value or delete the row to proceed.');}else{alert(fieldidentifier[0]+' is required for '+fieldidentifier[1]+' Field '+fieldidentifier[2]);}}}else{if(firstemptyinput.name=='SELECTSIMPLEKEY'){alert("All additional page simple keys/values are required. Either enter a value or delete the row to proceed.");}
else if(firstemptyinput.name=='SELECTCOMPLEXKEY'){alert("All additional page complex keys/values are required. Either enter a value or delete the row to proceed.");}else{alert((firstemptyinput.getAttribute('title')||firstemptyinput.name)
+' is required.');}}
try{firstemptyinput.focus();}catch(e){};return false;}
var pagelevelids=['OPTIONSLISTSIMPLE','OPTIONSLISTCOMPLEX'];for(var i=0;i<pagelevelids.length;i++){if(BasicAdminBuilder.IsDuplicateKey({ID:pagelevelids[i]})){return false;}}
if(BasicAdminBuilder.FIELDNAMEARRAY&&BasicAdminBuilder.FIELDNAMEARRAY.length){var fieldarray=['ATHENAINPUTOPTIONS','HTMLOPTIONS'];var fieldtypearray=['EDIT','FILTER'];var fieldnamearray=BasicAdminBuilder.FIELDNAMEARRAY;for(i=0;i<fieldarray.length;i++){for(var j=0;j<fieldtypearray.length;j++){for(var k=0;k<fieldnamearray.length;k++){if(BasicAdminBuilder.IsDuplicateKey({ID:fieldarray[i]+"_"+fieldtypearray[j]+"_"+fieldnamearray[k]})){return false;}}}}
var orderingarray=[];var duplicateindex;var orderingedit=jQuery('.editfield [name ^= "ORDERING_EDIT"]');orderingedit.each(function(){var editordervalue=this.value;if(editordervalue!==undefined&&editordervalue!==''){orderingarray.push(editordervalue);}});if(orderingarray&&orderingarray.length){duplicateindex=BasicAdminBuilder.FindDuplicate({ORDERINGARRAY:orderingarray});if(duplicateindex>=0){alert("Ordering shouldn't be duplicate for Edit Fields");orderingedit.get(duplicateindex).focus();return false;}}
orderingarray=[];var orderingfilter=jQuery('.filterfield [name ^= "ORDERING_FILTER"]');orderingfilter.each(function(){var filterordervalue=this.value;if(filterordervalue!==undefined&&filterordervalue!==''){orderingarray.push(filterordervalue);}});if(orderingarray&&orderingarray.length){duplicateindex=BasicAdminBuilder.FindDuplicate({ORDERINGARRAY:orderingarray})
if(duplicateindex>=0){alert("Ordering shouldn't be duplicate for Filter Fields");orderingfilter.get(duplicateindex).focus();return false;}}}
if(BasicAdminBuilder.ispagename){alert("Page name already exists and should be unique. Please try with new name.");document.zform.PAGENAME.focus();return false;}
if(BasicAdminBuilder.sourcetableind=='Invalid'){alert("Source table does not exists. Please create one to proceed (Refer wiki: ****).");document.zform.SOURCETABLE.focus();return false;}else if(BasicAdminBuilder.sourcetableind=='Duplicate'){alert("Source table entered for page already exists. Please try with other table.");document.zform.SOURCETABLE.focus();return false;}
return true;}
BasicAdminBuilder.FindDuplicate=function(args){var orderingarray=args.ORDERINGARRAY;for(var i=0;i<orderingarray.length-1;i++){for(var j=i+1;j<orderingarray.length;j++){if(orderingarray[i]==orderingarray[j]){return j;}}}
return-1;}
BasicAdminBuilder.IsDuplicateKey=function(args){var id=args.ID;var keys;var orderingarray=[];var duplicateindex;if(id=='OPTIONSLISTSIMPLE'){keys=jQuery('#'+id+' [name $= "SIMPLEKEY"]');}else{keys=jQuery('#'+id+' [inputclass = "AUTOCOMPLETE"]');}
if(keys.length>1){keys.each(function(){orderingarray.push(this.value);});duplicateindex=BasicAdminBuilder.FindDuplicate({ORDERINGARRAY:orderingarray});if(duplicateindex>=0){alert("Duplicate key names are not allowed.");keys.get(duplicateindex).focus();return true;}}
return false;}
BasicAdminBuilder.CheckForUniquePageName=function(args){BasicAdminBuilder.ispagename=false;CallRemote({SUB:'HTML::BasicAdminBuilder::CheckForUniquePageName',ARGS:{PAGENAME:args.PAGENAME},ASYNC:false,ONFINISH:function(pagenamecheck){if(pagenamecheck>0){BasicAdminBuilder.ispagename=true;}}});}
BasicAdminBuilder.CheckForValidSourceTable=function(args){BasicAdminBuilder.sourcetableind='';CallRemote({SUB:'HTML::BasicAdminBuilder::CheckForValidSourceTable',ARGS:{SOURCETABLE:args.SOURCETABLE},ASYNC:false,ONFINISH:function(sourcetablecheck){BasicAdminBuilder.sourcetableind=sourcetablecheck;}});}
BasicAdminBuilder.ToggleView=function(args){var additionalpagecomplexkeysid=jQuery("#ADDITIONALPAGECOMPLEXKEYSID");var link=jQuery("#togglelink");if(additionalpagecomplexkeysid.is(":hidden")){additionalpagecomplexkeysid.show();link.html(args.REPLACEMENTTEXT);}else{additionalpagecomplexkeysid.hide();link.html(args.LINKTEXT);}}
BasicAdminBuilder.AddOptionRow=function(args){var options;var viewtext;var optionsid;var inputtype;var linkid;if(args.VIEW!=undefined){viewtext=args.VIEW;}
if(args.OPTIONSID!=undefined)
{optionsid=args.OPTIONSID;}
if(args.INPUTTYPE!=undefined)
{inputtype=args.INPUTTYPE;}
if(args.LINKID!=undefined){linkid=args.LINKID;}
var advancedpagekeys;if(args.ADVANCEDPAGEHTML){advancedpagekeys=EscapeJS(args.ADVANCEDPAGEHTML);}
options=GetChildren(document.getElementById(optionsid),'tagName','div');if(options){jQuery('#'+linkid).addClass('hidden');}
var previousid=options.length-1;var fieldcount;if(previousid>-1){fieldcount=jQuery(options[previousid]).find('[id ^="valuetag"]').attr('currentid');}
else{fieldcount=0;}
fieldcount++;var changenamefunction;if(viewtext=='field'){changenamefunction="BasicAdminBuilder.ChangeAttributeName({ OPTIONSID : '"+optionsid+"', COUNT : '"+fieldcount+"' })";}
var deleteoptionsicon=jQuery("<span>").attr({"class":'sprite-del-16x16',style:'cursor:pointer',border:0});var deleteoptionslink=jQuery("<a>").attr({id:'deletetag_'+fieldcount,"class":'alignleft'}).click(function(){BasicAdminBuilder.DeleteOptionRow({OPTIONSID:optionsid,FIELDCOUNT:fieldcount,LINKID:linkid});});var addoptionsicon=jQuery("<span>").attr({"class":'sprite-add',style:'cursor:pointer',border:0});var addoptionslink=jQuery("<a>").attr({id:'addtag_'+fieldcount,"class":'addlink'}).click(function(){BasicAdminBuilder.AddOptionRow({VIEW:viewtext,OPTIONSID:optionsid,LINKID:linkid,ADVANCEDPAGEHTML:args.ADVANCEDPAGEHTML,INPUTTYPE:inputtype});changenamefunction;});var optionsdivider=jQuery("<div>").attr({id:'dividetag_'+fieldcount,"class":'divider'});var optionsinput;var optionsvalueinput;var spaninput;spaninput=jQuery("<span>").attr({id:'spantag_'+fieldcount,"class":'alignleft'});if(viewtext&&viewtext=='simple')
{var additionalpagekeyjson=jQuery.extend({},BasicAdminBuilder.additionalpagekeytextjson,BasicAdminBuilder.additionalpagekeycheckjson);optionsinput=jQuery("<select>").attr({name:'SELECTSIMPLEKEY',"class":'RequiredField',id:'dropdowntag_'+fieldcount}).change(function(){BasicAdminBuilder.ChangeInputFormat({SELECTEDVALUE:this.value,OPTIONSID:optionsid,CURRENTID:fieldcount});});jQuery('<option />',{value:'',text:''}).appendTo(optionsinput);for(var val in additionalpagekeyjson){jQuery('<option />',{value:val,text:additionalpagekeyjson[val]}).appendTo(optionsinput);}
optionsvalueinput=jQuery("<textarea>").attr({currentid:fieldcount,name:'SELECTVALUE_SIMPLE',"class":'alignselecttextarea RequiredField',id:'valuetag_'+fieldcount,cols:'50',rows:'2'});spaninput.append(optionsvalueinput);}else{var spanid;var fieldname;var fieldtype;if(viewtext=='field'){var splitoptions=optionsid.split("_");fieldtype=splitoptions[1];fieldname=splitoptions[2];spanid="'autocompletetag_"+inputtype+"_"+fieldtype+"_"+fieldname+"_"+fieldcount+"'";}
else{spanid="'autocompletetag_"+fieldcount+"'";}
optionsinput="<span id="+spanid+">"+args.ADVANCEDPAGEHTML+"</span>";if(viewtext=='field'){optionsvalueinput=jQuery("<textarea>").attr({currentid:fieldcount,type:'text',name:'SELECTVALUE_'+inputtype+'_'+fieldtype+'_'+fieldname,"class":'alignselecttextarea RequiredField',id:'valuetag_'+fieldcount,cols:'50',rows:'2'});}else{optionsvalueinput=jQuery("<textarea>").attr({currentid:fieldcount,name:'SELECTVALUE_COMPLEX',"class":'alignselecttextarea RequiredField',id:'valuetag_'+fieldcount,cols:'50',rows:'2'});}
spaninput.append(optionsvalueinput);}
var deleteelement=deleteoptionslink.append(deleteoptionsicon);var addelement=addoptionslink.append(addoptionsicon);var optionsrow=optionsdivider.append(optionsinput).append(spaninput).append(deleteelement).append(addelement);var optionslist;optionslist=jQuery(document.getElementById(optionsid)).append(optionsrow);optionslist.show();if(viewtext&&viewtext=='simple'){jQuery('#'+optionsid+' [name$= "SIMPLEKEY"]').last().focus();}else{jQuery('#'+optionsid+' [inputclass = "AUTOCOMPLETE"]').last().focus();}}
BasicAdminBuilder.DeleteOptionRow=function(args){var elementid;var options;var optionsid;var linkid;if(args.FIELDCOUNT!=undefined){elementid=args.FIELDCOUNT;}
if(args.OPTIONSID!=undefined){optionsid=args.OPTIONSID;}
if(args.LINKID!=undefined){linkid=args.LINKID;}
options=GetChildren(document.getElementById(optionsid),'tagName','div');if(options.length==1){jQuery(options[0]).remove();jQuery('#'+linkid).removeClass('hidden');}else{var dividetag=jQuery('#'+optionsid).find("#dividetag_"+elementid);if(dividetag)
{dividetag.remove();}}}
BasicAdminBuilder.ChangeInputFormat=function(args){var selecteddropdownvalue;var fieldcount;if(args.SELECTEDVALUE!=undefined){selecteddropdownvalue=args.SELECTEDVALUE;}
if(args.CURRENTID!=undefined){fieldcount=args.CURRENTID;}
var options=GetChildren(document.getElementById(args.OPTIONSID),'tagName','div');var optionvalue=jQuery(options).find("#valuetag_"+fieldcount);var optionsvalueinput;if(selecteddropdownvalue in BasicAdminBuilder.additionalpagekeycheckjson&&jQuery(optionvalue).is('textarea')){optionvalue.innerHTML="";optionvalue.remove();optionsvalueinput=jQuery("<input>").attr({currentid:fieldcount,type:'checkbox',name:'SELECTVALUE_SIMPLE',"class":'RequiredField',id:'valuetag_'+fieldcount});jQuery(options).find("#spantag_"+fieldcount).append(optionsvalueinput);}else if(selecteddropdownvalue in BasicAdminBuilder.additionalpagekeytextjson&&jQuery(optionvalue).is('input')){optionvalue.innerHTML="";optionvalue.remove();optionsvalueinput=jQuery("<textarea>").attr({currentid:fieldcount,name:'SELECTVALUE_SIMPLE',"class":'alignselecttextarea RequiredField',id:'valuetag_'+fieldcount,cols:'50',rows:'2'});jQuery(options).find("#spantag_"+fieldcount).append(optionsvalueinput);}}
BasicAdminBuilder.ChangeFieldType=function(args){if(args.HIDEFILTER!=undefined&&args.HIDEFILTER=='Filter'){jQuery('#fieldblock').find('[id ^= "FILTER"]').hide();}
if(args.LINK!=undefined){var link=args.LINK;var currentfieldname=link.name.split("_").pop();var editfieldblock=jQuery("#EDIT_"+currentfieldname);var filterfieldblock=jQuery("#FILTER_"+currentfieldname);var filtersql=filterfieldblock.find('[name^="SQL"]');var filterordering=filterfieldblock.find('[name^="ORDERING"]');var editsql=editfieldblock.find('[name^="SQL"]');var editordering=editfieldblock.find('[name^="ORDERING"]');if(link.value=='BOTH'){if(editfieldblock.is(":hidden")){editfieldblock.show();}
if(filterfieldblock.is(":hidden")){filterfieldblock.show();}
filtersql.addClass('RequiredField');filterordering.addClass('RequiredField');if(!editordering.hasClass('RequiredField')){editordering.addClass('RequiredField');}}else if(link.value=='EDIT'){if(editfieldblock.is(":hidden")){editfieldblock.show();}
if(!filterfieldblock.is(":hidden")){filterfieldblock.hide();}
if(filtersql.hasClass('RequiredField')&&(!filtersql.val())){filtersql.removeClass('RequiredField');}
if(filterordering.hasClass('RequiredField')&&(!filterordering.value)){filterordering.removeClass('RequiredField');}
if(!editordering.hasClass('RequiredField')){editordering.addClass('RequiredField');}}else if(link.value=='NONE'){if(!filterfieldblock.is(":hidden")){filterfieldblock.hide();}
if(!editfieldblock.is(":hidden")){editfieldblock.hide();}
if(filtersql.hasClass('RequiredField')&&(!filtersql.val())){filtersql.removeClass('RequiredField');}
if(filterordering.hasClass('RequiredField')&&(!filterordering.value)){filterordering.removeClass('RequiredField');}
if(!editordering.value){editordering.removeClass('RequiredField');}}}}
BasicAdminBuilder.ChangeAttributeName=function(args){if(args.OPTIONSID!=undefined){var optionsid=args.OPTIONSID;var keywords=optionsid.split("_");args.COUNT++;var spanid='autocompletetag_'+keywords[0].replace('OPTIONS','')+'_'+keywords[1]+'_'+keywords[2]+'_'+args.COUNT;var newname=optionsid.replace('OPTIONS','ATTRIBUTE');;jQuery('#'+spanid).children().attr('name',newname);}}
BasicAdminBuilder.CheckForAdvancedViewDisplay=function(){if(jQuery("#OPTIONSLISTCOMPLEX .divider").length){BasicAdminBuilder.ToggleView({LINKTEXT:'Switch to Advanced View',REPLACEMENTTEXT:'Switch to Simple View'});}}
function SmallModalPopupWindow(args){var dimensions=_ConvertToStandardModalWidthHeight({size:'SMALL'});args.width=dimensions.width;args.height=dimensions.height;return ModalPopupWindow(args);}
function MediumModalPopupWindow(args){var dimensions=_ConvertToStandardModalWidthHeight({size:'MEDIUM'});args.width=dimensions.width;args.height=dimensions.height;return ModalPopupWindow(args);}
function LargeModalPopupWindow(args){var dimensions=_ConvertToStandardModalWidthHeight({size:'LARGE'});args.width=dimensions.width;args.height=dimensions.height;return ModalPopupWindow(args);}
function ExtraWideModalPopupWindow(args){var dimensions=_ConvertToStandardModalWidthHeight({size:'EXTRAWIDE'});args.width=dimensions.width;args.height=dimensions.height;return ModalPopupWindow(args);}
function ModalPopupWindow(args){if(!(args.width||args.height)){var dimensions=_ConvertToStandardModalWidthHeight({size:'SMALL'});if(!args.width)args.width=dimensions.width;if(!args.height)args.height=dimensions.height;}
top.AthenaPattern_Popup.open({CONTENTURL:args.page,OVERLAYTYPE:'LIGHTBOX',WIDTH:args.width,HEIGHT:args.height,FULLSCREEN:args.fullscreen,ONCLOSE:args.onclose,CONTAINERARGS:args.additionalargs,NOCLOSEBUTTON:args.noclosebutton,CONTAINERCLASSES:args.classes,DEFER:args.defer,ONSHOW:args.onshow});}
function ReturnFromModalLookup(returnvalue){SetReturnValueFromModal(returnvalue);_CurrentPopupIsNewModal()?top.AthenaPattern_Popup.close(returnvalue):AH.CloseWindow();}
function GetModalArguments(){return _CurrentPopupIsNewModal()?top.AthenaPattern_Popup.get_args():GetModalLookupArguments();}
function _CurrentPopupIsNewModal(){return!!AH.GetGlobal('NEWMODAL');}
function GetModalWindow(){var modaliframe;if(_CurrentPopupIsNewModal()){modaliframe=top.jQuery('iframe#simplemodal-data').get(0);}
return((modaliframe&&modaliframe.contentWindow)||(AH&&AH.Frames&&AH.Frames.Main&&AH.Frames.Main.Frame&&AH.Frames.Main.Frame())||window);}
function SetReturnValueFromModal(returnvalue){if(_CurrentPopupIsNewModal()){top.jQuery('#simplemodal-container').data('returnvalue',returnvalue);}
else{AH.SetGlobal('returnValue',returnvalue);}}
var ClinicalProviderSelector={GatherSelectorObject:function(cpswspan){var newobject={};jQuery.extend(newobject,cpswspan.selectormetafields);jQuery(cpswspan).find('[selectorobjectcomponentname]').not(':disabled').each(function(){var thisjq=jQuery(this);if(thisjq.is(':checkbox')){if(thisjq.prop('checked')){newobject[thisjq.attr('selectorobjectcomponentname')]=this.value;}}
else{newobject[thisjq.attr('selectorobjectcomponentname')]=this.value;}
