jQuery.each(labels,function(){PrintDymoLabel(args.LABELLOCATION,this);});jQuery('#printingmessage').html(message);if(args.ONCOMPLETE)args.ONCOMPLETE(message);},ONERROR:args.ONCOMPLETE?function(){args.ONCOMPLETE('An error occurred while printing your label(s).');}:null});}
