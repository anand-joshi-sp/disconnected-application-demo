if(currentFiltersVisible){jQuery('.jslink.showfilters').click();}
existingfiltersets.replaceWith(jqfiltersets);if(results.ATTRSETS.length>0){if(currentFiltersVisible){jqfilterbox.find('span.showfilters').html("Hide filters");}
else{jqfilterbox.find('span.showfilters').html("Show filters");}}
else{jqfilterbox.find('span.showfilters').html("");model.FILTERSETS.hide(0)}
