function CheckRelationExists(relationobj){var relationset=relationobj.value;var mainmembersarray=new Array('MOTHER','FATHER','MATERNALGRANDMOTHER','MATERNALGRANDFATHER','PATERNALGRANDMOTHER','PATERNALGRANDFATHER');var mainmembersarraysnomed=new Array('Mother','Father','Maternal Grandmother','Maternal Grandfather','Paternal Grandmother','Paternal Grandfather');for(var relationcnt=0;relationcnt<mainmembersarray.length;relationcnt++){if(mainmembersarray[relationcnt]==relationset||mainmembersarraysnomed[relationcnt]==relationset){return true;}}
return false;}
function GetRelationKeyid(relationvalue,oTable){var jqoTable=jQuery(oTable);relationvalue=Trim(""+relationvalue+"");var oRow;var curr_row;var numRows=oTable.rows.length;numRows=numRows-1;var nextrelationid=1;for(curr_row=1;curr_row<numRows;curr_row++){oRow=oTable.rows[curr_row];var currentrelation=Trim(""+oRow.cells[0].innerText+"");if(currentrelation==GetFamilyMemberDescription(relationvalue)){var currentrelationidobj=jqoTable.find(EscapeJQuerySelector("input[name='FAMILYHISTORY{"+oRow.id+"}{RELATIONKEY}']")).get(0);var currentrelationid;if(currentrelationidobj){currentrelationid=currentrelationidobj.value;if(nextrelationid<=currentrelationid){nextrelationid=parseInt(currentrelationid)+1;}
else{nextrelationid++;}}
else{nextrelationid++;}}}
if(nextrelationid){return nextrelationid;}
else{return 1;}}
function GetInsertRowIndex(relationname,oTable,relationkeyid){var jqoTable=jQuery(oTable);var oRow;var curr_row;var numRows=oTable.rows.length;numRows=numRows-1;var nextinsertindex=0;for(curr_row=1;curr_row<numRows;curr_row++){oRow=oTable.rows[curr_row];var relationhiddeninput=jqoTable.find(EscapeJQuerySelector("input[name='FAMILYHISTORY{"+oRow.id+"}{RELATION}']")).get(0);var currrelationanme,currentkeyid;if(relationhiddeninput){currrelationanme=relationhiddeninput.value;currentkeyid=jqoTable.find(EscapeJQuerySelector("input[name='FAMILYHISTORY{"+oRow.id+"}{RELATIONKEY}']")).val();}
else{relationhiddeninput=jqoTable.find(EscapeJQuerySelector("input[name='FAMILYHISTORY{NEW_"+oRow.id+"}{RELATION}']")).get(0);if(relationhiddeninput){currrelationanme=relationhiddeninput.value;currentkeyid=jqoTable.find(EscapeJQuerySelector("input[name='FAMILYHISTORY{NEW_"+oRow.id+"}{RELATIONKEY}']")).val();}}
if(!nextinsertindex){if(relationname==currrelationanme&&relationkeyid==currentkeyid){nextinsertindex=oRow.rowIndex;}}
else{nextinsertindex++;if(currrelationanme!=relationname||relationkeyid!=currentkeyid){return nextinsertindex;}}}
if(nextinsertindex){nextinsertindex++;return nextinsertindex;}
else{return-1;}}
function AddConfidentialInfoRow(obj){var container=GetSectionContainerIfPossible(obj);if(!container){container=document;}
var currentrow=GetParent(obj,'tagName','tr');var currentrowindex=currentrow.rowIndex;var tableobj=jQuery(container).find('table#CONFIDENTIALINFO').get(0);var lastrowindex=tableobj.rows.length-1;if(lastrowindex!=currentrowindex){return true;}
var lastrowobj=tableobj.rows[lastrowindex];lastrowobj.cells[lastrowobj.cells.length-1].innerHTML="<td></td>";var rowobj=tableobj.insertRow(-1);var newth=document.createElement('th');newth.setAttribute('className','chartlabel');rowobj.appendChild(newth);var prevtextarea=GetChild(lastrowobj,'tagName','textarea','name',/CONFIDENTIALINFOLIST_FREETEXT_(\d+)/);var prevnumber=parseInt(RegExp.$1);rowobj.insertCell(1).innerHTML="<TEXTAREA class='autoresize_expandable' onpaste='var thisalias = this; setTimeout(function () { MaxLengthTA(thisalias,4000) },0)' onkeydown='MaxLengthTA(this,4000)' onkeyup='; SetScrollOverflow(this);' style='OVERFLOW-Y: hidden; WIDTH: 100%; HEIGHT: 1.65em; resize: none;' name='CONFIDENTIALINFOLIST_FREETEXT_"+(prevnumber+1)+"' rows='1' type='TEXTAREA' maxlength='4000' minrows='1' maxrows='8' autoresizing='1'></TEXTAREA>";rowobj.insertCell(2).innerHTML="<div class='sprite-del-16x16' title='delete row' style='cursor:pointer;' onclick='DeleteConfidentialInfoRow(this.parentElement.parentElement)'></div></td><td></td>";rowobj.cells[2].setAttribute('width','16');rowobj.insertCell(3).innerHTML="<div class='sprite-add' title='add row' style='cursor:pointer;' onclick='AddConfidentialInfoRow(this)'></div></td></tr>";rowobj.cells[3].setAttribute('width','78');rowobj.cells[3].setAttribute('align','left');}
function DeleteConfidentialInfoRow(deletedrow){var tableobj=deletedrow.parentNode;var deleteindex=deletedrow.rowIndex;if(deleteindex==0&&tableobj.rows.length==1){var rowobj=tableobj.rows[deleteindex];var textarea=GetChild(rowobj,'tagName','textarea','name',/CONFIDENTIALINFOLIST_FREETEXT_(\d+)/);textarea.value='';}
else if(deleteindex==0){var notes=document.createTextNode('Notes');tableobj.rows[1].cells[0].appendChild(notes);tableobj.deleteRow(0);}
else if(deleteindex==tableobj.rows.length-1){var ultrowobj=tableobj.rows[deleteindex];var ulttextarea=GetChild(ultrowobj,'tagName','textarea','name',/CONFIDENTIALINFOLIST_FREETEXT_(\d+)/);var ultnumber=parseInt(RegExp.$1);var penultrowobj=tableobj.rows[deleteindex-1];var penulttextarea=GetChild(penultrowobj,'tagName','textarea','name',/CONFIDENTIALINFOLIST_FREETEXT_(\d+)/);penulttextarea.setAttribute('name','CONFIDENTIALINFOLIST_FREETEXT_'+ultnumber);penultrowobj.cells[3].innerHTML="<div class='sprite-add' title='add row' style='cursor:pointer;' onclick='AddConfidentialInfoRow(this)'></div>";tableobj.deleteRow(deleteindex);}else{tableobj.deleteRow(deleteindex);}}
function CheckProcedure(selectedvalue,startingobject){var container=GetSectionContainer(startingobject);var jqcontainer=jQuery(container);var jqprocedurespanobj=jqcontainer.find('#SURGICALHXPROCEDURECODELOOKUPSPAN');if(jqprocedurespanobj.length){if(selectedvalue=='otherprocedure'){jqprocedurespanobj.css('display','block');try{jqcontainer.find("input[name='SURGICALHISTORYPROCEDURECODELOOKUP']").focus();ReinitializeSpeechEnabledFields();}
catch(e){}}
else{jqprocedurespanobj.css('display','none');var jqlabel=jqcontainer.find('span#PROCEDURECODELABEL');jqlabel.html='[e.g. CABG]';jqlabel.prop('title','');jqcontainer.find("input[name='SURGICALHISTORYPROCEDURECODE']").val('');jqcontainer.find("input[name='SURGICALHISTORYPROCEDURECODELOOKUP']").val('');}}}
