else if(!this.getAttribute('paperformtype')||this.getAttribute('paperformtype')==''){var selectbox=jQuery(EscapeJQuerySelector('[name="DOCUMENTPAPERFORM{'+this.value+'}"]'),container);if(selectbox.val()==''){alert('Please select a paperform.');selectbox.focus();loopreturn=false;}
