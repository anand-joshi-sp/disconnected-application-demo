if(foundkeys){jQuery("<div class='icd10levelheading'>Best match"+bestplural+"<hr class='icd10hr'></div>").insertBefore(jQuery(levelref[0]));}}
if(count==0&&any>0){jQuery("<div class='icd10levelheading'>There are no ICD-10 codes that match the selected attributes.</div>").insertBefore(jQuery(".icd10pickerlevel").first());}
if(count==1){jQuery(".icd10count").text("1 match");}
else{jQuery(".icd10count").text(count+" matches");}
jQuery('#level0icdcodes').parent().scrollTop(0);}
