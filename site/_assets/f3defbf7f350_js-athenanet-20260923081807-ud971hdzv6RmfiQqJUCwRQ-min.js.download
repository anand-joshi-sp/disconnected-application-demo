function OrderSetEnhancedDiagnosesEnabled(){return(OnOrderSetAdminPage())||(OnGlobalOrderSetAdminPage()&&window.CLOE_662_GLOBALORDERSET_IMO);}
function _FetchIMODataFromService(imocodestoquery){return new Promise(function(resolve,reject){if(!OrderSetEnhancedDiagnosesEnabled()||!imocodestoquery.length){var errormessage="There were no IMO codes passed in as arguments";console.log(errormessage);reject();}
var jwt=require('static:/jwt');var imosearchcontext={siteId:GetContextID(),userId:AH.GetGlobal('USERNAME'),sessionId:'00000000-0000-0000-0000-000000000000',setSessionId:function(sessionId){this.sessionId=sessionId;},getJWT:function(scopes){return jwt.getJWT({scopes:scopes});}};window.imoApi&&window.imoApi.getMultipleDetail(imosearchcontext,imocodestoquery).then(function(imoresponsemapping){resolve(imoresponsemapping);});});}
function GetOrderSetSummaryTableICDCodesFromIMO(){var imocodesset={};jQuery('table.manageordersets_dxordersubtable li span[data-imocode]').each(function(){var imocode=jQuery(this).data('imocode');imocodesset[imocode]=true;});var imocodes=Object.keys(imocodesset);var icd10descriptionmapping={};if(imocodes.length){_FetchIMODataFromService(imocodes).then(function(imoresponsemapping){Object.keys(imoresponsemapping).forEach(function(imocode){var imoresponseitem=imoresponsemapping[imocode];var icd10descriptions=imoresponseitem.icd10Terms.map(function(icd10term){return icd10term.code+': '+icd10term.term;});icd10descriptionmapping[imocode]=icd10descriptions;});jQuery('table.manageordersets_dxordersubtable li.imodiagnosissummary').each(function(){var imocodes=[];jQuery(this).find('span[data-imocode').each(function(){var imocode=jQuery(this).data('imocode');if(imocode){imocodes.push(imocode);}});var icd10descriptionArr=imocodes.map(function(imocode){return icd10descriptionmapping[imocode];}).flat();var icd10description=icd10descriptionArr.filter(function(elem,pos,arr){return arr.indexOf(elem)==pos;}).join('; ');if(icd10description){var icd10element=jQuery(this).find('.manageordersets_dxordersubtable_icd10desc');var supplementalicddescription=icd10element.data('supplemental-description');icd10element.text(' ('+icd10description+supplementalicddescription+')');}});});}}
function OrderSetDiagnosisIsEnhancedDiagnosis(ordering){if(!OrderSetEnhancedDiagnosesEnabled()){return false;}
var imodiagnosis=jQuery('[name="ENCOUNTERDIAGNOSIS{'+ordering+'}{IMODIAGNOSIS}"]');var imodiagnosisvalue=imodiagnosis.length&&imodiagnosis.val();if(!imodiagnosisvalue||imodiagnosisvalue==="undefined"||imodiagnosisvalue===""){return false;}
var parsedimodiagnosis=JSON.parse(imodiagnosisvalue);return!!parsedimodiagnosis.length;}
function PrependZeroIfDecimalNumber(raf){if(/^\.\d+/.test(raf)){return"0"+raf;}
return raf;}
function OnChangeDiagnosisCheckbox(ordering){var elementname='ENCOUNTERDIAGNOSIS{'+ordering+'}{DEFAULTCHECKED}';var diagnosischeckbox=document.getElementsByName(elementname)[0];var diagnosisblock=GetParent(diagnosischeckbox,'tagName','div','className');if(diagnosischeckbox){var orders_span=GetChildrenByTagName({CONTEXT:diagnosisblock,TAGNAME:'span',FILTER:[{ATTRIBUTEKEY:'class',ATTRIBUTEVALUE:'orderoptionality'}]});if(!diagnosischeckbox.checked){for(var index=0;index<orders_span.length;index++){orders_span[index].children[0].children[0].checked=false;}}else{for(var index2=0;index2<orders_span.length;index2++){orders_span[index2].children[0].children[0].checked=true;}}}}
function OnChangeOrderCheckbox(orderid,source){var elementid
if(source=='EXISTING'){elementid='ORDER{EXISTING}{'+orderid+'}{ORDERDIV}';}else if(source=='ADD'){elementid='ORDER{NEW}{'+orderid+'}{ORDERDIV}';}
var ordercheckbox=document.getElementById(elementid);var diagnosisblockdx=GetParent(ordercheckbox,'tagName','div','className');var diagnosisCheckbox=GetChildrenByTagName({CONTEXT:diagnosisblockdx,TAGNAME:'td',FILTER:[{ATTRIBUTEKEY:'class',ATTRIBUTEVALUE:'diagnosisbanneroptionality'}]});var orders_span=GetChildrenByTagName({CONTEXT:diagnosisblockdx,TAGNAME:'span',FILTER:[{ATTRIBUTEKEY:'class',ATTRIBUTEVALUE:'orderoptionality'}]});var checkedorderscount=0;for(var index=0;index<orders_span.length;index++){if(orders_span[index].children[0].children[0].checked){checkedorderscount++;}}
if(diagnosisCheckbox[0]&&diagnosisCheckbox[0].children&&diagnosisCheckbox[0].children[0]&&diagnosisCheckbox[0].children[0].children&&diagnosisCheckbox[0].children[0].children[0]){if(checkedorderscount==orders_span.length){diagnosisCheckbox[0].children[0].children[0].checked=true;diagnosisCheckbox[0].children[0].children[0].indeterminate=false;}else if(checkedorderscount==0){diagnosisCheckbox[0].children[0].children[0].checked=false;diagnosisCheckbox[0].children[0].children[0].indeterminate=false;}else{diagnosisCheckbox[0].children[0].children[0].checked=true;diagnosisCheckbox[0].children[0].children[0].indeterminate=true;}}}
function UpdateOptionalityCheckboxForOrderSetDiagnosesToMatchOrders(){if(!IsOrderSetDefaultingEnabled()){return;}
document.querySelectorAll('.orderitem').forEach(function(element){var result=element.id.match(/ORDER{(EXISTING|NEW)}{([0-9]+)}{ORDERDIV}/);if(result){var source=result[1]==='EXISTING'?'EXISTING':'ADD';var orderid=result[2];OnChangeOrderCheckbox(orderid,source);}});}
