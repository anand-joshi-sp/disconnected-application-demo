else if(field.TYPE==="DROPDOWN"||field.TYPE==="TEXTINPUT"){templatedataobj[name]=fieldjqueryobj.val();}
else if(field.TYPE==="DROPDOWNINDEX"){templatedataobj[name]=fieldjqueryobj.prop("selectedIndex");}
else if(field.TYPE==="DISPLAYSTATE"){templatedataobj[name]=fieldjqueryobj.css("display");}
else if(field.TYPE==="RADIO"){templatedataobj[name]=fieldjqueryobj.find('input:checked').val();}});var templateccrows=jQuery(EscapeJQuerySelector("#"+templateprefix+"{DOCUMENTORDERCC}")).find("input[type='text']").filter("[value]").closest("tr");var templateccdata=[];templateccrows.each(function(){templateccdata.push({CLINICALPROVIDERID:jQuery(this).find("[name$='{CLINICALPROVIDERID}']").val(),NAME:jQuery(this).find("[name$='{NAME}']").val(),FAX:jQuery(this).find("[name$='{FAX}']").val()});});templatedataobj["CCPROVIDERS"]=templateccdata;return templatedataobj;}
