function ConfirmHIPAA(){return confirm('HIPAA [45 CFR 164.312(a)(2)(i)] requires that all actions performed within athenaNet be traceable to a specific individual.\nThe creation of any account intended for use by more than one person is non-compliant and therefore not allowed.\nAll such accounts identified will be deactivated and practice managers notified.  Create user?');}
function ConfirmPortalUserUpgrade(){return confirm('By removing the restriction for this provider to only access the provider portal, they will be given access to athenaNet which could include access to patient and other sensitive information. By clicking OK you are confirming that this username is verified to be in possession of this provider to whom you are granting access.');}
function EnableOrDisableComplianceForm(forcestate,type){var enable=isDefined(forcestate)?forcestate:PageChangedSinceLoad();var sas70form=document.getElementById('SAS70COMPLIANCEFORM');if((!isDefined(type)||type==='SAS70')&&sas70form&&sas70form.style.display!='none'){var casenumber=new InputWrapper(document.zform.CASENUMBER);if(enable){casenumber.input.disabled=false;casenumber.AddClass('RequiredField');}
else{casenumber.input.disabled=true;casenumber.input.value='';casenumber.RemoveClass('RequiredField');casenumber.MarkValid();}}
var bpoform=document.getElementById('BPOCOMPLIANCEFORM');if((!isDefined(type)||type==='BPO')&&bpoform&&bpoform.style.display!='none'){var bpoticket=new InputWrapper(document.zform.BPOTICKET);bpoticket.input.disabled=!enable;if(enable){bpoticket.AddClass('RequiredField');}
else{bpoticket.input.value='';bpoticket.RemoveClass('RequiredField');bpoticket.MarkValid();}}}
function HideOrShowComplianceForm(show,type){var complianceform=document.getElementById(type+'COMPLIANCEFORM');if(complianceform){if(show){complianceform.style.display='block';EnableOrDisableComplianceForm(show,type);}
else{EnableOrDisableComplianceForm(show,type);complianceform.style.display='none';}}}
function CheckIfComplianceFormIsRequired(element){var tab=document.zform.TAB;if(tab.value=='PROFILE'){if(document.zform.ORGANIZATIONID.value){CheckIfBPOComplianceFormIsRequired(document.zform.ORGANIZATIONID.value);}
if(document.zform.ORGANIZATIONID.value=='ATHENA'||document.zform.ORGANIZATIONTYPE.value=='VENDOR'){HideOrShowComplianceForm(false,'SAS70');}
else{if(document.zform.INSERTCONTEXTNAME){var contextname=document.zform.INSERTCONTEXTNAME.value;if(contextname){CallRemote({SUB:'UserAdmin::SomeContextLiveMoreThan30Days',ARGS:{CONTEXTIDS:contextname.match(/\[(\d+)\]/)[1]},ONFINISH:function(isrequired){HideOrShowComplianceForm(isrequired,'SAS70');},LOADINGINDICATORFLAG:true});}
else{HideOrShowComplianceForm(false,'SAS70');}}
else{HideOrShowComplianceForm(false,'SAS70');}}}
else if(tab.value=='ROLES'){if(jQuery(element).prop("tagName")!='TABLE'){if(jQuery('#CROSSPRACTICECONTEXTIDS')&&jQuery('#CROSSPRACTICECONTEXTIDS').val()){var practiceids=jQuery('#CROSSPRACTICECONTEXTIDS').val().match(/\d+/g);if(practiceids){jQuery("input[name='SAVE']").attr('disabled',true);CallRemote({SUB:'UserAdmin::SomeContextLiveMoreThan30Days',ARGS:{CONTEXTIDS:practiceids},ONFINISH:function(isrequired){HideOrShowComplianceForm(isrequired,'SAS70');jQuery("input[name='SAVE']").removeAttr('disabled');},LOADINGINDICATORFLAG:true});}
else{HideOrShowComplianceForm(false,'SAS70');}}
else{HideOrShowComplianceForm(false,'SAS70');}}}
else{}}
function InitializeUserProfilePage(tabkey,isscimuser){jQuery('#'+tabkey).show();OrganizationUserPositionArrayJS(document.zform.ORGANIZATIONID,document.zform.POSITIONID,positionid);!isscimuser&&DisableOtherPosition();UpdateEmailRequired(document.zform.ORGANIZATIONID.value);HideFields(jQuery("input[name='OPTOUT']").is(':checked'));if(tabkey=='userprofile'){document.zform.LASTNAME.focus();}}
function DisableOtherPosition(){if(document.zform.POSITIONID.value!==''){document.zform.OTHERPOSITION.value='';document.zform.OTHERPOSITION.disabled=true;jQuery('input[name="OTHERPOSITION"]').removeClass('RequiredField');jQuery('select[name="POSITIONID"]').addClass('RequiredField');}else{document.zform.OTHERPOSITION.disabled=false;jQuery('input[name="OTHERPOSITION"]').addClass('RequiredField',true);jQuery('select[name="POSITIONID"]').removeClass('RequiredField',false);}
if(document.zform.POSITIONID.value=='1'){document.zform.COMMUNICATORDISPLAYNAME.style.display='none';document.zform.PORTALDISPLAYNAMEOPTION[0].checked=true;document.zform.PORTALDISPLAYNAMEOPTION[0].disabled=true;document.zform.PORTALDISPLAYNAMEOPTION[1].disabled=true;document.zform.COMMUNICATORDISPLAYNAME.value=TrimWhitespace(document.zform.FIRSTNAME.value+' '+document.zform.LASTNAME.value);document.zform.COMMUNICATORDISPLAYNAME.disabled=true;document.zform.COMMUNICATORDISPLAYNAME.className='';jQuery('#PORTALDISPLAYNAME').hide();}
else{jQuery('#PORTALDISPLAYNAME').show();document.zform.PORTALDISPLAYNAMEOPTION[0].disabled=false;document.zform.PORTALDISPLAYNAMEOPTION[1].disabled=false;document.zform.COMMUNICATORDISPLAYNAME.disabled=false;if(document.zform.PORTALDISPLAYNAMEOPTION[1].checked){document.zform.COMMUNICATORDISPLAYNAME.className='RequiredField';}}}
function CheckUserProfileForm(userpasswordset){var nameexp=/^[\-A-Za-z,."'() ]{2,}$/;if(!ValidateInputForm()){return false;}
if(document.zform.LASTNAME.value===''){alert("LastName is required");document.zform.LASTNAME.focus();return false;}
if(document.zform.FIRSTNAME.value===''){alert("FirstName is required");document.zform.FIRSTNAME.focus();return false;}
if(document.zform.DOB.value===''){alert("DOB is required");document.zform.DOB.focus();return false;}
if(!IsDate(document.zform.DOB.value)){alert('The DOB must be a valid date.');return false;}
if(document.zform.ORGANIZATIONID.value===''){alert("Organization is required");document.zform.ORGANIZATIONID.focus();return false;}
if((document.zform.POSITIONID.value==='')&&(document.zform.OTHERPOSITION.value==='')){alert("Either Position or Other position is required");document.zform.POSITIONID.focus();return false;}
if(document.zform.PORTALDISPLAYNAMEOPTION[1].checked){if(!nameexp.test(document.zform.COMMUNICATORDISPLAYNAME.value)){alert("Custom name must be at least two characters in length and special characters other than , . - \" \' ( ) are not allowed.");return false;}}
if(!ValidateEmailCore(document.zform.EMAIL.value)){alert("The email must be a valid address.");return false;}
if(userpasswordset){if(document.zform.PASSWORD.value===''){alert("Password is required");document.zform.PASSWORD.focus();return false;}}}
function CheckPasswordChange(){var oldpass=jQuery("input[name='OLDPASSWORD']");var newpass1=jQuery("input[name='NEWPASSWORD']");var newpass2=jQuery("input[name='NEWPASSWORD1']");var minPasswordLengthField=jQuery("input[name='MINPASSWORDLENGTH']");var minPasswordLength=minPasswordLengthField.val()?parseInt(minPasswordLengthField.val(),10):15;if(oldpass.val()===''){alert('You must provide your current password.');return false;}
if(newpass1.val()===''){alert('You must provide a new password.');return false;}
if(newpass1.val()!==newpass2.val()){alert('New Password and New Password (again) must match.');return false;}
if(newpass1.val()===oldpass.val()){alert('You must provide different values for your old and new passwords.');return false;}
if(minPasswordLength&&newpass1.val().length<minPasswordLength){alert("Password must be at least "+minPasswordLength+" characters.");return false;}
return true;}
function CheckPasswordReset(numofquestions,passwordreset){var questions=[];var answers=[];var clean=true;var optout=jQuery("input[name='OPTOUT']").is(':checked');var email=jQuery("input[name='SECURITYEMAIL']");passwordreset=(typeof passwordreset==='undefined')?0:passwordreset;for(i=1;!optout&&i<=numofquestions;i++){var questionfield=jQuery("select[name='QUESTION"+i+"']");var answerfield=jQuery("input[name='PASSWORDRESETANSWER"+i+"']");var newanswerfield=jQuery("input[name='NEWANSWER"+i+"']");var warningfield=jQuery("#WARNING"+i);answers[i]=TrimWhitespace(answerfield.val());warningfield.html('');if(newanswerfield.val()==1){if(answers[i].length>20){warningfield.html('Answers must be less than 20 characters.');clean=false;}
if(answers[i]===''){warningfield.html('Please provide an answer.');clean=false;}
for(j=1;j<i;j++){if((answers[i]!==''&&answers[j]!=='')&&(answers[i]==answers[j])){warningfield.html('You cannot use the same answer twice.');clean=false;}}
if(questions[questionfield.val()]&&i>1){warningfield.html('You cannot use the same security question more than once.');clean=false;}
questions[questionfield.val()]=1;if(!questionfield.val()||questionfield.val()==""){warningfield.html('Please choose a security question.');clean=false;}}
if(passwordreset){warningfield.show();}}
if(!passwordreset){if(!jQuery("input[name='CURRENTPASSWORD']").val()){jQuery("#PASSWORDWARNING").html('You must supply your password in order for changes to be saved.');clean=false;}}
if(!email.val()&&!optout){alert('You must provide an email address.');clean=false;}
else if(!optout&&email.val()&&!ValidateEmailCore(email.val())){alert("The email must be a valid address.");email.focus();clean=false;}
return clean;}
function ToggleField(field,fieldindex,show){if(show){var hidden=jQuery("input[name='PASSWORDRESETANSWER"+fieldindex+"']");if(hidden.val()){field.value=hidden.val();}
field.select();}
else if(TrimWhitespace(field.value)!==''){field.value='********';}
else{field.value='';}}
function HideFields(toggle){if(toggle){jQuery("#securityemail").prop('disabled',true);jQuery("#question1").prop('disabled',true);jQuery("#question2").prop('disabled',true);jQuery("#question3").prop('disabled',true);jQuery("#questiontext1").prop('disabled',true);jQuery("#questiontext2").prop('disabled',true);jQuery("#questiontext3").prop('disabled',true);jQuery("input[name='OPTOUT']").prop('disabled',false);}
else{jQuery("#securityemail").prop('disabled',false);jQuery("#question1").prop('disabled',false);jQuery("#question2").prop('disabled',false);jQuery("#question3").prop('disabled',false);jQuery("#questiontext1").prop('disabled',false);jQuery("#questiontext2").prop('disabled',false);jQuery("#questiontext3").prop('disabled',false);jQuery("input[name='OPTOUT']").prop('disabled',false);}}
function ClearAnswer(id){jQuery("input[name='ANSWER"+id+"_MASKED']").val('');jQuery("input[name='PASSWORDRESETANSWER"+id+"']").val('');jQuery("input[name='NEWANSWER"+id+"']").val('1');}
function HandleUserProfileTabClick(key){var busydiv=jQuery('#maincontent').get(0);var busyspinner=new BusyIndicator();busyspinner.Start(busydiv);AH.Frames.Main.SetLocation(AH.PrependBasePath("/user/updateuserprofile.esp?CURRENTTABKEY="+key));}
function TogglePasswordHelp(){var passwordhelp=jQuery("#PASSWORDHELP");if(passwordhelp.is(":visible")){passwordhelp.hide();jQuery("#PASSWORDHELPLINK").html("Show Password Help");}
else{passwordhelp.show();jQuery("#PASSWORDHELPLINK").html("Hide Password Help");}}
function SetListOrder(currentobj,tableid){var trelement=jQuery(currentobj).closest('tr').next();trelement.find("#PHONETYPE option")[0].selected=true;trelement.find("input[name='PHONENUMBERSETLIST']").val(0);SetListOrderAfterDelete(tableid);}
function SetListOrderAfterDelete(tableid){var count=0;jQuery("#"+tableid).find('tr').each(function(){if(jQuery(this).find("input[name='PHONENUMBERSETLIST']").val()==1){jQuery(this).find("input[name='LISTORDER']").prop("checked",true);count++;}
else{jQuery(this).find("input[name='LISTORDER']").prop("checked",false);}});if(count===0){var firsttrelement=jQuery("#"+tableid).find('tr:first');firsttrelement.find("input[name='LISTORDER']").prop("checked",true);firsttrelement.find("input[name='PHONENUMBERSETLIST']").val(1);}}
function InitializePasswordExpirePage(){if(document.zform&&document.zform.OLDPASSWORD){document.zform.OLDPASSWORD.focus();}
HideFields(jQuery("input[name='OPTOUT']").is(':checked'));}
function CheckPassword(){var minPasswordLengthField=document.zform.MINPASSWORDLENGTH;var minPasswordLength=minPasswordLengthField.value?parseInt(minPasswordLengthField.value,10):15;if(document.zform.NEWPASSWORD1.value!=document.zform.NEWPASSWORD.value){alert("You typed different values in the NEW PASSWORD and NEW PASSWORD (again) fields.");return false;}
if(document.zform.NEWPASSWORD.value==document.zform.OLDPASSWORD.value){alert("You must enter a different value for your NEW PASSWORD than for your OLD PASSWORD.");return false;}
if(document.zform.NEWPASSWORD.value.length<minPasswordLength){alert("Password must be at least "+minPasswordLength+" characters.");return false;}
if(document.zform.ONETIMEPASSWORD){if(document.zform.ONETIMEPASSWORD.value.length<6){alert("Enter a valid security code");return false;}}
return true;}
function Procrastinate(){if(document.zform.NEWPASSWORD1.value!==''||document.zform.NEWPASSWORD.value!==''){alert("If you do not wish to change your password now, please leave the new password fields blank.");return false;}
else{document.zform.PROCRASTINATE.value=1;document.zform.submit();}}
function ShowHidePasswordHelp(){var originalDialogSize=parseInt(top.dialogHeight);if(document.all('PASSWORDHELP').style.display=='none'){document.all('PASSWORDHELP').style.display='block';top.dialogHeight=originalDialogSize+400+'px';jQuery("#PASSWORDHELPLINKMORE").hide();jQuery("#PASSWORDHELPLINKCLOSE").show();}
else{document.all('PASSWORDHELP').style.display='none';top.dialogHeight=originalDialogSize+'px';jQuery("#PASSWORDHELPLINKMORE").show();jQuery("#PASSWORDHELPLINKCLOSE").hide();}}
function CheckSecurityQuestion(numofquestions,passwordreset){var clean=false;var checkpassword=CheckPassword();if(checkpassword){clean=CheckPasswordReset(numofquestions,passwordreset);}
return clean;}
function SetSecurityAnswer(field,fieldindex){var hiddenanswer=jQuery("input[name='PASSWORDRESETANSWER"+fieldindex+"']");var hiddennewanswer=jQuery("input[name='NEWANSWER"+fieldindex+"']");var fieldvalue=TrimWhitespace(field.value);hiddennewanswer.val(1);if(fieldvalue!==''){hiddenanswer.val(fieldvalue);}
else{hiddenanswer.val('');}}
function Portaldisplayname(){if(document.zform.PORTALDISPLAYNAMEOPTION[0].checked){document.zform.COMMUNICATORDISPLAYNAME.style.display='none';document.zform.COMMUNICATORDISPLAYNAME.value=TrimWhitespace(document.zform.FIRSTNAME.value+' '+document.zform.LASTNAME.value);document.zform.COMMUNICATORDISPLAYNAME.disabled=true;document.zform.COMMUNICATORDISPLAYNAME.className='';}
else{document.zform.COMMUNICATORDISPLAYNAME.value=TrimWhitespace(document.zform.FIRSTNAME.value+' '+document.zform.LASTNAME.value);document.zform.COMMUNICATORDISPLAYNAME.style.display='';document.zform.COMMUNICATORDISPLAYNAME.className='RequiredField';document.zform.COMMUNICATORDISPLAYNAME.disabled=false;}}
function ShowHideAuthenticationFields(control,hidevalue,toggleANetPassword){var row=jQuery('#ONETIMEPASSWORDROW');var input=row.find("[name='ONETIMEPASSWORD1']");var hide;if(control){hide=control.value===hidevalue;}
else{hide=row.is(":visible");}
function ToggleRow(row,input,hide){if(hide){row.hide();DisableInputField(input);}
else{row.show();input.addClass('RequiredField');input.prop("disabled",false);}}
ToggleRow(row,input,hide);if(toggleANetPassword){var passwordRow=row.siblings('#PASSWORDROW');if(passwordRow.length){ToggleRow(passwordRow,passwordRow.find("[name='PASSWORD']"),hide);}}}
function ValidateIdentityMappingSeletion(){var i=0;var identityproviderobj=jQuery("#IDENTITYPROVIDER"+i+":visible");var identityproviderval=identityproviderobj.val();while(identityproviderval){var j=i+1;var nextidentityproviderval=jQuery("#IDENTITYPROVIDER"+j+":visible").val();if(identityproviderval[0]){while(nextidentityproviderval){if(nextidentityproviderval[0]&&identityproviderval[0]===nextidentityproviderval[0]){identityproviderobj.addClass("InvalidInput");alert('Cannot map a value to an identity provider more than once.');return false;}
j++;nextidentityproviderval=jQuery("#IDENTITYPROVIDER"+j+":visible").val();}}
identityproviderobj.removeClass("InvalidInput");i++;identityproviderval=jQuery("#IDENTITYPROVIDER"+i+":visible").val();}
return true;};function OpenTokenActionModal(actionHref,actionText){AH.SetGlobal('tokenActionHref',actionHref);var anchor=document.getElementById('token_action_modal_anchor');if(anchor){anchor.click();}
setTimeout(function(){var popupDoc=document;if(AH&&AH.Frames&&AH.Frames.Top&&AH.Frames.Top.Frame){try{popupDoc=AH.Frames.Top.Frame().document;}catch(e){}}
var warningTitle=popupDoc.getElementById('token_action_warning_title');if(warningTitle&&actionText){warningTitle.textContent='Confirm '+actionText;}},0);return false;}
function handleTokenAction(){var showError=function(field,message){var existing_error=document.getElementById('token_case_number_error');if(existing_error){existing_error.remove();}
var error_msg=document.createElement('div');error_msg.id='token_case_number_error';error_msg.style.color='red';error_msg.style.marginTop='5px';error_msg.textContent=message;field.parentNode.appendChild(error_msg);field.focus();};var submitForm=function(caseNumber){AthenaPattern_Popup.close_containing(document.getElementById('token_action_ok_button'),true);AH.SetGlobal('pendingSubmitButton',document.getElementById('token_action_ok_button'));var actionHref=AH.GetGlobal('tokenActionHref')||'';var anchor='';if(actionHref.indexOf('#')!==-1){var hrefParts=actionHref.split('#');actionHref=hrefParts[0];anchor='#'+hrefParts.slice(1).join('#');}
if(caseNumber){actionHref+=(actionHref.indexOf('?')===-1?'?':'&')
+'CASENUMBER='+encodeURIComponent(caseNumber);}
if(actionHref.charAt(0)==='?'){actionHref=AH.Frames.Main.GetLocation().pathname+actionHref;}
if(actionHref){AH.Frames.Main.SetLocation(actionHref+anchor);}};var case_number_field=document.getElementById('token_case_number_input');if(case_number_field){var case_number_value=case_number_field.value.trim();var existing_error=document.getElementById('token_case_number_error');if(existing_error){existing_error.remove();}
if(!case_number_value){showError(case_number_field,'Case Number is required.');return false;}
if(!/^\d+$/.test(case_number_value)){showError(case_number_field,'Case Number must contain only numbers.');return false;}
CallRemote({SUB:'Partner::Salesforce::HTML::ValidateSalesforceid',ARGS:{SALESFORCEID:case_number_value},LOADINGINDICATORFLAG:true,ONFINISH:function(returnvalue){if(confirm(TrimWhitespace(returnvalue))){submitForm(case_number_value);}
else{try{case_number_field.focus();}catch(e){}}}});return false;}
submitForm();}
var eobtypefeatureenabled=false;var ircmandatoryfeatureenabled=false;jQuery(document).ready(function(event){eobtypefeatureenabled=jQuery('#eobtypefeatureenabled').val()==1?true:false;ircmandatoryfeatureenabled=jQuery('#ircmandatoryfeatureenabled').val()==1?true:false;});function EnterThinkTank(message){document.getElementById('secondcoming').value=0;var hangondiv=document.getElementById('hangondiv');hangondiv.style.marginLeft='200px';hangondiv.style.marginTop='250px';hangondiv.style.fontSize='30px';hangondiv.style.display='';KeepThinking(message,0);}
function KeepThinking(message,numberofdots){if(document.getElementById('secondcoming').value==0){numberofdots++;if(numberofdots>5){numberofdots=1;}
var dottedmessage=message;for(var i=0;i<numberofdots;i++){dottedmessage=dottedmessage+'.';}
document.getElementById('hangondiv').innerHTML=dottedmessage;var timeoutcommand='KeepThinking("'+message+'", '+numberofdots+');';setTimeout(timeoutcommand,500);}}
function SuppressIEHotkeys(){if(event.ctrlKey&&(event.keyCode!=67)&&(event.keyCode!=86)){return false;}
if(event.altKey&&(event.keyCode==37)){return false;}
if((document.getElementById('disablekeyboardshortcuts'))&&('yes' !=document.getElementById('disablekeyboardshortcuts').value)&&((event.keyCode==38)||(event.keyCode==40))){return false;}
if((event.keyCode==13)||(event.keyCode==27)){return false;}
if((event.keyCode==118)){return false;}}
function KeyCheck()
{var KeyID=event.keyCode;if((document.getElementById('disablekeyboardshortcuts'))&&('yes'==document.getElementById('disablekeyboardshortcuts').value)&&(KeyID!=27)&&(KeyID!=120)){return 0;}
if(!phiblockinguser){switch(KeyID){case 68:UpdateClass(document.pagenum,3);break;case 69:UpdateClass(document.pagenum,6);break;case 72:UpdateClass(document.pagenum,2);break;case 75:UpdateClass(document.pagenum,4);if(commingledpatientbatch){document.getElementById('cainput').focus();document.getElementById('cninput').disabled='true';}
else if(!PREVIEWMODE){document.getElementById('cninput').focus();}
break;case 78:if(event.ctrlKey){UpdateClass(document.pagenum,4);if(commingledpatientbatch){document.getElementById('cainput').focus();document.getElementById('cninput').disabled='true';}
else if(!PREVIEWMODE){document.getElementById('cninput').focus();}}
break;case 81:var potentialphibutton=document.getElementById('potentialphibutton');if(event.ctrlKey&&potentialphibutton){potentialphibutton.click();}
break;case 82:UpdateClass(document.pagenum,9);break;case 87:UpdateClass(document.pagenum,10);break;case 88:var splitimagebutton=document.getElementById('splitimagebutton');if(event.ctrlKey&&splitimagebutton){if(splitimagebutton.disabled==''){splitimagebutton.click();}}
break;case 37:if((!PREVIEWMODE)&&event.ctrlKey){RotatePageCounterclockwise(document.pagenum);}
break;case 39:if((!PREVIEWMODE)&&event.ctrlKey){RotatePageClockwise(document.pagenum);}
break;case 46:var errornodebutton=document.getElementById('errornodebutton');if(event.ctrlKey&&errornodebutton){errornodebutton.click();}
break;case 118:document.getElementById('publishbutton').click();break;case 120:var batchsummary=document.getElementById('ModalDivLink{BATCHSUMMARY}');if(!batchmodaldisplayon){batchsummary.click();batchmodaldisplayon=true;}
else{ModalDiv.Collapse();batchmodaldisplayon=false;}
break;case 27:if(PREVIEWMODE){break;}
if((document.getElementById('splitimagebutton'))&&('Split Here'==document.getElementById('splitimagebutton').value)){DeactivateSplitter();}
else{if(document.getElementById('publishbutton')){document.getElementById('publishbutton').focus();}
if(document.getElementById('cninput')){var temptext=document.getElementById('cninput').value;document.getElementById('cninput').value='';document.getElementById('cninput').value=temptext;}
if(document.getElementById('cidinput')){var temptext=document.getElementById('cidinput').value;document.getElementById('cidinput').value='';document.getElementById('cidinput').value=temptext;}
if(document.getElementById('cainput')){temptext=document.getElementById('cainput').value;document.getElementById('cainput').value='';document.getElementById('cainput').value=temptext;}}
break;}}
if((!bladeoperator)&&(KeyID==80)){UpdateClass(document.pagenum,7);}
switch(KeyID){case 77:var previewmodebutton=document.getElementById('previewmodebutton');if(event.ctrlKey&&previewmodebutton){previewmodebutton.click();}
break;case 85:UpdateClass(document.pagenum,1);break;case 38:if(document.pagenum>document.beginpage){ZoomImage(document.pagenum-1);}
else if(document.beginpage>1){return GoToPage(document.pagenum-1);}
break;case 40:if(document.pagenum<document.endpage){ZoomImage(document.pagenum+1);}
else if(document.endpage<document.maxpage){return GoToPage(document.pagenum+1);}
break;}}
function RoundCurrencyInBLADE(amt){newamt=parseFloat(Math.round(100*(amt)).toString())/100;return newamt;}
function CheckCopy(){if(document.zform.COPYPAYMENTBATCHID.value==''){alert('You need to select a Batch ID to copy.');return false;}
var startpage=TrimWhitespace(document.zform.FROMPAGE.value);var endpage=TrimWhitespace(document.zform.TOPAGE.value);if(startpage==''||endpage==''){alert('You need to select a page range to copy.');return false;}
if((isNaN(startpage)||isNaN(endpage))||((startpage<=0)||(endpage<=0))){alert('Start and end page must be positive integers.');return false;}
if(parseInt(startpage)>parseInt(endpage)){alert('Invalid page range: start page is greater than end page.');return false;}
return true;}
function CheckReOrder(beginpage,endpage,maxpage){if(isNaN(beginpage)||isNaN(endpage)){alert('Unknown JavaScript error. Cannot reorder.');return false;}
if((beginpage<=0)||(beginpage>endpage)){alert('Unexpected JavaScript error. Please forward the batch id and context id to the Athena development team.');return false;}
for(pagenumber=beginpage;pagenumber<=endpage;pagenumber++){var page=TrimWhitespace(document.getElementById('previewpage'+pagenumber).value);if(page==''||isNaN(page)||page<1||page%1!=0){if(page==''){page='[blank]';}
alert('Page '+page+' must be a positive integer.');document.getElementById('previewpage'+pagenumber).focus();return false;}
if(page>maxpage){alert('Page '+page+' is too large for this batch ('+maxpage+' pages)');document.getElementById('previewpage'+pagenumber).focus();return false;}}
for(pagenumber1=beginpage;pagenumber1<=endpage;pagenumber1++){for(pagenumber2=pagenumber1+1;pagenumber2<=endpage;pagenumber2++){var page1=TrimWhitespace(document.getElementById('previewpage'+pagenumber1).value);var page2=TrimWhitespace(document.getElementById('previewpage'+pagenumber2).value);if((page1==page2)&&(page1!=pagenumber1)&&(page2!=pagenumber2)){alert('Only one page may be updated to be page '+page2+'.');document.getElementById('previewpage'+pagenumber2).focus();return false;}}}
return true;}
function ClickSplitImage(){if('Split Image'==document.getElementById('splitimagebutton').value){ActivateSplitter();}
else if('Split Here'==document.getElementById('splitimagebutton').value){SubmitImageSplit();}}
function ClickPublishBatch(){var totalcheckamount=0,numberofsplits=0;for(pagenumber=1;pagenumber<=document.maxpage;pagenumber++){var classification,checkamount,checknumber,pbr,checkidentifier,irc;if((pagenumber<document.beginpage)||(pagenumber>document.endpage)){checkidentifier=document.allpagecheckidentifiers[pagenumber];classification=document.allpageclassifications[pagenumber];checkamount=document.allpagecheckamounts[pagenumber];checknumber=document.allpagechecknumbers[pagenumber];pbr=document.allpagepbrs[pagenumber];}
else{var hc=document.getElementById('hc'+pagenumber);if(hc){classification=document.classifications[hc.value-1];if((classification=='CHK')||(classification=='EFT')){checkidentifier=document.getElementById('cid'+pagenumber).value;checkamount=document.getElementById('ca'+pagenumber).value;checknumber=document.getElementById('cn'+pagenumber).value;pbr=document.getElementById('pb'+pagenumber).value;if(ircmandatoryfeatureenabled){irc=document.getElementById('irc'+pagenumber).value;}}
if((classification=='EOB')||(classification=='$0')){checkidentifier=document.getElementById('eobcid'+pagenumber).value;checkamount=document.getElementById('eobca'+pagenumber).value;checknumber=document.getElementById('eobcn'+pagenumber).value;pbr=document.getElementById('eobpb'+pagenumber).value;if(ircmandatoryfeatureenabled){irc=document.getElementById('eobirc'+pagenumber).value;}}}}
var renoperiod=/^[\w\s\-]*$/;if(checkidentifier&&checkidentifier.search(renoperiod)==-1){alert('Check identifier for page '+pagenumber+' contains an invalid character. Please review.');return false;}
if((classification=='CHK')||(classification=='EFT')){numberofsplits++;if(ircmandatoryfeatureenabled){if(!checkamount||!checknumber||!pbr||!irc){alert('Check Information missing for page '+pagenumber+', can not publish');return false;}}
else{if(!checkamount||!checknumber||!pbr){alert('Check Information missing for page '+pagenumber+', can not publish');return false;}}
totalcheckamount=RoundCurrencyInBLADE(totalcheckamount+parseFloat(checkamount));}
if(classification=='EOB'||classification=='$0'){numberofsplits++;if(checkamount<=0&&classification=='EOB'){alert('EOB on page '+pagenumber+' must have a positive amount, use $0 classification for non-monied EOBs');return false;}
if(ircmandatoryfeatureenabled){if((!checkamount&&classification!='$0')||!checknumber||!pbr||!irc){alert('EOB Information missing for page '+pagenumber+', can not publish');return false;}}
else{if((!checkamount&&classification!='$0')||!checknumber||!pbr){alert('EOB Information missing for page '+pagenumber+', can not publish');return false;}}}
if(classification=='CORRESPONDENCE'){numberofsplits++;}
if(classification=='PP'){alert('There is potential PHI on page '+pagenumber+'. If it is an OCR mistake, please mark the page as unclassified.');return false;}}
if(numberofsplits==0){alert('Cannot publish with no CHK/EOB/COR');return false;}
else if(document.correctionsbatch&&numberofsplits!=1){alert('A corrections paymentbatch cannot be split into more than one batch.');return false;}
if((totalcheckamount!=pbtotalsumamount)&&(!document.ignorebalancing)){alert('Batch out of balance by '+(pbtotalsumamount-totalcheckamount).toFixed(2)+': checks add up to '
+totalcheckamount.toFixed(2)+', actual batch total '+pbtotalsumamount.toFixed(2));return false;}
return confirm("You are about to publish this batch. This action can not be undone, are you sure?");}
function ClickSendtoBlade(){var hc=document.getElementById('hc'+1);var classification;if(hc){classification=document.classifications[hc.value-1];}
if((document.maxpage==1)&&(classification=='COVERSHEET')){if(confirm("This payment batch only contains a cover sheet. It will be automatically closed. Would you like to continue?")){document.zform.CLOSEPB.value="1";return true;}
else{return false;}}
return confirm("You are about to send this batch to the BLADE work queue.  This action can not be undone, are you sure?");}
function ClickCreateCoverSheet(){var hc=document.getElementById('hc'+1);var classification;if(hc){classification=document.classifications[hc.value-1];}
if((document.maxpage>0)&&(classification=='COVERSHEET')){alert("This batch already has a coversheet. To create a coversheet, please remove the existing coversheet first.");return false;}
return true;}
function ActivateSplitter(){if(document.getElementById("splitline")){document.getElementById("splitline").style.visibility="visible";}
document.getElementById("splitimagebutton").value="Split Here";document.getElementById("splitimagebutton").style.color="red";document.getElementById("splitimagebutton").disabled="true";document.getElementById("splitimagebutton").title="Click image to place the split line";}
function DeactivateSplitter(){var splitimagebutton=document.getElementById('splitimagebutton');if(phiblockinguser||!splitimagebutton){return;}
splitPegged=0;document.getElementById("splitline").style.visibility="hidden";document.getElementById("splitimagebutton").value="Split Image";document.getElementById("splitimagebutton").style.fontSize="";document.getElementById("splitimagebutton").style.color="";document.getElementById("splitimagebutton").disabled="";document.getElementById("splitimagebutton").title="";}
function LockSplitLine(){if(splitPegged){splitPegged=0;document.getElementById("splitimagebutton").disabled="true";document.getElementById("splitimagebutton").title="Click image to place the split line";}
else{splitPegged=1;document.getElementById("splitimagebutton").disabled="";document.getElementById("splitimagebutton").title="";}}
function MoveSplitLine(event){var image=document.getElementById('previewimg'+document.pagenum);var splitLine=document.getElementById("splitline");if(image.style.display==''){var pos_y=event.offsetY-image.height-13;if(!splitPegged){splitLine.style.top=pos_y;document.zform.formy.value=event.offsetY;}}
else{var imagewindow=document.getElementById('imagewindow'+document.pagenum);if(imagewindow.style.display==''){var largeimage=document.getElementById('largeimg'+document.pagenum);splitLine.style.top=(event.clientY-largeimage.offsetTop-largeimage.height-13);}}}
function SubmitImageSplit(){if(splitPegged){var image=document.getElementById('previewimg'+document.pagenum);document.zform.PAGENUM.value=document.pagenum;document.zform.ACTION.value="Split Image";document.zform.LASTBUTTONCLICKED.value="Split Image";document.zform.TOPAMOUNT.value=(document.zform.formy.value/image.height);ShowFinalLoadingScreen();document.zform.submit();}
return false;}
function LeftClickImage(event,pagenum){var splitimagebutton=document.getElementById('splitimagebutton');if(!phiblockinguser&&splitimagebutton){if('Split Here'==document.getElementById('splitimagebutton').value){LockSplitLine();return;}}
if(document.getElementById('previewimg'+pagenum).style.display==''){document.getElementById('previewimg'+pagenum).style.display='none';document.getElementById('imagewindow'+pagenum).style.display='';var largeimg=document.getElementById('largeimg'+pagenum);if(!largeimg.src.match('eobimage')){largeimg.src=largeimg.getAttribute("actualimagesource");}
if(!phiblockinguser&&splitimagebutton){document.getElementById('splitimagebutton').disabled='true';}}
else{document.getElementById('previewimg'+pagenum).style.display='';document.getElementById('imagewindow'+pagenum).style.display='none';if(!phiblockinguser&&splitimagebutton){document.getElementById('splitimagebutton').disabled='';}}}
function RightClickImage(event){var splitimagebutton=document.getElementById('splitimagebutton');if(phiblockinguser||!splitimagebutton){return false;}
if((event.button==2)&&('Split Here'==document.getElementById('splitimagebutton').value)){DeactivateSplitter();return false;}}
function EnterEOBInfo(){var hcname=document.getElementsByName('hc'+document.pagenum);var classname;if(hcname){classname=document.classifications[hcname[0].value-1];}
if(classname!='EOB'&&classname!='$0'){return false;}
var eobcn=document.getElementById('eobcn'+document.pagenum);eobcn.value=eobcn.value||'NA';document.getElementById('cninput').value=eobcn.value;document.getElementById('cninput').disabled='';var eobcid=document.getElementById('eobcid'+document.pagenum);document.getElementById('cidinput').value=eobcid.value;document.getElementById('cidinput').disabled='';var eobca=document.getElementById('eobca'+document.pagenum);eobca.value=eobca.value||'0';if(classname=='$0'){eobca.value=0;}
document.getElementById('cainput').value=eobca.value;if(classname=='EOB'){document.getElementById('cainput').disabled='';}
document.getElementsByName('pbinput')[0].value=document.paymentbatchroutes[document.getElementById('eobpb'+document.pagenum).value-1];document.getElementsByName('pbinput')[0].disabled='';document.getElementById('classtd'+document.pagenum).style.borderColor=ORANGE;document.getElementById('cninput').focus();var ircid=jQuery('#eobirc'+document.pagenum).val()||0;var ircname=document.insurancereportingcategory[ircid-1]||'';jQuery('[name="ircinput"]').val(ircname);jQuery('[name="ircinput"]').prop("disabled",false);if(eobtypefeatureenabled){var eobtype=jQuery('#eobtype'+document.pagenum).val();jQuery('[name="typeinput"]').val(eobtype);jQuery('[name="typeinput"]').prop("disabled",false);}}
function MakePagesVisible(){if(confirm('All pages in this batch will be made visible to the client.  This action cannot be undone, are you sure?')){document.zform.ACTION.value="Make Pages Visible";document.zform.submit();return false;}}
function AutoSave(){document.zform.CHECKSENTERED.value=parseFloat(document.zform.CHECKSENTERED.value)+1;if(5<=document.zform.CHECKSENTERED.value){}}
function ChooseReason(buttonvalue,reasonobject,noteobject){MediumModalPopupWindow({page:AH.PrependBasePath('/help/discardreasonlookup.esp?&BUTTONVALUE='+buttonvalue),title:'Choose Reason',onclose:function(responses){if(responses!=null){if(buttonvalue=='Potential PHI'){noteobject.value=responses["NOTE"];}
else{reasonobject.value=responses["REASON"];noteobject.value=responses["NOTE"];}
var jqzform=jQuery('#zform');jqzform.append("<input type='hidden' value='Error Node Batch' name='SUBMITVALUE'>");jqzform.submit();}}});return false;}
function PreserveCNChange(){var hcname=document.getElementsByName('hc'+document.pagenum);var classname;if(hcname){classname=document.classifications[hcname[0].value-1];}
if((classname=='CHK')||(classname=='EFT')){document.getElementById('cn'+document.pagenum).value=document.getElementById('cninput').value;}
else if(classname=='EOB'||classname=='$0'){document.getElementById('eobcn'+document.pagenum).value=document.getElementById('cninput').value;}}
function PreserveCIDChange(){var hcname=document.getElementsByName('hc'+document.pagenum);var classname;if(hcname){classname=document.classifications[hcname[0].value-1];}
if((classname=='CHK')||(classname=='EFT')){document.getElementById('cid'+document.pagenum).value=document.getElementById('cidinput').value;}
else if(classname=='EOB'||classname=='$0'){document.getElementById('eobcid'+document.pagenum).value=document.getElementById('cidinput').value;}}
function PreserveCAChange(){var hcname=document.getElementsByName('hc'+document.pagenum);var classname;if(hcname){classname=document.classifications[hcname[0].value-1];}
if((classname=='CHK')||(classname=='EFT')){document.getElementById('ca'+document.pagenum).value=document.getElementById('cainput').value;}
else if(classname=='EOB'||classname=='$0'){document.getElementById('eobca'+document.pagenum).value=document.getElementById('cainput').value;}}
function PreserveTYPEChange(){var hcname=document.getElementsByName('hc'+document.pagenum);var classname;if(hcname){classname=document.classifications[hcname[0].value-1];}
var eobtype=jQuery('[name="typeinput"]').val();if((classname=='CHK')||(classname=='EFT')){jQuery('#type'+document.pagenum).val(eobtype);}
if(classname=='EOB'||classname=='$0'){jQuery('#eobtype'+document.pagenum).val(eobtype);}}
function PreservePBChange(){var hcname=document.getElementsByName('hc'+document.pagenum);var classname;if(hcname){classname=document.classifications[hcname[0].value-1];}
if((classname=='CHK')||(classname=='EFT')){document.getElementById('pb'+document.pagenum).value=pbnamemap[document.getElementsByName('pbinput')[0].value]||1;}
else if(classname=='EOB'||classname=='$0'){document.getElementById('eobpb'+document.pagenum).value=pbnamemap[document.getElementsByName('pbinput')[0].value]||1;}}
function PreserveIRCChange(){var hcname=document.getElementsByName('hc'+document.pagenum);var classname;if(hcname){classname=document.classifications[hcname[0].value-1];}
if((classname=='CHK')||(classname=='EFT')){document.getElementById('irc'+document.pagenum).value=ircnamemap[document.getElementsByName('ircinput')[0].value]||'';}
else if(classname=='EOB'||classname=='$0'){document.getElementById('eobirc'+document.pagenum).value=ircnamemap[document.getElementsByName('ircinput')[0].value]||'';}}
function CNInputBlur(cninput){document.getElementById('disablekeyboardshortcuts').value='no';if(!cninput.value){cninput.value='NA';}
PreserveCNChange();}
function CIDInputBlur(cidinput){document.getElementById('disablekeyboardshortcuts').value='no';PreserveCIDChange();}
function CAInputBlur(cainput){document.getElementById('disablekeyboardshortcuts').value='no';document.zform.SUPPRESSAUTOSAVE.value=1;if(!(cainput.value.match(/^\d*\.?\d*$/))||isNaN(cainput.value)){alert('Please enter a number.');cainput.value='';cainput.focus();return false;}
else{if(!cainput.value){cainput.value='0';}
else{cainput.value=RoundCurrencyInBLADE(cainput.value);}}
PreserveCAChange();document.zform.SUPPRESSAUTOSAVE.value=0;}
function TYPEInputBlur(){document.getElementById('disablekeyboardshortcuts').value='no';PreserveTYPEChange();}
function PBInputBlur(){document.getElementById('disablekeyboardshortcuts').value='no';if(!document.getElementsByName('pbinput')[0].value){alert('Please enter a payment batch route.');}
PreservePBChange();if(document.zform.SUPPRESSAUTOSAVE.value==0)
{return AutoSave();}}
function IRCInputBlur(){document.getElementById('disablekeyboardshortcuts').value='no';if(ircmandatoryfeatureenabled){if(!document.getElementsByName('ircinput')[0].value){alert('Please enter a insurance reporting category.');}}
PreserveIRCChange();}
function TabToNextImage(event){if(event.keyCode==9){document.getElementById('disablekeyboardshortcuts').value='no';var nextimage=document.getElementById('image'+(document.pagenum+1));if(nextimage){ZoomImage(document.pagenum+1);}
var splitimagebutton=document.getElementById('splitimagebutton');if(splitimagebutton){splitimagebutton.focus();}
else{document.getElementById('reorderpagesbutton').focus();}
return false;}
return true;}
function ShowFinalLoadingScreen(){var waitforpagetoload=document.getElementById('waitforpagetoload');if(waitforpagetoload){if(waitforpagetoload.value==1){alert("Page is not fully loaded yet. Please wait for it to finish loading.");return false;}}
var submitvalue=document.zform.LASTBUTTONCLICKED.value;document.getElementById('bladeappdiv').style.display='none';document.getElementById('secondcoming').value=0;HideContextMenu();var splitline=document.getElementById("splitline");if(splitline){splitline.style.visibility="hidden";}
if(waitmessage[submitvalue]){EnterThinkTank(waitmessage[submitvalue]);}
else{EnterThinkTank('Loading');}
return true;}
function ColorMap(n){return 96+n%128;}
function StringColor(s){if(s=='PP'){return'rgb(255,10,10)';}
if(s=='CORRESPONDENCE'){return'gray';}
if(s=='$0'){return'plum';}
var r=0;var g=0;var b=0;var n=0;for(var i=0;i<s.length;i++){r*=3;g*=5;b*=7;n=s.charCodeAt(i);r+=n;g+=n;b+=n;}
return'rgb('+ColorMap(r)+','+ColorMap(g)+','+ColorMap(b)+')';}
function UpdateClass(i,j){var h=document.getElementById('hc'+i);if(typeof(j)=='undefined'){j=h.value;}
else{h.value=j;ZoomImage(i);}
var s=document.classifications[j-1];var etd=document.getElementById('classtd'+i);var edi=document.getElementById('classdi'+i);etd.style.backgroundColor=StringColor(s);edi.innerHTML=s.substr(0,3).split('').join('<br />');var eobcn=document.getElementById('eobcn'+i);var eobca=document.getElementById('eobca'+i);var bordercolor='black';var fontcolor='black';if(s=='CHK'||s=='EFT'||s=='CORRESPONDENCE'){bordercolor=ORANGE;}
if((s=='EOB'||s=='$0')&&(!PREVIEWMODE)){EnterEOBInfo();}
if((!PREVIEWMODE)&&(!phiblockinguser)){var checkoreob=document.getElementById('checkoreob');if(checkoreob){checkoreob.innerHTML='Check';if(s=='EOB'||s=='$0'){checkoreob.innerHTML='EOB';}}
if((s=='EOB'||s=='$0')&&eobcn&&(eobca!="")&&(eobcn.value||eobca.value)){bordercolor=ORANGE;}}
if(s=='CHK'||s=='EFT'){fontcolor='white';}
document.getElementById('classtd'+i).style.borderColor=bordercolor;document.getElementById('classdi'+i).style.color=fontcolor;}
function ZoomImage(pagenum){var image=document.getElementById('image'+pagenum);if(!image){return false;}
if(document.pagenum!=pagenum){HideContextMenu();document.getElementById('image'+document.pagenum).style.border='1px solid black';if(!PREVIEWMODE){DeactivateSplitter();document.getElementById('ar'+document.pagenum).innerHTML='';document.getElementById('previewimg'+document.pagenum).style.display='none';document.getElementById('imagewindow'+document.pagenum).style.display='none';}}
document.pagenum=pagenum;if(!PREVIEWMODE){document.getElementById('ar'+document.pagenum).innerHTML='>';document.getElementById('splitline').style.borderWidth="thin";ScrollToImage(document.pagenum);}
image.style.border='1px solid red';var hcname=document.getElementsByName('hc'+document.pagenum);var classname;if(hcname){classname=document.classifications[hcname[0].value-1];}
var potentialphidiv=document.getElementById('potentialphidiv');if(image.getAttribute("data-potentialphihtml")&&(classname=='PP')){potentialphidiv.innerHTML=image.getAttribute("data-potentialphihtml");potentialphidiv.style.borderWidth='1px';}
else{potentialphidiv.innerHTML='';potentialphidiv.style.borderWidth='0px';}
if(document.getElementById('previewimg'+pagenum)){document.getElementById('previewimg'+pagenum).style.display='';document.getElementById('imagewindow'+pagenum).style.display='none';if((!PREVIEWMODE)&&(!phiblockinguser)){var eobcn=document.getElementById('eobcn'+pagenum);var eobca=document.getElementById('eobca'+pagenum);var ircid;var ircname;var eobtype;if(classname=='CHK'||classname=='EFT'){document.getElementById('checkoreob').innerHTML='Check';if(!commingledpatientbatch){document.getElementById('cninput').disabled='';}
document.getElementById('cn'+pagenum).value=document.getElementById('cn'+pagenum).value||'NA';document.getElementById('cninput').value=document.getElementById('cn'+pagenum).value;document.getElementById('cidinput').disabled='';document.getElementById('cidinput').value=document.getElementById('cid'+pagenum).value;document.getElementById('cainput').disabled='';document.getElementById('ca'+pagenum).value=document.getElementById('ca'+pagenum).value||'0';document.getElementById('cainput').value=document.getElementById('ca'+pagenum).value;document.getElementsByName('pbinput')[0].disabled='';document.getElementsByName('pbinput')[0].value=document.paymentbatchroutes[document.getElementById('pb'+pagenum).value-1];ircid=jQuery('#irc'+pagenum).val()||0;ircname=document.insurancereportingcategory[ircid-1]||'';jQuery('[name="ircinput"]').val(ircname);jQuery('[name="ircinput"]').prop("disabled",false);if(eobtypefeatureenabled){eobtype=jQuery('#type'+pagenum).val();jQuery('[name="typeinput"]').val(eobtype);jQuery('[name="typeinput"]').prop("disabled",false);}}
else if((classname=='EOB'||classname=='$0')&&(eobcn.value||eobca.value)){document.getElementById('checkoreob').innerHTML='EOB';document.getElementById('cninput').disabled='';document.getElementById('cninput').value=document.getElementById('eobcn'+pagenum).value;document.getElementById('cidinput').disabled='';document.getElementById('cidinput').value=document.getElementById('eobcid'+pagenum).value;if(classname=='EOB'){document.getElementById('cainput').disabled='';}
else{document.getElementById('cainput').disabled='true';}
document.getElementById('cainput').value=document.getElementById('eobca'+pagenum).value;document.getElementsByName('pbinput')[0].disabled='';document.getElementsByName('pbinput')[0].value=document.paymentbatchroutes[document.getElementById('eobpb'+pagenum).value-1];ircid=jQuery('#eobirc'+pagenum).val()||0;ircname=document.insurancereportingcategory[ircid-1]||'';jQuery('[name="ircinput"]').val(ircname);jQuery('[name="ircinput"]').prop("disabled",false);if(eobtypefeatureenabled){eobtype=jQuery('#eobtype'+pagenum).val();jQuery('[name="typeinput"]').val(eobtype);jQuery('[name="typeinput"]').prop("disabled",false);}}
else{document.getElementById('checkoreob').innerHTML='Check';document.getElementById('cninput').disabled='true';document.getElementById('cninput').value='Not on page.';document.getElementById('cidinput').disabled='true';document.getElementById('cidinput').value='Not on page.';document.getElementById('cainput').disabled='true';document.getElementById('cainput').value='Not on page';document.getElementsByName('pbinput')[0].disabled='true';document.getElementsByName('pbinput')[0].value='';if(eobtypefeatureenabled){jQuery('[name="typeinput"]').prop("disabled",true);jQuery('[name="typeinput"]').val('');}
jQuery('[name="ircinput"]').prop("disabled",true);jQuery('[name="ircinput"]').val('');}}}}
function ScrollToImage(pagenum){var totalheight=0;for(var i=document.beginpage;i<(pagenum-1);i++){totalheight=document.getElementById('classtd'+i).clientHeight+totalheight+8;}
var thumbnailwindow=document.getElementById('thumbnailwindow');if(thumbnailwindow){thumbnailwindow.scrollTop=totalheight;}}
function HideContextMenu(){var thumbnailcontextmenu=document.getElementById('thumbnailcontextmenu');if(thumbnailcontextmenu){thumbnailcontextmenu.style.visibility='hidden';}}
function ContextMenu(pagenum){ZoomImage(pagenum);document.pagenum=pagenum;document.getElementById("thumbnailcontextmenuheader").innerHTML="<strong>Page "+document.pagenum+"</strong>";var menu=document.getElementById('thumbnailcontextmenu');var x=window.event.clientX+document.documentElement.scrollLeft+document.body.scrollLeft;var y=window.event.clientY+document.documentElement.scrollTop+document.body.scrollTop;menu.style.visibility='visible';menu.style.left=x;menu.style.top=y;}
function ShowBatchSummary(){var batchsummary=document.getElementById('batchsummary');batchsummary.style.left=document.body.clientWidth/10;batchsummary.style.top=document.body.clientHeight/10;batchsummary.style.width=(document.body.clientWidth*4)/5;batchsummary.style.height=(document.body.clientHeight*4)/5;if(!batchsummary){return true;}
if(bladeoperator){document.getElementById('publishbutton').focus();}
else{document.getElementById('previewmodebutton').focus();}
