else if(searchterms.length<2){ondatafetch({ICD10:[{DESC:"Please type 2 or more characters to search"}],ATTRSETS:[]});}
else{CallRemote({SUB:"GetICD10SearchResults",SUBSYSTEM:"Terminology",ARGS:{ADDITIONALCODESFOR:snomeddata.ADDITIONALCODESFOR,CHARTID:GetChartID(),CHECKAMBIGUITY:true,CLINICALENCOUNTERID:window.encounterid,HCCID:snomeddata.HCCID,INCLUDERAF:HCCRAFEnabled(),KEY:searchterms,MAXCOUNT:500,ONLYRAF:snomeddata.ONLYRAF},ONFINISH:ondatafetch,ONERROR:function(){ondatafetch({ICD10:[{DESC:"Communication error.  Please try again"}],ATTRSETS:[]});}});}}
