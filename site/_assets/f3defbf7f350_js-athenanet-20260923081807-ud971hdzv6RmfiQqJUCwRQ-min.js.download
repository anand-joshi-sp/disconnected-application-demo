if(!freetext){var freetexttemplate=jQuery('<div>').append(jQuery(section.children[0].children['FreeTextTemplate']).clone()).html();var html=freetexttemplate
.replace(/\{\{NAME\}\}/g,textname);freetext=AddHTML(html);if(freetextvalue){freetext.value=freetextvalue;}
freetext=valuespan.insertBefore(freetext,null);var jqfreetext=jQuery(freetext);if(isTablet()){jqfreetext.removeAttr("onkeydown");jqfreetext.removeAttr("onkeyup");jqfreetext.blur(function(){SetScrollOverflow(this);})
jqfreetext.keyup(function(){var jqthis=jQuery(this);var numrows=parseInt(jqthis.attr('rows'));if((jqthis.attr('maxrows')>numrows)&&(this.clientHeight<this.scrollHeight)){jqthis.attr('rows',numrows+1);}});}}
freetext.style.display='';SetScrollOverflow(freetext);if(!(isTablet()&&valuespan.className!='sentencefreetext')){try{freetext.focus();}catch(e){}}
