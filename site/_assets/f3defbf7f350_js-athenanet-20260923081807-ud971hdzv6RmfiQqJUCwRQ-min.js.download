if(procedurerow==procedurerows[numprocedurerows-1]){if(procedurerow==procedurerows[0]&&keeplastrow){GetServiceTemplateRow(encounterid,servicetype,function(servicetemplate,proceduretemplate){var templateprocedureprefix=proceduretemplate.id;templateprocedureprefix=new RegExp(EscapeRegExp(templateprocedureprefix),"g");for(var i=0;i<proceduretemplate.cells.length;i++){var procedurecodeinput=GetChild(procedurerow.cells[i],'tagName','input','type','text','name',procedurerowid+'{VALUE}');if(procedurecodeinput){procedurecodeinput.value='';}
else{var cellcopy=proceduretemplate.cells[i].cloneNode(true);procedurerow.cells[i].innerHTML=cellcopy.innerHTML.replace(templateprocedureprefix,procedurerowid);}}
CheckClinicalProcedureCodeBillable(procedurerow.cells[0]);});return;}
else if(procedurerow!=procedurerows[0]){var prevrow=GetProcedureRow(servicerow.id,-2);if(prevrow){var prevadd=GetChild(prevrow,'tagName','span','title','add procedure code');if(prevadd){prevadd.style.visibility='visible';}}}}
