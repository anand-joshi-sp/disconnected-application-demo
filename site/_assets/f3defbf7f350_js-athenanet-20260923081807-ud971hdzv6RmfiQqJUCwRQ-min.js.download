var parentnodeids=new Array();for(var i=0;i<childnodes.length;i++){childnodes[i].style.display='none';}
for(var i=0;i<expandcollapseimgs.length;i++){expandcollapseimgs[i].setAttribute('src',GetStaticURL('plus.gif'));}}
