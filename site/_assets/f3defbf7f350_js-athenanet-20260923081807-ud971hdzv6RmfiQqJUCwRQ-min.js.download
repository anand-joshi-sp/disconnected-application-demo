function FixOrderCounter(pickeritem,count,showdelete){if(count>1){jQuery(pickeritem).addClass('counter selected');jQuery('span.ordercounter',pickeritem).remove();jQuery(pickeritem).prepend('<span class=ordercounter>'+count+'</span>');}
else if(count==1){jQuery(pickeritem).removeClass('counter').addClass('selected');jQuery('span.ordercounter',pickeritem).remove();if(showdelete){ShowDelete(pickeritem);}}
else{jQuery(pickeritem).removeClass('counter selected');HideDelete(pickeritem);}}
function IncrementOrderCounter(args){if(args.FIELDNAME){var orderingimprovement=jQuery('#'+EscapeJQuerySelector(args.FIELDNAME)+'_pickercontent').attr('orderingimprovement');if(orderingimprovement==='ON'){Picker.UpdateOrderCounter({INCREMENT:true,FIELDNAME:args.FIELDNAME,CLINICALPROVIDERID:args.CLINICALPROVIDERID,CLINICALORDERTYPEID:args.CLINICALORDERTYPEID,CLINICALPROVIDERORDERTYPEID:args.CLINICALPROVIDERORDERTYPEID});return;}}
