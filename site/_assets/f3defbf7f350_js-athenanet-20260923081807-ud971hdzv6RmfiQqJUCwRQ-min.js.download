else{if(useHrefList){documentsToPrint.push({id:this.value,html:addstring});}
htmldocids+=addstring;}}
else{if(useHrefList){documentsToPrint.push({id:this.value,html:documentidstring});}
htmldocids+=documentidstring;}}});if(!loopreturn){return;}
