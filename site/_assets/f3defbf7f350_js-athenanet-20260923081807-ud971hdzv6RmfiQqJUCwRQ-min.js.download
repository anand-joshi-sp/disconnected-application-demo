'Return to Billing tab</button></div></div>',WIDTH:340,ONCLOSE:OnNothingBilledClose};AH.Frames.Top.Frame().AthenaPattern_Popup.open(args);}
var EmChargesWarning=(function(){var config={missingEmCharge:'NOT_REQUIRED',missingCharges:'NOT_REQUIRED',supervisingRequired:0};var copy={emSoft:{header:'Continue Without an E&M Code Set to Bill?',body:'There are no E&M Codes set to bill. Do you still want to continue?'},emHard:{header:'An E&M Code Set to Bill is Required',body:'There are no E&M Codes set to bill. One must be added to mark Provider Review as Reviewed.',combinedBullet:'An E&M charge must be billed.'},chargesSoft:{header:'Continue Without a Charge Set to Bill?',body:'There are no procedure codes set to bill. Do you still want to continue?'},chargesHard:{header:'At Least One Procedure Code Must Be Set to Bill',body:'There are no procedure codes set to bill. One must be set to bill to mark Provider Review as Reviewed.',combinedBullet:'A charge must be billed.'},supervisingHard:{header:'Provider Review Requirements Not Met',body:'Supervising Provider must be set.'},continueLabel:'Continue',cancelLabel:'Cancel',closeLabel:'Close'};function hasEmCode(){var billingSlip=jQuery('div[name="ebillingslip"]');var emRows=jQuery('tr[name="clinicalservicerow"][servicetype="EMCODE"]',billingSlip);if(!emRows.length){return false;}
var populated=false;emRows.each(function(){var procRows=jQuery(this).nextUntil('tr[name="clinicalservicerow"]','tr[name="clinicalprocedurerow"]');procRows.each(function(){if(!jQuery('td.billable input:checked',this).length){return;}
jQuery('input[name*="PROCEDURECODE"][name*="VALUE"]',this).each(function(){if(this.name.indexOf('{DIAGNOSIS}')!==-1||this.name.indexOf('{MODIFIER}')!==-1){return;}
if(jQuery.trim(this.value)!==''){populated=true;}});});});return populated;}
function hasBillableCharge(){return jQuery('input:checked',jQuery('td.billable',jQuery('div[name="ebillingslip"]'))).length>0;}
function isSupervisingProviderRequirementUnmet(){if(!config.supervisingRequired){return false;}
var sp=document.getElementById('SupervisingProvider');return!sp||sp.selectedIndex<=0;}
function pickEmChargesWinner(){var emFired=(config.missingEmCharge==='REQUIRE'||config.missingEmCharge==='RECOMMEND')&&!hasEmCode();var chargesFired=(config.missingCharges==='REQUIRE'||config.missingCharges==='RECOMMEND')&&!hasBillableCharge();var em=emFired?{level:config.missingEmCharge,kind:'em'}:null;var charges=chargesFired?{level:config.missingCharges,kind:'charges'}:null;if(em&&charges){if(em.level===charges.level){return em;}
return em.level==='REQUIRE'?em:charges;}
return em||charges||null;}
function singleCopyFor(emChargesWinner){if(emChargesWinner.kind==='em'){return emChargesWinner.level==='REQUIRE'?copy.emHard:copy.emSoft;}
return emChargesWinner.level==='REQUIRE'?copy.chargesHard:copy.chargesSoft;}
function decideWarning(){var supervisingRequirementUnmet=isSupervisingProviderRequirementUnmet();var emChargesWinner=pickEmChargesWinner();if(!supervisingRequirementUnmet){if(!emChargesWinner){return null;}
var single=singleCopyFor(emChargesWinner);return{level:emChargesWinner.level,header:single.header,body:single.body};}
if(!emChargesWinner||emChargesWinner.level!=='REQUIRE'){return{level:'REQUIRE',header:copy.supervisingHard.header,body:copy.supervisingHard.body};}
var requiredCopy=singleCopyFor(emChargesWinner);return{level:'REQUIRE',header:copy.supervisingHard.header,bullets:[copy.supervisingHard.body,requiredCopy.combinedBullet]};}
var proceeding=false;function resumeSignoff(){var box=document.getElementById('EBILLINGSLIP_SIGNOFF');if(!box){return;}
proceeding=true;box.checked=false;box.click();}
function bodyHtml(warning){if(warning.bullets){var intro=warning.intro?'<p>'+warning.intro+'</p>':'';var items=warning.bullets.map(function(b){return'<li>'+b+'</li>';}).join('');return intro+'<ul>'+items+'</ul>';}
return'<p>'+warning.body+'</p>';}
function showSoftStop(warning){var html='<div style="padding:8px;width:min-content">'+
'<div class="reskinpagetitle" style="white-space:nowrap">'+warning.header+'</div>'+
bodyHtml(warning)+
'<div style="padding-top:8px">'+
'<button style="margin-right:20px" onclick="'+
'AH.Frames.Top.Frame().AthenaPattern_Popup.close();'+
' require([\'shared:/scripts/athena/utils/cross_frame_events\'], function(CrossFrameEventsUtils) { CrossFrameEventsUtils.trigger(\'em-charges.continue\', true); });">'+
copy.continueLabel+'</button>'+
'<button onclick="'+
'AH.Frames.Top.Frame().AthenaPattern_Popup.close();">'+
copy.cancelLabel+'</button>'+
'</div></div>';AH.Frames.Top.Frame().AthenaPattern_Popup.open({CENTERED:1,OVERLAYTYPE:'LIGHTBOX',SIMULATETOPFRAME:1,CONTENTHTML:html});}
function showHardStop(warning){var html='<div style="padding:8px;width:min-content">'+
'<div class="reskinpagetitle" style="white-space:nowrap">'+warning.header+'</div>'+
bodyHtml(warning)+
'<div style="padding-top:8px">'+
'<button onclick="'+
'AH.Frames.Top.Frame().AthenaPattern_Popup.close();">'+
copy.closeLabel+'</button>'+
'</div></div>';AH.Frames.Top.Frame().AthenaPattern_Popup.open({CENTERED:1,OVERLAYTYPE:'LIGHTBOX',SIMULATETOPFRAME:1,CONTENTHTML:html});}
function init(pageConfig){config.missingEmCharge=pageConfig.missingEmCharge||'NOT_REQUIRED';config.missingCharges=pageConfig.missingCharges||'NOT_REQUIRED';config.supervisingRequired=pageConfig.supervisingRequired?1:0;require(['shared:/scripts/athena/utils/cross_frame_events'],function(CrossFrameEventsUtils){CrossFrameEventsUtils.off('em-charges.continue');CrossFrameEventsUtils.on('em-charges.continue',function(){resumeSignoff();});});}
function checkOnSignoff(checkbox){if(proceeding){proceeding=false;return true;}
var warning=decideWarning();if(!warning){return true;}
if(checkbox){checkbox.checked=false;}
if(warning.level==='REQUIRE'){showHardStop(warning);}else{showSoftStop(warning);}
return false;}
return{init:init,hasEmCode:hasEmCode,hasBillableCharge:hasBillableCharge,decideWarning:decideWarning,checkOnSignoff:checkOnSignoff,resumeSignoff:resumeSignoff};})();function StoreProviderSelection(obj){var spdropdown=document.getElementById("SupervisingProvider");if(spdropdown.selectedIndex>0){spdropdown.defaultValue=spdropdown[spdropdown.selectedIndex].value;}}
function DisplayProviderReviewRemovalWarning(obj){var spdropdown=document.getElementById("SupervisingProvider");var signoff=document.getElementById('EBILLINGSLIP_SIGNOFF');if(spdropdown.selectedIndex<=0&&signoff.checked){var confirmation=confirm("Removing the entry for Supervising Provider will revoke the given Provider Review since this is critical information to create a claim. Would you like to continue with removing the entry for Supervising Provider?");if(confirmation==false){applysupervising(spdropdown.defaultValue);}
else{signoff.checked=false;}}}
function CheckMinutesEqualToUnits(obj,args){AssertFields(args,['PATIENTID','CHARTID','CLINICALENCOUNTERID','ENCOUNTERDATE'],['NOTHINGBILLEDON','SUPERVISINGALERTFLAG']);if(args.SUPERVISINGALERTFLAG==1){var check=document.getElementById("SupervisingProvider");if(check.selectedIndex<=0){alert("The Supervising Provider field is required in order to Mark the Billing Slip as Reviewed. You can still save and return to this page at a later time");input=document.getElementById('EBILLINGSLIP_SIGNOFF');input.checked=false;}}
if(obj.checked){var procunits=[];var trs=jQuery('input:checked',jQuery('td.billable',jQuery('div[name="ebillingslip"]'))).closest('tr');trs.each(function(){var procedurecode=jQuery('input[name*="VALUE"]',this).get(0).value;var units=jQuery('input[name*="UNITS"]',this).get(0).value;var previous=jQuery(this).prevAll('tr[servicetype]:first');var templateid=jQuery('input[name*="DOCUMENTID"]',previous).get(0).value;procunits.push({TEMPLATEID:templateid,PROCEDURECODE:procedurecode,UNITS:units});});if(!trs.length&&args.NOTHINGBILLEDON){NothingBilledModal();}
if(procunits){CallRemote({SUB:'Clinical::Encounter::Section::EBillingSlip::CalculateTotalMinuteAndUnit',ARGS:{PATIENTID:args.PATIENTID,CHARTID:args.CHARTID,CLINICALENCOUNTERID:args.CLINICALENCOUNTERID,ENCOUNTERDATE:args.ENCOUNTERDATE,PROCUNITS:procunits},LOADINGINDICATORFLAG:true,ONFINISH:function(errorflag){if(errorflag=='unitstoolarge'){alert("Total units exceeds eight for this appointment. Please review.");}
