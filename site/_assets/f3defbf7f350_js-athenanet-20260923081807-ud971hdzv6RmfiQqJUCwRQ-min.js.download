if(data.completed){var rows=Math.ceil((textarea.scrollHeight-data.padding)/data.rowheight);textarea.rows=Math.min(Math.max(rows,data.minrows),data.maxrows);data.oldscrollheight=textarea.scrollHeight;jqtextarea.toggleClass('autoresize_expanded',rows>data.maxrows);}}
