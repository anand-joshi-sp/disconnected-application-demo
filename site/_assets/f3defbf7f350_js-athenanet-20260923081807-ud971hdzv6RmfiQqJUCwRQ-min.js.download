if(keys(AH.GlobalElements).length){AH.Frames.Top.Frame().HideGlobalElements();}
var practiceid=AH.GetGlobal('LOGINPRACTICEID')?AH.GetGlobal('LOGINPRACTICEID'):loginpractice;var departmentid=AH.GetGlobal('DEPARTMENTID')?AH.GetGlobal('DEPARTMENTID'):department;var params={RESUMESESSION:1,USERNAME:username,PRACTICEID:practiceid,DEPARTMENTID:departmentid,CONCIERGEMODE:AH.GetGlobal('CONCIERGEMODE')?AH.GetGlobal('CONCIERGEMODE'):0};if(isTablet()){params.VIEWCROSSBROWSER=1;}
if(currentusername!=username){params.CURRENTUSERNAME=currentusername;}
else{params.TIMEDOUT=1;}
