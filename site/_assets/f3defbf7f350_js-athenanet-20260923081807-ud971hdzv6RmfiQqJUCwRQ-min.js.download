function CheckAllergy(field,checkbox){if((isNull(field)&&isNull(checkbox))||(!isNull(checkbox)&&checkbox.checked)){return;}
var section=GetSectionContainer(field);var nkdacheckbox=jQuery(section).find("input[name='PATIENTALLERGY_NKDA']").get(0);var nkdaallergyflag=0;var normalallergyflag=0;var table=document.getElementById('PATIENTALLERGYCART');var indexoflastrow=table.rows.length;var allrows=GetChildren(table,'tagName','tr');for(var i=0;i<allrows.length;i++){if(allrows[i].id&&allrows[i].id.match(/PATIENTALLERGY_ALLERGYID_\d+/)){var deactivated=allrows[i].className&&allrows[i].className.match(/DeactivatedAllergyRow/);if(!deactivated&&allrows[i].innerHTML&&allrows[i].innerHTML.match(/NO KNOWN DRUG ALLERGIES/)){nkdaallergyflag=1;}
else if(!deactivated){normalallergyflag=1;}}}
var namevalue;if(field){var autoobject=field.autocompleteobj;var idvalue=field.value;if(autoobject.autocompletionname==''){return;}
namevalue=TrimWhitespace(autoobject.autocompletionname);}else{var rowobj=checkbox.parentElement.parentElement;namevalue=rowobj.cells[0].innerHTML;}
if(namevalue&&normalallergyflag&&namevalue.match(/NO KNOWN DRUG ALLERGIES/)){alert("Can't add NO KNOWN DRUG ALLERGIES when allergy is present. Please first deactivate allergies added.");if(field){field.value='';}else{checkbox.checked=1;}
return 1;}
if((nkdaallergyflag||nkdacheckbox.checked)&&!namevalue.match(/NO KNOWN DRUG ALLERGIES/)){if(nkdaallergyflag){alert("Can't add an allergy when NO KNOWN DRUG ALLERGIES is present. Please first deactivate NO KNOWN DRUG ALLERGIES.");}
else{alert("Can't add an allergy when NKDA is checked. Please first uncheck NKDA.");}
if(field){field.value='';}else{checkbox.checked=1;}
return 1;}
if(namevalue.match(/NO KNOWN DRUG ALLERGIES/)){nkdacheckbox.checked=1;}
return;}
