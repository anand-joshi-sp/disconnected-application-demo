function GetAllClinicalProcedureRows(args){return GetServiceTableRows({SERVICEID:args.SERVICEID,CLINICALROWS:args.CLINICALROWS,ROWNAME:'clinicalprocedurerow'});}
function GetServiceTableRows(args){var servicetablerows=(args.CLINICALROWS)?args.CLINICALROWS:document.getElementById('servicetablebody').children;var rowslength=servicetablerows.length;var rowname=args.ROWNAME;var servicerowidregex=new RegExp(EscapeRegExp(args.SERVICEID));var selectedrows=[];var currentrow;for(var i=0;i<rowslength;i++){currentrow=servicetablerows[i];if((!rowname||currentrow.getAttribute('name')==rowname)&&servicerowidregex.test(currentrow.getAttribute('id'))){selectedrows.push(currentrow);}}
return selectedrows;}
function AddServiceWarning(clinicalprocedurerow,warningname,warningtext,noncritical){if(clinicalprocedurerow.style.display=='none'){return;}
var servicetable=document.getElementById('servicetable');var serviceprefix=clinicalprocedurerow.id;var warningprefix=serviceprefix+'{WARNING}';var outerwarningdiv=document.getElementById(warningprefix);var duplicatewarningdivs=GetChildren(outerwarningdiv,'tagName','div','name',warningname);if(duplicatewarningdivs&&duplicatewarningdivs.length>0){for(var i=0;i<duplicatewarningdivs.length;i++){if(duplicatewarningdivs[i].name==warningname&&duplicatewarningdivs[i].warningtext==warningtext){return;}}}
var warningdiv=document.createElement('div');warningdiv.setAttribute('name',warningname);warningdiv.className='clinicalservicewarningitem';warningdiv.setAttribute('warningtext',warningtext);if(noncritical){warningdiv.innerHTML="<span class='sprite-alert-unknown clinicalserviceicon clinicalservicewarning'></span>&nbsp;&nbsp;<span name='warningtext'>"+warningtext+"</span>";}
else{warningdiv.innerHTML="<span class='sprite-alert-moderate clinicalserviceicon clinicalservicewarning'></span>&nbsp;&nbsp;<span name='warningtext'>"+warningtext+"</span>";}
outerwarningdiv.appendChild(warningdiv);if(outerwarningdiv.style.display=='none'&&clinicalprocedurerow.style.display!='none'){outerwarningdiv.style.display='';}}
function DeleteServiceWarning(clinicalprocedurerow,warningname){var servicetable=document.getElementById('servicetable');var serviceprefix=clinicalprocedurerow.id;var warningprefix=serviceprefix+'{WARNING}';var warningdiv=document.getElementById(warningprefix);var warningdivs=GetChildren(warningdiv,'tagName','div','name',warningname);if(warningdivs&&warningdivs.length>0){for(var i=0;i<warningdivs.length;i++){warningdiv.removeChild(warningdivs[i]);}
