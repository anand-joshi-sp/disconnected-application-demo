function _AddICD9Row(newicd9code,desc,jqblock,supressalerts,raf){var sectioncontainer=GetSectionContainer(jqblock.get(0));var icd9count=jqblock.children('div').length;var snomeddxid=jqblock.attr('ID');var reg=/DIAGNOSIS_ICD9BLOCK_(.*)/;var snomedordering=reg.exec(snomeddxid)[1];var icd9s=GetICD9CodeData(snomedordering);var icd9codes=icd9s[0];var icd9descriptions=icd9s[1];var icd9codevals=icd9codes.val();var icd9descriptionvals=icd9descriptions.val();if(icd9codevals){var icd9codelist=icd9codevals.split(/\t/);for(var i=0;i<icd9codelist.length;i++){if(newicd9code==icd9codelist[i]){if(!supressalerts){alert("The selected ICD-9 code has already been added:\n"+desc);}
return;}}
icd9codes.val(icd9codevals+"\t"+newicd9code);icd9descriptions.val(icd9descriptionvals+"\t"+desc);}
else{icd9codes.val(newicd9code);icd9descriptions.val(desc);}
