var jqlabel=jqcontainer.find('span#PROCEDURECODELABEL');jqlabel.html(procedurecodename);jqlabel.prop('title',procedurecode);}
field.value='';setTimeout(function(){jqcontainer.find("button[name='ADDPROCEDURE']").focus()},10);}
