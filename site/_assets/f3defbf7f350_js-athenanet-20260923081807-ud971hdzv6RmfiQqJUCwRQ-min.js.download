"' onchange='ShowDropdownOptions(this);'>"+
"<option value='POS/NEG'>Pos/Neg"+
"<option value='NORMAL/ABNORMAL'>Normal/Abnormal"+
"<option value='FREETEXT' selected>Free Text"+
"<option value='DROPDOWN'>Dropdown"+
"<option value='MATCHABOVE'>(match above)"+
"</select>";cellobj.innerHTML=cellobj.innerHTML+
"<div style='display:none;' class='freetext'>"+
"<table><tr><th>Options</th><th></th></tr><tr>"+
"<td><input size=10 maxlength=100 name='VALUEOPTIONS{"+(+i+1)+"}{"+(+j+1)+"}{1}{OPTION}' type=TEXT></td>"+
"<td><a href='javascript:void(0);' onclick='AddBlankRow(); SwitchToDeleteLink(this);' title='Add Row'>"+
"<span class='sprite-add nodefaultcursor' title='Add Row'></span></a></td></tr>"+
"</table>"+
"</div>";}
