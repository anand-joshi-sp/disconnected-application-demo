if(AH&&AH.IsMain&&AH.Frames.GlobalNav.Frame()&&AH.Frames.GlobalNav.Document()&&AH.Frames.GlobalNav.GetGlobal('contextid')&&AH.Frames.GlobalNav.GetGlobal('contextid')!=GetContextID()){var pagename=GetPageName();var switchurls=new Array("/billing/hcfa.esp","/client/clientsummary.esp","/client/registration.esp","/message/addmessage.esp","/message/viewmessages.esp","/client/labels.esp","/client/labelsdetailed.esp","/eligibility/eligibility.esp","/client/insurancehistory.esp","/schedule/appointmenttickler.esp","/client/chartcheck.esp","/client/patientchart.esp","/schedule/appointmenthistory.esp","/billing/hcfanew.esp","/billing/viewclaims.esp","/billing/unappliedpayment.esp","/billingadmin/unappliedrefund.esp","/billingadmin/insurancerefund.esp","/client/clientstatement.esp","/client/clientstatementinfo.esp","/billing/erabatch.esp","/billingadmin/paymentbatchadmin.esp","/billing/claimedit.esp","/billing/claimadd.esp");for(var i=0;i<switchurls.length;i++){if(switchurls[i]==pagename){if(confirm("In order to proceed, you must switch to another practice. Continue?")){;AH.SetGlobal('SKIPLOGOUTDIALOG',1);AH.Frames.Top.SetLocation(GetBaseHref()+'/globalframeset.esp?browserwidth='+window.screen.width+'&browserheight='+window.screen.width+'&MAIN='+escape(document.location));}}}}}
