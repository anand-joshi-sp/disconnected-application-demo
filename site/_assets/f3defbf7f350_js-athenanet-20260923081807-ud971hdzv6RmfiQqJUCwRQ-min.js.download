function FindDataRecHiddenFieldElements(){return jQuery('input[id*=DATARECONCILEITEM][type="hidden"]');}
function GetDataRecObjectsFromHiddenFields(hiddenFieldElements){var itemList=[];var itemLookup={};hiddenFieldElements=hiddenFieldElements||[];jQuery(hiddenFieldElements).each(function(i,el){var decoded=DecodeDataRecHiddenFieldIdString(el.id);if(!decoded){return;}
if(!itemLookup[decoded.prefix]){itemList.push(decoded.prefix);}
var item=itemLookup[decoded.prefix]||{_decoded_fields:decoded};var remainder=decoded.remainder;if(remainder){delete decoded.remainder;item[remainder.replace(/[{}]/g,'')]=el.value;}
itemLookup[decoded.prefix]=item;});jQuery.each(itemList,function(i,itemKey){var item=itemLookup[itemKey];item._decoded_fields.domSortIndex=i;});return itemLookup;}
function DecodeDataRecHiddenFieldIdString(id){var matches=id.match(/^(DATARECONCILEITEM{(\w+)}{(\w*)}{(\d*)}{((?:NEW_)?\d+)})(.*)/);if(matches){return{prefix:matches[1],section:matches[2],sourceType:matches[3],sourceId:matches[4],metaId:matches[5],remainder:matches[6]};}
return null;}
function PopulateDataReconcileConfirm(args){var totalhtml=args.HTML;var accordion=args.ACCORDION;var confirmchanges=args.CONFIRMCHANGES;var isNoKnownProblemsEnabled=args.IS_NO_KNOWN_PROBLEMS_ENABLED;var sectionitems=accordion.children().children().children().children('[id^="'+EscapeJQuerySelector(args.FIELDPREFIX)+'"]').first().siblings();var matchitems=jQuery("[id*='INTERNAL'].datareconcileitemmatch",sectionitems);var archivematchitems=jQuery(".datareconcileitemarchivematch",matchitems);var selecteditems=jQuery(".datareconcileitemselected",sectionitems);var preselecteditems=jQuery("#datareconcileitem",matchitems);var preselectedarchiveitems=jQuery(".datareconcileitemarchive",sectionitems);var preselecteditemsother=jQuery(".datareconcileitemarchiveunselected",sectionitems);var html="<div class=datarecconfirmsectionname>"+args.SECTIONNAME+"</div><br>";var allitems=new Array(selecteditems,preselecteditems,preselectedarchiveitems,archivematchitems);var arraylength=allitems.length;var body='';for(var i=0;i<arraylength;i++){var items=allitems[i];jQuery.each(jQuery(items),function(index,item){var title=jQuery(".datareconcileitemtitle",item).html();if((title=='No matching item in master chart')||(title=='No matching item in document')){if(args.SECTIONNAME=='Flowsheets'){var unselected=jQuery(".datareconcileitem",jQuery(item).parent().siblings());title=jQuery(".datareconcileitemtitle",unselected).html();item='';}
else{title=jQuery(".datareconcileitemtitle",item).html();item=preselecteditemsother[index];}}
var date='';var details='';var note='';if(item){date=jQuery(".datareconcileitemdate",item).html();details=jQuery(".datareconcileitemdetails",item).html();var defaultroute=jQuery(".defaultdosageroute",item).first().text();details=ReplaceMedicationRoute(details,defaultroute);note=jQuery('input',jQuery("#toggleField",item)).val();if(note===undefined){note=jQuery('textarea',jQuery("#toggleField",item)).val();}
if((i==1)&&(note===undefined)){details=details||jQuery(".datareconcileitemnotes",item).html();}}
if((title!='No matching item in master chart')&&(title!='No matching item in document')){if(isNoKnownProblemsEnabled&&args.SECTIONNAME==='Problems'){body+="<div class=\"data-rec-confirm-item\"><div class=datarecconfirmbody>"+title+"</div>";if(date){body+="<div class=datarecconfirmdate>"+date+"</div>";}
if(details){body+=details.replace(/<br>/g,'');}}
else{body+="<div><span class=datarecconfirmbody>"+title+"</span><span class=datarecconfirmdate>"+date+"</span>";}
if(details){if(isNoKnownProblemsEnabled&&args.SECTIONNAME==="Problems"){}
else{body+='<div class=clear></div>'+details;}}
if(note){body+='<div class=clear></div>Note: '+note;}
body+='</div><br>';}});}
if(body){totalhtml=totalhtml+html+body;}
else if(args.SECTIONNAME!='Flowsheets'){totalhtml=totalhtml+html+'<div>This section of the chart will be empty.</div><br>';}
return totalhtml;}
function ReplaceMedicationRoute(itemdetails,supportedroute){if(!supportedroute){return itemdetails;}
else{return itemdetails.replace(/Route: [\w\s\.-]+/,"Route: "+supportedroute);}}
