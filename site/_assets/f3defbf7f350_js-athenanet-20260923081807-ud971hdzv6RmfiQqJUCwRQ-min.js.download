if(clinicalproviderrequiredforlocalnetwork===1&&!submitnone){var clinicalordertypegroupname=this.getAttribute('clinicalordertypegroupname');var documentstatus=this.getAttribute('documentstatus');if(clinicalordertypegroupname&&(clinicalordertypegroupname==='CONSULT'||clinicalordertypegroupname==='IMAGING')&&documentstatus&&(documentstatus==='SUBMIT'))
