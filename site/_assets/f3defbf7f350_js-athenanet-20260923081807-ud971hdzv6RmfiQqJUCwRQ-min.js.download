function isMultiPatientCookie(cookie){if(cookie!=='undefined'){var cookieArr=cookie.split(';');if(cookieArr.length>=4){return true;}}
return false;}
function processCookie(batchName,res,statusVal,successflag){if(res!=='undefined'&&isMultiPatientCookie(res)){var currUpdatedCookie=res.split(";");currUpdatedCookie[2]=statusVal;if(!successflag){currUpdatedCookie[3]="1";}
setCookie(batchName,currUpdatedCookie);}}
function getCookie(batchName){var cookie={};document.cookie.split(";").forEach(function(val){var valArr=val.split('=');var k=valArr[0];var v=valArr[1];cookie[k.trim()]=v;})
return decodeURIComponent(cookie[batchName]);}
function setCookie(batchName,val){document.cookie=batchName+"="+encodeURIComponent(val.join(";"))+"; path=/";}
