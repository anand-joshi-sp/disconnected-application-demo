function SelectDymoPrinterAndPrint(fields,labelurl,DymoAddIn,DymoLabel){var dymoprinters=DymoAddIn.GetDymoPrinters();if(!dymoprinters){alert('No DYMO printers are installed. Install a DYMO printer.');return;}
if(!AH.GetGlobal('printerselectpopupopen')){dymoprinters=dymoprinters.split("|");var connecteddymoprinters=jQuery.grep(dymoprinters,function(dymoprinter){return DymoAddIn.IsPrinterOnline(dymoprinter);});if(!connecteddymoprinters.length){alert('No DYMO printers are connected. Connect a DYMO printer.');return;}
else if(connecteddymoprinters.length==1){PrintToSelectedDymoPrinter(fields,labelurl,connecteddymoprinters[0],DymoAddIn,DymoLabel)
return;}
OpenDymoPrinterSelect({CONNECTEDDYMOPRINTERS:connecteddymoprinters,FIELDS:fields,LABELURL:labelurl,DYMOADDIN:DymoAddIn,DYMOLABEL:DymoLabel,ADMENABLED:false});}
else{WaitForDymoPrinterSelectThenPrint({FIELDS:fields,LABELURL:labelurl,DYMOADDIN:DymoAddIn,DYMOLABEL:DymoLabel,ADMENABLED:false});}}
function WaitForDymoPrinterSelectThenPrint(args){function _WaitForDymoPrinterSelectThenPrint(args){if(!AH.GetGlobal('printerselectpopupopen')){if(AH.GetGlobal('nodymoprinterselected')){return;}
var selecteddymoprinter=GetCookieValue('UNENCRYPTED_DYMOPRINTERNAME');selecteddymoprinter=decodeURIComponent(selecteddymoprinter);if(args.ADMENABLED){window.DYMOLabelPrinter.CallPrintWithPrinter(args.LABELURL,args.FIELDS,selecteddymoprinter);}
else{PrintToSelectedDymoPrinter(args.FIELDS,args.LABELURL,selecteddymoprinter,args.DYMOADDIN,args.DYMOLABEL,true);}}
else{setTimeout(function(){_WaitForDymoPrinterSelectThenPrint(args);},100);}}
_WaitForDymoPrinterSelectThenPrint(args);}
