var ButtonGroup={OnMouseEnter:function(button){if(button.className.match(/disabled/)){return;}
if(!button.className.match(/active/)){button.className+=' active';}},OnMouseLeave:function(button){if(button.className.match(/disabled/)){return;}
if(button.className.match(/active/)){button.className=button.className.replace(/( |\b)active\b/,'');}},Toggle:function(source){var clickedbutton=window.event.srcElement;if(clickedbutton.className.match(/disabled/)){return;}
ButtonGroup.SetValue(clickedbutton.parentNode,(ButtonGroup.IsActive(clickedbutton))?'':jQuery(clickedbutton).attr('optionvalue'));},SetValue:function(buttongroup,value){var allbuttons=GetChildren(buttongroup,'className',/button/);for(var i=0;i<allbuttons.length;i++){var thisbutton=allbuttons[i];if(jQuery(thisbutton).attr('optionvalue')==value){ButtonGroup.Activate(thisbutton);}
else{ButtonGroup.Deactivate(thisbutton);}}
var hiddeninput=jQuery("[name='"+EscapeJQuerySelector(jQuery(buttongroup).attr('hiddeninputname'))+"']",buttongroup).get(0);hiddeninput.value=value;},IsActive:function(button){return button&&button.className.match(/selected/);},Activate:function(button){if(!button.className.match(/( |\b)selected\b/)){button.className+=' selected';}},Deactivate:function(button){button.className=button.className.replace(/( |\b)selected\b/g,'');}}
