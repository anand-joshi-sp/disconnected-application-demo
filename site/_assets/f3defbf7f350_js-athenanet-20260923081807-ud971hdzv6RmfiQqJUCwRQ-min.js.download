function DiagnosisOrdersAdjustTabWidths(diagnosisorderstabscontainer){var musthidesection=0;var oldstyle;var sectioncontainer=GetSectionContainer(diagnosisorderstabscontainer);if(jQuery(sectioncontainer).css('display')=='none'){musthidesection=1;oldstyle=jQuery(sectioncontainer).css('display');jQuery(sectioncontainer).css('display','block');}
var tabs=GetChildren(diagnosisorderstabscontainer,'tagName','span','className',/diagnosisordertab/);var availablewidth=diagnosisorderstabscontainer.offsetWidth-5;AdjustTabWidths(tabs,availablewidth,40,100,4);if(musthidesection){jQuery(sectioncontainer).css('display',oldstyle);}}
function PickerAdjustTabWidths(pickertabscontainer,pickertabspanclass){var musthidesection=0;var oldstyle;var sectioncontainer=GetSectionContainer(pickertabscontainer);if(jQuery(sectioncontainer).css('display')=='none'){musthidesection=1;oldstyle=jQuery(sectioncontainer).css('display');jQuery(sectioncontainer).css('display','block');}
var classregex=new RegExp(pickertabspanclass);var tabs=GetChildren(pickertabscontainer,'tagName','span','className',classregex);var availablewidth=pickertabscontainer.offsetWidth-5;AdjustTabWidths(tabs,availablewidth,40,75,4);if(musthidesection){jQuery(sectioncontainer).css('display',oldstyle);}}
function AdjustTabWidths(tabs,availablewidth,tabminwidth,tabdefaultwidth,totalmargin){if(!isDefined(tabminwidth)){tabminwidth=40;}
if(!isDefined(tabdefaultwidth)){tabdefaultwidth=100;}
var totalwidth=0;var totalcount=0;for(var i=0;i<tabs.length;i++){if(tabs[i].scrollWidth==0){for(var j=0;j<tabs.length;j++){jQuery(tabs[j]).css('width',tabdefaultwidth);}
return;}
totalwidth+=tabs[i].scrollWidth;totalwidth+=totalmargin;totalcount++;}
if(totalwidth>availablewidth){var adjusttowidth=(availablewidth/totalcount)-totalmargin;if(adjusttowidth<tabminwidth){adjusttowidth=tabminwidth;}else{adjusttowidth=Math.floor(adjusttowidth);}
tabs.sort(function(a,b){return a.scrollWidth-b.scrollWidth});for(var i=0;i<tabs.length;i++){if(tabs[i].scrollWidth<adjusttowidth){adjusttowidth=adjusttowidth+Math.floor((adjusttowidth-tabs[i].scrollWidth)/(totalcount-i-1));SetTabWidth(tabs[i],tabs[i].scrollWidth);}
else{SetTabWidth(tabs[i],adjusttowidth);}}}else{for(var i=0;i<tabs.length;i++){var computedscrollwidth;if(window.getComputedStyle){var computedscrollwidth=Math.ceil(parseFloat(window.getComputedStyle(tabs[i]).width)
+parseInt(jQuery(tabs[i]).css('padding-left'))
+parseInt(jQuery(tabs[i]).css('padding-right')));}
else{computedscrollwidth=tabs[i].scrollWidth;}
SetTabWidth(tabs[i],computedscrollwidth);}}}
function SetTabWidth(tab,width){jQuery(tab).css('width',width);var widthdiff=tab.clientWidth-width;if(widthdiff>0){jQuery(tab).css('width',width-widthdiff);}}
