for(j=0;j<document.zform.CHARGEPROCEDURECODE.length;j++){if(document.zform.CHARGEPROCEDURECODE[j].value!==''){if(document.zform.CHARGEPROCEDURECODEVALID[j].value==0){alert("This claim cannot be saved with an invalid procedure code ("+document.zform.CHARGEPROCEDURECODE[j].value+").");return false;}
if(!document.zform.CHARGEDIAGNOSISREF1[j].disabled&&document.zform.CHARGEDIAGNOSISREF1[j].value===''){alert("You have a charge without a diagnosis reference.");return false;}
for(var k=1;k<=4;k++){if(isNaN(document.zform['CHARGEDIAGNOSISREF'+k][j].value)||document.zform['CHARGEDIAGNOSISREF'+k][j].value==' '){alert('Diagnosis reference '+k+
' ( \''+document.zform['CHARGEDIAGNOSISREF'+k][j].value+'\' ) '+
' for procedure '+document.zform.CHARGEPROCEDURECODE[j].value+
' must be numeric');return false;}}
for(k=1;k<=3;k++){if(document.zform['CHARGEDIAGNOSISREF'+k][j].value==''&&document.zform['CHARGEDIAGNOSISREF'+(k+1)][j].value!==''&&!document.zform.CHARGEPROCEDURECODE[j].disabled){alert('Diagnosis reference '+k+
' for procedure '+document.zform.CHARGEPROCEDURECODE[j].value+
' is empty, while diagnosis reference '+(k+1)+
' is filled. Please shift the diagnosis references to fill all empty spaces. ');return false;}}
for(k=1;k<=4;k++){if((k==1||document.zform['CHARGEDIAGNOSISREF'+k][j].value!='')&&(!eval("document.zform.DIAGNOSIS"+document.zform['CHARGEDIAGNOSISREF'+k][j].value)||eval("document.zform.DIAGNOSIS"+document.zform['CHARGEDIAGNOSISREF'+k][j].value+".value == ''"))&&(!document.zform.CHARGEPROCEDURECODE[j].disabled)){alert('Diagnosis reference '+k+
' for procedure '+document.zform.CHARGEPROCEDURECODE[j].value+
' is pointing to a nonexistent diagnosis'+
' ( \''+document.zform['CHARGEDIAGNOSISREF'+k][j].value+'\' ) ');return false;}}
if(!TrimWhitespace(document.zform.CHARGEDAYS[j].value).match(/^\-?\d+$/g)){alert("Charge units must be a whole number.");return false;}
else if(document.zform.CHARGEDAYS[j].value&&document.zform.CHARGEDAYS[j].value<=0){alert("Charge units must be greater than zero.");return false;}
else if(document.zform.CHARGEDAYS[j].value>99){if(!confirm('The number of units for procedure code '+document.zform.CHARGEPROCEDURECODE[j].value+' is unusually large ('+document.zform.CHARGEDAYS[j].value+'). Do you want to continue?')){try{document.zform.CHARGEDAYS[j].focus()}catch(e){};return false;}}
var chargeamount=document.zform.CHARGEAMOUNT[j];if(chargeamount.value.match(/^\s*$/)||isNaN(chargeamount.value)){var chargeamountalert=chargeamount.value.match(/^\s*$/)?'You must enter a charge amount.':'Charge amount must be numeric.';var editchargelinelink=jQuery('.editchargelinelink.view.row'+j);if(editchargelinelink.length){editchargelinelink.click();}
alert(chargeamountalert);chargeamount.focus();return false;}
for(i=0;i<noNulls.length;i++){var element=jQuery('[name=zform]').find('[name='+noNulls[i]+']:eq('+j+')');if(!element.prop('disabled')&&element.val()===''){alert("Field "+noNullsDescription[i]+" cannot be blank.");try{eval("document.zform."+noNulls[i]+"["+j+"].focus()");}catch(e){};return false;}}
enteredProcedureCodes++;}else if(document.zform.CHARGENOTVOIDABLE[j].value>0){alert("This charge cannot be voided.");try{document.zform.CHARGEPROCEDURECODE[j].focus();}catch(e){};return false;}}
var jqdiaginputs=jQuery('.diag');if(jqdiaginputs.length){var hasinvaliddiag=false;var jquerydiag=jQuery('.diag:not(.precertfield):not(.otherdiag)');var dpdiaginputs=jQuery.grep(jquerydiag,function(elem){return(jQuery(elem).val()!=='');});for(i=0;i<dpdiaginputs.length;i++){for(j=i+1;j<dpdiaginputs.length;j++){if(dpdiaginputs[i].value.toUpperCase()==dpdiaginputs[j].value.toUpperCase()){alert("This claim cannot be saved with a duplicate diagnosis code ("+dpdiaginputs[i].value.toUpperCase()+").");return false;}}}
jqdiaginputs.each(function(i,elem){if(jQuery(elem).hasClass('InvalidInput')){alert("This claim cannot be saved with an invalid diagnosis code ("+elem.value+").");hasinvaliddiag=true;return false;}});if(hasinvaliddiag){return false;}}
else{for(k=0;k<8;k++){diagcode=eval('document.zform.DIAGNOSIS'+(k+1)+'.value');if(document.zform.DIAGNOSISCODEVALID[k].value==0&&diagcode!=''){alert("This claim cannot be saved with an invalid diagnosis code ("+diagcode+").");return false;}}}
if(enteredProcedureCodes==0){if(confirm('THIS CLAIM WILL NOW BE DELETED because all of its procedure\ncodes are being deleted.  Continue with the delete?')){document.location=AH.PrependBasePath("/billing/hcfadelete.esp?CLAIMID="+claimid+'&POSTDATE='+document.zform.POSTDATE.value);}
return false;}
if(document.zform.MANUALDROPYN.value&&!document.zform.WASMANUALDROPYN){if(document.zform.MANUALDROPREASONID.value==''){alert("You must select a reason for forcing this claim to drop to paper.");return false;}}
if(document.zform.MANUALDROPYN2.value&&!document.zform.WASMANUALDROPYN2){if(document.zform.MANUALDROPREASONID2.value==''){alert("You must select a reason for forcing this claim to drop to paper.");return false;}}
if(document.zform.STATUS.value.indexOf('HOLD')>=0&&document.zform.KICKCODE.value==''){alert("You must specify a kick reason if you want to put the claim into one of the HOLD statuses.");try{document.zform.KICKCODE.focus;}catch(e){};return false;}
if(document.zform.STATUS.value!=''&&document.zform.KICKCODE.value==''&&document.zform.EDITNOTE.value==''){alert("You must add either a kick reason or an edit note if changing a claim status.");try{document.zform.EDITNOTE.focus;}catch(e){};return false;}
if((document.zform.PRIMARYPATIENTINSURANCEID.value!=document.zform.OLDPRIMARYPATIENTINSURANCEID.value||document.zform.SECONDARYPATIENTINSURANCEID.value!=document.zform.OLDSECONDARYPATIENTINSURANCEID.value)&&document.zform.EDITNOTE.value==''){alert("You must add an edit note if changing primary or secondary payor.");try{document.zform.EDITNOTE.focus;}catch(e){};return false;}
if(!CheckPostDate(document.zform.POSTDATE)){return false;}
if(!CheckChargeFromDate()){return false;}
if(document.zform.CHARGENDC&&document.zform.CHARGENDC.length){for(i=0;i<document.zform.CHARGENDC.length;i++){if(document.zform.CHARGENDC[i].value!=''&&document.zform.CHARGENDC[i].value.length<11){alert("NDC Numbers must be 11 characters.");eval("document.zform.CHARGENDC[i].focus()");return false;}}}
if(jQuery('#KICKREASONOPTION').hasClass('RequiredField')&&jQuery('#KICKREASONOPTION').val()==''){alert('You must choose a kick reason option.');try{jQuery('#KICKREASONOPTION').focus();}catch(e){};return false;}
if(jQuery('#ESCALATEDPAYERSITECLASS').hasClass('RequiredField')&&jQuery('#ESCALATEDPAYERSITECLASS').val()==''){alert('You must choose a PayerSite class.');try{jQuery('#ESCALATEDPAYERSITECLASS').focus();}catch(e){};return false;}
return!ClaimUtils.DeferSubmit();}
function CheckChargeAmount(element){var chargelineindex=GetParent(element,'tagName','tr').getAttribute('i');if(!isNaN(element.value)){ClaimUtils.SubmitBlockingCallRemote({SUB:'Charge::AboveUnitAmountLimit',ARGS:{PROCEDURECODE:document.zform.CHARGEPROCEDURECODE[chargelineindex].value,UNITAMOUNT:element.value},ONFINISH:function(pxcode){if(pxcode){if(!confirm('The charge per unit for procedure code '+pxcode+' is unusually high ('+FormatCurrency(document.zform.CHARGEAMOUNT[chargelineindex].value,'$')+'). Do you want to continue?')){try{document.zform.CHARGEAMOUNT[chargelineindex].focus()}catch(e){};}}}});}}
function CheckChargeFromDate(){var fromdateobj;var postdateobj=jQuery('#POSTDATE')[0];var postdate=new Date(postdateobj.value);if(document.location.pathname.indexOf("claimadd.esp")!=-1||document.location.pathname.indexOf("hcfanew.esp")!=-1){fromdateobj=jQuery('input[name=FROMDATE]');}
else{fromdateobj=jQuery('input[name=CHARGEFROMDATE]');}
for(var i=0;i<fromdateobj.length&&(fromdateobj[i].value!=''||fromdateobj[i].offsetWidth>0||fromdateobj[i].offsetHeight>0);i++){if(fromdateobj[i].value!=''){var fromdate=new Date(fromdateobj[i].value);if(fromdate>postdate){alert("Postdate ("+postdateobj.value+") cannot be earlier than Charges From Date ("+fromdateobj[i].value+")");fromdateobj[i].value='';if(jQuery(fromdateobj[i]).hasClass('hidden')){ClaimEdit.SwitchViewEditMode();}
fromdateobj[i].focus();return false;}}}
return true;}
function DiagBlurFormat(element){FillSame(element.getAttribute('i'),element);var newVal=Trim(element.value.toUpperCase());newVal=newVal.replace(/\./g,"");try{element.innerText=newVal;}
catch(e){}
if(element.value!=newVal){element.value=newVal;}}
function DiagBlur(element){DiagBlurFormat(element);MyLookupDiag(element);}
function NDCBlur(element){var $element=jQuery(element||event.srcElement);var $dosagefields=$element.closest('table').find('input[name$=DRUGDOSAGE],select[name$=DRUGUNITQUALIFIER]');if($element.val()&&!$dosagefields.first().hasClass('NeverRequiredField')){$dosagefields.addClass('RequiredFieldColor');}
else{$dosagefields.removeClass('RequiredFieldColor');}
var ndc=ClaimUtils.FormatNDC($element.val());$element.val(ndc.FORMATTED);var input=new InputWrapper($element[0]);if(ndc.ISVALID){input.MarkValid();$element.nextAll('span.alert').hide();}
else{input.MarkInvalid('NDC must be 11 digits.');$element.nextAll('span.alert').show();}
$element.prev('input').val(ndc.NDC);if(ndc.NDC&&ndc.ISVALID){CallRemote({SUB:'Claim::HTML::GetNDCTradeName',ARGS:{NDC:ndc.NDC},ONFINISH:function(tradename){if(tradename){$element.nextAll('span.tradename').html(tradename).show();}
else{$element.nextAll('span.tradename').html('<span class="athenawarningmessage">No drug found</span>').show();}}});}
else{$element.nextAll('span.tradename').html('').hide();}
ClaimUtils.ToggleNDCErrorMessages($element);return;}
function NDCKeyUp(el){if(IsArrowKeyEvent()){return;}
element=el||event.srcElement;var procedurecode;if(document.zform.PROCEDURECODE0){procedurecode=document.zform.PROCEDURECODE0[element.getAttribute("i")].value;}
else{procedurecode=document.zform.CHARGEPROCEDURECODE[element.getAttribute("i")].value;}
MyLookupNDC(element,procedurecode);}
function ProcedureBlurFormat(){if(event.srcElement.getAttribute('i')){FillSame(event.srcElement.getAttribute('i'));}
var newVal=TrimWhitespace(event.srcElement.value.toUpperCase());try{event.srcElement.innerText=newVal;}
catch(e){}
if(event.srcElement.value!=newVal){event.srcElement.value=newVal;}
ShowHideCodeCorrectLookup(event.srcElement);}
function ProcedureBlur(){ProcedureBlurFormat();var $input=jQuery(event.srcElement);if(!$input.val()){var chargelineindex=parseInt($input.attr('i'),10);var $chargeline=jQuery('.chargeline'+chargelineindex);var $charges=$chargeline.find('.proc');var chargesperline=$charges.length;var procindex=$charges.index($input);RemoveNDCInfo(chargelineindex*chargesperline+procindex);}}
function ProcedureKeyUp(){var el=event.srcElement;MyLookupProc(el);}
function ProcedureChange(element){setTimeout(function(){ValidateProcedureCodeInput(element);},0);}
function FormatSelectChange(theselect,url,claimid){if(arguments.length!=3){alert("FormatSelectChange called with "+arguments.length
+" arguments, but 3 were expected.\nArgs: "+Dumper(arguments));return void(0);}
var newformname=selectValue(theselect);var jqselect=jQuery(theselect);var oldformname=jqselect.attr('lastselection');jqselect.attr('lastselection',newformname);var parentdiv=GetParent(theselect,'tagName','div','controlscustomform',1);if(oldformname){UnloadForm(parentdiv,oldformname);}
if(newformname){LoadForm(parentdiv,newformname,url,claimid);}}
function HandleSpecialtyCheckboxClick(checkbox,formname,url,claimid,haschargehtml,clinicalfields){if(arguments.length!=5&&arguments.length!=6){alert("HandleSpecialtyCheckboxClick called with "+arguments.length
+" arguments, but 5 were expected.\nArgs: "+Dumper(arguments));return void(0);}
if(url.match(/hcfanew\.esp/)&&haschargehtml){var advancedbutton=GetChild(document,'tagName','input','type','submit','name','SUBMITSHOWVIEW','value',/Advanced/);if(!advancedbutton){if(formname==='NDCCode'){AH.SetGlobal('ndcuserdidrequest',true);}
NormalizeCustomClaimHTMLDisplay(url);}
else if(checkbox.checked){if(confirm('You have selected a service type add-on that requires advanced charge entry. Click OK to continue to Advanced Charge Entry, or click Cancel to stay in Basic Charge Entry.')){if(formname==='NDCCode'){checkbox.checked=false;ClaimUtils.AddNDCCodeInputs(true);return;}
else{advancedbutton.click();}}
else{checkbox.checked=false;return;}}}
else if(formname==='NDCCode'){AH.SetGlobal('ndcuserdidrequest',true);}
var parentdivs=jQuery('div[id="'+formname+'Control"]').toArray();if(parentdivs.length===0){parentdivs=GetChildren(document,'id',formname+'Control','tagName','div','controlscustomform',1);}
var skipNDCUpdates;if(formname==='NDCCode'){skipNDCUpdates=AH.GetGlobal('isHospitalClaim');}
if(checkbox.checked){var chargeleveldivs=[];var i=parentdivs.length;while(parentdivs[--i]){if(parentdivs[i].getAttribute('chargelevel')==1){chargeleveldivs.unshift(parentdivs.splice(i,1)[0]);}}
if(parentdivs.length){LoadForm(parentdivs[0],formname,url,claimid,1,null,clinicalfields);}
if(chargeleveldivs.length){var firstchargeleveldiv=chargeleveldivs.shift();LoadForm(firstchargeleveldiv,formname,url,claimid,1,chargeleveldivs,clinicalfields);}}
else{for(var i=0;i<parentdivs.length;i++){UnloadForm(parentdivs[i],formname,skipNDCUpdates);}}}
function InitializeCustomForms(url,claimid){var activesets=GetActiveInputSetDivs();if(activesets.length>0){var namecounts=[];var formatdivs=[];jQuery.each(document.getElementsByTagName('div'),function(ind,val){if(val.getAttribute('iscustomform')==1){formatdivs.push(val);}});for(var i=0;i<formatdivs.length;i++){var name=formatdivs[i].id;if(namecounts[name]>0){namecounts[name]++;}
else{namecounts[name]=1;}}
for(var name in namecounts){var formatdivs2=[];jQuery.each(document.getElementsByTagName('div'),function(ind,val){if(val.getAttribute('iscustomform')==1&&val.getAttribute('id')==name){formatdivs2.push(val);}});for(var j=1;j<formatdivs2.length;j++){formatdivs2[j].outerHTML='';}}
for(var i=0;i<activesets.length;i++){var activeset=activesets[i];var formname=GetFormNameFromDiv(activeset);if(formname){UnloadForm(activeset,formname,true);}}
for(var i=0;i<activesets.length;i++){var activeset=activesets[i];var formname=GetFormNameFromDiv(activeset);if(formname){LoadForm(activeset,formname);}}}
document.getElementById('generatingcustomclaimforms').style.display='none';InitializeChargeLevelFields(1);NormalizeCustomClaimHTMLDisplay(url);}
function ValidateExtraClaimFields(){var activesets=GetActiveInputSetDivs();for(var i=0;i<activesets.length;i++){var validationfunctionname="Validate"+GetFormNameFromDiv(activesets[i]);if(window[validationfunctionname]){try{var returnvalue=window[validationfunctionname](activesets[i]);}
catch(e){DisplayError(e,validationfunctionname)}
if(!returnvalue){return false;}}}
return true;}
function GetActiveInputSetDivs(){var controlingdivs=[];jQuery.each(document.getElementsByTagName('div'),function(ind,val){if(val.getAttribute('controlscustomform')==1&&(jQuery(val).is(":visible")||jQuery(val).css('display')!=='none')){controlingdivs.push(val);}});return controlingdivs;}
function GetFormNameFromDiv(thediv){var controlingselect=GetChild(thediv,'tagName','select','controlscustomform',1);if(controlingselect){return selectValue(controlingselect);}
else{var staticname=GetChild(thediv,'tagName','input','type','hidden','name','formname');if(staticname){return staticname.value;}
else{return void(0);}}}
function GetFormTitleFromDiv(thediv){var controlingselect=GetChild(thediv,'tagName','select','controlscustomform',1);if(controlingselect){return selectText(controlingselect);}
else{var staticname=GetChild(thediv,'tagName','input','type','hidden','name','formtitle');if(staticname){return staticname.value;}
else{return"Unknown Form";}}}
var helplinkarray=[];var requestidarray=[];function UnloadForm(parentdiv,formname,skipndcupdates){var inactiveforms=document.getElementById("inactiveforms");var jqparentdiv=jQuery(parentdiv);if(requestidarray[formname]){var waitmessage=GetChild(parentdiv,'tagName','div','id','waitmessage');waitmessage.style.display='none';waitmessage.formatname='';CancelHiddenFrameRequest(requestidarray[formname]);}
var jqduplicatemessage=jqparentdiv.find('#duplicatemessage');if(jqduplicatemessage.length){jqduplicatemessage.hide();}
jqhelplink=jqparentdiv.find('a#helplink');jqhelplink.hide();helplinkarray[formname]=jqhelplink.html();var oldform=jqparentdiv.find(EscapeJQuerySelector('#'+formname)).get(0);var container=_GetSTAOContainer(parentdiv);if(oldform){var duplicateformdiv=GetChild(container,'tagName','div','id','duplicatemessage','formatname',formname,'style.display','');if(duplicateformdiv){duplicateformdiv.formatname='';duplicateformdiv.style.display='none';var controlingdiv=GetParent(duplicateformdiv,'tagName','div','controlscustomform',1);oldform=SetParent(oldform,controlingdiv,'beforeEnd');var jqnewhelplink=jQuery(controlingdiv).find('a#helplink');jqnewhelplink.html(helplinkarray[formname]);jqnewhelplink.show();}
else{oldform=SetParent(oldform,inactiveforms,'beforeEnd');HandleInputsOnFormUnload(oldform);parentdiv.style.display='none';}}
if(!skipndcupdates&&formname==='NDCCode'){jQuery('input.proc').change();}}
function HandleInputsOnFormUnload(theform){var inactiveforms=document.getElementById("inactiveforms");var submittinginputs=GetChildren(theform,'tagName','div','submitting',1);INPUT:for(var i=0;i<submittinginputs.length;i++){var input=submittinginputs[i];if(input.active==1){var inactivesubmittings=jQuery('div[id="'+input.id+'"][active=0][submitting=1]').toArray();if(inactivesubmittings.length>0){for(var j=0;j<inactivesubmittings.length;j++){var inactivesubmitting=inactivesubmittings[j];if(j==0){inactivesubmitting.innerHTML=input.innerHTML;inactivesubmitting.active=1;inactivesubmitting.title='';}
else{PointAtEstablishedInput(inactivesubmitting,inactivesubmittings[0]);}}
input.active=0;}
else{var activestandby=jQuery(inactiveforms).find('div[id="'+input.id+'"][submitting=0][active=1]').get(0);if(activestandby){activestandby.active=0;}}}
input.submitting=0;}}
function LoadForm(parentdiv,formname,url,claimid,ansimodule,chargeleveldivs,clinicalfields){var inactiveforms=document.getElementById("inactiveforms");var jqparentdiv=jQuery(parentdiv);jqparentdiv.show();var loadingmessage=GetChild(document,'id','waitmessage','formatname',formname);var container=_GetSTAOContainer(parentdiv);var jqinactiveforms=jQuery(inactiveforms).find(EscapeJQuerySelector('#'+formname));if(jqinactiveforms.length||!(jQuery(container).find(EscapeJQuerySelector('#'+formname)).length||loadingmessage)||(chargeleveldivs&&chargeleveldivs.length)){var waitmessage=jQuery(parentdiv).find('#waitmessage').get(0);if(!waitmessage){waitmessage=AddElement(parentdiv,'beforeEnd','div','waitmessage');}
waitmessage=SetParent(waitmessage,parentdiv,'beforeEnd');waitmessage.formatname=formname;waitmessage.innerHTML="<h2>Loading "+GetFormTitleFromDiv(parentdiv)+"</h2>";waitmessage.style.display='';if(jqinactiveforms.length){_ContinueLoadForm(false,formname,parentdiv,chargeleveldivs);}
else{var options=[];options.push("FORMAT="+formname);options.push("URL="+url);if(isNumber(claimid))options.push("CLAIMID="+claimid);if(ansimodule)options.push("ANSIMODULE="+1);if(parentdiv.getAttribute('chargelevel')==1){options.push("CHARGELEVEL="+1);}
if(clinicalfields){for(var i in clinicalfields){if(clinicalfields[i]){options.push(i+"="+clinicalfields[i]);}}}
var thelocation=AH.PrependBasePath("/billing/hidden_hcfa_getformsegment.esp?"+options.join('&'));var callback=function(){_ContinueLoadForm(true,formname,parentdiv,chargeleveldivs);};requestidarray[formname]=QueueHiddenFrameRequest(thelocation,callback);}}
else{var existingform=GetChild(container,'id',formname,'tagName','div');var jqduplicatemessage=jqparentdiv.find('#duplicatemessage');var duplicatemessage=jqduplicatemessage.get(0);if(!jqduplicatemessage.length){duplicatemessage=AddElement(parentdiv,'beforeEnd','div','duplicatemessage');jqduplicatemessage=jQuery(duplicatemessage);}
var message=GetFormTitleFromDiv(parentdiv)+" is already ";if(existingform){message+="displayed";}
else{message+="loading";}
duplicatemessage.formatname=formname;duplicatemessage.align='center';duplicatemessage.innerHTML="<strong>"+message+"</strong>";if(existingform&&existingform.innerHTML==''){duplicatemessage.formatname='';jqduplicatemessage.hide();}
else{jqduplicatemessage.show();}}}
function _ContinueLoadForm(loadingnew,formname,insertlocation,chargeleveldivs){var jqscratcharea=jQuery('#scratchdiv');var inactiveforms=document.getElementById("inactiveforms");var container=_GetSTAOContainer(insertlocation);var newformdiv;if(loadingnew){requestidarray[formname]=0;jqscratcharea.html(AH.Frames.Hidden.getElementById('returnvalue').innerHTML);newformdiv=AddElement(inactiveforms,'beforeEnd','div',formname);newformdiv.style.display='none';newformdiv.innerHTML=jqscratcharea.find('#formhtml').text();if(!chargeleveldivs){helplinkarray[formname]=jqscratcharea.find('a#helplink').text();var evalstring="Validate"+formname+" = function( controldiv ){\n"
+jqscratcharea.find('#validationjscript').get(0).innerText
+";\nreturn true;\n"
+"};";try{eval(evalstring);}
catch(e){DisplayError(e,"Validation script: "+evalstring);}}
var duplicatemessage=GetChild(container,'id','duplicatemessage','formatname',formname);if(duplicatemessage){if(newformdiv.innerHTML==''){duplicatemessage.style.display='none';}
else{duplicatemessage.innerHTML="<strong>"+GetFormTitleFromDiv(insertlocation)+" is already displayed</strong>";}}}
if(!newformdiv){newformdiv=jQuery(inactiveforms).find(EscapeJQuerySelector('div#'+formname)).get(0);}
newformdiv.setAttribute('data-customformwrapper','1');var inputs=GetChildren(newformdiv,'tagName',['input','select','textarea']);for(var i=0;i<inputs.length;i++){var input=inputs[i];if(!isDefined(input.DefaultValue)){input.DefaultValue=InputValue(input);}}
SetParent(newformdiv,insertlocation,'beforeEnd');var jqinsertlocation=jQuery(insertlocation);newformdiv=jqinsertlocation.find(EscapeJQuerySelector('#'+formname)).get(0);HandleInputsOnFormLoad(newformdiv,container);if(!isDefined(helplinkarray[formname])){helplinkarray[formname]='';}
var jqhelplink=jqinsertlocation.find('a#helplink');jqhelplink.html(helplinkarray[formname]);if(loadingnew){ExportDynamicFunctions(newformdiv);}
var waitmessage=jqinsertlocation.find('#waitmessage').get(0);if(!waitmessage){waitmessage=AddElement(insertlocation,'beforeEnd','div','waitmessage');}
waitmessage.style.display='none';waitmessage.style.format='';newformdiv.style.display='';jqhelplink.show();if(chargeleveldivs&&chargeleveldivs.length){var nextparentdiv=chargeleveldivs.shift();nextparentdiv.style.display='';_ContinueLoadForm(loadingnew,formname,nextparentdiv,chargeleveldivs);if(chargeleveldivs.length==0)InitializeChargeLevelFields();}
else if(formname==='NDCCode'){if(AH.GetGlobal('ndcuserdidrequest')){AH.SetGlobal('ndcuserdidrequest',undefined);var procedurecodes=jQuery('input.proc').filter(function(){return this.value;}).map(function(){return this.value;}).get();if(procedurecodes.length){ClaimUtils.SubmitBlockingCallRemote({SUB:'Claim::HTML::GetChargeInfo',ARGS:{PROCEDURECODES:procedurecodes,PATIENTID:document.getElementById('PatientActionMenu_DATA').getAttribute('PATIENTID'),PATIENTINSURANCEID:document.zform.PRIMARYPATIENTINSURANCEID.value,DEPARTMENTID:document.zform.DEPARTMENTID.value,DATE:document.zform.SERVICEDATE.value,SUPERVISINGPROVIDERID:InputValue(document.zform.SUPERVISINGPROVIDERID),CHECKDUPE:0,CHECKEXPLODED:0,CHECKAPPOINTMENT:0},LOADINGINDICATORFLAG:true,ONFINISH:function(response){jQuery.each(response.PROCEDURES,function(i,procedureinfo){if(procedureinfo.NDC){AddNDCInfo(procedureinfo,procedureinfo.INDEX);}});jQuery('input[name=NDC_Setter]').filter(function(){return this.value;}).first().focus();}});}}
RunInitJS(document,{RUNALREADYSEEN:true});jQuery('.ndceditlink').hide();}}
function HandleInputsOnFormLoad(theform,container){var inactiveforms=document.getElementById("inactiveforms");var inputs=GetChildren(theform,'tagName','div');for(var i=0;i<inputs.length;i++){var input=inputs[i];var inputid=input.id;input.id='';input.active=1;input.submitting=1;var establishedinput;if(inputid){establishedinput=jQuery(container).find('div[id="'+inputid+'"][submitting=1][active=1][fieldtype="claim"]').get(0);if(establishedinput){PointAtEstablishedInput(input,establishedinput);}}
input.id=inputid;var myparentdivid=GetParent(input,'tagName','div').id;var standby=jQuery(inactiveforms).find('div[id="'+input.id+'"][submitting=0][active=1][fieldtype="claim"]').get(0);if(!establishedinput&&standby){input.innerHTML=standby.innerHTML;standby.active=0;}}}
function PointAtEstablishedInput(subordinantinput,establishedinput){var $subordinantinput=jQuery(subordinantinput);var $establishedinput=jQuery(establishedinput);if(!isDefined(document.zform.ALLOWEDIT)||document.zform.ALLOWEDIT.value==1){var $parentwrapper=$establishedinput.closest('div[data-customformwrapper=1]');jQuery("<a href='#'>edit</a>")
.appendTo($subordinantinput.empty())
.click(function(){var activechilddivselector='div[id='+$establishedinput.attr('id')+'][submitting=1][active=1]';var $activechild=$parentwrapper.find(activechilddivselector);if($activechild.length){$activechild.focus();}
return false;});}
var $controllingdiv=$establishedinput.closest('div[controlscustomform=1]');if($controllingdiv.length){var establishedformname=GetFormTitleFromDiv($controllingdiv.get(0));$subordinantinput.attr('title','The field for this information already exists in '
+establishedformname+'. Click to edit it.');}
subordinantinput.active=0;$subordinantinput.attr('active',0);}
function SwitchInsurance(theselect,transfertype,url,claimid,departmentid){DisableSubmit();var parentdiv=GetChild(document,'id',theselect.getAttribute('formdivid'),'tagName','div','controlscustomform',1);var loadingdiv=GetChild(document,'id',"LOADING"+theselect.getAttribute('formdivid'),'tagName','div');var controlingselect=GetChild(parentdiv,'tagName','select','controlscustomform',1);document.getElementById('customclaimforms').style.display='';loadingdiv.style.display='';parentdiv.style.display='none';var formatdiv=GetChild(parentdiv,'tagName','div','id',selectValue(controlingselect));var oldformname=controlingselect.getAttribute('lastselection');if(oldformname){UnloadForm(parentdiv,oldformname);}
var options={PATIENTINSURANCEID:selectValue(theselect),TRANSFERTYPE:transfertype,URL:url};if(isNumber(claimid))options.CLAIMID=claimid;if(isNumber(departmentid))options.DEPARTMENTID=departmentid;CallRemote({SUB:'Claim::FormatUtils::GetFormatDropdownForPatientInsurance',ARGS:options,ONFINISH:function(returnobject){_ContinueSwitchInsurance(theselect,url,claimid,returnobject.FORMATSELECT);ValidateInsurances();}});}
function _ContinueSwitchInsurance(theselect,url,claimid,selecttext){var parentdiv=GetChild(document,'id',theselect.getAttribute('formdivid'),'tagName','div','controlscustomform',1);var loadingdiv=GetChild(document,'id',"LOADING"+theselect.getAttribute('formdivid'),'tagName','div');var controlingselect=GetChild(parentdiv,'tagName','select','controlscustomform',1);if(selecttext){controlingselect.outerHTML=selecttext;controlingselect=GetChild(parentdiv,'tagName','select','controlscustomform',1);var formname=selectValue(controlingselect);if(formname!=''){LoadForm(parentdiv,selectValue(controlingselect),url,claimid);parentdiv.style.display='';}
else{}}
loadingdiv.style.display='none';NormalizeCustomClaimHTMLDisplay(url);EnableSubmit();}
function ValidateInsurances(){if(CheckInsuranceMatch()){EnableSubmit();}else{DisableSubmit();}}
function CheckInsuranceMatch(){if(jQuery('#PRIMARYPATIENTINSURANCEID option:selected').val().toString()!=='0'&&jQuery('#PRIMARYPATIENTINSURANCEID option:selected').val()==jQuery('#SECONDARYPATIENTINSURANCEID option:selected').val()){jQuery('#warningduplicateinsurances').show();return false;}
else{jQuery('#warningduplicateinsurances').hide();return true;}}
function RepopulateSecondaryInsuranceDropdown(){var primarypatientinsurancequery=jQuery('#PRIMARYPATIENTINSURANCEID');var secondarypatientinsurancequery=jQuery('#SECONDARYPATIENTINSURANCEID');var primarypatientinsuranceid=primarypatientinsurancequery.val();var secondarypatientinsuranceid=secondarypatientinsurancequery.val();secondarypatientinsurancequery.find('option').remove();var primaryoptions=primarypatientinsurancequery.find('option').clone();if(secondarypatientinsuranceid[0]===primarypatientinsuranceid[0]||primarypatientinsuranceid[0]==='0'){secondarypatientinsurancequery.append(primaryoptions);}
else{var secondaryoptions=primaryoptions.filter(":not(option[value="+primarypatientinsuranceid+"])");secondarypatientinsurancequery.append(secondaryoptions);}
secondarypatientinsurancequery.val(secondarypatientinsuranceid);}
function NormalizeCustomClaimHTMLDisplay(url){var customclaimcontainer=document.getElementById('customclaimforms');var visibledivs=GetChildren(customclaimcontainer,'tagName','div','style.display','','id',['PRIMARYDIV','LOADINGPRIMARYDIV','SECONDARYDIV','LOADINGSECONDARYDIV','SPECIALTYFIELDSDIV']);if(visibledivs.length){customclaimcontainer.style.display='';}
else{customclaimcontainer.style.display='none';}
var simplebutton=GetChild(document,'tagName','input','type','submit','name','SUBMITSHOWVIEW','value',/Simple/);if(simplebutton&&url.match(/hcfanew\.esp/)){var essentialdivs=GetChildren(customclaimcontainer,'tagName','div','style.display','','id',['PRIMARYDIV','LOADINGPRIMARYDIV','SECONDARYDIV','LOADINGSECONDARYDIV']);var specialtyfieldsdiv=document.getElementById('SPECIALTYFIELDSDIV');var chargelevelinputs=specialtyfieldsdiv?GetChildren(specialtyfieldsdiv,'tagName','input','haschargelevelinput',1,'checked',true):new Array();if(essentialdivs.length||chargelevelinputs.length){jQuery('.basiclink').addClass('disabledlink');simplebutton.disabled=true;simplebutton.title='Simple view cannot be used because there are custom claim fields displayed.';}
else{jQuery('.basiclink').removeClass('disabledlink');simplebutton.disabled=false;simplebutton.title='';}}}
function SetSupervisingProvider(providerid,providername){document.zform.SUPERVISINGPROVIDERID.value=providerid;if(document.zform.SUPERVISINGPROVIDERID.value!=providerid){alert('Provider '+providername+' not available');}}
function OnChangeCMNQuestionNumber(activeInput){var codeinput='CMNQUESTION';var codetable=document.getElementById(codeinput);if(Trim(activeInput.value)){document.zform.CMNQUESTIONINDEX.value++;document.zform.CMNQUESTIONINDEX.value=('00'+document.zform.CMNQUESTIONINDEX.value).slice(-2);var index=document.zform.CMNQUESTIONINDEX.value;var NewRow=codetable.insertRow(-1);var activeInputValue=activeInput.value;activeInput.value='';CallRemote({SUB:'Claim::ExtendedFields::GetCMNQuestionsFields',ARGS:{INDEX:index,QUESTIONNUMBER:activeInputValue},ONFINISH:function(returnobject){if(returnobject){SetCMNInputFields(NewRow,index,activeInputValue,returnobject);}}});}}
function SetCMNInputFields(coderow,cmnquestionindex,activeInputValue,cmnfields){var codeinputrow='CMNQUESTIONHEADER';var headercoderow=document.getElementById(codeinputrow);if(document.zform.QUESTIONHEADERSPRESENT.value==0){var thelement=document.createElement("th");headercoderow.appendChild(thelement);thelement.innerText='\nResponse';var thelement=document.createElement("th");headercoderow.appendChild(thelement);thelement.innerText='\nDate';var thelement=document.createElement("th");headercoderow.appendChild(thelement);thelement.innerText='\nPercent';var thelement=document.createElement("th");headercoderow.appendChild(thelement);thelement.innerText='\nAdditional Information';document.zform.QUESTIONHEADERSPRESENT.value=1;}
CreateCMNQuestionTableRow(coderow,activeInputValue,cmnfields);document.getElementById('EXTRACLAIM_GLOBAL_CMNQUESTION'+cmnquestionindex+'YN').focus();}
function CreateCMNQuestionTableRow(coderow,activeInputValue,cmnfields){var thelement=CreateColumnCell(coderow,"th");thelement.innerText=activeInputValue;var tdelement=CreateColumnCell(coderow,"td");tdelement.innerHTML=cmnfields.CMNQUESTIONYN;var tdelement=CreateColumnCell(coderow,"td");tdelement.innerHTML=cmnfields.CMNQUESTIONDATE;var tdelement=CreateColumnCell(coderow,"td");tdelement.innerHTML=cmnfields.CMNQUESTIONPERCENT;var tdelement=CreateColumnCell(coderow,"td");tdelement.innerHTML=cmnfields.CMNQUESTIONADDITIONALINFO;tdelement.innerHTML+=cmnfields.CMNQUESTIONNUMBER;}
function LookupFacilityClaimCode(activeInput,codeset,moc){if(activeInput.value=="."){activeInput.value="";MediumModalPopupWindow({page:AH.PrependBasePath('/help/facilityclaimcodelookup.esp?CODESET='+codeset),title:'UB04 Code Lookup',onclose:function(response){if(response){_LookupFacilityClaimCode(activeInput,codeset,response,moc);}
else{activeInput.value="";}}});}}
function _LookupFacilityClaimCode(activeInput,codeset,response,moc){AH.SetGlobal('activeInput',activeInput);if(response){var inputfieldname='EXTRACLAIM_UB04_'+codeset+response[0];var codeinput,codetable,NewRow,thelement,newInputCell,rowNum;if(codeset=='OCCURRENCESPANCODE'){inputfieldname+="FROMDATE";}
if(jQuery("[name='"+inputfieldname+"']").length==0){codeinput=codeset+'_NEWINPUT';codetable=jQuery('#'+EscapeJQuerySelector(codeinput)).get(0);NewRow=codetable.insertRow(-1);thelement=document.createElement("th");NewRow.appendChild(thelement);thelement.innerText=response[0];thelement.title=response[1];newInputCell=document.createElement("td");NewRow.appendChild(newInputCell);CallRemote({SUB:'Claim::FacilityClaimCode::GetFacilityClaimInput',ARGS:{'CODESET':codeset,'CODE':response[0]},ONFINISH:function(codesethtml){newInputCell.innerHTML=codesethtml;var input=jQuery("[name='"+EscapeJQuerySelector(inputfieldname)+"']").get(0);input.focus();}});}
else if(moc){codeinput=codeset+'_NEWINPUT';codetable=jQuery('#'+EscapeJQuerySelector(codeinput)).get(0);NewRow=codetable.insertRow(-1);thelement=document.createElement("th");rowNum=jQuery("[name^='"+inputfieldname+"']").length;NewRow.appendChild(thelement);thelement.innerText=response[0];thelement.title=response[1];newInputCell=document.createElement("td");NewRow.appendChild(newInputCell);CallRemote({SUB:'Claim::FacilityClaimCode::GetFacilityClaimInput',ARGS:{'CODESET':codeset,'CODE':response[0],'ROW':rowNum},ONFINISH:function(codesethtml){newInputCell.innerHTML=codesethtml;var input=jQuery("[name='"+EscapeJQuerySelector(inputfieldname+rowNum)+"']").get(0);input.focus();}});}
else{alert("Code "+response[0]+" already exists.");}}
activeInput.value="";}
function onChangeFacilityClaimCode(activeInput,codeset,moc){var code=activeInput.value;code=code.replace(/\s/g,'');code=code.toUpperCase();activeInput.value=code;CallRemote({SUB:'Claim::FacilityClaimCode::GetFacilityClaimInput',ARGS:{'CODESET':codeset,'CODE':escape(code),'GETDESCRIPTION':1},ONFINISH:function(description){if(description&&description.match(/[0-9A-z]/)){var response=new Array();response[0]=activeInput.value;response[1]=description;_LookupFacilityClaimCode(activeInput,codeset,response,moc);}
else{alert([activeInput.value]+" is not a valid code.");activeInput.value='';activeInput.focus();}}});}
function LookupRevenueCode(inputbox){var args='';if(inputbox.value=='.'){inputbox.value="";var url=AH.PrependBasePath('/help/revenuecodelookup.esp?SHOWNORESULT=1');var code=document.getElementById('REVENUECODENAME').innerText.split('-');if(code){url+='&REVENUECODE='+code[0];}
MediumModalPopupWindow({page:url,title:'Choose Revenue Code',onclose:function(responses){if(responses){inputbox.value=responses[0];if(responses[0]){document.getElementById('REVENUECODENAME').innerText=responses[0]+'-'+responses[1];}
else{document.getElementById('REVENUECODENAME').innerText='';}}
else{inputbox.value=code[0];}}});}}
function ChargelevelShowHide(element,forceshow){var elementtohide;if(element){elementtohide=GetChild(GetParent(element),'id','chargelevelinputs','tagName','span');}
if(elementtohide){var jqelement=jQuery(element);var plus=jqelement.children('img#img_plus');var minus=jqelement.children('img#img_minus');if(elementtohide.style.display=='none'||forceshow){elementtohide.style.display='';if(plus.length){plus.hide();}
if(minus.length){minus.show();}}
else{elementtohide.style.display='none';if(plus.length){plus.show();}
if(minus.length){minus.hide();}}}}
function ChargeLevelKeyDown(element){if(event.keyCode==13){ChargelevelShowHide(element,1);}}
function InitializeChargeLevelFields(checkvaluesonly){var tablerows=jQuery('tr[id="CUSTOMCHARGEDATA"]').toArray();if(tablerows.length===0){tablerows=GetChildren(document,'tagName','tr','id','CUSTOMCHARGEDATA');}
for(var i=0;i<tablerows.length;++i){var customchargedata=tablerows[i];var specialtydivs=GetChildren(customchargedata,'tagName','div','controlscustomform',1,'chargelevel',1);for(var j=0;j<specialtydivs.length;++j){var haschargevalue=0;var inputdivs=GetChildren(specialtydivs[j],'tagName','div','fieldtype','charge');for(var k=0;k<inputdivs.length;++k){var input=GetChild(inputdivs[k]);var inputvalue=eval('customchargedata.'+input.name);if(checkvaluesonly&&(input.tagName!='SPAN'&&InputValue(input))){haschargevalue=1;}
else if(isDefined(inputvalue)){SetInputValue(input,inputvalue);haschargevalue=1;}}
if(haschargevalue){_RunInitializationFunction(specialtydivs[j]);ChargelevelShowHide(GetChild(specialtydivs[j],'tagName','a','id','SpecialtyShowHideControl'),1);}}}}
function _RunInitializationFunction(chargelevelparentdiv){var validationfunctionname="Initialize"+GetFormNameFromDiv(chargelevelparentdiv);if(window[validationfunctionname]){try{var returnvalue=window[validationfunctionname](chargelevelparentdiv);}
catch(e){DisplayError(e,validationfunctionname)}}}
function GetChargeLevelInput(chargelevelcontroldiv,inputname){var childdiv=jQuery(chargelevelcontroldiv).find('#'+EscapeJQuerySelector(inputname)).get(0);if(childdiv){return jQuery(childdiv).find("[name='"+EscapeJQuerySelector(inputname)+"']").get(0);}}
function GetChargeDataRow(chargeid){var datarows=document.all('CHARGEDATA');for(var i=0;i<datarows.length;++i){if(chargeid==datarows[i].getAttribute('chargeid')){return datarows[i];}}}
function Clocktime(hours,minutes,ampm){this.hours=hours;this.minutes=minutes;this.ampm=ampm;}
function MilitaryTimeDifference(militarystarttime,militaryendtime){var starthours=militarystarttime.substring(0,2);var startminutes=militarystarttime.substring(2,4);var endhours=militaryendtime.substring(0,2);var endminutes=militaryendtime.substring(2,4);var starttimeinminutes=(starthours*60)+(startminutes-0);var endtimeinminutes=(endhours*60)+(endminutes-0);var difference=endtimeinminutes-starttimeinminutes;if(difference<0){difference+=24*60;}
return difference;}
var parsetimeerrormsg='Time must be entered in a format like 12:30, for example. \nThe hour must be between 1 and 12. \nThe minute must be between 0 and 59.';var militaryparsetimeerrormsg='Time must be entered in a format like 12:30, for example. \nThe hour must be between 0 and 23. \nThe minute must be between 0 and 59.';function ParseTime(timeelement,timeampmelement){var time=timeelement.value;var timeampm=timeampmelement.value;if(time&&timeampm){var hours;var minutes;if(time.match(':')){var timearray=time.split(':');hours=timearray[0]-0;minutes=timearray[1]-0;}
else{hours=time.slice(0,-2)-0;minutes=time.slice(-2)-0;}
if(hours>=1&&hours<=12&&minutes>=0&&minutes<=59){minutes=('00'+minutes).slice(-2);return new Clocktime(hours,minutes,timeampm);}}}
function ParseMilitaryTime(timeelement){var time=timeelement.value;if(time){var hours;var minutes;if(time.match(/^\d+:\d+$/)){var timearray=time.split(':');hours=timearray[0]-0;minutes=timearray[1]-0;}
else{hours=time.slice(0,-2)-0;minutes=time.slice(-2)-0;}
if(hours>=0&&hours<=23&&minutes>=0&&minutes<=59){minutes=('00'+minutes).slice(-2);hours=('00'+hours).slice(-2);return new Clocktime(hours,minutes);}}}
function EnableSubmit(){jQuery('input[type*=SUBMIT]')
.not("#switchview")
.prop('disabled',false);}
function DisableSubmit(){jQuery('input[type*=SUBMIT]')
.not("#switchview")
.prop('disabled',true);}
function LookupChargeAmount(){var charges=[];for(var i=0;i<document.zform.CHARGEAMOUNT.length;i++){if(document.zform.CHARGEPROCEDURECODE[i].value!=''){var formattedcharge=i+'|'+document.zform.CHARGEFROMDATE[i].value+'|'+
document.zform.CHARGEPROCEDURECODE[i].value+'|'+document.zform.CHARGEAMOUNT[i].value;charges.push(formattedcharge);}}
CallRemote({SUB:'Claim::GetChargeAmountUpdateJS',ARGS:{PRIMARYPATIENTINSURANCEID:document.zform.PRIMARYPATIENTINSURANCEID.value,DEPARTMENTID:document.zform.DEPARTMENTID.value,CHARGES:charges},LOADINGINDICATORFLAG:true,ONFINISH:function(refreshamountsjs){var RefreshAmounts=new Function(refreshamountsjs);return(RefreshAmounts());}});}
function _GetSTAOContainer(parentdiv){if(parentdiv.clinical){var parent=parentdiv.parentElement;while(parent){if(parent.name=='clinicalstaodiv'&&parent.tagName=='div'){return parent;}
parent=parent.parentElement;}}
return document;}
function UpdateSupervisingProvider(providerid){CallRemote({SUB:'Provider::SupervisingProviderHintHTMLWrapper',ARGS:{'PROVIDERID':providerid,'SUPPRESSSTYLING':1},ONFINISH:function(response){if(AH.Frames.Main.Document().zform&&AH.Frames.Main.Document().zform.PROVIDERID){if(response.ID){AH.Frames.Main.Document().zform.SUPERVISINGPROVIDERID.value=response.ID;AH.Frames.Main.getElementById('SUPERVISINGPROVIDERHINT').innerText='';if(AH.Frames.Main.Frame().UpdateAcceptAssignmentDefaults){AH.Frames.Main.Frame().UpdateAcceptAssignmentDefaults();}}
else{AH.Frames.Main.getElementById('SUPERVISINGPROVIDERHINT').innerHTML=response.HINT;}
AH.SetGlobal('isDirty',false);if(AH.GetGlobal('waitingToSubmit')){AH.SetGlobal('waitingToSubmit',false);AH.GetGlobal('pendingSubmitButton').click();}}}});}
function FillSame(index,element){var elem=element||event.srcElement;var newVal;if(elem.value=='s'||elem.value=='S'||elem.value=='='){if(index>0){newVal=jQuery('[name="'+elem.name+'"]').get(index-1).value;}
else{newVal="";}
try{elem.innerText=newVal;}
catch(e){}
if(elem.value!=newVal){elem.value=newVal;}}};function checkServiceDate(){if(document.zform.SERVICEDATE&&document.zform.EARLIESTDATEOFSERVICE&&document.zform.EARLIESTDATEOFSERVICE.value!==''&&Date.parse(document.zform.SERVICEDATE.value)<Date.parse(document.zform.EARLIESTDATEOFSERVICE.value)){alert("The date of service you entered is earlier than the earliest date of service on file ("
+document.zform.EARLIESTDATEOFSERVICE.value
+"). Please contact your Account Manager if you need to have the date on file updated.");document.zform.SERVICEDATE.focus();return false;}
return true;}
function GetKickReasonOptions(){return{"WEBACCESSRVW":{"Add Legacy":"An active login is available for this payer. However, the legacy number must be added. Please add the login information in order to complete the necessary claim follow up.","Add NPI":"An active login is available for this payer. However, the provider NPI must be added. Please add the login information in order to complete the necessary claim follow up.","Add Provider Name":"An active login is available for this payer. However, the provider name must be added. Please add the login information in order to complete the necessary claim follow up.","Add Taxonomy":"An active login is available for this payer. However, the taxonomy must be added. Please add the login information in order to complete the necessary claim follow up.","Add TIN":"An active login is available for this payer. However, the TIN must be added. Please add the login information in order to complete the necessary claim follow up.","Enable Remits Option":"An active login is available for this payer. However, the remittance option must be enabled. Please add the login information in order to complete the necessary claim follow up.","Enable Claim Status Option":"An active login is available for this payer. However, the claim status option must be enabled. Please add the login information in order to complete the necessary claim follow up.","Inactive PayerSite Credential":"The login provided for this practice and payer combination is currently unavailable. Please activate the login through the appropriate channels to complete the necessary claim follow up.","New Login Request":"The claim status and remittance for this payer should be obtained from the payer web portal. Please add the login information in order to complete the necessary claim follow up.","Other":""}};}
function ShowKickReasonOption(kickcode,optionelement,rowelement,claimnoteelement){var kickcodereasonrowoptions=GetKickReasonOptions();if(kickcodereasonrowoptions[kickcode]){optionelement.find('option').remove();optionelement.append("<option value=''/>");for(var kickreasonoption in kickcodereasonrowoptions[kickcode]){optionelement.append("<option value='"+kickreasonoption+"'>"+kickreasonoption+"</option>");}
rowelement.show();optionelement.addClass('RequiredField');optionelement.focus();}
else{rowelement.hide();optionelement.removeClass('RequiredField');claimnoteelement.removeClass('RequiredField');RemovePreviousKickReasonOptionText('',kickcode,claimnoteelement);}}
function OnChangeKickReasonOption(kickreasonoption,escalatedpayersiteclass,kickcode,claimnoteelement){var kickcodereasonrowoptions=GetKickReasonOptions();RemovePreviousKickReasonOptionText(kickreasonoption,kickcode,claimnoteelement);if(kickcodereasonrowoptions[kickcode][kickreasonoption]){claimnoteelement.val(kickcodereasonrowoptions[kickcode][kickreasonoption]+claimnoteelement.val());}
if(kickreasonoption==='Other'||escalatedpayersiteclass==='0'){claimnoteelement.addClass('RequiredField');}
else{claimnoteelement.removeClass('RequiredField');}}
function RemovePreviousKickReasonOptionText(option,kickcode,claimnoteelement){var previousoption=jQuery(this).data("previouskickreasonoption");var previouskickcode=jQuery(this).data("previouskickcode");jQuery(this).data("previouskickreasonoption",option);jQuery(this).data("previouskickcode",kickcode);if(previousoption==""||previouskickcode==""||previousoption==null||previouskickcode==null){return;}
var kickcodereasonrowoptions=GetKickReasonOptions();if(kickcodereasonrowoptions[previouskickcode][previousoption]){var previoustext=kickcodereasonrowoptions[previouskickcode][previousoption];var regex=new RegExp(previoustext);claimnoteelement.val(claimnoteelement.val().replace(regex,''));}}
function ShowEscalatedPayerSiteClassOptions(kickcode,payersiteclasselement,rowelement,claimnoteelement){var kickcodereasonrowoptions=GetKickReasonOptions();if(kickcode=='WEBACCESSRVW'){rowelement.show();payersiteclasselement.addClass('RequiredField');payersiteclasselement.focus();}
else{rowelement.hide();payersiteclasselement.val('');payersiteclasselement.removeClass('RequiredField');claimnoteelement.removeClass('RequiredField');}}
function OnChangeEscalatedPayerSiteClass(escalatedpayersiteclass,kickreasonoption,claimnoteelement){if(escalatedpayersiteclass==='0'||kickreasonoption==='Other'){claimnoteelement.addClass('RequiredField');}
else{claimnoteelement.removeClass('RequiredField');}}
(function(window){var ClaimUtils={};var outstandingrequests=[];var dirtyelements=[];ClaimUtils.GetPageName=function(){var matches=document.URL.match(/\/([^\/]+)\.esp/i);return matches[1].toUpperCase();};ClaimUtils.HasDirtyInputs=function(){return dirtyelements.length>0;};ClaimUtils.GetDirtyInputs=function(){return dirtyelements;};ClaimUtils.MarkInputDirty=function(inputelement){var index=jQuery.inArray(inputelement,dirtyelements);if(index===-1){dirtyelements.push(inputelement);}};ClaimUtils.MarkInputClean=function(inputelement){var index=jQuery.inArray(inputelement,dirtyelements);if(index!==-1){dirtyelements.splice(index,1);}};ClaimUtils.MarkInputValid=function(inputelement){ClaimUtils.MarkInputClean(inputelement);var wrapper=new InputWrapper(inputelement);wrapper.MarkValid();};ClaimUtils.SubmitBlockingCallRemote=function(args){outstandingrequests.push(CallRemote(args));};ClaimUtils.GetOutstandingRequests=function(){outstandingrequests=jQuery.grep(outstandingrequests,function(request){if(request.isResolved()||request.isRejected()){return false;}
return true;});return outstandingrequests;};ClaimUtils.GetICDVersion=function(servicedate){var switchoverdate=jQuery("#ICD10SWITCHOVERDATE").val(),version="ICD-9";if((servicedate&&switchoverdate)&&(servicedate===switchoverdate||IsDateAfter(servicedate,switchoverdate))){version="ICD-10";}
