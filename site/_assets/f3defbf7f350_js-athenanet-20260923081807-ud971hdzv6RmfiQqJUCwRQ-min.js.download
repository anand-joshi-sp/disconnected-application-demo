cell.innerHTML="<input name="+fieldname+" type=hidden value='"+value+"'>"+EscapeHTML(namevalue);cell.title=title;newrow.insertCell(1).innerHTML="<td><span>"+"<input class='removeie10clearicon' type='TEXT' name=DISPLAY_PATIENTSURGICALHISTORY{_"+
