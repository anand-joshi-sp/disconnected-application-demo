link.style.display=ssn?'inline':'none';}
function BPRDisableOnlyShowSubtotals(issubtotal){if(zform.ONLYSHOWSUBTOTALS){if(!issubtotal){zform.ONLYSHOWSUBTOTALS.checked=false;zform.ONLYSHOWSUBTOTALS.disabled=true;}
else{zform.ONLYSHOWSUBTOTALS.disabled=false;}}}
function Eval(string,thisobj){try{return(function(){eval(string)}.bind(thisobj||this))();}
catch(originalerror){var error=new Error([originalerror.message,'From (eval):',string.replace(/^/g,' ')].join('\n'));throw(error);}}
function ToggleCheckBoxGroup(checkbox,inputname,optionvalue){var groupcontainer=GetParent(checkbox,'className',/checkboxgroup/,'hiddeninputname',inputname);var hiddeninput=GetChild(groupcontainer,'name',inputname);if(checkbox.checked){hiddeninput.value=optionvalue;}
else{hiddeninput.value='';}
var checkboxes=GetChildren(groupcontainer,'type','checkbox','id',new RegExp(EscapeRegExp(inputname)));for(var i=0;i<checkboxes.length;i++){if(checkboxes[i].id!=checkbox.id){checkboxes[i].checked=false;}}}
function SetCheckBoxGroupValue(checkbox,value){var groupcontainer=jQuery(checkbox).parent().get(0);if(!isDefined(groupcontainer)||!jQuery(groupcontainer).hasClass("checkboxgroup")){return;}
var hiddenvalue="";var checkboxes=jQuery(":checkbox",groupcontainer);jQuery.each(jQuery(checkboxes),function(index,checkbox){if(checkbox.optionvalue==value){checkbox.checked=true;hiddenvalue=value;}
else{checkbox.checked=false;}});var hiddeninput=jQuery('[name="'+groupcontainer.hiddeninputname+'"]').val(hiddenvalue);}
var contentsublist=new Array();var contentargslist=new Array();function AccordionChange(accordionid,index,force){var accordion=jQuery('#'+accordionid);var contents=AccordionContents(accordionid);if(index<0||index>contents.length){return;}
var content=jQuery(contents[index]);if(!force&&content.html()){return;}
if(!isDefined(contentsublist[accordionid])||!isDefined(contentargslist[accordionid])||contentsublist[accordionid].length<=index||contentargslist[accordionid].length<=index){return;}
content.html('');var busy=new BusyIndicator();busy.Start(content.get(0),{size:12,ticks:8,tickradius:6,tickwidth:3});CallRemote({SUB:contentsublist[accordionid][index],ARGS:contentargslist[accordionid][index],ONFINISH:function(data){if(data.HEADER){SetInnerHTMLNoStyles(content.prev('h3').children('.ui-accordion-header-inner').get(0),data.HEADER);}
if(data.CONTENT){SetInnerHTMLNoStyles(content.get(0),data.CONTENT);}
else{SetInnerHTMLNoStyles(content.get(0),data);}
content.hide().show(0);accordion.accordion("resize");busy.Stop(content.get(0));}});}
