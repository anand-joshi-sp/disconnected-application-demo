+'&CHARTID='+chartid+'&FLOWSHEETID='+flowsheetid
+'&FLOWSHEETTEMPLATEID='+templateid),REFRESH:1,PATIENTID:patientid});}
function DeleteHeaderElementRow(deletebuttonimg){var pageheaderelementstable=GetParent(deletebuttonimg,'id','PAGEHEADERELEMENTSTABLE');var temp=deletebuttonimg;while(temp.tagName!='TR'){temp=temp.parentNode;}
pageheaderelementstable.deleteRow(temp.rowIndex);}
function AddPageHeaderElement(addbutton,headerelements,headerdisplaynames){var nameobject=document.getElementById('PAGETOPELEMENTNAME');var inputtypeobject=document.getElementById('PAGETOPELEMENTINPUTTYPE');var optionsobject=document.getElementById('PAGETOPELEMENTELEMENTKEY');var orderingobject=document.getElementById('PAGETOPELEMENTORDERING');if(nameobject.value==''||inputtypeobject.value==''){alert("Please enter a name and select an input type.");return;}
var name=nameobject.value;var inputtype=inputtypeobject.value;var pageheaderelementstable=GetParent(addbutton,'id','PAGEHEADERELEMENTSTABLE');if(jQuery("#"+EscapeJQuerySelector('HEADERELEMENTS{'+name+'}{NAME}'),pageheaderelementstable).size()){alert("'"+name+"' is already a page-header element");return;}
var indexofnewrow=pageheaderelementstable.rows.length;var newrow=pageheaderelementstable.insertRow(indexofnewrow);var ordering=orderingobject.value?orderingobject.value:indexofnewrow-2;newrow.insertCell(0).innerHTML="<input type='type' "+
"name='HEADERELEMENTS{"+name+"}{NAME}' "+
"id='HEADERELEMENTS{"+name+"}{NAME}' "+
"value='"+name+"'>"+
"<input type='hidden' "+
"name='HEADERELEMENTS{"+name+"}{ELEMENTCLASS}'"+
"id='HEADERELEMENTS{"+name+"}{ELEMENTCLASS}'"+
"value='HEADERELEMENT'>";var options="<option value=''>";if(headerelements&&headerelements.length>0){for(i=0;i<headerelements.length;i++){options+="<option value='"+headerelements[i]+"'>"+headerdisplaynames[i];}}
var typecell=newrow.insertCell(1);typecell.innerHTML="<select "+
"prefix='HEADERELEMENTS{"+name+"}{' "+
"onchange='var inputtype = jQuery(this); ChangeFlowsheetAdminOptionWidget(inputtype.parent().next(), inputtype.val(), inputtype.attr(\"prefix\"));' "+
"id='HEADERELEMENTS{"+name+"}{INPUTTYPE}' "+
"name='HEADERELEMENTS{"+name+"}{INPUTTYPE}' "+
"value='"+inputtype+"'>"+
options+
"</select>";var typefield=document.getElementById("HEADERELEMENTS{"+name+"}{INPUTTYPE}");selectSetValue(typefield,inputtype);var optionscell=newrow.insertCell(2);newrow.insertCell(3).innerHTML="<input type='text' style='width: 50px' "+
"name='HEADERELEMENTS{"+name+"}{ORDERING}' "+
"id='HEADERELEMENTS{"+name+"}{ORDERING}' "+
"value='"+ordering+"'>";newrow.insertCell(4).innerHTML="<span "+
"style='cursor:pointer; align:right;' "+
"onclick=';DeleteHeaderElementRow(event.srcElement);'>"+
"<span title='Delete Element' class=sprite-del-16x16></span>"+
"</span>";if(optionsobject&&optionsobject.value){ChangeFlowsheetAdminOptionWidget(optionscell,inputtype,"HEADERELEMENTS{"+name+"}{",optionsobject.value);}
nameobject.value='';inputtypeobject.value='';if(optionsobject){optionsobject.outerHTML='';}
orderingobject.value='';}
function ChangeFlowsheetAdminOptionWidget(optionnode,inputtype,prefix,value){var jqoptionnode=jQuery(optionnode);if(inputtype!=''){var classname="Clinical::Flowsheet::HeaderElement::"+inputtype;CallRemote({ARGS:{CLASS:classname,PREFIX:prefix,VALUE:value},SUB:"Clinical::Flowsheet::HeaderElement::OptionsWidgetHTML",ONFINISH:function(html){if(html){jqoptionnode.html(html);}else{jqoptionnode.html('');}}});}else{jqoptionnode.html('');}}
function ReverseTable(dateheader,flowsheettemplateid){var tablebody=GetParent(dateheader,'id','FLOWSHEET_'+flowsheettemplateid);var table=tablebody.parentNode;if(table.sortmethod=='newestfirst'){for(var i=0;i<table.rows.length;i++){tablebody.insertBefore(table.rows[i],table.rows[1]);}
var analyteheaderrow=GetChild(table,'id','ANALYTEHEADER');if(analyteheaderrow){tablebody.insertBefore(analyteheaderrow,table.rows[1]);}
table.sortmethod='oldestfirst';}
else if(table.sortmethod=='oldestfirst'){for(var i=0;i<table.rows.length;i++){tablebody.insertBefore(table.rows[i],table.rows[1]);}
var inputrow=GetChild(table,'id','INPUTROW');var analyteheaderrow=GetChild(table,'id','ANALYTEHEADER');if(analyteheaderrow&&inputrow){tablebody.insertBefore(analyteheaderrow,inputrow);}
table.sortmethod='newestfirst';}
var arrowimg=GetChild(dateheader.parentNode,'id','SORTARROW');if(arrowimg.className.match('arrowdown')){arrowimg.className=arrowimg.className.replace('arrowdown','arrowup');}
else{arrowimg.className=arrowimg.className.replace('arrowup','arrowdown');}}
function VerifyBoxesChecked(){var documentactionreasonid=ActionReasonChosen();var assignedtochanged;if(!documentactionreasonid){var groupassignedto=document.zform.GROUPASSIGNEDTO;if(groupassignedto){var assignedto=groupassignedto.value;var newassignedto=jQuery('[name=ASSIGNEDTO]').val();assignedtochanged=assignedto!=newassignedto;}}
var someboxchecked=false;var textboxeswithtext=new Array();for(i=0;i<document.zform.elements.length;i++){if(document.zform[i].type=='checkbox'){if(document.zform[i].name.match(/^DOCUMENTID.[0-9]+$/)&&document.zform[i].checked==true){someboxchecked=true;}}
else if(document.zform[i].type=='TEXTAREA'&&document.zform[i].value!=''){var matcharray=document.zform[i].name.match(/^PROVIDERNOTE.([0-9]+)$/);if(matcharray&&matcharray[1]!=''){textboxeswithtext[textboxeswithtext.length]=matcharray[1];}}}
var actionnotevalue=TrimWhitespace(document.forms[0].ACTIONNOTE.value);if((documentactionreasonid||assignedtochanged||actionnotevalue!='')&&!someboxchecked){alert('If an action is chosen or an action note is added, at least one checkbox must be checked.');return false;}
for(i=0;i<textboxeswithtext.length;i++){var checkboxes=new Array();var checkboxenames='DOCUMENTSFORPROVIDERNOTE.'+textboxeswithtext[i];if(document.zform.all(checkboxenames).length>1){checkboxes=document.zform.all(checkboxenames);var someresultchosen=false;for(j=0;j<checkboxes.length;j++){if(document.zform.all('DOCUMENTID.'+checkboxes[j].value).checked){someresultchosen=true;break;}}
if(!someresultchosen){alert('If adding a note, please check the lab result to receive the note');document.zform.all('PROVIDERNOTE.'+textboxeswithtext[i]).focus();return false;}}}
return true;}
function ConfirmSwitchClinicalEncounterLayout(){var appointmentdropdown=document.getElementsByName('APPOINTMENTTYPEID')[0];if(appointmentdropdown){var selectedoption=jQuery("[value="+appointmentdropdown.value+"]",appointmentdropdown).get(0);if(selectedoption&&selectedoption.getAttribute("SWAPLAYOUT")){if(selectedoption.getAttribute("SWAPLAYOUT")=='1'){var container=GetSectionContainer(appointmentdropdown);if(container){container.busy=new BusyIndicator();container.busy.Start(container);}
var response;CallRemote({SUB:"Clinical::Encounter::VerifyLayoutSwitch",ARGS:{OLDAPPTTYPEID:appointmentdropdown.getAttribute("oldvalue"),SPECIALTYID:appointmentdropdown.getAttribute("specialty"),NEWAPPTTYPEID:appointmentdropdown.value},ASYNC:false,ONFINISH:function(message){response=confirm(message);}});if(container){container.busy.Stop(container);}
if(!response){appointmentdropdown.value=appointmentdropdown.getAttribute("oldvalue");return 0;}
return 2;}
else if(selectedoption.getAttribute("SWAPLAYOUT")=='2'){return 2;}}}
return 1;}
function CancelStandingOrder(documentid){if(confirm("Are you sure you want to cancel this Standing Order?  By selecting this option, you acknowledge that all future occurrences of this order will also be cancelled.")){CallRemote({ARGS:{DOCUMENTID:documentid},SUB:"Document::Class::ORDER::CancelStandingOrder",ONFINISH:function(date){jQuery('#DISCONTINUEBLOCK').html('This order was discontinued on '+date);}});return 1;}
else{return false;}}
function AddPrescriptionAdminPickerMedication(item,frompicker){if(item.ID){var input=jQuery('#CLINICALORDERTYPEID').get(0);if(input.value.match(new RegExp('\\b'+item.ID+'\\b'))){return;}
input.value=input.value?input.value+'\t'+item.ID:item.ID;jQuery('#SELECTEDMEDICATIONDIV').css('display','block');var table=jQuery('#SELECTEDMEDICATIONLIST').get(0);var newrow=AddBlankRow({TABLE:table,SOURCEINDEX:0});newrow.style.display='';newrow.cells[0].innerText=item.INNERTEXT;jQuery('#deletelink',newrow.cells[1]).get(0).onclick=function(){RemovePrescriptionAdminPickerMedication(this,item.ID);};}}
function RemovePrescriptionAdminPickerMedication(deleteicon,id){if(ConfirmOperation("remove")){var input=jQuery('#CLINICALORDERTYPEID');var ordertypelist=input.val().split('\t');var index=jQuery.inArray(id,ordertypelist);if(index!=-1){ordertypelist.splice(index,1);}
input.val(ordertypelist.join('\t'));jQuery(deleteicon).parents("tr:first").css('display','none');}}
function QMEnrollmentToggleSpecialty(specialty){var configdiv=jQuery('#PRACTICESPECIALTYCONFIG').get(0);var specialtydiv=jQuery('#SPECIALTYSELECT').get(0);if(!configdiv||!specialtydiv)
return;if(specialty){configdiv.innerHTML='<a href=# onclick=\'QMEnrollmentToggleSpecialty(false);\'>Practice Configuration</a> | Specialty Configuration';specialtydiv.style.visibility='visible';}
else{var specialtyselect=jQuery('select[name=SPECIALTYID]',specialtydiv).get(0);if(specialtyselect&&specialtyselect.value){document.location='localqmenrollment.esp?SPECIALTYID=';}
else{configdiv.innerHTML='Practice Configuration | <a href=# onclick=\'QMEnrollmentToggleSpecialty(true);\'>Specialty Configuration</a>';specialtydiv.style.visibility='hidden';}}}
function ToggleQMOptionsMenu(menuid){var optionsmenu=jQuery("#"+EscapeJQuerySelector(menuid));var popup=jQuery(".qmoptionspopup",optionsmenu).get(0);var header=jQuery(".qmoptionsheader",optionsmenu).get(0);var expandcollapseimg=jQuery("[name=optionsexpandcollapseimg]",optionsmenu).get(0);var clickeventid="click."+EscapeJQuerySelector(menuid);if(jQuery(popup).is(":visible")){jQuery(popup).hide();jQuery(header).removeClass('qmoptionsexpanded');jQuery(expandcollapseimg).toggleClass('sprite-arrow-collapse sprite-arrow-expand');jQuery('body').unbind(clickeventid);jQuery(header).unbind(clickeventid);jQuery(popup).unbind(clickeventid);}
else{jQuery('.qmoptionspopup').each(function(){if(jQuery(this).is(":visible")){ToggleQMOptionsMenu(this.parentNode.parentNode.id);}});jQuery(popup).show();jQuery(header).addClass('qmoptionsexpanded');jQuery(expandcollapseimg).toggleClass('sprite-arrow-expand sprite-arrow-collapse');var bodyclickhandler=function(){CloseQMOptionsMenu(menuid);};jQuery('body').bind(clickeventid,bodyclickhandler);var e=window.event;if(e.stopPropagation)e.stopPropagation();var optionsclickhandler=function(evt){evt.stopPropagation();};jQuery(header).bind(clickeventid,optionsclickhandler);jQuery(popup).bind(clickeventid,optionsclickhandler);}}
function CloseQMOptionsMenu(menuid){var optionsmenu=jQuery("#"+EscapeJQuerySelector(menuid));var popup=jQuery(".qmoptionspopup",optionsmenu).get(0);if(jQuery(popup).is(":visible")){ToggleQMOptionsMenu(menuid);}}
function ToggleQMOptionsSection(parentid,sectionid){var parentobj=jQuery("#"+EscapeJQuerySelector(parentid)).get(0);if(!isDefined(parentobj)){return;}
