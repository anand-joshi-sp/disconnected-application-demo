AddInlineWarning([inlinetext]);}}
else{field.removeClass('RequiredField');field.removeAttr('requiredalert');}}}
function ConsentToTextConditionalRequirement(args){var conditionalrequiremobile=args.CONDITIONALREQUIREMOBILE;var conditionalrequireCTT=args.CONDITIONALREQUIRECTT;var mobilephone=jQuery('[name=MOBILEPHONE]');var consenttotextradio=jQuery('[name=CONSENTTOTEXTRADIO]');if(mobilephone.length&&consenttotextradio.length){var nomobilechecked=jQuery('[name=nomobile]').prop('checked');var mobileval=mobilephone.val();var cttradioval=consenttotextradio.filter(':checked').val();var mobilemissing='Mobile phone is required if consent to text is set to "Yes."';var consenttotextmissing='Please choose yes or no for consent to text.';var inlinetext={};inlinetext.inlinetype='warning';inlinetext.input=mobilephone;inlinetext.inlinemessagedivid='CTTconditionalmessage';RemoveInlineWarning([inlinetext]);_CTTConditionalHelper({FIELD:mobilephone,CONDITIONALREQUIREFIELD:conditionalrequiremobile,FIELDSVALUE:mobileval,SETREQUIRED:!nomobilechecked&&cttradioval==='Y',MESSAGE:mobilemissing,INLINETEXT:inlinetext});_CTTConditionalHelper({FIELD:consenttotextradio,CONDITIONALREQUIREFIELD:conditionalrequireCTT,FIELDSVALUE:cttradioval,SETREQUIRED:!nomobilechecked&&mobileval,MESSAGE:consenttotextmissing,INLINETEXT:inlinetext});}}
