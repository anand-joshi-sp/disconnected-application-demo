function LoadDeferredEncounterSections(args){AssertFields(args,['CLINICALENCOUNTERID'],['CLINICALENCOUNTERTABID','STAGE','DEPARTMENTID','SECTIONS','ONENCOUNTERSAVE','CLOSINGENCOUNTER','STREAMLINEDUSER','LOADALWAYSDEFERRED']);var allsections=GetAllSections(contentset);var allsummaries=GetEncounterContainer({CONTEXT:contentset,CONTAINERTYPE:'SUMMARYCONTAINER',RETURNARRAY:1});var loadalwaysdeferredflag=0;if(!args.LOADALWAYSDEFERRED&&!args.ONENCOUNTERSAVE){for(var i=0;i<allsections.length;i++){var sectionname=allsections[i].sectionobject.sectionname;if(sectionname==='P4PMeasureList'||sectionname==='P4PMeasureList_Summary'){loadalwaysdeferredflag=1;}}}
var digests;var registry=false;var registrysummary=false;if(isArray(args.SECTIONS)){digests={};for(var i=0;i<args.SECTIONS.length;i++){var sectionname=args.SECTIONS[i];if(sectionname==='Registry'){registry=true;}
else if(sectionname==='Registry_Summary'){registrysummary=true;}
digests[sectionname]=SectionDigest[sectionname];}
if(registrysummary&&!registry){args.SECTIONS.push('Registry');}}
CallRemote({SUB:'Clinical::Encounter::GetDeferredSections',ARGS:{CLINICALENCOUNTERID:args.CLINICALENCOUNTERID,CLINICALENCOUNTERTABID:args.CLINICALENCOUNTERTABID,STAGE:args.STAGE,DEPARTMENTID:args.DEPARTMENTID,SECTIONS:args.SECTIONS,DIGESTS:digests,ONENCOUNTERSAVE:args.ONENCOUNTERSAVE,CLOSINGWITHWORKER:args.CLOSINGENCOUNTER&&args.STREAMLINEDUSER,LOADALWAYSDEFERRED:args.LOADALWAYSDEFERRED},TIMEOUT:60,RETRIES:3,ONFINISH:function(updates){var callback=function(){encountersectionsready=1;FireEncounterSectionsReady();}
ShowSectionErrors(updates,allsections);var callbackargs={CLOSINGENCOUNTER:args.CLOSINGENCOUNTER,STREAMLINEDUSER:args.STREAMLINEDUSER}
ReplaceEncounterSections(updates,allsections,allsummaries,args.CLINICALENCOUNTERTABID,args.ONENCOUNTERSAVE,callback,callbackargs);if(loadalwaysdeferredflag&&!updates['LOADEDALWAYSDEFERRED']){args.LOADALWAYSDEFERRED=1;LoadDeferredEncounterSections(args);}}});}
function ShowSectionErrors(updates,allsections){if(updates&&updates['SECTIONS']){jQuery.each(allsections,function(index,section){if(updates['SECTIONS'][section.getAttribute('sectionname')]&&updates['SECTIONS'][section.getAttribute('sectionname')]['ERROR']){var error=updates['SECTIONS'][section.getAttribute('sectionname')]['ERROR'];alert(error);updates['SECTIONS'][section.getAttribute('sectionname')]['ERROR']='<div class=errormessage style="text-align:left">'+error+'</div>';}});}}
function DelayForSectionLoad(myfunction,myargs){Assert(isDefined(myfunction)&&isFunction(myfunction),"Missing argument myfunction in DelayForSectionLoad.");myargs=myargs||[];Assert(isArray(myargs));window.onencountersectionsready=window.onencountersectionsready||[];window.onencountersectionsready.push({FUNCTION:myfunction,ARGS:myargs});ShowLoadingIndicator();if(!isDefined(window.encountersectionsready)||window.encountersectionsready==1){FireEncounterSectionsReady();}}
function FireEncounterSectionsReady(){var functionhashes=window.onencountersectionsready||[];window.onencountersectionsready=[];var errorstack=[];while(functionhashes.length>0){var functionhash=functionhashes.shift();try{functionhash.FUNCTION.apply(document,functionhash.ARGS);}
catch(originalerror){var error=new Error([originalerror.message,'\nFrom DelayForSectionLoad:\n',functionhash.FUNCTION].join(''));error.errormessage=originalerror.errormessage;errorstack.push(error);}
ClearLoadingIndicator();}
if(errorstack.length>0){throw(errorstack[0]);}}
function IsContentEditableElementEmpty(divcontent){if(!divcontent||(divcontent=='<br>')||(divcontent==CursorPositioningHTML())){return true;}
else{return false;}}
function CopyToHiddenInput(displayedfield,hiddenfieldname){UpdateInnerHTML(displayedfield);var divtext=TrimWhitespace(displayedfield.innerHTML);var hiddeninput=jQuery(EscapeJQuerySelector("[name='"+hiddenfieldname+"']"));if(IsContentEditableElementEmpty(divtext)){hiddeninput.val('');}
else{divtext=divtext.replace(new RegExp(EscapeRegExp(CursorPositioningHTML()),"g"),"");hiddeninput.val(divtext);}}
function CursorPositioningHTML(){return'<br data-extra="1">';}
function PositionCursorInTemplates(editableelement,templatedata){RemoveCursorPositioningHTML(editableelement);ContenteditableDataCleanup(editableelement,templatedata);AppendCursorPositioningHTML({EDITABLEELEMENT:editableelement});}
function AppendCursorPositioningHTML(args){if(window.getSelection){var editableelement=args.EDITABLEELEMENT||document.getElementById(args.EDITABLEELEMENTID);var pattern=new RegExp(EscapeRegExp(CursorPositioningHTML())+"$");if(!editableelement.innerHTML.match(pattern)){jQuery(editableelement).append(CursorPositioningHTML());}}}
function RemoveCursorPositioningHTML(editableelement){var pattern=new RegExp(EscapeRegExp(CursorPositioningHTML()));if(editableelement.innerHTML.match(pattern)){jQuery(editableelement).find('br[data-extra=1]').remove();}}
function ContenteditableDataCleanup(editableelement,data){data=data.replace(/\n/g,'');if(!IsContentEditableElementEmpty(data)){editableelement.innerHTML+=data;}
else{editableelement.innerHTML=data;}}
function CheckFormTextTemplate(fieldname,hiddenfieldname,templatefieldname,savetab){var notecontent;notecontent=document.getElementById(fieldname);if(notecontent){UpdateInnerHTML(notecontent);var templatetext=TrimWhitespace(notecontent.innerHTML);notecontent.innerHTML=templatetext;hiddennotefield=document.getElementsByName(hiddenfieldname)[0];if(hiddennotefield){if(IsContentEditableElementEmpty(templatetext)){hiddennotefield.value='';}
else{templatetext=templatetext.replace(new RegExp(EscapeRegExp(CursorPositioningHTML()),"g"),"");hiddennotefield.value=templatetext;}}
var templatename;if(templatefieldname){templatename=document.getElementsByName(templatefieldname)[0];}
if(templatename){templatename.value=TrimWhitespace(templatename.value);if(templatename.value!=''){var templateinnertext=TrimWhitespace(notecontent.innerText);var providerentitytypeid=document.getElementById('PROVIDERENTITYTYPE');if(providerentitytypeid&&providerentitytypeid.value==2){alert("Warning: This template could not be created because you selected a non-provider for the encounter. A template must be tied to a provider.");templatename.ISSAVING=0;return false;}
else if(templatename.ISDUPLICATE==-1){if(savetab){window.setTimeout(savetab,500);templatename.ISSAVING=1;}
return false;}
else if(templatetext==''||templateinnertext==''){alert("Warning: cannot save empty template.");templatename.ISSAVING=0;return false;}
else if(templatename.ISDUPLICATE==1){templatename.focus();alert("Warning: template name is already in use.");templatename.ISSAVING=0;return false;}}}}
return 1;}
function ChangeTemplateDropdown(obj,viewpaneid,prefix,additive){HideAllTemplateDropdowns(obj,prefix);if(!additive){ClearTemplateViewPane(viewpaneid);}
if(obj.value){var templatedropdown=jQuery(EscapeJQuerySelector('[name*="'+prefix+'{DROPDOWN}{'+obj.value+'}"]'));var templatebutton=jQuery(EscapeJQuerySelector('[name*="'+prefix+'{BUTTON}{'+obj.value+'}"]'));if(!templatedropdown.size()){templatedropdown=jQuery(EscapeJQuerySelector('[name*="'+prefix+'{DROPDOWN}{'+obj.value.toUpperCase()+'}"]'));templatebutton=jQuery(EscapeJQuerySelector('[name*="'+prefix+'{BUTTON}{'+obj.value.toUpperCase()+'}"]'));}
templatedropdown.show();templatebutton.show();}}
function HideAllTemplateDropdowns(obj,prefix){jQuery(EscapeJQuerySelector('[name*="'+prefix+'{DROPDOWN}"]')).hide();jQuery(EscapeJQuerySelector('[name*="'+prefix+'{BUTTON}"]')).hide();}
