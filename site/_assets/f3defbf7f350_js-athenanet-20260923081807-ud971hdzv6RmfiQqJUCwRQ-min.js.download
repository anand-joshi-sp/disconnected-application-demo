nextrow=nextrow.next('tr');}
thisjq.css('display',display);if(headerrows.length>1){thisjq.prev().css('display',display);}});var rows=jQuery('.lettertablerow:visible:has(input)',sourcetable);rows.each(function(){var border='none';var thisjq=jQuery(this);if(!thisjq.prevAll(':visible:first').hasClass('headerrow')&&!thisjq.find('#addresseetype').text().match(/^Cc/)){border='1px solid #ddd';}
thisjq.children('td').andSelf().css('border-top',border);});rows.each(function(){var thisjq=jQuery(this);var border=thisjq.css('border-top');if(border&&border.match(/ddd/)){thisjq.prev().children('td').andSelf().css('padding-bottom','7px');thisjq.next().children('td').andSelf().css('padding-top','7px');}});}
function AddLetter(recipient,sourceobject){var sectioncontainer=GetSectionContainer(sourceobject);var lettertable=jQuery(sectioncontainer).find('#LETTERTABLE').get(0);lettertable.style.display='';var sourceindex=GetBlankLetterRowIndex(lettertable);var newrow=AddBlankRow({TABLE:lettertable,SOURCEINDEX:sourceindex});jQuery(newrow).addClass('lettertablerow');var newletterid=jQuery('input[name*=NEWLETTERID]',lettertable);jQuery('[name*="{NEW}"]',newrow).each(function(index){if(this.name&&this.name.match(/([A-Z0-9][A-Z0-9_\{\}]*)\{\d*\}\{\d*\}{(.*)}/)){if(RegExp.$2=='DOCUMENTCLASS'){this.value='LETTER';}
this.name=RegExp.$1+'{'+newletterid.val()+'}{0}{'+RegExp.$2+'}';}});newletterid.val(parseInt(newletterid.val())+1);jQuery('[name$="{GENERATELETTER}"]',newrow).prop('checked',true);ChangeLetterRecipient(recipient,newrow);UpdateLetterAssignment(newrow);}
function UpdateLetterAssignment(sourceobject){var row=jQuery(sourceobject).closest('tr');var recipientclass=jQuery('[name$="{RECIPIENTCLASS}"]',row).val();var clinicalpaperformid=jQuery('[name$="{CLINICALPAPERFORMID}"]',row).val();var documentsubclass=FindLetterDocumentSubclass(clinicalpaperformid,recipientclass);var assignedto=window.lettersdefaultassignedtobysubclass[documentsubclass];jQuery('[name$="{ASSIGNEDTO}"]',row).val(assignedto);}
function UpdateLetterDeliveryMethod(sourceobject){var letterobjectname=sourceobject.name;var clinicalpaperformid=sourceobject.value;var recipientclassobjectname=letterobjectname.replace(/CLINICALPAPERFORMID/,'RECIPIENTCLASS');var recipientclass=jQuery('[name="'+recipientclassobjectname+'"]').val();if(recipientclass=='Patient'){var documentsubclass=FindLetterDocumentSubclass(clinicalpaperformid,recipientclass);var actionreasontodeactivate=window.lettersdeactivatedactionreasonbysubclass[documentsubclass];var approvalactionreasonname=letterobjectname.replace(/CLINICALPAPERFORMID/,'APPROVALDOCUMENTACTIONREASONID');var actionreasonoptions=jQuery('[name="'+approvalactionreasonname+'"] option');actionreasonoptions.each(function(){if(jQuery(this).val()==actionreasontodeactivate){jQuery(this).prop('disabled',true);}
else{jQuery(this).prop('disabled',false);}});var defaultactionreasonid=window.lettersdefaultactionreasonbysubclass[documentsubclass];var actionreasonoptionsselect=jQuery('[name="'+approvalactionreasonname+'"]');actionreasonoptionsselect.val(defaultactionreasonid);}}
function FindLetterDocumentSubclass(clinicalpaperformid,recipientclass){var documentsubclass='';if(recipientclass==='Patient'){if(window.letterspatientcaresummaries[clinicalpaperformid]){documentsubclass='LETTER_PATIENTCARESUMMARY';}
else{documentsubclass='LETTER_PATIENTCORRESPONDENCE';}}
else if(window.lettercategories[clinicalpaperformid]==='EPISODE'){documentsubclass='LETTER_EPISODE';}
return documentsubclass;}
