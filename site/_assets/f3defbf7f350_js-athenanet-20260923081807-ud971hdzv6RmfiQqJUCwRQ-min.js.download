.map(function(){return this.value;})
.get();if(documentids.length){CallRemote({SUB:'BusCall::Order::HaveOrdersBeenPrinted',ARGS:{DOCUMENTIDS:documentids},ONFINISH:function(printstatuses){Object.keys(printstatuses).forEach(function(documentID){var $printedcell=$table
