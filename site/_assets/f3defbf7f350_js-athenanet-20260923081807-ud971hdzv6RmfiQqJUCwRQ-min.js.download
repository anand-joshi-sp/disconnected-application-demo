else{var needsverification=jQuery("#SNOMEDDIAGNOSISNEEDSVERIFICATION");var snomedsearch=jQuery("[name='DOCUMENTSNOMEDDIAGNOSIS_search']");if(!snomedsearch.length){return;}
var plaintextfield=jQuery("#DOCUMENTSNOMEDDIAGNOSIS");var snomedlabel=snomedsearch.length?snomedsearch.attr('namevalue'):plaintextfield.attr('displayvalue');var snomedcode=plaintextfield.val();var icd9=jQuery("[name='DOCUMENTDIAGNOSISCODE']").val();var icd10=jQuery("#DOCUMENTDIAGNOSISCODEICD10").val();var needsicd10=jQuery("#DOCUMENTDIAGNOSISNEEDSICD10").length;var futureicd10=jQuery('#FUTUREICD10S').val();var showingfutureicd10=jQuery('#SHOWFUTUREICD10S').val();var requirefutureicd10=jQuery('#REQUIREICD10FORFUTUREORDERS').val();if(!snomedcode){alert("Please add a diagnosis.");return false;}
else if((needsicd10&&(!icd10||!icd10.length||icd10==-1))||(requirefutureicd10=='REQUIRED'&&showingfutureicd10==1&&(!futureicd10||!futureicd10.length||futureicd10==-1))){alert("ICD-10 code required.");return false;}
else if(!needsicd10&&(!icd9||icd9=='undefined')){alert("ICD-9 code required.");return false;}
else if(needsverification.val()==1){var message="The diagnosis associated with this order was converted to the following SNOMED terminology: "+snomedlabel+"<br><br>";message+="Click <strong>OK</strong> to confirm the SNOMED diagnosis, or <strong>Cancel</strong> to select a new diagnosis.";if(confirmYN(message,'OK','Cancel')){needsverification.val(0);}
else{return false;}}
return true;}}
function RegistrySectionsForDiagnosis(args){AssertFields(args,[],['CODESYSTEM','ONFINISH','LOADALLFORCHART','DIAGNOSISCODES']);if(args.DIAGNOSISCODES){AssertRequiredFields(args,['CODESYSTEM']);}
if(typeof encounterid==='undefined'){return undefined;}
var registrysection=GetRegistrySection();var sectionexists=registrysection?1:0;var registrysummary=GetRegistrySummarySection();var summaryexists=registrysummary?1:0;var diagnosiscodes;if(sectionexists){var sectionobject=registrysection.prop('sectionobject');if(!sectionobject){InitializeSection(registrysection.get(0),false);sectionobject=registrysection.prop('sectionobject');}
diagnosiscodes=sectionobject.WhichDiagnosesAreRelevant(args.DIAGNOSISCODES);}
else if(args.DIAGNOSISCODES){diagnosiscodes=args.DIAGNOSISCODES;}
if(args.LOADALLFORCHART||diagnosiscodes.length){var chartid=GetChartID();var subsections=sectionexists?AllRegistrySubsections():[];var onfinish=args.ONFINISH;var ajaxargs={CHARTID:chartid,CLINICALENCOUNTERID:encounterid,EXISTINGSUBSECTIONS:subsections,SECTIONEXISTS:sectionexists,SUMMARYEXISTS:summaryexists};if(args.LOADALLFORCHART){ajaxargs.LOADALLFORCHART=true;}
if(diagnosiscodes.length){ajaxargs.DIAGNOSISCODES=diagnosiscodes;ajaxargs.CODESYSTEM=args.CODESYSTEM;}
return CallRemote({SUB:'Clinical::Encounter::Section::Registry::RemoteLoad',ARGS:ajaxargs,ONFINISH:function(result){var registrysection=GetRegistrySection();var sectionobject;if(registrysection){sectionobject=registrysection.prop('sectionobject');if(!sectionobject){InitializeSection(registrysection.get(0),false);sectionobject=registrysection.prop('sectionobject');}}
else{sectionobject={};}
var currentsubsections=AllRegistrySubsections();var oktoaddhtml=true;var retryajaxcall=false;if((currentsubsections.length!=subsections.length)||(currentsubsections.sort().toString()!=subsections.sort().toString())){(function(){if(!(subsections.length&&currentsubsections.length)){retryajaxcall=true;oktoaddhtml=false;return;}
var subsectionsobject=sectionobject.registries;var i;for(i=0;i<result.EXISTINGREGISTRIES.length;++i){var subsection=result.EXISTINGREGISTRIES[i];if(!subsectionsobject[subsection.REGISTRY]){oktoaddhtml=false;retryajaxcall=true;return;}}
var newsubsectioncount=result.NEWREGISTRIES.length;for(i=0;i<result.NEWREGISTRIES.length;++i){var subsection=result.NEWREGISTRIES[i];if(subsectionsobject[subsection.REGISTRY]){oktoaddhtml=false;result.EXISTINGREGISTRIES.push(subsection);--newsubsectioncount;}}
if(newsubsectioncount){retryajaxcall=true;return;}})();if(retryajaxcall){RegistrySectionsForDiagnosis(args);return;}}
var apsection=GetDiagnosisSection();var jqapsection=jQuery(apsection);if(oktoaddhtml){if(result.HTML){if(registrysection){registrysection.append(result.HTML);PositionRegistrySection({APSECTION:jqapsection,REGISTRYSECTION:registrysection});}
else{jqapsection.after(result.HTML);registrysection=GetRegistrySection();InitializeSection(registrysection.get(0),false);}}
if(result.SUMMARY){var registrysummary=GetRegistrySummarySection();if(registrysummary){registrysummary.find('.clinicalsummarybox').append(result.SUMMARY);}}}
else{PositionRegistrySection({APSECTION:jqapsection,REGISTRYSECTION:registrysection});}
for(var i=0;i<result.EXISTINGREGISTRIES.length;++i){var subsection=result.EXISTINGREGISTRIES[i];var registry=subsection.REGISTRY;for(var j=0;j<subsection.DIAGNOSES.length;++j){var diagnosis=subsection.DIAGNOSES[j];sectionobject.AddDiagnosis({CODE:diagnosis.CODE,DESCRIPTION:diagnosis.DESCRIPTION,REGISTRY:registry});}}
if(result.SHOW){registrysection.removeClass('invisible');var registrysummary=GetRegistrySummarySection();if(registrysummary){registrysummary.removeClass('invisible');}
AddRegistryToJumpTo();}
if(onfinish){onfinish();}}});}
ReinitializeSpeechEnabledFields();}
function PositionRegistrySection(args){if(!args){args={};}
var jqregistrysection=args.REGISTRYSECTION||GetRegistrySection();if(!jqregistrysection){return false;}
var jqapsection=args.APSECTION;if(!jqapsection){var apsection=GetDiagnosisSection();jqapsection=jQuery(apsection);}
var jqregistrysummary=GetRegistrySummarySection();jqapsection.after(jqregistrysection);if(!jqregistrysummary){return true;}
jqregistrysection.after(jqregistrysummary);if(jqregistrysection.is(':visible')){jqregistrysummary.hide();}
return true;}
function GetRegistrySummarySection(){var beacon=document.getElementById('registrysummarybeacon');if(!beacon){return undefined;}
var container=GetSummaryContainer(beacon);if(!container){return undefined;}
var jqcontainer=jQuery(container);return jqcontainer;}
function AllRegistrySubsections(){var registrysection=GetRegistrySection();if(!registrysection){return[];}
var jqsubsections=registrysection.children('div.REGISTRYDATA_REGISTRY');var subsectionnames=new Array();jqsubsections.each(function(index,subsection){var id=jQuery(subsection).attr('id');if(id.match(/REGISTRYDATA_(.*)/)){subsectionnames.push(RegExp.$1);}
return true;});return subsectionnames;}
function GetRegistrySection(){var beaconspan=document.getElementById('registrydatasectionishere');if(!beaconspan){return undefined;}
var container=GetSectionContainer(beaconspan);return container?jQuery(container):undefined;}
function ChangeYNDatePair(select){var jqselect=jQuery(select);var container=jqselect.closest('.yesnodatecontainer');var datecontainer=container.find('span.datecontainer');var datefield=datecontainer.find('input[inputclass="DATE"]');if(!datefield.get(0)){return false;}
if(jqselect.val()=='Y'){datecontainer.removeClass('hidden');datefield.val(datefield.data('value')||TodayToString());}
else{datecontainer.addClass('hidden');var value=datefield.val();if(value){datefield.data('value',value).val('');}}}
function RegistrySection(div,sectionname){var jqdiv=jQuery(div);var existingsectionobject=jqdiv.prop('sectionobject');var infobutton=jQuery(div).find('div.athenawidget[PERLPACKAGE="HTML::AthenaWidget::DialogDiv"]');infobutton.each(function(index,widget){AthenaWidget_DialogDiv.AttachNamespace(widget,AthenaWidget_DialogDiv);});var registries={};jqdiv.children('div.REGISTRYDATA_REGISTRY').each(function(index,element){var registryname=jQuery(element).attr('REGISTRY');registries[registryname]=jQuery(element);});this.registries=registries;}
RegistrySection.prototype=new EncounterSection();RegistrySection.prototype.AddDiagnosis=function(args){AssertRequiredFields(args,['CODE','DESCRIPTION','REGISTRY']);var diagnosiscode=args.CODE;var diagnosis=args.CODE+': '+args.DESCRIPTION;var registry=args.REGISTRY;var id='registry_'+registry+'_diagnoses';var diagnosistd=jQuery('#'+id)
.children('td')
var diagnosisspan=this.FindDiagnosisInSubsection(registry,diagnosiscode);if(!diagnosisspan){if(diagnosistd.children().length){diagnosistd.append('<span class="diagnosisseparator">; </span>');}
var prettydiagnosis=diagnosis.toLowerCase().replace(/(^|\s)([a-z])/g,function(match,space,letter){return space+letter.toUpperCase();});var strippeddiagnosiscode=diagnosiscode.replace(/\W/g,'');diagnosistd.append('<span id="'
+'registry_'+registry+'_diagnosis_'+strippeddiagnosiscode
+'" class="registry_diagnosis" diagnosiscode="'+strippeddiagnosiscode+'">'
+prettydiagnosis
+'</span>');var addedspan=diagnosistd.children('span.registry_diagnosis:last-child');return addedspan;}
else{return diagnosisspan;}};RegistrySection.prototype.RemoveDiagnosis=function(diagnosiscode){var registries=AllRegistrySubsections();for(var i=0;i<registries.length;++i){var diagnosisspan=this.FindDiagnosisInSubsection(registries[i],diagnosiscode);if(diagnosisspan&&!diagnosisspan.attr('data-preexisting')){var container=diagnosisspan.closest('.registry_diagnosis_container');var separator=diagnosisspan.next('.diagnosisseparator');if(!separator.length){separator=diagnosisspan.prev('.diagnosisseparator');}
diagnosisspan.remove();separator.remove();var remainingdiagnoses=container.find('.registry_diagnosis');if(!remainingdiagnoses.length){var subsection=container.closest('div.REGISTRYDATA_REGISTRY');var subsectionid=subsection.attr('id');var section=subsection.parent();if(!(this.SubsectionHasData(subsection))){subsection.remove();var summarysubsection=jQuery(subsectionid.replace(/^REGISTRYDATA/,'#REGISTRYDATA_SUMMARY'));var summary=summarysubsection.closest('.clinicalsummary');summarysubsection.remove();MaybeShowOrHideRegistrySection({SECTION:section,SUMMARY:summary,NOSUMMARY:!summary,HIDEONLY:true});}}}}};RegistrySection.prototype.FindDiagnosisInSubsection=function(subsection,diagnosiscode){var strippeddiagnosiscode=diagnosiscode.replace(/\W/g,'');var selector='#registry_'+subsection+'_diagnosis_'+strippeddiagnosiscode;var span=jQuery(selector);if(span.length){return span;}
else{return undefined;}};RegistrySection.prototype.SubsectionHasData=function(jqsection){var hasdata=false;jqsection.find('.registryinput').each(function(index,element){if((element.value!=="")&&(element.value!==jQuery(element).data('nullvalue'))){hasdata=true;return false;}
return true;});return hasdata;};RegistrySection.prototype.SectionValidation=function(){var self=this;if(self.registries.AGAIBD){var jqcolonoscopyinterval=jQuery('#AGAIBD_COLONOSCOPYINTERVAL');var colonoscopyintervalunit=jqcolonoscopyinterval
.closest('td')
.find('input:radio[name=AGAIBD_COLONOSCOPYINTERVAL_UNIT]:checked')
.val();var colonoscopymonths=parseInt(jqcolonoscopyinterval.val());if(colonoscopyintervalunit!='M'){colonoscopymonths*=12;}
if(colonoscopymonths>1440){alert('Invalid colonoscopy interval');jqcolonoscopyinterval.focus();return false;}}
return true;}
RegistrySection.prototype.AllDiagnoses=function(){var jqdiagnoses=jQuery('.registry_diagnosis');var alldiagnosiscodes={};var diagnosiscodes=[];jqdiagnoses.each(function(index,element){var jqelement=jQuery(element);if(!jqelement.data('preexisting')){var code=jqelement.attr('diagnosiscode');if(!alldiagnosiscodes[code]){diagnosiscodes.push(code);alldiagnosiscodes[code]=true;}}});return diagnosiscodes;}
RegistrySection.prototype.SetContents=function(div,newcontent,clearspinneronly){var self=this;EncounterSection.prototype.SetContents.call(self,div,newcontent,clearspinneronly);var jqsection=jQuery(div);MaybeShowOrHideRegistrySection({SECTION:jqsection});}
RegistrySection.prototype.WhichDiagnosesAreRelevant=function(codestocheck){var self=this;if(!self.relevantdiagnoses){var beacon=jQuery("#registrydatasectionishere");if(beacon.length){var diagnosisstring=beacon.data("relevantcodes");var diagnosisarray=diagnosisstring?diagnosisstring.split(','):[];self.relevantdiagnoses={};for(var i=0;i<diagnosisarray.length;++i){self.relevantdiagnoses[diagnosisarray[i]]=true;}}
else{return codestocheck;}}
var relevantcodes=[];for(var i=0;i<codestocheck.length;++i){var code=codestocheck[i];if(self.relevantdiagnoses[code]){relevantcodes.push(code);}}
return relevantcodes;}
function MaybeShowOrHideRegistrySection(args){AssertValidFields(args,['SECTION','SUMMARY','NOSUMMARY','SHOWONLY','HIDEONLY']);Assert(!(args.SUMMARY&&args.NOSUMMARY),'Parameters SUMMARY and NOSUMMARY cannot both be true.');Assert(!(args.SHOWONLY&&args.HIDEONLY),'Parameters SHOWONLY and HIDEONLY cannot both be true.');var section=args.SECTION||GetRegistrySection();var summary;if(!args.NOSUMMARY){summary=args.SUMMARY||GetRegistrySummarySection();}
if(!section){return false;}
var remainingsubsections=section.children('div.REGISTRYDATA_REGISTRY');var visibilitychanged=false;if(remainingsubsections.length){if(args.HIDEONLY){return!section.hasClass('invisible');}
if(section.hasClass('invisible')){visibilitychanged=true;section.removeClass('invisible');}
if(summary&&summary.hasClass('invisible')){visibilitychanged=true;summary.removeClass('invisible');}
AddRegistryToJumpTo();}
else{if(args.SHOWONLY){return!section.hasClass('invisible');}
if(!section.hasClass('invisible')){visibilitychanged=true;section.addClass('invisible');}
if(summary&&!summary.hasClass('invisible')){visibilitychanged=true;summary.addClass('invisible');}
if(visibilitychanged){jumptooptions=jQuery('#jumptonav option');for(var i=jumptooptions.length-1;i>=0;--i){var currentoption=jumptooptions.eq(i);if(currentoption.val().match(/\d+_Registry(_Summary)?/)){currentoption.remove();break;}}}
return false;}}
function ValidateRegistrySection(saveargs){var jqregistry=GetRegistrySection();if(!jqregistry){return true;}
if(!jqregistry.is(':visible')){var jqregistrysummary=GetRegistrySummarySection();if(!jqregistrysummary||!jqregistrysummary.is(':visible')){return true;}}
var registryfields=jqregistry.find(".registryinput");var firstmissingfield;registryfields.each(function(index,field){var id=field.getAttribute('id');if(field.value){return true;}
else if(jQuery("#"+id+"_container.hidden").length){return true;}
else{firstmissingfield=field;return false;}});if(firstmissingfield){var subsection=jQuery(firstmissingfield).closest('.REGISTRYDATA_REGISTRY');var subsectiontitle=subsection.attr('data-subsectiontitle');var message="<p class='mualerttext'>To satisfy Quality Management programs, complete the <strong>"
+subsectiontitle
+"</strong> in the <strong>Registry Data</strong> section.</p>"
+"<p class='mualerttext'>Continue without updating <strong>"
+subsectiontitle
+"</strong>?</p>";var mualertwidget=jQuery('#mualertregistrywidget');var widgetargs=saveargs.WIDGETARGS;widgetargs.SECTIONCONTAINER=jqregistry.get(0);widgetargs.FIELD=firstmissingfield;widgetargs.MESSAGE=message;MeaningfulUse_MUAlert.GetWidgetContainer(mualertwidget).OpenDialog(widgetargs);return false;}
return true;}
function AddRegistryToJumpTo(){var jumptooptions=jQuery('#jumptonav option');var registrysection=GetRegistrySection();if(!registrysection){return;}
for(var i=jumptooptions.length-1;i>=0;--i){var currentoption=jumptooptions.eq(i);var value=currentoption.val();if(value.match(/^(\d+_)(AssessmentPlan|DiagnosisOrders)$/)){var optionhtml='<option value="'
+RegExp.$1
+'Registry'
+(registrysection.hasClass('hidden')?'_Summary':'')
+'">'
+(currentoption.html().match(/^(.+: )/)?RegExp.$1:'')
+'Registry Data</option>';currentoption.after(optionhtml);break;}
if(value.match(/^(\d+_)Registry/)){break;}}}
function LogPrint(documentidlist){CallRemote({SUB:'Document::LogPrint',ARGS:{DOCUMENTIDLIST:documentidlist}});return;}
function PrintIfCanMarkSubmitted(documentidlist,formobj,upfpdfpreview){var canmarksubmittedselector=document.getElementById('CANMARKSUBMITTED');if(canmarksubmittedselector){var canmarksubmitted=parseInt(canmarksubmittedselector.value);if(canmarksubmitted===0){var alertmessage=jQuery(canmarksubmittedselector).attr("alertmessage");alert(alertmessage?alertmessage:"An error occurred. The documents could not be submitted. Please review the documents and try again.");return false;}}
if(jQuery('meta[name="PrintingFrameworkEnabled"]').attr('content')){var printpageargs={BEFOREPRINT:function(){LogPrint(documentidlist);return true;},OLDPRINT:function(){window.print();formobj.submit();},AFTERPRINT:function(){formobj.submit();}};if(upfpdfpreview){printpageargs.IGNOREHIDEPDF=1;}
AthenaPattern_Print.print_page(printpageargs);}
else{window.print();formobj.submit();}
return;}
