else{$printedcell.html("No");$checkbox.prop('checked',true);}
ProcessPaperFormWidgetCheckboxes($checkbox.get(0));});}});}
return;};if(onprintcallback){var originalonprintcallback=args.ONPRINTCALLBACK;onprintcallback=function(){updateprintstatusdisplay();originalonprintcallback.call(this);return;};}
else{onprintcallback=updateprintstatusdisplay;}}
