else{$showmappedcheckbox.prop('checked',false);ShowMappedDiagnosesRow(false);}}
function CheckFormHCFANew(){var isdevserver=jQuery('#isdevserver').val();if(!submitting){return true;}
if(document.zform.PATIENTDEPARTMENTID.value==""){alert("You must enter a patient department.");return false;}
if(document.zform.DEPARTMENTID.value==""){alert("You must enter a service department.");return false;}
if(isdevserver!=='Y'&&(document.zform.SERVICEDATE&&IsDate(document.zform.SERVICEDATE.value)&&(IsDateAfter(document.zform.SERVICEDATE.value,document.zform.POSTDATE.value)))){alert("The Post Date cannot be before the date of service ("+document.zform.SERVICEDATE.value+")");try{document.zform.SERVICEDATE.focus();}catch(e){};return false;}
if(document.zform.PROVIDERID&&!document.zform.PROVIDERID.value){alert("Please enter a provider.");eval("document.zform.PROVIDERID.focus()")
return false;}
if(document.zform.SUPERVISINGPROVIDERID&&!document.zform.SUPERVISINGPROVIDERID.value){alert("Please enter a supervising provider.");eval("document.zform.SUPERVISINGPROVIDERID.focus()")
return false;}
if(document.zform.SERVICEDATE&&!(document.zform.SERVICEDATE.value!==''&&IsDate(document.zform.SERVICEDATE.value))){alert("Please enter a valid date of service.");eval("document.zform.SERVICEDATE.focus()")
return false;}
todaysdate=new Date();if(isdevserver!=='Y'&&(document.zform.SERVICEDATE&&!(IsDate(document.zform.SERVICEDATE.value)&&IsDateAfter(todaysdate,document.zform.SERVICEDATE.value)))){alert("The date of service cannot be a future date.");try{document.zform.SERVICEDATE.focus();}catch(e){};return false;}
if(document.zform.SERVICEDATE&&document.zform.SERVICETODATE&&document.zform.SERVICETODATE.value!==''&&IsDateAfter(document.zform.SERVICEDATE.value,document.zform.SERVICETODATE.value)){alert("To Date must be on or after From Date.");try{document.zform.SERVICEDATE.focus();}catch(e){};return false;}
var chargelength=(document.zform.FROMDATE===undefined)?0:document.zform.FROMDATE.length;for(var i=0;i<chargelength;i++){if(document.zform.FROMDATE[i]&&document.zform.TODATE[i]&&IsDateAfter(document.zform.FROMDATE[i].value,document.zform.TODATE[i].value)){alert("To Date must be on or after From Date.");try{document.zform.FROMDATE[i].focus();}catch(e){};return false;}}
if(document.zform.SERVICEDATE&&document.zform.EARLIESTDATEOFSERVICE&&document.zform.EARLIESTDATEOFSERVICE.value!==''&&Date.parse(document.zform.SERVICEDATE.value)<Date.parse(document.zform.EARLIESTDATEOFSERVICE.value)){alert("The date of service you entered is earlier than the earliest date of service on file ("
+document.zform.EARLIESTDATEOFSERVICE.value
+"). Please contact your Account Manager if you need to have the date on file updated.");try{document.zform.SERVICEDATE.focus();}catch(e){};return false;}
if(!CheckReferralForm()){return false;}
if(!CheckRequiredFields()){return false;}
var invalidinput=jQuery('.chargeline input.InvalidInput').not('[name=NDC_Setter]').first();if(invalidinput.length){invalidinput.focus();alert("You may not enter any invalid procedures or diagnoses.");return false;}
var re=new RegExp("(.*)\\.(.*)$","i");procedurecoderows=0;for(i=0;i<document.zform.PROCEDURECODE0.length;i++){proceduresblank=true;for(j=0;eval("document.zform.PROCEDURECODE"+j);j++){var procedurearray=eval("document.zform.PROCEDURECODE"+j);proceduredata=procedurearray[i];if(proceduredata.value!==''){if(proceduredata.value.match(re)){if(RegExp.$2==''||isNaN(RegExp.$2)||(RegExp.$2<=0)){alert('The number of units specified is invalid');try{proceduredata.focus();}catch(e){};return false;}
else if(RegExp.$2>99){if(!confirm('You have entered a large number ('+RegExp.$2+') of units of procedure '+RegExp.$1+'.  Click OK if it is correct or Cancel to change the units.')){try{proceduredata.focus();}catch(e){};return false;}}}
proceduresblank=false;procedurecoderows++;}}
if(!proceduresblank&&document.zform.DIAGNOSIS0[i].value==''){alert('A primary diagnosis is required for each line containing procedurecodes.');return false;}}
var otherdiags=document.getElementsByName("OTHERCLAIMDIAGNOSES");if(otherdiags.length>0){var alldiags=[];for(i=0;i<document.zform.PROCEDURECODE0.length;i++){for(j=0;j<4;j++){var diag=document.getElementsByName('DIAGNOSIS'+j)[i];if(diag.value!=''){alldiags.push(diag.value);}}}
var otherdiagvalues=[];for(i=0;i<otherdiags.length;i++){var otherdiag=otherdiags[i].value;if(otherdiag!=''&&otherdiagvalues.indexOf(otherdiag)>-1){otherdiags[i].focus();alert("This is a duplicate diagnosis code");return false;}
else if(otherdiag!=''){otherdiagvalues.push(otherdiag);}
if(otherdiag!=''&&alldiags.indexOf(otherdiag)>-1){otherdiags[i].focus();alert("This diagnosis code is already included in one of the charges");return false;}}}
if(procedurecoderows==0){alert('You must enter at least one procedure.');return false;}
if(isdevserver!=='Y'&&(!CheckPostDate(document.zform.POSTDATE))){return false;}
if(!CheckChargeFromDate()){return false;}
if(document.zform.SERVICEDATE&&!(IsDate(document.zform.SERVICEDATE.value))){alert("Please enter a valid Date of Service.");try{document.zform.SERVICEDATE.focus();}catch(e){};return false;}
if(document.zform.DAYS&&document.zform.DAYS.length){var daysvalue;for(i=0;i<document.zform.DAYS.length;i++){daysvalue=TrimWhitespace(document.zform.DAYS[i].value);if(daysvalue!==''&&!daysvalue.match(/^\-?\d+$/g)){alert("Units must be a whole number.");return false;}
if(daysvalue!=''&&daysvalue<=0){alert("Units must be a number greater than zero (or blank).");return false;}
if(document.zform.DAYS[i].value>99){if(!confirm('You have entered a large number ('+document.zform.DAYS[i].value+') of units of procedure '+document.zform.PROCEDURECODE0[i].value+'.  Click OK if it is correct or Cancel to change the units.')){try{document.zform.DAYS[i].focus();}catch(e){};return false;}}
document.zform.DAYS[i].value=daysvalue;}}
if(this.UNKNOWN_PROCEDUREFLAG==1){alert("You may not enter any UNKNOWN procedures or diagnoses.");return false;}
if(document.zform.POSTDATE.value==''){alert('Post Date cannot be blank.');document.zform.POSTDATE.focus();return false;}
var $ndcerrormessages=jQuery('div.ndcerrormessage:visible');var incorrectndc=false;var missingdrugdosage=false;var confirmed=true;$ndcerrormessages.each(function(){var $ndcerrormessage=jQuery(this);var confirmationmessage;if($ndcerrormessage.is('.ndcincorrectformat')){if(!incorrectndc){confirmationmessage='Incorrect NDC number formatting will cause this claim to go into hold. Are you sure you want to continue?';incorrectndc=true;}}
else{if(!missingdrugdosage){confirmationmessage='Missing drug information will cause this claim to go into hold. Are you sure you want to continue?';missingdrugdosage=true;}}
if(confirmationmessage){confirmed=confirm(confirmationmessage);}
return!(incorrectndc&&missingdrugdosage);});if((incorrectndc||missingdrugdosage)&&!confirmed){return false;}
if(document.zform.NDC&&document.zform.NDC.length){for(i=0;i<document.zform.NDC.length;i++){if(document.zform.NDC[i].value!==''){if(document.zform.NDC[i].value.length!==11){if(document.zform.NDC[i].value.length>11){alert('The NDC number must be 11 digits.');jQuery(document.zform.NDC[i]).focus();return false;}
if(!incorrectndc){if(confirm('Incorrect NDC number formatting will cause this claim to go into hold. Are you sure you want to continue?')){incorrectndc=true;}
else{return false;}}}
if(!missingdrugdosage){var $parentdiv=jQuery(document.zform.NDC[i]).closest('div.customform');var $drugdosage=$parentdiv.find('[name$=DRUGDOSAGE]');var $drugunitqualifier=$parentdiv.find('[name$=DRUGUNITQUALIFIER]')
if(!$drugdosage.length||!$drugdosage.val()||!$drugunitqualifier.length||!$drugunitqualifier.find('option:selected').val()){if(confirm('Missing drug dosage information will cause this claim to go into hold. Are you sure you want to continue?')){missingdrugdosage=true;}
else{return false;}}}}}}
return!ClaimUtils.DeferSubmit();}
function InitializeChargeInputsBasedOnServiceDate(pagename){var servicedateinput=jQuery('input[name=SERVICEDATE]');if(servicedateinput.val().match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/)){var icdversion=ClaimUtils.UpdateICDVersionBasedOnServiceDate(servicedateinput.val());InitializeChargeInputs(icdversion,pagename);}}
var alarmstriggered=false;var chargeinputsinitialized=false;function EnableOrDisableCharges(args){var $servicedate=jQuery('#SERVICEDATE');var currentservicedate=$servicedate.val();var servicedatelastattr=$servicedate.attr('pickerlastvalue');var lastservicedate=typeof servicedatelastattr!=='undefined'?servicedatelastattr:$servicedate.data('lastvalue');var hasvaliddate=IsDate(currentservicedate)&&currentservicedate!=='';var ispayermodified=jQuery('[name="PRIMARYPATIENTINSURANCEID"]').val()!==jQuery('[name="PRIMARYPATIENTINSURANCEINFO"]').val()||jQuery('[name="SECONDARYPATIENTINSURANCEID"]').val()!==jQuery('[name="SECONDARYPATIENTINSURANCEINFO"]').val();if(hasvaliddate&&(currentservicedate!=lastservicedate||ispayermodified)){ClaimUtils.UpdatePayerICDVersions(function(){_EnableOrDisableCharges(args);ClaimUtils.OnPayerICDVersionChange();});}
else{_EnableOrDisableCharges(args);}}
function _EnableOrDisableCharges(args){var pageload=(args&&args.PAGELOAD);var $servicedate=jQuery('#SERVICEDATE'),$department=jQuery('#DEPARTMENTID'),lasticdversion=ClaimUtils.GetPageICDVersion();var servicedatelastattr=$servicedate.attr('pickerlastvalue');var currentservicedate=$servicedate.val(),lastservicedate=typeof servicedatelastattr!=='undefined'?servicedatelastattr:$servicedate.data('lastvalue'),currentdepartment=$department.val(),lastdepartment=$department.data('lastvalue'),currenticdversion=ClaimUtils.GetICDVersion(currentservicedate);var hasvaliddate=IsDate(currentservicedate)&&currentservicedate!=='';var hasvaliddepartment=currentdepartment!='';var departmentchanged=(Number(currentdepartment)!=Number(lastdepartment));var servicedatechanged=(currentservicedate!=lastservicedate&&hasvaliddate);if(departmentchanged){ClaimUtils.UpdateElementLastValue($department,currentdepartment);}
var pagename=ClaimUtils.GetPageName();var chargesentryenabled=false;if(hasvaliddate){var crossedswitchoverdate=(currenticdversion!=lasticdversion)&&lasticdversion;var newdepartmentselected=(lastdepartment===''&&hasvaliddepartment);if(!chargeinputsinitialized||crossedswitchoverdate||newdepartmentselected){InitializeChargeInputsBasedOnServiceDate(pagename);chargeinputsinitialized=true;}
if(servicedatechanged||(departmentchanged&&hasvaliddepartment)){alarmstriggered=false;}
if(typeof servicedatelastattr!=='undefined'){$servicedate.removeAttr('pickerlastvalue');}
if(hasvaliddepartment){ClaimUtils.EnableDefaultChargeInputs(true);jQuery('#SPECIALTYFIELDSDIV input[type=checkbox]')
.prop('disabled',false);jQuery('.datewarning').slideUp('slow');if(pagename==='CLAIMADD'&&!alarmstriggered){CheckAlarms();jQuery('#ICDVERSIONHEADER').html('Diagnosis codes ('+currenticdversion+')');if(currenticdversion==='ICD-10'){jQuery('#AUTOSUGGESTOPTION').removeClass('hidden');jQuery(".diag").each(function(){if(this.value){jQuery(this).change();}});var icd9payerexists=ClaimUtils.GetPrimaryPayerICDVersion()==='ICD-9'||ClaimUtils.GetSecondaryPayerICDVersion()==='ICD-9';if(icd9payerexists){ShowMappedDiagnosesRow(true);jQuery('.showmappeddiagnosescheckboxcontainer').removeClass('hidden');}
else{ShowMappedDiagnosesRow(false);jQuery(".showmappeddiagnosescheckboxcontainer").addClass("hidden");}
if(crossedswitchoverdate){jQuery(".diaginfo").html('');jQuery(".diag").val('').blur();jQuery.each(ClaimAdd.VisibleChargelineIndexes(),function(index,chargelineindex){ClaimAdd.ResetMappedDiagnosisEdit(chargelineindex);});}
var reimbursementmapapproved=jQuery('input[name=REIMBURSEMENTMAPAPPROVED]').val()==1;if(icd9payerexists&&!reimbursementmapapproved){ClaimAdd.EditMappings();}}
else{jQuery(".showmappeddiagnosescheckboxcontainer").addClass("hidden");jQuery(".diag").each(function(){if(this.value){jQuery(this).change();}});if(crossedswitchoverdate){jQuery(".diaginfo").html('');jQuery(".diag").val('').blur();jQuery.each(ClaimAdd.VisibleChargelineIndexes(),function(index,chargelineindex){ClaimAdd.ResetMappedDiagnosisEdit(chargelineindex);});}
jQuery('#AUTOSUGGESTOPTION').addClass('hidden');jQuery('.mappeddiagnosisheading').removeClass('hidden');}}
if(!(pagename==='CLAIMEDIT'&&pageload)&&(crossedswitchoverdate||departmentchanged)){LoadChargeInfo(document.zform.PATIENTID.value,pagename);chargeinputsvalidated=true;}
chargesentryenabled=true;}}
if(!chargesentryenabled){ClaimUtils.EnableDefaultChargeInputs(false);jQuery('#SPECIALTYFIELDSDIV input[type=checkbox]')
.prop('disabled',true);var jqdatewarning=jQuery('.datewarning');var departmentfieldname=pagename==='CLAIMADD'?'service department':'facility';if(hasvaliddate){jqdatewarning.html('Please enter a '+departmentfieldname+' to enter charges.');}
else if(hasvaliddepartment){jqdatewarning.html('Please enter a date of service to enter charges.');}
else{jqdatewarning.html('Please enter a date of service and '+departmentfieldname+' to enter charges.');}
jqdatewarning.slideDown('slow');if(pagename==='CLAIMADD'){jQuery('#ICDVERSIONHEADER').html('Diagnosis codes');jQuery('#AUTOSUGGESTOPTION').addClass('hidden');jQuery('#SHOWICD9CHECKBOX').addClass('hidden');ShowMappedDiagnosesRow(false);}
return false;}
return true;}
