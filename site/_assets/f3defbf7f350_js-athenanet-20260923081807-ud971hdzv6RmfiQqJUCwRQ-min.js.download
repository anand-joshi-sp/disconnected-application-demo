else{rowparent.deleteRow(rowidx);}
EncounterDirty(container);return true;}
else{return false;}}
function GetFamilyMemberDescription(relationvalue){if(isDefined(familymembers[relationvalue])){return familymembers[relationvalue];}}
function RemoveExistingRecord(obj,id,relationname,relationkeyid){var container=GetSectionContainer(obj);if(RemoveRecord(obj,relationname,relationkeyid)){var html="<input name=FAMILYHISTORY{"+id+"}{DELETED} type=hidden value='"+id+"'>";container.insertAdjacentHTML("beforeEnd",html);EncounterDirty(container);}}
