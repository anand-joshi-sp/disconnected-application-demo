		<th>RAF</th>\n			<th>Source</th>\n			{{#ADDLINKJS}}<th></th>{{/ADDLINKJS}}\n		</tr>\n	{{#RECOMMENDATIONS}}\n		<tr \n			class=\'hccdxsuggestiontablerow {{ADDITIONALROWCLASS}}\'\n			{{#DIAGNOSIS}}\n				icd9code=\'{{CODE}}\'\n				icd9description=\'{{DESCRIPTION}}\'\n				snomedcode=\'{{SNOMEDCODE}}\'\n				snomedname=\'{{SNOMEDDESCRIPTION}}\'\n			{{/DIAGNOSIS}}\n			data-hccid=\'{{HCCID}}\'\n		>\n			<td class=\'hccdxsuggestiontablecell\'>\n				<div>\n					<span class=\'hcctext\'> HCC {{HCCID}}: {{HCCDESCRIPTION}} </span>\n					<br>\n					{{#DIAGNOSIS}}\n						{{UNSTRIPPEDCODE}}: {{DESCRIPTION}}\n					{{/DIAGNOSIS}}\n				</div>\n			</td>\n			<td class=\'hccdxsuggestiontablecell\'>{{RAF}} </td>\n			<td class=\'hccdxsuggestiontablecell\'>{{{SOURCEHTML}}}</td>\n			{{#ADDLINKJS}}\n				<td class=\'hccdxsuggestiontablecell\'>\n					<a href=\'#\' onclick=\'{{ADDLINKJS}}\' class=\'hccdxsuggestionacceptlink\'>Accept</a>\n				</td>\n			{{/ADDLINKJS}}\n		</tr>\n	{{/RECOMMENDATIONS}}\n	</table>\n</div>\n'});define('shared:/templates/clinicals/p4p/vbr/hccsnomedsearchsnomedlist',[],function(){'use strict';return'\n{{#SNOMEDS}}\n	<div\n		class=\'hccdxsnomedsearchselection\'\n		data-snomedcode=\'{{SNOMEDCODE}}\'\n		data-snomeddescription=\'{{DESCRIPTION}}\'\n	>\n		{{DESCRIPTION}}\n	</div>\n{{/SNOMEDS}}\n'});define('shared:/templates/clinicals/p4p/vbr/icd10_diagnosis_suggestion_list',[],function(){'use strict';return'\n<div class=\'hccdxsuggestioncontent\'>\n	<div class=\'hccpatientrafscorediv\'>\n		<span class=\'hccpatientriskinfospan\'> \n			<span>\n				 Risk score\n			</span>\n			<span class=\'hccriskscoreinfobox\'>\n			</span>\n		</span>\n		<span class=\'hcccurrentrafspan\'>\n			Current <span class=\'hcccurrentpatientrafscorespan\'></span> \n		</span>\n		<span class=\'hccpatientrafdivider\'></span> \n		<span class=\'hccgapspan\'>\n			Gap <span class=\'hccpatientrafgapspan\'></span>\n		</span>\n		<span class=\'hccpatientraflinks\'>\n			{{{PATIENTRAFLINKS}}}\n			{{#PATIENTRAFLINKS}}<span class=\'hcclinkdivider\'></span>{{/PATIENTRAFLINKS}}\n			<span class=\'hcclearnmorelink\'>\n				<a href=\"https://community.athenahealth.com/community/resource-center/quality-management-resource-center\" target=\"_blank\">Learn more</a>\n			</span>\n		</span>\n	</div>\n	{{#NUMRECOMMENDATIONS}}\n		<div class=\'athenawarningmessage\'>\n			<span class=\'strong\'>Existing clinical and claim data suggests the following as potential diagnosis for this patient.</span>\n			<br>\n			<span>\n				{{#SUGGESTIONSEXISTTEXT}}{{SUGGESTIONSEXISTTEXT}}{{/SUGGESTIONSEXISTTEXT}}\n				{{^SUGGESTIONSEXISTTEXT}}\n					Determine whether these diagnoses are valid and document accordingly.\n				{{/SUGGESTIONSEXISTTEXT}}\n			</span>	\n		</div>	\n	{{/NUMRECOMMENDATIONS}}\n	{{^NUMRECOMMENDATIONS}}\n		<div class=\'athenasuccessmessage\'>\n			<span class=\'strong\'> All potential diagnoses have been documented in this encounter or submitted on a claim this year</span>\n		</div>\n	{{/NUMRECOMMENDATIONS}}\n	<table class=\'hccdxsuggestiontable itemtable\'>\n		<tr class=\'hccdxsuggestiontableheaderrow\'>\n			<th>Potential diagnosis</th>\n			<th>RAF Weight</th>\n			<th>Source</th>\n			{{#ADDLINKJS}}<th></th>{{/ADDLINKJS}}\n		</tr>\n	{{#RECOMMENDATIONS}}\n		<tr \n			class=\'hccdxsuggestiontablerow {{ADDITIONALROWCLASS}}\'\n			{{#DIAGNOSIS}}\n				buddycoderecommended=\'{{#BUDDYCODES}}{{RECOMMENDED}}{{/BUDDYCODES}}\'\n				buddycoderequired=\'{{#BUDDYCODES}}{{REQUIRED}}{{/BUDDYCODES}}\'\n				icdcode=\'{{CODE}}\'\n				icdcodeallid=\'{{ICDCODEALLID}}\'\n				icddescription=\'{{DESCRIPTION}}\'\n				snomedcode=\'{{SNOMEDCODE}}\'\n				snomedname=\'{{SNOMEDDESCRIPTION}}\'\n				unstrippedicdcode = \'{{UNSTRIPPEDCODE}}\'\n			{{/DIAGNOSIS}}\n			data-hccdescription=\'{{HCCDESCRIPTION}}\'\n			data-hccid=\'{{HCCID}}\'\n			data-p4phccdxsuggestionid=\'{{P4PHCCDXSUGGESTIONID}}\'\n			data-sourcesnomeds=\'{{SOURCESNOMEDS}}\'\n		>\n			<td class=\'hccdxsuggestiontablecell\'>\n				<div>\n					<span class=\'hcctext\'> HCC {{HCCID}}: {{HCCDESCRIPTION}} </span>\n					<br>\n					{{#DIAGNOSIS}}\n						<table>\n							{{#ADDLINKJS}}\n								{{#DIAGNOSIS}}\n									{{#SNOMEDCODE}}\n										<tr class=\'hccdxsuggestionsnomedrow\'>\n									{{/SNOMEDCODE}}\n									{{^SNOMEDCODE}}\n										<tr class=\'hccdxsuggestionsnomedrow starthidden\'>\n									{{/SNOMEDCODE}}\n								{{/DIAGNOSIS}}\n								<th>\n									Diagnosis\n								</th>\n								<td class=\'hccdxsuggestionsnomedcodecell\'>\n									<span class=\'hccdxsnomedtext\'>\n										{{#DIAGNOSIS}}\n											{{#SNOMEDCODE}}\n												{{SNOMEDDESCRIPTION}}\n												<a class=\'hccdxsnomeddeletelink deletelink\' title=\'Change Diagnosis\'>\n													<span class=\'sprite-del-16x16\'></span>\n												</a>\n											{{/SNOMEDCODE}}\n										{{/DIAGNOSIS}}\n									</span>\n								</td>\n								</tr>\n							{{/ADDLINKJS}}\n							<tr class=\'hccdxsuggestionbillingcodecell{{^SNOMEDCODE}}{{^ICDCODEALLID}} starthidden{{/ICDCODEALLID}}{{/SNOMEDCODE}}\'>\n								<th>\n									Billing Code\n								</th>\n								{{#ICDCODEALLID}}\n									<td>\n										{{UNSTRIPPEDCODE}}: {{DESCRIPTION}}\n									</td>\n								{{/ICDCODEALLID}}\n								{{^ICDCODEALLID}}\n									{{#ICD10DATAMODEL}}\n										<td>\n											<span class=\'hccdxsuggestionicd10text\'></span>\n										</td>\n									{{/ICD10DATAMODEL}}\n								{{/ICDCODEALLID}}\n							</tr>\n							{{#ADDLINKJS}}\n								{{#BUDDYCODES}}\n									<tr class=\'hccdxsuggestionbuddycoderow\'>\n										<th></th>\n										<td class=\'hccdxsuggestionbuddycodecell\'>\n											<span class=\'hccdxsuggestionmanifestationrecommendedlink\'>\n												{{#RECOMMENDED}}\n													<span \n														class=\'jslink hccdxsuggestionbuddycodelink\' \n														onclick=\'{{SELECTMANIFESTATIONLINKJS}}\'\n														data-required=\'\'\n														data-icd10pickermodel=\'{{MODEL}}\'\n													>\n														Specify manifestation\n													</span>\n													An additional billing code may be recommended {{{INFOBOX}}}\n												{{/RECOMMENDED}}\n											</span>\n											<span class=\'hccdxbuddycodeicd10text\'></span>\n										</td>\n									</tr>\n								{{/BUDDYCODES}}\n								{{^BUDDYCODES}}\n									<tr class=\'hccdxsuggestionbuddycoderow starthidden\'>\n										<th></th>\n										<td class=\'hccdxsuggestionbuddycodecell\'>\n											<span class=\'hccdxsuggestionmanifestationrecommendedlink\'></span>\n											<span class=\'hccdxbuddycodeicd10text\'></span>\n										</td>\n									</tr>\n								{{/BUDDYCODES}}\n							{{/ADDLINKJS}}\n							{{CANCELLINKJS}}\n						</table>\n					{{/DIAGNOSIS}}\n				</div>\n			</td>\n			<td class=\'hccdxsuggestiontablecell\'>{{RAF}} </td>\n			<td class=\'hccdxsuggestiontablecell\'>{{{SOURCEHTML}}}</td>\n			{{#ADDLINKJS}}\n				<td class=\'hccdxsuggestiontablecell hccdxsuggestionactiontablecell\'>\n				{{#DIAGNOSIS}}\n					{{#SNOMEDCODE}}\n						{{#ICD10DATAMODEL}}\n							<a href=\'#\' onclick=\'{{ADDLINKJS}}\' class=\'hccdxsuggestionacceptlink\'>Add to A&P</a>\n						{{/ICD10DATAMODEL}}\n						{{^ICD10DATAMODEL}}\n							{{#BUDDYCODES}}\n								{{^RECOMMENDED}}\n									<a href=\'#\' onclick=\'{{ADDLINKJS}}\' class=\'hccdxsuggestionacceptlink\'>Add to A&P</a>\n								{{/RECOMMENDED}}\n								{{#RECOMMENDED}}\n									<a href=\'#\' onclick=\'{{ADDLINKJS}}\' class=\'hccdxsuggestionacceptlink startvisible\'>Add to A&P</a>\n								{{/RECOMMENDED}}\n							{{/BUDDYCODES}}\n							{{^BUDDYCODES}}\n								<a href=\'#\' onclick=\'{{ADDLINKJS}}\' class=\'hccdxsuggestionacceptlink startvisible\'>Add to A&P</a>\n							{{/BUDDYCODES}}\n						{{/ICD10DATAMODEL}}\n					{{/SNOMEDCODE}}\n					{{^SNOMEDCODE}}\n						<a href=\'#\' onclick=\'{{ADDLINKJS}}\' class=\'hccdxsuggestionacceptlink\'>Add to A&P</a>\n					{{/SNOMEDCODE}}\n					<span class=\'hccdxsuggestionaddholduptext\'>\n						<span class=\'hccdxsuggestionchoosesnomedlink jslink{{^SNOMEDCODE}} startvisible{{/SNOMEDCODE}}\'>\n							Choose diagnosis\n						</span>\n						<span class=\'icd10dxaddlink{{#SNOMEDCODE}}{{#ICD10DATAMODEL}} startvisible{{/ICD10DATAMODEL}}{{/SNOMEDCODE}}\' data-model=\'{{ICD10DATAMODEL}}\' data-hccid=\'{{HCCID}}\'>\n							<span class=\'jslink\' onclick=\'{{CHOOSEICD10LINKJS}}\'>\n								Choose billing code\n							</span>\n						</span>\n						<span class=\'hccdxsuggestionmanifestationrequiredlink{{#SNOMEDCODE}}{{^ICD10DATAMODEL}}{{#BUDDYCODES}}{{^RECOMMENDED}} startvisible{{/RECOMMENDED}}{{/BUDDYCODES}}{{/ICD10DATAMODEL}}{{/SNOMEDCODE}}\'>\n							<span \n								class=\'jslink hccdxsuggestionbuddycodelink\' \n								onclick=\'{{SELECTMANIFESTATIONLINKJS}}\'\n								{{#BUDDYCODES}}\n									{{^RECOMMENDED}}\n										data-required=\'1\'\n										data-icd10pickermodel=\'{{MODEL}}\'\n									{{/RECOMMENDED}}\n								{{/BUDDYCODES}}\n							>\n								Specify manifestation\n							</span>\n						</span>\n					</span>\n				{{/DIAGNOSIS}}\n				{{#DISMISSALJS}}\n					<span> | </span>\n					<a href=\'#\' onclick=\'{{DISMISSALJS}}\' class=\'hccdxsuggestiondismisslink\'>\n						<span class=\'sprite-streamlined-delete\'></span>\n					</a>\n				{{/DISMISSALJS}}\n				</td>\n			{{/ADDLINKJS}}\n		</tr>\n	{{/RECOMMENDATIONS}}\n	</table>\n</div>\n'});define('shared:/templates/clinicals/p4p/vbr/patient_raf_receipt_view',[],function(){'use strict';return'\n<div class=\'hccrafreceiptcontainer\'>\n	<a id=\'receiptview\' name=\'receiptview\'></a>\n	<div class=\'hccrafreceiptrow\'>\n		<div class=\'hccrafreceiptcurrentrafcell\'>\n			 Risk Score: {{RAF}}\n		</div>\n		<div class=\'hccrafreceiptfactorstablecontainer\'>\n			<table class=\'hccrafreceiptfactorstable\'>\n				{{#FACTORS}}\n					<tr class=\'hccrafreceiptfactorstablerow\'>\n						<td class=\'hccrafreceiptfactorstablecell\'>{{FACTORNAME}}</td>\n						<td class=\'hccrafreceiptfactorstablecell\'>{{FACTORRAF}}</td>\n					</tr>\n				{{/FACTORS}}\n			</table>\n		</div>\n	</div>\n</div>\n'});define('shared:/templates/interface/patientmatch/demographics',[],function(){'use strict';return'\n<div class=\"floatleft\">\n	<div>\n		{{#PATIENTURL}}<a\n			href=\'{{PATIENTURL}}\'\n			target=\'frMain\'\n			title=\'View Chart\'\n		>{{/PATIENTURL}}\n		<strong>\n			{{#FIRSTNAME}}\n				{{FIRSTNAME}}\n			{{/FIRSTNAME}}\n			{{#ALTFIRSTNAME}}\n				\"{{ALTFIRSTNAME}}\"\n			{{/ALTFIRSTNAME}}\n			{{#MIDDLEINITIAL}}\n				{{MIDDLEINITIAL}}\n			{{/MIDDLEINITIAL}}\n			{{#LASTNAME}}\n				{{LASTNAME}}\n			{{/LASTNAME}}\n			{{#NAMESUFFIX}}\n				 {{NAMESUFFIX}}\n			{{/NAMESUFFIX}}\n		</strong>\n		{{#PATIENTURL}}</a>{{/PATIENTURL}}\n	</div>\n	<div>\n		{{#DOB}}\n			<b>DOB</b>: {{DOB}}&nbsp;&nbsp;&nbsp;\n		{{/DOB}}\n		{{#SSN}}\n			<b>SSN</b>: {{SSN}}&nbsp;&nbsp;&nbsp;\n		{{/SSN}}\n		{{#ID}}\n			<b>Patient ID</b>: #{{ID}}&nbsp;&nbsp;&nbsp;\n		{{/ID}}\n	</div>\n	<div>\n		{{#PHONENUMBER}}\n			<b>Phone</b>: {{PHONENUMBER}}&nbsp;&nbsp;&nbsp;\n		{{/PHONENUMBER}}\n		{{#SEX}}\n			<b>Sex</b>: {{SEX}}&nbsp;&nbsp;&nbsp;\n		{{/SEX}}\n	</div>\n	{{#HASADDRESS}}\n		<div>\n			<b>Address</b>:\n				{{#ADDRESS1}}\n					{{ADDRESS1}},\n				{{/ADDRESS1}}\n				{{#ADDRESS2}}\n					{{ADDRESS2}},\n				{{/ADDRESS2}}\n				{{#CITY}}\n					{{CITY}},\n				{{/CITY}}\n				{{#STATE}}\n					{{STATE}}\n				{{/STATE}}\n				{{ZIP}}\n		</div>\n	{{/HASADDRESS}}\n	{{#CHARTSHARINGGROUPNAME}}\n		<div>\n			<b>Chart Sharing Group</b>: {{CHARTSHARINGGROUPNAME}}\n		</div>\n	{{/CHARTSHARINGGROUPNAME}}\n	{{#PROVIDERGROUPNAME}}\n		<div>\n			<b>Provider Group</b>: {{PROVIDERGROUPNAME}}\n		</div>\n	{{/PROVIDERGROUPNAME}}\n</div>\n'});define('shared:/templates/interface/patientmatch/document_view_form_hold',[],function(){'use strict';return'\n{{^PATIENTNAMEURL}}\n	<tr class=\'nonprinting\'>\n		<td colspan=2>\n			<div class=\"linking-lightbox\">\n				<div class=\"person-verification\">\n					<div class=\"athenawarningmessage\">\n						We could not conclusively match this document to a patient profile. \n						{{#MATCHEDPATIENTSHTML}}Select the correct patient profile below, or search for a correct match.{{/MATCHEDPATIENTSHTML}}\n						{{^MATCHEDPATIENTSHTML}}Search for the correct match below.{{/MATCHEDPATIENTSHTML}}\n					</div>\n				</div>\n			</div>\n		</td>\n	</tr>\n\n	{{#PATIENTINFOHTML}}\n		<tr class=\'nonprinting\'>\n			<td colspan=2>\n				<div class=\"pmlsubheading pmlelement\">Document patient profile</div>\n			</td>\n		</tr>\n		<tr class=\'nonprinting\'>\n			<td colspan=2>\n				<div class=\'pmlelement mockradio\'></div>\n				{{{PATIENTINFOHTML}}}\n			</th>\n		</tr>\n	{{/PATIENTINFOHTML}}\n	{{{MATCHEDPATIENTSHTML}}}\n{{/PATIENTNAMEURL}}\n\n<tr class=nonprinting>\n	{{#PATIENTNAMEURL}}<th>Patient</th>{{/PATIENTNAMEURL}}\n	{{^PATIENTNAMEURL}}\n		{{#FINDPROFILERADIO}}\n			<td>{{{FINDPROFILERADIO}}}</td>\n		{{/FINDPROFILERADIO}}\n		{{^FINDPROFILERADIO}}\n			<th>Find Patient Profile</th>\n		{{/FINDPROFILERADIO}}\n	{{/PATIENTNAMEURL}}\n	<td><div class=\'floatleft\'>[[RESULTPMLID]][[CHARTSHARINGGROUPID]]</div>\n	{{^PATIENTNAMEURL}}\n		<div class=\'mockradio\'></div>{{{REGISTRATIONLINK}}}\n	{{/PATIENTNAMEURL}}\n	</td>\n</tr>\n\n<tr class=nonprinting>\n	<td colspan=2>\n		{{^PATIENTNAMEURL}}{{#FINDPROFILERADIO}}\n			<label for=\'Find_Patient_Profile_Radio\'>\n		{{/FINDPROFILERADIO}}{{/PATIENTNAMEURL}}\n		<div class=\'pmlelement mockradio\'></div><span id=\'PATIENTNAME\'>{{{PATIENTNAMEURL}}}</span>\n		{{^PATIENTNAMEURL}}{{#FINDPROFILERADIO}}\n			</label>\n		{{/FINDPROFILERADIO}}{{/PATIENTNAMEURL}}\n	</td>\n</tr>\n{{^PATIENTNAMEURL}}{{#FINDPROFILERADIO}}\n	<tr class=\'nonprinting\'>\n		<td colspan=2>\n			<div class=\"pmlsubheading pmlelement\"></div>\n		</td>\n	</tr>\n{{/FINDPROFILERADIO}}{{/PATIENTNAMEURL}}'});define('shared:/templates/element_attributes',[],function(){'use strict';return'{{#name}}name=\"{{name}}\"{{/name}}\n{{#id}}id=\"{{id}}\"{{/id}}\n{{#attributes}}\n	  {{key}}=\"{{value}}\"\n{{/attributes}}\n{{#data_attributes}}\n	  data-{{key}}=\"{{value}}\"\n{{/data_attributes}}\n\n\n'});d