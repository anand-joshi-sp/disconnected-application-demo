var alldiagnosisorders=jQuery('#ALLDIAGNOSISORDERS').get(0);var orderwidgets=[];if(jQuery(object).parents("[id$=_pickercontent]").attr('orderingimprovement')==='ON'){var clinicalproviderordertypeid=jQuery(object.parentNode).attr('clinicalproviderordertypeid');var clinicalproviderid=jQuery(object.parentNode).attr('defaultclinicalproviderid');var temporderwidgets=GetChildren(alldiagnosisorders,'tagName','div','className',/orderitem/,'ordertypeid',clinicalordertypeid);for(var i=temporderwidgets.length-1;i>=0;i--){var orderwidget=temporderwidgets[i];var widgetclinicalproviderordertypeid=jQuery(orderwidget).find('[id$="{CLINICALPROVIDERORDERTYPEID}"]').val();var widgetclinicalproviderid=jQuery(orderwidget).find('[id$="{CLINICALPROVIDERID}"]').val();if(clinicalproviderid===widgetclinicalproviderid&&clinicalproviderordertypeid===widgetclinicalproviderordertypeid){orderwidgets.push(orderwidget);}}
