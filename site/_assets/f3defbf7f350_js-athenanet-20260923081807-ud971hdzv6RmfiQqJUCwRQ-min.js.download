else{for(var i=0;i<sectionnames.length;i++){var fieldprefix=args.FIELDPREFIX+"{"+sectionids[i]+"}";finalhtml=PopulateDataReconcileConfirm({SECTIONNAME:sectionnames[i],FIELDPREFIX:fieldprefix,CONFIRMCHANGES:confirmchanges,ACCORDION:accordion,HTML:finalhtml,IS_NO_KNOWN_PROBLEMS_ENABLED:args.IS_NO_KNOWN_PROBLEMS_ENABLED});}}
confirmchanges.html(finalhtml);}}
