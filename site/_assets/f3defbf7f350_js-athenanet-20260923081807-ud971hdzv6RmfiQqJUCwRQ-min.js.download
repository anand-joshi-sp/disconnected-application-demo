var sectionvalid=completed&&!lefttodo;var sectionselectionsvalid;if(shouldValidateNoKnownSelections){sectionselectionsvalid=ValidateSectionSelections(section,sectionprefix,sectionvalid);sectionvalid=sectionvalid&&sectionselectionsvalid;}
