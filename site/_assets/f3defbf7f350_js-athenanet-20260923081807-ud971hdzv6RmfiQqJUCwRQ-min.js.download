function OnOrderSetAdminPage(){return document.location.toString().match('manageordersets.esp|encounterplan.esp')?1:0;}
function OnGlobalOrderSetAdminPage(){return document.location.toString().match('/1/1/clinicalsadmin/manageordersets.esp')?1:0;}
function OnEncounterPlansPage(){return document.location.toString().match('encounterplan.esp')?1:0;}
function IsOrderSetDefaultingEnabled(){return OnOrderSetAdminPage()&&!OnGlobalOrderSetAdminPage()&&!OnEncounterPlansPage();}
function GetImmediateChildrenByAttribute(parent,attribute,value){var candidates=parent.childNodes;var winners=[];for(var i=0;i<candidates.length;i++){if(jQuery(candidates[i]).attr(attribute)==value){winners.push(candidates[i]);}}
return winners;}
function GetFirstMatchingElementByAttribute(object,attribute,value){for(var i=0;i<object.length;i++){if(jQuery(object[i]).attr(attribute)==value){return object[i];}}
return null;}
