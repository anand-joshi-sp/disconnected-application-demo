if(!jqorderdiv.attr('signoffpermission')){ordersignoff=false;}
var MyValidate=function(fieldname,displayname,type){var field=document.getElementsByName(fieldprefix+fieldname+fieldsuffix)[0];return ValidateField({FIELD:field,DISPLAYNAME:displayname,TYPE:type,SECTION:orderdiv,BEFOREALERT:function(){Focus(ordertype,orderid,orderdiv)}});}
var needsappointment=document.getElementsByName(fieldprefix+'NEEDSAPPOINTMENT'+fieldsuffix)[0];if(needsappointment){if(needsappointment.checked){var performencounterdate=document.getElementsByName(fieldprefix+'PERFORMENCOUNTERID'+fieldsuffix)[0];if(performencounterdate&&performencounterdate.value=='Other'){if(!MyValidate('PERFORMENCOUNTERIDASDATE','Perform Date','NONNULL')){return false;}}}else{var futuresubmitdateselect=document.getElementsByName(fieldprefix+'FUTURESUBMITDATESELECT'+fieldsuffix)[0];if(futuresubmitdateselect&&futuresubmitdateselect.value=='Other'){if(!MyValidate('FUTURESUBMITDATE','Perform Date','NONNULL')){return false;}}}}
var specimencollectedby=jQuery("#autocomplete_"+EscapeJQuerySelector(fieldprefix+'SPECIMENCOLLECTEDBY'+fieldsuffix));if(specimencollectedby&&specimencollectedby.hasClass("InvalidInput")){alert('Please enter a user or set it to blank');specimencollectedby.focus();return false;}
var specimendatetime=jQuery("#"+EscapeJQuerySelector(fieldprefix+'SPECIMENDATETIME'+fieldsuffix));if(specimendatetime&&specimendatetime.attr("INVALID")&&specimendatetime.attr("INVALID")!="false"){alert('Please enter a valid collection date and time, or clear all associated fields.');jQuery(orderdiv).click();var togglelink=jQuery('#'+EscapeJQuerySelector(fieldprefix+'SPECIMENTOGGLE'+fieldsuffix)).find('a');if(togglelink.text()=='Document specimen'){togglelink.click();}
jQuery("#"+EscapeJQuerySelector(fieldprefix+'SPECIMENDATETIME'+fieldsuffix+'_DATE')).focus();return false;}
if(ordersignoff){var offmenuinput=document.getElementsByName(fieldprefix+"OFFMENUYN"+fieldsuffix)[0];if(offmenuinput&&offmenuinput.value=='Y'&&offmenuinput.getAttribute('restrictcompendiumyn')=='Y'){alert(jQuery('div.SHOWWARNING',orderdiv).text());return false;}
if(!ValidateForeignLabCode({FIELDPREFIX:fieldprefix,FIELDSUFFIX:fieldsuffix,ORDERDIV:orderdiv})){return false;}}
return true;}
