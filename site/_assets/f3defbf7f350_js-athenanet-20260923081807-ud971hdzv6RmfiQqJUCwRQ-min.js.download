else{var html="<input name='"+providerordertypefieldname+"' type=hidden value="+nvl(data.CLINICALPROVIDERORDERTYPEID,'')+">";jqform.append(html);}}
if(form.CLINICALPROVIDERID&&form.CLINICALPROVIDERID.value&&form.CLINICALPROVIDERID.value!=data.CLINICALPROVIDERID&&documentstatus!='CLINICALDATAENTRY'||form.PROVIDERUSERNAME&&form.PROVIDERUSERNAME.value&&form.PROVIDERUSERNAME.value!=data.PROVIDERUSERNAME&&documentstatus!='CLINICALDATAENTRY'||(clinicalordertypename&&form.CLINICALORDERTYPEID&&form.CLINICALORDERTYPEID.value&&form.CLINICALORDERTYPEID.value!=data.CLINICALORDERTYPEID&&documentstatus!='CLINICALDATAENTRY')){if(!confirm('Update '+performinglab+' and '+orderingprovider+' fields as well?')){return;}}
if(form.CLINICALPROVIDERID&&(!form.CLINICALPROVIDERID.value||documentstatus!='CLINICALDATAENTRY')){form.CLINICALPROVIDERID.value=nvl(data.CLINICALPROVIDERID,'');var clinicalproviderdescription=jqform.find('#CLINICALPROVIDERID_NAME').get(0);if(clinicalproviderdescription){clinicalproviderdescription.innerHTML=nvl(data.CLINICALPROVIDERDESCRIPTION,'');}}
if(form.PROVIDERUSERNAME&&(!form.PROVIDERUSERNAME.value||documentstatus!='CLINICALDATAENTRY')){form.PROVIDERUSERNAME.value=nvl(data.PROVIDERUSERNAME,'');}}
