else{documentid=GetChild(tablerow,'tagName','input','name',/SPECIMEN{.+}{ID}/);var resultTypeInfoElement=jQuery(tablerow).find('.structured-result-types');if(resultTypeInfoElement.length){var resultTypeOptions=resultTypeInfoElement.data('resulttypeoptions');var resultTypes=[];if(resultTypeOptions){resultTypes=Object.keys(resultTypeOptions);resultTypeInfoElement.data('resulttypeoptions',null);}
var hideDocResultField=RemoveUnnecessaryResultTypes(resultTypes);if(hideDocResultField){HideDocumentResultTable();}}}
if(documentid&&documentid.value){var deletename=documentid.name.replace(/ID/,"DELETE");var html="<input name='"+deletename+"' type=hidden value="+documentid.value+">";document.zform.insertAdjacentHTML("beforeEnd",html);}
table.deleteRow(index);}
if(selectedVal){for(var i=2;i<table.rows.length;i++){tablerow=table.rows[i];if(tablerow){var options=jQuery(tablerow).find('option[value="'+selectedVal+'"]');if(options&&options.length===0){var newOption=new Option(selectedVal,selectedVal);var resultType=jQuery(tablerow).find("select[name*='RESULTTYPE']");if(resultType&&resultType.length){resultType[0].options.add(newOption);}}}}}}}
function UpdateResultValue(obj){var resultTypeOptionElement=jQuery('.structured-result-types');if(resultTypeOptionElement.length){var resultValues=[];var tableRow=jQuery(obj).parent('td').parent('tr');var resultValueFields=tableRow.find("select[name*='RESULTVALUE']");if(obj.value){for(var i=0;i<resultTypeOptionElement.length;i++){var resultTypeOptions=jQuery(resultTypeOptionElement[i]).data('resulttypeoptions');if(resultTypeOptions&&resultTypeOptions[obj.value]&&resultTypeOptions[obj.value].length){resultValues=resultTypeOptions[obj.value];break;}}}
if(resultValueFields.length){resultValueFields.children().remove();tableRow.find("input[name*='RESULTTYPEVALUEID']").val('');var newOption=new Option('','');resultValueFields.append(newOption);resultValues.forEach(function(resultValue){newOption=new Option(resultValue.RESULTVALUE,resultValue.RESULTVALUE);newOption.setAttribute("resulttypevalueid",resultValue.RESULTTYPEVALUEID);resultValueFields.append(newOption);});}}}
