function GenerateClinicalServiceProcedureCodes(field,autoclaimenabled){field.autocompleteobj.clearPopup();try{var procedurecodeoptions=JSON.parse(field.value);if(!procedurecodeoptions||!(Array.isArray(procedurecodeoptions))){throw new Error("Not a JSON array");}
var procedurerow=GetParent(field,'tagName','tr','name','clinicalprocedurerow');var servicetable=GetParent(procedurerow,'tagName','table','id','servicetable');var dxregex=new RegExp(EscapeRegExp(procedurerow.id+'{DIAGNOSIS}'));var dxlist=GetChildren(servicetable,'tagName','input','type','text','name',dxregex);var dx=dxlist.map(function(dxelement){return dxelement.value;});var unitsregex=new RegExp(EscapeRegExp(procedurerow.id+'{UNITS}'));var units=GetChild(procedurerow,'name',unitsregex);var modifiersregex=new RegExp(EscapeRegExp(procedurerow.id+'{MODIFIER}'));var modifierlist=GetChildren(procedurerow,'tagName','input','type','text','name',modifiersregex);var modifiers=[];for(var i=0;i<modifierlist.length;i++){modifiers.push(modifierlist[i].value);}
var delsprite=GetChild(procedurerow,'title','delete procedure code','className',/sprite-del-16x16/);for(var i=procedurecodeoptions.length-1;i>=0;i--){if(procedurecodeoptions[i].CODE){if(i==0){if(!procedurecodeoptions[i].UNITS){procedurecodeoptions[i].UNITS=units.value;}
if((!procedurecodeoptions[i].NONFEEAFFECTINGMODIFIERS)||!(procedurecodeoptions[i].NONFEEAFFECTINGMODIFIERS.length)){procedurecodeoptions[i].NONFEEAFFECTINGMODIFIERS=modifiers;}}
AddClinicalServiceProcedureCode(procedurerow.cells[0],procedurecodeoptions[i].CODE,1,autoclaimenabled,dx,procedurecodeoptions[i].UNITS,procedurecodeoptions[i].NONFEEAFFECTINGMODIFIERS);}}
DeleteClinicalServiceProcedureCode(delsprite,autoclaimenabled);}catch(e){field.value=field.value.toUpperCase();CheckDistinctProcedureCode(field);CheckClinicalProcedureCodeBillable(field);DisplayCodeName(field);if(autoclaimenabled){DisplayExplodingMessage(field);DisplayNDC(field);}}}
