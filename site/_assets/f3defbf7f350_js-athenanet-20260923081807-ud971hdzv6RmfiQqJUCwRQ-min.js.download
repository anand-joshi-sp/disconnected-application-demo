function InlineAddition(name){var count=0;var values;var initializejavascript='';var addrowjavascript='';var getrowvaluejavascript='';var setrequiredfieldstatusjavascript='';var preinitialize=function(){var hiddeninput=document.getElementById(name);hiddeninput.refresh=refresh;values=hiddeninput.value?hiddeninput.value.split('\t'):'';initializejavascript=hiddeninput.getAttribute("initializejavascript");addrowjavascript=hiddeninput.getAttribute("addrowjavascript");getrowvaluejavascript=hiddeninput.getAttribute("getrowvaluejavascript");setrequiredfieldstatusjavascript=hiddeninput.getAttribute("setrequiredfieldstatusjavascript");}
var initialize=function(){var mydiv=getdiv();var hiddeninput=document.getElementById(name);mydiv.innerHTML='';if(values.length){for(var i=0;i<values.length;i++){addinput({value:values[i],skiprefresh:true});}
_setrequiredfieldstatus({index:0,requiredfieldvalue:hiddeninput.className.match(/\bRequiredField\b/)});}
else{addinput();}};var addinput=function(args){var value='';var skiprefresh=false;if(args){value=args.value;skiprefresh=args.skiprefresh;}
var mydiv=getdiv();var newinputdiv=document.createElement('div');newinputdiv.id=name+'_inputdiv_'+count;newinputdiv.style.display='none';_addinput({inputdiv:newinputdiv,value:value});var newdeletespan=document.createElement('span');newdeletespan.id=name+'_deletespan_'+count;newdeletespan.style.cursor='pointer';if(count==0&&values.length<2){newdeletespan.style.display='none';}
newdeletespan.className='sprite-del-16x16';newdeletespan.onclick=deleteinput;newinputdiv.appendChild(newdeletespan);var newaddspan=document.createElement('span');newaddspan.id=name+'_addspan_'+count;newaddspan.style.cursor='pointer';newaddspan.className='sprite-add';newaddspan.onclick=addinput;newinputdiv.appendChild(newaddspan);var newspacerdiv=document.createElement('div');newspacerdiv.style.height=5;newspacerdiv.style.fontSize=5;newinputdiv.appendChild(newspacerdiv);mydiv.appendChild(newinputdiv);jQuery(newinputdiv).slideDown();count++;if(!skiprefresh){refresh();}};var _addinput=function(args){var inputdiv=args.inputdiv;var value=args.value;eval(addrowjavascript);};var deleteinput=function(){this.parentElement.deleted=true;jQuery(this.parentElement).slideUp();refresh();};var refresh=function(){var hiddeninput=document.getElementById(name);var first;var realcount=0;values=[];for(var i=0;i<count;i++){inputdiv=getinputdiv(i);if(!inputdiv.deleted){if(realcount==0){first=i;}
realcount++;var value=_getrowvalue({index:i});if(value){values.push(value);}}
else{_setrequiredfieldstatus({index:i,requiredfieldvalue:false});}}
_setrequiredfieldstatus({index:first,requiredfieldvalue:hiddeninput.className.match(/\bRequiredField\b/)});getdeletespan(first).style.display=(realcount==1?'none':'inline-block');hiddeninput.value=values.join('\t');if(hiddeninput.onchange){hiddeninput.onchange();}};var _getrowvalue=function(args){var index=args.index;var rowvalue;eval(getrowvaluejavascript);return rowvalue;};var _setrequiredfieldstatus=function(args){var index=args.index;var requiredfieldvalue=args.requiredfieldvalue;eval(setrequiredfieldstatusjavascript);};var getdiv=function(){return document.getElementById(name+'_div');};var getinputdiv=function(index){return document.getElementById(name+'_inputdiv_'+index);};var getdeletespan=function(index){return document.getElementById(name+'_deletespan_'+index);};preinitialize();eval(initializejavascript);initialize();}
