else{if(!basehref||basehref==AH.GetGlobal('BASE_HREF')){AH.SetGlobal('DEPARTMENTID',departmentid);require(['shared:/scripts/athena/utils/cross_frame_events'],function(CrossFrameEventUtils){CrossFrameEventUtils.trigger('change-department-dropdown-value',departmentid,departmentname);});}
var newlocationstring='';if(newlocationurl){newlocationstring='&NEWLOCATIONURLENCODED='+encodeURIComponent(newlocationurl);}
