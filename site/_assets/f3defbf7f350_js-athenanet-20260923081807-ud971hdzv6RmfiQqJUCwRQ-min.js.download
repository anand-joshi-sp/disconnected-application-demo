else if(args.MODAL){var win=window.open(GetMDCCompatibleHTMLURL('blank.html'),args.MODAL,'titlebar=no,directories=no,location=no,menubar=no,status=no,toolbar=no,top=0,left=0,scrollbars=no,resizable=yes');RunWhenDocumentReady(win,function(){win.document.location.href=args.URL;win.focus();});}
else if(args.PRINTFROMHIDDEN){AH.Frames.Hidden.SetLocation(args.URL);}
else{document.location=args.URL;}}});}
function DisplayControl(control,type,elements){var selectedvalue=(type=='radio'?radioValue(document.getElementsByName(control)):document.getElementsByName(control).value);for(var i=0;i<elements.length;i++){if(selectedvalue==elements[i]){document.getElementById('div'+elements[i]).style.display='block';}else{document.getElementById('div'+elements[i]).style.display='none';}}}
function ChangeInputType(oldObject,oType){var newObject=document.createElement('input');newObject.type=oType;if(oldObject.size){newObject.size=oldObject.size;}
if(oldObject.value){newObject.value=oldObject.value;}
if(oldObject.name){newObject.name=oldObject.name;}
if(oldObject.id){newObject.id=oldObject.id;}
if(oldObject.className){newObject.className=oldObject.className;}
if(oldObject.onblur){newObject.onblur=oldObject.onblur;}
if(oldObject.onfocus){newObject.onfocus=oldObject.onfocus;}
oldObject.parentNode.replaceChild(newObject,oldObject);return newObject;}
function UpdatePin(args){AssertFields(args,['PATIENTID','PINCODE']);var success;CallRemote({SUB:'PatientCycle::UpdatePIN',ARGS:{PATIENTID:args.PATIENTID,PINCODE:args.PINCODE},ONFINISH:function(patientid){if(patientid){success=true;}
else{success=false;}},ASYNC:false});return success;}
