if(!isDefined(args.TABLE)){args.TABLE=GetParent(event.srcElement,'tagName','TABLE');}
if(jQuery(args.TABLE).attr("overflowtable")){var overflowtable=jQuery(args.TABLE);var uppercells=AddBlankColumn({TABLE:jQuery("table[name=UPPER]",overflowtable).get(0),SOURCEINDEX:args.SOURCEINDEX,TARGETINDEX:args.TARGETINDEX,INSERTBEFORE:args.INSERTBEFORE});var centercells=AddBlankColumn({TABLE:jQuery("table[name=CENTER]",overflowtable).get(0),SOURCEINDEX:args.SOURCEINDEX,TARGETINDEX:args.TARGETINDEX,INSERTBEFORE:args.INSERTBEFORE});return uppercells.concat(centercells);}
if(args.TABLE.rows.length==0){return[];}
