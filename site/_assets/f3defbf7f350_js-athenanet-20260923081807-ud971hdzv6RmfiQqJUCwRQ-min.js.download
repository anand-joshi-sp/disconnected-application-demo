function TogglePane(element,speed,togglelink,openhtml,closedhtml){var obj=jQuery(element);var toggleobj=jQuery(togglelink);if(!speed){speed="slow";}
if(obj){if(obj.is(":hidden")){obj.slideDown(speed,function(){if(isFunction(openhtml)){openhtml(toggleobj);}
else if(toggleobj&&isDefined(openhtml)){toggleobj.html(openhtml);}});}
else{obj.slideUp(speed,function(){if(isFunction(closedhtml)){closedhtml(toggleobj);}
else if(toggleobj&&isDefined(closedhtml)){toggleobj.html(closedhtml);}});}}
return false;}
