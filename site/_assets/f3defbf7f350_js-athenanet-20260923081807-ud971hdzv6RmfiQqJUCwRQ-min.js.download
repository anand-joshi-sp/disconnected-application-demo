else if(sectionname==='DiagnosisOrders'){sectionname='Diagnoses & Orders';}
return sectionname;}
function ValidatePrescriptionRefills(args){var fieldcheck=GetPrescriptionRefillsFieldCheck(args);if(fieldcheck!==undefined&&fieldcheck.FIELD.value!==''&&(parseInt(fieldcheck.FIELD.value,10)>fieldcheck.UPPERLIMIT||parseInt(fieldcheck.FIELD.value,10)<fieldcheck.LOWERLIMIT)){if(args.DEAVALUE===2){if(fieldcheck.FIELD.type!='hidden'){fieldcheck.FIELD.value=0;}}
alert(fieldcheck.DISPLAYMESSAGE);fieldcheck.FIELD.focus();return false;}
return true;}
function GetPrescriptionRefillsFieldCheck(args){var deavalue=args.DEAVALUE;var prefix=args.FIELDPREFIX||'';var suffix=args.FIELDSUFFIX||'';var drugname=args.DRUGNAME;var skiphidden=args.SKIPHIDDEN;var refillsfieldname=prefix+'NUMBERREFILLSALLOWED'+suffix;var refillsfieldjq;var refillsfield;var norefillsmessage="Refills cannot be specified for Schedule II prescriptions";var deastring='';var upperlimit=5;var upperlimitmessage='';if(supportedCompoundDEAScheduleMap[deavalue]){refillsfieldjq=jQuery("#"+EscapeJQuerySelector(refillsfieldname));refillsfield=refillsfieldjq.get(0);if(skiphidden&&!refillsfieldjq.is(':visible')){return undefined;}
if(deavalue===2){if(drugname){norefillsmessage+="; refills must be removed from "+drugname+" before it can be approved";}
norefillsmessage+='.';return{FIELD:refillsfield,DISPLAYMESSAGE:norefillsmessage,TYPE:'NUMERICRANGE',LOWERLIMIT:0,UPPERLIMIT:0,RESETFIELD:true};}
else if(deavalue===3||deavalue===4){deastring='III';if(deavalue===4){deastring='IV';}
upperlimitmessage="The maximum number of refills for Schedule "+deastring+" drugs is "+upperlimit;if(drugname){upperlimitmessage+="; refills must be updated for "+drugname+" before it can be approved";}
upperlimitmessage+='.';return{FIELD:refillsfield,DISPLAYMESSAGE:upperlimitmessage,TYPE:'NUMERICRANGE',LOWERLIMIT:0,UPPERLIMIT:upperlimit};}}
return undefined;}
function ValidatePrescriptionFields(orderdiv,fieldprefix,fieldsuffix,ordersignoff){var jqorderdiv=jQuery(orderdiv);var documentclass=jQuery(EscapeJQuerySelector('#'+fieldprefix+'DOCUMENTCLASS'+fieldsuffix)).val();if(documentclass&&!InList(documentclass,['PRESCRIPTION','VACCINE'])){return true;}
var prescriptiontypes=jQuery(EscapeJQuerySelector('#'+fieldprefix+'TYPEDETAILS'+fieldsuffix)).find('input').toArray();if(prescriptiontypes.length===0){return true;}
if(!ValidateCommonOrderFields(orderdiv,fieldprefix,fieldsuffix,ordersignoff)){return false;}
var ordertype=jqorderdiv.attr('documentid')?'ORDER':'NEWORDER';var orderid=jqorderdiv.attr('documentid')?jqorderdiv.attr('documentid'):jqorderdiv.attr('neworderid');if(!jqorderdiv.attr('signoffpermission')){ordersignoff=false;}
var prescriptiontype=radioValue(prescriptiontypes);var quantityprefix=prescriptiontype=='ORDER'?'':prescriptiontype;var prescriptionquantityrequiredyn=jQuery(EscapeJQuerySelector('#'+fieldprefix+'PRESCRIPTIONQUANTITYREQUIREDYN'+fieldsuffix)).val();var quantityrequired=(ordersignoff&&(documentclass!='PRESCRIPTION'||(documentclass=='PRESCRIPTION'&&!(quantityprefix==''&&prescriptionquantityrequiredyn=='N'))));var quantityfield=document.getElementsByName(fieldprefix+quantityprefix+'QUANTITY'+fieldsuffix)[0];var fieldchecks=[];if(quantityfield){fieldchecks.push({FIELD:quantityfield,DISPLAYNAME:(quantityprefix?quantityprefix==='SAMPLE'?'dispense ':quantityprefix.toLowerCase()+' ':'')+'quantity',TYPE:'POSITIVE',REQUIRED:quantityrequired});}
var deavalue;try{deavalue=jQuery('span#deavalue',orderdiv).first().attr('deavalue');deavalue=parseInt(deavalue,10);var fieldcheck=GetPrescriptionRefillsFieldCheck({DEAVALUE:deavalue,FIELDPREFIX:fieldprefix,FIELDSUFFIX:fieldsuffix});if(fieldcheck!==undefined){fieldchecks.push(fieldcheck);}}
catch(e){}
var quantityunitsname=fieldprefix+quantityprefix+'NDC'+fieldsuffix;var quantityunitsjq=jQuery(EscapeJQuerySelector("[name='"+quantityunitsname+"']"));var sectioncontainerjq=quantityunitsjq.closest("#SECTIONCONTAINER");var sectioncontainervisible=sectioncontainerjq.is(':visible');if(quantityfield.value&&quantityunitsjq.attr('type')&&quantityunitsjq.attr('type').toLowerCase()!='hidden'&&(sectioncontainervisible||quantityrequired)){var displaymessage='Please specify units for this '+(quantityprefix?quantityprefix==='SAMPLE'?'dispense ':quantityprefix.toLowerCase()+' ':'')+'quantity.';if(!sectioncontainervisible&&quantityrequired){displaymessage=('An order in this encounter is missing '+(quantityprefix?quantityprefix.toLowerCase()+' ':'')
+'quantity units. Please edit this order in the '
+GetSectionName(sectioncontainerjq)
+' section.');}
fieldchecks.push({FIELD:quantityunitsjq.get(0),DISPLAYMESSAGE:displaymessage,REQUIRED:true});}
if(quantityunitsjq.attr('type').toLowerCase()=='text'&&quantityunitsjq.get(0).value&&!isNaN(quantityunitsjq.get(0).value)){Focus(ordertype,orderid,orderdiv);quantityunitsjq.get(0).focus();alert('Please specify non-numerical units for this quantity.');return false;}
var showingstructuredsig=jQuery(EscapeJQuerySelector('#'+fieldprefix+'STRUCTUREDSIG'+fieldsuffix)).get(0);var unstructuredsigfield=jQuery(EscapeJQuerySelector('#'+fieldprefix+'SIG'+fieldsuffix)).get(0);if(showingstructuredsig&&showingstructuredsig.value==1){var dosagequantity=jQuery(EscapeJQuerySelector('#'+fieldprefix+'DOSAGEQUANTITY'+fieldsuffix)).get(0);if(dosagequantity){var durationfield=jQuery(EscapeJQuerySelector('#'+fieldprefix+'DURATION'+fieldsuffix)).get(0);var dosagequantityrequired=prescriptiontype=='ORDER'?ordersignoff:false;var dosagequantityunitsjq=jQuery(EscapeJQuerySelector('#'+fieldprefix+'DISPLAYDOSAGEUNITS'+fieldsuffix));var sectionjq=dosagequantityunitsjq.closest("#SECTIONCONTAINER");var sectionvisible=sectionjq.is(':visible');var dosagedisplaymessage='Please specify the units for this dosage quantity.';if(!sectionvisible&&ordersignoff){dosagedisplaymessage='An order in this encounter is missing dosage quantity units. Please edit this order in the '+GetSectionName(sectionjq)+' section.';}
fieldchecks.push({FIELD:dosagequantity,DISPLAYNAME:'Dosage quantity',TYPE:'NONNEGATIVE',REQUIRED:dosagequantityrequired},{FIELD:durationfield,DISPLAYNAME:'Duration',TYPE:'POSITIVE'},{FIELD:dosagequantityunitsjq.get(0),DISPLAYMESSAGE:dosagedisplaymessage,REQUIRED:dosagequantity.value&&(sectionvisible||ordersignoff)});}}
else{if(unstructuredsigfield){var sigrequired=prescriptiontype=='ORDER'?ordersignoff:false;if(sigrequired)
{fieldchecks.push({FIELD:unstructuredsigfield,DISPLAYNAME:'Sig details',REQUIRED:true});}}}
if(IsCompoundMed(jqorderdiv.attr('ordertypeid'))){var compoundIsControlledField=jQuery(EscapeJQuerySelector('#'+fieldprefix+'COMPOUNDISCONTROLLED'+fieldsuffix)).get(0);var compoundDEAScheduleField=jQuery(EscapeJQuerySelector('#'+fieldprefix+'COMPOUNDDEASCHEDULE'+fieldsuffix)).get(0);if(compoundIsControlledField&&compoundIsControlledField.checked&&compoundDEAScheduleField&&(compoundDEAScheduleField.value==0||compoundDEAScheduleField.value=='')){compoundDEAScheduleField.value='';fieldchecks.push({FIELD:compoundDEAScheduleField,DISPLAYMESSAGE:'Formulation Schedule is required.',REQUIRED:true});}}
if(prescriptiontype=='ORDER'){var regex=new RegExp('^[0-9]*\$');var refills=refills||document.getElementsByName(fieldprefix+'NUMBERREFILLSALLOWED'+fieldsuffix)[0];if(!refills.value){refills.value=0;}
else if(!regex.test(refills.value)){alert('Refills must be a whole number between 0 and 99.');refills.focus();return false;}}
if(prescriptiontype=='SAMPLE'||prescriptiontype=='ORDER'){var administermanufacturer=document.getElementsByName(fieldprefix+'ADMINISTERMANUFACTURER'+fieldsuffix)[0];if(administermanufacturer){administermanufacturer.value='';}}
if(prescriptiontype=='ADMINISTER'){var performencounterdate=document.getElementsByName(fieldprefix+'PERFORMENCOUNTERID'+fieldsuffix)[0];if(performencounterdate&&performencounterdate.value=='Other'){var performencounterotherdate=document.getElementsByName(fieldprefix+'PERFORMENCOUNTERIDASDATE'+fieldsuffix)[0];fieldchecks.push({FIELD:performencounterotherdate,DISPLAYNAME:'Perform Date',TYPE:'NONNULL'});}
var manufacturer=document.getElementsByName(fieldprefix+'ADMINISTERMANUFACTURER'+fieldsuffix)[0];if(manufacturer&&!manufacturer.getAttribute('PENDING')&&/InvalidInput/.test(manufacturer.className)){alert('Please enter a valid manufacturer');try{manufacturer.focus();}catch(e){}
return false;}}
if(ordersignoff){if(prescriptiontype=='ORDER'){var notifier=jQuery(EscapeJQuerySelector('input[name="'+fieldprefix+'NOTIFIER'+fieldsuffix+'"]:enabled')).get(0);var documentationonly=document.getElementsByName(fieldprefix+'FORDOCUMENTATIONONLY'+fieldsuffix)[0];if(notifier&&notifier.value=='ATHENA'&&!documentationonly.checked){var $clinicalprovider=jQuery(EscapeJQuerySelector('#'+fieldprefix+'CLINICALPROVIDERID'+fieldsuffix));var $epcsdata=jQuery(EscapeJQuerySelector('#'+fieldprefix+'EPCS'+fieldsuffix));if(!$epcsdata.data('providercansignepcs')&&supportedCompoundDEAScheduleMap[deavalue]){Focus(ordertype,orderid,orderdiv);ToggleRxHideFields(1);alert('You cannot submit this order electronically. You '+
'are either not enrolled in EPCS or are missing a '+
'DEA, NPI, or SPI number in the department '+
'associated with this order. To submit this order, '+
'you must change the Submitter field to something '+
'other than ATHENA.');return false;}
if(!$clinicalprovider.val()){Focus(ordertype,orderid,orderdiv);ToggleRxHideFields(1);alert('Please enter a pharmacy if submitting by ATHENA.');return false;}
if($epcsdata.data('providercansignepcs')&&supportedCompoundDEAScheduleMap[deavalue]){if($epcsdata.data('prescriptionprinted')){Focus(ordertype,orderid,orderdiv);ToggleRxHideFields(1);alert('Cannot submit controlled substance prescription via '
+'ATHENA since it was already printed. Please change '
+'the submitter.');return false;}
if(!$epcsdata.data('pharmacysupportsepcs')){Focus(ordertype,orderid,orderdiv);ToggleRxHideFields(1);alert('The selected pharmacy cannot receive '+
'prescriptions for controlled substances '+
'electronically. To submit this order, change '+
'the pharmacy or change the Submitter to '+
'something other than ATHENA.');return false;}}}
if(!documentationonly.checked&&!ValidatePrescriptionApprovalNoteToPharmacy({FIELDPREFIX:fieldprefix,FIELDSUFFIX:fieldsuffix})){return false;}}
if(IsCompoundMed(jqorderdiv.attr('ordertypeid'))){var alertmsg='Drug Formulation is required.';var compoundedfield=jQuery(jqorderdiv).find('#'+EscapeJQuerySelector(fieldprefix+'COMPOUNDNAME'+fieldsuffix));if(compoundedfield&&compoundedfield.val()==''){Focus(ordertype,orderid,orderdiv);alert(alertmsg);compoundedfield.focus();return false;}}}
for(var i=0;i<fieldchecks.length;i++){var validateargs=fieldchecks[i];var resetfield=validateargs.RESETFIELD;delete validateargs.RESETFIELD;validateargs.SECTION=orderdiv;validateargs.BEFOREALERT=function(){Focus(ordertype,orderid,orderdiv)};if(typeof validateargs.FIELD=='string'){validateargs.FIELD=fieldprefix+validateargs.FIELD+fieldsuffix;}
if(!ValidateField(validateargs)){if(resetfield){validateargs.FIELD.value=0;}
return false;}}
return true;}
function ValidatePrescriptionApprovalNoteToPharmacy(args){AssertFields(args,[],['FIELDPREFIX','FIELDSUFFIX']);var fieldid,notetopharmacyjq,fieldprefix='',fieldsuffix='';if(args){fieldprefix=args.FIELDPREFIX||'';fieldsuffix=args.FIELDSUFFIX||'';}
fieldid=fieldprefix+'NOTEFORPHARMACYFROMPRESCRIBER'+fieldsuffix;notetopharmacyjq=jQuery(EscapeJQuerySelector('#'+fieldid));if(notetopharmacyjq.length&&notetopharmacyjq.hasClass('RequireMedicalNecessity')&&(jQuery.trim(notetopharmacyjq.val()).length===0)){alert('You must enter a description of medical necessity into the Note to Pharmacy field before submitting this order.');notetopharmacyjq.focus();return false;}
return true;}
function ValidateRefusedVaccineFields(orderdiv,fieldprefix,fieldsuffix,ordersignoff){var jqorderdiv=jQuery(orderdiv);var jqrefusednote=jQuery(EscapeJQuerySelector("textarea[name='"+fieldprefix+'REFUSEDNOTE'+fieldsuffix+"']"),orderdiv);var jqrefusedreason=jQuery(EscapeJQuerySelector("[name='"+fieldprefix+'REFUSEDREASON'+fieldsuffix+"']"),orderdiv);var jqrefuseddate=jQuery(EscapeJQuerySelector("input[name='"+fieldprefix+'REFUSEDDATE'+fieldsuffix+"']"),orderdiv);if(jQuery.trim(jqrefuseddate.val())==''){alert("Please enter a declined date");FocusOrder({ORDERDIV:orderdiv});jqrefuseddate.focus();return false;}
if(jqrefusedreason.val()==''){alert("Please enter a declined reason");FocusOrder({ORDERDIV:orderdiv});jqrefusedreason.focus();return false;}
if(jqrefusednote.hasClass('RequiredField')&&jQuery.trim(jqrefusednote.val())==''){alert("Declined note must have a value when a declined reason is 'Other'");FocusOrder({ORDERDIV:orderdiv});jqrefusednote.focus();return false;}
return true;}
function ValidateVaccineFields(orderdiv,fieldprefix,fieldsuffix,ordersignoff){var fieldchecks=[];var jqorderdiv=jQuery(orderdiv);var ordertype=jqorderdiv.attr('documentid')?'ORDER':'NEWORDER';var orderid=jqorderdiv.attr('documentid')?jqorderdiv.attr('documentid'):jqorderdiv.attr('neworderid');if(!jqorderdiv.attr('signoffpermission')){ordersignoff=false;}
var administer=radioValue(jQuery(EscapeJQuerySelector("input[name='"+fieldprefix+'TYPE'+fieldsuffix+"']"),orderdiv).toArray())=='ADMINISTER';if(administer){if(OnOrderSetAdminPage()){var quantity=document.getElementsByName(fieldprefix+'ADMINISTERQUANTITY'+fieldsuffix)[0];var quantityUnits=document.getElementsByName(fieldprefix+'ADMINISTERNDC'+fieldsuffix)[0];if(isDefined(quantity)&&isDefined(quantityUnits)){if(quantity.value&&!ValidateField({FIELD:quantityUnits,DISPLAYMESSAGE:'Please specify units for this quantity.',REQUIRED:true,SECTION:orderdiv,BEFOREALERT:function(){Focus(ordertype,orderid,orderdiv)}})){return false;}}}}
var manufacturer=jQuery(EscapeJQuerySelector("input[name='"+fieldprefix+'MVX'+fieldsuffix+"']"),orderdiv).get(0);if(administer){if(isDefined(manufacturer)&&!jQuery(manufacturer).attr('PENDING')&&/InvalidInput/.test(manufacturer.className)){alert('Please enter a valid manufacturer');try{manufacturer.focus();}catch(e){}
return false;}}
else{manufacturer.value='';}
var performencounterdate=jQuery(EscapeJQuerySelector("select[name='"+fieldprefix+'PERFORMENCOUNTERID'+fieldsuffix+"']"),orderdiv).get(0);if(performencounterdate&&performencounterdate.value=='Other'){if(!ValidateField({FIELD:fieldprefix+'PERFORMENCOUNTERIDASDATE'+fieldsuffix,DISPLAYNAME:'Perform Date',TYPE:'NONNULL',SECTION:orderdiv,BEFOREALERT:function(){Focus(ordertype,orderid,orderdiv)}})){return false;}}
return true;}
function DelayWhileManufacturerValidationPending(alldiagnosisorders,submitFunction){if(!isDefined(submitFunction)){submitFunction=function(){if(CheckForm()){document.zform.SUBMITVALUE.click();}}}
var anchorfields=jQuery(EscapeJQuerySelector("select[name*='{CLINICALVACCINESITEID}']"),alldiagnosisorders);for(var i=0;i<anchorfields.length;i++){var fieldname=anchorfields[i].name;var modifiers=fieldname.split(/CLINICALVACCINESITEID/);if(modifiers){var manufacturer=jQuery(EscapeJQuerySelector("[name='"+modifiers[0]+'MVX'+modifiers[1]+"']")).get(0);if(isDefined(manufacturer)&&manufacturer.getAttribute('PENDING')){window.setTimeout(submitFunction,500);return true;}}}
var anchorfields=jQuery(EscapeJQuerySelector("select[name*='{SUBSTITUTE}']"),alldiagnosisorders);for(var i=0;i<anchorfields.length;i++){var fieldname=anchorfields[i].name;var modifiers=fieldname.split(/SUBSTITUTE/);if(modifiers){var manufacturer=jQuery(EscapeJQuerySelector("[name='"+modifiers[0]+'ADMINISTERMANUFACTURER'+modifiers[1]+"']")).get(0);if(isDefined(manufacturer)&&manufacturer.PENDING){window.setTimeout(submitFunction,500);return true;}}}
return false;}
var ValidateOrderForClass={};ValidateOrderForClass.DME=function(orderdiv,modifiers,ordersignoff){if(!modifiers){return true;}
var signed=orderdiv.getAttribute('signed');if(signed&&signed!=='0'){var reopened=document.getElementsByName(modifiers[0]+'REOPEN'+modifiers[1])[0];if(!reopened){return true;}}
if(!ValidateCommonOrderFields(orderdiv,modifiers[0],modifiers[1],ordersignoff)){return false;}
var orderdivjq=jQuery(orderdiv);var orderdivdocumentid=orderdivjq.attr('documentid');var ordertype=orderdivdocumentid?'ORDER':'NEWORDER';var orderid=orderdivdocumentid?orderdivdocumentid:orderdivjq.attr('neworderid');var MyValidate=function(fieldname,displayname,type){var field=document.getElementsByName(modifiers[0]+fieldname+modifiers[1])[0];if(orderdiv.getAttribute('signoffpermission')&&ordersignoff){return ValidateField({FIELD:field,DISPLAYNAME:displayname,TYPE:type,SECTION:orderdiv,REQUIRED:true,BEFOREALERT:function(){Focus(ordertype,orderid,orderdiv)}});}
else{return true;}}
var actiontypefield=jQuery(EscapeJQuerySelector('#'+modifiers[0]+'TYPEDETAILS'+modifiers[1])).find('input').toArray();if(actiontypefield&&radioValue(actiontypefield)=='SAMPLE'){if(!MyValidate('SAMPLEQUANTITY','Quantity','POSITIVE')){return false;}}
else{if(!MyValidate('QUANTITY','Quantity','POSITIVE')){return false;}
if(!MyValidate('NUMBERREFILLSALLOWED','Refills','NONNEGATIVE')){return false;}
var notifierfield=document.getElementsByName(modifiers[0]+'NOTIFIER'+modifiers[1])[0];var documentationonly=document.getElementsByName(modifiers[0]+'FORDOCUMENTATIONONLY'+modifiers[1])[0];if(notifierfield&&InList(notifierfield.value,['ATHENA','ATHENAFAX'])&&documentationonly&&!documentationonly.checked&&!MyValidate('CLINICALPROVIDERID','Supplier','NONNULL')){return false;}}
return true;}
ValidateOrderForClass.VACCINE=function(orderdiv,modifiers,ordersignoff){if(!modifiers){return true;}
switch(radioValue(jQuery('input[type="radio"][name*="{TYPE}"]',orderdiv))){case"ADMINISTER":if(!ValidateVaccineFields(orderdiv,modifiers[0],modifiers[1],ordersignoff))return false;break;case"ORDER":if(!ValidatePrescriptionFields(orderdiv,modifiers[0],modifiers[1],ordersignoff))return false;break;case"REFUSED":if(!ValidateRefusedVaccineFields(orderdiv,modifiers[0],modifiers[1],ordersignoff))return false;break;}
return true;}
ValidateOrderForClass.ORDER=function(orderdiv,modifiers,ordersignoff){if(!ValidateOrderFields(orderdiv,modifiers[0],modifiers[1],ordersignoff))return false;if(!ValidateStandingOrderFields(orderdiv,true))return false;return true;}
ValidateOrderForClass.PRESCRIPTION=function(orderdiv,modifiers,ordersignoff){var authorizewidget;if(!ValidatePrescriptionFields(orderdiv,modifiers[0],modifiers[1],ordersignoff)){return false;}
authorizewidget=EPCS_AuthorizeDialog_Document.FindWidget();if((!authorizewidget||!authorizewidget.IsAuthorized())&&!ValidatePrescriptionDoseChecks({FIELDPREFIX:modifiers[0],FIELDSUFFIX:modifiers[1]})){var orderid;var ordertype;if(orderdiv.getAttribute('documentid')){orderid=orderdiv.getAttribute('documentid');ordertype='ORDER';}
else{orderid=orderdiv.getAttribute('neworderid');ordertype='NEWORDER';}
Focus(ordertype,orderid,orderdiv);try{jQuery('input[id='+EscapeJQuerySelector(modifiers[0]+'DOSAGEQUANTITY'+modifiers[1])+']',orderdiv).focus();}
catch(e){}
return false;}
return true;}
function WarnAllPrescriptionsCosigned(allprescriptiondivs){if(!allprescriptiondivs||!allprescriptiondivs.length){return;}
var allcosignatures=allprescriptiondivs.find('div[id=DoubleSignOff]:visible span[id=cosignature1by]');var cosignedbythisuser=allcosignatures.filter(function(index){return this.innerText==AH.GetGlobal('USERNAME');});if(cosignedbythisuser.length==allprescriptiondivs.length){if(cosignedbythisuser.length==1){alert("This medication requires a secondary sign-off before it can be submitted.\r\n\r\nYou have already signed this order. A secondary signature by another authorized user is required.");}
else{alert("These medications require a secondary sign-off before they can be submitted.\r\n\r\nYou have already signed these orders. A secondary signature by another authorized user is required.");}}}
function CheckUnansweredQuestions(allorderdivs){if(!allorderdivs||!allorderdivs.length){return;}
var jqmissedquestion;var jqbadorderdiv;var badordertypes=[];var badordertypesIncludesLabOrImaging=false;for(var i=0;i<allorderdivs.length;i++){var orderdiv=allorderdivs[i];var jqorderdiv=jQuery(orderdiv);var modifiers=orderdiv.id.split(/ORDERDIV/);var fieldprefix=modifiers[0]||'';var fieldsuffix=modifiers[1]||'';var questiontable=document.getElementById(fieldprefix+'CLINICALORDERQUESTIONS'+fieldsuffix);var jqquestiontable=jQuery(questiontable);var jqrequiredfields=[];jqquestiontable.find('input.RequiredField').each(function(){jqrequiredfields.push(jQuery(this));});jqquestiontable.find('select.RequiredField').each(function(){jqrequiredfields.push(jQuery(this));});var orderisbad=0;for(var j=0;j<jqrequiredfields.length;j++){var jqfield=jqrequiredfields[j];if(jqfield.val()==''){orderisbad=1;if(!jqbadorderdiv){jqbadorderdiv=jqorderdiv;if(!jqmissedquestion){jqmissedquestion=jqfield;}}
break;}}
if(orderisbad){var ordername=document.getElementById(fieldprefix+'ORDERDIV}{NAME'+fieldsuffix);badordertypes.push(ordername.getAttribute('displayname'));var ordertypegroup=orderdiv.getAttribute("validationclass");if(ordertypegroup==='LAB'||ordertypegroup==='IMAGING'){badordertypesIncludesLabOrImaging=true;}}}
var leaveunanswered=1;if(jqmissedquestion){var aoesforsignoff=jQuery("#SUBSECTIONS_AP_SIGNOFF").data("aoesforsignoff");var requiredforsignoff=aoesforsignoff||!badordertypesIncludesLabOrImaging;var message;if(requiredforsignoff){message='The following orders have required questions from the receiving facility that you must answer before submitting.\n';}
else{message='The following orders have required questions from the receiving facility that you must answer before submitting. If you do not answer these questions now, these orders will remain in your staff bucket for review.\n';}
for(var j=0;j<badordertypes.length;j++){message+=' - '+badordertypes[j]+'\n';}
if(requiredforsignoff){alert(message);leaveunanswered=0;jqbadorderdiv.click();jqmissedquestion.focus();}
else{if(!confirm(message)){leaveunanswered=0;jqbadorderdiv.click();jqmissedquestion.focus();}}}
return leaveunanswered;}
function DiagnosisOrdersOrderFormCheckForm(section){var jqalldiagnosisorders=section?jQuery('#ALLDIAGNOSISORDERS'):undefined;if(!jqalldiagnosisorders||!jqalldiagnosisorders.length){return false;}
var ordersignoffjq=jQuery('#ORDERSSIGNOFF');var ordersignoff=ordersignoffjq.prop('checked');var allorderdivs=jqalldiagnosisorders.children('[name="DIAGNOSIS"]').children('[name="DIAGNOSIS_ORDERS"]').children('[name="ORDERDIV"][validationclass]');for(var i=0;i<allorderdivs.length;i++){var orderdiv=allorderdivs[i];var modifiers=orderdiv.id.split(/ORDERDIV/);var validator=ValidateOrderForClass[orderdiv.getAttribute("validationclass")];if(modifiers&&validator&&!validator(orderdiv,modifiers,ordersignoff)){return false;}}
if(ordersignoff){if(!CheckUnansweredQuestions(allorderdivs)){return false;}}
WarnAllPrescriptionsCosigned(allorderdivs.filter('[validationclass="PRESCRIPTION"]'));var authorizewidget=EPCS_AuthorizeDialog_Encounter.FindWidget();if(authorizewidget&&ordersignoff){authorizewidget.PreSave();}
return true;}
function ValidateStandingOrderFields(order,diagnosisorder){var fieldprefix='';var fieldsuffix='';if(diagnosisorder){fieldprefix=order.id.replace('ORDERDIV}','');fieldsuffix='}';}
var standingon=document.getElementById('checkbox_yesno_'+fieldprefix+'STANDINGORDERYN'+fieldsuffix);if(standingon&&standingon.checked){var frequencyselect=document.getElementById(fieldprefix+'STANDINGFREQUENCYSELECT'+fieldsuffix);var frequencynumber,frequencyunit;if(frequencyselect.value===''){alert('Please select a frequency for all Standing Orders');if(diagnosisorder){jQuery(order).click();}
jQuery(frequencyselect).focus();return false;}
if(frequencyselect.value==='Other'){var frequencynumeral=document.getElementById(fieldprefix+'STANDINGFREQUENCYNUMERAL'+fieldsuffix);frequencynumber=frequencynumeral.value;if(frequencynumber==''||frequencynumber<1||!(frequencynumber.match(new RegExp('^[0-9]+\$')))){alert('Please select an integer numeric frequency for all Standing Orders');if(diagnosisorder){jQuery(order).click();}
jQuery(frequencynumeral).focus();return false;}
frequencyunit=document.getElementById(fieldprefix+'STANDINGFREQUENCYUNITSELECT'+fieldsuffix).value;}
if(frequencynumber===undefined){var frequency=frequencyselect.value;if(isArray(frequency)){frequency=frequency[0];}
frequencyunit=frequency.slice(-1);frequencynumber=frequency.slice(0,-1);}
var durationselect=document.getElementById(fieldprefix+'STANDINGDURATIONSELECT'+fieldsuffix);var durationnumber,durationunit;if(durationselect.value==='Other'){var durationnumeral=document.getElementById(fieldprefix+'STANDINGDURATIONNUMERAL'+fieldsuffix);durationnumber=durationnumeral.value;if(durationnumber==''||durationnumber<1||!(durationnumber.match(new RegExp('^[0-9]+\$')))){alert('Please select an integer numeric duration for all Standing Orders');if(diagnosisorder){jQuery(order).click();}
jQuery(durationnumeral).focus();return false;}
durationunit=document.getElementById(fieldprefix+'STANDINGDURATIONUNITSELECT'+fieldsuffix).value;}
if(durationnumber===undefined){var duration=durationselect.value;if(isArray(duration)){duration=duration[0];}
durationunit=duration.slice(-1);durationnumber=duration.slice(0,-1);}
var nextorderdate=GetEndOfInterval(new Date(),frequencynumber,frequencyunit);var enddate=GetEndOfInterval(new Date(),durationnumber,durationunit);if(nextorderdate.getTime()>enddate.getTime()){alert('The duration of this standing order must be greater than the frequency.');if(diagnosisorder){jQuery(order).click();}
if(durationselect.value=='Other'){jQuery(durationnumeral).focus();}
else{jQuery(durationselect).focus();}
return false;}}
return true;}
var supportedCompoundDEAScheduleMap={'-1':true,2:true,3:true,4:true,5:true};function UpdateCompoundMedFields(clinicalordertypeid){if(IsCompoundMed(clinicalordertypeid)){if(clinicalordertypeid<0){var compoundfieldsrow=jQuery('tr#COMPOUNDFIELDS_ROW');var compoundiscontrolled=jQuery('#COMPOUNDISCONTROLLED');compoundfieldsrow.css('display','none');CallRemote({SUB:'Document::Class::PRESCRIPTION::GetCompoundMedValues',ARGS:{CLINICALORDERTYPEID:clinicalordertypeid},LOADINGINDICATORFLAG:1,ONFINISH:function(compoundvalues){jQuery('#COMPOUNDNAME').val(compoundvalues.FORMULATION).prop('readOnly',true).addClass('readonly');jQuery('#COMPOUNDDEASCHEDULE').val(compoundvalues.COMPOUNDDEASCHEDULE);if(supportedCompoundDEAScheduleMap[compoundvalues.COMPOUNDDEASCHEDULE]){compoundiscontrolled.prop('checked',true);jQuery('select[name=COMPOUNDDEASCHEDULE]').val(compoundvalues.COMPOUNDDEASCHEDULE);jQuery('tr[id="COMPOUNDSCHEDULE_ROW"]').toggle(true);}
else{compoundiscontrolled.prop('checked',false);jQuery('select[name=COMPOUNDDEASCHEDULE]').val(0);jQuery('tr[id="COMPOUNDSCHEDULE_ROW"]').toggle(false);}
compoundiscontrolled.prop('disabled',false);compoundfieldsrow.show();}});}
else{jQuery('#COMPOUNDNAME').val('').prop('readOnly',false).removeClass('readonly');jQuery('#COMPOUNDDEASCHEDULE').val('');jQuery('#COMPOUNDISCONTROLLED').prop('checked',false).prop('disabled',false);jQuery('tr#COMPOUNDFIELDS_ROW').show();jQuery('select[name=COMPOUNDDEASCHEDULE]').val('');jQuery('tr[id="COMPOUNDSCHEDULE_ROW"]').toggle(false);}}
else{jQuery('tr#COMPOUNDFIELDS_ROW').hide();jQuery('#COMPOUNDNAME').val('').prop('readOnly',false).removeClass('readonly');jQuery('#COMPOUNDDEASCHEDULE').val('');jQuery('#COMPOUNDISCONTROLLED').prop('checked',false);jQuery('select[name=COMPOUNDDEASCHEDULE]').val('');jQuery('tr[id="COMPOUNDSCHEDULE_ROW"]').toggle(false);}}
