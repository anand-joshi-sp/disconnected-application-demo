var headerrow=jQuery("th",tableobject).parent("tr").filter(":first");var headerheight=headerrow.outerHeight();var headerrowposition=FindPosition(headerrow.get(0));var scrollfrom=scrolltopelement.scrollTop()-(headerrowposition.top+headerheight)>0;var scrolltill=scrolltopelement.scrollTop()<tableobject.outerHeight()+headerrowposition.top-(headerheight*2);var newheadertable=jQuery("#movingheader_"+tableid);if(scrollfrom&&scrolltill){if(!newheadertable.length){divcontainer.html("<table id=movingheader_"+tableid+"><tr>"+headerrow.html()+"</tr></table>");newheadertable=divcontainer.children(":first");newheadertable.addClass(tableobject.attr("class"));newheadertable.width(headerrow.outerWidth()+(parseInt(newheadertable.css('border-right-width'))+parseInt(newheadertable.css('border-left-width')))/2);divcontainer.show();headerrow.children().each(function(cellnum){var cell=jQuery("tr:first",newheadertable).children(":nth-child("+(cellnum+1)+")");var padding=0;var properties="padding-left padding-right".split(" ");for(var i=0;i<properties.length;i++){var new_padding=jQuery(cell).css(properties[i]);if(isDefined(new_padding)){new_padding=new_padding.replace("px","")*1;padding+=new_padding;}}
if(cell.css('box-sizing')=='border-box'&&(jQuery(document.documentElement).hasClass('standards')||jQuery(document.documentElement).hasClass('safari'))){cell.width(jQuery(this).outerWidth());}
else{cell.width(jQuery(this).get(0).clientWidth-padding);}
var checkbox=cell.children(":checkbox");if(checkbox.is(":checkbox")){var checkvalue=headerrow.children(":nth-child("+(cellnum+1)+")").children(":checkbox").attr('checked');checkbox.attr('checked',checkvalue);}});}
divcontainer.css("left",headerrowposition.left-offset);divcontainer.css("top",scrolltopelement.scrollTop());return true;}
newheadertable.remove();}
divcontainer.hide();}
function SignOffUncheck(startingobject){var container=GetSectionContainer(startingobject);if(startingobject.checked){var allcheckboxes;if(startingobject.name=='REVIEWENCOUNTER'||startingobject.name=='UPDATERENDERINGPROVIDER'){allcheckboxes=new Array('CLOSEENCOUNTER','DELETEENCOUNTER');}
else{allcheckboxes=new Array('CLOSEENCOUNTER','REVIEWENCOUNTER','UPDATERENDERINGPROVIDER','DELETEENCOUNTER');}
UncheckBoxes(allcheckboxes,startingobject);}}
function EncounterAlert(msg,field){UncheckBoxes(['CLOSEENCOUNTER','DELETEENCOUNTER']);alert(msg);setTimeout(function(){try{field.focus();}catch(error){}},100);}
function UncheckBoxes(checkboxes,startingobject){for(var i=0;i<checkboxes.length;i++){var checkbox=jQuery('#'+checkboxes[i]).get(0);if(checkbox&&checkbox!=startingobject){checkbox.checked=false;}}}
function ToggleDirtyOrderSignOff(closeencountercheckbox){DelayForSectionLoad(function(){var ordersignoffcheckbox=document.all('ORDERSSIGNOFF');if(ordersignoffcheckbox){ordersignoffcheckbox.checked=closeencountercheckbox.checked;if(closeencountercheckbox.checked){DirtySection(ordersignoffcheckbox);}
else{EncounterClean(GetSectionContainer(ordersignoffcheckbox));}}});}
function ToggleDeleteNotes(startingobject){var container=GetSectionContainer(startingobject);var deletenotes=jQuery(container).find('table#delete_notes').get(0);if(deletenotes&&startingobject.checked){deletenotes.style.visibility='visible';}
else{deletenotes.style.visibility='hidden';}}
function ToggleScribedBy(startingobject){var fieldscribedby=jQuery('#SCRIBEDBY').get(0);var spanscribedby=fieldscribedby.parentNode;if(fieldscribedby.selectedIndex!=-1){fieldscribedby.lastSelectedIndex=fieldscribedby.selectedIndex;}
if(fieldscribedby&&spanscribedby){if(startingobject.checked){spanscribedby.style.display='inline';fieldscribedby.selectedIndex=fieldscribedby.lastSelectedIndex;}
else{spanscribedby.style.display='none';fieldscribedby.selectedIndex=-1;}}}
function ConfirmDeleteEncounter(startingobject){if(startingobject.checked){var message="Approved letters associated with this encounter may need to be manually deleted.";var args="QUESTION="+message+"&b1=OK&b2=Cancel";SmallModalPopupWindow({page:AH.PrependBasePath('/help/choice.esp?'+args+'&NEWMODAL=1'),title:'Delete Encounter',onclose:function(response){if(response==1){SignOffUncheck(startingobject);}
else{startingobject.checked=false;}
ToggleDeleteNotes(startingobject);}});}
else{ToggleDeleteNotes(startingobject);}}
function SubmitAndSchedule(field,encounterid){var container=GetSectionContainer(field);var rescheduleperformencounterid=jQuery(container).find('#RESCHEDULEPERFORMENCOUNTERID').get(0);if(rescheduleperformencounterid){rescheduleperformencounterid.value=encounterid;ChangeAllPerformEncounterIDs(rescheduleperformencounterid);}
jQuery(container).find('#GOTOSCHEDULE').get(0).value=1;SaveTab();}
function ChangeAllPerformEncounterIDs(field){var performencounterid=field.value;var container=GetSectionContainer(field);var performencounters=jQuery(container).find('#PERFORMENCOUNTERID,[name="PERFORMENCOUNTERID"]').get();if(performencounters.value){performencounters.value=performencounterid;}else{for(var i=0;i<performencounters.length;i++){performencounters[i].value=performencounterid;}}}
