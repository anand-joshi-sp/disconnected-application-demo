var celldiv=rowdivs[i][rowindex].get(c);colspans[i][rowindex][c]=jQuery(rowcells[c]).attr("colSpan")||1;if((rowindex===0)&&(colspans[i][rowindex][c]==1)){maxwidth[colindex]=Math.max(maxwidth[colindex],jQuery(celldiv).outerWidth());}
colindex+=colspans[i][rowindex][c];};});}
for(var i=0;i<2;i++){subtablerows[i][j].each(function(rowindex,row){var colindex=0;var numcells=rowdivs[i][rowindex].length;for(var c=0;c<numcells;c++){var celldiv=rowdivs[i][rowindex].get(c);var celltextarea=rowtextareas[i][rowindex];if(colspans[i][rowindex][c]==1){jQuery(celldiv).width(maxwidth[colindex]);if(celltextarea.length==1){jQuery(celltextarea).width('100%');}}
colindex+=colspans[i][rowindex][c];}});}}
for(var i=0;i<2;i++){var maxheight=[];for(var j=0;j<3;j++){subtablerows[i][j].each(function(rowindex,row){if(j==0)maxheight[rowindex]=0;maxheight[rowindex]=Math.max(maxheight[rowindex],jQuery(row).outerHeight());});}
for(var j=0;j<3;j++){subtablerows[i][j].each(function(rowindex,row){jQuery(row).height(maxheight[rowindex]);});}}
var prevlastinput=jQuery();var bindindex;for(var i=0;i<2;i++){var numrows=subtablerows[i][1].length;for(var rowindex=0;rowindex<numrows;rowindex++){for(var j=0;j<3;j++){var row=subtablerows[i][j].get(rowindex);var inputs=jQuery("input, select, textarea",row).filter(':visible');inputs.unbind("keydown.overflowTableTabHandler");var firstinput=jQuery(inputs.get(0));var lastinput=jQuery(inputs.get(-1));if(prevlastinput.length&&firstinput.length){prevlastinput.bind('keydown.overflowTableTabHandler',{tabto:firstinput},function(e){var keycode=e.keyCode||e.which;if((keycode==9||keycode==13)&&!e.shiftKey){e.preventDefault();e.data.tabto.focus();}});firstinput.bind('keydown.overflowTableTabHandler',{tabto:prevlastinput},function(e){var keycode=e.keyCode||e.which;if((keycode==9||keycode==13)&&e.shiftKey){e.preventDefault();e.data.tabto.focus();}});}
if(lastinput.length){prevlastinput=lastinput;}}}}
maintable.attr("overflowresized",1);jQuery(window).resize(function(){RestartTimer(function(){ReflowOverflowTable(maintable)},500,"#"+EscapeJQuerySelector(maintable.attr("id")));});ReflowOverflowTable(maintable);}
function ReflowOverflowTable(table){var maintable=jQuery(table);if(!maintable.attr("overflowtable")||!maintable.attr("overflowresized")){return;}
var subdiv=[];subdiv[0]=[];subdiv[0][0]=jQuery("div[name='UL']",maintable);subdiv[0][1]=jQuery("div[name='UPPER']",maintable);subdiv[0][2]=jQuery("div[name='UR']",maintable);subdiv[1]=[];subdiv[1][0]=jQuery("div[name='LEFT']",maintable);subdiv[1][1]=jQuery("div[name='CENTER']",maintable);subdiv[1][2]=jQuery("div[name='RIGHT']",maintable);var overflowheightdiv=maintable.attr("overflowheightdiv");var windowoffset=overflowheightdiv?jQuery("#"+overflowheightdiv).scrollTop():jQuery(window).scrollTop();var horizscrolloffset=subdiv[1][1].scrollLeft()/subdiv[1][1].width();var vertscrolloffset=subdiv[1][1].scrollTop()/subdiv[1][1].height();for(var i=0;i<2;i++){for(var j=0;j<3;j++){subdiv[i][j].css({width:'',height:''});}}
var tableparent=maintable.parent();maintable.hide();tableparent.css("width","100%");var parentwidth=tableparent.width();var parentheight=overflowheightdiv?jQuery("#"+overflowheightdiv).height():0;tableparent.css("width",'');maintable.show();if(!parentwidth){return;}
var scrollbarwidth=jQuery.getScrollbarWidth();var contentwidth=parentwidth
-subdiv[0][0].width()
-subdiv[0][2].width()
-scrollbarwidth;var horizontalscroll;if(contentwidth<subdiv[0][1].width()){subdiv[0][1].width(contentwidth);subdiv[1][1].width(contentwidth);horizontalscroll=1;subdiv[1][1].height(subdiv[1][1].height()+scrollbarwidth);}
if(IsSafari()||IsChrome()||IsEdge()){subdiv[1][1].width(subdiv[1][1].width()+scrollbarwidth);subdiv[0][1].width(subdiv[1][1].width());}
if(overflowheightdiv){var contentheight=parentheight-subdiv[0][1].height();if(contentheight<subdiv[1][1].height()-scrollbarwidth){contentheight-=20;for(var j=0;j<3;j++){var divheight=contentheight;if(j!=1&&horizontalscroll){divheight-=scrollbarwidth;}
subdiv[1][j].height(divheight);}
if(horizontalscroll){if(subdiv[1][1].attr("overflowy")){subdiv[1][1].width(subdiv[1][1].width()+scrollbarwidth);}
else{for(var i=0;i<2;i++){subdiv[i][1].width(subdiv[i][1].width()-scrollbarwidth);}}}}}
var maxdivheight;for(var i=0;i<=2;i++){if(subdiv[1][i].outerHeight()>maxdivheight){maxdivheight=subdiv[1][i].outerHeight();}}
for(var i=0;i<=2;i++){subdiv[1][i].height(maxdivheight);}
if(maintable.attr("scrolltoright")){subdiv[1][1].scrollLeft(subdiv[1][1].width());maintable.removeAttr("scrolltoright");}
else{subdiv[1][1].scrollLeft(horizscrolloffset*subdiv[1][1].width());}
if(overflowheightdiv){var scrolldiv=subdiv[1][2].width()==0?subdiv[1][1]:subdiv[1][2];if(maintable.attr("scrolltobottom")){scrolldiv.scrollTop(scrolldiv.height());maintable.removeAttr("scrolltobottom");}
else{scrolldiv.scrollTop(vertscrolloffset*scrolldiv.height());}}
overflowheightdiv?jQuery("#"+overflowheightdiv).scrollTop(windowoffset):jQuery(window).scrollTop(windowoffset);}
