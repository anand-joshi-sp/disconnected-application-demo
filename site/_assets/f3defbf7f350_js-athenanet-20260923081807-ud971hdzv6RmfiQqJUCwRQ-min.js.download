else if(!authdomaininput.prop("disabled")){if(authdomaininput.val()!=''){input.prop("disabled",false);input.addClass('RequiredField');jQuery('#WINDOWSUSERNAMEROW').show();jQuery('#SYSTEMACCESSROW').show();}
else{DisableInputField(input);jQuery('#WINDOWSUSERNAMEROW').hide();jQuery('#SYSTEMACCESSROW').hide();}}
else if(!input.prop('disabled')){DisableInputField(input);jQuery('#WINDOWSUSERNAMEROW').hide();jQuery('#SYSTEMACCESSROW').hide();}}
for(i=0;i<identitymappingrows;i++){var mapping=jQuery('#IDENTITYMAPPING'+i);var provider=jQuery('#IDENTITYPROVIDER'+i);if(ssosettings[orginput.value]){if(provider.prop("disabled")){mapping.prop("disabled",false);provider.prop("disabled",false);if(i===0){provider.addClass('RequiredField');}
jQuery('#IDENTITYMAPPINGROW').show();}
SelectOptionsFromArrays(provider[0],ssosettings[orginput.value].IDENTITYPROVIDERS.IDS,ssosettings[orginput.value].IDENTITYPROVIDERS.TEXTS);}
else{if(!provider.prop("disabled")){DisableInputField(mapping);DisableInputField(provider);jQuery('#IDENTITYMAPPINGROW').hide();}}}
locationidelement=document.zform.EMPLOYEELOCATIONID;locationidelement.options.length=0;var optionctr=0;organization=orginput.value;var optionvar=document.createElement('option');optionvar.text='';optionvar.value='';locationidelement.add(optionvar,optionctr);optionctr++;for(i=0;i<organizationidarray.length;i++){if(organizationidarray[i]==organization){var newoptionvar=document.createElement('option');newoptionvar.text=locationnamearray[i];newoptionvar.value=locationidarray[i];locationidelement.add(newoptionvar,optionctr);optionctr++;}}
var type='';for(i=0;i<organizationidarray.length;i++){if(organizationidarray[i]==organization){type=organizationtypearray[i];break;}}
document.zform.ORGANIZATIONTYPE.value=type;document.zform.DEPARTMENTNAME.value='';document.zform.DEPARTMENTNAMESELECT.value='';if(type=='VENDOR'){document.getElementById('DEPARTMENTSELECTROW').style.display='';document.getElementById('DEPARTMENTTEXTROW').style.display='none';document.zform.DEPARTMENTNAMESELECT.className='RequiredField';}
else{document.getElementById('DEPARTMENTSELECTROW').style.display='none';document.getElementById('DEPARTMENTTEXTROW').style.display='';document.zform.DEPARTMENTNAMESELECT.className='';}
if(type=='ATHENA'||type=='VENDOR'){document.zform.EMPLOYEELOCATIONID.className='RequiredField';document.getElementById('LOCATIONROW').style.display='';}
else{document.zform.EMPLOYEELOCATIONID.className='';document.getElementById('LOCATIONROW').style.display='none';}
if(!skipUpdateEmailRequireClass){UpdateEmailRequired(organization);}
if(loadTimeCall){loadTimeCall=false;}
else{CheckIfComplianceFormIsRequired();}}
function UpdateTrainingDepartment(department){var organization;if(document.zform.ORGANIZATIONID){organization=document.zform.ORGANIZATIONID.value;}
else{return;}
var contextid=document.zform.INSERTCONTEXTNAME?document.zform.INSERTCONTEXTNAME.value:'';var userid=document.zform.ID?document.zform.ID.value:'';var trainingcontext=jQuery('input[name="TRAININGCONTEXTNAME"]').val();if(trainingcontext){contextid=trainingcontext;}
if(organization=='PRACTICE'&&(userid||contextid)){document.getElementById('TRAININGCONTEXTROW').style.display='table-row';document.getElementById('TRAININGDEPARTMENTROW').style.display='';CallRemote({SUB:'UserAdmin::GetTrainingDepartmentInput',ARGS:{USERID:userid,CONTEXTNAME:contextid,ORGANIZATION:organization,DEFAULTVALUE:department},ONFINISH:function(data){if(data){document.getElementById('TRAININGDEPARTMENTINPUT').innerHTML=data;}
else{document.getElementById('TRAININGDEPARTMENTROW').style.display='none';}},LOADINGINDICATORFLAG:true});}
else{document.getElementById('TRAININGCONTEXTROW').style.display='none';document.getElementById('TRAININGDEPARTMENTROW').style.display='none';}}
function UpdateIdentityMapping(index){var identitymapping=document.zform["IDENTITYMAPPING"+index].value;if(identitymapping){var identityproviderelt=document.zform["IDENTITYPROVIDER"+index];var identityprovidertext=identityproviderelt.options[identityproviderelt.selectedIndex].text;if(identityproviderelt.value==''){return;}
var args={IDENTITYMAPPING:identitymapping,IDENTITYPROVIDER:identityproviderelt.value};if(document.zform.ID){args.USERID=document.zform.ID.value;}
CallRemote({SUB:'UserAdmin::ExistingUserMapping',ARGS:args,ONFINISH:function(json){if(json){if(!confirm(identitymapping+" in "+identityprovidertext+" is already mapped to "+json.USERNAME+". "
+"If this change is saved the mapping for the other user will be deleted. "
+"Press OK to continue or Cancel to clear the field.")){document.zform.IDENTITYMAPPING.value='';}}}});}}
