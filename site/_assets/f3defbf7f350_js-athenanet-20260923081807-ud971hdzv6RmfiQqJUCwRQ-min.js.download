else{jotterobject=SVGJotter.GetJotter({'STARTINGOBJECT':params.STARTINGOBJECT,'SECTIONNAME':params.SECTION});}
LoadSVGJotter({'STARTINGOBJECT':params.STARTINGOBJECT,'JOTTEROBJECT':jotterobject,'IFRAME':params.IFRAME,'SECTION':params.STARTINGOBJECT,'SECTIONNAME':params.SECTION,'JOTTERSTROKES':params.JOTTERSTROKES,'JOTTERHEIGHT':params.JOTTERHEIGHT,'JOTTERWIDTH':params.JOTTERWIDTH,'ANATOMICAL':params.ANATOMICAL,'PENCOLOR':params.PENCOLOR});if(params.IMAGEEXISTS){var image=new Image();jQuery(image).load(function(){jotterobject.ExtendSVGJotter({'HEIGHT':image.height});jotterobject.sketchpadjottercontainer.css('background',params.BACKGROUNDCSS);jotterobject.savedimageheight=image.height;if(params.IFRAME){params.TARGETFRAME.height=params.TARGETFRAME.contentWindow.document.body.scrollHeight+'px';}});image.src=params.IMAGEURL;}}
function InitializeSVGJotterControls(params){InitializeSVGJotterObject(params);jQuery(EscapeJQuerySelector(params.CHECKBOXSELECTOR)).prop('disabled',false);var extendbutton=document.getElementById("extendjotter"+params.SECTIONNAME);if(extendbutton!==null){extendbutton.disabled=false;}
var contextdoc;if(params.IFRAME){contextdoc=params.TARGETFRAME.contentWindow.document;var contextdocbody=contextdoc.body;var contextdochtml=jQuery(contextdocbody).html();contextdochtml=contextdochtml.replace(/ORDER{NEW}{_NEWORDERINDEX_}{JOTTER_DIAGNOSISORDERS}/g,params.SECTIONNAME);contextdocbody.innerHTML=contextdochtml;}
else{contextdoc=document;}
var useenhancements=jQuery('#'+EscapeJQuerySelector(params.SECTIONNAME)+'USEJOTTERENHANCEMENTS').val();if(!useenhancements){contextdoc.getElementById(params.SECTIONNAME+"INK").disabled=false;contextdoc.getElementById(params.SECTIONNAME+"ERASE").disabled=false;contextdoc.getElementById(params.SECTIONNAME+"CLEAR").disabled=false;}}
