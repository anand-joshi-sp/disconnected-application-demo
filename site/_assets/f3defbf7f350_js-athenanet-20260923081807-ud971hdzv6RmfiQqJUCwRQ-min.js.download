if(prevrelation){prevrelationvalue=prevrelation.value;}
if(prevkeyid){prevkeyidvalue=prevkeyid.value;}
if(prevrelationvalue==relationname&&prevkeyidvalue==relationkeyid){prevrow.cells[5].innerHTML="<td nextrow="+nextrowflag+"><a href='#' "+
" onclick='AppendFamilyHistoryRow("+rowid+", "+nextrowflag+", undefined, this);return false;' "+
