function ProcessCountedCallback(callbackobject){if(!callbackobject){return;}
if(!isDefined(callbackobject.active)||!isDefined(callbackobject.semaphore)||!isDefined(callbackobject.CallbackFunction)){alert('In ProcessCountedCallback, callbackobject must have the properties active, semaphore and CallbackFunction.');return;}
if(callbackobject.active){--callbackobject.semaphore;if(callbackobject.semaphore<=0){callbackobject.CallbackFunction();callbackobject.active=0;}}}
