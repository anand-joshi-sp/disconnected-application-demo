function DocumentDiagnosisConfirmation(args){args=args||{};var documentviewenhanceddxenabled=args.documentviewenhanceddxenabled;var edxreadonlydiagnosis=args.edxreadonlydiagnosis;if(documentviewenhanceddxenabled||edxreadonlydiagnosis){var imopickerlauncher=jQuery("#enhanced-diagnosis-picker-launcher");if(!edxreadonlydiagnosis&&!imopickerlauncher.length){return;}
if(jQuery("input[name=DOCUMENTSNOMEDDIAGNOSIS]").val()=="0"){alert("A diagnosis must be selected.");return false;}
var icd10=jQuery("input[name=DOCUMENTDIAGNOSISCODEICD10]").val();var imodiagnosislist=jQuery("input[name=IMODIAGNOSISLIST]").val();if((imodiagnosislist&&(JSON.parse(imodiagnosislist)).length>0&&(JSON.parse(imodiagnosislist))[0].PARTIALLYREFINEDIMOTERM==1)||(!icd10||icd10==-1)){alert('Select a more specific diagnosis.');return false;}
