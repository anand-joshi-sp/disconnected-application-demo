for(var i=0;i<problemcells.length;i++){var problemrow=GetParent(problemcells[i],'tagName','tr');GetChild(problemrow,'tagName','input','value',problemcode).name.match(/PREGNANCYPROBLEMS_EXISTING_(.*)_PROBLEMCODE/);var problemid=RegExp.$1;var deactivated=problemcells[i].getAttribute('deactivated');var deactivatedcheckbox=GetChild(problemrow,'tagName','input','type','checkbox','name','PREGNANCYPROBLEMS_EXISTING_'+problemid+'_HIDDEN');if(!deactivatedcheckbox||(deactivatedcheckbox&&!deactivatedcheckbox.checked&&deactivatedcheckbox!=checkbox)){alert("Patient already has problem "+problemdescription+" active.");return false;}}}
return true;}
