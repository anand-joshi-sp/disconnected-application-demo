if(!isDefined(args.TARGETINDEX)){args.TARGETINDEX=args.TABLE.rows[0].cells.length;}
var newcells=[];for(var i=0;i<args.TABLE.rows.length;i++){var currentrow=args.TABLE.rows[i];var sourcecellobj=currentrow.cells[args.SOURCEINDEX];var newcellobj=currentrow.insertCell(args.TARGETINDEX);newcellobj.innerHTML=_CloneTableCellInnerHTML(sourcecellobj,1);var inputs=jQuery('input,select,textarea',newcellobj);BlankInputCells(inputs);_AddBlankCellsPostCopyProcess(sourcecellobj,newcellobj);newcells.push(newcellobj);}
