function InitializeVisibleElements(){var icdversion=ClaimUtils.GetPageICDVersion();var interfaceicdversion=ClaimUtils.GetInterfaceICDVersion();var manuallyeditedmaps=jQuery('input[name=MANUALLYEDITEDMAPS]').first().val()!=0;var icd9payerexists=ClaimUtils.GetPrimaryPayerICDVersion()==='ICD-9'||ClaimUtils.GetSecondaryPayerICDVersion()==='ICD-9';var reimbursementmapapproved=jQuery('input[name=REIMBURSEMENTMAPAPPROVED]').val()==1;ClaimUtils.SetVisible('.claimlevel.mappeddiagnosisdatarow',icdversion==='ICD-10'&&(icd9payerexists||interfaceicdversion==='ICD-9'));ClaimUtils.SetVisible('.icd10learnmorecontainer',icdversion==='ICD-10');ClaimUtils.SetVisible('#SHOWICD9CHECKBOX',icdversion==='ICD-10');ClaimUtils.SetVisible('.requiredicd9codesmessage',icdversion==='ICD-10'&&(interfaceicdversion!=='ICD-9'||interfaceicdversion!=='both')&&icd9payerexists);if(interfaceicdversion==='ICD-9'||interfaceicdversion==='both'){jQuery('input[name=MANUALLYEDITEDMAPS]').first().val('1');}
