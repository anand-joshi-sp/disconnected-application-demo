function ShowConflictResolutionForConsolidatedDocumentView(args){AssertRequiredFields(args,['CONFLICTDATABYDOCUMENTID','BASEHREF']);var multiple_conflict_array=new Array();for(var document_id in args.CONFLICTDATABYDOCUMENTID){multiple_conflict_array.push(args.CONFLICTDATABYDOCUMENTID[document_id].CONFLICTDATA);}
