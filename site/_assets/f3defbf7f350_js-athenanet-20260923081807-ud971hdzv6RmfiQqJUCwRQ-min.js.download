var newindex=parseInt(oldindex)+1;adderobj.id=adderprefix+newindex;var newvitalsfield=jQuery(adderobj).prev().clone();newvitalsfield.find("input[data-type='DATE']").removeClass('hasDatepicker');newvitalsfield.find('#ui-datepicker-div').remove();newvitalsfield.find('.vitals-blood-pressure-value').prop('disabled',false);newvitalsfield.find('.vitals-weight-value').prop('disabled',false);newvitalsfield.find("input[name*='READINGSOURCETYPE']").remove();newvitalsfield=newvitalsfield.get(0).outerHTML;var nameregex=new RegExp('\\{'+oldindex+'\\}(?!\\{)','g');newvitalsfield=newvitalsfield.replace(nameregex,'{'+newindex+'}');newvitalsfield=jQuery(newvitalsfield);newvitalsfield.find('*').add(newvitalsfield).removeAttr(jQuery.expando);var regobj=new RegExp('_'+oldindex+'$');newvitalsfield.attr('id',newvitalsfield.attr('id').replace(regobj,'_'+newindex));var inputs=jQuery('input,select,textarea',newvitalsfield);ClearVitalReading(adderobj,inputs);var audittextobj=jQuery(adderobj).next("span:first[id^='audittext']").get(0);if(audittextobj){swapNodes(adderobj,audittextobj);}
jQuery(adderobj).before('<br>').before(newvitalsfield);jQuery(adderobj).prev().children('span.unitconv').text('');var targetfield=jQuery(adderobj).prev().children('input,select,textarea:first').get(0);if(targetfield){if((targetfield.tagName.toLowerCase()=='input'&&targetfield.type.toLowerCase()=='text')||targetfield.tagName.toLowerCase()=='textarea'){jQuery(targetfield).val('');targetfield.select();}
else{targetfield.focus();}}
ReinitializeSpeechEnabledFields();return false;}
