if(selecteddiagnosiscontainer){var selecteddiagnosissummary=jQuery("span[name='selecteddiagnosissummary']",selecteddiagnosiscontainer).get(0);var newdetailshtml=TextifyDiagnosisDetails(selecteddiagnosiscontainer,'SELECTEDDIAGNOSIS{'+ordering+'}');var newdetailsplain=TextifyDiagnosisDetails(selecteddiagnosiscontainer,'SELECTEDDIAGNOSIS{'+ordering+'}',true);var descriptionspan=jQuery("span[name='description']",selecteddiagnosissummary).get(0);selecteddiagnosissummary.title=descriptionspan.innerText+newdetailsplain;var detailsspan=jQuery("span[name='details']",selecteddiagnosissummary).get(0);if(newdetailshtml){SetInnerHTML(detailsspan,newdetailshtml);}
else{detailsspan.innerHTML='';}}
