function GeneratePager(args){var dir=args.dir;var type=dir>0?"next":"prev";var name=args.name;var prefix=dir>0?"":"&lt;&lt; ";var suffix=dir>0?" &gt;&gt;":"";var pager=jQuery("<div class='icd10filter"+type+"'>"
+prefix+name+suffix+"</div>");pager.click(function(){ScrollICD10Filters(dir);});pager.css("left",args.left);pager.css("top",args.top);return pager;}
function MaxOfIntegers(nums){if(!nums||nums.length==0){return 0;}
var max=nums[0];for(var idx=1;idx<nums.length;idx++){if(nums[idx]>max){max=nums[idx];}}
return max;}
function ScrollICD10Filters(dir){var jqfilterscroll=jQuery(".icd10filtersetscroller");var scrollsize=jqfilterscroll.parent().width();var page=-jqfilterscroll.position().left/scrollsize;var target=Math.round(page+dir*0.51)*scrollsize;jqfilterscroll.animate({left:-target},{duration:400});}
