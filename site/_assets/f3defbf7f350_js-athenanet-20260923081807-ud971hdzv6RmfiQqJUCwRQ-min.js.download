var noyticks=item.series.yaxis.options.ticks&&!item.series.yaxis.options.ticks.length;var pointstring=item.series.label&&!noyticks?item.series.label+': '+point:item.series.label?item.series.label:point;var tooltip=datestring+pointstring;jQuery('<div id="flottooltip" class="flottooltip">'+tooltip+'</div>').css({top:item.pageY-22,left:item.pageX+5}).appendTo("body");}}
