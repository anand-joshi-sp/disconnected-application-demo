else{var all_old_versions=true;var callremote_calls=new Array();selecteddata.reconcileselections.forEach(function(reconcileselection){if(reconcileselection.value=='NEW'){all_old_versions=false;var document_id=reconcileselection.documentid;var fdat=args.CONFLICTDATABYDOCUMENTID[document_id].FDATDATA;callremote_calls.push(CallRemote({SUB:'BusCall::InternalDocument::UpdateByDocumentClass',ARGS:{UPDATEARGS:fdat,DOCUMENTCLASS:fdat.DOCUMENT.DOCUMENTCLASS},BASE_HREF:args.BASEHREF,LOADINGINDICATORFLAG:true}));}});if(all_old_versions){ReloadConsolidatedDocumentView();}else{Promise.all(callremote_calls).then(function(){ReloadConsolidatedDocumentView();});}}});}
function ReloadDocumentView(){var documentviewurl=document.location.href.toString().replace('#','');document.location.href=documentviewurl;}
function ReloadConsolidatedDocumentView(){var consolidated_documentview_url=document.location.href.toString().replace('#','');document.location.href=consolidated_documentview_url;}
function HandleClosingEncounterCollision(args,updates,allsections,allsummaries){UnlockClosingEncounter(allsections,allsummaries);ShowSectionErrors(updates,allsections);jQuery.each(allsections,function(index,section){section.saving=false;});jQuery.each(allsummaries,function(index,summary){summary.saving=false;});if(isDefined(args.URL)){args.URL='';}
if(updates['REFRESHSECTIONLIST']){var refreshsectionnames={};for(i=0;i<updates['REFRESHSECTIONLIST'].length;i++){var sectionname=updates['REFRESHSECTIONLIST'][i];refreshsectionnames[sectionname]=1;var summaryname=sectionname+'_Summary';refreshsectionnames[summaryname]=1;}
updates['REFRESHSECTIONNAMES']=refreshsectionnames;ReplaceEncounterSections(updates,allsections,allsummaries,args.CLINICALENCOUNTERTABID,1,_ReplaceEncounterSectionsCallback,args);}
var jqcloseencounter=jQuery('#CLOSEENCOUNTER');if(jqcloseencounter.length){jqcloseencounter.prop('checked',false);}
return;}
function DelayEncounterSwitchStage(args){if(!window.pendingstageswitch&&!window.pendingswitch){ShowLoadingIndicator();}
window.pendingstageswitch=args;window.pendingswitch=[];}
function LockClosingEncounter(allsections,allsummaries){jQuery.each(allsections,function(index,section){if(jQuery(section).attr('sectionname')){GetSectionObject(section).Loading(section,1);}});jQuery.each(allsummaries,function(index,summary){if(jQuery(summary).attr('sectionname')){GetSectionObject(summary).Loading(summary,1);}});return 1;}
function UnlockClosingEncounter(allsections,allsummaries){jQuery.each(allsections,function(index,section){if(jQuery(section).attr('sectionname')){GetSectionObject(section).FinishLoading(section);}});jQuery.each(allsummaries,function(index,summary){if(jQuery(summary).attr('sectionname')){GetSectionObject(summary).FinishLoading(summary);}});}
function _ValidateSections(contentset,args){var widgetargs=args.WIDGETARGS||{};widgetargs.TARGETSTAGE=args.STAGE;widgetargs.COMPLETEDSTAGE=args.COMPLETEDSTAGE;widgetargs.TABID=args.TABID;widgetargs.CLINICALENCOUNTERID=args.CLINICALENCOUNTERID;widgetargs.CONTENTSET=contentset;widgetargs.EXCLUDESECTIONS=args.EXCLUDESECTIONS?args.EXCLUDESECTIONS:{};args.WIDGETARGS=widgetargs;if(!(args.EXCLUDESECTIONS&&args.EXCLUDESECTIONS.SMOKINGSTATUS)){args.WIDGETARGS.EXCLUDESECTIONS.SMOKINGSTATUS=1;var socialhistorylist=jQuery(contentset).children('div[id=SECTIONCONTAINER][sectionname=SocialHistoryList]').get(0);var smokingstatusok=CheckForSmokingData(socialhistorylist,args);if(!smokingstatusok){return false;}}
if(!(args.EXCLUDESECTIONS&&args.EXCLUDESECTIONS.ALLERGIES)){args.WIDGETARGS.EXCLUDESECTIONS.ALLERGIES=1;var allergylist=jQuery(contentset).children('div[id=SECTIONCONTAINER][sectionname=AllergyList]').get(0);if(allergylist&&!CheckForAllergiesEntered(allergylist,args)){return false;}}
if(!(args.EXCLUDESECTIONS&&args.EXCLUDESECTIONS.FAMILYHISTORY)){args.WIDGETARGS.EXCLUDESECTIONS.FAMILYHISTORY=1;var familyhistorylist=jQuery(contentset).children('div[id=SECTIONCONTAINER][sectionname=FamilyHistoryList]').get(0);if(familyhistorylist){var familyhistoryargs=jQuery.extend({},args);var familyhistoryok=CheckForFamilyHistoryEntered(familyhistorylist,familyhistoryargs);if(!familyhistoryok){return false;}}}
var medicationlist=jQuery(contentset).children('div[id=SECTIONCONTAINER][sectionname=MedicationList]').get(0);if(!(args.EXCLUDESECTIONS&&args.EXCLUDESECTIONS.MEDICATIONSENTERED)){args.WIDGETARGS.EXCLUDESECTIONS.MEDICATIONSENTERED=1;if(medicationlist&&!CheckForMedicationsEntered(medicationlist,args)){return false;}}
if(!(args.EXCLUDESECTIONS&&args.EXCLUDESECTIONS.MEDICATIONSREVIEWED)){args.WIDGETARGS.EXCLUDESECTIONS.MEDICATIONSREVIEWED=1;if(!CheckIfMedicationsReviewed(medicationlist,args)){return false;}}
if(!(args.EXCLUDESECTIONS&&args.EXCLUDESECTIONS.PROBLEMS)){args.WIDGETARGS.EXCLUDESECTIONS.PROBLEMS=1;var problemlist=jQuery(contentset).children('div[id=SECTIONCONTAINER][sectionname=ProblemList]').get(0);if(problemlist&&!CheckForProblemsEntered(problemlist,args)){return false;}}
if(!(args.EXCLUDESECTIONS&&args.EXCLUDESECTIONS.INVALIDSNOMEDS)){args.WIDGETARGS.EXCLUDESECTIONS.INVALIDSNOMEDS=1;if(problemlist&&!CheckForInvalidSnomeds(problemlist,args)){return false;}}
if(!(args.EXCLUDESECTIONS&&args.EXCLUDESECTIONS.VITALS)){args.WIDGETARGS.EXCLUDESECTIONS.VITALS=1;var vitals=jQuery(contentset).children('div[id=SECTIONCONTAINER][sectionname=Vitals]').get(0);if(vitals&&!CheckForVitalsEntered(vitals,args)){return false;}}
if(args.COMPLETEDSTAGE=='EXAM'){if(!(args.EXCLUDESECTIONS&&args.EXCLUDESECTIONS.DIAGNOSESMISSINGICD9)){args.WIDGETARGS.EXCLUDESECTIONS.DIAGNOSESMISSINGICD9=1;var diagnosisorders=jQuery(contentset).children('div[id=SECTIONCONTAINER][sectionname=AssessmentPlan]').get(0);if(diagnosisorders&&!CheckForDiagnosesMissingICD9s(diagnosisorders,args)){return false;}}}
if(!(args.EXCLUDESECTIONS&&args.EXCLUDESECTIONS.REGISTRY)){args.WIDGETARGS.EXCLUDESECTIONS.REGISTRY=1;if(!ValidateRegistrySection(args)){return false;}}
if(args.STAGEORTABSWITCH){if(args.COMPLETEDSTAGE){var donewithstage=jQuery('#DONEWITHSTAGE');donewithstage.attr('disabled',true);}
if(args.STAGE){var switchstageargs=jQuery.extend({},args);delete switchstageargs['EXCLUDESECTIONS'];delete switchstageargs['STAGEORTABSWITCH'];delete switchstageargs['WIDGETARGS'];delete switchstageargs['TABID'];delete switchstageargs['CONTENTSET'];switchstageargs.EXCLUDEMUVALIDATION=1;switchstageargs.STAGEDONE=switchstageargs.COMPLETEDSTAGE;delete switchstageargs['COMPLETEDSTAGE'];EncounterSwitchStage(switchstageargs);return;}
else if(args.TABID){var selecttabargs={};selecttabargs.EXCLUDEMUVALIDATION=1;EncounterSelectTab(args.TABID,undefined,selecttabargs);return;}}
return true;}
function ProcessDelayedSwitch(){if(window.pendingstageswitch){EncounterSwitchStage(window.pendingstageswitch);ClearLoadingIndicator();}
if(window.pendingswitch&&window.pendingswitch.length){EncounterSelectTab(window.pendingswitch[0],window.pendingswitch[1],window.pendingswitch[2]);ClearLoadingIndicator();}}
function StreamlinedSwitchStage(args){var stagespan=AH.Frames.Main.getElementById('stagespan_'+args.stage);var skipstagediv=jQuery('#skipstage');if(args.returnpoint){setReturnPathway({name:args.returnpoint,url:args.returnpointurl,schedulenav:args.schedulenav});}
if(!InList(args.fromstage,['CHECKIN','CHECKOUT'])&&InList(args.stage,['EXAM','SIGNOFF'])){CurrentEncounterSwitchStage({STAGE:args.stage,SKIPSTAGETEXT:args.skipstagetext});return;}
var navigationAdoptionArgs={stage:args.stage,link_type:'five stages link'};if(stagespan&&stagespan.getAttribute('notready')==1){var message=args.skipstagetext;confirmYN({TEXT:message,YESBUTTON:'Start '+args.displaystage,NOBUTTON:'Cancel',CALLBACK:function(response){if(response){ClassicMetricsManager.LogMetric('navigation_adoption',navigationAdoptionArgs);redirectToAirlock(buildAirlockURL({name:'encounter',id:args.id,stage:args.stage,closed:args.closed,briefing:args.briefing}));}}});}
else{ClassicMetricsManager.LogMetric('navigation_adoption',navigationAdoptionArgs);redirectToAirlock(buildAirlockURL({name:'encounter',id:args.id,stage:args.stage,closed:args.closed,briefing:args.briefing}));}}
function CurrentEncounterSwitchStage(args){var currentencounter=jQuery('iframe[id*="content_E"]',AH.Frames.Main.Document()).get(0);if(currentencounter){var clinicalencounterid=currentencounter.id.replace('content_E','');var content=currentencounter.contentWindow;var switchstage=function(){if(!content.EncounterSwitchStage){return;}
var attemptswitch=content.EncounterSwitchStage({CLINICALENCOUNTERID:clinicalencounterid,STAGE:args.STAGE,STAGEDONE:args.STAGEDONE,SKIPSTAGETEXT:args.SKIPSTAGETEXT});var currentencountertab=jQuery('#tab_E'+clinicalencounterid);if(attemptswitch){var encounterurl=currentencountertab.attr('location');if(encounterurl){var updatedurl=encounterurl.replace(/STAGE=\w+/,('STAGE='+args.STAGE));currentencountertab.attr('location',updatedurl);}}}
if(content.EncounterSwitchStage){switchstage();}
else{jQuery(content.document).ready(switchstage);}}}
function EncounterSwitchStage(args){AssertRequiredFields(args,['STAGE','CLINICALENCOUNTERID']);AssertValidFields(args,['STAGE','CLINICALENCOUNTERID','STAGEDONE','EXCLUDEMUVALIDATION','SKIPSTAGETEXT']);if(!window.allowswitching){DelayEncounterSwitchStage(args);return false;}
jQuery.data(document.body,'STAGEORTABSWITCH',true);var tabset=document.getElementById('encountertabset');var closedencounter;var billingtabonly;var jqdonewithstagebutton=jQuery('#DONEWITHSTAGE');if(tabset){var hiddentabs=GetChildren(tabset,'tagName','span','id',/tab_/);var visibletab;if(hiddentabs.length<3){if(hiddentabs.length==1&&hiddentabs[0].id=='tab_-1'){billingtabonly=1;}
else{closedencounter=1;}}
if(!closedencounter&&!billingtabonly){for(var i=0;i<hiddentabs.length;i++){if(jQuery(hiddentabs[i]).attr('stage')==args.STAGE||(args.STAGE=='SIGNOFF'&&(hiddentabs[i].id=='tab_-1'||jQuery(hiddentabs[i]).attr('summaryflag')==1))){if(!visibletab){visibletab=hiddentabs[i];}
if(args.STAGE=='EXAM'&&jQuery(hiddentabs[i]).attr('defaulttab')){visibletab=hiddentabs[i];}
if(args.STAGE=='SIGNOFF'&&jQuery(hiddentabs[i]).attr('defaultsignofftab')){visibletab=hiddentabs[i];}}}}
else if(billingtabonly){visibletab=hiddentabs[0];}
var currentstage=document.getElementById('APPOINTMENTSTAGE');var closeencounter=jQuery('#CLOSEENCOUNTER').get(0);var attemptsave;if(!closedencounter){var attemptsaveargs={};attemptsaveargs.RETURNSAVERESULT=1;attemptsaveargs.STAGE=args.STAGE;if(args.STAGEDONE){attemptsaveargs.COMPLETEDSTAGE=args.STAGEDONE;}
else{attemptsaveargs.COMPLETEDACTUALSTAGE=currentstage?currentstage.value:'';}
attemptsaveargs.EXCLUDEMUVALIDATION=args.EXCLUDEMUVALIDATION;if(args.STAGEDONE=='SIGNOFF'&&jqdonewithstagebutton){if(closeencounter&&closeencounter.checked){attemptsaveargs.CHECKOUTPATIENT=CheckoutPatient;}}
attemptsave=EncounterSelectTab(visibletab.id.replace('tab_',''),'',attemptsaveargs);}
else{var savetabargs={};savetabargs.STAGE=args.STAGE;if(args.STAGEDONE){savetabargs.COMPLETEDSTAGE=args.STAGEDONE;}
else{savetabargs.COMPLETEDACTUALSTAGE=currentstage?currentstage.value:'';}
attemptsave=SaveTab(savetabargs);}
if(!attemptsave){jQuery.data(document.body,'STAGEORTABSWITCH',false);return false;}
if(closeencounter&&closeencounter.checked){jQuery.data(document.body,'STAGEORTABSWITCH',false);return false;}
if(!closedencounter&&!billingtabonly){for(var i=0;i<hiddentabs.length;i++){if(jQuery(hiddentabs[i]).attr('stage')==args.STAGE||(args.STAGE=='SIGNOFF'&&(hiddentabs[i].id=='tab_-1'||hiddentabs[i].summaryflag==1))){if(hiddentabs[i].className.match(/ hidden/)){hiddentabs[i].className=hiddentabs[i].className.replace(' hidden','');}}
else{if(!hiddentabs[i].className.match(/ hidden/)){hiddentabs[i].className+=' hidden';}}}}
if(args.STAGEDONE){currentstage=UpdatePatientLocation({STAGEDONE:args.STAGEDONE});}
if(!billingtabonly){UpdateJumpToOptions(args.STAGE);}
if(InList(args.STAGE,['INTAKE','EXAM'])){jQuery('#PortalActiveIndicator').show();}
else{jQuery('#PortalActiveIndicator').hide();}}
var stagespan=AH.Frames.Main.getElementById('stagespan_'+args.STAGE);var nimbusPatientBanner=AH.Frames.Main.getElementById('nimbus-banner-container');if(jqdonewithstagebutton&&!(args.STAGEDONE&&args.STAGE==args.STAGEDONE)){jqdonewithstagebutton.attr('stage',args.STAGE);jqdonewithstagebutton.val(args.STAGE=='SIGNOFF'?'Ready for Checkout':'Done with '+upperCaseFirst(args.STAGE.toLowerCase()));if(stagespan){jqdonewithstagebutton.prop('disabled',(jQuery(stagespan).attr('complete')==1?true:false));}}
var skipstagediv=jQuery('#skipstage');var layouttable=jQuery('#layout_header, #layout_content, #layout_footer');if(stagespan&&stagespan.getAttribute('notready')==1&&!args.STAGEDONE){if(layouttable.size()>0){layouttable.hide();if(skipstagediv.size()>0){jQuery('#STARTSTAGE[stage!='+args.STAGE+']',skipstagediv).attr('stage',args.STAGE).val('Start '+(args.STAGE=='SIGNOFF'?'Sign-off':upperCaseFirst(args.STAGE.toLowerCase())));skipstagediv.show();if(args.SKIPSTAGETEXT){jQuery('#skipstagetext',skipstagediv).html(args.SKIPSTAGETEXT);}}
else{CallRemote({SUB:'PatientWorkflow::SkipStageHTML',ARGS:{CLINICALENCOUNTERID:args.CLINICALENCOUNTERID,STAGE:args.STAGE},ONFINISH:function(returnhtml){var layouttable=jQuery('#layout_header, #layout_content, #layout_footer');var skipstagedivcount=jQuery("#skipstage").length;if(!returnhtml){layouttable.show();}
else if(skipstagedivcount==0){layouttable.first().before(returnhtml);layouttable.hide();}}});}}}
else if((stagespan||nimbusPatientBanner)&&args.STAGEDONE){UpdatePatientBanner({STAGEDONE:args.STAGEDONE,CLINICALENCOUNTERID:args.CLINICALENCOUNTERID,STAGE:args.STAGE});}
else{skipstagediv.hide();layouttable.show();}
if(!closedencounter){DisplaySaveAndNext(visibletab);}
jQuery.data(document.body,'STAGEORTABSWITCH',false);return true;}
function UpdatePatientLocation(args){AssertFields(args,['STAGEDONE'],['BYPASSSECTIONLOAD']);var currentstage=document.getElementById('APPOINTMENTSTAGE');if(InList(args.STAGEDONE,['INTAKE','SIGNOFF'])){var UpdateLocation=function(){var patientstatusinput=jQuery('#contentset div[sectionname=PatientLocation] select[name=PATIENTSTATUSID]');if(args.STAGEDONE=='INTAKE'&&patientstatusinput.val()<3){patientstatusinput.val(3);if(args.STAGEDONE=='INTAKE'){var assignedto=document.getElementById('ASSIGNEDTOUSERNAME');var providerusernameelement=AH.Frames.Main.getElementById('ENCOUNTERPROVIDERUSERNAME');if(providerusernameelement&&assignedto){var providerusername=providerusernameelement.getAttribute('value');if(providerusername!=''){assignedto.value=providerusername;}}}}
else if(args.STAGEDONE=='SIGNOFF'){patientstatusinput.val(4);}};if(args.BYPASSSECTIONLOAD){UpdateLocation();}
else{DelayForSectionLoad(UpdateLocation);}}
if(currentstage){if(args.STAGEDONE=='INTAKE'){currentstage.value='EXAM';}
else if(args.STAGEDONE=='EXAM'){currentstage.value='SIGNOFF';}
else if(InList(args.STAGEDONE,['SIGNOFF','CHECKOUT'])){currentstage.value='POST-VISIT';}}
return currentstage;}
function UpdatePatientBanner(args){AssertFields(args,['STAGEDONE','CLINICALENCOUNTERID','STAGE'],['BYPASSSECTIONLOAD']);var UpdateBanner=function(){jQuery.data(document.body,'PATIENTBANNERREFRESH',true);var bannerwrapper=AH.Frames.Main.getElementById('patient-banner-wrapper');var includeactionbar=args.STAGEDONE==='CHECKOUT'?1:0;var finishfunction=function(returnhtml){bannerwrapper=AH.Frames.Main.getElementById('patient-banner-wrapper');var headingcontainer=AH.Frames.Main.getElementById('patientworkflowheading');if(returnhtml&&(headingcontainer||bannerwrapper)){if(bannerwrapper){var $bannerwrapper=jQuery(bannerwrapper);if(includeactionbar){$bannerwrapper.height($bannerwrapper.height()+30);}
$bannerwrapper.parent().replaceWith(returnhtml);}
else{headingcontainer.outerHTML=returnhtml;}}
jQuery.data(document.body,'PATIENTBANNERREFRESH',false);if(args.STAGEDONE=='CHECKOUT'){if(AH.Frames.ScheduleNav.GetLocation().toString().match(/schedulenav.esp/)){require(['shared:/scripts/athena/utils/cross_frame_events'],function(CrossFrameEventsUtils){var args={SOURCE:'UpdatePatientBanner',FUNCTIONARGS:{LOADTYPE:'MANUALREFRESH'}};CrossFrameEventsUtils.trigger('reload-schedulenav-HTML',args);});}
else if(AH.Frames.ScheduleNav.GetLocation().toString().match(/schedulenavbilling.esp/)){AH.Frames.ScheduleNav.GetLocation().reload();}}};if(bannerwrapper){CallRemote({SUB:'Patient::Banner::GetBanner',ARGS:{ENCOUNTERID:args.CLINICALENCOUNTERID,CURRENTSTAGE:args.STAGE,INCLUDEQUICKLINKS:1,INCLUDESPECIALTYFILTER:1,INCLUDEALLERGYALERTS:1,INCLUDEACTIONBAR:includeactionbar,STAGECHANGEARGS:{CLINICALENCOUNTERID:args.CLINICALENCOUNTERID,STAGE:args.STAGE,STAGEDONE:args.STAGEDONE}},ONFINISH:finishfunction});}
else{CallRemote({SUB:'PatientWorkflow::HeaderHTML',ARGS:{CLINICALENCOUNTERID:args.CLINICALENCOUNTERID,STAGE:args.STAGE,STAGEDONE:args.STAGEDONE},ONFINISH:finishfunction});}};if(args.BYPASSSECTIONLOAD){UpdateBanner();}
else{DelayForSectionLoad(UpdateBanner);}}
function UpdateJumpToOptions(stage){var jumptoselect=jQuery('#jumptonav');if(jumptoselect&&stage&&jumptoselect.attr('options'+stage)){if(jumptoselect.attr('options'+stage).match(/option/gi).length>1){jumptoselect.html(jumptoselect.attr('options'+stage));}
else{jumptoselect.html(jumptoselect.attr('optionsSIGNOFF'));}
var registrysection=GetRegistrySection();if(registrysection&&!registrysection.hasClass('invisible')){AddRegistryToJumpTo();}}}
function ChartTabsRemoveCloseFromOBTab(id){var tab=AH.Frames.Main.getElementById('tab_ob');tab.id="tab_"+id;var content=AH.Frames.Main.getElementById('content_ob');content.id="content_"+id;var closer=AH.Frames.Main.getElementById('closer_ob');closer.innerHTML='';}
function ChartTabsRefreshTab(id,stage){if(jQuery('#STREAMLINED_DOCUMENT_VIEW').length){require(['shared:/scripts/athena/utils/cross_frame_events'],function(CrossFrameEventUtils){CrossFrameEventUtils.trigger('document-iframe-reload');});}
var tab=AH.Frames.Main.getElementById('content_'+id);var src;if(tab){src=tab.src;if(!stage&&tab.ownerDocument){var patientworkflowheading=tab.ownerDocument.getElementById('patientworkflowheading');if(patientworkflowheading){stage=patientworkflowheading.getAttribute('stage');}}}
if(src&&src.indexOf('blank.html')==-1){if(stage){src=src.replace(/STAGE=[A-Z]+/,'STAGE='+stage);}
ChartTabsRedirectTab(id,src);}
if(id.match("^E\d*")){AH.SetPropertyInGlobal('dirtyencountertab',id,1);}}
function ChartTabsRedirectTab(id,location){var tabcontent=AH.Frames.Main.getElementById('content_'+id);var tabdiv=AH.Frames.Main.getElementById('tab_'+id);if(tabdiv&&tabcontent){jQuery(tabdiv).attr('status','loading');jQuery(tabcontent).one('load',function(){jQuery(tabdiv).attr('status','loaded')});tabcontent.src=location;}}
function ChartTabsAddTab(id,title,url,section,forcerefresh,currentencounter,noselect){var externalurl;if(url&&url.match(/^http/i)&&!url.match(/athenahealth.com$/i)){externalurl=1;}
if(url&&!url.match(/NOHEADER=1/)&&!externalurl){url+='&NOHEADER=1';}
if(url&&!externalurl){url+='&ISCHARTTABS=1';}
if(!AH.Frames.Main.getElementById('tab_'+id)){forcerefresh=0;var subtabarg='';if(url&&url.match(/encounter|cancercases/)){subtabarg='hassubtabs=1';}
var tabtitle=unescape(StripHTML(title));if(tabtitle.length>50){tabtitle=tabtitle.substring(0,47)+"...";}
var newtab=sprintf("<div %s "+subtabarg+">%s</div>",HTMLAttributes({id:'tab_'+id,title:unescape(title),status:'loading'}),tabtitle);if(currentencounter){jQuery('#charttabs [id^="tab_"][initialtab]:last',AH.Frames.Main.Document()).after(newtab);}
else{jQuery('#charttabs',AH.Frames.Main.Document()).append(newtab);}
var newframe=sprintf("<iframe %s></iframe>",HTMLAttributes({id:'content_'+id,src:url,status:'loading',onload:"top.AH.Frame().jQuery('#tab_"+EscapeJS(EscapeJQueryID(id))+"', top.AH.Frames.Main.Document()).attr('status', 'loaded')",frameborder:0}));jQuery('#chartcontents',AH.Frames.Main.Document()).append(newframe);}
var newtab=AH.Frames.Main.getElementById('tab_'+id);if(newtab){if(newtab.className.match('selected')){var selectedclass=newtab.className;newtab.className='';window.setTimeout(function(){AH.Frames.Main.getElementById('tab_'+id).className=selectedclass;},100);}
var framecontent=AH.Frames.Main.getElementById('content_'+id);if(framecontent&&url&&framecontent.src){var splitcurrenturl=framecontent.src.split('?');var splitnewurl=url.split('?');var currentfilename=splitcurrenturl[0].split('/');var newfilename=splitnewurl[0].split('/');if(currentfilename[currentfilename.length-1]==newfilename[newfilename.length-1]){if(splitcurrenturl[1]&&splitnewurl[1]){var splitcurrentparams=splitcurrenturl[1].split('&');var splitnewparams=splitnewurl[1].split('&');var currentparamhash={};var currentcount=0;for(var i=0;i<splitcurrentparams.length;i++){var splitparam=splitcurrentparams[i].split('=');if(splitparam[1]&&splitparam[0]!='STAGE'&&splitparam[0]!='CLINICALENCOUNTERTABID'){currentparamhash[splitparam[0]]=splitparam[1];currentcount++;}}
var failed=0;for(var i=0;i<splitnewparams.length;i++){var splitparam=splitnewparams[i].split('=');if(splitparam[1]){if(splitparam[1]==currentparamhash[splitparam[0]]){currentcount--;}
else if(splitparam[0]!='STAGE'&&splitparam[0]!='CLINICALENCOUNTERTABID'){failed=1;break;}}}
if(currentcount){failed=1;}
if(failed){ChartTabsRedirectTab(id,url);}}
else{if(splitcurrenturl[1]||splitnewurl[1]){ChartTabsRedirectTab(id,url);}}}
else{ChartTabsRedirectTab(id,url);}}}}
function ChartTabsScrollHistorypage(id,sectionname){if(!id||!AH.Frames.Main.SubFrame('content_'+id)){return;}
var framedocument;var height=0;var scrollheight=0;try{framedocument=AH.Frames.Main.SubFrame('content_'+id).document;scrollheight=AH.Frames.Main.SubFrame('content_'+id).document.body.scrollHeight;height=AH.Frames.Main.SubFrame('content_'+id).document.body.offsetHeight;}catch(e){}
if(framedocument&&framedocument.getElementById(sectionname)&&scrollheight==height){AH.Frames.Main.SubFrame('content_'+id).document.location.hash="";AH.Frames.Main.SubFrame('content_'+id).document.location.hash=sectionname;}
else{var scrollfunction=function(){ChartTabsScrollHistorypage(id,sectionname);};window.setTimeout(scrollfunction,100);}}
function TransformXML(xmldata,xsldata,xslargs){var parser=new DOMParser();var xmldoc=parser.parseFromString(xmldata,"text/xml");var xsldoc=parser.parseFromString(xsldata,"text/xml");var xsltproc=new XSLTProcessor();xsltproc.importStylesheet(xsldoc);if(xslargs){for(var key in xslargs){xsltproc.setParameter(null,key,xslargs[key]);}}
var finaldoc=xsltproc.transformToFragment(xmldoc,document);var serializer=new XMLSerializer;var html='';for(var i=0;i<finaldoc.childNodes.length;i++){html+=serializer.serializeToString(finaldoc.childNodes[i]);}
return html;}
function PrettyPrintXML(xmlnode,spacevar){var html='';var spaces=spacevar||'';if(xmlnode.hasChildNodes()||(xmlnode.attributes&&xmlnode.attributes.length>0)){html+='<br/>'+spaces+'&lt;';html+='<b>'+xmlnode.nodeName+'</b>';for(var j=0;j<xmlnode.attributes.length;j++){html+=' '+xmlnode.attributes[j].name+"=&quot;"+xmlnode.attributes[j].value+"&quot;";}
if(!xmlnode.hasChildNodes()){html+=' /';}
html+='&gt;';var nodehastext=false;for(var i=0;i<xmlnode.childNodes.length;i++){var childnode=xmlnode.childNodes.item(i);if(childnode.nodeName=='#text'){if(!(/\S/.test(childnode.nodeValue))){continue;}
nodehastext=true;}
html+=PrettyPrintXML(childnode,spaces+'\t');}
if(xmlnode.hasChildNodes()){if(!nodehastext){html+='<br/>'+spaces;}
html+='&lt;/'+xmlnode.nodeName+'&gt;';}}
else{if(xmlnode.nodeName&&(xmlnode.nodeName!='#text')){html+='<br/>'+spaces+'&lt;<b>'+xmlnode.nodeName+'</b>/&gt;';}
else{html='<strong>'+xmlnode.nodeValue+'</strong>';}}
return html;}
function ViewXML(xmldata,styleurl){if(window.viewxmlwindow)window.viewxmlwindow.close();var viewxmlwindow=window.open(GetMDCCompatibleHTMLURL('blank.html'),"viewxmlwindow","scrollbars=1,resizable=1,menubar=1,width=600,height=400");var parser=new DOMParser();var xmlobj=parser.parseFromString(xmldata,"text/xml");var prettyxml=PrettyPrintXML(xmlobj.documentElement);var documentdomainjs=window.isdocumentdomainadded?'<script>document.domain="'+document.domain+'";</script>':'';viewxmlwindow.document.write('<html><head></head>'+
'<link rel=stylesheet type="text/css" href='+styleurl+'>'+
documentdomainjs+
"<body><div style='background-color:white;'><pre>"+
prettyxml+
'</pre></div></body></html>');viewxmlwindow.document.close();if(window.focus){viewxmlwindow.focus();}}
