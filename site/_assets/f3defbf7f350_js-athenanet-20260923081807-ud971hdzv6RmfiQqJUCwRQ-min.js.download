var orderingarray=keys(orderedsectionnames);orderingarray.sort(function(a,b){return a-b;});for(var i=0;i<orderingarray.length;i++){var orderingkey=orderingarray[i];var sectionname=prefix+orderedsectionnames[orderingkey];var selectallspan=document.getElementById(sectionname+'{AVAILABLE}{SELECTALL}');selectallspan=selectallspan||document.getElementById(sectionname+'{AVAILABLE}{ITEM}');var stateinput=document.getElementById(sectionname+'{AVAILABLE}{STATE}{HEADER}');stateinput=stateinput||document.getElementById(sectionname+'{AVAILABLE}{STATE}');if(selectallspan&&selectallspan.className=='letterselectall'&&stateinput.value=='AVAILABLE'){selectallspan.shuttleobject.MoveItem(selectallspan);}}}
shuttletable.shuttleobject.ClearLoading();jQuery('#checkbox_yesno_AUDITHISTORY').attr('disabled',false);}});}
