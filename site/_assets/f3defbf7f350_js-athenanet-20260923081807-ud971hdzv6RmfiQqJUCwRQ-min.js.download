function ValidateEmail(field){var error;if(!field||!field.name){return;}
if(field&&field.value&&!(field.value.length<=254&&field.value.match(/^[^\@]{1,64}\@[^\@]{1,253}$/)&&field.value.match(/^[\w\!\#\$\%\&\'\*\+\-\/\=\?\^\`\{\|\}\~\.\@]+$/)&&field.value.match(/^.+\@.+\..+$/)&&!field.value.match(/\.\./)&&!field.value.match(/^\./)&&!field.value.match(/\.\@/)&&!field.value.match(/\@\./)&&!field.value.match(/\.$/))){error=1;}
var emailerror=document.getElementById(field.name+'_emailerrormessage');if(error){emailerror.style.display='inline';jQuery(field).addClass('InvalidInput');return false;}
else{emailerror.style.display='none';jQuery(field).removeClass('InvalidInput');}
return true;}
