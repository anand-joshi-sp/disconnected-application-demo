function RefocusPicker(elt){if(elt.is(":focus")){return;}
var scroller=jQuery("#layout_content");if(!scroller.length||scroller.scrollTop()==0){scroller=jQuery(document);if(scroller.scrollTop()==0){scroller=jQuery('html');}}
var scrollpos=scroller.scrollTop();elt.get(0).focus();scroller.scrollTop(scrollpos);}
function ICD10BuildListItem(i10,position){if(!i10.CODE){return jQuery("<div><i>"+i10.DESC+"</i></div>");}
var additionalclass='';if(i10.RAF){additionalclass+=' hasraf';}
return jQuery('<div></div>')
.addClass('icd10pickeritem'+additionalclass)
.attr('data-icd10code',i10.CODE)
.attr('data-icd10desc',i10.DESC)
.attr('data-icd10codeallid',i10.ID)
.attr('data-icd10priority',(i10.PRIORITY===undefined)?'':i10.PRIORITY)
.attr('title',i10.CODE+": "+i10.DESC)
.attr('data-icd10position',position?position:'')
.attr('data-raf',i10.RAF?i10.RAF:'')
.append(jQuery('<div class="icd10pickerlistcode">'+i10.CODE+'</div>'+
(i10.RAF?'<div class="icd10pickerlistraf">'+i10.RAF+'</div>':'')+
'<div class="icd10pickerlistdesc">'+i10.DESC+'</div>'));}
function CreateICD10PickerDOM(model){var pickerfocus=function(){var jqthis=jQuery(this);model.jqfield=jqthis;var pickercontainer=jqthis.parent();var jqsnomedpickercontents=pickercontainer.children('.icd10snomedpickercarrier');model.$DIAGNOSISLATERALITYSELECT=jqthis.closest('.diagnosisblock').find('input[name$="{LATERALITY}"]');var scrolloffset=-1*jQuery('.infoheader').height()||0;if(jqsnomedpickercontents.children().length===0){pickercontainer.append(ICD10BuildSNOMEDPicker(model));var parentTable=pickercontainer.closest('table');if(parentTable.hasClass('dropdowni10pickertable')){parentTable=parentTable.parent().closest('table');}
if(parentTable.length){ScrollToItem(parentTable[0].parentNode,null,jQuery('#layout_content')[0],scrolloffset,true);}
