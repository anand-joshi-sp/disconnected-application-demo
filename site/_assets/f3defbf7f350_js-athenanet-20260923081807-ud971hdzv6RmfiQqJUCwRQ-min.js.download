if(classification=='EOB'||classification=='$0'){checkamount=document.getElementById('eobca'+pagenumber).value;checknumber=document.getElementById('eobcn'+pagenumber).value;checkidentifier=document.getElementById('eobcid'+pagenumber).value;pbrid=document.getElementById('eobpb'+pagenumber).value;ircid=jQuery('#eobirc'+pagenumber).val();if(eobtypefeatureenabled){eobtype=jQuery('#eobtype'+pagenumber).val();}}
