function RotatePageClockwise(pagenum){document.zform.PAGENUM.value=pagenum;document.zform.ACTION.value="Rotate Clockwise";document.zform.LASTBUTTONCLICKED.value="Rotate Clockwise";ShowFinalLoadingScreen();document.zform.submit();return false;}
function RotatePageCounterclockwise(pagenum){document.zform.PAGENUM.value=document.pagenum;document.zform.ACTION.value="Rotate Counterclockwise";document.zform.LASTBUTTONCLICKED.value="Rotate Counterclockwise";ShowFinalLoadingScreen();document.zform.submit();return false;}
function EnableNavigatingAway(){var waitforpagetoload=document.getElementById('waitforpagetoload');if(waitforpagetoload){waitforpagetoload.value=0;}}
function SuppressNavigatingAway(){var waitforpagetoload=document.getElementById('waitforpagetoload');if(waitforpagetoload){if(waitforpagetoload.value==1){return"Doing so will cause delays in the publishing of the batch and may make images inaccurate. Please click \"Cancel\" to remain on the page until the page has fully loaded.";}}}
function ChangeBackgroundColor(){if(commingledpatientbatch){document.body.style.background='#DCDCDC';}}
function GoToPage(pagenum){document.zform.PAGENUM.value=pagenum;document.zform.KEEPINVERSE.value=1;document.zform.LASTBUTTONCLICKED.value="Jump to page";document.getElementById('disablekeyboardshortcuts').value='yes';ShowFinalLoadingScreen();document.zform.submit();return false;}
function PopulateBankStatementAccount(bankstatementaccounts){if(!document.zform.BANKACCOUNTID.value){selectSetValue(document.zform.BANKSTATEMENTACCOUNTID,'');document.zform.BANKSTATEMENTACCOUNTID.disabled=false;}
else if(document.zform.BANKACCOUNTID.value==-1){selectSetValue(document.zform.BANKSTATEMENTACCOUNTID,0);document.zform.BANKSTATEMENTACCOUNTID.disabled=false;}
else{var bankstatementaccount=DetermineBankStatementAccount(document.zform.BANKACCOUNTID.value,bankstatementaccounts);selectSetValue(document.zform.BANKSTATEMENTACCOUNTID,bankstatementaccount);document.zform.BANKSTATEMENTACCOUNTID.disabled=true;}}
function DetermineBankStatementAccount(bankaccount,bankstatementaccounts){return bankstatementaccounts.items[bankaccount];}
function Hash(){this.length=0;this.items=new Array();for(var i=0;i<arguments.length;i+=2){if(typeof(arguments[i+1])!='undefined'){this.items[arguments[i]]=arguments[i+1];this.length++;}}}
function CheckFormForObviousErrors(today,sixmonthsago,enablebankstatementaccountid){if(document.zform.POSTDATE){if(document.zform.POSTDATE.value==""){alert('You must enter a post date.');document.all.POSTDATE.focus();return false;}}
if(document.zform.DEPOSITDATE){if(document.zform.DEPOSITDATE.value==""){alert('You must enter a deposit date.');document.all.DEPOSITDATE.focus();return false;}
if(!IsDate(document.zform.DEPOSITDATE.value)){alert('The Deposit Date is not a valid date.');try{document.zform.DEPOSITDATE.focus();}catch(e){};return false;}
var depositdate=new Date(document.zform.DEPOSITDATE.value);if(depositdate>today){if(!confirm('The Deposit Date is in the future. Are you sure?')){try{document.zform.DEPOSITDATE.focus();}catch(e){};return false;}}
if(depositdate<sixmonthsago){if(!confirm('The Deposit Date is in more than six months in the past. Are you sure?')){try{document.zform.DEPOSITDATE.focus();}catch(e){};return false;}}}
if(document.zform.BATCHMETHODID){if(document.zform.BATCHMETHODID.value==""){alert('You must enter a batch method.');document.all.BATCHMETHODID.focus();return false;}}
if(document.zform.TOTALSUMAMOUNT){document.zform.TOTALSUMAMOUNT.value=TrimWhitespace(document.zform.TOTALSUMAMOUNT.value);if(document.zform.TOTALSUMAMOUNT.value==""){alert('You must enter a Deposit Amount.');document.zform.TOTALSUMAMOUNT.focus();return false;}
if(document.zform.TOTALSUMAMOUNT.value&&isNaN(document.zform.TOTALSUMAMOUNT.value)){alert('Deposit Amount must be numeric');document.zform.TOTALSUMAMOUNT.focus();return false;}}
if(document.zform.CHECKSDEPOSITEDBYSITEYN){if(document.zform.CHECKSDEPOSITEDBYSITEYN.value==""){alert('Checks deposited by site is a required field.');document.all.CHECKSDEPOSITEDBYSITEYN.focus();return false;}}
if(document.zform.BANKSTATEMENTACCOUNTID){if(document.zform.BANKSTATEMENTACCOUNTID.value==""){alert('You must select a Bank Account.');document.all.BANKSTATEMENTACCOUNTID.focus();return false;}}
if(document.zform.CONFIRMCONTEXTID){if(document.zform.CONFIRMCONTEXTID.value.length==0){alert('The Practice ID is compulsory');document.zform.CONFIRMCONTEXTID.focus();return false;}
if(document.zform.CONFIRMCONTEXTID.value&&isNaN(document.zform.CONFIRMCONTEXTID.value)){alert('The Practice ID must be numeric');document.zform.CONFIRMCONTEXTID.focus();return false;}}
if(enablebankstatementaccountid){document.zform.BANKSTATEMENTACCOUNTID.disabled=false;}
return true;}
