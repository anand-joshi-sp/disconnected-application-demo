'<br>&nbsp;&nbsp;#'
+(communityview?patientid:'<a href="'+AH.GetGlobal('BASE_HREF')+'/client/clientsummary.esp?ID='
+patientid+'">'+patientid+'</a>')
+': '+data[i]['LASTNAME']+', '+
data[i]['FIRSTNAME']+' (DOB '+data[i]['DOB']+')';}
document.getElementById(divname).style.display='block';}}});}}
function ToggleFullSSN(ssnfieldname,alwaysshow){var escapedssnfieldname=EscapeJQuerySelector(ssnfieldname);var ssnfield=jQuery('[id="'+escapedssnfieldname+'"]').first();var maskedssnfield=jQuery('[id="'+escapedssnfieldname+'_masked'+'"]').first();var link=jQuery('[id="'+escapedssnfieldname+'_link'+'"]').first();if(link.html()!='Cancel'){link.prop('oldlinktext',link.html());link.html('Cancel');if(!ssnfield.attr('displayfullssn')&&!alwaysshow){ssnfield.val('');}
ssnfield.css('display','inline');maskedssnfield.css('display','none');}
else{link.html(link.prop('oldlinktext'));ssnfield.css('display','none');ssnfield.val(ssnfield.attr('previousvalue'));maskedssnfield.css('display','inline');ssnfield.change();}
return false;}
