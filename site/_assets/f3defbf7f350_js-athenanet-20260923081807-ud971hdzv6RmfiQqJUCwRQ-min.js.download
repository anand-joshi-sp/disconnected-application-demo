function ValidateSectionSelections(sectionName,sectionPrefix,sectionSelectionsComplete){var sectionItems=jQuery('[id^="'+EscapeJQuerySelector('DATARECONCILEITEM{'+sectionName+'}')+'"]').first().siblings();var selectedItems=jQuery(".datareconcileitemselected",sectionItems);var matchedItems=jQuery("[id*='INTERNAL'].datareconcileitemmatch",sectionItems);var itemLookup=GetDataRecObjectsFromHiddenFields(FindDataRecHiddenFieldElements());var noKnownValidation=ValidateNoKnownSectionSelections(selectedItems,matchedItems,itemLookup);if(!noKnownValidation){jQuery("#"+EscapeJQuerySelector('DATARECONCILEITEM{'+sectionName+'}{VALIDATIONWARNING}')).show();if(sectionSelectionsComplete){jQuery("#"+EscapeJQuerySelector(sectionPrefix.replace(/\{(DOCUMENT)}{\d+}{(NEW_)?\d+\}$/,'{SECTIONSTATUS}')))
