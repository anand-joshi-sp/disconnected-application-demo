grid-column6 patient-column\'>\n			<div class=\'patient-identification autostart\'>\n				<div class=\'briefing-link\'>\n					<div class=\'patient-photo-container placeholder {{SEX}} stm-facesheet-image\'>\n					</div>\n				</div>\n				<div class=\'patient-banner-information\'>\n					<div class=\'patient-name\'>\n						<span class=\'patient-name-first\'>{{FIRSTNAME}}</span>\n						{{#MIDDLEINITIAL}}<span class=\'patient-name-middle\'>{{MIDDLEINITIAL}}</span>{{/MIDDLEINITIAL}}\n						<span class=\'patient-name-last\'>{{LASTNAME}}{{#SUFFIX}},{{/SUFFIX}}</span>\n						{{#SUFFIX}}<span class=\'patient-name-suffix\'>{{SUFFIX}}</span>{{/SUFFIX}}\n					</div>\n					<div class=\'patient-demographic-items\'>\n						<span>{{#AGE}}{{AGE}}{{AGEUNITS}} {{/AGE}}{{SEX}}</span>\n						{{#DOB}}\n							<span class=\'vertical-separator-narrow\'></span>\n							<span class=\'birth-date\'>{{DOB}}</span>\n						{{/DOB}}\n						{{#ID}}\n							<span class=\'vertical-separator-narrow\'></span>\n							<span>#{{ID}}</span>\n						{{/ID}}\n						{{#ENTERPRISEPATIENTID}}\n							<span class=\'vertical-separator-narrow\'></span>\n							<span>E#{{ENTERPRISEPATIENTID}}</span>\n						{{/ENTERPRISEPATIENTID}}\n					</div>\n					<div class=\'icon-viewmore-banner demographics-icon\'>\n					</div>\n				</div>\n			</div>\n		</div>\n	</div>\n	<div class=\'demographics-container\'>\n		{{#DEMOGRAPHICS}}\n		<div class=\'demographics-category\'>\n			{{#ROWS}}\n			<div class=\'demographics-row {{#LAST}}subsection-last{{/LAST}}\'>\n				<div class=\'demographics-left\'> \n					<div class=\'demographics-title\'>\n						{{SECTIONNAME}}\n					</div>\n				</div>\n				<div class=\'demographics-right\'>\n					<div class=\'row-info {{#NONE}}none{{/NONE}}\'>\n						{{SECTIONINFO}}\n					</div>\n					<div class=\'row-label\'>\n						{{SECTIONLABEL}}\n					</div>\n				</div>\n			</div>\n			{{/ROWS}}\n		</div>\n		{{/DEMOGRAPHICS}}\n	</div>\n	<div class=\'grid-row briefing-patient\'>\n		<div class=\'grid-column6 left-side\'>\n			<div class=\'allergy-briefing autostart\'>\n				<div class=\'list-header\'>\n					<h3 class=\'list-header\'>Allergies</h3>\n				</div>\n				<ul class=\'encounter-list list-items\'>\n					{{#ALLERGIES}}<li>{{Name}}</li>{{/ALLERGIES}}\n					{{^ALLERGIES}}<li class=\'none-recorded\'>None recorded</li>{{/ALLERGIES}}\n				</ul>\n 			{{#HASALLERGIES}}\n 				<div class=\'stm-facesheet-timestamp\'>\n 					Updated on {{ALLERGIESTIMESTAMP}}\n 				</div>\n 			{{/HASALLERGIES}}\n			</div>\n		</div>\n		<div class=\'grid-column6 right-side\'>\n			<div class=\'encounter-briefing autostart\'>\n				<div class=\'list-header\'>\n					<h3 class=\'list-header\'>Last Visit</h3>\n				</div>\n				<div class=\'card-content\'>\n					<div class=\'summary\'>\n						<div>\n							{{#HASENCOUNTER}}\n							{{#ENCOUNTERSUMMARY}}\n								{{{ENCOUNTERSUMMARY}}}\n							{{/ENCOUNTERSUMMARY}}\n							{{^ENCOUNTERSUMMARY}}\n								<div class=\'primary\'>{{ENCOUNTERVISITNAME}}, {{ENCOUNTERDATE}}</div>\n								<div class=\'secondary\'></div>\n								<div class=\'detail\'>Performed by {{ENCOUNTERPROVIDERFIRSTNAME}} {{ENCOUNTERPROVIDERLASTNAME}}, {{ENCOUNTERPROVIDERPHONE}}</div>\n							{{/ENCOUNTERSUMMARY}}\n 								<div class=\'stm-facesheet-timestamp\'>Updated on {{ENCOUNTERTIMESTAMP}}</div>\n							{{/HASENCOUNTER}}\n							{{^HASENCOUNTER}}\n								<div class=\'primary none-recorded\'>None recorded</div>\n							{{/HASENCOUNTER}}\n						</div>\n					</div>\n				</div>\n			</div>\n		</div>\n		<div class=\'grid-column6 left-side\'>\n			<div class=\'problems-briefing autostart\'>\n				<div class=\'list-header\'>\n					<h3 class=\'list-header\'>Problems</h3>\n				</div>\n				<ul class=\'encounter-list list-items\'>\n					{{#PROBLEMS}}<li>{{Name}}</li>{{/PROBLEMS}}\n					{{^PROBLEMS}}<li class=\'none-recorded\'>None recorded</li>{{/PROBLEMS}}\n				</ul>\n 			{{#HASPROBLEMS}}\n 				<div class=\'stm-facesheet-timestamp\'>\n 					Updated on {{PROBLEMSTIMESTAMP}}\n 				</div>\n 			{{/HASPROBLE