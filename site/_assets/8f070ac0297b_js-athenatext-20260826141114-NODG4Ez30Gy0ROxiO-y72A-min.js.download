return states;};this.GroupCreationSuccessLoggingEventHandler=function(){_this.LogError({MESSAGE:'User \''+Config.USERNAME+'\' created a group with file upload'});};this.GroupCreationFailureLoggingEventHandler=function(){_this.LogError({MESSAGE:'User \''+Config.USERNAME+'\' attempt to create a group failed'});};this.ManageGroupSuccessLoggingEventHandler=function(){_this.LogError({MESSAGE:'User \''+Config.USERNAME+'\' edited a group with file upload'});};this.ManageGroupFailureLoggingEventHandler=function(){_this.LogError({MESSAGE:'User \''+Config.USERNAME+'\' attempt to edit a group failed'});};this.hiddenSTMCriticalErrorPanelEventHandler=function(uuid){_this.LogError({MESSAGE:'[Update] Critical Error Panel Seen: User maximized the athenaText application.',ORIGINATINGERROR:uuid});};};var AthenaText=function(){var model=new ModelClass();var view=new ViewClass({MODEL:model});var controller=new ControllerClass({VIEW:view});model.Error=new Error({ROOT:document.getElementById('error-root')});controller.bindEventBusEvents();controller.bindDocumentEvents();controller.bindPageEvents();controller.bindCrossFrameEvents();view.waitForFramesToLoad().always(function(){controller.InitializeNotificationWidget();if(Config.HASEPOCACCOUNT){model.AtextMobile=new AtextMobile({ROOT:document.getElementById('atext-mobile-root'),DISMISSEDMOBILEPANEL:controller.DismissedMobilePanel});model.stmApp=new STMLib.AppClass({ROOT:document.getElementById('athenatext-main'),SUBVIEWS:{ADDGROUPROOT:document.getElementById('add-group-root'),ADDGROUPHEADERROOT:document.getElementById('add-group-sub-header-root'),ADDPARTICIPANTROOT:document.getElementById('add-participant-root'),COLLEAGUEDETAILROOT:document.getElementById('colleague-detail-root'),COLLEAGUELISTROOT:document.getElementById('colleagues-list-root'),COLLEAGUELISTHEADERROOT:document.getElementById('colleagues-list-sub-header-root'),CONVERSATIONHEADERROOT:document.getElementById('conversation-sub-header-root'),CONVERSATIONLISTROOT:document.getElementById('conversation-list-root'),CONVERSATIONLISTHEADERROOT:document.getElementById('conversation-list-sub-header-root'),CONVERSATIONNEWMESSAGEROOT:document.getElementById('conversation-new-message-root'),CONVERSATIONROOT:document.getElementById('conversation-root'),DISMISSEDCONNECTIONREQUESTSLISTROOT:document.getElementById('dismissed-requests-root'),GROUPDETAILROOT:document.getElementById('group-detail-root'),GROUPDETAILHEADERROOT:document.getElementById('group-detail-sub-header-root'),IDENTITYROOT:document.getElementById('identity-root'),MANAGEGROUPHEADERROOT:document.getElementById('manage-group-sub-header-root'),MANAGEGROUPROOT:document.getElementById('manage-group-root'),PUBLICPROFILEROOT:document.getElementById('public-profile-root'),USERPROFILEROOT:document.getElementById('userprofile-root'),EDITUSERPROFILEROOT:document.getElementById('edit-userprofile-root'),PDINVITEPANELROOT:document.getElementById('pd-invite-panel-root'),MANUALINVITEPANELROOT:document.getElementById('manual-invite-panel-root')},SERVICES:controller.AthenaTextServices,CONFIG:Config});view.getTopFrameBodyJQuery().bind('SESSION.UNLOCKED',controller.SessionUnlockedHandler);view.getTopFrameBodyJQuery().bind('SESSION.LOCKED',controller.SessionLockedHandler);}else{model.Welcome=new Welcome({ROOT:document.getElementById('welcome-root'),SAWWELCOMEPANEL:controller.SawWelcomePanel,UPDATEEMAILADDRESS:controller.UpdateEmailAddress,NOACCOUNT:true,NEEDSINFO:Config.NEEDSINFOFOREPOCACCOUNT,ISEMAILUNIQUE:Config.ISEMAILUNIQUE,EMAIL:Config.EMAIL});model.displayNewMessageNotifications=true;view.displayContent({CONTENTSELECTOR:'#welcome-root',HEADERSELECTOR:'#welcome-header',FOOTERSELECTOR:'#welcome-footer'});if(Config.NEEDSINFOFOREPOCACCOUNT){view.setUnreadMessageCount({UNREADMESSAGECOUNT:'?'});}
if((Config.NEEDSINFOFOREPOCACCOUNT||!Config.ISEMAILUNIQUE)&&Config.SHOWNEEDSINFONOTIFICATION){view.publishNotification({HEADER:'Welcome to athenaText',BODY:'Click the chat bubble below to begin.',MESSAGEID:STMLib.Constants.NotificationIds.NeedsInfo,ONCLICK:controller.SawNeedsInfoNotification,ONCLOSE:controller.SawNeedsInfoNotification});EventBus.Publish('Notification.NeedsInfo');}}});var uuidFromCookie=STMLib.Utils.GetBrowserUUID();if(uuidFromCookie===undefined){STMLib.Utils.SetBrowserUUID(STMLib.Utils.GenerateUUID());}
var uuidFromStorage=STMLib.Utils.GetTabUUID();if(uuidFromStorage===null){STMLib.Utils.SetTabUUID(STMLib.Utils.GenerateUUID());}};return AthenaText;});
