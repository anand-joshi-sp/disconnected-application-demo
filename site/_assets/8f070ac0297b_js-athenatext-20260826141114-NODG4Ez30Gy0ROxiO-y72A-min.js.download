',[],function(){'use strict';return'<div class=\'stm-form stm-edit-userprofile\'>\n	<hr class=\'stm-form-hr\' />\n	{{#IsMDDO}}\n	{{#IsOptedIntoPD}}\n	<div class=\'stm-form-attention\'>Your profile is public and any changes made will be viewable by others in the Provider Directory. None of your changes will be reflected in athenaNet.</div>\n	{{/IsOptedIntoPD}}\n	{{^IsOptedIntoPD}}\n	<div class=\'stm-form-attention\'>You opted out of the Provider Directory and all of your information is private. None of your changes will be reflected in athenaNet.</div>\n	{{/IsOptedIntoPD}}\n	<hr class=\'stm-form-hr\' />\n	{{/IsMDDO}}\n	<div class=\'stm-form-section\'>\n		<div class=\'stm-form-section-header\'>Basic Information</div>\n		<div class=\'stm-form-avatar\'></div>\n		<div id=\'stm-edit-userprofile-name-section\' class=\'stm-form-section-twocol\'>\n			<div class=\'stm-form-label\'>First name</div>\n			<span class=\'stm-form-readonly\'>{{FirstName}}</span>\n			<div class=\'stm-form-label\'>Last name</div>\n			<span class=\'stm-form-readonly\'>{{LastName}}</span>\n		</div>\n		<div class=\'stm-form-section-subheader\'>Specialities</div>\n		<hr class=\'stm-form-section-hr\' />\n		<div id=\'stm-edit-userprofile-specialty-section\' class=\'stm-form-section-twocol\'></div>\n		<div class=\'stm-form-section-linkbutton stm-form-section__hidden\' id=\'stm-edit-userprofile-specialty-sub-link\'>\n			<span class=\'sprite-streamlined-add-small stm-form-section-linkbutton__icon\'></span><span class=\'stm-form-section-linkbutton__text\'>SPECIALTY</span>\n		</div>\n		<div id=\'stm-edit-userprofile-specialty-sub-section\' class=\'stm-form-section-twocol stm-form-section__hidden\'></div>\n		{{#IsMDDO}}\n		<div class=\'stm-form-section-subheader\'>Foreign Languages Spoken</div>\n		<hr class=\'stm-form-section-hr\' />\n		<div id=\'stm-edit-userprofile-language-section\' class=\'stm-form-section-twocol\'></div>\n		<div class=\'stm-form-section-linkbutton\' id=\'stm-edit-userprofile-language-link\'>\n			<span class=\'sprite-streamlined-add-small stm-form-section-linkbutton__icon\'></span><span class=\'stm-form-section-linkbutton__text\'>LANGUAGE</span>\n		</div>\n		{{/IsMDDO}}\n	</div>\n	<div class=\'stm-form-section\'>\n		<hr class=\'stm-form-section-hr\' />\n		<div class=\'stm-form-section-header\'>Contact Information</div>\n		<div class=\'stm-form-section-note\'>To change your email address or mobile number, call the CSC.</div>\n		<div class=\'stm-form-section-twocol\'>\n			<div class=\'stm-form-label\'>Email</div>\n			<span class=\'stm-form-readonly\'>{{Email}}</span>\n			<div class=\'stm-form-label\'>Mobile</div>\n			{{#MobilePhone}}\n			<span class=\'stm-form-readonly\'>{{#FormatPhoneNumber}}{{MobilePhone}}{{/FormatPhoneNumber}}</span>\n			{{/MobilePhone}}\n			{{^MobilePhone}}\n			<span class=\'stm-form-readonly\'>None</span>\n			{{/MobilePhone}}\n		</div>\n	</div>\n	{{#IsMDDO}}\n	<div class=\'stm-form-section\'>\n		<hr class=\'stm-form-section-hr\' />\n		<div class=\'stm-form-section-header\'>Clinical Interests</div>\n		<div id=\'stm-edit-userprofile-clinicalinterests-section\' class=\'stm-form-section-onecol\'></div>\n	</div>\n	{{/IsMDDO}}\n	<div class=\'stm-form-section\'>\n		<hr class=\'stm-form-section-hr\' />\n		<div class=\'stm-form-section-header\'>Practice Info</div>\n		<div class=\'stm-form-section-subheader\'>Place of Employment</div>\n		<hr class=\'stm-form-section-hr\' />\n		<div id=\'stm-edit-userprofile-practice-section\' class=\'stm-form-section-twocol\'></div>\n		{{#IsMDDO}}\n		<div class=\'stm-form-section-subheader\'>Accepted Insurance</div>\n		<hr class=\'stm-form-section-hr\' />\n		<div id=\'stm-edit-userprofile-insurance-section\' class=\'stm-form-section-twocol\'></div>\n		<div id=\'stm-edit-userprofile-insurance-link\' class=\'stm-form-section-linkbutton\'>\n			<span class=\'sprite-streamlined-add-small stm-form-section-linkbutton__icon\'></span><span class=\'stm-form-section-linkbutton__text\'>INSURANCE</span>\n		</div>\n		<div c