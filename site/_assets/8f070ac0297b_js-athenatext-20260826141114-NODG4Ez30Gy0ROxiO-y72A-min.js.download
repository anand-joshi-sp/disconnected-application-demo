>\n				<div class=\'stm-modal-title\'>No message content</div>\n				<hr class=\'stm-modal-title__hr\'>\n				<div class=\'stm-invitation-modal-message\'>Do you want to send this invitation without a message?</div>\n				<div class=\'stm-invitation-modal-buttons\'>\n					<button class=\'stm-button stm-action-confirmation-yes\' type=\'button\'>Yes</button>\n					<button class=\'stm-button stm-action-confirmation-no\' type=\'button\'>No</button>\n				</div>\n			</div>\n		</div>\n	</div>\n</div>\n'});define('shared:/templates/stm/manage-group-header',[],function(){'use strict';return'<div id=\'stm-manage-group-header\' class=\'subscribers-BeginEditGroupEvent\'>\n	<hr id=\'stm-header-top\'>\n	<div class=\'stm-group-name-wrapper\'>\n		<input type=\'text\' id=\'stm-group-name-input\' maxlength=\'250\'>\n		<span title=\'Delete group\' class=\'icon-streamlined-delete\' id=\'stm-delete-group-link\'></span>\n		<div id=\'stm-group-name-error-text\'></div>\n	</div>\n	<div id=\'stm-manage-group-add-contact-wrapper\' class=\'stm-filter-contacts\'>\n	</div>\n	{{#SHOW_FILE_UPLOAD}}\n	<div id=\'stm-manage-group-fileupload\'>\n        <input id=\'stm-manage-file-name\' type=\'file\' maxlength=\'21\'>\n		 <p>Or<br>\n		<a href=\"\" class= \'stm-group-empty-label\' id=\'stm-manage-file-name-link\'>Upload a file </a>with contacts.</p>\n    </div>\n    {{/SHOW_FILE_UPLOAD}}\n	<input title=\'Delete group\' type=\'button\' class=\'stm-button\' id=\'stm-delete-group-button\' value=\'Delete Group\'></button>\n	\n</div>\n'});define('shared:/templates/stm/manage-group',[],function(){'use strict';return'<div class=\'stm-manage-group subscribers-BeginEditGroupEvent stm-edit-group\'>\n	<ul class=\'stm-colleague-list-wrapper\' id=\'stm-group-members-list\'></ul>\n</div>\n<div class=\'stm-modal stm-manage-group-update-failed-modal\'>\n	<div class=\'stm-modal-overlay\'>&nbsp;</div>\n	<div class=\'stm-modal-vertical-offset stm-modal-group\'>\n		<div class=\'stm-modal-content\'>\n			<div class=\'stm-modal