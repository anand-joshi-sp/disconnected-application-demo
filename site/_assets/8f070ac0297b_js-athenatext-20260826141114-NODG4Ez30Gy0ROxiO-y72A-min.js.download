'stm-notification fonts-default\' id=\'{{messageID}}\' data-thread-id=\'{{threadID}}\' data-colleague-id=\'{{colleagueID}}\'>\n	<div class=\'stm-notification-close icon-streamlined-delete-inline\'></div>\n	{{#isWelcomeNotification}}\n		<div class=\'stm-notification-header\' id=\'stm-notification-welcome-header\'>Welcome to athenaText</div>\n	{{/isWelcomeNotification}}\n	{{^isWelcomeNotification}}\n		<div class=\'stm-notification-header\'>{{headerText}}</div>\n	{{/isWelcomeNotification}}\n	<div class=\'stm-notification-message\' id=\'stm-notification-message-main\'>{{{messageHTML}}}</div>\n	{{#isWelcomeNotification}}\n		<div class=\'stm-notification-message\' id=\'stm-notification-message-welcome\'>Click the athenaText icon below to begin.</div>\n	{{/isWelcomeNotification}}\n</div>\n'});define('shared:/templates/stm/pd-invite-panel',[],function(){'use strict';return'<hr class=\'stm-pd-invite-panel\' />\n<div class=\'stm-pd-invite-wrapper\'>\n	<div class=\'stm-message-success stm-pd-invite-result\'></div>\n	<div class=\'stm-message-error stm-pd-invite-error stm-message-wrapper\'></div>\n	<div class=\'stm-invite-description\'>Search our national Provider Directory to invite colleagues outside of your practice.</div>\n		<form name=\'stm-pd-search-form\' class=\"stm-pd-invite-panel-form\">\n			<ul class=\'stm-providerdirectory-searchresults ui-autocomplete ui-menu ui-widget ui-widget-content ui-corner-all stm-custom-autocomplete\' />\n			<textarea id=\'stm-pd-invitation-message\' data-preventtab=\'1\' class=\'stm-personalized-invitation\'>{{placeholderInviteMessage}}</textarea>\n			<div class=\'stm-pd-invite-panel-text-small\'>Please do not include protected health information.</div>\n			<input type=\'submit\' id=\'stm-invite-button\' value=\'Invite\' class=\'stm-button disabled\' data-preventtab=\'1\' disabled />\n		</form>\n</div>\n<hr class=\'stm-pd-invite-panel\' />\n<div class=\'stm-manual-invite-nudge-wrapper\'>\n	<div class=\"stm-manual-invite-text-small\">Can&apos;t find someone?</div>\n	<span class=\'stm-manual-invite-panel-link stm-manual-invite-panel-link-small\' id=\'stm-manual-invite-panel-link\'>Invite them by email</span>\n</div>\n<div id=\'stm-modal-dialog\' class=\"stm-modal stm-invite-error\">\n	<div class=\"stm-modal-overlay\">\n		&nbsp;\n	</div>\n	<div class=\"stm-modal-vertical-offset\">\n		<div class=\"stm-modal-content\">\n			<div id=\'stm-modal-dialog-header\' class=\'stm-dialog-header\' />\n			<hr />\n			<div id=\'stm-modal-dialog-message\' class=\'stm-dialog-message\' />	\n			<div id=\'stm-modal-button-container\' class=\'stm-dialog-button-panel\' />\n		</div>\n	</div>\n</div>\n'});define('shared:/templates/stm/pd-profile',[],function(){'use strict';return'<div class=\'stm-pdprofile\'>\n	<div class=\'stm-pdprofile-header\'>\n		{{#IsMDDO}}\n		<div class=\'stm-pdprofile-header-mddo\'>\n			<div class=\'stm-message-info\'>Keep your Provider Directory profile up to date to easily connect with colleagues for consultations and referrals.</div>\n			<hr class=\'stm-pdprofile-header__border\' />\n		</div>\n		{{/IsMDDO}}\n		<div class=\'stm-pdprofile-header-avatar\'></div>\n		<div class=\'stm-pdprofile-header-name\'>{{Name}}</div>\n		<div class=\'stm-pdprofile-header-specialty\'>\n			{{Specialty}}{{#SubSpecialty}}<span>, {{SubSpecialty}}</span>{{/SubSpecialty}}\n		</div>\n		<div class=\'stm-pdprofile-header-practicename\'>{{PracticeName}}</div>\n		<div class=\'stm-pdprofile-header-location\'>{{PracticeLocation}}</div>\n		<hr class=\'stm-pdprofile-header__border\' />\n	</div>\n	<div class=\'stm-pdprofile-section\'>\n		<div class=\'stm-pdprofile-section__header\'>Contact Information</div>\n		<div class=\'stm-pdprofile-section__note\'>Will not appear in the Provider Directory.</div>\n		<div class=\'stm-pdprofile-section__subheader\'>Email</div>\n		<div class=\'stm-pdprofile-section__value\'>{{Email}}</div>\n		{{#MobilePhone}}\n		<div class=\'stm-pdprofile-section__subheader\'>Mobile number</div>\n		<div class=\'stm-pdprofile-section__value\'>{{#FormatPhoneNumber}}{{MobilePhone}}{{/FormatPhoneNumber}}</div>\n		{{/MobilePhone}}\n	</div>\n	<hr class=\'stm-pdprofile-section__border\'>\n	{{#IsMDDO}}\n	<div class=\'stm-pdprofile-section\'>\n		<div class=\'stm-pdprofile-section__header\'>Foreign Languages Spoken</div>\n		{{#Languages}}\n		<div class=\'stm-pdprofile-section__value\'>{{.}}</div>\n		{{/Languages}}\n		{{^Languages}}\n		<div class=\'stm-pdprofile-section__note\'>None</div>\n		{{/Languages}}\n	</div>\n	<hr class=\'stm-pdprofile-section__border\'>\n	<div class=\'stm-pdprofile-section\'>\n		<div class=\'stm-pdprofile-section__header\'>Clinical Interests</div>\n		{{#ClinicalInterests}}\n		<div class=\'stm-pdprofile-section__value\'>{{ClinicalInterests}}</div>\n		{{/ClinicalInterests}}\n		{{^ClinicalInterests}}\n		<div class=\'stm-pdprofile-section__note\'>None</div>\n		{{/ClinicalInterests}}\n	</div>\n	<hr class=\'stm-pdprofile-section__border\'>\n	<div class=\'stm-pdprofile-section\'>\n		<div class=\'stm-pdprofile-section__header\'>Practice Information</div>\n		{{^HasPracticeInfo}}\n		<div class=\'stm-pdprofile-section__note\'>None</div>\n		{{/HasPracticeInfo}}\n		{{#HasPracticeInfo}}\n		{{#HasPracticeContactInfo}}\n		<div class=\'stm-pdprofile-section__subheader\'>Place of Employment</div>\n		<div class=\'stm-pdprofile-section__value\'>{{PracticeName}}</div>\n		<div class=\'stm-pdprofile-section__value\'>{{PracticeAddress}}</div>\n		<div class=\'stm-pdprofile-section__value\'>{{PracticeLocation}}</div>\n		{{/HasPracticeContactInfo}}\n		{{#PracticePhone}}\n		<div class=\'stm-pdprofile-section__value\'>Phone: {{#FormatPhoneNumber}}{{PracticePhone}}{{/FormatPhoneNumber}}</div>\n		{{/PracticePhone}}\n		{{#PracticeFax}}\n		<div class=\'stm-pdprofile-section__value\'>Fax: {{#FormatPhoneNumber}}{{PracticeFax}}{{/FormatPhoneNumber}}</div>\n		{{/PracticeFax}}\n		<div class=\'stm-pdprofile-section__value\'>{{Website}}</div>\n		{{#HasPracticeType}}\n		<div class=\'stm-pdprofile-section__spacer\'></div>\n		<div class=\'stm-pdprofile-section__value\'>{{PracticeType}}</div>\n		{{/HasPracticeType}}\n		{{#IsAcceptingNewPatients}}\n		<div class=\'stm-pdprofile-section__value\'>Accepting new patients</div>\n		{{/IsAcceptingNewPatients}}\n		{{^IsAcceptingNewPatients}}\n		<div class=\'stm-pdprofile-section__value\'>Not accepting new patients</div>\n		{{/IsAcceptingNewPatients}}\n		{{#HasInsurncesAccepted}}\n		<div class=\'stm-pdprofile-section__subheader\'>Insurances Accepted</div>\n		{{#InsurancesAccepted}}\n		<div class=\'stm-pdprofile-section__value\'>{{.}}</div>\n		{{/InsurancesAccepted}}\n		{{/HasInsurncesAccepted}}\n		{{#HasHospitalAffiliations}}\n		<div class=\'stm-pdprofile-section__subheader\'>Hospital Affiliations</div>\n		{{#HospitalAffiliations}}\n		<div class=\'stm-pdprofile-section__value\'>{{.}}</div>\n		{{/HospitalAffiliations}}\n		{{/HasHospitalAffiliations}}\n		{{/HasPracticeInfo}}\n	</div>\n	<hr class=\'stm-pdprofile-section__border\'>\n	<div class=\'stm-pdprofile-section\'>\n		<div class=\'stm-pdprofile-section__header\'>Education & Training</div>\n		{{^HasEducationTraining}}\n		<div class=\'stm-pdprofile-section__note\'>None</div>\n		{{/HasEducationTraining}}\n		{{#HasEducationTraining}}\n		{{#HasProfessionalOrganizations}}\n		<div class=\'stm-pdprofile-section__subheader\'>Professional Organizations</div>\n		{{#ProfessionalOrganizations}}\n		<div class=\'stm-pdprofile-section__value\'>{{.}}</div>\n		{{/ProfessionalOrganizations}}\n		{{/HasProfessionalOrganizations}}\n		{{#HasResidencies}}\n		<div class=\'stm-pdprofile-section__subheader\'>Residencies</div>\n		{{#Residencies}}\n		<div class=\'stm-pdprofile-section__value\'>{{residencyName}}</div>\n		{{/Residencies}}\n		{{/HasResidencies}}\n		{{#HasMedicalSchool}}\n		<div class=\'stm-pdprofile-section__subheader\'>Medical School</div>\n		<div class=\'stm-pdprofile-section__value\'>{{MedicalSchool}}</div>\n		{{#HasGraduationYear}}\n		<div class=\'stm-pdprofile-section__value\'>{{GraduationYear}}</div>\n		{{/HasGraduationYear}}\n		{{/HasMedicalSchool}}\n\n		{{/HasEducationTraining}}\n	</div>\n	<hr class=\'stm-pdprofile-section__border\'>\n	{{/IsMDDO}}\n</div>\n'});define('shared:/templates/stm/pd-search-error-message',[],function(){'use strict';return'<{{domElement}} class=\'stm-pd-search-results stm-pd-search-error\'>{{message}}</{{domElement}}>\n'});define('shared:/templates/stm/pd-search-feedback-message',[],function(){'use strict';return'<{{domElement}} class=\'stm-pd-search-results message\'>Type {{minLength}} letters to start searching.</{{domElement}}>\n'});define('shared:/templates/stm/pd-search-spinner',[],function(){'use strict';return'<{{domElement}} class=\'stm-spinner-backdrop spinner stm-pd-search-results\'>&nbsp;</{{domElement}}>\n'});define('shared:/templates/stm/pending-colleague',[],function(){'use strict';return'<li class=\'stm-pending-colleague\' data-colleague-id=\'{{userId}}\'>\n	<div class=\'stm-pending-colleague-item\'>\n		<div class=\'stm-pending-colleague-avatar\'>\n			<div class=\'stm-pd-person-avatar\'></div>\n		</div>\n		<div class=\'stm-pending-colleague-details\'>\n			<div class=\'stm-pd-person-details\'>\n				<div class=\'stm-pd-person-name\'>{{name}}</div>\n				{{#hasSpecialty}}\n					<div class=\'stm-pd-person-specialty\'>{{userDetails}}</div>\n				{{/hasSpecialty}}\n				{{#invitationMessage}}\n					<div class=\'stm-pd-message-preview\'>{{invitationMessagePreview}}</div>\n				{{/invitationMessage}}\n			</div>\n		</div>\n	</div>\n	<div class=\'stm-invite-details\'>\n	{{#invitationMessage}}\n		<div class=\'stm-pd-message-full\'>{{invitationMessage}}</div>\n	{{/invitationMessage}}\n	<div class=\'stm-pd-message-metadata\'>\n		Sent via\n	{{#hasInviteDetails}}\n		{{invitationMethod}}\n	{{/hasInviteDetails}}\n	{{^hasInviteDetails}}\n			athenaText\n	{{/hasInviteDetails}}\n		<span class=\'vertical-separator-narrow\' />\n		{{invitationDate}}\n	</div>\n</li>\n'});define('shared:/templates/stm/pending-connection-request',[],funct