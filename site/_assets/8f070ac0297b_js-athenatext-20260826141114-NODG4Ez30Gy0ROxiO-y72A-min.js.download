tle__hr\'>\n                        <p class=\'stm-add-group-errors\'>Are you sure you want to discard the contacts you added ?</p>\n                        <button id=\'stm-manage-group-discard-modal-button-ok\' class=\'stm-button\' type=\'button\'>OK</button>\n                        <button id=\'stm-manage-group-discard-modal-button-cancel\' class=\'stm-button\' type=\'button\'>Cancel</button>\n                </div>\n        </div>\n</div>\n<div class=\'stm-modal stm-manage-group-confirm-modal\'>\n        <div class=\'stm-modal-overlay\'>&nbsp;</div>\n        <div class=\'stm-modal-vertical-offset stm-modal-group\'>\n                <div class=\'stm-modal-content\'>\n                        <div class=\'stm-modal-title\'>Group Confirmation Message</div>\n                        <hr class=\'stm-modal-title__hr\'>\n                        <p class=\'stm-manage-group-errors\'>The request has been processed. The status of each user is available in the file.</p>\n                        <button id=\'stm-manage-group-confirm-modal-button-ok\' class=\'stm-button\' type=\'button\'>OK</button>\n                </div>\n        </div>\n</div>\n\n'});define('shared:/templates/stm/manual-invite-panel',[],function(){'use strict';return'<hr class=\"stm-manual-invite-panel\" />\n<div class=\'stm-manual-invite-wrapper\'>\n	<form name=\'stm-manual-invite-form\'>\n		<div class=\'stm-message-success stm-manual-invite-result\'></div>\n		<div class=\'stm-message-error stm-manual-invite-error\'></div>\n		<div class=\"stm-invite-description\">Expand your care coordination network by inviting colleagues outside of your practice.</div>\n		<input id=\'stm-manual-invite-name\' type=\'text\' class=\'stm-wide-input\' placeholder=\'Name\' data-preventtab=\'1\' />	\n		<div id=\'stm-invite-name-error\' class=\'stm-validation-error\'>A colleague name is required.</div> \n		<input id=\'stm-manual-invite-contact\' type=\'text\' class=\'stm-wide-input\' placeholder=\'Email\' data-preventtab=\'1\' /