function getFhirRefreshToken(tokenData,tokenRefreshCallback){var configData=oneChartData.configData;var isSessionLocked=top.AH.GetGlobal("SESSIONLOCKED");var headers={"Content-Type":"application/json",accountId:tokenData.accountId}
