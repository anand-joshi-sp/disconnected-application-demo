function getInsightsUrl(appName,projectId,dashboardPath){var insightsEnvironment={dev:'https://insights.dev.web.athena.io/'+appName+'/',stage:'https://insights.int.web.athena.io/'+appName+'/',prod:'https://insights.web.athena.io/'+appName+'/'}
var athenaHost=window.location.hostname;var environment={'dev':insightsEnvironment.dev,'stage.athenahealth.com':insightsEnvironment.stage,'other':insightsEnvironment.stage,'prodmirror.athenahealth.com':insightsEnvironment.stage,'athenanet.athenahealth.com':insightsEnvironment.prod};var development=/^dev([0-9]{0,4}).athenahealth.com/;if(development.test(athenaHost)){athenaHost='dev';}else if(!environment[athenaHost]){athenaHost='other';}
var virtualPath='/home';if(athenaHost=='other'){virtualPath=projectId+'/dashboard/view/9553101b-dbe6-4d7c-a27e-0b14e95843e3'}else if(dashboardPath){virtualPath=projectId+dashboardPath;}
return environment[athenaHost]+AH.Frames.GlobalNav.GetGlobal('contextid')+virtualPath;}
function commonRedirection(dashboardPath,projectId,source){Promise.all([CallRemote({SUB:'Reports::Insights::GetUserTypeOrIDP',ARGS:{}})]).then(function(result){if(result[0].RESPONSE){var url=getInsightsUrl('data-visualization',projectId,dashboardPath);var windows=window.open(url+'?idp='+result[0].RESPONSE+'&source='+source);if(windows){windows.focus();}}});}
function ShowMenu(menuName,xpos,ypos){if(menuName=='ActionMenu'&&!AH.GetGlobal('PATIENTID')>0){menuName='InactionMenu';}
var menuheading=menuName.replace('Menu','');if(!xpos||!ypos){var jqmenuspan=jQuery(AH.Frames.GlobalNav.getElementById(menuName+"Image"));if(jqmenuspan.length){xpos=jqmenuspan.offset().left-jQuery(window).scrollLeft();ypos=jqmenuspan.offset().top-jQuery(window).scrollTop()+22;}
else{xpos=0;ypos=0;}}
AH.Frames.Top.Frame().DisplayMenu(xpos,ypos,menuheading,menuitems[menuheading]);}
function MenuClickHandler(menuheading,item,evt){var url=menuurls[menuheading][item-1];var menuitem=menuitems[menuheading][item-1];var targetframe;var chromeHack=(IsChrome()&&AH.GetGlobal("arrivedFromAirlock")&&!AH.GetGlobal('didChromeMenuDelay'))?1:0;var airlockChromeWorkaroundDelay=1000;if(chromeHack){AH.SetGlobal('didChromeMenuDelay',1);}
if(url=='CANCEL'){return;}
else if(url=='HELP'){alert("Note: You can access context-sensitive help in athenaNet by pressing F1 on virtually any screen.");if(chromeHack){setTimeout(AthenaNetHelp,airlockChromeWorkaroundDelay);}
else{AthenaNetHelp();}}
else if(url=='HELPNOWARNING'){if(chromeHack){setTimeout(AthenaNetHelp,airlockChromeWorkaroundDelay);}
else{AthenaNetHelp();}}
else if(url=='practiceswitcher'){if(chromeHack){setTimeout(PracticeSwitcher,airlockChromeWorkaroundDelay);}
else{PracticeSwitcher();}}
else if(url=='LOGOUT'){LogOut();}
else if(url=='LEARNINGPORTAL'){if(chromeHack){setTimeout(OpenLearningPortal,airlockChromeWorkaroundDelay);}
else{OpenLearningPortal();}}
else if(url=='SCREENSHARING'){if(chromeHack){setTimeout(OpenScreenSharing,airlockChromeWorkaroundDelay);}
else{OpenScreenSharing();}}
else if(url=='/csc/cscunifiedclientsupport.esp'){if(chromeHack){setTimeout(NewClientSupport,airlockChromeWorkaroundDelay);}
else{NewClientSupport();}}
else if(url=='PATIENTSAFETYREPORTING'){if(chromeHack){setTimeout(OpenPatientSafetyReporting,airlockChromeWorkaroundDelay);}
else{OpenPatientSafetyReporting();}}
else if(url=='SHOWCLINICALSPATIENTMENU'){ShowMenu("ClinicalsActionMenu");}
else if(menuheading=='GlobalNav'){ShowMenu(url);}
else if(menuheading=='Find'){eval(url);}
else if(url=='/schedule/schedulenav.esp'||url=='/billing/claimattachmenterrormatchnav.esp'||url=='/billing/claimchecknav.esp'||url=='/billing/unpostablemenunav.esp'||url=='/clinicals/chartabstractionnav.esp'||url=='/reports/reportinbox.esp'||url=='/mdp/ssodashboard.esp'||url=='/schedule/appointmentticklerworklist.esp'||url.match(/\/clinicalsadmin\/documentqueue\.esp\?MINE=1/)||url.match(/\/clinicalsadmin\/faxpagegroupqueue\.esp\?USERVIEW=1/)||url.match(/\/clinicalsadmin\/labanalyteentryqueue\.esp\?USERVIEW=1/)||url.match(/^\/partners\//)||(menuheading=='Athena'&&url.match(/^\/athenanav\.esp\?RESOURCETYPE=/))||menuheading=='Admin'){targetframe=AH.Frames.ScheduleNav.Frame();if(evt&&evt.arrivedFromAirlock){AH.SetGlobal('arrivedFromAirlock',1);}}
else if(url.match(/community(%2Duat)?%2Eathenahealth/)){if(chromeHack){setTimeout(function(){OpenSuggestionCommunityBoard(url);},airlockChromeWorkaroundDelay);}
else{OpenSuggestionCommunityBoard(url);}}
else if(url.match(/^https?:\/\//)){AH.Frames.Top.SetLocation(url);return;}
else if(url=='/client/labelssingle.esp?'){MediumModalPopupWindow({page:AH.GetGlobal('BASE_HREF')+url+'PATIENTID='+AH.GetGlobal('PATIENTID')});return;}
else{targetframe=AH.Frames.Main.Frame();}
if(evt&&evt.altKey){if(url=='/billing/unpostablemenunav.esp'||url=='/athenanav.esp?RESOURCETYPE=Posting'){url+=url.indexOf('?')>=0?'&':'?';url+='ALTKEY=1';}}
if(menuheading=='Action'){url+='&PATIENTID='+AH.GetGlobal('PATIENTID');url+='&CHARTID='+GetChartID();if(AH.GetGlobal('DEPARTMENTID')>0){url+='&DEPARTMENTID='+AH.GetGlobal('DEPARTMENTID');}}
if(menuheading=='ClinicalsAction'){url+='PATIENTID='+AH.GetGlobal('PATIENTID');url+='&CHARTID='+GetChartID();if(menuitem=='New Patient Case'||menuitem=='New Order Group'){if(menuitem=='New Order Group'){menuitem='New Order';}
var taburl=url;url='/clinicals/charttabs.esp?PATIENTID='+AH.GetGlobal('PATIENTID')
+'&CHARTID='+GetChartID()
+'&ID='+menuitem
+'&TITLE='+menuitem
+'&URL='+escape(taburl);}}
if(targetframe){if(!url.match(/^http/)&&!url.match(/^\/[0-9]+\/[0-9]+\//)&&!url.match(/^\/queue/)&&!url.match(/^\/warehouse/)&&!url.match(/^\/providerdirectory/)){url=AH.PrependBasePath(url);}
ProtectRedirect(targetframe,url);}}
function OpenLearningPortal(){var learnurl=AH.PrependBasePath('/message/cornerstonehome.esp');var win=window.open(learnurl,'LearningPortal','height=700, width=1100,toolbar=no,directories=no,menubar=no, resizable=yes,scrollbars=yes,status=1');win.focus();return false;}
function OpenStreamlinedPage(url){redirectToAirlock(buildAirlockURL({'url':url}));return false;}
function OpenOllieChat(source){if(window.DD_RUM){try{window.DD_RUM.onReady(function(){window.DD_RUM.addAction("OllieChatOpened",{source:source||'menu'});});}catch(error){}}
window.top.dispatchEvent(new CustomEvent('open-ollie-chat'));return false;}
function OpenScreenSharing(){var screenshareurl=AH.PrependBasePath('/help/screenshare.esp');var ScreenShareWindow=window.open(screenshareurl,'ScreenSharing','titlebar=0, directories=no, location=no, menubar=no, status=yes, toolbar=no, height=360, width=480, scrollbars=no, resizable=yes');ScreenShareWindow.focus();return false;}
function OpenSuggestionCommunityBoard(url){var win=window.open(url,'BoardTransition');win.focus();return false;}
function OpenCoordinatorReports(){var page=AH.PrependBasePath('/coordinator/standalone/reports.esp');var title=window.parent.document.title;var url=AH.PrependBasePath('/help/modaliframe.esp?PAGE='+page+'&TITLE'+title+'&WIDTH=800&HEIGHT=800');var win=window.open(url,'CoordinatorReports','resizable=1,scrollbars=1');win.focus();return false;}
function OpenPatientSafetyReporting(){var patientsafetyurl=AH.PrependBasePath('/clinicals/patientsafetyreporting.esp');window.open(patientsafetyurl);return false;}
function _AllowHyphenDOBSearch(){return!!document.getElementById('allow-hyphenated-patient-dob-search');}
function _IsHyphenatedDOBSearch(findtext){return _AllowHyphenDOBSearch()&&findtext.indexOf('-')!=-1&&TrimWhitespace(findtext).match(/^\d{1,2}-\d{1,2}-?\d{0,4}$/);}
function _NormalizeHyphenatedDOBSearch(findtext){findtext=TrimWhitespace(findtext);if(findtext.match(/^\d{1,2}-\d{1,2}$/)){findtext+='-'+new Date().getFullYear();}
return findtext.replace(/-/g,'/');}
function FormatFind(e){var event=e||window.event;if(document.zform.findtext.value==''){}
else if(document.zform.findtext.value.indexOf('/')!=-1||_IsHyphenatedDOBSearch(document.zform.findtext.value)){document.zform.filtertype.value='DOB';}
else if(isNaN(document.zform.findtext.value)&&!document.zform.findtext.value.match(/^\s*\d+A\d*\s*$/i)){if(document.zform.filtertype.value!='PHONE'&&document.zform.filtertype.value!='SSN'&&document.zform.filtertype.value!='GUARANTORNAME'){document.zform.filtertype.value='NAME';}}
else if(document.zform.filtertype.value!='SSN'&&document.zform.filtertype.value!='PHONE'&&document.zform.filtertype.value!='DOB'&&document.zform.filtertype.value!='ID'){document.zform.filtertype.value='ID';}
if(document.zform.filtertype.value=='DOB'){if(_IsHyphenatedDOBSearch(document.zform.findtext.value)){document.zform.findtext.value=_NormalizeHyphenatedDOBSearch(document.zform.findtext.value);}
else{FormatDate(event);}}}
function FindClient(){document.zform.findtext.value=document.zform.findtext.value.toUpperCase();if(TrimWhitespace(document.zform.findtext.value)==''){alert("\'Find text field\' cannot be left blank");return false;}
var strippedfindtext=document.zform.findtext.value.replace(/[(),.' -]+/g,'');if(strippedfindtext==''){alert("\'Find text field\' must contain at least one alphanumeric character");return false;}
if(document.zform.filtertype.value=='DOB'){if(!SetDate(-100,document.zform.findtext)){return false;}
if(!IsDate(document.zform.findtext.value)){alert("The date "+document.zform.findtext.value+" is invalid.");return false;}}
if(document.zform.filtertype.value=='ID'){var patientpractice=new Array();var patientid='';var practiceid='';patientpractice=document.zform.findtext.value.split(/A/i);patientid=TrimWhitespace(patientpractice[0]);practiceid=TrimWhitespace(patientpractice[1]||GetContextID());patientid=patientid.replace(/^0+(\d+)$/,'$1');practiceid=practiceid.replace(/^0+(\d+)$/,'$1');if(document.zform.findtext.value.match(/^A/i)||(patientid==0&&patientpractice.length<2)||!patientid.match(/^\d+$/)){alert('Patient ID must be numeric and should be greater than zero.');return false;}
if(validpracticeswitcher){if(patientpractice.length>2||(practiceid&&(isNaN(practiceid)||practiceid==0))){alert('Invalid format!\n\nValid formats are:\n\t1. <patientid>\n\t2. <patientid>A<practiceid>\n\nPatient ID and Practice ID must be numeric and should be greater than zero.');return false;}}
else if(document.zform.findtext.value.match(/A/i)){alert(' Patient ID must be numeric and should be greater than zero.');return false;}
if(practiceid&&practiceid!=GetContextID()){if(AH.GetGlobal('AIRLOCKINCLASSICFRAMESET')&&isAirlockOpen()){AirlockNavbarSearch({FORMNAME:'zform',EVENT:{type:'submit'}});}
else{AH.Frames.Hidden.SetLocation(AH.GetGlobal('BASE_HREF')+"/hidden_changepractice.esp?PATIENTID="+patientid+"&PRACTICEID="+practiceid+"&defaultaction="+escape(document.zform.defaultaction.value));}
return false;}
else{var url=AH.GetGlobal('BASE_HREF');if(accesstocharttabs){url+="/clinicals/charttabs.esp?GOTOCHARTSUMMARYBYDEFAULT=1&PATIENTID="+patientid;}
else{url+=document.zform.defaultaction.value+"?SWITCHPROMPT=1&ID="+patientid;}
if(accesstocharttabs){CallRemote({SUB:'Clinical::Patient::GetChartID',ARGS:{'PATIENTID':patientid,'DEPARTMENTID':AH.GetGlobal('DEPARTMENTID'),'ALLOWZERORESULTS':1},ONFINISH:function(chartid){if(chartid){if(isinpatient){url=AH.GetGlobal('AIRLOCK_URL')+AH.GetGlobal('BASE_HREF')+'/inpatient/chart/'+chartid;redirectToAirlock(url);}
else{var airlockurl=buildAirlockURL({'name':'briefing','id':chartid});_ADMNavigate({url:airlockurl,airlock:true,defaultNavigator:function(){redirectToAirlock(airlockurl);}});}}
else{SearchNavigation({frame:'Main',url:url,searchformname:'zform'});}}});}
else{SearchNavigation({frame:'Main',url:url,searchformname:'zform'});}
return false;}}
if(document.zform.filtertype.value=="SSN"&&((document.zform.findtext.value.replace(/[-\s]/g,'').length!=9&&document.zform.findtext.value.replace(/[-\s]/g,'').length!=4)||isNaN(document.zform.findtext.value.replace(/[-\s]/g,'')))){alert("The SSN must be a 4-digit or 9-digit number.");return false;}
if(document.zform.filtertype.value=="PHONE"&&isNaN(document.zform.findtext.value.replace(/[-()\s]/g,''))){alert("The PHONE# must be numeric.");return false;}
var modernnavsearchinput=jQuery('input[id=searchinput]',AH.Frames.GlobalNav.Document());if(modernnavsearchinput.length){if(modernnavsearchinput.val()!=document.zform.findtext.value){modernnavsearchinput.val(document.zform.findtext.value);}}
var redirectpage="/client/findpatient.esp?filtertype=";var defaultactionpage=escape(document.zform.defaultaction.value);var searchurl=AH.GetGlobal('BASE_HREF')
+redirectpage+escape(document.zform.filtertype.value)
+"&findtext="+encodeURIComponent(document.zform.findtext.value)
+"&defaultaction="+AH.GetGlobal('BASE_HREF')+defaultactionpage;SearchNavigation({frame:'Main',url:searchurl,searchformname:'zform'});return false;}
function FindVisit(){if(document.visitfindform.ID.value==''){alert("You must enter a visit ID.");return false;}
document.visitfindform.ID.value=TrimWhitespace(document.visitfindform.ID.value);var visitcontextmatch=document.visitfindform.ID.value.match(/^(\d+)\s*vz\s*(\d+)$/i);var url;if(visitcontextmatch&&practiceswitcher){var visit=parseInt(visitcontextmatch[1],10);var context=parseInt(visitcontextmatch[2],10);document.visitfindform.ID.value=visit;var oldlocation=AH.GetGlobal('BASE_HREF');if(context!=GetContextID()){if(AH.GetGlobal('AIRLOCKINCLASSICFRAMESET')&&isAirlockOpen()){document.visitfindform.ID.value=visit+'vz'+context;AirlockNavbarSearch({FORMNAME:'visitfindform',EVENT:{type:'submit'}});return false;}
url=(AH.GetGlobal('BASE_HREF')+'/hidden_changepractice.esp?PRACTICEID='+context+'&VISITCASEID='+visit);if(AH.GetGlobal("AIRLOCKINCLASSICFRAMESET")&&isAirlockOpen()){AH.Frames.Hidden.StitchToClassic(url);}
else{AH.Frames.Hidden.SetLocation(url);}
return!((oldlocation==AH.GetGlobal('BASE_HREF'))&&(context!=GetContextID()));}}
if(!document.visitfindform.ID.value.match(/^\d+$/)){alert("The ID must be numeric and non-negative.");return false;}
document.visitfindform.ID.value=document.visitfindform.ID.value.replace(/^0+(\d+)$/,'$1');url=AH.GetGlobal('BASE_HREF')
+"/client/editvisitgroup.esp?KEEPGLOBALSEARCHFIELD=1&VISITCASEID="
+escape(document.visitfindform.ID.value);SearchNavigation({frame:'Main',url:url,searchformname:'visitfindform'});return false;}
function FindClaim(){if(document.claimfindform.ID.value==''){alert("You must enter a claim ID.");return false;}
document.claimfindform.ID.value=TrimWhitespace(document.claimfindform.ID.value);var vindex=document.claimfindform.ID.value.indexOf("v");if(vindex==-1){vindex=document.claimfindform.ID.value.indexOf("V");}
if(vindex!=-1){var nextv=document.claimfindform.ID.value.indexOf("v",vindex+1);var leftofv;var rightofv;if(nextv==-1){nextv=document.claimfindform.ID.value.indexOf("V",vindex+1);}
if(nextv!=-1||vindex==0||vindex==document.claimfindform.ID.value.length-1){alert("The ID must be numeric.");return false;}
else{leftofv=TrimWhitespace(document.claimfindform.ID.value.substring(0,vindex));rightofv=TrimWhitespace(document.claimfindform.ID.value.substring(vindex+1,document.claimfindform.ID.value.length));if(rightofv!=''){if(practiceswitcher){if(!leftofv.match(/^\d+$/)||!rightofv.match(/^\d+$/)){alert('Invalid format!\n\nValid formats are:\n\t1. <claimid>\n\t2. <claimid>V<practiceid>');return false;}}
else{alert('Claim ID should be numeric.');return false;}}}
leftofv=parseInt(leftofv,10);document.claimfindform.ID.value=leftofv;var oldlocation=AH.GetGlobal('BASE_HREF');rightofv=rightofv.replace(/^0+/,'');if(rightofv!=GetContextID()){if(AH.GetGlobal('AIRLOCKINCLASSICFRAMESET')&&isAirlockOpen()){document.claimfindform.ID.value=leftofv+'v'+rightofv;AirlockNavbarSearch({FORMNAME:'claimfindform',EVENT:{type:'submit'}});return false;}
var url=AH.GetGlobal('BASE_HREF')+'/hidden_changepractice.esp?PRACTICEID='+rightofv+'&CLAIMID='+leftofv;if(AH.GetGlobal("AIRLOCKINCLASSICFRAMESET")&&isAirlockOpen()){AH.Frames.Hidden.StitchToClassic(url);}
else{AH.Frames.Hidden.SetLocation(url);}
if((oldlocation==AH.GetGlobal('BASE_HREF'))&&(rightofv!=GetContextID())){return false;}
else{return true;}}}
if(!document.claimfindform.ID.value.match(/^\d+$/)){alert("The ID must be numeric and non-negative.");return false;}
document.claimfindform.ID.value=document.claimfindform.ID.value.replace(/^0+(\d+)$/,'$1');var url=AH.GetGlobal('BASE_HREF')+"/billing/claimedit.esp?ID="+escape(document.claimfindform.ID.value);SearchNavigation({frame:'Main',url:url,searchformname:'claimfindform'});return false;}
function FindNetworkPatient(){if(TrimWhitespace(document.acepopfindform.findtext.value)===''){alert("\'Find text field\' cannot be left blank");return false;}
var filtervalue=document.acepopfindform.filtertype.value;var searchtypeid='0';if(filtervalue=='ACEPOPDOB'){if(!SetDate(-100,document.acepopfindform.findtext)){return false;}
if(!IsDate(document.acepopfindform.findtext.value)){alert("The date "+document.acepopfindform.findtext.value+" is invalid.");return false;}}
else if(filtervalue=='ACEPOPPATIENTID'){searchtypeid='1';}
else if(filtervalue=='ACEPOPMEMBERID'){searchtypeid='2';}
var modernnavsearchinput=jQuery('input[id=searchinput]',AH.Frames.GlobalNav.Document());if(modernnavsearchinput.length){if(modernnavsearchinput.val()!=document.acepopfindform.findtext.value){modernnavsearchinput.val(document.acepopfindform.findtext.value);}}
if(top.jQuery('#navbar-iframe').length){AirlockNavbarSearch({FORMNAME:'acepopfindform',EVENT:{type:'submit'}});}
else{CallRemote({SUBSYSTEM:'PopulationManagement',SUB:'CreateURL',ARGS:{'TARGET':'/Header/PerformEnterpriseSearch?searchTerm='+escape(document.acepopfindform.findtext.value)+'&searchType='+searchtypeid,'DEPARTMENTID':AH.GetGlobal('DEPARTMENTID')},ONFINISH:function(newurl){if(newurl){RegisterPOPReloginHandler();jQuery('body').append(jQuery('<form/>')
.attr({'action':newurl,'method':'post','id':'searcher',target:'frMain'})
.append(jQuery('<input/>')
.attr({'type':'hidden','name':'searchTerm','value':document.acepopfindform.findtext.value}))).find('#searcher').submit().remove();}}});}
return false;}
function FindEnrollmentTask(){if(document.enrollmenttaskfindform.findtext.value==''){alert("You must enter an Enrollment task ID.");return false;}
var url=AH.GetGlobal('BASE_HREF')+'/imp/taskview.esp?SUBMITVALUE=Go%20to%20Task&TASKID='+escape(TrimWhitespace(document.enrollmenttaskfindform.findtext.value));SearchNavigation({frame:'Main',url:url,searchformname:'enrollmenttaskfindform'});return false;}
function FindClinicalItems(){document.clinicalitemsfindform.findtext.value=TrimWhitespace(document.clinicalitemsfindform.findtext.value.toUpperCase());if(document.clinicalitemsfindform.findtext.value==''){alert("\'Find text field\' cannot be left blank");return false;}
if(document.clinicalitemsfindform.filtertype.value=='DOCUMENTID'){_DocumentIDSearch();}
return false;}
function _DocumentIDSearch(){var documentandpractice=new Array();var documentid='';var practiceid='';documentandpractice=document.clinicalitemsfindform.findtext.value.split(/H/i);documentid=TrimWhitespace(documentandpractice[0]);practiceid=TrimWhitespace(documentandpractice[1]||GetContextID());documentid=documentid.replace(/^0+(\d+)$/,'$1');practiceid=practiceid.replace(/^0+(\d+)$/,'$1');if(document.clinicalitemsfindform.findtext.value.match(/^H/i)||(documentid==0&&documentandpractice.length<2)||!documentid.match(/^\d+$/)){alert('Document ID must be numeric and should be greater than zero.');return false;}
if(validpracticeswitcher){if(documentandpractice.length>2||(practiceid&&(isNaN(practiceid)||practiceid==0))){alert('Document ID must be numeric.');return false;}}
else if(document.clinicalitemsfindform.findtext.value.match(/H/i)){alert('Document ID must be numeric and should be greater than zero.');return false;}
if(practiceid&&practiceid!=GetContextID()){alert('Document ID must be numeric.');return false;}
else{CallRemote({SUBSYSTEM:'InternalDocument',SUB:'GetDocumentURLOrAlertText',ARGS:{'DOCUMENTID':documentid},ONFINISH:function(args){var alerttext=args.TEXT;var isairlock=args.ISAIRLOCK;var url=args.URL;if(alerttext){alert(alerttext);return false;}
if(isairlock){url=AH.GetGlobal('AIRLOCK_URL')
+AH.GetGlobal('BASE_HREF')+'/'
+(AH.GetGlobal('AIRLOCK_URL_PREFIX')||'ax')
+url;}
else{url=AH.PrependBasePath(url);}
SearchNavigation({frame:'Main',url:url,searchformname:'clinicalitemsfindform'});return false;}});}
return false;}
function PracticeSwitcher(){MediumModalPopupWindow({page:AH.PrependBasePath('/practiceswitcher.esp?DONTCLOSE=1'),title:'switch practice / department',onclose:function(response){if(response&&response.PRACTICEID&&response.DEPARTMENTID){AH.Frames.Hidden.SetLocation(sprintf('%s/hidden_changepractice.esp?%s',AH.GetGlobal('BASE_HREF'),MakeGetString({PRACTICEID:response.PRACTICEID,DEPARTMENTID:response.DEPARTMENTID})));}}});}
function InitializePage(){DisplayChange(1);if(haspatientaccess){jQuery('#NOFINDER').hide();GOTO_FindPatient("ID");}
else if(document.visitfindform){jQuery('#NOFINDER').hide();GOTO_FindVisit();}
else if(document.claimfindform){jQuery('#NOFINDER').hide();GOTO_FindClaim();}}
function ShowPatientActionMenu(menu){var actionmenuitem=AH.Frames.Main.getElementById(menu);if(actionmenuitem){ToggleDropdown(menu);}}
function DisplayChange(initial){if(isTablet()&&!initial){return;}
var finder=jQuery('div#findercontainer',document);var menuitems=jQuery('div.menucontainer',document).children();var body=jQuery('body#globalnav',document);if(body.width()==0)return;if(body.width()>TOTAL_WIDTH){finder.show();menuitems.show();}else if(body.width()>FINDER_WIDTH){finder.show();var widthsofar=FINDER_WIDTH;var hiderest=0;var index=0;menuitems.each(function(){var item=jQuery(this);if(hiderest){item.hide();}else{widthsofar+=MENU_ITEM_WIDTHS[index];if(widthsofar>body.width()){hiderest=1;item.hide();}else{item.show();}}
index++;});}else{finder.hide();menuitems.hide();}}
function InitializeMenus(args){var menuobjects=args.MENUOBJECTS;for(var i=0;i<menuobjects.length;i++){for(var j=0;j<menuobjects[i].length;j++){var menuname=menuobjects[i][j].MENUNAME.toLowerCase();var menuicon=jQuery('#'+menuname+'menucomponent');if(menuobjects[i][j].HIDE){menuicon.addClass('hidden');}
else{var menuargs={MENUNAME:menuname,MENUOBJ:menuobjects[i][j]};var additionalonclick=menuobjects[i][j].ADDITIONALONCLICK||'';menuicon.attr({onclick:'OpenMenu('+ObjectToJSON(menuargs)+');'+additionalonclick});menuicon.removeClass('hidden');}}}}
function OpenMenu(args){if(args.MENUNAME.toUpperCase()=='USER'){AH.Frames.Top.Frame().ShowUserData(args);}
else{AH.Frames.Top.Frame().DisplayMegaMenu(args);}}
function InitializeSearch(args){if(hasvisitaccess||hasclaimaccess||hasdocumentsearchaccess||haspatientaccess||haspopaccess||hastaskaccess||(globalsearchsettings&&globalsearchsettings.VENDORSHORTCUTKEYS==='Y')){AH.Frames.Top.Frame().InitializeSearchObject({HASVISITACCESS:hasvisitaccess,HASCLAIMACCESS:hasclaimaccess,HASDOCUMENTSEARCHACCESS:hasdocumentsearchaccess,HASPATIENTACCESS:haspatientaccess,HASPOPACCESS:haspopaccess,HASTASKACCESS:hastaskaccess,VALIDPRACTICESWITCHER:validpracticeswitcher,ATHENAMENU:athenamenu,PATIENTACTIONMENU:patientactionmenu,GLOBALSEARCHSETTINGS:globalsearchsettings,ICONMENU:iconmenu,EXTRAVENDORSHORTCUTS:extravendorshortcuts});}}
function InitializeSearchText(args){if(globalsearchsettings&&globalsearchsettings.USEMENUSEARCH){defaultsearchtext='Search';}
else{var searchtexts=[];if(haspatientaccess)searchtexts.push('patient');if(hasvisitaccess)searchtexts.push('visit');if(hasclaimaccess)searchtexts.push('claim');if(hasdocumentsearchaccess)searchtexts.push('clinical items');defaultsearchtext='Find ';switch(searchtexts.length){case 0:break;case 1:defaultsearchtext+=searchtexts[0];break;case 2:defaultsearchtext+=searchtexts.join(' or ');break;default:defaultsearchtext+=searchtexts.splice(0,searchtexts.length-1).join(', ')
+', or '+searchtexts[0];}}}
function TrackAppsMenuClicked(trackingenabled){if(trackingenabled==1){require(['shared:/scripts/athena/utils/cross_frame_events'],function(CrossFrameEventsUtils){CrossFrameEventsUtils.trigger('user-tracking.track-event',{rollout_toggle_key:'XDGE_EMBEDDED_APPS_LOGGING',event_type:'GlobalNav:Apps'});});}}
function TrackBrowseMktplace(trackobject,trackingenabled){var eventtype;if(trackobject=='TrackMarketplaceBrowse'){eventtype='AppsNav:Browse';}
else if(trackobject=='TrackMarketplaceAllrecommended'){eventtype='AppsNav:ViewRecommendations';}
if(trackingenabled==1){CallRemote({SUB:'UserBehaviorTracking::LogEvent',ARGS:{PROJECTID:'mdp_marketplace',EVENT:{event_type:eventtype,user_id:AH.GetGlobal('USERNAME'),user_properties:{context_id:AH.Frames.GlobalNav.GetGlobal('contextid')}}}});}}
function TrackMarketplaceProductLinks(trackobject,linkname,trackingenabled){var eventtype;if(trackobject=='TrackMarketplaceRecommendedApp'){eventtype='AppsNav:Recommended';}
else if(trackobject=='TrackMarketplaceQuickLinkApp'){eventtype='AppsNav:QuickLinks';}
if(trackingenabled==1){require(['shared:/scripts/athena/utils/cross_frame_events'],function(CrossFrameEventsUtils){CrossFrameEventsUtils.trigger('user-tracking.track-event',{rollout_toggle_key:'XDGE_EMBEDDED_APPS_LOGGING',event_type:eventtype,event_properties:{app:linkname}});});}}
function SearchFocus(args){var obj=args.OBJ;var searchobject=AH.Frames.Top.Frame().navsearchobject;if(!searchobject||(!searchobject.KeepOpen()&&!searchobject.SilentlyFocus())){AH.Frames.Top.Frame().CloseAthenaNav();if(obj.value==defaultsearchtext){obj.value='';jQuery('#categoryicon').removeClass('sprite-patienticon');jQuery('#categoryicon').removeClass('sprite-visiticon');jQuery('#categoryicon').removeClass('sprite-claimicon');AH.Frames.Top.Frame().HandleFocus(args);}
else{AH.Frames.Top.Frame().HandleFocus(args);}
jQuery(obj).addClass('active');}
obj.select();}
function SearchBlur(args){var obj=args.OBJ;if(obj.value==''){jQuery(obj).removeClass('active');obj.value=defaultsearchtext;jQuery('#categoryicon').removeClass('sprite-patienticon');jQuery('#categoryicon').removeClass('sprite-visiticon');jQuery('#categoryicon').removeClass('sprite-claimicon');AH.Frames.Top.Frame().ResizeSearchBox();}
if(window.getSelection){if(window.getSelection().empty){window.getSelection().empty();}
else if(window.getSelection().removeAllRanges){window.getSelection().removeAllRanges();}}
else if(document.selection){document.selection.empty();}
var searchobject=AH.Frames.Top.Frame().navsearchobject;if(searchobject){if(!searchobject.KeepOpen()){AH.Frames.Top.Frame().CloseAllMenus();if(searchobject.SilentlyFocus()){searchobject.UpdateSilentlyFocus(0);}}}}
function SearchKeyUp(args){obj=args.OBJ;AH.Frames.Top.Frame().HandleKeyUp(args);}
function SearchKeyDown(args){obj=args.OBJ;return AH.Frames.Top.Frame().HandleKeyDown(args);}
function NewClientSupport(identifier){var dimensions=_ConvertToStandardModalWidthHeight({size:'LARGE'});top.AthenaPattern_Popup.open({CONTENTURL:AH.PrependBasePath("/csc/cscunifiedclientsupport.esp?")+MakeGetString(identifier),OVERLAYTYPE:'LIGHTBOX',HEIGHT:dimensions.height,WIDTH:dimensions.width});}
function GetHelp(){require(['shared:/scripts/athena/utils/cross_frame_events'],function(CrossFrameEventsUtils){CrossFrameEventsUtils.trigger('csc-gethelp-toggle-panel-frame');});}
function ParseQueryParams(querystring){querystring=querystring.replace('?','');var pairs=querystring.split('&');var query={};jQuery.each(pairs,function(i,value){var pair=value.split('=');query[pair[0]]=decodeURIComponent(pair[1]);});return query;}
function GlobalNavOnload(args){var attempts=0;var preparedsearchargs=AH.GetGlobal('currentSearchState')||{};setTimeout(function LoadSearch(){var searchobject=AH.Frames.Top.Frame().navsearchobject;if(searchobject){searchobject.PrepareSearch(preparedsearchargs);}
else if(attempts<10){attempts+=1;setTimeout(LoadSearch,250);}},0);return;}
function AirlockNavbarSearch(args){AH.Frames.Top.SetLocation(AH.BaseURL('/globalframeset.esp?'+MakeGetString(AirlockSearchParams(args))));return false;}
function AirlockSearchParams(args){var formname=args.FORMNAME;var event=args.EVENT;if(!event){event={type:'click'};}
var form=jQuery('#finderform[name='+formname+']');var field=(formname==='visitfindform'||formname==='claimfindform')?form.find('[name=ID]'):form.find('[name=findtext]');if(!field.val().match(/\S/)){alert("'Find text field' cannot be left blank.");return false;}
var serializedform=form.serialize().replace(/\+/g,' ');return{AXFIND:serializedform,AXFINDFORM:formname,AXEVENTTYPE:event.type};}
function SearchNavigation(args){var navigationargs={frame:args.frame,url:args.url};if(args.searchformname){navigationargs.framesetParams=AirlockSearchParams({FORMNAME:args.searchformname});}
_ADMNavigate({url:navigationargs.url,framesetParams:navigationargs.framesetParams,defaultNavigator:function(){AH.FramesetNavigation(navigationargs);}});}
function _ADMNavigate(args){var admNavigator=AH.Frames.GlobalNav.GetGlobal('nav_search_admnavigator');if(admNavigator){admNavigator.navigate({url:args.url,airlock:args.airlock,framesetParams:args.framesetParams,defaultNavigator:args.defaultNavigator});}
else{args.defaultNavigator();}}
function FromAirlockOnload(args){var action=function(){var pagequery=ParseQueryParams(top.location.search);var menuid=pagequery['AXMENUID'];var leftnav=pagequery['AXLEFTNAV'];var menu=pagequery['AXMENU'];var menuitem=pagequery['AXMENUITEM'];var nav=pagequery['AXNAV'];var find=pagequery['AXFIND'];var findform=pagequery['AXFINDFORM'];var eventtype=pagequery['AXEVENTTYPE'];var switchpractice=pagequery['AXSWITCHPRACTICE'];var stitch=pagequery['AXSTITCH'];var referrer=AH.Frames.Top.Document().referrer;if(menuid||leftnav||menu||menuitem||nav||find||findform||eventtype||referrer.match(/\/(ax|bx_[^\/]+)\//)||switchpractice){AH.SetGlobal('arrivedFromAirlock',1);}
if(leftnav){AH.SetGlobal('arrivedFromAirlockLeftNav',1);ShowNavigation();}
if(switchpractice){var chromeHack=(IsChrome()&&AH.GetGlobal("arrivedFromAirlock"));var airlockChromeWorkaroundDelay=1000;if(chromeHack){setTimeout(PracticeSwitcher,airlockChromeWorkaroundDelay);}
else{PracticeSwitcher();}}
else if(menuid){AH.Frames.Top.Frame().SimulateMegaMenuClick({MAINMENU:athenamenu,ICONMENU:iconmenu,MENUID:menuid});}
else if(menu&&menuitem){var evt={arrivedFromAirlock:1};if(pagequery['AXMENUALT']){evt.altKey=1;}
MenuClickHandler(menu,menuitem,evt);}
else if(nav){if(nav==="support"){jQuery('#phoneinfo').trigger('click')}}
else if(find&&findform){var query=ParseQueryParams(find);var globalnavdocument;if(AH.Frames&&AH.Frames.GlobalNav&&(globalnavdocument=AH.Frames.GlobalNav.Document())&&jQuery('input[id=searchinput]',globalnavdocument).length){var loop=setInterval(function(){var searchobject=AH.Frames.Top.Frame().navsearchobject;if(searchobject){clearInterval(loop);var searchcategory=findform==='zform'?'PATIENT':/^(\w+)findform$/.exec(findform)[1].toUpperCase();var searchtext=(searchcategory==='VISIT'||searchcategory==='CLAIM')?query.ID:query.findtext;var searchoptionname=(searchcategory==='VISIT'||searchcategory==='CLAIM')?'ID':query.filtertype;searchobject.PerformPreparedSearch({TEXT:searchtext,CATEGORY:searchcategory,OPTIONNAME:searchoptionname,EVENTTYPE:eventtype,PREPAREONLY:stitch});}});}else{var form=jQuery('#finderform[name='+findform+']');jQuery.each(query,function(name,value){form.find('[name='+name+']').first().val(value);});form.submit();}}
AH.SetGlobal('fromAirlockOnloadJSExecuted',1);};if(!AH.GetGlobal('fromAirlockOnloadJSExecuted')){RunWhenDocumentReady(function(){return AH.Frames.Main.Frame()},action,15*60);}}
function SimulateLogoutClick(){AH.Frames.GlobalNav.Frame().jQuery('#logout').click();}
